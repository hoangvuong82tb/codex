<UserControl x:Class="ASMILE.BO.App.Controls.WarehouseDetailCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASMILE.BO.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="520">
    <UserControl.Resources>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="#2E4561" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <controls:RoundedClipBorder Style="{StaticResource FluentCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="1" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="&#xE8D1;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="#2F65D9"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextRenderingMode="Aliased" />
                    </Border>
                    <TextBlock Grid.Column="2"
                               Text="Thông tin kho"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="#223A58"
                               VerticalAlignment="Center" />
                </Grid>
                <Border Grid.Row="2" BorderBrush="#D5E1F0" BorderThickness="0,1,0,0" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Style="{StaticResource FormLabelStyle}"><Run Text="Mã kho" /><Run Text=" *" Foreground="#D04747" /></TextBlock>
                        <TextBox Style="{StaticResource FluentTextBox}" Text="{Binding Editing.WarehouseCode, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Style="{StaticResource FormLabelStyle}"><Run Text="Tên kho" /><Run Text=" *" Foreground="#D04747" /></TextBlock>
                        <TextBox Style="{StaticResource FluentTextBox}" Text="{Binding Editing.WarehouseName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Kho cha" />
                        <ComboBox x:Name="ParentWarehouseCombo"
                                  Height="44"
                                  Style="{StaticResource FluentComboBox}"
                                  Margin="0,0,0,2"
                                  ItemsSource="{Binding WarehouseLookup}"
                                  DisplayMemberPath="Display"
                                  TextSearch.TextPath="Display"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  IsTextSearchCaseSensitive="False"
                                  GotKeyboardFocus="SuggestionCombo_OnGotKeyboardFocus"
                                  KeyUp="SuggestionCombo_OnKeyUp"
                                  LostKeyboardFocus="SuggestionCombo_OnLostKeyboardFocus"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding Editing.ParentWarehouseId}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Bộ phận" />
                        <ComboBox x:Name="DepartmentCombo"
                                  Height="44"
                                  Style="{StaticResource FluentComboBox}"
                                  Margin="0,0,0,2"
                                  ItemsSource="{Binding DepartmentLookup}"
                                  DisplayMemberPath="Display"
                                  TextSearch.TextPath="Display"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  IsTextSearchCaseSensitive="False"
                                  GotKeyboardFocus="SuggestionCombo_OnGotKeyboardFocus"
                                  KeyUp="SuggestionCombo_OnKeyUp"
                                  LostKeyboardFocus="SuggestionCombo_OnLostKeyboardFocus"
                                  SelectedValuePath="Name"
                                  SelectedValue="{Binding Editing.DepartmentName}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Người chịu trách nhiệm" />
                        <ComboBox x:Name="ResponsiblePersonCombo"
                                  Height="44"
                                  Style="{StaticResource FluentComboBox}"
                                  Margin="0,0,0,2"
                                  ItemsSource="{Binding ResponsiblePersonLookup}"
                                  DisplayMemberPath="Display"
                                  TextSearch.TextPath="Display"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  IsTextSearchCaseSensitive="False"
                                  GotKeyboardFocus="SuggestionCombo_OnGotKeyboardFocus"
                                  KeyUp="SuggestionCombo_OnKeyUp"
                                  LostKeyboardFocus="SuggestionCombo_OnLostKeyboardFocus"
                                  Text="{Binding Editing.ResponsiblePersonName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Ghi chú" />
                        <TextBox Style="{StaticResource FluentTextBox}"
                                 Height="110"
                                 Padding="12,10,12,10"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 HorizontalContentAlignment="Left"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Editing.Note, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Kho tiêu hao" Style="{StaticResource FormLabelStyle}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <CheckBox Grid.Column="1" IsChecked="{Binding Editing.IsConsumptionWarehouse}" Style="{StaticResource FluentToggleSwitchStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Có" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#273E5A" />

                        <TextBlock Grid.Column="4" Text="Trạng thái" Style="{StaticResource FormLabelStyle}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <CheckBox Grid.Column="5" IsChecked="{Binding Editing.IsActive}" Style="{StaticResource FluentToggleSwitchStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="Kích hoạt" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#273E5A" />
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#D4E0EF" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                    <Button Style="{StaticResource FluentSecondaryButton}" Command="{Binding NewCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#243B5D" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Mới" Foreground="#243B5D" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FluentPrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Lưu" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FluentDangerButton}" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Xóa" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </controls:RoundedClipBorder>
</UserControl>
