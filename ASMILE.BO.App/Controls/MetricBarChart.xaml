<UserControl x:Class="ASMILE.BO.App.Controls.MetricBarChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#1F2937"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,6">
            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                <Border Width="10" Height="10" Background="#66C282" CornerRadius="2" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding InSeriesTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" Foreground="#64748B"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding HasOutSeries, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="10" Height="10" Background="#F08A83" CornerRadius="2" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding OutSeriesTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="126"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="AxisLabelPanel" Grid.Row="0"/>
            <Canvas x:Name="PlotCanvas" Grid.Row="0" Grid.Column="1" Height="126" ClipToBounds="False" SizeChanged="OnPlotCanvasSizeChanged"/>
            <UniformGrid x:Name="DateLabelsPanel" Grid.Row="1" Grid.Column="1" Rows="1" Margin="0,2,0,0"/>
        </Grid>
    </Grid>
</UserControl>
