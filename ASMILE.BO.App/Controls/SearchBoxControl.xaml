<UserControl x:Class="ASMILE.BO.App.Controls.SearchBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="46"
             d:DesignWidth="320">
    <Border CornerRadius="14"
            BorderThickness="1"
            Background="#FFFFFF">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#C8D4E6" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#16000000"
                                          BlurRadius="12"
                                          ShadowDepth="1"
                                          Direction="315"
                                          Opacity="0.10" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=InnerTextBox}" Value="True">
                        <Setter Property="BorderBrush" Value="#6D9FE3" />
                        <Setter Property="Background" Value="#FFFFFF" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=InnerTextBox}" Value="True">
                        <Setter Property="BorderBrush" Value="#AEC3DE" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="&#xE721;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="16"
                       Foreground="#5F7692"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <Grid Grid.Column="1">
                <TextBox x:Name="InnerTextBox"
                         Style="{StaticResource FluentSearchBox}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0,0,4,0"
                         Margin="0,0,0,1"
                         VerticalContentAlignment="Center"
                         VerticalAlignment="Center"
                         Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#7C8FA8"
                           Margin="0,0,0,1"
                           FontSize="14"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=InnerTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <TextBlock Grid.Column="2"
                       Text="&#xE71C;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="16"
                       Foreground="#5F7692"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
