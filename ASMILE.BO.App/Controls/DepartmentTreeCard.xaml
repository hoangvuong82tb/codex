<UserControl x:Class="ASMILE.BO.App.Controls.DepartmentTreeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASMILE.BO.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="420">
    <UserControl.Resources>
        <Style x:Key="TreeActionButtonStyle" TargetType="Button" BasedOn="{StaticResource EnterpriseDialogIconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="TreeListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="#FDFEFF"
                                BorderBrush="#DDE6F2"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,10,10,10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F5F9FF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#CADAF1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EEF4FF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#BFD3F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <controls:RoundedClipBorder Style="{StaticResource FluentCardStyle}" Padding="18,18,18,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Cơ cấu bộ phận"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#223A58"
                       Margin="0,0,0,12" />

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Departments}"
                     SelectedItem="{Binding SelectedDepartment}"
                     Background="Transparent"
                     BorderThickness="0"
                     FocusVisualStyle="{x:Null}"
                     IsTabStop="False"
                     ItemContainerStyle="{StaticResource TreeListItemStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="{Binding ItemMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#4B77CE" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DepartmentName}" FontWeight="Bold" Foreground="#173F93" FontSize="13.5" />
                                <TextBlock Text="{Binding DepartmentCode}" Foreground="#2E4263" FontSize="13" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border Grid.Column="3"
                                    Background="#EAF5EE"
                                    CornerRadius="11"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding PeopleCount, StringFormat={}{0} NS}" Foreground="#1E7C48" FontSize="12.5" FontWeight="SemiBold" />
                            </Border>

                            <Button Grid.Column="5"
                                    Style="{StaticResource TreeActionButtonStyle}"
                                    Command="{Binding DataContext.OpenEditDepartmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="#5A7091" />
                            </Button>

                            <Button Grid.Column="7"
                                    Style="{StaticResource TreeActionButtonStyle}"
                                    Command="{Binding DataContext.ToggleDepartmentStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="&#xE8D8;" FontFamily="Segoe MDL2 Assets" Foreground="#5A7091" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </controls:RoundedClipBorder>
</UserControl>
