<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ASMILE.BO.App.Controls.EnterpriseSummaryCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="Root" xmlns:controls="clr-namespace:ASMILE.BO.App.Controls;assembly=ASMILE.BO.App">
  <Border Style="{StaticResource EnterpriseSummaryCardFrame}" MinWidth="180" MinHeight="112">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Foreground="#536985" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title, ElementName=Root}" />
        <TextBlock Foreground="#0F2A55" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap" Text="{Binding Value, ElementName=Root}" />
        <TextBlock Foreground="#6B7A90" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Subtitle, ElementName=Root}" />
      </StackPanel>
      <Border Grid.Column="1" Width="42" Height="42" Background="#EEF4FF" CornerRadius="12" VerticalAlignment="Top" Margin="12,0,0,0">
        <TextBlock FontFamily="Segoe MDL2 Assets" Foreground="#2F63DE" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding IconGlyph, ElementName=Root}" />
      </Border>
    </Grid>
  </Border>
</UserControl>
