<UserControl x:Class="ASMILE.BO.App.Controls.ExplorerDriveItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="74"
             d:DesignWidth="260">
    <Border BorderThickness="1"
            BorderBrush="#E5EAF2"
            CornerRadius="8"
            Background="#FFFFFF"
            Padding="10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <Image Source="{Binding Item.IconPath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Width="22"
                       Height="22"
                       Stretch="Uniform" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Item.DisplayName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#1F1F1F"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <Border Height="8"
                        Margin="0,6,0,5"
                        Background="#EFF3F8"
                        CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="#E5EAF2"
                        Visibility="{Binding Item.HasUsageMetric, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border HorizontalAlignment="Left"
                            Width="{Binding UsedBarWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="{Binding UsedBarBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CornerRadius="4" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
