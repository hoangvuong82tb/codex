<UserControl x:Class="ASMILE.BO.App.Controls.AppWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="680"
             d:DesignWidth="1080">
    <UserControl.Resources>
        <Style x:Key="WindowCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#223957" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="9.6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E9F0FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D6E3F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowCaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E05656" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#BF4343" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResizeHandleStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Window.IsMaximized, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#A8BCD8"
            Background="#F9FBFF"
            PreviewMouseLeftButtonDown="RootBorder_PreviewMouseLeftButtonDown">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.18" Color="#213E66" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="#A8BCD8" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Window.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                        <Setter Property="BorderBrush" Value="#B8C6DA" />
                        <Setter Property="Opacity" Value="0.82" />
                        <Setter Property="Background" Value="#CFF7FAFF" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Window.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="BorderBrush" Value="#6D8FC6" />
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="Background" Value="#F9FBFF" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="#F2F6FC"
                    BorderBrush="#D4E0EF"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F2F6FC" />
                        <Setter Property="BorderBrush" Value="#D4E0EF" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Window.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Background" Value="#D9EFF6FF" />
                                <Setter Property="BorderBrush" Value="#C8D8EB" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Window.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Background" Value="#F2F6FC" />
                                <Setter Property="BorderBrush" Value="#D4E0EF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="28"
                            Height="28"
                            Margin="8,0,8,0"
                            VerticalAlignment="Center"
                            CornerRadius="6"
                            Background="#20FFFFFF"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1">
                        <Image Source="{Binding Window.Module.IconImage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Width="16"
                               Height="16"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Window.Module.Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#213552" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                Command="{Binding MinimizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Window, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="Thu nhỏ">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>

                        <Button x:Name="MaximizeButton"
                                Command="{Binding ToggleMaximizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Window, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="Phóng to / Khôi phục">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WindowCaptionButtonStyle}">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Window.IsMaximized, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <TextBlock Text="&#xE923;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Style="{StaticResource WindowCloseButtonStyle}"
                                Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Window, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="Đóng">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10,8,10,10">
                <ContentControl Content="{Binding Window.ContentViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Grid>

            <Thumb Style="{StaticResource ResizeHandleStyle}"
                   Grid.RowSpan="2"
                   Width="8"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Stretch"
                   Cursor="SizeWE"
                   DragDelta="ResizeLeftThumb_DragDelta" />
            <Thumb Style="{StaticResource ResizeHandleStyle}"
                   Grid.RowSpan="2"
                   Width="8"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Stretch"
                   Cursor="SizeWE"
                   DragDelta="ResizeRightThumb_DragDelta" />
            <Thumb Style="{StaticResource ResizeHandleStyle}"
                   Grid.RowSpan="2"
                   Height="8"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Cursor="SizeNS"
                   DragDelta="ResizeTopThumb_DragDelta" />
            <Thumb Style="{StaticResource ResizeHandleStyle}"
                   Grid.RowSpan="2"
                   Height="8"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNS"
                   DragDelta="ResizeBottomThumb_DragDelta" />

            <Thumb Style="{StaticResource ResizeHandleStyle}"
                   Grid.RowSpan="2"
                   Width="12"
                   Height="12"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeTopLeftThumb_DragDelta" />
            <Thumb Style="{StaticResource ResizeHandleStyle}"
                   Grid.RowSpan="2"
                   Width="12"
                   Height="12"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Cursor="SizeNESW"
                   DragDelta="ResizeTopRightThumb_DragDelta" />
            <Thumb Style="{StaticResource ResizeHandleStyle}"
                   Grid.RowSpan="2"
                   Width="12"
                   Height="12"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNESW"
                   DragDelta="ResizeBottomLeftThumb_DragDelta" />
            <Thumb Style="{StaticResource ResizeHandleStyle}"
                   Grid.RowSpan="2"
                   Width="12"
                   Height="12"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeBottomRightThumb_DragDelta" />
        </Grid>
    </Border>
</UserControl>
