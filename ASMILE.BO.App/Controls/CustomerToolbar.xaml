<UserControl x:Class="ASMILE.BO.App.Controls.CustomerToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASMILE.BO.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="70"
             d:DesignWidth="1200">
    <controls:EnterpriseCommandToolbar SearchText="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       SearchPlaceholder="Tìm kiếm theo mã, tên, điện thoại..."
                                       RefreshCommand="{Binding SearchCommand}"
                                       ExportTemplateCommand="{Binding ExportTemplateCommand}"
                                       ExportCurrentViewCommand="{Binding ExportCurrentViewCommand}"
                                       ImportDataCommand="{Binding ImportDataCommand}" />
</UserControl>
