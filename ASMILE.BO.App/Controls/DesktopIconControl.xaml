<UserControl x:Class="ASMILE.BO.App.Controls.DesktopIconControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="96"
             d:DesignWidth="104">
    <Button x:Name="IconButton"
            Style="{StaticResource DesktopIconButtonStyle}"
            AutomationProperties.Name="{Binding Module.Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
            AutomationProperties.AutomationId="{Binding Module.Key, RelativeSource={RelativeSource AncestorType=UserControl}}"
            PreviewMouseLeftButtonDown="IconButton_PreviewMouseLeftButtonDown"
            PreviewMouseRightButtonDown="IconButton_PreviewMouseRightButtonDown"
            PreviewMouseMove="IconButton_PreviewMouseMove"
            PreviewMouseLeftButtonUp="IconButton_PreviewMouseLeftButtonUp"
            MouseDoubleClick="IconButton_MouseDoubleClick"
            Click="IconButton_Click">
        <Button.ContextMenu>
            <ContextMenu Style="{StaticResource DesktopContextMenuStyle}">
                <MenuItem Header="Mở"
                          Tag="open"
                          Click="IconContextMenuItem_Click"
                          Style="{StaticResource DesktopContextMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Ghim/Bỏ ghim taskbar"
                          Tag="toggle-pin"
                          Click="IconContextMenuItem_Click"
                          Style="{StaticResource DesktopContextMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Căn vào lưới"
                          Tag="snap-grid"
                          Click="IconContextMenuItem_Click"
                          Style="{StaticResource DesktopContextMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Style="{StaticResource DesktopContextMenuSeparatorStyle}" />
                <MenuItem Header="Ẩn khỏi desktop"
                          Tag="hide"
                          Click="IconContextMenuItem_Click"
                          Style="{StaticResource DesktopContextMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Đổi icon"
                          Tag="change-icon"
                          Click="IconContextMenuItem_Click"
                          Style="{StaticResource DesktopContextMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Style="{StaticResource DesktopContextMenuSeparatorStyle}" />
                <MenuItem Header="Sao chép tên"
                          Tag="copy-name"
                          Click="IconContextMenuItem_Click"
                          Style="{StaticResource DesktopContextMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Thuộc tính"
                          Tag="properties"
                          Click="IconContextMenuItem_Click"
                          Style="{StaticResource DesktopContextMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Button.ContextMenu>
        <StackPanel HorizontalAlignment="Center">
            <Image Source="{Binding Module.IconImage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Width="32"
                   Height="32"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
            <TextBlock Text="{Binding Module.Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{StaticResource TextOnDarkBrush}"
                       FontSize="11.5"
                       TextAlignment="Center"
                       Margin="0,7,0,0"
                       TextWrapping="Wrap"
                       MaxWidth="96"
                       LineStackingStrategy="BlockLineHeight"
                       LineHeight="14" />
        </StackPanel>
    </Button>
</UserControl>
