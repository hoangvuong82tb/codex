<UserControl x:Class="ASMILE.BO.App.Views.HotelRoomStatusRuleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource HotelSettingsButtonBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/></Style>
        <Style x:Key="SettingsTextBox" TargetType="TextBox" BasedOn="{StaticResource HotelSettingsTextBoxBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/></Style>
    </UserControl.Resources>
    <Grid Background="Transparent" Margin="0,0,0,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Padding="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Quy tắc trạng thái phòng" FontSize="22" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Thiết lập độc lập các chuyển trạng thái theo cơ sở; rule OOS được áp dụng trực tiếp khi đổi trạng thái vận hành phòng." Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Làm mới" Command="{Binding LoadCommand}" Style="{StaticResource SettingsButton}"/><Button Content="+ Thêm quy tắc" Command="{Binding NewItemCommand}" Style="{StaticResource SettingsPrimaryButton}" Margin="0"/></StackPanel></Grid></Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Từ khóa" Grid.Column="0" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBlock Text="Lĩnh vực" Grid.Column="1" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" ToolTip="Tìm mã, tên, trạng thái nguồn hoặc đích"/><ComboBox Grid.Row="1" Style="{StaticResource HotelSettingsComboBoxBase}" Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding Domains}" SelectedItem="{Binding SelectedDomain}" Height="34" Padding="8,0"/><Button Grid.Row="1" Grid.Column="3" Content="Tìm" Command="{Binding SearchCommand}" Style="{StaticResource SettingsButton}" Margin="8,0,0,0"/></Grid></Border>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
            <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="False"><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#F8FAFC" CornerRadius="10" ClipToBounds="True" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="Mã" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/><TextBlock Grid.Column="1" Text="Lĩnh vực" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/><TextBlock Grid.Column="2" Text="Chuyển trạng thái" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/><TextBlock Grid.Column="3" Text="Trạng thái" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/></Grid></Border><ListBox ItemContainerStyle="{StaticResource HotelSettingsListBoxItemStyle}" HorizontalContentAlignment="Stretch" Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock Grid.Column="1" Text="{Binding StatusDomain}" Foreground="#475569"/><StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="{Binding FromStatus}" Foreground="#17365D"/><TextBlock Text="  →  " Foreground="#94A3B8"/><TextBlock Text="{Binding ToStatus}" Foreground="#17365D"/></StackPanel><TextBlock Grid.Column="3" Text="{Binding IsActive, StringFormat='{}{0}'}" Foreground="#2563EB"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
            <Border Grid.Column="1" Margin="16,0,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16"><StackPanel><StackPanel><TextBlock Text="Chi tiết quy tắc" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="{Binding SelectedSummary}" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/><StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Mã" Foreground="#475569"/><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,8"/><TextBlock Text="Tên" Foreground="#475569"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,8"/><TextBlock Text="Lĩnh vực" Foreground="#475569"/><ComboBox Style="{StaticResource HotelSettingsComboBoxBase}" ItemsSource="{Binding Domains}" SelectedItem="{Binding StatusDomain}" Height="34" Margin="0,4,0,8"/><TextBlock Text="Từ trạng thái" Foreground="#475569"/><TextBox Text="{Binding FromStatus, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,8"/><TextBlock Text="Đến trạng thái" Foreground="#475569"/><TextBox Text="{Binding ToStatus, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,8"/><TextBlock Text="Vai trò yêu cầu" Foreground="#475569"/><TextBox Text="{Binding RequiredRole, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,8"/><TextBlock Text="Sự kiện yêu cầu" Foreground="#475569"/><TextBox Text="{Binding RequiredEvent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,8"/><CheckBox Content="Yêu cầu phê duyệt" IsChecked="{Binding RequiresApproval}" Margin="0,4,0,8"/><TextBlock Text="Mô tả" Foreground="#475569"/><TextBox Style="{StaticResource HotelSettingsTextBoxBase}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="52" TextWrapping="Wrap" AcceptsReturn="True" Padding="10,8" BorderBrush="#D7E2F0" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Hủy" Command="{Binding CancelEditCommand}" Style="{StaticResource SettingsButton}"/><Button Content="Lưu" Command="{Binding SaveCommand}" Style="{StaticResource SettingsPrimaryButton}" Margin="0"/></StackPanel></StackPanel><StackPanel Visibility="{Binding IsReadOnlyPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Trạng thái" Foreground="#64748B" Margin="0,0,0,3"/><TextBlock Text="{Binding SelectedStatus}" Foreground="#17365D" FontWeight="SemiBold"/><TextBlock Text="Quy tắc này là cấu hình độc lập theo property; màn hình vận hành đọc trạng thái thật từ workflow và lịch sử." Foreground="#64748B" TextWrapping="Wrap" Margin="0,14,0,16"/><StackPanel Orientation="Horizontal"><Button Content="Sửa" Command="{Binding EditItemCommand}" Style="{StaticResource SettingsPrimaryButton}"/><Button Content="Bật / tạm ngưng" Command="{Binding ToggleActiveCommand}" Style="{StaticResource SettingsButton}" Margin="0"/></StackPanel></StackPanel><Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap"/></Border><Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0" Visibility="{Binding HasInfo, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding InfoMessage}" Foreground="#166534" TextWrapping="Wrap"/></Border></StackPanel></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>



