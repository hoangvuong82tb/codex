<UserControl x:Class="ASMILE.BO.App.Views.CheckoutWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.04,0.04" Center="0.04,0.04" RadiusX="0.32" RadiusY="0.32">
                <GradientStop Color="#106aa7ff" Offset="0"/><GradientStop Color="#00ffffff" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Style="{StaticResource HubContainerStyle}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Button Content="← Quay lại Lễ tân" Command="{Binding BackCommand}" Style="{StaticResource HubBackButtonStyle}"/>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,32">
                    <TextBlock Text="Check-out" Style="{StaticResource HubHeaderStyle}" FontSize="32"/>
                    <TextBlock Text="Kiểm tra, thanh toán và hoàn tất quy trình trả phòng." Style="{StaticResource HubSubtitleStyle}" FontSize="16"/>
                </StackPanel>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Center" MaxWidth="1060">
                    <Border Style="{StaticResource HubCardStyle}" MouseLeftButtonDown="OnPrepCheckout"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource HubIconBoxStyle}"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4A8EFF" Offset="0"/><GradientStop Color="#1765F2" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Grid.Column="1" Text="Chuẩn bị Check-out" Style="{StaticResource HubCardTitleStyle}"/></Grid></Border>
                    <Border Style="{StaticResource HubCardStyle}" MouseLeftButtonDown="OnQuickCheckout"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource HubIconBoxStyle}"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#31C9B8" Offset="0"/><GradientStop Color="#00A58F" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE961;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Grid.Column="1" Text="Check-out nhanh" Style="{StaticResource HubCardTitleStyle}"/></Grid></Border>
                    <Border Style="{StaticResource HubCardStyle}" MouseLeftButtonDown="OnGroupCheckout"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource HubIconBoxStyle}"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFAD39" Offset="0"/><GradientStop Color="#ED7900" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Grid.Column="1" Text="Check-out đoàn" Style="{StaticResource HubCardTitleStyle}"/></Grid></Border>
                    <Border Style="{StaticResource HubCardStyle}" MouseLeftButtonDown="OnExpressCheckout"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource HubIconBoxStyle}"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B158FF" Offset="0"/><GradientStop Color="#7D2BE1" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Grid.Column="1" Text="Express Check-out" Style="{StaticResource HubCardTitleStyle}"/></Grid></Border>
                    <Border Style="{StaticResource HubCardStyle}" MouseLeftButtonDown="OnCheckFolio"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource HubIconBoxStyle}"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF5A94" Offset="0"/><GradientStop Color="#E32F70" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE90B;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Grid.Column="1" Text="Kiểm tra Folio" Style="{StaticResource HubCardTitleStyle}"/></Grid></Border>
                </WrapPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
