<UserControl x:Class="ASMILE.BO.App.Views.ExportPipelineSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Export PDF/Excel" FontSize="22" FontWeight="SemiBold" Foreground="#102E5A" />
                    <TextBlock Text="Quản lý retention của export execution đã lưu. Template/định dạng của các module chưa được đăng ký trong pipeline này."
                               TextWrapping="Wrap" Foreground="#64748B" Margin="0,4,12,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Làm mới" Command="{Binding LoadCommand}" Padding="16,8" MinWidth="94" />
                <Button Grid.Column="3" Content="+ Thêm policy" Command="{Binding NewPolicyCommand}" Padding="16,8" MinWidth="112" IsEnabled="{Binding CanEdit}" />
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.1*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Retention policies" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,8" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Policies}" SelectedItem="{Binding SelectedPolicy, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ExportCode}" FontWeight="SemiBold" Foreground="#102E5A" />
                                        <TextBlock Text="{Binding RetentionDays, StringFormat={}{0} ngày}" FontSize="12" Foreground="#64748B" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#475569" Margin="12,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Tạm ngưng" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Text" Value="Đang bật" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="Export executions gần đây" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,12,0,8" />
                <DataGrid Grid.Row="3" ItemsSource="{Binding Executions}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã export" Binding="{Binding ExportCode}" Width="*" />
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="Auto" />
                        <DataGridTextColumn Header="Đã xếp hàng" Binding="{Binding QueuedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel IsEnabled="{Binding HasSelection}">
                    <TextBlock Text="Chi tiết retention policy" FontSize="17" FontWeight="SemiBold" Foreground="#102E5A" />
                    <TextBlock Text="Policy chỉ áp dụng cho ExportExecutions/Artifacts do ExportPipelineService ghi nhận; các module xuất trực tiếp không được tự nhận là đã áp dụng."
                               TextWrapping="Wrap" Foreground="#64748B" Margin="0,4,0,16" />
                    <TextBlock Text="Mã export" />
                    <TextBox Text="{Binding ExportCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="8,6" IsEnabled="{Binding CanEdit}" />
                    <TextBlock Text="Lưu execution (ngày)" />
                    <TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="8,6" IsEnabled="{Binding CanEdit}" />
                    <CheckBox Content="Áp dụng retention policy" IsChecked="{Binding IsActive}" Margin="0,2,0,16" IsEnabled="{Binding CanEdit}" />
                    <Button Content="Lưu policy" Command="{Binding SaveCommand}" Padding="16,8" HorizontalAlignment="Left" MinWidth="120" IsEnabled="{Binding CanEdit}" />
                    <TextBlock Text="{Binding InfoMessage}" Foreground="#15803D" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
