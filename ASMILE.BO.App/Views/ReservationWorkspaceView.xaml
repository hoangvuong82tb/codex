<UserControl x:Class="ASMILE.BO.App.Views.ReservationWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="Margin" Value="0,18,0,8"/></Style>
        <Style x:Key="FormLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
        <Style x:Key="FormTextBox" TargetType="TextBox"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#C8D4E7"/></Style>
        <Style x:Key="InlineError" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="InlineInfo" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding HasInfo}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="EmptyState" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource SurfaceBrush}" Margin="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="28,22,28,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Dat phong" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Quan ly dat phong theo Property hien tai" Margin="0,5,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Lam moi" Command="{Binding RefreshCommand}" Style="{StaticResource FluentSecondaryButton}" Margin="0,0,10,0"/>
                <Button Content="Tao dat phong" Command="{Binding NewCommand}" IsEnabled="{Binding CanCreate}" Style="{StaticResource FluentPrimaryButton}"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Margin="28,0,28,14" Padding="16" Background="{StaticResource CardBrush}" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="115"/><ColumnDefinition Width="8"/><ColumnDefinition Width="115"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" ToolTip="Tim theo so dat phong hoac ten khach"/>
                <ComboBox Grid.Column="2" Height="36" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}"/>
                <DatePicker Grid.Column="4" SelectedDate="{Binding FilterArrivalFrom}" ToolTip="Nhan phong tu ngay"/>
                <DatePicker Grid.Column="6" SelectedDate="{Binding FilterArrivalTo}" ToolTip="Nhan phong den ngay"/>
                <Button Grid.Column="8" Content="Tim" Command="{Binding SearchCommand}" Style="{StaticResource FluentSecondaryButton}"/>
                <Button Grid.Column="10" Content="Xoa loc" Command="{Binding ClearFiltersCommand}" Style="{StaticResource FluentSecondaryButton}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="28,0,28,24">
            <Border Background="{StaticResource CardBrush}" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="10" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Reservations}" SelectedItem="{Binding SelectedReservation}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Margin="0" MinHeight="360" MouseDoubleClick="OnDataGridDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="So dat phong" Binding="{Binding ReservationNumber}" Width="130"/>
                            <DataGridTextColumn Header="Khach" Binding="{Binding GuestName}" Width="*"/>
                            <DataGridTextColumn Header="Nhan phong" Binding="{Binding ArrivalDate}" Width="100"/>
                            <DataGridTextColumn Header="Tra phong" Binding="{Binding DepartureDate}" Width="100"/>
                            <DataGridTextColumn Header="Trang thai" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Nguon" Binding="{Binding Source}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="0" Style="{StaticResource EmptyState}" Background="{StaticResource CardBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="260">
                            <TextBlock Text="Chua co dat phong phu hop." FontSize="15" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Thay doi bo loc hoac tao dat phong moi." TextAlignment="Center" Margin="0,6,0,12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <Button Content="Tao dat phong" Command="{Binding NewCommand}" IsEnabled="{Binding CanCreate}" Style="{StaticResource FluentPrimaryButton}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Background="#D9FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="150" Height="5" IsIndeterminate="True"/>
                            <TextBlock Text="Dang tai du lieu..." Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <DockPanel Grid.Row="1" Margin="14" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding TotalCount, StringFormat=Tong: {0}}"/>
                        <Button DockPanel.Dock="Right" Content="Sau" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" Style="{StaticResource FluentSecondaryButton}" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Truoc" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}" Style="{StaticResource FluentSecondaryButton}"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
