<Window x:Class="ASMILE.BO.App.Views.CashierReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phiếu thu FO"
        Width="1180"
        Height="720"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#D9E2EF"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="11,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D9E2EF"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="22,16" Background="White" BorderBrush="#DCE6F2" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12" Background="#2563EB"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Phiếu thu Front Office" FontSize="20" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Quản lý phiếu thu riêng cho nghiệp vụ Thu ngân / Folio." Margin="0,3,0,0" FontSize="12" Foreground="#64748B"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Làm mới" Click="OnRefresh" Style="{StaticResource SecondaryButton}"/><Button Content="Đóng" Click="OnClose" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"/></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="18,14,18,0" Padding="14" Background="White" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="Từ khóa" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/><TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" Style="{StaticResource Field}"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Ngày thu" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/><TextBox Text="Tất cả" IsReadOnly="True" Style="{StaticResource Field}"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Trạng thái" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/><TextBox Text="Tất cả" Style="{StaticResource Field}"/></StackPanel>
                <TextBlock Grid.Column="3" Text="Phiếu thu FO không dùng chung màn hình Phiếu thu kế toán." VerticalAlignment="Center" Foreground="#2563EB" FontSize="12" TextWrapping="Wrap" Margin="8,15,16,0"/>
                <Button Grid.Column="4" Content="Tìm" Click="OnRefresh" Style="{StaticResource PrimaryButton}" Margin="0,15,0,0"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="18,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Danh sách phiếu thu FO" FontSize="15" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,10"/>
                    <DataGrid x:Name="ReceiptGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="42" ColumnHeaderHeight="40" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF2F7" AlternatingRowBackground="#FAFBFD" FontSize="13">
                        <DataGrid.Columns><DataGridTextColumn Header="Phiếu thu FO · Khách / Folio · Số tiền · Phương thức · Trạng thái" Binding="{Binding Display}" Width="*"/></DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ReceiptFooterText" Grid.Row="2" Text="Đang tải dữ liệu phiếu thu FO thật..." Margin="0,12,0,0" FontSize="12" Foreground="#64748B"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel><TextBlock Text="Chi tiết phiếu thu" FontSize="15" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Chưa chọn phiếu" Margin="0,18,0,4" FontSize="16" FontWeight="SemiBold" Foreground="#52657D"/><TextBlock Text="Chọn một phiếu thu FO để xem chi tiết và thao tác." TextWrapping="Wrap" Foreground="#94A3B8" FontSize="12"/><Button Content="Tạo phiếu thu" Click="OnCreate" Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" HorizontalAlignment="Left"/></StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="3" Padding="18,10" Background="White" BorderBrush="#DCE6F2" BorderThickness="0,1,0,0"><TextBlock Text="Nghiệp vụ Thu ngân / Front Office · Phiếu thu FO" Foreground="#64748B" FontSize="12"/></Border>
    </Grid>
</Window>
