<UserControl x:Class="ASMILE.BO.App.Views.LostFoundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" Loaded="OnLoaded">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="That Lac &amp; Tim Thay (Lost &amp; Found)" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding TotalFound, StringFormat='Tim thay: {0}'}" Margin="0,0,12,0" Foreground="#2563EB" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalReturned, StringFormat='Da tra: {0}'}" Margin="0,0,12,0" Foreground="#16A34A" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalOutstanding, StringFormat='Con lai: {0}'}" Foreground="#EA580C" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="Lam moi" Command="{Binding RefreshCommand}" Style="{StaticResource FluentSecondaryButton}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F0F4F8" Padding="12,8" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,4,4"/>
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding NewCategory}" Width="100" Margin="0,0,4,4"/>
                <TextBox Text="{Binding NewLocation, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,4,4"/>
                <TextBox Text="{Binding NewFoundBy, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,4,4"/>
                <TextBox Text="{Binding NewColor, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,4,4"/>
                <TextBox Text="{Binding NewBrand, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,4,4"/>
                <Button Content="Dang ky" Command="{Binding RegisterItemCommand}" Style="{StaticResource FluentPrimaryButton}" Padding="8,4" FontSize="11"/>
            </WrapPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Grid.Column="0" Margin="12,8">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:LostFoundDto}">
                    <Border Padding="12,10" Margin="0,0,0,4" CornerRadius="8" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="OnItemClick" Tag="{Binding}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ItemNumber}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <Border CornerRadius="3" Padding="4,1" Background="{Binding Status, Converter={StaticResource StatusToColor}}"><TextBlock Text="{Binding Status}" FontSize="10" Foreground="White"/></Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ItemName}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding FoundLocation, StringFormat=' - {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding OwnerGuestName, StringFormat=' → {0}'}" FontSize="11" Foreground="#2563EB"/></StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding FoundDateTime, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding FoundByStaff}" FontSize="11"/></StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Grid.Column="1" Background="White" BorderBrush="#DDE7F3" BorderThickness="1,0,0,0" Padding="16" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="CHI TIET" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding SelectedItem.ItemNumber}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedItem.ItemName}" FontSize="14"/>
                <TextBlock Text="{Binding SelectedItem.Category}"/>
                <TextBlock Text="{Binding SelectedItem.FoundLocation, StringFormat='Noi tim thay: {0}'}"/>
                <TextBlock Text="{Binding SelectedItem.FoundByStaff, StringFormat='Nguoi tim: {0}'}"/>
                <Separator Margin="0,8"/>
                <WrapPanel>
                    <Button Content="Nhan lai" Command="{Binding ClaimItemCommand}" Style="{StaticResource FluentPrimaryButton}" Padding="8,4" Margin="0,0,4,4"/>
                    <Button Content="Da tra" Command="{Binding ReturnItemCommand}" Style="{StaticResource FluentSecondaryButton}" Padding="8,4"/>
                </WrapPanel>
                <Separator Margin="0,8"/>
                <TextBlock Text="GHEP KHACH" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal"><TextBox Text="{Binding MatchGuestName, UpdateSourceTrigger=PropertyChanged}" Width="180"/><Button Content="Ghep" Command="{Binding MatchGuestCommand}" Style="{StaticResource FluentSecondaryButton}" Padding="6,4" FontSize="11" Margin="4,0,0,0"/></StackPanel>
                <Separator Margin="0,8"/>
                <ItemsControl ItemsSource="{Binding SelectedItem.History}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"><TextBlock Text="Dang tai..." Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
</UserControl>
