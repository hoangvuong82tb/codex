<UserControl x:Class="ASMILE.BO.App.Views.HotelHousekeepingRuleProfileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
 <UserControl.Resources><Style x:Key="B" TargetType="Button" BasedOn="{StaticResource HotelSettingsButtonBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style><Style x:Key="P" TargetType="Button" BasedOn="{StaticResource B}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Style><Style x:Key="T" TargetType="TextBox" BasedOn="{StaticResource HotelSettingsTextBoxBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style><Style x:Key="C" TargetType="ComboBox" BasedOn="{StaticResource HotelSettingsComboBoxBase}"><Setter Property="Height" Value="34"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style></UserControl.Resources>
 <Grid Background="Transparent" Margin="0,0,0,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Padding="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Quy tắc housekeeping" FontSize="22" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Cấu hình loại tác vụ, SLA và điều kiện tự tạo công việc cho nhà buồng." Foreground="#64748B"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Làm mới" Command="{Binding LoadCommand}" Style="{StaticResource B}"/><Button Content="+ Thêm quy tắc" Command="{Binding NewItemCommand}" Style="{StaticResource P}" Margin="0"/></StackPanel></Grid></Border><Border Grid.Row="1" Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Từ khóa" Grid.Column="0" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBlock Text="Loại" Grid.Column="1" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBox Grid.Row="1" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" ToolTip="Tìm mã, tên, bộ phận"/><ComboBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" Style="{StaticResource C}"/><Button Grid.Row="1" Grid.Column="3" Content="Tìm" Command="{Binding SearchCommand}" Style="{StaticResource B}" Margin="8,0,0,0"/></Grid></Border><Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions><Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="False"><ListBox ItemContainerStyle="{StaticResource HotelSettingsListBoxItemStyle}" HorizontalContentAlignment="Stretch" Background="Transparent" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem,Mode=TwoWay}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="#17365D"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Kind}" FontSize="11" Foreground="#94A3B8"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding SlaMinutes,StringFormat={}{0} phút}" Foreground="#475569"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border><Border Grid.Column="1" Margin="16,0,0,0" Padding="16" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" ClipToBounds="True"><StackPanel><StackPanel><TextBlock Text="Chi tiết quy tắc" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="{Binding SelectedSummary}" Foreground="#64748B" Margin="0,4,0,14"/><StackPanel Visibility="{Binding IsEditing,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Mã / tên"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Code,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/><TextBox Grid.Column="2" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/></Grid><TextBlock Text="Loại / bộ phận"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}" Style="{StaticResource C}"/><TextBox Grid.Column="2" Text="{Binding Department,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/></Grid><TextBlock Text="Ưu tiên / SLA phút"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Priority,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/><TextBox Grid.Column="2" Text="{Binding SlaMinutes,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/></Grid><WrapPanel Margin="0,0,0,8"><CheckBox Content="Bắt buộc inspection" IsChecked="{Binding RequiresInspection}" Margin="0,0,16,4"/><CheckBox Content="Tự tạo task" IsChecked="{Binding AutoCreateTask}"/></WrapPanel><TextBlock Text="Hiệu lực từ / đến"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding EffectiveFrom,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/><TextBox Grid.Column="2" Text="{Binding EffectiveTo,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/></Grid><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><Button Content="Hủy" Command="{Binding CancelEditCommand}" Style="{StaticResource B}"/><Button Content="Lưu" Command="{Binding SaveCommand}" Style="{StaticResource P}" Margin="0"/></StackPanel></StackPanel><StackPanel Visibility="{Binding IsReadOnlyPanelVisible,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Trạng thái" Foreground="#64748B"/><TextBlock Text="{Binding SelectedStatus}" FontWeight="SemiBold"/><TextBlock Text="{Binding InfoMessage}" Foreground="#15803D" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock Text="Rule cấu hình độc lập; tác vụ vận hành vẫn được tạo trong module Housekeeping." Foreground="#64748B" TextWrapping="Wrap" Margin="0,14,0,16"/><StackPanel Orientation="Horizontal"><Button Content="Sửa" Command="{Binding EditItemCommand}" Style="{StaticResource P}"/><Button Content="Bật / tạm ngưng" Command="{Binding ToggleActiveCommand}" Style="{StaticResource B}" Margin="0"/></StackPanel></StackPanel><Border Background="#FEF2F2" Padding="10" Margin="0,16,0,0" Visibility="{Binding HasError,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap"/></Border></StackPanel></StackPanel></Border></Grid></Grid>
</UserControl>




