<UserControl x:Class="ASMILE.BO.App.Views.CheckOutStayModalView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" UseLayoutRounding="True"><UserControl.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseCommand}" /></UserControl.InputBindings><Border Style="{StaticResource FO.LargeModalShell}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Tra phong (Check-out)" Style="{StaticResource FO.HubPageTitle}"/><TextBlock Text="Chon ho so InHouse va xac nhan tra phong." Foreground="{StaticResource TextSecondaryBrush}"/><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,14,0,8"/><Button Content="Tim" Command="{Binding SearchCommand}" Style="{StaticResource FluentSecondaryButton}" HorizontalAlignment="Left"/></StackPanel><Grid Grid.Row="1" Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox ItemsSource="{Binding Stays}" SelectedItem="{Binding SelectedStay}"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding GuestName}" FontWeight="SemiBold" Width="180"/><TextBlock Text="{Binding RoomNumber}" Width="80"/><TextBlock Text="{Binding StayNumber}" Width="160"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{StaticResource FO.Status.ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></Grid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><TextBlock Text="{Binding InfoMessage}" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="300" TextWrapping="Wrap"/><Button Content="Tai lai" Command="{Binding ReloadCommand}" IsEnabled="{Binding CanReload}" Style="{StaticResource FluentSecondaryButton}"/><Button Content="Huy" Command="{Binding CloseCommand}" Style="{StaticResource FluentSecondaryButton}"/><Button Content="Xac nhan tra phong" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" Style="{StaticResource FluentPrimaryButton}" Margin="10,0,0,0"/></StackPanel></Grid></Border></UserControl>
