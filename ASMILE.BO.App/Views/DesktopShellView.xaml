<UserControl x:Class="ASMILE.BO.App.Views.DesktopShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:ASMILE.BO.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="920"
             d:DesignWidth="1540"
             Focusable="True"
             PreviewKeyDown="DesktopShellView_PreviewKeyDown">
    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="{Binding TaskbarRowHeight}" />
        </Grid.RowDefinitions>

        <views:DesktopWorkspaceView Grid.Row="0" />

        <Grid Grid.RowSpan="2"
              Panel.ZIndex="40"
              Visibility="{Binding IsStartMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button Background="#01000000"
                    BorderThickness="0"
                    Command="{Binding CloseStartMenuCommand}" />

            <ContentControl x:Name="ShellNavigationFlyoutHost"
                            Style="{StaticResource ShellNavigationFlyoutHostStyle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,76"
                            IsVisibleChanged="ShellNavigationFlyoutHost_IsVisibleChanged" />
        </Grid>

        <Border Grid.RowSpan="2"
                Background="#66FFFFFF"
                Visibility="{Binding IsShellBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="60">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource EnterprisePanelCard}"
                    Padding="18,12">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="90"
                                 Height="8"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="Loading workspace..."
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#294B75"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Border>

        <views:TaskbarView Grid.Row="1"
                           Panel.ZIndex="20"
                           Visibility="{Binding IsTaskbarVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Border Grid.RowSpan="2"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,20,82"
                Background="{StaticResource AccentBlueBrush}"
                CornerRadius="12"
                Padding="16,10"
                Panel.ZIndex="70"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ToastMessage}"
                       Foreground="White"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</UserControl>
