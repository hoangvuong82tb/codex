<Window x:Class="ASMILE.BO.App.Views.GroupCheckInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ASMILE.BO.App.Controls"
        Title="Check-in đoàn" Width="1420" Height="900"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="ModTextBox" TargetType="TextBox"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/><Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModCombo" TargetType="ComboBox"><Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/><Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#7B8DA6" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="6" Stretch="Uniform"/></Grid></Border><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="9" Margin="0,2"><ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModDatePicker" TargetType="DatePicker"><Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker"><Grid><Border x:Name="Root" Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="9" SnapsToDevicePixels="True"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" BorderThickness="0" Background="Transparent" Padding="12,0" VerticalContentAlignment="Center" FontSize="14" FontFamily="Segoe UI" Foreground="#17365D"/><ToggleButton x:Name="PART_Button" Grid.Column="1" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><Border Width="28" Height="28" CornerRadius="7" Background="#F2F6FD"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2F6BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ToggleButton></Grid><Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"><Border Background="White" BorderBrush="#DCE5F1" BorderThickness="1" CornerRadius="14" Padding="0"><Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.16" Color="#62748E"/></Border.Effect><Calendar x:Name="PART_Calendar" Style="{StaticResource FoModernCalendarStyle}" Language="vi-VN" BorderThickness="0" Background="White" SelectedDate="{Binding SelectedDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" DisplayDate="{Binding DisplayDate, RelativeSource={RelativeSource TemplatedParent}}"/></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#AFCBF7"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModDataGrid" TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="#FAFBFD"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="ColumnHeaderHeight" Value="42"/><Setter Property="RowHeight" Value="40"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2F6FC"/><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="10,0"/></Style></Setter.Value></Setter>
        </Style>
        <Style x:Key="BlueBtn" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="22,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GreenBtn" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#16A34A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="22,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GrayBtn" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#F3F6FA"/><Setter Property="Foreground" Value="#52657D"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="Width" Value="110"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#2563EB"/><Setter Property="Background" Value="#F8FAFF"/><Setter Property="BorderBrush" Value="#D7E3FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="14,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EAF2FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DeleteBtn" TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="Width" Value="110"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#DC2626"/><Setter Property="Background" Value="#FFF5F5"/><Setter Property="BorderBrush" Value="#FECACA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="14,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7C3AED" Offset="0"/><GradientStop Color="#5B21B6" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="Check-in đoàn" FontSize="20" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Nhận phòng hàng loạt cho booking đoàn" FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="2" Content="Làm mới" Click="OnRefresh" Style="{StaticResource GrayBtn}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border x:Name="Step0" Width="140" Height="60" CornerRadius="10" Margin="0,0,3,0" Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1.5" Cursor="Hand" Padding="10,8" MouseLeftButtonDown="OnStepClick" Tag="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="7" Background="#2563EB"><TextBlock Text="A" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Chọn đoàn" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/><TextBlock x:Name="Lbl0" Text="Đang nhập" FontSize="9" Foreground="#1E40AF"/></StackPanel></Grid></Border><TextBlock Text="▸" FontSize="14" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,3,0"/>
                <Border x:Name="Step1" Width="140" Height="60" CornerRadius="10" Margin="0,0,3,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" Padding="10,8" MouseLeftButtonDown="OnStepClick" Tag="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="7" Background="#F1F5F9"><TextBlock Text="B" FontSize="13" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Phòng &amp; khách" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/><TextBlock x:Name="Lbl1" Text="Chưa bắt đầu" FontSize="9" Foreground="#64748B"/></StackPanel></Grid></Border><TextBlock Text="▸" FontSize="14" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,3,0"/>
                <Border x:Name="Step2" Width="140" Height="60" CornerRadius="10" Margin="0,0,3,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" Padding="10,8" MouseLeftButtonDown="OnStepClick" Tag="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="7" Background="#F1F5F9"><TextBlock Text="C" FontSize="13" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Giấy tờ" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/><TextBlock x:Name="Lbl2" Text="Chưa bắt đầu" FontSize="9" Foreground="#64748B"/></StackPanel></Grid></Border><TextBlock Text="▸" FontSize="14" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,3,0"/>
                <Border x:Name="Step3" Width="140" Height="60" CornerRadius="10" Margin="0,0,3,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" Padding="10,8" MouseLeftButtonDown="OnStepClick" Tag="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="7" Background="#F1F5F9"><TextBlock Text="D" FontSize="13" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Thông tin lưu trú" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/><TextBlock x:Name="Lbl3" Text="Chưa bắt đầu" FontSize="9" Foreground="#64748B"/></StackPanel></Grid></Border><TextBlock Text="▸" FontSize="14" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,3,0"/>
                <Border x:Name="Step4" Width="140" Height="60" CornerRadius="10" Margin="0,0,3,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" Padding="10,8" MouseLeftButtonDown="OnStepClick" Tag="4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="7" Background="#F1F5F9"><TextBlock Text="E" FontSize="13" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Tài chính" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/><TextBlock x:Name="Lbl4" Text="Chưa bắt đầu" FontSize="9" Foreground="#64748B"/></StackPanel></Grid></Border><TextBlock Text="▸" FontSize="14" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,3,0"/>
                <Border x:Name="Step5" Width="140" Height="60" CornerRadius="10" Margin="0,0,3,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" Padding="10,8" MouseLeftButtonDown="OnStepClick" Tag="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="7" Background="#F1F5F9"><TextBlock Text="F" FontSize="13" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Xác nhận" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/><TextBlock x:Name="Lbl5" Text="Chưa bắt đầu" FontSize="9" Foreground="#64748B"/></StackPanel></Grid></Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="24,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="65*" MinWidth="440"/><ColumnDefinition Width="20"/><ColumnDefinition Width="35*" MinWidth="330"/></Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="26,22">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <Grid>
                <StackPanel x:Name="PanelA"><TextBlock Text="Chọn đoàn" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,14"/>
                    <Border Background="White" Padding="14,12" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,10"><WrapPanel><StackPanel Margin="0,0,10,4"><TextBlock Text="Từ khóa" FontSize="11" Foreground="#94A3B8"/><TextBox Width="200" Style="{StaticResource ModTextBox}"/></StackPanel><StackPanel Margin="0,0,10,4"><TextBlock Text="Ngày đến" FontSize="11" Foreground="#94A3B8"/><DatePicker Width="140" Style="{StaticResource ModDatePicker}"/></StackPanel><StackPanel Margin="0,0,10,4"><TextBlock Text="Trạng thái" FontSize="11" Foreground="#94A3B8"/><ComboBox Width="140" Style="{StaticResource ModCombo}"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Đã xác nhận"/><ComboBoxItem Content="Chờ đến"/></ComboBox></StackPanel><StackPanel Margin="0,14,8,4"><Button Content="Xóa lọc" Style="{StaticResource GrayBtn}"/></StackPanel></WrapPanel></Border>
                    <DataGrid x:Name="GroupGrid" Style="{StaticResource ModDataGrid}" SelectionChanged="OnGroupSelected" MinHeight="260"><DataGrid.Columns><DataGridTextColumn Header="Trạng thái" Binding="{Binding Col8}" Width="110"/><DataGridTextColumn Header="Mã đoàn" Binding="{Binding Col1}" Width="110"/><DataGridTextColumn Header="Tên đoàn" Binding="{Binding Col2}" Width="170"/><DataGridTextColumn Header="Công ty" Binding="{Binding Col3}" Width="120"/><DataGridTextColumn Header="Ngày đến" Binding="{Binding Col4}" Width="100"/><DataGridTextColumn Header="Ngày đi" Binding="{Binding Col5}" Width="100"/><DataGridTextColumn Header="Số phòng" Binding="{Binding Col6}" Width="70"/><DataGridTextColumn Header="Tổng khách" Binding="{Binding Col7}" Width="80"/></DataGrid.Columns></DataGrid>
                </StackPanel>
                <StackPanel x:Name="PanelB" Visibility="Collapsed"><TextBlock Text="Phòng &amp; khách" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,14"/>
                    <WrapPanel Margin="0,0,0,10"><Border Background="#FAFBFD" CornerRadius="8" Padding="10,8" Margin="0,0,8,6" Width="120"><StackPanel><TextBlock Text="Tổng phòng" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="10" FontSize="20" FontWeight="Bold" Foreground="#17365D"/></StackPanel></Border><Border Background="#F0FDF4" CornerRadius="8" Padding="10,8" Margin="0,0,8,6" Width="120"><StackPanel><TextBlock Text="Đã phân" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="7" FontSize="20" FontWeight="Bold" Foreground="#16A34A"/></StackPanel></Border><Border Background="#FFF7ED" CornerRadius="8" Padding="10,8" Margin="0,0,8,6" Width="120"><StackPanel><TextBlock Text="Chưa phân" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="3" FontSize="20" FontWeight="Bold" Foreground="#D97706"/></StackPanel></Border><Border Background="#FAFBFD" CornerRadius="8" Padding="10,8" Width="120"><StackPanel><TextBlock Text="Tổng khách" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="22" FontSize="20" FontWeight="Bold" Foreground="#17365D"/></StackPanel></Border></WrapPanel>
                    <DataGrid x:Name="RoomGrid" Style="{StaticResource ModDataGrid}" MinHeight="260"><DataGrid.Columns><DataGridTextColumn Header="Số phòng" Binding="{Binding Col1}" Width="85"/><DataGridTextColumn Header="Hạng phòng" Binding="{Binding Col2}" Width="100"/><DataGridTextColumn Header="Tầng" Binding="{Binding Col3}" Width="55"/><DataGridTextColumn Header="TT phòng" Binding="{Binding Col4}" Width="95"/><DataGridTextColumn Header="Sức chứa" Binding="{Binding Col5}" Width="65"/><DataGridTextColumn Header="Đã gắn" Binding="{Binding Col6}" Width="60"/><DataGridTextColumn Header="Khách chính" Binding="{Binding Col7}" Width="140"/><DataGridTextColumn Header="Check-in" Binding="{Binding Col8}" Width="105"/></DataGrid.Columns></DataGrid>
                </StackPanel>
                <StackPanel x:Name="PanelC" Visibility="Collapsed"><TextBlock Text="Giấy tờ" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,14"/>
                    <Border Background="White" Padding="14,12" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><Button Content="Quét CCCD" Style="{StaticResource ActionBtn}"/><Button Content="Passport" Style="{StaticResource ActionBtn}" Margin="10,0,0,0"/><Button Content="Nạp ảnh" Style="{StaticResource ActionBtn}" Margin="10,0,0,0"/><Button Content="Khách cũ" Style="{StaticResource ActionBtn}" Margin="10,0,0,0"/><Button Content="Xóa" Style="{StaticResource DeleteBtn}" Margin="10,0,0,0"/></StackPanel></Border>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Họ và tên" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><TextBox Style="{StaticResource ModTextBox}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Giới tính" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><ComboBox Style="{StaticResource ModCombo}"><ComboBoxItem Content="Nam"/><ComboBoxItem Content="Nữ"/></ComboBox></StackPanel></Grid>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ngày sinh" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><TextBox Style="{StaticResource ModTextBox}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Quốc tịch" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><ComboBox Style="{StaticResource ModCombo}"><ComboBoxItem Content="Việt Nam"/></ComboBox></StackPanel></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Số CCCD" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><TextBox Style="{StaticResource ModTextBox}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Địa chỉ" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><TextBox Style="{StaticResource ModTextBox}"/></StackPanel></Grid>
                </StackPanel>
                <StackPanel x:Name="PanelD" Visibility="Collapsed"><TextBlock Text="Thông tin lưu trú" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,14"/>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ngày đến" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><DatePicker Style="{StaticResource ModDatePicker}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Ngày đi" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><DatePicker Style="{StaticResource ModDatePicker}"/></StackPanel></Grid>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Meal Code" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><ComboBox Style="{StaticResource ModCombo}"><ComboBoxItem Content="RO"/><ComboBoxItem Content="BB"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Nguồn" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><ComboBox Style="{StaticResource ModCombo}"><ComboBoxItem Content="Corporate"/><ComboBoxItem Content="Travel Agent"/></ComboBox></StackPanel></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Company / TA" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><TextBox Style="{StaticResource ModTextBox}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Ghi chú đoàn" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><TextBox Style="{StaticResource ModTextBox}"/></StackPanel></Grid>
                </StackPanel>
                <StackPanel x:Name="PanelE" Visibility="Collapsed"><TextBlock Text="Tài chính &amp; Folio" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><RadioButton Content="Folio chung" GroupName="FT" IsChecked="True" FontSize="13" FontFamily="Segoe UI" Margin="0,0,16,0"/><RadioButton Content="Folio riêng" GroupName="FT" FontSize="13" FontFamily="Segoe UI" Margin="0,0,16,0"/><RadioButton Content="Hỗn hợp" GroupName="FT" FontSize="13" FontFamily="Segoe UI"/></StackPanel>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Rate Code" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><TextBox Style="{StaticResource ModTextBox}" Text="CORP"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Giá phòng" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><TextBox Style="{StaticResource ModTextBox}" Text="1.200.000"/></StackPanel></Grid>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tiền tệ" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><ComboBox Style="{StaticResource ModCombo}"><ComboBoxItem Content="VND"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="VAT" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><CheckBox Content="Đã gồm VAT" IsChecked="True" FontSize="13" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Đặt cọc" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><TextBox Style="{StaticResource ModTextBox}" Text="5.000.000"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Hình thức" FontSize="12" Foreground="#52657D" Margin="0,0,0,4"/><ComboBox Style="{StaticResource ModCombo}"><ComboBoxItem Content="Chuyển khoản"/></ComboBox></StackPanel></Grid>
                </StackPanel>
                <StackPanel x:Name="PanelF" Visibility="Collapsed"><TextBlock Text="Xác nhận Check-in đoàn" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,4"/><TextBlock Text="Kiểm tra phòng, khách, giấy tờ và cấu hình Folio trước khi thực hiện." FontSize="13" Foreground="#64748B" Margin="0,0,0,16"/>
                    <WrapPanel Margin="0,0,0,12"><TextBlock x:Name="CheckInKpiText" Text="Chưa có dữ liệu kiểm tra." FontSize="13" Foreground="#64748B" TextWrapping="Wrap"/></WrapPanel>
                    <WrapPanel><TextBlock x:Name="CheckInSummaryText" Text="Chưa chọn đoàn để xác nhận." FontSize="13" Foreground="#64748B" TextWrapping="Wrap"/></WrapPanel>
                    <Border Background="#EFF6FF" CornerRadius="10" Padding="16,14" Margin="0,12,0,0" BorderBrush="#93C5FD" BorderThickness="1"><TextBlock x:Name="CheckInReadinessText" Text="Chưa có dữ liệu kiểm tra." FontSize="14" TextAlignment="Center" Foreground="#1E40AF" FontWeight="SemiBold"/></Border>
                </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20,18">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <StackPanel x:Name="DetailCard"><TextBlock Text="Chi tiết đoàn" FontSize="16" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,14"/>
                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6"><StackPanel><TextBlock Text="Đoàn" FontSize="12" Foreground="#7B8DA6" Margin="0,0,0,6"/><TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" x:Name="DetailGroup" Text="—"/><TextBlock FontSize="13" Foreground="#6F8198" x:Name="DetailGroupInfo" Text="—"/></StackPanel></Border>
                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6"><StackPanel><TextBlock Text="Lưu trú" FontSize="12" Foreground="#7B8DA6" Margin="0,0,0,6"/><TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" x:Name="DetailStay" Text="—"/><TextBlock FontSize="13" Foreground="#6F8198" x:Name="DetailNights" Text="—"/></StackPanel></Border>
                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6"><StackPanel><TextBlock Text="Phòng &amp; khách" FontSize="12" Foreground="#7B8DA6" Margin="0,0,0,6"/><TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" x:Name="DetailRooms" Text="—"/><TextBlock FontSize="13" Foreground="#6F8198" x:Name="DetailGuests" Text="—"/></StackPanel></Border>
                    <Border Background="#EEF4FF" BorderBrush="#CFE0FF" BorderThickness="1" CornerRadius="8" Padding="14,10"><TextBlock Text="Chọn một đoàn để tiếp tục." FontSize="13" Foreground="#1E40AF" TextAlignment="Center"/></Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="20,14" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StepLabel" Text="Bước A/6" FontSize="13" Foreground="#64748B"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Đóng" Click="OnClose" Style="{StaticResource GrayBtn}"/>
                    <Button Content="← Quay lại" Click="OnBack" x:Name="BackBtn" Style="{StaticResource GrayBtn}" Margin="10,0,0,0" Visibility="Collapsed"/>
                    <Button Content="Tiếp theo →" Click="OnNext" x:Name="NextBtn" Style="{StaticResource BlueBtn}" Margin="10,0,0,0"/>
                    <Button Content="Thực hiện Check-in đoàn" Click="OnExecute" x:Name="ExecuteBtn" Style="{StaticResource GreenBtn}" Margin="10,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
