<UserControl x:Class="ASMILE.BO.App.Views.VirtualExplorerView"
             x:Name="RootExplorer"
             AutomationProperties.AutomationId="VfcRootExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dto="clr-namespace:ASMILE.BO.Application.DTOs;assembly=ASMILE.BO.Application"
             xmlns:controls="clr-namespace:ASMILE.BO.App.Controls"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             xmlns:models="clr-namespace:ASMILE.BO.App.Models"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1520"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <converters:VirtualExplorerNodeIconConverter x:Key="VirtualExplorerNodeIconConverter" />
    </UserControl.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="47" />
            <RowDefinition Height="19" />
            <RowDefinition />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F9FBFE" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1" Padding="10,5,10,4">
            <DockPanel LastChildFill="False" VerticalAlignment="Bottom">
                <ItemsControl DockPanel.Dock="Left"
                              ItemsSource="{Binding Tabs}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ExplorerTabItem}">
                            <Border CornerRadius="8,8,0,0"
                                    BorderThickness="1,1,1,0"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    BorderBrush="#CFD9E7">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Đóng tab"
                                                  Command="{Binding DataContext.CloseTabCommand, Source={x:Reference RootExplorer}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Mở tab này ở cửa sổ mới"
                                                  Command="{Binding DataContext.OpenTabInNewWindowCommand, Source={x:Reference RootExplorer}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#EAF0F7" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#E5EAF2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Command="{Binding DataContext.ActivateTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FocusVisualStyle="{x:Null}"
                                            Padding="10,5,8,5">
                                        <DockPanel LastChildFill="False">
                                            <Image Source="pack://siteoforigin:,,,/Windows_Icon/Icons/folders/folder.ico" Width="14" Height="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Title}" Foreground="#1F1F1F" FontSize="12.5" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>

                                    <Button Grid.Column="1"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FocusVisualStyle="{x:Null}"
                                            Width="24"
                                            Padding="0"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="#6F7C8E" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button DockPanel.Dock="Left"
                        Command="{Binding AddTabCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        FocusVisualStyle="{x:Null}"
                        Padding="8,4,8,4"
                        Margin="0,0,0,2"
                        VerticalAlignment="Bottom"
                        Cursor="Hand">
                    <DockPanel LastChildFill="False">
                        <Border Width="1" Height="16" Background="#D6DEEA" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="+" FontSize="16" Foreground="#4A617F" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Background="#FFFFFF" Margin="8,2,8,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource ExplorerNavGlyphButtonStyle}" Command="{Binding BackCommand}"
                    ToolTip="Quay lại" ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.Name="Quay lại" AutomationProperties.AutomationId="VfcBackButton">
                <TextBlock Text="←" FontFamily="Segoe UI Symbol" FontSize="16"
                           Foreground="#2D3748" HorizontalAlignment="Center" VerticalAlignment="Center"
                           AutomationProperties.Name="Biểu tượng Quay lại" AutomationProperties.AutomationId="VfcBackIcon" />
            </Button>
            <Button Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource ExplorerNavGlyphButtonStyle}" Command="{Binding ForwardCommand}"
                    ToolTip="Tiến tới" ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.Name="Tiến tới" AutomationProperties.AutomationId="VfcForwardButton">
                <TextBlock Text="→" FontFamily="Segoe UI Symbol" FontSize="16"
                           Foreground="#2D3748" HorizontalAlignment="Center" VerticalAlignment="Center"
                           AutomationProperties.Name="Biểu tượng Tiến tới" AutomationProperties.AutomationId="VfcForwardIcon" />
            </Button>
            <Button Grid.Column="2" Margin="4,0,0,0" Style="{StaticResource ExplorerNavGlyphButtonStyle}" Command="{Binding UpCommand}"
                    ToolTip="Lên thư mục cha" ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.Name="Lên thư mục cha" AutomationProperties.AutomationId="VfcUpButton">
                <TextBlock Text="↑" FontFamily="Segoe UI Symbol" FontSize="16"
                           Foreground="#2D3748" HorizontalAlignment="Center" VerticalAlignment="Center"
                           AutomationProperties.Name="Biểu tượng Lên thư mục cha" AutomationProperties.AutomationId="VfcUpIcon" />
            </Button>
            <Button Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource ExplorerNavGlyphButtonStyle}" Command="{Binding RefreshCommand}"
                    ToolTip="Làm mới" ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.Name="Làm mới" AutomationProperties.AutomationId="VfcRefreshButton">
                <TextBlock Text="↻" FontFamily="Segoe UI Symbol" FontSize="16"
                           Foreground="#2D3748" HorizontalAlignment="Center" VerticalAlignment="Center"
                           AutomationProperties.Name="Biểu tượng Làm mới" AutomationProperties.AutomationId="VfcRefreshIcon" />
            </Button>

            <controls:ExplorerBreadcrumb Grid.Column="5"
                                         VerticalAlignment="Center"
                                         Segments="{Binding BreadcrumbItems}"
                                         NavigateSegmentCommand="{Binding NavigateBreadcrumbCommand}" />

            <controls:SearchBoxControl Grid.Column="7"
                                       Width="240"
                                       MinWidth="190"
                                       MaxWidth="270"
                                       Height="32"
                                       VerticalAlignment="Center"
                                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                       Placeholder="{Binding SearchPlaceholder}" />
        </Grid>

        <controls:ExplorerCommandBar Grid.Row="2" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="280" />
                            <Setter Property="MinWidth" Value="220" />
                            <Setter Property="MaxWidth" Value="460" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsNavigationPaneVisible, ElementName=RootExplorer}" Value="False">
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MaxWidth" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="2">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="2" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsNavigationPaneVisible, ElementName=RootExplorer}" Value="False">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="2" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsRightPaneVisible, ElementName=RootExplorer}" Value="False">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="360">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="360" />
                            <Setter Property="MinWidth" Value="340" />
                            <Setter Property="MaxWidth" Value="420" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsRightPaneVisible, ElementName=RootExplorer}" Value="False">
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MaxWidth" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF"
                    Visibility="{Binding IsNavigationPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TreeView x:Name="NavigationTreeView"
                          Margin="8,8,8,6"
                          Style="{StaticResource ExplorerNavTreeViewStyle}"
                          ItemContainerStyle="{StaticResource ExplorerNavTreeItemStyle}"
                          ItemsSource="{Binding NavigationNodes}"
                          SelectedItemChanged="NavigationTreeView_SelectedItemChanged">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type models:ExplorerNavNode}" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Title}" Visibility="Collapsed" />
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="2"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="#E5EAF2"
                          ShowsPreview="False"
                          Cursor="SizeWE"
                          Visibility="{Binding IsNavigationPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Grid Grid.Column="2" Background="#FFFFFF">
                <Grid Visibility="{Binding IsThisPcView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,12,14,14">
                            <TextBlock Text="Devices and drives" Foreground="#1F1F1F" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding DriveItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ExplorerDriveItemModel}">
                                        <Border Margin="0,0,10,10" Cursor="Hand"
                                                PreviewMouseLeftButtonDown="DriveCard_PreviewMouseLeftButtonDown"
                                                MouseLeftButtonUp="DriveCard_MouseLeftButtonUp">
                                            <controls:ExplorerDriveItem Item="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Network locations" Foreground="#1F1F1F" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,12" />
                            <ItemsControl ItemsSource="{Binding NetworkLocationItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ExplorerDriveItemModel}">
                                        <Border Margin="0,0,10,10" Cursor="Hand"
                                                PreviewMouseLeftButtonDown="DriveCard_PreviewMouseLeftButtonDown"
                                                MouseLeftButtonUp="DriveCard_MouseLeftButtonUp">
                                            <controls:ExplorerDriveItem Item="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsThisPcView}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ListBox x:Name="CurrentItemsIconList"
                             AutomationProperties.AutomationId="VfcCurrentItemsIconList"
                             Margin="8,8,8,8"
                             ItemsSource="{Binding CurrentItems}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             PreviewMouseLeftButtonDown="CurrentItemsListView_PreviewMouseLeftButtonDown"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIconViewMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="6" />
                                <Setter Property="Padding" Value="8" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemRoot" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemRoot" Property="Background" Value="#F3F6FA" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemRoot" Property="Background" Value="#E8F1FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type dto:VirtualExplorerNodeDto}">
                                <StackPanel Width="130">
                                    <Image Source="{Binding Converter={StaticResource VirtualExplorerNodeIconConverter}}"
                                           Width="{Binding DataContext.ItemIconSize, ElementName=RootExplorer}"
                                           Height="{Binding DataContext.ItemIconSize, ElementName=RootExplorer}"
                                           HorizontalAlignment="Center"
                                           Stretch="Uniform" />
                                    <TextBlock Text="{Binding DisplayName}"
                                               Margin="0,8,0,0"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="#1F1F1F" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListView x:Name="CurrentItemsListView"
                              AutomationProperties.AutomationId="VfcCurrentItemsListView"
                              Margin="0"
                              ItemsSource="{Binding CurrentItems}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              Loaded="CurrentItemsListView_Loaded"
                              SizeChanged="CurrentItemsListView_SizeChanged"
                              LayoutUpdated="CurrentItemsListView_LayoutUpdated"
                              PreviewMouseLeftButtonDown="CurrentItemsListView_PreviewMouseLeftButtonDown"
                              BorderThickness="0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.Style>
                            <Style TargetType="ListView">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIconViewMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Style>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Height" Value="34" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsCompactView, ElementName=RootExplorer}" Value="True">
                                        <Setter Property="Height" Value="28" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="Name" Width="280">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type dto:VirtualExplorerNodeDto}">
                                            <DockPanel Margin="8,4">
                                                <CheckBox Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding DataContext.IsItemCheckBoxes, ElementName=RootExplorer, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Image Source="{Binding Converter={StaticResource VirtualExplorerNodeIconConverter}}"
                                                       Width="16"
                                                       Height="16"
                                                       Margin="0,0,8,0"
                                                       Stretch="Uniform" />
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#1F1F1F" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Type" Width="140" DisplayMemberBinding="{Binding NodeType}" />
                                <GridViewColumn Header="Module" Width="140" DisplayMemberBinding="{Binding Module}" />
                                <GridViewColumn Header="Ngày giờ" Width="170">
                                    <GridViewColumn.DisplayMemberBinding>
                                        <Binding Path="DateModified"
                                                 StringFormat="dd/MM/yyyy h:mm tt"
                                                 TargetNullValue="" />
                                    </GridViewColumn.DisplayMemberBinding>
                                </GridViewColumn>
                                <GridViewColumn Header="Virtual Path" Width="420" DisplayMemberBinding="{Binding VirtualPath}" />
                            </GridView>
                        </ListView.View>
                        <ListView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Open" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedItem, ElementName=CurrentItemsListView}" />
                                <MenuItem Header="Print" Command="{Binding PrintCommand}" />
                                <MenuItem Header="Export PDF" Command="{Binding ExportPdfCommand}" />
                                <Separator />
                                <MenuItem Header="View Details" Command="{Binding ViewDetailsCommand}" />
                                <MenuItem Header="Open Location" Command="{Binding OpenLocationCommand}" />
                                <MenuItem Header="Copy Virtual Path" Command="{Binding CopyVirtualPathCommand}" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Width="2"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="#E5EAF2"
                          ShowsPreview="False"
                          Cursor="SizeWE"
                          Visibility="{Binding IsRightPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Grid.Column="4"
                    Background="#FFFFFF"
                    Visibility="{Binding IsRightPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="14,12">
                    <TextBlock Text="Preview" FontSize="15" FontWeight="SemiBold" Foreground="#1F1F1F" />
                    <Border Height="1" Background="#E5EAF2" Margin="0,8,0,12" />
                    <TextBlock Text="{Binding PreviewTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#1F1F1F" TextWrapping="Wrap" />
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviewVirtualLocation}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding PreviewCode, StringFormat=Mã: {0}}" Foreground="#5F6B7A" FontSize="12.5" />
                        <TextBlock Text="{Binding PreviewDate, StringFormat=Ngày: {0}}" Margin="0,6,0,0" Foreground="#5F6B7A" FontSize="12.5" />
                        <TextBlock Text="{Binding PreviewEntity, StringFormat=Đối tượng: {0}}" Margin="0,6,0,0" Foreground="#5F6B7A" FontSize="12.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PreviewAmount, StringFormat=Số tiền: {0}}" Margin="0,6,0,0" Foreground="#5F6B7A" FontSize="12.5" />
                        <TextBlock Text="{Binding PreviewStatus, StringFormat=Trạng thái: {0}}" Margin="0,6,0,0" Foreground="#5F6B7A" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding IsPreviewVirtualLocation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding PreviewLocationType, StringFormat=Loại: {0}}" Foreground="#5F6B7A" FontSize="12.5" />
                        <TextBlock Text="{Binding PreviewLocationPath, StringFormat=Đường dẫn ảo: {0}}" Margin="0,6,0,0" Foreground="#5F6B7A" FontSize="12.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PreviewLocationStatus, StringFormat=Trạng thái: {0}}" Margin="0,6,0,0" Foreground="#5F6B7A" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                                Visibility="{Binding IsPreviewDocument, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Style="{StaticResource FluentSecondaryButton}" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedItem}" MinWidth="90">
                            <TextBlock Text="Open" />
                        </Button>
                        <Button Style="{StaticResource FluentSecondaryButton}" Command="{Binding PrintCommand}" Margin="8,0,0,0" MinWidth="90">
                            <TextBlock Text="Print" />
                        </Button>
                        <Button Style="{StaticResource FluentPrimaryButton}" Command="{Binding ExportPdfCommand}" Margin="8,0,0,0" MinWidth="110">
                            <TextBlock Text="Export PDF" Foreground="#FFFFFF" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E5EAF2" BorderThickness="1,1,0,0" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="#5F6B7A" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Image Source="pack://siteoforigin:,,,/Windows_Icon/Icons/applications/layout.ico" Width="14" Height="14" Margin="0,0,10,0" />
                    <Image Source="pack://siteoforigin:,,,/Windows_Icon/Icons/applications/taskview2.ico" Width="14" Height="14" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
