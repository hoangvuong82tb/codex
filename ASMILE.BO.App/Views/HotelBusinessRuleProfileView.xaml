<UserControl x:Class="ASMILE.BO.App.Views.HotelBusinessRuleProfileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
 <UserControl.Resources><Style x:Key="B" TargetType="Button" BasedOn="{StaticResource HotelSettingsButtonBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#FFF"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/></Style><Style x:Key="P" TargetType="Button" BasedOn="{StaticResource B}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="#FFF"/><Setter Property="BorderBrush" Value="#2563EB"/></Style><Style x:Key="I" TargetType="TextBox" BasedOn="{StaticResource HotelSettingsTextBoxBase}"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,0"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style></UserControl.Resources>
 <Grid Background="Transparent" Margin="0,0,0,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Padding="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Business rules / Rule Engine" FontSize="22" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Khai báo rule dạng tham chiếu, ưu tiên, chặn/độc quyền và thời gian hiệu lực." Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Làm mới" Command="{Binding LoadCommand}" Style="{StaticResource B}"/><Button Content="+ Thêm rule" Command="{Binding NewItemCommand}" Style="{StaticResource P}" Margin="0"/></StackPanel></Grid></Border><Border Grid.Row="1" Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Từ khóa" Grid.Column="0" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBox Grid.Row="1" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource I}" ToolTip="Tìm mã, domain hoặc condition reference"/><Button Grid.Row="1" Grid.Column="1" Content="Tìm" Command="{Binding SearchCommand}" Style="{StaticResource B}" Margin="8,0,0,0"/></Grid></Border><Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions><Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="False"><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#F8FAFC" CornerRadius="10" ClipToBounds="True" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="Mã" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Rule" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Domain" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Ưu tiên / Chế độ" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></Border><ListBox ItemContainerStyle="{StaticResource HotelSettingsListBoxItemStyle}" HorizontalContentAlignment="Stretch" Background="Transparent" Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem,Mode=TwoWay}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#17365D"/><TextBlock Grid.Column="2" Text="{Binding Domain}" Foreground="#17365D"/><StackPanel Grid.Column="3"><TextBlock Text="{Binding Priority}" Foreground="#17365D"/><TextBlock Text="{Binding IsBlocking,StringFormat=Blocking: {0}}" Foreground="#64748B" FontSize="11"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border><Border Grid.Column="1" Margin="16,0,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16"><StackPanel><StackPanel><TextBlock Text="Chi tiết business rule" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="{Binding SelectedSummary}" Foreground="#64748B" Margin="0,4,0,8"/><TextBlock Text="Condition là tham chiếu declarative; không lưu hoặc thực thi mã tùy ý trong cấu hình." Foreground="#0369A1" TextWrapping="Wrap" Margin="0,0,0,12"/><StackPanel Visibility="{Binding IsEditing,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Mã / tên"/><Grid Margin="0,3,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Code,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource I}" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource I}" Grid.Column="2" HorizontalAlignment="Stretch" Margin="0"/></Grid><TextBlock Text="Domain / ưu tiên"/><Grid Margin="0,3,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Domain,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource I}" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0"/><TextBox Text="{Binding Priority}" Style="{StaticResource I}" Grid.Column="2" HorizontalAlignment="Stretch" Margin="0"/></Grid><TextBlock Text="Condition reference"/><TextBox Text="{Binding ConditionReference,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource I}" Height="55" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,3,0,7"/><TextBlock Text="Hiệu lực từ / đến"/><Grid Margin="0,3,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding EffectiveFrom}" Style="{StaticResource I}" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0"/><TextBox Text="{Binding EffectiveTo}" Style="{StaticResource I}" Grid.Column="2" HorizontalAlignment="Stretch" Margin="0"/></Grid><CheckBox Content="Blocking (chặn giao dịch)" IsChecked="{Binding IsBlocking}" Margin="0,3,0,6"/><CheckBox Content="Exclusive (dừng rule sau khi khớp)" IsChecked="{Binding IsExclusive}" Margin="0,0,0,8"/><TextBlock Text="Mô tả"/><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource I}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,3,0,10"/><StackPanel Orientation="Horizontal"><Button Content="Lưu" Command="{Binding SaveCommand}" Style="{StaticResource P}"/><Button Content="Hủy" Command="{Binding CancelEditCommand}" Style="{StaticResource B}" Margin="0"/></StackPanel></StackPanel><StackPanel Visibility="{Binding IsReadOnlyPanelVisible,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Trạng thái" Foreground="#64748B"/><TextBlock Text="{Binding SelectedStatus}" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,2,0,14"/><Button Content="Sửa rule" Command="{Binding EditItemCommand}" Style="{StaticResource P}"/><Button Content="Bật / tạm ngưng" Command="{Binding ToggleActiveCommand}" Style="{StaticResource B}" Margin="0,8,0,0"/></StackPanel><TextBlock Text="{Binding InfoMessage}" Foreground="#15803D" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></StackPanel></Border></Grid></Grid>
</UserControl>




