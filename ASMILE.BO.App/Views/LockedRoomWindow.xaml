<Window x:Class="ASMILE.BO.App.Views.LockedRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phòng khóa" Width="1420" Height="880"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="ModTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBox">
                    <Grid><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/>
                            <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#7B8DA6" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="6" Stretch="Uniform"/>
                        </Grid></Border>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="9" Margin="0,2"><ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border>
                        </Popup>
                    </Grid></ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="CalendarStyle" Value="{StaticResource FoModernCalendarStyle}"/>
            <Setter Property="FirstDayOfWeek" Value="Monday"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
                <Grid>
                    <Border x:Name="Root" Background="White" BorderBrush="#D7E2F0" BorderThickness="1" CornerRadius="9" SnapsToDevicePixels="True"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <DatePickerTextBox x:Name="PART_TextBox" BorderThickness="0" Background="Transparent" Padding="12,0" VerticalContentAlignment="Center" FontSize="13" FontFamily="Segoe UI" Foreground="#17365D"/>
                            <TextBlock x:Name="Watermark" Text="Chọn ngày" IsHitTestVisible="False" Background="White"
                                       FontSize="13" FontFamily="Segoe UI" Foreground="#94A3B8" Padding="12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <ToggleButton x:Name="PART_Button" Grid.Column="1" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#F2F6FD">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2F6BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ToggleButton>
                    </Grid>
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                        <Calendar x:Name="PART_Calendar" Style="{StaticResource FoModernCalendarStyle}" Language="vi-VN" BorderThickness="0" Background="White" SelectedDate="{Binding SelectedDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" DisplayDate="{Binding DisplayDate, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#AFCBF7"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#2F6BFF"/></Trigger>
                    <DataTrigger Binding="{Binding SelectedDate, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                        <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ModDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/><Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="RowHeight" Value="42"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value><Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F2F6FC"/><Setter Property="Foreground" Value="#475569"/>
                    <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="Padding" Value="10,0"/>
                </Style></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlueBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border></ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GrayBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border></ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource BlueBtn}">
            <Setter Property="Background" Value="#16A34A"/>
        </Style>

        <Style x:Key="OutlineBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BadgeRed" TargetType="Border"><Setter Property="Background" Value="#FEE2E2"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="BadgeOrange" TargetType="Border"><Setter Property="Background" Value="#FFF7ED"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="BadgeGray" TargetType="Border"><Setter Property="Background" Value="#F3F4F6"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>

        <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="#FAFBFD"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12,10"/></Style>
        <Style x:Key="ActionCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F59E0B" Offset="0"/><GradientStop Color="#D97706" Offset="1"/>
                    </LinearGradientBrush></Border.Background>
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Phòng khóa" FontSize="20" FontWeight="SemiBold" Foreground="#102E5A"/>
                    <TextBlock Text="Khóa phòng để sửa chữa, vệ sinh hoặc bảo trì" FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Làm mới" Click="OnRefresh" Style="{StaticResource GrayBtn}"/>
            </Grid>
        </Border>

        <!-- ═══ FILTER BAR ═══ -->
        <Border Grid.Row="1" Margin="14,10,14,6" Padding="14,12" Background="White" CornerRadius="12" BorderBrush="#D8E2F0" BorderThickness="1">
            <WrapPanel>
                <StackPanel Margin="0,0,10,4"><TextBlock Text="Từ khóa" FontSize="11" Foreground="#94A3B8"/><TextBox x:Name="SearchBox" Width="180" Style="{StaticResource ModTextBox}"/></StackPanel>
                <StackPanel Margin="0,0,10,4"><TextBlock Text="Tầng" FontSize="11" Foreground="#94A3B8"/><ComboBox Width="100" Style="{StaticResource ModCombo}" x:Name="FloorFilter" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/></ComboBox></StackPanel>
                <StackPanel Margin="0,0,10,4"><TextBlock Text="Trạng thái" FontSize="11" Foreground="#94A3B8"/><ComboBox Width="140" Style="{StaticResource ModCombo}" x:Name="StatusFilter" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Đang khóa"/><ComboBoxItem Content="Sắp mở"/><ComboBoxItem Content="Đã hết hạn"/></ComboBox></StackPanel>
                <StackPanel Margin="0,0,10,4"><TextBlock Text="Loại khóa" FontSize="11" Foreground="#94A3B8"/><ComboBox Width="150" Style="{StaticResource ModCombo}" x:Name="TypeFilter" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Bảo trì"/><ComboBoxItem Content="Vệ sinh"/><ComboBoxItem Content="Sửa chữa"/><ComboBoxItem Content="Kiểm kê"/><ComboBoxItem Content="Khác"/></ComboBox></StackPanel>
                <StackPanel Margin="0,0,10,4"><TextBlock Text="Ngày bắt đầu" FontSize="11" Foreground="#94A3B8"/><DatePicker Width="150" Style="{StaticResource ModDatePicker}"/></StackPanel>
                <StackPanel Margin="0,0,10,4"><TextBlock Text="Ngày kết thúc" FontSize="11" Foreground="#94A3B8"/><DatePicker Width="150" Style="{StaticResource ModDatePicker}"/></StackPanel>
                <StackPanel Margin="0,16,6,4"><Button Content="Tìm" Click="OnRefresh" Style="{StaticResource BlueBtn}" Width="80"/></StackPanel>
                <StackPanel Margin="0,16,0,4"><Button Content="Xóa lọc" Click="OnClearFilter" Style="{StaticResource GrayBtn}"/></StackPanel>
            </WrapPanel>
        </Border>

        <!-- ═══ MAIN: 2 cột ═══ -->
        <Grid Grid.Row="2" Margin="14,4,14,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="6.8*" MinWidth="520"/><ColumnDefinition Width="14"/><ColumnDefinition Width="3.2*" MinWidth="340"/></Grid.ColumnDefinitions>

            <!-- ═══ CỘT TRÁI: DataGrid ═══ -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Danh sách phòng khóa" FontSize="14" FontWeight="SemiBold" Foreground="#102E5A"/>
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="#94A3B8" x:Name="ResultCount" Text="12 phòng"/>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" x:Name="LockedGrid" Style="{StaticResource ModDataGrid}" SelectionChanged="OnRoomSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Số phòng" Binding="{Binding RoomNumber}" Width="80"/>
                            <DataGridTextColumn Header="Loại phòng" Binding="{Binding RoomType}" Width="90"/>
                            <DataGridTextColumn Header="Tầng" Binding="{Binding Floor}" Width="60"/>
                            <DataGridTextColumn Header="Trạng thái phòng" Binding="{Binding RoomStatus}" Width="120"/>
                            <DataGridTemplateColumn Header="Trạng thái khóa" Width="110">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Left"
                                            Background="{Binding LockStatusBadge}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LockStatus}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding LockStatusColor}" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="140"/>
                            <DataGridTextColumn Header="Người khóa" Binding="{Binding LockedBy}" Width="110"/>
                            <DataGridTextColumn Header="Ngày bắt đầu" Binding="{Binding StartDate}" Width="100"/>
                            <DataGridTextColumn Header="Ngày kết thúc" Binding="{Binding EndDate}" Width="100"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ═══ CỘT PHẢI: Chi tiết + Thao tác ═══ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <!-- ═══ Card chi tiết ═══ -->
                <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Chi tiết phòng khóa" FontSize="15" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,14"/>
                        <StackPanel x:Name="DetailPanel">
                            <TextBlock Text="Chọn một phòng để xem chi tiết." FontSize="13" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ Card thao tác ═══ -->
                <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Thao tác" FontSize="15" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,14"/>
                        <Button Content="Khóa phòng" Click="OnLockRoom" Style="{StaticResource BlueBtn}" Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
                        <Button Content="Mở khóa" Click="OnUnlockRoom" Style="{StaticResource GreenBtn}" Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
                        <Button Content="Gia hạn" Click="OnExtendLock" Style="{StaticResource OutlineBtn}" Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
                        <Button Content="Xem lịch sử" Click="OnViewHistory" Style="{StaticResource OutlineBtn}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ FOOTER ═══ -->
        <Border Grid.Row="3" Padding="14,10" Margin="14,10,14,12" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#64748B" x:Name="FooterTotal" Text="Tổng: 12 phòng"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="← Trước" Style="{StaticResource GrayBtn}"/>
                    <Button Content="Sau →" Style="{StaticResource GrayBtn}" Margin="8,0,0,0"/>
                    <Button Content="Đóng" Click="OnClose" Style="{StaticResource GrayBtn}" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
