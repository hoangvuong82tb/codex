<Window x:Class="ASMILE.BO.App.Views.InvoiceProviderConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình hóa đơn điện tử" Width="900" Height="620"
        MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F8FAFC" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#0F2747"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="FieldPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#0F2747"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="18,12" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Cấu hình hóa đơn điện tử" FontSize="18" FontWeight="SemiBold" Foreground="#102E5A"/>
                    <TextBlock Text="Quản lý provider theo công ty/chi nhánh. Secret được mã hóa và không hiển thị lại." FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Đóng" Click="OnClose" Style="{StaticResource SecondaryButton}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="16,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Provider đã cấu hình" FontSize="13" FontWeight="SemiBold" Foreground="#102E5A" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Mới" Click="OnNew" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0"/>
                        </Grid>
                        <TextBlock Text="Chỉ provider active/default mới được dùng khi lập hóa đơn." TextWrapping="Wrap" FontSize="10" Foreground="#64748B" Margin="0,5,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="ProviderList" BorderThickness="0" SelectionChanged="OnSelectionChanged">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Padding="9,8" Margin="0,0,0,5" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding ProviderCode}" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                        <TextBlock DockPanel.Dock="Right" Text="Mặc định" Foreground="#15803D" FontSize="10" Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="#334155" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding EndpointUrl}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Thông tin kết nối" FontSize="15" FontWeight="SemiBold" Foreground="#102E5A"/>
                        <TextBlock x:Name="ModeText" Text="Cấu hình mới" FontSize="11" Foreground="#64748B" Margin="0,3,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Provider" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,10,12" Foreground="#475569"/>
                            <ComboBox x:Name="ProviderCodeBox" Grid.Row="0" Grid.Column="1" Height="32" FontSize="12" Margin="0,0,0,12"/>
                            <TextBlock Text="Tên hiển thị" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,10,12" Foreground="#475569"/>
                            <TextBox x:Name="DisplayNameBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>
                            <TextBlock Text="Endpoint URL" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,10,12" Foreground="#475569"/>
                            <TextBox x:Name="EndpointBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>
                            <TextBlock Text="Tenant / MST" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,10,12" Foreground="#475569"/>
                            <TextBox x:Name="TenantBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>
                            <TextBlock Text="Username" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,10,12" Foreground="#475569"/>
                            <TextBox x:Name="UsernameBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>
                            <TextBlock Text="Secret / Token" Grid.Row="5" VerticalAlignment="Center" Margin="0,0,10,12" Foreground="#475569"/>
                            <PasswordBox x:Name="SecretBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldPassword}" Margin="0,0,0,12"/>
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                <CheckBox x:Name="ActiveBox" Content="Đang hoạt động" IsChecked="True" Margin="0,0,24,0" Foreground="#334155"/>
                                <CheckBox x:Name="DefaultBox" Content="Provider mặc định" Foreground="#334155"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,16,0,0">
                            <TextBlock Text="Lưu cấu hình không tự biến provider thành adapter thật. Nếu chưa cài adapter/API được phê duyệt, hệ thống vẫn từ chối phát hành và không ghi trạng thái Issued giả." TextWrapping="Wrap" FontSize="11" Foreground="#9A3412"/>
                        </Border>
                        <TextBlock x:Name="StatusText" Text="" TextWrapping="Wrap" FontSize="11" Foreground="#475569" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" Padding="16,9" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid><TextBlock Text="Secret để trống khi cập nhật nếu muốn giữ secret hiện tại." FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Tải lại" Click="OnRefresh" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Lưu cấu hình" Click="OnSave" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid>
        </Border>
    </Grid>
</Window>
