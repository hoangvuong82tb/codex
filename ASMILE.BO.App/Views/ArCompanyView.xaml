                    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Tổng quan" Click="OnDetailTabClick" Tag="0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailTabBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="0"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="Contacts" Click="OnDetailTabClick" Tag="1"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailTabBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="1"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="Thanh toán" Click="OnDetailTabClick" Tag="2"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailTabBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="2"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="Hợp đồng" Click="OnDetailTabClick" Tag="3"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailTabBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="3"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="Giá" Click="OnDetailTabClick" Tag="4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailTabBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="4"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="Sales" Click="OnDetailTabClick" Tag="5"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailTabBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="5"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="Đặt phòng" Click="OnDetailTabClick" Tag="6"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailTabBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="6"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="Đoàn" Click="OnDetailTabClick" Tag="7"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailTabBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="7"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="Folio" Click="OnDetailTabClick" Tag="8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailTabBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="8"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="Hóa đơn" Click="OnDetailTabClick" Tag="9"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailTabBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="9"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="Thanh toán" Click="OnDetailTabClick" Tag="10"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailTabBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="10"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="Công nợ" Click="OnDetailTabClick" Tag="11"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailTabBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="11"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="File" Click="OnDetailTabClick" Tag="12"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailTabBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="12"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="Lịch sử" Click="OnDetailTabClick" Tag="13"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailTabBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="13"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="CRM" Click="OnDetailTabClick" Tag="14"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailTabBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="14"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0">
                        <Grid Margin="16,12">
                            <!-- TAB 0: OVERVIEW -->
                            <StackPanel Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="THÔNG TIN DOANH NGHIỆP" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Mã" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.CompanyCode}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="Tên" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.CompanyName}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="2" Text="Tên tắt" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.ShortName, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="3" Text="Tên TA" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.EnglishName, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="4" Text="Loại" FontSize="10" Foreground="#94A3B8"/><Border Grid.Row="4" Grid.Column="1" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" Background="{Binding SelectedItem.TypeBg, Converter={StaticResource StringToBrush}}"><TextBlock Text="{Binding SelectedItem.TypeLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding SelectedItem.TypeColor, Converter={StaticResource StringToBrush}}"/></Border>
                                    <TextBlock Grid.Row="5" Text="MST" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedItem.TaxCode, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="6" Text="GPKD" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedItem.BusinessLicense, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="7" Text="Thành lập" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedItem.FoundedDate, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="11"/>
                                    <TextBlock Grid.Row="8" Text="Nhân viên" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedItem.EmployeeCount, StringFormat='{}{0:N0}'}" FontSize="11"/>
                                    <TextBlock Grid.Row="9" Text="Địa chỉ" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedItem.Address, TargetNullValue='—'}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="10" Text="Phone" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedItem.Phone, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="11" Text="Email" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding SelectedItem.Email, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="12" Text="Website" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding SelectedItem.Website, TargetNullValue='—'}" FontSize="11"/>
                                </Grid>
                                <Separator Margin="0,10" Background="#F1F5F9"/>
                                <TextBlock Text="ĐỊA CHỈ" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Billing" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.BillingAddress, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Text="Invoice" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.InvoiceAddress, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="2" Text="Shipping" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.ShippingAddress, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="3" Text="Quốc gia" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.Country, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="4" Text="Tỉnh/TP" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.Province, TargetNullValue='—'}" FontSize="11"/>
                                </Grid>
                            </StackPanel>

                            <!-- TAB 1: CONTACTS -->
                            <StackPanel Visibility="{Binding IsContactsTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="NGƯỜI LIÊN HỆ" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <ItemsControl ItemsSource="{Binding SelectedItem.Contacts}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArCompanyContactDto}">
                                    <Border Padding="10,7" Margin="0,0,0,5" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                                                    <Border CornerRadius="4" Padding="3,0" Margin="4,0,0,0" Background="#DBEAFE" Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}"><TextBlock Text="Primary" FontSize="8" Foreground="#2563EB"/></Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Position, TargetNullValue='—'}" FontSize="10" Foreground="#475569"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="{Binding Phone, TargetNullValue='—'}" FontSize="10" Foreground="#64748B"/><TextBlock Text="{Binding Email, StringFormat=' • {0}'}" FontSize="10" Foreground="#2563EB"/></StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border CornerRadius="4" Padding="3,0" Margin="2,0" Background="#F0FDF4" Visibility="{Binding IsDecisionMaker, Converter={StaticResource BoolToVis}}"><TextBlock Text="DM" FontSize="8" Foreground="#16A34A"/></Border>
                                                <Border CornerRadius="4" Padding="3,0" Margin="2,0" Background="#FFF7ED" Visibility="{Binding IsAccounting, Converter={StaticResource BoolToVis}}"><TextBlock Text="ACCT" FontSize="8" Foreground="#D97706"/></Border>
                                                <Border CornerRadius="4" Padding="3,0" Margin="2,0" Background="#ECFEFF" Visibility="{Binding IsReservation, Converter={StaticResource BoolToVis}}"><TextBlock Text="RES" FontSize="8" Foreground="#0891B2"/></Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>

                            <!-- TAB 2: PAYMENT TERMS -->
                            <StackPanel Visibility="{Binding IsPaymentTermsTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ĐIỀU KHOẢN THANH TOÁN" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Credit Limit" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.CreditLimit, StringFormat='{}{0:N0} ₫'}" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/>
                                    <TextBlock Grid.Row="1" Text="Credit Days" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.CreditDays, StringFormat='{}{0} ngày'}" FontSize="11"/>
                                    <TextBlock Grid.Row="2" Text="Điều khoản TT" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.PaymentTerms, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="3" Text="Tiền tệ" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.Currency}" FontSize="11"/>
                                    <TextBlock Grid.Row="4" Text="VAT" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.VatRequired}" FontSize="11"/>
                                    <TextBlock Grid.Row="5" Text="Loại HĐ" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedItem.InvoiceType, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="6" Text="Đặt cọc" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedItem.RequireDeposit}" FontSize="11"/>
                                    <TextBlock Grid.Row="7" Text="Yêu cầu PO" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedItem.NeedPo}" FontSize="11"/>
                                    <TextBlock Grid.Row="8" Text="Cho Credit" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedItem.AllowCredit}" FontSize="11"/>
                                    <TextBlock Grid.Row="9" Text="Auto Invoice" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedItem.AutoInvoice}" FontSize="11"/>
                                </Grid>
                            </StackPanel>

                            <!-- TAB 3: CONTRACTS -->
                            <StackPanel Visibility="{Binding IsContractsTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="HỢP ĐỒNG" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <ItemsControl ItemsSource="{Binding SelectedItem.Contracts}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArCompanyContractDto}">
                                    <Border Padding="10,7" Margin="0,0,0,5" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ContractNo}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock FontSize="10" Foreground="#94A3B8"><Run Text="Hiệu lực: "/><Run Text="{Binding EffectiveDate, StringFormat='{}{0:dd/MM/yyyy}'}" Foreground="#475569"/></TextBlock>
                                                    <TextBlock FontSize="10" Foreground="#94A3B8" Margin="8,0,0,0"><Run Text="Hết hạn: "/><Run Text="{Binding ExpiryDate, StringFormat='{}{0:dd/MM/yyyy}'}" Foreground="#475569"/></TextBlock>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Discount, StringFormat='CK: {0}%'}" FontSize="10" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding Commission, StringFormat=' • HH: {0}%'}" FontSize="10" Foreground="#64748B" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="6" Padding="5,1"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F1F5F9"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Active"><Setter Property="Background" Value="#DCFCE7"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Expired"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}"/></Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>

                            <!-- TAB 4: RATES -->
                            <StackPanel Visibility="{Binding IsRatesTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="COMPANY RATE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <ItemsControl ItemsSource="{Binding SelectedItem.Rates}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArCompanyRateDto}">
                                    <Border Padding="10,7" Margin="0,0,0,5" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding RoomType}" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/><TextBlock Text="{Binding Season, StringFormat=' — {0}'}" FontSize="10" Foreground="#64748B"/></StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="{Binding MealPlan, TargetNullValue='—'}" FontSize="9" Foreground="#94A3B8"/><TextBlock Text="{Binding Promotion, StringFormat=' • {0}'}" FontSize="9" Foreground="#94A3B8" Margin="3,0,0,0"/></StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Rate, StringFormat='{}{0:N0} ₫'}" FontSize="13" FontWeight="Bold" Foreground="#16A34A" TextAlignment="Right"/><TextBlock Text="{Binding WeekendRate, StringFormat='WE: {0:N0} ₫'}" FontSize="9" Foreground="#D97706" TextAlignment="Right"/></StackPanel>
                                        </Grid>
                                    </Border>
