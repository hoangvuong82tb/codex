                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Sales" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.SalesPerson, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Text="Manager" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.SalesManager, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="2" Text="Region" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.SalesRegion, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="3" Text="Market" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.Market, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="4" Text="Source" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.Source, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="5" Text="Segment" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedItem.Segment, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="6" Text="Priority" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedItem.Priority, TargetNullValue='—'}" FontSize="11"/>
                                </Grid>
                            </StackPanel>

                            <!-- TAB 6-14: RESERVATIONS, GROUPS, FOLIOS, INVOICES, PAYMENTS, AR, FILES, HISTORY, CRM -->
                            <StackPanel Visibility="{Binding IsReservationsTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="LỊCH SỬ ĐẶT PHÒNG" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <ItemsControl ItemsSource="{Binding SelectedItem.Reservations}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArCompanyReservationDto}">
                                    <Border Padding="8,5" Margin="0,0,0,3" Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ReservationNo}" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A"/><TextBlock Text="{Binding Status}" FontSize="9" Foreground="#94A3B8" Margin="4,0,0,0"/></StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0"><TextBlock Text="{Binding Arrival, StringFormat='{}{0:dd/MM}'}" FontSize="9" Foreground="#64748B"/><TextBlock Text="{Binding Departure, StringFormat=' → {0:dd/MM}'}" FontSize="9" Foreground="#94A3B8"/></StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:N0} ₫'}" FontSize="11" FontWeight="SemiBold" Foreground="#16A34A" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsGroupsTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="DANH SÁCH ĐOÀN" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <ItemsControl ItemsSource="{Binding SelectedItem.Groups}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArCompanyGroupDto}">
                                    <Border Padding="8,5" Margin="0,0,0,3" Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
