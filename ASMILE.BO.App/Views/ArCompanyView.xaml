<UserControl x:Class="ASMILE.BO.App.Views.ArCompanyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" Loaded="OnLoaded" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InvBoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:StringToBrushConverter x:Key="StringToBrush"/>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="64"/>
            <Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#16A34A"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#15803D"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#DC2626"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B91C1C"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="56"/><Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0,0,5,3"/><Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="ViewModeBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Height" Value="28"/><Setter Property="Width" Value="50"/><Setter Property="Padding" Value="6,0"/><Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="FilterTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="6,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource FluentComboBox}">
            <Setter Property="Height" Value="30"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="8,0,28,0"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Margin" Value="0,0,5,3"/>
        </Style>
        <Style x:Key="ModDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="RowHeight" Value="38"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value><Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="10"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="5,0"/>
                </Style></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailTabBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="6,0"/><Setter Property="Margin" Value="0,0,1,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PagerBtn" TargetType="Button" BasedOn="{StaticResource FluentPaginationButton}">
            <Setter Property="Foreground" Value="#475569"/><Setter Property="Margin" Value="1,0"/>
        </Style>
        <Style x:Key="PagerPageBtn" TargetType="Button" BasedOn="{StaticResource FluentPaginationButton}">
            <Setter Property="Content" Value="{Binding Label}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="#2563EB"/><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></DataTrigger>
                <DataTrigger Binding="{Binding IsEllipsis}" Value="True"><Setter Property="Width" Value="22"/><Setter Property="MinWidth" Value="22"/><Setter Property="MaxWidth" Value="22"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="IsEnabled" Value="False"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="KpiCardTemplate" DataType="{x:Type vm:ArCompanyKpi}">
            <Border Background="{Binding BgColor, Converter={StaticResource StringToBrush}}" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,4" Width="100" Margin="0,0,4,3" Cursor="Hand">
                <StackPanel><TextBlock Text="{Binding Value}" FontSize="14" FontWeight="Bold" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" FontFamily="Segoe UI"/>
                    <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#64748B" Margin="0,1,0,0" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#FFAD39" Margin="0,0,12,0">
                        <TextBlock Text="DN" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel><TextBlock Text="Doanh nghiệp — Company Master" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                        <TextBlock Text="Quản lý toàn bộ công ty, doanh nghiệp, đại lý, đối tác — Company, TA, Government, Education, Medical, Supplier" FontSize="11" Foreground="#64748B" Margin="0,1,0,0" FontFamily="Segoe UI"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Export Excel" Style="{StaticResource ToolbarBtn}" Command="{Binding ExportExcelCommand}"/>
                    <Button Content="Export PDF" Style="{StaticResource ToolbarBtn}" Command="{Binding ExportPdfCommand}"/>
                    <Button Content="Làm mới" Style="{StaticResource SecondaryBtn}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI DASHBOARD -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="12,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DashboardKpis}" ItemTemplate="{StaticResource KpiCardTemplate}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- TOOLBAR + FILTER -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel Grid.Row="0">
                    <Button Content="Thêm DN" Style="{StaticResource PrimaryBtn}" Margin="0,0,5,3"/>
                    <Button Content="Sửa" Style="{StaticResource ToolbarBtn}" Command="{Binding OpenEditFormCommand}"/>
                    <Button Content="Khóa/Mở" Style="{StaticResource ToolbarBtn}" Command="{Binding ToggleLockCommand}"/>
                    <Button Content="Xóa" Style="{StaticResource ToolbarBtn}"/>
                    <Button Content="Merge" Style="{StaticResource ToolbarBtn}"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,0"/>
                    <Button Content="Thu tiền" Style="{StaticResource SuccessBtn}" Margin="0,0,5,3" Command="{Binding OpenPaymentFormCommand}"/>
                    <Button Content="Gửi Email" Style="{StaticResource ToolbarBtn}" Command="{Binding OpenEmailFormCommand}"/>
                    <Button Content="In Statement" Style="{StaticResource ToolbarBtn}" Command="{Binding PrintStatementCommand}"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,0"/>
                    <ToggleButton Content="Panel Phải" IsChecked="{Binding IsRightPanelOpen}" Height="32" Width="80" Padding="8,0" Margin="0,0,5,3" FontSize="11" FontFamily="Segoe UI" Background="#F1F5F9" Foreground="#475569" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                </WrapPanel>
                <WrapPanel Grid.Row="1" Margin="0,4,0,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="140"/>
                    <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding FilterType}" Style="{StaticResource FilterCombo}" Width="100"/>
                    <ComboBox ItemsSource="{Binding MarketFilters}" SelectedItem="{Binding FilterMarket}" Style="{StaticResource FilterCombo}" Width="90"/>
                    <ComboBox ItemsSource="{Binding SourceFilters}" SelectedItem="{Binding FilterSource}" Style="{StaticResource FilterCombo}" Width="90"/>
                    <ComboBox ItemsSource="{Binding CountryFilters}" SelectedItem="{Binding FilterCountry}" Style="{StaticResource FilterCombo}" Width="90"/>
                    <ComboBox ItemsSource="{Binding SalesFilters}" SelectedItem="{Binding FilterSales}" Style="{StaticResource FilterCombo}" Width="110"/>
                    <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" Style="{StaticResource FilterCombo}" Width="100"/>
                    <CheckBox IsChecked="{Binding FilterHasDebt}" Content="Có nợ" FontSize="11" VerticalAlignment="Center" Margin="4,0,6,0" FontFamily="Segoe UI"/>
                    <CheckBox IsChecked="{Binding FilterHasContract}" Content="Có HĐ" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Segoe UI"/>
                    <CheckBox IsChecked="{Binding FilterExpiredContract}" Content="Hết HĐ" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Segoe UI"/>
                    <Button Content="Xóa lọc" Style="{StaticResource SecondaryBtn}" Command="{Binding ClearFiltersCommand}" Height="30" FontSize="10"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- MAIN 3-COLUMN -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" MinWidth="420"/>
                <ColumnDefinition Width="4*" MinWidth="420"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Company List -->
            <Border Grid.Column="0" Margin="8,6,4,6" Style="{StaticResource PanelCard}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#EFF6FF" CornerRadius="6" Padding="8,4" Margin="8,6,8,0" Visibility="{Binding InfoMessage, Converter={StaticResource StringToVis}}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding InfoMessage}" FontSize="10" Foreground="#1E40AF" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            <Button Grid.Column="1" Content="×" Background="Transparent" BorderThickness="0" Foreground="#1E40AF" FontSize="14" FontFamily="Segoe UI" Cursor="Hand" Width="22" Height="22" Padding="0" Click="OnDismissInfo"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="#FEF2F2" CornerRadius="6" Padding="8,4" Margin="8,6,8,0" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="10" Foreground="#DC2626" FontFamily="Segoe UI"/>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,8,8,4">
                        <Button Content="Bảng" Command="{Binding SetGridViewCommand}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ViewModeBtn}">
                                <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#64748B"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsGridView}" Value="True"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#2563EB"/><Setter Property="BorderBrush" Value="#93C5FD"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button Content="Thẻ" Command="{Binding SetCardViewCommand}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ViewModeBtn}">
                                <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#64748B"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsCardView}" Value="True"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#2563EB"/><Setter Property="BorderBrush" Value="#93C5FD"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </StackPanel>

                    <ScrollViewer Grid.Row="3" Margin="6,0,6,6" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                        <DataGrid ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource ModDataGrid}" MouseDoubleClick="OnDataGridDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Xem chi tiết" Command="{Binding SelectItemCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
                                    <MenuItem Header="Thu tiền" Command="{Binding OpenPaymentFormCommand}"/>
                                    <MenuItem Header="Gửi Email" Command="{Binding OpenEmailFormCommand}"/>
                                    <Separator/><MenuItem Header="In Statement" Command="{Binding PrintStatementCommand}"/>
                                    <MenuItem Header="Khóa/Mở khóa" Command="{Binding ToggleLockCommand}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding CompanyCode}" Width="70"/>
                                <DataGridTemplateColumn Header="Tên DN" Width="160">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="{Binding CompanyName}" FontSize="11" VerticalAlignment="Center" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Loại" Width="85">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Border CornerRadius="5" Padding="4,1" Background="{Binding TypeBg, Converter={StaticResource StringToBrush}}">
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="9" Foreground="{Binding TypeColor, Converter={StaticResource StringToBrush}}" FontFamily="Segoe UI"/>
                                        </Border>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Còn nợ" Width="90">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="{Binding Outstanding, StringFormat='{}{0:N0} ₫'}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style><Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#DC2626"/><Style.Triggers><DataTrigger Binding="{Binding Outstanding}" Value="0"><Setter Property="Foreground" Value="#16A34A"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Credit" Binding="{Binding CreditLimit, StringFormat='{}{0:N0} ₫'}" Width="85"/>
                                <DataGridTextColumn Header="Sales" Binding="{Binding SalesPerson}" Width="90"/>
                                <DataGridTextColumn Header="Res" Binding="{Binding ReservationCount}" Width="40"/>
                                <DataGridTextColumn Header="Đoàn" Binding="{Binding GroupCount}" Width="40"/>
                                <DataGridTextColumn Header="Invoice" Binding="{Binding OpenInvoiceCount}" Width="50"/>
                                <DataGridTemplateColumn Header="TT" Width="65">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Border CornerRadius="6" Padding="4,1" Background="{Binding StatusBg, Converter={StaticResource StringToBrush}}">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="8" FontWeight="SemiBold" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" FontFamily="Segoe UI"/>
                                        </Border>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="3" Margin="6,0,6,6" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCardView, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding FilteredItems}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArCompanyDto}">
                                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="0,0,6,6" Width="210" Cursor="Hand" MouseLeftButtonDown="OnCardClick" Tag="{Binding}">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{Binding CompanyName}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CompanyCode}" FontSize="10" Foreground="#64748B" FontFamily="Segoe UI"/></StackPanel>
                                            <Border Grid.Column="1" CornerRadius="8" Padding="5,1" Background="{Binding StatusBg, Converter={StaticResource StringToBrush}}">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" FontFamily="Segoe UI"/></Border>
                                        </Grid>
                                        <Separator Margin="0,8" Background="#F1F5F9"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"><TextBlock Text="Còn nợ" FontSize="9" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                                <TextBlock Text="{Binding Outstanding, StringFormat='{}{0:N0} ₫'}" FontSize="13" FontWeight="Bold" Foreground="#DC2626" FontFamily="Segoe UI"/></StackPanel>
                                            <StackPanel Grid.Column="1"><TextBlock Text="Credit" FontSize="9" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                                <TextBlock Text="{Binding CreditLimit, StringFormat='{}{0:N0} ₫'}" FontSize="13" FontWeight="Bold" Foreground="#2563EB" FontFamily="Segoe UI"/></StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border CornerRadius="5" Padding="4,1" Background="{Binding TypeBg, Converter={StaticResource StringToBrush}}">
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="8" Foreground="{Binding TypeColor, Converter={StaticResource StringToBrush}}" FontFamily="Segoe UI"/></Border>
                                            <TextBlock Text="{Binding City, TargetNullValue='—'}" FontSize="9" Foreground="#94A3B8" Margin="4,0,0,0" FontFamily="Segoe UI"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="3" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="6,4">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="«" Style="{StaticResource PagerBtn}" Command="{Binding FirstPageCommand}" IsEnabled="{Binding HasPrevPage}" Width="24" Height="24" FontSize="10" FontFamily="Segoe UI"/>
                            <Button Content="‹" Style="{StaticResource PagerBtn}" Command="{Binding PrevPageCommand}" IsEnabled="{Binding HasPrevPage}" Width="24" Height="24" FontSize="14" FontFamily="Segoe UI"/>
                            <ItemsControl ItemsSource="{Binding PageButtons}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArCompanyPaginationButton}">
                                    <Button Style="{StaticResource PagerPageBtn}" Width="26" Height="24" FontSize="10" Command="{Binding DataContext.SetPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding PageNumber}"/>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="›" Style="{StaticResource PagerBtn}" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" Width="24" Height="24" FontSize="14" FontFamily="Segoe UI"/>
                            <Button Content="»" Style="{StaticResource PagerBtn}" Command="{Binding LastPageCommand}" IsEnabled="{Binding HasNextPage}" Width="24" Height="24" FontSize="10" FontFamily="Segoe UI"/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- CENTER: Detail Panel -->
            <Border Grid.Column="1" Margin="4,6,4,6" Style="{StaticResource PanelCard}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedItem.CompanyName}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border CornerRadius="6" Padding="5,1" Background="{Binding SelectedItem.TypeBg, Converter={StaticResource StringToBrush}}">
