                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Revenue, StringFormat='{}{0:N0} ₫'}" FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>

                            <!-- TAB 8: FOLIOS (compact) -->
                            <StackPanel Visibility="{Binding IsFoliosTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="DANH SÁCH FOLIO" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <ItemsControl ItemsSource="{Binding SelectedItem.Folios}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArCompanyFolioDto}">
                                    <Border Padding="8,5" Margin="0,0,0,3" Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding FolioNo}" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A"/><TextBlock Text="{Binding Type, StringFormat=' ({0})'}" FontSize="9" Foreground="#94A3B8"/></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Outstanding, StringFormat='{}{0:N0} ₫'}" FontSize="10" FontWeight="SemiBold" Foreground="#DC2626"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>

                            <!-- TAB 9: INVOICES -->
                            <StackPanel Visibility="{Binding IsInvoicesTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="DANH SÁCH HÓA ĐƠN" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <ItemsControl ItemsSource="{Binding SelectedItem.Invoices}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArCompanyInvoiceDto}">
                                    <Border Padding="10,7" Margin="0,0,0,5" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{Binding InvoiceNo}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="{Binding Amount, StringFormat='Tiền: {0:N0} ₫'}" FontSize="10" Foreground="#475569"/><TextBlock Text="{Binding Vat, StringFormat=' • VAT: {0:N0} ₫'}" FontSize="10" Foreground="#94A3B8" Margin="4,0,0,0"/></StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><Border CornerRadius="6" Padding="5,1" Background="{Binding StatusColor, Converter={StaticResource StringToBrush}}"><TextBlock Text="{Binding StatusLabel}" FontSize="8" FontWeight="SemiBold" Foreground="White"/></Border><TextBlock Text="{Binding Balance, StringFormat='Còn: {0:N0} ₫'}" FontSize="9" Foreground="#DC2626" Margin="0,2,0,0" TextAlignment="Right"/></StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>

                            <!-- TAB 10: PAYMENTS -->
                            <StackPanel Visibility="{Binding IsPaymentsTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="LỊCH SỬ THANH TOÁN" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <ItemsControl ItemsSource="{Binding SelectedItem.Payments}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArCompanyPaymentDto}">
                                    <Border Padding="10,7" Margin="0,0,0,4" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ReceiptNo}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/><Border CornerRadius="4" Padding="3,0" Margin="4,0,0,0" Background="#EFF6FF"><TextBlock Text="{Binding TypeLabel}" FontSize="8" Foreground="#2563EB"/></Border></StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="{Binding PaymentDate, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="10" Foreground="#64748B"/><TextBlock Text="{Binding Method, StringFormat=' • {0}'}" FontSize="10" Foreground="#94A3B8"/></StackPanel></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:N0} ₫'}" FontSize="13" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>

                            <!-- TAB 11: AR (AGING) -->
                            <StackPanel Visibility="{Binding IsArTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="CÔNG NỢ — AGING" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <Grid Margin="0,0,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#FEF2F2" CornerRadius="6" Padding="8,5" Margin="0,0,0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tổng dư nợ" FontSize="10" Foreground="#DC2626"/><TextBlock Grid.Column="1" Text="{Binding SelectedItem.Outstanding, StringFormat='{}{0:N0} ₫'}" FontSize="13" FontWeight="Bold" Foreground="#DC2626"/></Grid></Border>
                                    <Border Grid.Row="1" Grid.Column="0" Background="#FFF7ED" CornerRadius="6" Padding="6,5" Margin="0,0,2,4"><StackPanel><TextBlock Text="Hiện tại" FontSize="9" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedItem.CurrentDebt, StringFormat='{}{0:N0} ₫'}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B"/></StackPanel></Border>
                                    <Border Grid.Row="1" Grid.Column="1" Background="#FFF7ED" CornerRadius="6" Padding="6,5" Margin="2,0,0,4"><StackPanel><TextBlock Text="1-30 ngày" FontSize="9" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedItem.Debt1To30, StringFormat='{}{0:N0} ₫'}" FontSize="11" FontWeight="SemiBold" Foreground="#D97706"/></StackPanel></Border>
                                    <Border Grid.Row="2" Grid.Column="0" Background="#FEE2E2" CornerRadius="6" Padding="6,5" Margin="0,0,2,0"><StackPanel><TextBlock Text="31-60 ngày" FontSize="9" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedItem.Debt31To60, StringFormat='{}{0:N0} ₫'}" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444"/></StackPanel></Border>
                                    <Border Grid.Row="2" Grid.Column="1" Background="#FEE2E2" CornerRadius="6" Padding="6,5" Margin="2,0,0,0"><StackPanel><TextBlock Text="60-90+ ngày" FontSize="9" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedItem.Debt61To90, StringFormat='{}{0:N0} ₫'}" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626"/></StackPanel></Border>
                                </Grid>
                            </StackPanel>

                            <!-- TAB 12: FILES -->
                            <StackPanel Visibility="{Binding IsFilesTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="HỒ SƠ ĐÍNH KÈM" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <ItemsControl ItemsSource="{Binding SelectedItem.Documents}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArCompanyDocumentDto}">
                                    <Border Margin="0,0,0,6" Background="#F8FAFC" CornerRadius="8" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="6" Background="#DBEAFE" Margin="0,0,8,0"><TextBlock Text="PDF" FontSize="8" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/><StackPanel Orientation="Horizontal" Margin="0,1,0,0"><Border CornerRadius="4" Padding="3,0" Background="#EFF6FF"><TextBlock Text="{Binding TypeLabel}" FontSize="8" Foreground="#2563EB"/></Border><TextBlock Text="{Binding UploadDate, StringFormat=' • {0:dd/MM/yyyy}'}" FontSize="9" Foreground="#94A3B8" Margin="3,0,0,0"/></StackPanel></StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" Margin="0,3,0,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="+" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/><TextBlock Text="Upload hồ sơ" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" FontFamily="Segoe UI"/></StackPanel></Border>
                            </StackPanel>

                            <!-- TAB 13: HISTORY (TIMELINE) -->
                            <StackPanel Visibility="{Binding IsHistoryTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="LỊCH SỬ GIAO DỊCH" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <ItemsControl ItemsSource="{Binding SelectedItem.History}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArCompanyHistoryDto}">
                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid><Border Width="8" Height="8" CornerRadius="4" Background="#2563EB" Margin="0,2,0,0"/><Border Width="2" HorizontalAlignment="Center" Background="#E2E8F0" Margin="3,10,3,0" VerticalAlignment="Stretch"/></Grid>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0"><StackPanel Orientation="Horizontal"><Border CornerRadius="4" Padding="3,0" Background="#EFF6FF"><TextBlock Text="{Binding TypeLabel}" FontSize="9" Foreground="#2563EB"/></Border><TextBlock Text="{Binding Reference, StringFormat=' • {0}'}" FontSize="9" Foreground="#94A3B8" Margin="3,0,0,0"/></StackPanel><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#475569" Margin="0,1,0,0"/><TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="8" Foreground="#94A3B8"/></StackPanel>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>

                            <!-- TAB 14: CRM -->
                            <StackPanel Visibility="{Binding IsCrmTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="CRM" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Status" FontSize="10" Foreground="#94A3B8"/><Border Grid.Row="0" Grid.Column="1" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F1F5F9"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.CrmStatus}" Value="Customer"><Setter Property="Background" Value="#DCFCE7"/></DataTrigger><DataTrigger Binding="{Binding SelectedItem.CrmStatus}" Value="Lead"><Setter Property="Background" Value="#FFFBEB"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding SelectedItem.CrmLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding SelectedItem.CrmColor, Converter={StaticResource StringToBrush}}"/></Border>
                                    <TextBlock Grid.Row="1" Text="Priority" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.Priority, TargetNullValue='—'}" FontSize="11"/>
                                    <TextBlock Grid.Row="2" Text="Reservations" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.ReservationCount}" FontSize="11"/>
                                    <TextBlock Grid.Row="3" Text="Stays" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.StayCount}" FontSize="11"/>
                                    <TextBlock Grid.Row="4" Text="Room Nights" FontSize="10" Foreground="#94A3B8"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.RoomNightCount}" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="White" Panel.ZIndex="2"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="—" FontFamily="Segoe UI" FontSize="24" Foreground="#CBD5E1" HorizontalAlignment="Center"/><TextBlock Text="Chọn một doanh nghiệp" FontSize="14" FontWeight="SemiBold" Foreground="#52657D" HorizontalAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="để xem thông tin chi tiết và lịch sử giao dịch." FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/></StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: AR Dashboard -->
            <Border Grid.Column="2" Margin="4,6,8,6" Width="270" Style="{StaticResource PanelCard}" Padding="0" Visibility="{Binding IsRightPanelOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                    <StackPanel Margin="14,10">
                        <TextBlock Text="DASHBOARD" FontSize="11" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Credit Limit" FontSize="10" Foreground="#2563EB"/><TextBlock Grid.Column="1" Text="{Binding SelectedItem.CreditLimit, StringFormat='{}{0:N0} ₫'}" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/></Grid>
                                <Grid Grid.Row="1" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Available" FontSize="10" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding SelectedItem.AvailableCredit, StringFormat='{}{0:N0} ₫'}" FontSize="12" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#16A34A"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.IsOverCredit}" Value="True"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                                <Border Grid.Row="2" Background="#FEF2F2" CornerRadius="4" Padding="6,3" Margin="0,6,0,0" Visibility="{Binding SelectedItem.IsOverCredit, Converter={StaticResource BoolToVis}}"><TextBlock Text="⚠ CREDIT LIMIT EXCEEDED" FontSize="9" FontWeight="Bold" Foreground="#DC2626"/></Border>
                            </Grid>
                        </Border>
                        <Grid Margin="0,0,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#F8FAFC" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Reservations" FontSize="10" Foreground="#475569"/><TextBlock Grid.Column="1" Text="{Binding SelectedItem.ReservationCount}" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/></Grid>
                            <Grid Grid.Row="1" Background="#F8FAFC" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Stays" FontSize="10" Foreground="#475569"/><TextBlock Grid.Column="1" Text="{Binding SelectedItem.StayCount}" FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED"/></Grid>
                            <Grid Grid.Row="2" Background="#F8FAFC" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Room Nights" FontSize="10" Foreground="#475569"/><TextBlock Grid.Column="1" Text="{Binding SelectedItem.RoomNightCount}" FontSize="11" FontWeight="SemiBold" Foreground="#0891B2"/></Grid>
                            <Grid Grid.Row="3" Background="#F8FAFC" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Doanh thu" FontSize="10" Foreground="#475569"/><TextBlock Grid.Column="1" Text="{Binding SelectedItem.TotalRevenue, StringFormat='{}{0:N0} ₫'}" FontSize="10" Foreground="#16A34A"/></Grid>
                            <Grid Grid.Row="4" Background="#F8FAFC" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Invoice mở" FontSize="10" Foreground="#475569"/><TextBlock Grid.Column="1" Text="{Binding SelectedItem.OpenInvoiceCount}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B"/></Grid>
                            <Grid Grid.Row="5" Background="#F8FAFC"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Đoàn" FontSize="10" Foreground="#475569"/><TextBlock Grid.Column="1" Text="{Binding SelectedItem.GroupCount}" FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED"/></Grid>
                        </Grid>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="HOẠT ĐỘNG GẦN ĐÂY" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <Grid Grid.Row="1" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Last Stay" FontSize="9" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding SelectedItem.LastStayDate, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="9" Foreground="#475569"/></Grid>
                                <Grid Grid.Row="2" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Last Booking" FontSize="9" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding SelectedItem.LastBookingDate, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="9" Foreground="#475569"/></Grid>
                                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Last Invoice" FontSize="9" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding SelectedItem.LastInvoiceDate, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="9" Foreground="#475569"/></Grid>
                            </Grid>
                        </Border>
                        <Border CornerRadius="8" Padding="10,7" Visibility="{Binding SelectedItem.HasWarning, Converter={StaticResource BoolToVis}}"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FEF2F2"/><Setter Property="BorderBrush" Value="#FECACA"/><Setter Property="BorderThickness" Value="1"/></Style></Border.Style>
                            <StackPanel><TextBlock Text="⚠ CẢNH BÁO" FontSize="10" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,6"/><ItemsControl ItemsSource="{Binding SelectedItem.Warnings}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type system:String}"><TextBlock Text="{Binding}" FontSize="9" Foreground="#DC2626" Margin="0,0,0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="4" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding PageDisplay}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/><Border CornerRadius="5" Padding="5,1" Margin="8,0,0,0" Background="#EFF6FF"><TextBlock Text="Company Master" FontSize="10" Foreground="#2563EB" FontWeight="SemiBold"/></Border></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x00AB;" Style="{StaticResource PagerBtn}" Command="{Binding FirstPageCommand}" IsEnabled="{Binding HasPrevPage}" ToolTip="Trang đầu" Width="28" Height="28"/>
                    <Button Content="&#x2039;" Style="{StaticResource PagerBtn}" Command="{Binding PrevPageCommand}" IsEnabled="{Binding HasPrevPage}" ToolTip="Trang trước" Width="28" Height="28"/>
                    <ItemsControl ItemsSource="{Binding PageButtons}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArCompanyPaginationButton}">
                            <Button Style="{StaticResource PagerPageBtn}" Command="{Binding DataContext.SetPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding PageNumber}" Width="30" Height="28"/>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="&#x203A;" Style="{StaticResource PagerBtn}" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" ToolTip="Trang sau" Width="28" Height="28"/>
                    <Button Content="&#x00BB;" Style="{StaticResource PagerBtn}" Command="{Binding LastPageCommand}" IsEnabled="{Binding HasNextPage}" ToolTip="Trang cuối" Width="28" Height="28"/>
                    <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemStringFormat="{}{0} / trang" Style="{StaticResource FluentComboBox}" Width="122" Height="28" MinWidth="0" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FORM OVERLAY -->
        <Border Grid.RowSpan="5" Background="#80000000" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
            <Grid><Border Background="White" CornerRadius="12" MaxWidth="500" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="12,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding FormTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/><Button Grid.Column="1" Content="Đóng" Style="{StaticResource SecondaryBtn}" Width="52" Height="28" Padding="6,0" Command="{Binding CloseFormCommand}"/></Grid></Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,10"><StackPanel>
                        <Border Background="#FEF2F2" CornerRadius="6" Padding="8,5" Margin="0,0,0,8" Visibility="{Binding FormErrorMessage, Converter={StaticResource StringToVis}}"><TextBlock Text="{Binding FormErrorMessage}" FontSize="10" Foreground="#DC2626"/></Border>
                        <StackPanel Visibility="{Binding IsEditForm, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Tên DN *" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding EditCompanyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Tên tắt" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding EditShortName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Loại" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><ComboBox SelectedItem="{Binding EditCompanyType}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0"><ComboBoxItem Content="Corporate"/><ComboBoxItem Content="TravelAgent"/><ComboBoxItem Content="Company"/><ComboBoxItem Content="Government"/><ComboBoxItem Content="Education"/><ComboBoxItem Content="Medical"/><ComboBoxItem Content="Supplier"/></ComboBox></StackPanel>
                            </Grid>
                            <TextBlock Text="MST" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding EditTaxCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                            <TextBlock Text="Địa chỉ" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Phone" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Email" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Credit Limit" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding EditCreditLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Credit Days" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding EditCreditDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Sales" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding EditSalesPerson, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsPaymentForm, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Số tiền *" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                            <TextBlock Text="Phương thức" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><ComboBox SelectedItem="{Binding PaymentMethod}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,8"><ComboBoxItem Content="Tiền mặt"/><ComboBoxItem Content="Chuyển khoản"/><ComboBoxItem Content="Thẻ tín dụng"/><ComboBoxItem Content="Ví điện tử"/><ComboBoxItem Content="Séc"/></ComboBox>
                            <TextBlock Text="Tham chiếu" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding PaymentReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsEmailForm, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Loại" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><ComboBox SelectedItem="{Binding EmailType}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,8"><ComboBoxItem Content="Statement"/><ComboBoxItem Content="Invoice"/><ComboBoxItem Content="Reminder"/><ComboBoxItem Content="BalanceConfirmation"/></ComboBox>
                            <TextBlock Text="Email *" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding EmailTo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                            <TextBlock Text="Nội dung" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding EmailBody, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                        </StackPanel>
                    </StackPanel></ScrollViewer>
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Hủy" Style="{StaticResource SecondaryBtn}" Width="70" Command="{Binding CloseFormCommand}" Margin="0,0,6,0"/><Button Content="Lưu" Width="70"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryBtn}"><Style.Triggers><DataTrigger Binding="{Binding IsEditForm}" Value="True"><Setter Property="Command" Value="{Binding SubmitEditFormCommand}"/></DataTrigger><DataTrigger Binding="{Binding IsPaymentForm}" Value="True"><Setter Property="Command" Value="{Binding SubmitPaymentFormCommand}"/></DataTrigger><DataTrigger Binding="{Binding IsEmailForm}" Value="True"><Setter Property="Command" Value="{Binding SubmitEmailFormCommand}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Border>
                </Grid>
            </Border></Grid>
        </Border>

        <Border Grid.RowSpan="5" Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Đang tải..." FontSize="14" Foreground="#64748B"/></StackPanel></Border>
    </Grid>
</UserControl>
