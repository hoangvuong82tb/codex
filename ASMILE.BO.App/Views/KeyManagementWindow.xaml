<Window x:Class="ASMILE.BO.App.Views.KeyManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý chìa khóa" Width="860" Height="580"
        MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="GrayBtn" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ActionCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="24,22"/><Setter Property="Cursor" Value="Hand"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#D97706" Offset="0"/><GradientStop Color="#B45309" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="Quản lý chìa khóa" FontSize="20" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Quản lý phát hành và thu hồi thẻ phòng." FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="2" Content="Đóng" Click="OnClose" Style="{StaticResource GrayBtn}"/>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="1" Margin="28,24,28,16" HorizontalAlignment="Center">
            <Border Width="220" Height="170" Style="{StaticResource ActionCard}" Margin="0,0,12,12" MouseLeftButtonDown="OnIssueKey">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="13" Background="#EFF6FF" Margin="0,0,0,12"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Cấp thẻ" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Phát hành thẻ phòng mới" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Width="220" Height="170" Style="{StaticResource ActionCard}" Margin="0,0,12,12" MouseLeftButtonDown="OnReissueKey">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="13" Background="#FFF7ED" Margin="0,0,0,12"><TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Cấp lại" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Cấp lại thẻ bị mất/hỏng" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Width="220" Height="170" Style="{StaticResource ActionCard}" Margin="0,0,0,12" MouseLeftButtonDown="OnRevokeKey">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="13" Background="#FEF2F2" Margin="0,0,0,12"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Thu hồi" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Thu thẻ khi trả phòng" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Width="220" Height="170" Style="{StaticResource ActionCard}" Margin="0,0,12,12" MouseLeftButtonDown="OnLockKey">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="13" Background="#F3F4F6" Margin="0,0,0,12"><TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Khóa thẻ" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Vô hiệu hóa thẻ phòng" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Width="220" Height="170" Style="{StaticResource ActionCard}" Margin="0,0,0,12" MouseLeftButtonDown="OnKeyLog">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="13" Background="#ECFDF5" Margin="0,0,0,12"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Nhật ký thẻ" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Lịch sử cấp/thu hồi thẻ" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <Border Grid.Row="2" Padding="14,10" Margin="14,10,14,12" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#94A3B8" Text="Chọn một thao tác để bắt đầu"/>
                <Button Grid.Column="1" Content="Đóng" Click="OnClose" Style="{StaticResource GrayBtn}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
