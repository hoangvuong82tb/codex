<UserControl x:Class="ASMILE.BO.App.Views.SupplierPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASMILE.BO.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1520"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <Border Background="{StaticResource SupplierPageBackgroundBrush}" Padding="30,18,30,30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Nhà cung cấp" FontSize="31" FontWeight="Bold" Foreground="#162C4E" />
                <TextBlock Text="Quản lý thông tin và trạng thái hoạt động của nhà cung cấp."
                           Margin="0,4,0,0"
                           FontSize="15.5"
                           Foreground="#4C6281" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="40*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <controls:SupplierToolbar Grid.Column="0" Grid.Row="0" Margin="0,0,0,16" />
                <controls:SupplierListCard Grid.Column="0" Grid.Row="1" />
                <controls:SupplierDetailCard Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" />
            </Grid>

        </Grid>
    </Border>
</UserControl>
