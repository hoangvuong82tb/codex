<Window x:Class="ASMILE.BO.App.Views.RoomMoveExtendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi phòng + Gia hạn" Width="1360" Height="880" MinWidth="1160" MinHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#94A3B8"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModernComboBox" TargetType="ComboBox"><Setter Property="Height" Value="38"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/><Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#7B8DA6" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="6" Stretch="Uniform"/></Grid></Border><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="9" Margin="0,2"><ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModernDatePicker" TargetType="DatePicker"><Setter Property="Height" Value="38"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="CalendarStyle" Value="{StaticResource FoModernCalendarStyle}"/><Setter Property="FirstDayOfWeek" Value="Monday"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker"><Grid><Border x:Name="Root" Background="White" BorderBrush="#D7E2F0" BorderThickness="1" CornerRadius="9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Grid Grid.Column="0"><DatePickerTextBox x:Name="PART_TextBox" BorderThickness="0" Background="Transparent" Padding="12,0" VerticalContentAlignment="Center" FontSize="13" FontFamily="Segoe UI" Foreground="#17365D"/><TextBlock x:Name="Watermark" Text="Chọn ngày" IsHitTestVisible="False" Background="White" FontSize="13" FontFamily="Segoe UI" Foreground="#94A3B8" Padding="12,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid><ToggleButton x:Name="PART_Button" Grid.Column="1" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><Border Width="28" Height="28" CornerRadius="7" Background="#F2F6FD"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2F6BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ToggleButton></Grid><Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"><Calendar x:Name="PART_Calendar" Style="{StaticResource FoModernCalendarStyle}" Language="vi-VN" BorderThickness="0" Background="White" SelectedDate="{Binding SelectedDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" DisplayDate="{Binding DisplayDate, RelativeSource={RelativeSource TemplatedParent}}"/></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#AFCBF7"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#2F6BFF"/></Trigger><DataTrigger Binding="{Binding SelectedDate, RelativeSource={RelativeSource Self}}" Value="{x:Null}"><Setter TargetName="Watermark" Property="Visibility" Value="Visible"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PagerButtonStyle" TargetType="Button"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="30"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Padding="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box"
                                        Width="18"
                                        Height="18"
                                        Background="White"
                                        BorderBrush="#BFCDE0"
                                        BorderThickness="1.5"
                                        CornerRadius="5">
                                    <Path x:Name="Mark"
                                          Margin="3"
                                          Data="M1,5 L4,8 L10,1"
                                          Fill="Transparent"
                                          Stroke="White"
                                          StrokeThickness="2"
                                          Stretch="Uniform"
                                          Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#2F6BFF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2F6BFF"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernDataGrid" TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="#FAFBFD"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ColumnHeaderHeight" Value="42"/><Setter Property="RowHeight" Value="42"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2F6FC"/><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="8,0"/></Style></Setter.Value></Setter></Style>
        <Style x:Key="PanelCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#102E5A"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <!-- Header -->
        <Border Padding="20,14" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="11"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFAD39" Offset="0"/><GradientStop Color="#ED7900" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Đổi phòng + Gia hạn" FontSize="18" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Chuyển khách sang phòng mới và kéo dài thời gian lưu trú." FontSize="12" Foreground="#64748B"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Làm mới" Click="OnRefresh" Style="{StaticResource SecondaryButton}"/><Button Content="Đóng" Click="OnClose" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/></StackPanel>
            </Grid>
        </Border>
        <!-- Step Bar -->
        <Border Grid.Row="1" Padding="20,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel x:Name="StepBar" Orientation="Horizontal" HorizontalAlignment="Center"/>
        </Border>
        <!-- Summary Strip -->
        <Border Grid.Row="2" Padding="20,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel x:Name="SummaryStrip" Orientation="Horizontal" HorizontalAlignment="Center"/>
        </Border>
        <!-- Body -->
        <Grid Grid.Row="3" Margin="20,12">
            <!-- Step 1: Guest -->
            <Grid x:Name="Step1Content">
                <Grid.ColumnDefinitions><ColumnDefinition Width="65*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="35*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Padding="14,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"><WrapPanel>
                            <StackPanel Width="235" Margin="0,0,8,6"><TextBlock Text="Từ khóa" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GuestSearchBox" Style="{StaticResource ModernTextBox}" ToolTip="Tên khách, số phòng, mã hồ sơ hoặc Folio"/></StackPanel>
                            <StackPanel Width="78" Margin="0,0,8,6"><TextBlock Text="Số phòng" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GuestRoomFilterBox" Style="{StaticResource ModernTextBox}"/></StackPanel>
                            <StackPanel Width="105" Margin="0,0,8,6"><TextBlock Text="Hạng phòng" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="GuestRoomTypeFilter" Style="{StaticResource ModernComboBox}"/></StackPanel>
                            <StackPanel Width="78" Margin="0,0,8,6"><TextBlock Text="VIP" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="GuestVipFilter" Style="{StaticResource ModernComboBox}"/></StackPanel>
                            <Button Margin="0,15,6,6" Content="Tìm" Click="OnApplyGuestFilters" Style="{StaticResource PrimaryButton}"/><Button Margin="0,15,0,6" Content="Xóa lọc" Click="OnClearGuestFilters" Style="{StaticResource SecondaryButton}"/>
                        </WrapPanel></Border>
                        <DataGrid x:Name="GuestGrid" Grid.Row="1" Style="{StaticResource ModernDataGrid}" SelectionChanged="OnGuestSelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Phòng" Binding="{Binding Room}" Width="58"/><DataGridTextColumn Header="Tên khách" Binding="{Binding Name}" Width="150"/>
                                <DataGridTextColumn Header="Mã HS" Binding="{Binding Folio}" Width="86"/><DataGridTextColumn Header="Ngày đến" Binding="{Binding Arrival}" Width="76"/>
                                <DataGridTextColumn Header="Ngày đi" Binding="{Binding Departure}" Width="76"/><DataGridTextColumn Header="Hạng" Binding="{Binding RoomType}" Width="72"/>
                                <DataGridTextColumn Header="SK" Binding="{Binding GuestCount}" Width="40"/><DataGridTextColumn Header="VIP" Binding="{Binding VipDisplay}" Width="42"/>
                                <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2" Padding="12,9" Background="#FBFCFE" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="GuestPagerSummary" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="GuestPrevBtn" Content="←" Click="OnGuestPrevPage" Style="{StaticResource PagerButtonStyle}"/><StackPanel x:Name="GuestPageBtns" Orientation="Horizontal"/>
                                    <Button x:Name="GuestNextBtn" Content="→" Click="OnGuestNextPage" Style="{StaticResource PagerButtonStyle}"/><ComboBox x:Name="GuestPageSizeBox" Width="118" Margin="8,0,0,0" SelectionChanged="OnGuestPageSizeChanged" Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="14"><StackPanel>
                    <TextBlock Text="Chi tiết khách đã chọn" Style="{StaticResource SectionTitle}"/>
                    <Border x:Name="GuestEmptyState" Padding="16" Background="#F8FAFC" CornerRadius="10"><StackPanel><TextBlock Text="Chưa chọn khách" FontSize="14" FontWeight="SemiBold" Foreground="#52657D"/><TextBlock Margin="0,4,0,0" Text="Chọn một khách đang lưu trú trong danh sách để tiếp tục." TextWrapping="Wrap" FontSize="12" Foreground="#94A3B8"/></StackPanel></Border>
                    <StackPanel x:Name="GuestDetailPanel" Visibility="Collapsed">
                        <TextBlock x:Name="GuestDetailName" FontSize="18" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock x:Name="GuestDetailMeta" Margin="0,3,0,14" FontSize="12" Foreground="#64748B"/>
                        <Border Height="1" Margin="0,0,0,12" Background="#E2E8F0"/>
                        <TextBlock x:Name="GuestDetailRoom" Margin="0,3" FontSize="12" Foreground="#334155"/><TextBlock x:Name="GuestDetailDates" Margin="0,3" FontSize="12" Foreground="#334155"/>
                        <TextBlock x:Name="GuestDetailFolio" Margin="0,3" FontSize="12" Foreground="#334155"/><TextBlock x:Name="GuestDetailVip" Margin="0,3" FontSize="12" Foreground="#334155"/>
                        <TextBlock x:Name="GuestDetailCount" Margin="0,3" FontSize="12" Foreground="#334155"/><TextBlock x:Name="GuestDetailBalance" Margin="0,3" FontSize="12" Foreground="#334155"/>
                        <Border Margin="0,14,0,0" Padding="12" Background="#FFF7ED" CornerRadius="9"><StackPanel>
                            <TextBlock Text="Vấn đề tại phòng hiện tại" FontSize="11" FontWeight="SemiBold" Foreground="#EA580C"/>
                            <TextBlock x:Name="GuestIssue1" Margin="0,3,0,0" FontSize="11" Foreground="#92400E"/>
                            <TextBlock x:Name="GuestIssue2" Margin="0,1,0,0" FontSize="11" Foreground="#92400E"/>
                        </StackPanel></Border>
                    </StackPanel>
                </StackPanel></Border>
            </Grid>
            <!-- Steps 2-6: placeholder panels (populated in code-behind) -->
            <Grid x:Name="Step2Content" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="16"><StackPanel x:Name="Step2Left"/></Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="16"><StackPanel x:Name="Step2Right"/></Border>
            </Grid>
            <Grid x:Name="Step3Content" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <WrapPanel x:Name="Step3Filter" Margin="0,0,0,8"/>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="65*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="35*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DataGrid x:Name="RoomGrid" Grid.Row="0" Style="{StaticResource ModernDataGrid}" SelectionChanged="OnRoomPreviewChanged"/>
                        <Border Grid.Row="1" Padding="12,9" Background="#FBFCFE" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="RoomPagerSummary" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="RoomPrevBtn" Content="←" Click="OnRoomPrevPage" Style="{StaticResource PagerButtonStyle}"/><StackPanel x:Name="RoomPageBtns" Orientation="Horizontal"/><Button x:Name="RoomNextBtn" Content="→" Click="OnRoomNextPage" Style="{StaticResource PagerButtonStyle}"/><ComboBox x:Name="RoomPageSizeBox" Width="118" Margin="8,0,0,0" SelectionChanged="OnRoomPageSizeChanged" Style="{StaticResource ModernComboBox}"/></StackPanel>
                        </Grid></Border>
                    </Grid></Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="14"><StackPanel x:Name="RoomPreviewPanel"/></Border>
                </Grid>
            </Grid>
            <Grid x:Name="Step4Content" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="AdjustmentWarning"
                        Margin="0,0,0,10"
                        Padding="12,9"
                        Background="#FFF7ED"
                        CornerRadius="9">
                    <TextBlock x:Name="AdjustmentWarningText"
                               Text="Chưa đủ thông tin. Hãy chọn khách, ngày đi mới và phòng mới để tính giá."
                               FontSize="12"
                               Foreground="#C2410C"/>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Thông tin điều chỉnh" Style="{StaticResource SectionTitle}"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Thời điểm hiệu lực" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="EffectiveModeBox"
                                              SelectionChanged="OnAdjustmentChanged"
                                              Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ngày" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker x:Name="EffectiveDatePicker"
                                                SelectedDateChanged="OnAdjustmentDateChanged"
                                                Style="{StaticResource ModernDatePicker}"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Margin="0,14" Background="#E2E8F0"/>
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Giờ" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EffectiveTimeBox"
                                             Text="14:00"
                                             TextChanged="OnAdjustmentTextChanged"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Lý do đổi phòng" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ReasonBox"
                                              SelectionChanged="OnAdjustmentChanged"
                                              Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="4" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Lý do gia hạn" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ExtendReasonBox"
                                              SelectionChanged="OnAdjustmentChanged"
                                              Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Người yêu cầu" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="RequestedByBox"
                                             Text="Khách lưu trú"
                                             TextChanged="OnAdjustmentTextChanged"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="5" Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Người phê duyệt" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ApprovedByBox"
                                             Text="Quản lý trực ca"
                                             TextChanged="OnAdjustmentTextChanged"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                    <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="AdjustmentNoteBox"
                                             Height="70"
                                             Padding="11,8"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             TextChanged="OnAdjustmentTextChanged"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Giá và chính sách" Style="{StaticResource SectionTitle}"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Giá cũ" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="OldPriceText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#17365D"/>
                                    <TextBlock Margin="0,12,0,0" Text="Chênh lệch / đêm" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="PriceDifferenceText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="#2F6BFF"/>
                                    <TextBlock Margin="0,12,0,0" Text="Phát sinh đổi phòng" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TotalDifferenceText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="#17365D"/>
                                    <TextBlock Margin="0,12,0,0" Text="Tổng phát sinh dự kiến" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="GrandTotalText" Text="—" FontSize="18" FontWeight="Bold" Foreground="#17365D"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Giá mới" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="NewPriceText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#17365D"/>
                                    <TextBlock Margin="0,12,0,0" Text="Số đêm còn lại" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="RemainingNightsText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="#17365D"/>
                                    <TextBlock Margin="0,12,0,0" Text="Số đêm gia hạn" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="ExtraNightsText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="#17365D"/>
                                    <TextBlock Margin="0,12,0,0" Text="Tiền gia hạn" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="ExtensionChargeText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="#17365D"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Margin="0,16" Background="#E2E8F0"/>
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Chính sách giá" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="PricePolicyBox"
                                              SelectionChanged="OnAdjustmentChanged"
                                              Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Giá thỏa thuận / đêm" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="NegotiatedPriceBox"
                                             IsEnabled="False"
                                             TextChanged="OnAdjustmentTextChanged"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                    <TextBlock Text="Lý do miễn chênh lệch" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="WaiverReasonBox"
                                             IsEnabled="False"
                                             TextChanged="OnAdjustmentTextChanged"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="Step5Content" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PanelCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Phòng cũ" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="Kiểm tra và chốt Minibar" Tag="Minibar" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Đối chiếu tài sản trong phòng" Tag="Tài sản" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Thu hồi toàn bộ thẻ phòng cũ" Tag="Thu hồi thẻ" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Thông báo bộ phận Nhà buồng" Tag="Thông báo HSK" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Chuyển phòng cũ về trạng thái chờ dọn" Tag="Đưa phòng dọn" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Phòng mới" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="Xác nhận phòng mới đã sạch" Tag="Phòng sạch" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Kiểm tra nhanh trang thiết bị" Tag="Kiểm tra" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Phát hành thẻ phòng mới" Tag="Thẻ mới" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Chuẩn bị giường phụ nếu có" Tag="Giường phụ" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Chuyển yêu cầu đặc biệt" Tag="Chuyển YCĐB" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Khách và hành lý" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="Xác nhận phương án chuyển khách" Tag="Chuyển khách" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Kiểm đếm và bàn giao hành lý" Tag="Hành lý" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Điều phối Bellman" Tag="Bellman" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Thông báo lịch chuyển cho khách" Tag="Báo khách" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Folio và hồ sơ" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="Chuyển Folio sang phòng mới" Tag="Chuyển Folio" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Chuyển package và quyền lợi" Tag="Chuyển package" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Chuyển ghi chú lưu trú" Tag="Chuyển ghi chú" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Chuyển thông tin VIP" Tag="Chuyển VIP" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="Step6Content" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="16"><StackPanel x:Name="Step6Left"/></Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="16"><StackPanel x:Name="Step6Right"/></Border>
            </Grid>
        </Grid>
        <!-- Footer -->
        <Border Grid.Row="4" Padding="16,10" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStepLabel" Text="Bước 1/6 · Chọn khách" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Hủy" Click="OnClose" Style="{StaticResource SecondaryButton}"/><Button x:Name="BtnBack" Content="← Quay lại" Click="OnBack" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" IsEnabled="False"/>
                    <Button x:Name="BtnNext" Content="Tiếp tục →" Click="OnNext" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
                    <Button x:Name="BtnConfirm" Content="Xác nhận đổi phòng + gia hạn" Click="OnConfirm" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
