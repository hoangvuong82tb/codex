<UserControl x:Class="ASMILE.BO.App.Views.RateEngineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" Loaded="OnLoaded">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:WeekendToColorConverter x:Key="WeekendToColor"/>
        <converters:ActiveToColorConverter x:Key="ActiveToColor"/>
        <converters:ActiveToTextConverter x:Key="ActiveToText"/>
        <converters:GreaterThanZeroToVisibilityConverter x:Key="Gt0ToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>

        <!-- HEADER -->
        <Border Grid.ColumnSpan="2" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Khung giá &amp; kiểm tra giá" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="Thiết lập giá theo hạng phòng, lịch giá, mùa vụ, phụ thu/chiết khấu và yield." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="+ Kế hoạch giá" Command="{Binding OpenCreatePlanCommand}" Style="{StaticResource FluentPrimaryButton}" Margin="0,0,8,0"/><Button Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource FluentSecondaryButton}"/></StackPanel>
            </Grid>
        </Border>

        <!-- LEFT: Rate Plan List + Calendar + Rules -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="12,8">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                    <TextBlock Text="KẾ HOẠCH GIÁ" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding PlanStatusFilters}" SelectedItem="{Binding FilterStatus}" ToolTip="Lọc theo trạng thái" Margin="8,0,8,0"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding RoomTypes}" SelectedItem="{Binding FilterRoomType}" DisplayMemberPath="DisplayName" ToolTip="Lọc theo hạng phòng"/>
                </Grid>
                <ListBox ItemsSource="{Binding VisiblePlans}" SelectedItem="{Binding SelectedPlan}" BorderThickness="0" MaxHeight="150">
                    <ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:RatePlanDto}">
                        <Border Padding="10,6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Cursor="Hand">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PlanCode}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding PlanName}" FontSize="14" Margin="8,0,0,0"/></StackPanel><TextBlock Text="{Binding RoomTypeDisplay}" FontSize="11" Foreground="#475569" Margin="0,2,0,0"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding BaseRate, StringFormat='{}{0:N0} VND'}" FontWeight="Bold" Foreground="#2563EB" FontSize="14"/><TextBlock Text="gia goc/đem" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,2" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Button Content="Sửa kế hoạch" Command="{Binding OpenEditPlanCommand}" Style="{StaticResource FluentPrimaryButton}" Margin="0,0,6,0"/>
                    <Button Content="{Binding SelectedPlan.Status, StringFormat='Đổi trạng thái ({0})'}" Command="{Binding TogglePlanStatusCommand}" Style="{StaticResource FluentSecondaryButton}" Margin="0,0,6,0"/>
                    <Button Content="+ Giá ngày" Command="{Binding OpenAddCalendarCommand}" Style="{StaticResource FluentSecondaryButton}" Margin="0,0,6,0"/>
                    <Button Content="+ Mùa/sự kiện" Command="{Binding OpenAddSeasonCommand}" Style="{StaticResource FluentSecondaryButton}" Margin="0,0,6,0"/>
                    <Button Content="+ Quy tắc" Command="{Binding OpenAddRuleCommand}" Style="{StaticResource FluentSecondaryButton}"/>
                </StackPanel>

                <!-- Calendar Grid -->
                <TextBlock Text="LICH GIA 30 NGAY" FontWeight="Bold" FontSize="13" Margin="0,16,0,4" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding SelectedPlan.Calendar}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:RateCalendarRow}">
                        <Border Width="90" Height="50" Margin="2" CornerRadius="4" Padding="4,2" Background="{Binding IsWeekend, Converter={StaticResource WeekendToColor}}">
                            <StackPanel><TextBlock Text="{Binding Date, StringFormat='{}{0:dd/MM}'}" FontSize="10" HorizontalAlignment="Center"/><TextBlock Text="{Binding Rate, StringFormat='{}{0:N0}'}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#2563EB"/></StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="MÙA &amp; SỰ KIỆN" FontWeight="Bold" FontSize="13" Margin="0,16,0,4" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding SelectedPlan.Seasons}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:RateSeasonRow}">
                        <Border Padding="8,4" Margin="0,0,0,2" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding SeasonType}" FontWeight="SemiBold" FontSize="12"/><TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"><Run Text="{Binding FromDate, StringFormat={}{0:dd/MM/yyyy}}"/><Run Text=" – "/><Run Text="{Binding ToDate, StringFormat={}{0:dd/MM/yyyy}}"/><Run Text=" · "/><Run Text="{Binding Description}"/></TextBlock></StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Multiplier, StringFormat='x{0:N2}'}" Foreground="#EA580C" FontWeight="Bold" VerticalAlignment="Center"/><Button Content="{Binding IsActive, Converter={StaticResource ActiveToText}}" Command="{Binding DataContext.ToggleSeasonStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FluentSecondaryButton}" Padding="6,2" Margin="0,3,0,0"/></StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Rules -->
                <TextBlock Text="QUY TAC GIA" FontWeight="Bold" FontSize="13" Margin="0,16,0,4" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding SelectedPlan.Rules}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:RateRuleRow}">
                        <Border Padding="8,4" Margin="0,0,0,2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding RuleType}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding ValueDisplay}" FontWeight="Bold" Foreground="#F2994A" FontSize="14"/><Border CornerRadius="3" Padding="4,1" Background="{Binding IsActive, Converter={StaticResource ActiveToColor}}" HorizontalAlignment="Right" Margin="0,2,0,0"><TextBlock Text="{Binding IsActive, Converter={StaticResource ActiveToText}}" FontSize="9" Foreground="White"/></Border><Button Content="Bật/tắt" Command="{Binding DataContext.ToggleRuleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FluentSecondaryButton}" Padding="6,2" Margin="0,3,0,0"/></StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT: Price Calculator -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#DDE7F3" BorderThickness="1,0,0,0" Padding="16">
            <StackPanel>
                <TextBlock Text="CÔNG CỤ TÍNH GIÁ" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Kế hoạch đang chọn" FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding SelectedPlan.PlanCode}" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                        <TextBlock Text="{Binding SelectedPlan.PlanName}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedPlan.RoomTypeDisplay}" FontSize="11" Foreground="#475569" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding YieldOccupancyDisplay}" FontSize="11" Foreground="#475569" Margin="0,4,0,0" Visibility="{Binding SelectedPlan.AllowYield, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap"/>
                </Border>
                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8" Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding InfoMessage}" Foreground="#166534" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="Ngày đến:"/><DatePicker SelectedDate="{Binding CalcArrival}" Margin="0,4,0,8"/>
                <TextBlock Text="Ngày đi:"/><DatePicker SelectedDate="{Binding CalcDeparture}" Margin="0,4,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8"><TextBlock Text="Người lớn:" Width="80"/><TextBox Text="{Binding CalcAdults, UpdateSourceTrigger=PropertyChanged}" Width="60"/></StackPanel>
                <Border Background="#F0F4F8" Padding="8" CornerRadius="4" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding CalcNights, StringFormat='Số đêm: {0}'}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CalcBasePrice, StringFormat='Giá nền: {0:N0} VND'}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Button Content="TÍNH GIÁ" Command="{Binding CalculatePriceCommand}" Style="{StaticResource FluentPrimaryButton}" Margin="0,12,0,8" Padding="8,8" FontSize="14"/>
                <Border Background="#F0FDF4" Padding="12" CornerRadius="8" BorderBrush="#16A34A" BorderThickness="1" Visibility="{Binding CalcFinalPrice, Converter={StaticResource Gt0ToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding CalcFinalPrice, StringFormat='GIÁ CUỐI: {0:N0} VND'}" FontSize="20" FontWeight="Bold" Foreground="#16A34A"/>
                        <TextBlock Text="{Binding CalcBreakdown}" FontSize="11" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Plan editor -->
        <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#990F172A" Visibility="{Binding IsPlanEditorOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10">
            <Border Width="650" Background="White" CornerRadius="12" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Tạo kế hoạch giá" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Kế hoạch giá được lưu theo cơ sở và có thể gắn trực tiếp với một hạng phòng." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Mã kế hoạch *"/><TextBox Text="{Binding RatePlanCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                            <TextBlock Text="Hạng phòng"/><ComboBox ItemsSource="{Binding RoomTypes}" SelectedItem="{Binding SelectedRoomType}" DisplayMemberPath="DisplayName" Margin="0,4,0,10"/>
                            <TextBlock Text="Giá cơ bản/đêm *"/><TextBox Text="{Binding RatePlanBaseRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Tên kế hoạch *"/><TextBox Text="{Binding RatePlanName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                            <TextBlock Text="Cấp giá"/><ComboBox ItemsSource="{Binding RateHierarchies}" SelectedItem="{Binding SelectedRateHierarchy}" Margin="0,4,0,10"/>
                            <StackPanel Orientation="Horizontal"><StackPanel Width="140"><TextBlock Text="Hiệu lực từ"/><DatePicker SelectedDate="{Binding RatePlanEffectiveFrom}" Margin="0,4,0,0"/></StackPanel><StackPanel Width="140" Margin="10,0,0,0"><TextBlock Text="Đến"/><DatePicker SelectedDate="{Binding RatePlanEffectiveTo}" Margin="0,4,0,0"/></StackPanel></StackPanel>
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="Bật yield management" IsChecked="{Binding EnableYieldManagement}" Margin="0,14,0,6"/>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Giá sàn" VerticalAlignment="Center"/><TextBox Text="{Binding YieldMinRate, UpdateSourceTrigger=PropertyChanged}" Width="85" Margin="6,0,14,0"/><TextBlock Text="Giá trần" VerticalAlignment="Center"/><TextBox Text="{Binding YieldMaxRate, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="6,0,14,0"/><TextBlock Text="Ngưỡng %" VerticalAlignment="Center"/><TextBox Text="{Binding YieldThreshold, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="6,0,14,0"/><TextBlock Text="Điều chỉnh %" VerticalAlignment="Center"/><TextBox Text="{Binding YieldAdjustmentPct, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,0,0"/></StackPanel>
                    <TextBlock Text="{Binding EditorErrorMessage}" Foreground="#DC2626" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Hủy" Command="{Binding ClosePlanEditorCommand}" Style="{StaticResource FluentSecondaryButton}" Margin="0,0,8,0"/><Button Content="Lưu kế hoạch giá" Command="{Binding SavePlanCommand}" Style="{StaticResource FluentPrimaryButton}"/></StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Daily rate / season / rule editor -->
        <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#990F172A" Visibility="{Binding IsComponentEditorOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="11">
            <Border Width="560" Background="White" CornerRadius="12" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Thiết lập giá chi tiết" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedPlan.PlanName}" Foreground="#2563EB" Margin="0,3,0,16"/>
                    <StackPanel Visibility="{Binding IsCalendarEditor, Converter={StaticResource BoolToVis}}"><TextBlock Text="Ngày áp dụng"/><DatePicker SelectedDate="{Binding ComponentFrom}" Margin="0,4,0,10"/><TextBlock Text="Giá bán/đêm *"/><TextBox Text="{Binding ComponentValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Visibility="{Binding IsSeasonEditor, Converter={StaticResource BoolToVis}}"><TextBlock Text="Loại mùa/sự kiện"/><ComboBox ItemsSource="{Binding SeasonTypes}" SelectedItem="{Binding SelectedSeasonType}" Margin="0,4,0,10"/><StackPanel Orientation="Horizontal"><StackPanel Width="210"><TextBlock Text="Từ ngày"/><DatePicker SelectedDate="{Binding ComponentFrom}" Margin="0,4,0,0"/></StackPanel><StackPanel Width="210" Margin="12,0,0,0"><TextBlock Text="Đến ngày"/><DatePicker SelectedDate="{Binding ComponentTo}" Margin="0,4,0,0"/></StackPanel></StackPanel><TextBlock Text="Hệ số giá *" Margin="0,10,0,0"/><TextBox Text="{Binding ComponentValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Visibility="{Binding IsRuleEditor, Converter={StaticResource BoolToVis}}"><TextBlock Text="Quy tắc"/><ComboBox ItemsSource="{Binding RuleTypes}" SelectedItem="{Binding SelectedRuleType}" Margin="0,4,0,10"/><StackPanel Orientation="Horizontal"><StackPanel Width="220"><TextBlock Text="Giá trị (% / hệ số / giá cố định)"/><TextBox Text="{Binding ComponentValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel><StackPanel Width="100" Margin="12,0,0,0"><TextBlock Text="Ưu tiên"/><TextBox Text="{Binding ComponentPriority, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><CheckBox Content="Độc quyền" IsChecked="{Binding ComponentExclusive}" Margin="0,0,20,0"/><CheckBox Content="Cho phép kết hợp" IsChecked="{Binding ComponentCombinable}"/></StackPanel></StackPanel>
                    <TextBlock Text="Ghi chú" Margin="0,12,0,0"/><TextBox Text="{Binding ComponentDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding EditorErrorMessage}" Foreground="#DC2626" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Hủy" Command="{Binding CloseComponentEditorCommand}" Style="{StaticResource FluentSecondaryButton}" Margin="0,0,8,0"/><Button Content="Lưu thiết lập" Command="{Binding SaveComponentCommand}" Style="{StaticResource FluentPrimaryButton}"/></StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Loading -->
        <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Dang tai..." Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
