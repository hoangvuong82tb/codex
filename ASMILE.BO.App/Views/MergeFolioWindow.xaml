<Window x:Class="ASMILE.BO.App.Views.MergeFolioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gộp Folio" Width="1480" Height="900" MinWidth="1260" MinHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#94A3B8"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModernComboBox" TargetType="ComboBox"><Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/><Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#7B8DA6" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="9" Height="5" Stretch="Uniform"/></Grid></Border><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="8" Margin="0,2"><ScrollViewer MaxHeight="200"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SmallButton" TargetType="Button"><Setter Property="Height" Value="28"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="8,0"/><Setter Property="Margin" Value="0,0,4,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PagerButtonStyle" TargetType="Button"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="26"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModernDataGrid" TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="#FAFBFD"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="RowHeight" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2F6FC"/><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="6,0"/></Style></Setter.Value></Setter></Style>
        <Style x:Key="PanelCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#102E5A"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Padding="16,10" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0891B2" Offset="0"/><GradientStop Color="#0E7490" Offset="1"/></LinearGradientBrush></Border.Background>
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Gộp Folio" FontSize="18" FontWeight="SemiBold" Foreground="#102E5A"/>
                    <TextBlock Text="Hợp nhất nhiều Folio vào một Folio đích và bảo toàn toàn bộ số liệu tài chính." FontSize="12" Foreground="#64748B"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Làm mới" Click="OnRefresh" Style="{StaticResource SecondaryButton}"/>
                    <Button Content="Đóng" Click="OnClose" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STEP BAR -->
        <Border Grid.Row="1" Padding="16,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel x:Name="StepBar" Orientation="Horizontal" HorizontalAlignment="Center"/>
        </Border>

        <!-- SUMMARY STRIP -->
        <Border Grid.Row="2" Padding="12,6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <WrapPanel x:Name="SummaryStrip" HorizontalAlignment="Center"/>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="3" Margin="14,10">
            <!-- STEP A: Source Folios -->
            <Grid x:Name="StepAContent" Visibility="Visible">
                <Grid.ColumnDefinitions><ColumnDefinition Width="70*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="30*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Padding="10,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <WrapPanel>
                                <TextBox x:Name="SourceSearchBox" Width="180" Style="{StaticResource ModernTextBox}" Margin="0,0,4,2"/>
                                <ComboBox x:Name="SourceTypeFilter" Width="90" Style="{StaticResource ModernComboBox}" Margin="0,0,4,2"/>
                                <ComboBox x:Name="SourceCurrFilter" Width="65" Style="{StaticResource ModernComboBox}" Margin="0,0,4,2"/>
                                <ComboBox x:Name="SourceStatusFilter" Width="85" Style="{StaticResource ModernComboBox}" Margin="0,0,4,2"/>
                                <Button Content="Tìm" Click="OnApplySourceFilter" Style="{StaticResource PrimaryButton}" Margin="0,0,4,2"/>
                                <Button Content="Xóa" Click="OnClearSourceFilter" Style="{StaticResource SecondaryButton}" Margin="0,0,4,2"/>
                                <Button Content="Cùng hồ sơ" Click="OnSelectAllSameStay" Style="{StaticResource SmallButton}"/>
                                <Button Content="Cùng đoàn" Click="OnSelectAllSameGroup" Style="{StaticResource SmallButton}"/>
                                <Button Content="Bỏ chọn" Click="OnDeselectAll" Style="{StaticResource SmallButton}"/>
                            </WrapPanel>
                        </Border>
                        <DataGrid x:Name="SourceGrid" Grid.Row="1" Style="{StaticResource ModernDataGrid}" SelectionChanged="OnSourceSelected">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã Folio" Binding="{Binding Code}" Width="85"/>
                                <DataGridTextColumn Header="Loại" Binding="{Binding Type}" Width="65"/>
                                <DataGridTextColumn Header="Khách" Binding="{Binding GuestName}" Width="120"/>
                                <DataGridTextColumn Header="Phòng" Binding="{Binding Room}" Width="55"/>
                                <DataGridTextColumn Header="Hồ sơ" Binding="{Binding Reservation}" Width="85"/>
                                <DataGridTextColumn Header="Payer" Binding="{Binding Payer}" Width="55"/>
                                <DataGridTextColumn Header="Cty/TA" Binding="{Binding Company}" Width="80"/>
                                <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="50"/>
                                <DataGridTextColumn Header="Tổng Nợ" Binding="{Binding TotalDisplay}" Width="90"/>
                                <DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="90"/>
                                <DataGridTextColumn Header="Khoản" Binding="{Binding ItemCount}" Width="50"/>
                                <DataGridTextColumn Header="T.Thái" Binding="{Binding Status}" Width="70"/>
                                <DataGridTextColumn Header="Đoàn" Binding="{Binding GroupCode}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2" Padding="10,6" Background="#FBFCFE" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="SourcePagerSummary" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="SourcePrevBtn" Content="←" Click="OnSourcePrevPage" Style="{StaticResource PagerButtonStyle}"/>
                                    <StackPanel x:Name="SourcePageBtns" Orientation="Horizontal"/>
                                    <Button x:Name="SourceNextBtn" Content="→" Click="OnSourceNextPage" Style="{StaticResource PagerButtonStyle}"/>
                                    <ComboBox x:Name="SourcePageSizeBox" Width="100" Margin="4,0,0,0" SelectionChanged="OnSourcePageSizeChanged" Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Chi tiết Folio" Style="{StaticResource SectionTitle}"/>
                        <Border x:Name="SourceEmptyState" Padding="10" Background="#F8FAFC" CornerRadius="8">
                            <TextBlock Text="Chọn một Folio để xem chi tiết." FontSize="12" Foreground="#94A3B8"/>
                        </Border>
                        <StackPanel x:Name="SourceDetailPanel" Visibility="Collapsed">
                            <TextBlock x:Name="SdCode" FontSize="16" FontWeight="SemiBold" Foreground="#17365D"/>
                            <WrapPanel Margin="0,2,0,6"><TextBlock x:Name="SdType" FontSize="12" Foreground="#64748B"/><TextBlock Text=" · " FontSize="12" Foreground="#CBD5E1"/><TextBlock x:Name="SdGuest" FontSize="12" Foreground="#64748B"/><TextBlock Text=" · " FontSize="12" Foreground="#CBD5E1"/><TextBlock x:Name="SdRoom" FontSize="12" Foreground="#64748B"/></WrapPanel>
                            <Border Height="1" Margin="0,0,0,6" Background="#E2E8F0"/>
                            <TextBlock x:Name="SdRes" FontSize="11" Foreground="#334155" Margin="0,1,0,0"/>
                            <TextBlock x:Name="SdGroup" FontSize="11" Foreground="#334155" Margin="0,1,0,0"/>
                            <TextBlock x:Name="SdPayer" FontSize="11" Foreground="#334155" Margin="0,1,0,0"/>
                            <TextBlock x:Name="SdCompany" FontSize="11" Foreground="#334155" Margin="0,1,0,0"/>
                            <TextBlock x:Name="SdTA" FontSize="11" Foreground="#334155" Margin="0,1,0,0"/>
                            <TextBlock x:Name="SdCurr" FontSize="11" Foreground="#334155" Margin="0,1,0,0"/>
                            <TextBlock x:Name="SdBilling" FontSize="11" Foreground="#334155" Margin="0,1,0,0"/>
                            <TextBlock x:Name="SdTax" FontSize="11" Foreground="#334155" Margin="0,1,0,0"/>
                            <Border Height="1" Margin="0,3,0,3" Background="#E2E8F0"/>
                            <TextBlock x:Name="SdTotal" FontSize="13" FontWeight="SemiBold" Foreground="#17365D" Margin="0,1,0,0"/>
                            <TextBlock x:Name="SdPaid" FontSize="11" Foreground="#16A34A" Margin="0,1,0,0"/>
                            <TextBlock x:Name="SdDeposit" FontSize="11" Foreground="#F59E0B" Margin="0,1,0,0"/>
                            <TextBlock x:Name="SdRefund" FontSize="11" Foreground="#8B5CF6" Margin="0,1,0,0"/>
                            <TextBlock x:Name="SdBalance" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,2,0,0"/>
                            <Border Height="1" Margin="0,3,0,3" Background="#E2E8F0"/>
                            <TextBlock x:Name="SdItems" FontSize="11" Foreground="#334155" Margin="0,1,0,0"/>
                            <TextBlock x:Name="SdLocked" FontSize="11" Foreground="#DC2626" Margin="0,1,0,0"/>
                            <TextBlock x:Name="SdStatus" FontSize="11" FontWeight="SemiBold" Foreground="#2F6BFF" Margin="0,2,0,0"/>
                            <Button x:Name="BtnToggleSource" Content="✓ Chọn Folio này" Click="OnToggleSource" Style="{StaticResource PrimaryButton}" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                            <Border Height="1" Margin="0,4,0,4" Background="#E2E8F0"/>
                            <TextBlock Text="Folio đã chọn" FontSize="12" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,4"/>
                            <StackPanel x:Name="SelPanel"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- STEP B: Compatibility -->
            <Grid x:Name="StepBContent" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="68*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="32*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="12">
                    <StackPanel x:Name="CompLeftPanel"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="12">
                    <StackPanel x:Name="CompRightPanel"/>
                </Border>
            </Grid>

            <!-- STEP C: Target Folio -->
            <Grid x:Name="StepCContent" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="65*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="35*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TargetListPanel"/></ScrollViewer>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TargetPreviewPanel"/></ScrollViewer>
                </Border>
            </Grid>

            <!-- STEP D: Merge Rules -->
            <Grid x:Name="StepDContent" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="RuleLeftPanel"/></ScrollViewer>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="RuleMiddlePanel"/></ScrollViewer>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource PanelCard}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="RuleRightPanel"/></ScrollViewer>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource PanelCard}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="RuleSummaryPanel"/></ScrollViewer>
                </Border>
            </Grid>

            <!-- STEP E: Reconciliation -->
            <Grid x:Name="StepEContent" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="52*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="48*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ReconcileLeftPanel"/></ScrollViewer>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ReconcileRightPanel"/></ScrollViewer>
                </Border>
            </Grid>

            <!-- STEP F: Confirmation -->
            <Grid x:Name="StepFContent" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="52*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="48*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ConfirmLeftPanel"/></ScrollViewer>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ConfirmRightPanel"/></ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="4" Padding="14,8" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStepLabel" Text="Bước 1/6 · Chọn Folio nguồn" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Hủy" Click="OnClose" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="BtnBack" Content="← Quay lại" Click="OnBack" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" IsEnabled="False"/>
                    <Button x:Name="BtnNext" Content="Tiếp tục →" Click="OnNext" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
                    <Button x:Name="BtnConfirm" Content="Xác nhận gộp Folio" Click="OnConfirm" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
