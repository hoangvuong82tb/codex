<UserControl x:Class="ASMILE.BO.App.Views.HousekeepingSupplyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             Loaded="OnLoaded" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
        <Style x:Key="Primary" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/><Setter Property="Background" Value="#0F766E"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#0F766E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="Secondary" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="12,0"/><Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="FilterBox" TargetType="TextBox"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
        <Style x:Key="FilterCombo" TargetType="ComboBox"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,0"/><Setter Property="MinWidth" Value="120"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
        <Style x:Key="GridStyle" TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RowHeight" Value="40"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#ECFDF5"/><Setter Property="Foreground" Value="#0F766E"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="8,0"/></Style></Setter.Value></Setter></Style>
    </UserControl.Resources>
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="20,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="12" Background="#0EA5A8" Margin="0,0,14,0"><TextBlock Text="&#xE7B2;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Đồ vải &amp; tiện nghi" FontSize="21" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Theo dõi tồn kho phòng, cấp bù tiện nghi và biến động đồ vải" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/></StackPanel></StackPanel><Button Grid.Column="1" Content="Làm mới" Style="{StaticResource Secondary}" Command="{Binding RefreshCommand}"/></Grid></Border>
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="16,10"><UniformGrid Columns="5"><Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"><StackPanel><TextBlock Text="Dòng đồ vải" FontSize="11" Foreground="#2563EB"/><TextBlock Text="{Binding LinenLineCount}" FontSize="18" FontWeight="Bold" Foreground="#1D4ED8"/></StackPanel></Border><Border Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"><StackPanel><TextBlock Text="Tổng số đồ vải" FontSize="11" Foreground="#0F766E"/><TextBlock Text="{Binding LinenUnitCount}" FontSize="18" FontWeight="Bold" Foreground="#0F766E"/></StackPanel></Border><Border Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"><StackPanel><TextBlock Text="Dòng tiện nghi" FontSize="11" Foreground="#0F766E"/><TextBlock Text="{Binding AmenityLineCount}" FontSize="18" FontWeight="Bold" Foreground="#0F766E"/></StackPanel></Border><Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"><StackPanel><TextBlock Text="Dưới ngưỡng" FontSize="11" Foreground="#C2410C"/><TextBlock Text="{Binding LowStockCount}" FontSize="18" FontWeight="Bold" Foreground="#C2410C"/></StackPanel></Border><Border Background="#FDF2F8" BorderBrush="#FBCFE8" BorderThickness="1" CornerRadius="8" Padding="10,7"><StackPanel><TextBlock Text="Phòng cần cấp bù" FontSize="11" Foreground="#BE185D"/><TextBlock Text="{Binding RefillRoomCount}" FontSize="18" FontWeight="Bold" Foreground="#BE185D"/></StackPanel></Border></UniformGrid></Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="16,8"><WrapPanel><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}" Width="220" ToolTip="Tìm theo phòng hoặc mã hàng" Margin="0,0,8,4"/><ComboBox ItemsSource="{Binding StockFilters}" SelectedItem="{Binding StockFilter}" Style="{StaticResource FilterCombo}" Width="135" Margin="0,0,8,4"/><Button Content="Xóa lọc" Style="{StaticResource Secondary}" Command="{Binding ClearFiltersCommand}" Margin="0,0,8,4"/><Button Content="Ghi nhận đồ vải" Style="{StaticResource Primary}" Command="{Binding RecordLinenTransactionCommand}" Margin="0,0,8,4"/><Button Content="Tạo yêu cầu cấp bù" Style="{StaticResource Primary}" Background="#2563EB" BorderBrush="#2563EB" Command="{Binding RequestRefillCommand}" Margin="0,0,8,4"/></WrapPanel></Border>
        <Grid Grid.Row="3" Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,10,0"><TabControl><TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="Đồ vải trong phòng"/><Border Background="#DBEAFE" CornerRadius="10" Padding="6,1" Margin="8,0,0,0"><TextBlock Text="{Binding LinenLineCount}" Foreground="#1D4ED8" FontSize="10"/></Border></StackPanel></TabItem.Header><DataGrid ItemsSource="{Binding FilteredLinenInventory}" SelectedItem="{Binding SelectedLinen, Mode=TwoWay}" Style="{StaticResource GridStyle}" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Phòng" Binding="{Binding RoomDisplay}" Width="100"/><DataGridTextColumn Header="Mã đồ vải" Binding="{Binding LinenCode}" Width="140"/><DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="90"/><DataGridTextColumn Header="Lần giặt" Binding="{Binding WashCycleCount}" Width="80"/><DataGridTextColumn Header="Hư hỏng" Binding="{Binding DamagedCount}" Width="80"/><DataGridTextColumn Header="Nhập gần nhất" Binding="{Binding LastRestockedDisplay}" Width="160"/></DataGrid.Columns></DataGrid></TabItem><TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="Tiện nghi trong phòng"/><Border Background="#DCFCE7" CornerRadius="10" Padding="6,1" Margin="8,0,0,0"><TextBlock Text="{Binding AmenityLineCount}" Foreground="#15803D" FontSize="10"/></Border></StackPanel></TabItem.Header><DataGrid ItemsSource="{Binding FilteredAmenityInventory}" SelectedItem="{Binding SelectedAmenity, Mode=TwoWay}" Style="{StaticResource GridStyle}" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Phòng" Binding="{Binding RoomDisplay}" Width="100"/><DataGridTextColumn Header="Mã tiện nghi" Binding="{Binding AmenityCode}" Width="140"/><DataGridTextColumn Header="Tồn hiện tại" Binding="{Binding CurrentStock}" Width="100"/><DataGridTextColumn Header="Mức par" Binding="{Binding ParLevel}" Width="85"/><DataGridTextColumn Header="Thiếu" Binding="{Binding Shortage}" Width="70"/><DataGridTextColumn Header="Tiêu thụ 30 ngày" Binding="{Binding ConsumptionLast30Days}" Width="125"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding StockStatus}" Width="110"/><DataGridTextColumn Header="Cấp bù gần nhất" Binding="{Binding LastRefillDisplay}" Width="160"/></DataGrid.Columns></DataGrid></TabItem></TabControl></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Chi tiết dòng đã chọn" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,12"/><Border Background="#F8FAFC" CornerRadius="8" Padding="12" Visibility="{Binding HasSelectedAmenity, Converter={StaticResource BoolToVis}}"><StackPanel><TextBlock Text="TIỆN NGHI" FontSize="10" FontWeight="Bold" Foreground="#0F766E"/><TextBlock Text="{Binding SelectedAmenity.AmenityCode}" FontSize="17" FontWeight="SemiBold" Foreground="#17365D" Margin="0,4,0,10"/><TextBlock Text="{Binding SelectedAmenity.RoomDisplay, StringFormat=Phòng: {0}}" Foreground="#475569"/><TextBlock Text="{Binding SelectedAmenity.CurrentStock, StringFormat=Tồn hiện tại: {0}}" Foreground="#475569"/><TextBlock Text="{Binding SelectedAmenity.ParLevel, StringFormat=Mức par: {0}}" Foreground="#475569"/><TextBlock Text="{Binding SelectedAmenity.Shortage, StringFormat=Thiếu: {0}}" Foreground="#C2410C" Margin="0,0,0,8"/><Button Content="Tạo yêu cầu cấp bù" Style="{StaticResource Primary}" Command="{Binding RequestRefillCommand}"/></StackPanel></Border><Border Background="#F8FAFC" CornerRadius="8" Padding="12" Visibility="{Binding HasSelectedLinen, Converter={StaticResource BoolToVis}}"><StackPanel><TextBlock Text="ĐỒ VẢI" FontSize="10" FontWeight="Bold" Foreground="#2563EB"/><TextBlock Text="{Binding SelectedLinen.LinenCode}" FontSize="17" FontWeight="SemiBold" Foreground="#17365D" Margin="0,4,0,10"/><TextBlock Text="{Binding SelectedLinen.RoomDisplay, StringFormat=Phòng: {0}}" Foreground="#475569"/><TextBlock Text="{Binding SelectedLinen.Quantity, StringFormat=Số lượng: {0}}" Foreground="#475569"/><TextBlock Text="{Binding SelectedLinen.WashCycleCount, StringFormat=Số lần giặt: {0}}" Foreground="#475569"/><Separator Margin="0,12"/><TextBlock Text="Biến động" FontWeight="SemiBold" Foreground="#17365D" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding LinenActionOptions}" SelectedItem="{Binding SelectedLinenAction}" Style="{StaticResource FilterCombo}"/><TextBox Text="{Binding LinenQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}" Margin="0,4,0,8" ToolTip="Số lượng"/><Button Content="Ghi nhận biến động" Style="{StaticResource Primary}" Command="{Binding RecordLinenTransactionCommand}"/></StackPanel></Border><TextBlock Text="Chọn một dòng tồn kho để xem chi tiết và thao tác." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></ScrollViewer></Border></Grid>
        <Border Grid.Row="4" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,1,0,0" Padding="16,8"><Grid><TextBlock Text="{Binding DataMessage}" Foreground="#64748B" FontSize="11"/><StackPanel HorizontalAlignment="Right"><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="11" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/><TextBlock Text="{Binding InfoMessage}" Foreground="#15803D" FontSize="11"/></StackPanel></Grid></Border>
        <Border Grid.RowSpan="5" Background="#66000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"><TextBlock Text="Đang tải dữ liệu..." Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
</UserControl>
