<Window x:Class="ASMILE.BO.App.Views.IssueInvoiceWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phát hành hóa đơn" Width="1280" Height="820" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModernDataGrid" TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="RowHeight" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2F6FC"/><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="6,0"/></Style></Setter.Value></Setter></Style>
        <Style x:Key="PagerButtonStyle" TargetType="Button"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="26"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="1,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,0"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModernComboBox" TargetType="ComboBox"><Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center"/><Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#7B8DA6" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="8" Height="4" Stretch="Uniform"/></Grid></Border><Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="7" Margin="0,2"><ScrollViewer MaxHeight="200"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PanelCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Padding="16,10" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#10B981" Offset="0"/><GradientStop Color="#059669" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Phát hành hóa đơn" FontSize="18" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Tạo và phát hành hóa đơn từ Folio lưu trú." FontSize="12" Foreground="#64748B"/></StackPanel>
                <Button Grid.Column="2" Content="Đóng" Click="OnClose" Style="{StaticResource SecondaryButton}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="16,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel x:Name="StepBar" Orientation="Horizontal" HorizontalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="2" Margin="14,10">
            <!-- STEP A -->
            <Grid x:Name="Step1" Visibility="Visible">
                <Grid.ColumnDefinitions><ColumnDefinition Width="65*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="35*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Padding="10,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <WrapPanel><TextBox x:Name="FolioSearchBox" Width="180" Style="{StaticResource ModernTextBox}" Margin="0,0,6,4"/><ComboBox x:Name="FolioStatusFilter" Width="90" Style="{StaticResource ModernComboBox}" Margin="0,0,6,4"/><Button Content="Tìm" Click="OnApplyFFilter" Style="{StaticResource PrimaryButton}" Margin="0,0,4,4"/><Button Content="Xóa lọc" Click="OnClearFFilter" Style="{StaticResource SecondaryButton}" Margin="0,0,0,4"/></WrapPanel>
                        </Border>
                        <DataGrid x:Name="FolioGrid" Grid.Row="1" Style="{StaticResource ModernDataGrid}" SelectionChanged="OnFolioSelected">
                            <DataGrid.Columns><DataGridTextColumn Header="Folio" Binding="{Binding Code}" Width="85"/><DataGridTextColumn Header="Khách" Binding="{Binding Guest}" Width="130"/><DataGridTextColumn Header="Công ty" Binding="{Binding Company}" Width="110"/><DataGridTextColumn Header="Phòng" Binding="{Binding Room}" Width="55"/><DataGridTextColumn Header="Reservation" Binding="{Binding Reservation}" Width="90"/><DataGridTextColumn Header="Tổng" Binding="{Binding TotalDisplay}" Width="90"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="75"/><DataGridTextColumn Header="HĐ đã xuất" Binding="{Binding IssuedInvoice}" Width="100"/></DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2" Padding="10,6" Background="#FBFCFE" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="FolioPagerSummary" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="FolioPrevBtn" Content="←" Click="OnFPrevPage" Style="{StaticResource PagerButtonStyle}"/><StackPanel x:Name="FolioPageBtns" Orientation="Horizontal"/><Button x:Name="FolioNextBtn" Content="→" Click="OnFNextPage" Style="{StaticResource PagerButtonStyle}"/><ComboBox x:Name="FolioPageSizeBox" Width="100" Margin="4,0,0,0" SelectionChanged="OnFPageSizeChanged" Style="{StaticResource ModernComboBox}"/></StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="12">
                    <StackPanel><TextBlock Text="Chi tiết Folio" FontSize="14" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,8"/>
                        <Border x:Name="FolioEmptyState" Padding="12" Background="#F8FAFC" CornerRadius="8"><TextBlock Text="Chọn Folio để xem chi tiết." FontSize="12" Foreground="#94A3B8"/></Border>
                        <StackPanel x:Name="FolioDetail" Visibility="Collapsed">
                            <TextBlock x:Name="FdCode" FontSize="16" FontWeight="SemiBold" Foreground="#17365D"/>
                            <TextBlock x:Name="FdGuest" FontSize="12" Foreground="#334155" Margin="0,4,0,0"/>
                            <TextBlock x:Name="FdCompany" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            <TextBlock x:Name="FdRoom" FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                            <TextBlock x:Name="FdRes" FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                            <Border Height="1" Margin="0,6,0,6" Background="#E2E8F0"/>
                            <TextBlock x:Name="FdArrival" FontSize="11" Foreground="#334155" Margin="0,1,0,0"/>
                            <TextBlock x:Name="FdDeparture" FontSize="11" Foreground="#334155" Margin="0,1,0,0"/>
                            <Border Height="1" Margin="0,6,0,6" Background="#E2E8F0"/>
                            <TextBlock x:Name="FdBalance" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            <TextBlock x:Name="FdTotal" FontSize="12" Foreground="#64748B" Margin="0,1,0,0"/>
                            <TextBlock x:Name="FdStatus" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <Button x:Name="BtnSelectFolio" Content="Chọn Folio này" Click="OnSelectFolio" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- STEP B -->
            <Grid x:Name="Step2" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="42*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Step2Left"/></ScrollViewer></Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="14"><StackPanel x:Name="Step2Right"/></Border>
            </Grid>
            <!-- STEP C -->
            <Grid x:Name="Step3" Visibility="Collapsed">
                <Border Style="{StaticResource PanelCard}" Padding="20" MaxWidth="700" HorizontalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Step3Panel"/></ScrollViewer>
                </Border>
            </Grid>
            <!-- STEP D -->
            <Grid x:Name="Step4" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="50*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="50*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="14"><StackPanel x:Name="Step4Left"/></Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="14"><StackPanel x:Name="Step4Right"/></Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Padding="14,8" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterLabel" Text="Bước 1/4 · Chọn Folio" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Hủy" Click="OnClose" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="BtnBack" Content="← Quay lại" Click="OnBack" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" IsEnabled="False"/>
                    <Button x:Name="BtnNext" Content="Tiếp tục →" Click="OnNext" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
                    <Button x:Name="BtnIssue" Content="Phát hành hóa đơn" Click="OnIssue" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
