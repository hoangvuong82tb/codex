<Window x:Class="ASMILE.BO.App.Views.StayProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hồ sơ lưu trú" Width="1420" Height="880"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="ModTextBox" TargetType="TextBox"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModCombo" TargetType="ComboBox"><Setter Property="Height" Value="38"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/><Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#7B8DA6" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="6" Stretch="Uniform"/></Grid></Border><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="9" Margin="0,2"><ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModDataGrid" TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="#FAFBFD"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="ColumnHeaderHeight" Value="42"/><Setter Property="RowHeight" Value="42"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2F6FC"/><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="10,0"/></Style></Setter.Value></Setter>
        </Style>
        <Style x:Key="TabBtn" TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="MinWidth" Value="90"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GrayBtn" TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="Background" Value="#F3F6FA"/><Setter Property="Foreground" Value="#52657D"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/></Style>
        <Style x:Key="ModDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="CalendarStyle" Value="{StaticResource FoModernCalendarStyle}"/>
            <Setter Property="FirstDayOfWeek" Value="Monday"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
                <Grid>
                    <Border x:Name="Root" Background="White" BorderBrush="#D7E2F0" BorderThickness="1" CornerRadius="9" SnapsToDevicePixels="True"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <DatePickerTextBox x:Name="PART_TextBox" BorderThickness="0" Background="Transparent" Padding="12,0" VerticalContentAlignment="Center" FontSize="13" FontFamily="Segoe UI" Foreground="#17365D"/>
                            <TextBlock x:Name="Watermark" Text="Chọn ngày" IsHitTestVisible="False" Background="White"
                                       FontSize="13" FontFamily="Segoe UI" Foreground="#94A3B8"
                                       Padding="12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <ToggleButton x:Name="PART_Button" Grid.Column="1" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#F2F6FD">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2F6BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ToggleButton>
                    </Grid>
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                        <Calendar x:Name="PART_Calendar" Style="{StaticResource FoModernCalendarStyle}" Language="vi-VN" BorderThickness="0" Background="White" SelectedDate="{Binding SelectedDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" DisplayDate="{Binding DisplayDate, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#AFCBF7"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#2F6BFF"/></Trigger>
                    <DataTrigger Binding="{Binding SelectedDate, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                        <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="BlueBtn" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="BadgeGreen" TargetType="Border"><Setter Property="Background" Value="#DCFCE7"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="BadgeBlue" TargetType="Border"><Setter Property="Background" Value="#DBEAFE"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="BadgeRed" TargetType="Border"><Setter Property="Background" Value="#FEE2E2"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="BadgeGray" TargetType="Border"><Setter Property="Background" Value="#F3F4F6"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="#FAFBFD"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinWidth" Value="90"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2563EB" Offset="0"/><GradientStop Color="#1D4ED8" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="Hồ sơ lưu trú" FontSize="20" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Tra cứu và quản lý thông tin khách đã hoặc đang lưu trú" FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="2" Content="Làm mới" Click="OnRefresh" Style="{StaticResource GrayBtn}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="14,10,14,6" Padding="14,12" Background="White" CornerRadius="12" BorderBrush="#D8E2F0" BorderThickness="1">
            <WrapPanel><StackPanel Margin="0,0,10,4"><TextBlock Text="Từ khóa" FontSize="11" Foreground="#94A3B8"/><TextBox x:Name="SearchBox" Width="240" Style="{StaticResource ModTextBox}"/></StackPanel>
                <StackPanel Margin="0,0,10,4"><TextBlock Text="Trạng thái" FontSize="11" Foreground="#94A3B8"/><ComboBox Width="170" Style="{StaticResource ModCombo}" x:Name="StatusFilter" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Đang lưu trú"/><ComboBoxItem Content="Đã trả phòng"/><ComboBoxItem Content="Sắp đến"/><ComboBoxItem Content="Đã hủy"/><ComboBoxItem Content="Không đến"/></ComboBox></StackPanel>
                <StackPanel Margin="0,0,10,4"><TextBlock Text="Ngày đến từ" FontSize="11" Foreground="#94A3B8"/><DatePicker Width="150" Style="{StaticResource ModDatePicker}"/></StackPanel>
                <StackPanel Margin="0,0,10,4"><TextBlock Text="Ngày đến đến" FontSize="11" Foreground="#94A3B8"/><DatePicker Width="150" Style="{StaticResource ModDatePicker}"/></StackPanel>
                <StackPanel Margin="0,16,6,4"><Button Content="Tìm" Click="OnRefresh" Style="{StaticResource BlueBtn}" Width="80"/></StackPanel><StackPanel Margin="0,16,0,4"><Button Content="Xóa lọc" Click="OnClearFilter" Style="{StaticResource GrayBtn}"/></StackPanel>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" Margin="14,4,14,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="6*" MinWidth="480"/><ColumnDefinition Width="14"/><ColumnDefinition Width="4*" MinWidth="380"/></Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Danh sách hồ sơ" FontSize="14" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Grid.Column="1" FontSize="12" Foreground="#94A3B8" x:Name="ResultCount" Text="20 hồ sơ"/></Grid></Border>
                    <DataGrid Grid.Row="1" x:Name="StayGrid" Style="{StaticResource ModDataGrid}" SelectionChanged="OnStaySelected"><DataGrid.Columns><DataGridTextColumn Header="Trạng thái" Binding="{Binding Col1}" Width="120"/><DataGridTextColumn Header="Mã HS" Binding="{Binding Col2}" Width="100"/><DataGridTextColumn Header="Họ tên" Binding="{Binding Col3}" Width="170"/><DataGridTextColumn Header="Điện thoại" Binding="{Binding Col4}" Width="120"/><DataGridTextColumn Header="Số giấy tờ" Binding="{Binding Col5}" Width="120"/><DataGridTextColumn Header="Số phòng" Binding="{Binding Col6}" Width="80"/><DataGridTextColumn Header="Ngày đến" Binding="{Binding Col7}" Width="100"/><DataGridTextColumn Header="Ngày đi" Binding="{Binding Col8}" Width="100"/></DataGrid.Columns></DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" Text="Chi tiết hồ sơ"/><TextBlock x:Name="DetailName" FontSize="14" FontWeight="SemiBold" Foreground="#17365D" Margin="0,2,0,0"/><TextBlock x:Name="DetailMeta" FontSize="12" Foreground="#6F8198"/></StackPanel>
                            <Button Grid.Column="1" Content="Chỉnh sửa" Click="OnEditToggle" Style="{StaticResource GrayBtn}" Height="32" FontSize="12" Padding="12,0"/>
                        </Grid>
                    </Border>
                    <WrapPanel Grid.Row="1" Margin="16,10"><Border Style="{StaticResource MetricCard}" Margin="0,0,6,4"><StackPanel><TextBlock Text="Trạng thái" FontSize="10" Foreground="#94A3B8"/><TextBlock x:Name="MetricStatus" FontSize="16" FontWeight="Bold" Foreground="#16A34A" Text="—"/></StackPanel></Border><Border Style="{StaticResource MetricCard}" Margin="0,0,6,4"><StackPanel><TextBlock Text="Số lần LS" FontSize="10" Foreground="#94A3B8"/><TextBlock x:Name="MetricVisits" FontSize="16" FontWeight="Bold" Foreground="#17365D" Text="—"/></StackPanel></Border><Border Style="{StaticResource MetricCard}" Margin="0,0,6,4"><StackPanel><TextBlock Text="Tổng đêm" FontSize="10" Foreground="#94A3B8"/><TextBlock x:Name="MetricNights" FontSize="16" FontWeight="Bold" Foreground="#17365D" Text="—"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Gần nhất" FontSize="10" Foreground="#94A3B8"/><TextBlock x:Name="MetricLast" FontSize="16" FontWeight="Bold" Foreground="#17365D" Text="—"/></StackPanel></Border></WrapPanel>
                    <Border Grid.Row="2" Padding="16,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><Button Content="Tổng quan" Click="OnTabClick" Tag="0" Style="{StaticResource TabBtn}"/><Button Content="Giấy tờ" Click="OnTabClick" Tag="1" Style="{StaticResource TabBtn}"/><Button Content="Lưu trú" Click="OnTabClick" Tag="2" Style="{StaticResource TabBtn}"/><Button Content="Phòng &amp; DV" Click="OnTabClick" Tag="3" Style="{StaticResource TabBtn}"/><Button Content="Tài chính" Click="OnTabClick" Tag="4" Style="{StaticResource TabBtn}"/></StackPanel></Border>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TabContent" Margin="16,12"/></ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="14,10" Margin="14,10,14,12" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#64748B" x:Name="FooterTotal" Text="Tổng: 20 hồ sơ"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="← Trước" Style="{StaticResource GrayBtn}"/><Button Content="Sau →" Style="{StaticResource GrayBtn}" Margin="8,0,0,0"/><Button Content="Đóng" Click="OnClose" Style="{StaticResource GrayBtn}" Margin="16,0,0,0"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
