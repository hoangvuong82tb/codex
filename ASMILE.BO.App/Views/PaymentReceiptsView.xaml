<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ASMILE.BO.App.Views.PaymentReceiptsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ASMILE.BO.App.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" xmlns:views="clr-namespace:ASMILE.BO.App.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <Style x:Key="CompactPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource FluentPrimaryButtonStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="102" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <Style x:Key="CompactPrimaryIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource FluentPrimaryButtonStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Width" Value="52" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <Style x:Key="CompactSecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource FluentSecondaryButtonStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="102" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="15" />
      </Style>
      <Style x:Key="CompactSecondaryIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource FluentSecondaryButtonStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Width" Value="52" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="17" />
      </Style>
      <Style x:Key="CompactDangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource FluentDangerButtonStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="102" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <Style x:Key="VoucherTabButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource FluentSecondaryButtonStyle}">
        <Setter Property="MinWidth" Value="94" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#3F516B" />
        <Setter Property="Background" Value="#F8FAFD" />
        <Setter Property="BorderBrush" Value="#D4DEE9" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
            <Setter Property="Foreground" Value="#1E56C4" />
            <Setter Property="Background" Value="#EAF2FF" />
            <Setter Property="BorderBrush" Value="#92B8FF" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="VoucherDatePickerStyle" TargetType="{x:Type DatePicker}" BasedOn="{StaticResource {x:Type DatePicker}}">
        <Setter Property="Height" Value="42" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="#1F3653" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="DatePicker.SelectedDateFormat" Value="Short" />
        <Setter Property="FrameworkElement.Language" Value="vi-VN" />
        <Setter Property="Padding" Value="8,0,4,0" />
      </Style>
      <Style x:Key="VoucherDateHostStyle" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="42" />
        <Setter Property="Border.CornerRadius" Value="12" />
        <Setter Property="BorderBrush" Value="#AFC5E8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#FCFEFF" />
        <Setter Property="Border.Padding" Value="6,0,6,0" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="{StaticResource SupplierPageBackgroundBrush}" Padding="30,18,30,30">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,14">
        <TextBlock Text="Phiếu thu" FontSize="31" FontWeight="Bold" Foreground="#162C4E" />
        <TextBlock Text="Quản lý chứng từ thu tiền khách hàng và số dư công nợ." Margin="0,4,0,0" FontSize="15.5" Foreground="#4C6281" />
      </StackPanel>
      <Grid Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="68*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="32*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Column="0" Row="0" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource VoucherTabButtonStyle}" Margin="0,0,8,0" Tag="{Binding IsCreateTabSelected}" Command="{Binding ShowCreateTabCommand}">
            <TextBlock Text="Lập phiếu" />
          </Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding IsListTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Từ" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#4C6281" FontSize="13" />
            <Border Style="{StaticResource VoucherDateHostStyle}" Width="132" Height="34" Margin="0,0,8,0">
              <DatePicker Style="{StaticResource VoucherDatePickerStyle}" Height="32" Margin="-5,5,5,-5" SelectedDate="{Binding FilterFromDate}" />
            </Border>
            <TextBlock Text="Đến" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#4C6281" FontSize="13" />
            <Border Style="{StaticResource VoucherDateHostStyle}" Width="132" Height="34">
              <DatePicker Style="{StaticResource VoucherDatePickerStyle}" Height="32" Margin="1,5,-1,-5" SelectedDate="{Binding FilterToDate}" />
            </Border>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource VoucherTabButtonStyle}" Margin="0,0,8,0" Tag="{Binding IsPendingTabSelected}" Command="{Binding ShowPendingTabCommand}">
            <TextBlock Text="Chờ duyệt" />
          </Button>
          <Button Grid.Column="3" Style="{StaticResource VoucherTabButtonStyle}" Margin="0,0,8,0" Tag="{Binding IsApprovedTabSelected}" Command="{Binding ShowApprovedTabCommand}">
            <TextBlock Text="Đã duyệt" />
          </Button>
          <Button Grid.Column="4" Style="{StaticResource CompactPrimaryIconButtonStyle}" Margin="0,0,8,0" Command="{Binding NewCommand}">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#FFFFFFFF" />
          </Button>
          <Button Grid.Column="5" Style="{StaticResource CompactSecondaryIconButtonStyle}" Margin="0,0,8,0" Command="{Binding RefreshCommand}">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" />
          </Button>
          <Button Grid.Column="6" Style="{StaticResource CompactSecondaryIconButtonStyle}" Margin="0,0,8,0" Command="{Binding ExportCsvCommand}" ToolTip="Xuất CSV danh sách phiếu thu">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" />
          </Button>
        </Grid>
        <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource FluentCardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="64" />
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="0" Margin="16,12,16,0" AutoGenerateColumns="False" Style="{StaticResource FluentDataGridStyle}" ColumnHeaderStyle="{StaticResource FluentDataGridColumnHeaderStyle}" RowStyle="{StaticResource FluentListRow}" RowHeight="52" ItemsSource="{Binding ReceiptPager.Items}" SelectedItem="{Binding SelectedReceipt}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Ngày thu" Width="120" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" />
                <DataGridTextColumn Header="Số phiếu" Width="130" Binding="{Binding DocumentNo}" />
                <DataGridTextColumn Header="Mã KH" Width="95" Binding="{Binding CustomerCode}" />
                <DataGridTextColumn Header="Khách hàng" Width="*" Binding="{Binding CustomerName}" />
                <DataGridTextColumn Header="Số tiền" Width="140" Binding="{Binding Amount, StringFormat=N0}" />
                <DataGridTextColumn Header="Phương thức" Width="130" Binding="{Binding Method}" />
                <DataGridTextColumn Header="Trạng thái" Width="120" Binding="{Binding Status}" />
              </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="1" BorderBrush="#D9E5F4" BorderThickness="0,1,0,0" Padding="16,8,16,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="180" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="#5A6F8E" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Text="{Binding ReceiptPager.PageText}" />
                <controls:TablePagerControl Grid.Column="1" HorizontalAlignment="Right" DataContext="{Binding ReceiptPager}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                  <Button Style="{StaticResource CompactPrimaryButtonStyle}" Margin="0,0,10,0" Height="39" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsPendingTabSelected, Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding ApproveSelectedCommand}">
                    <TextBlock Text="Duyệt" Foreground="#FFFFFFFF" />
                  </Button>
                  <Button Style="{StaticResource CompactSecondaryButtonStyle}" Margin="0,0,10,0" Visibility="{Binding IsPendingTabSelected, Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding EditSelectedCommand}">
                    <TextBlock Text="Sửa" />
                  </Button>
                  <Button Style="{StaticResource CompactDangerButtonStyle}" Margin="0,0,10,0" Visibility="{Binding IsPendingTabSelected, Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding DeleteSelectedCommand}">
                    <TextBlock Text="Xóa" Foreground="#FFFFFFFF" />
                  </Button>
                  <Button Style="{StaticResource CompactSecondaryButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsApprovedTabSelected, Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding ReapproveCommand}">
                    <TextBlock Text="Duyệt lại" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
        <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource FluentCardStyle}">
          <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#2F65D9" FontSize="18" />
              <TextBlock Text="Thông tin phiếu thu" Margin="10,0,0,0" FontSize="22" FontWeight="SemiBold" Foreground="#203B5F" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,12">
              <StackPanel>
                <Grid Margin="0,0,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Số phiếu *" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource FluentTextBox}" IsReadOnly="True" Text="{Binding ReceiptNo}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Ngày chứng từ" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Border Style="{StaticResource VoucherDateHostStyle}">
                      <DatePicker Style="{StaticResource VoucherDatePickerStyle}" Margin="0,7,0,-9" SelectedDate="{Binding ReceiptDate}" />
                    </Border>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Khách hàng" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox Style="{StaticResource FluentComboBox}" DisplayMemberPath="CustomerName" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Người thu tiền" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox Style="{StaticResource FluentComboBox}" DisplayMemberPath="FullName" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" ItemsSource="{Binding Collectors}" SelectedItem="{Binding SelectedCollector}" />
                  </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Số tiền / Phương thức" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Style="{StaticResource FluentTextBox}" Text="{Binding Amount, StringFormat=N0}" />
                      <TextBox Grid.Column="2" Style="{StaticResource FluentTextBox}" Text="{Binding PaymentMethod}" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Tài khoản nợ / có" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Style="{StaticResource FluentTextBox}" Text="{Binding DebitAccountCode}" />
                      <TextBox Grid.Column="2" Style="{StaticResource FluentTextBox}" Text="{Binding CreditAccountCode}" />
                    </Grid>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Ghi chú" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,12,0,6" />
                <TextBox Style="{StaticResource FluentTextBox}" AcceptsReturn="True" Height="76" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12,8" Text="{Binding Note}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                  <Button Style="{StaticResource CompactPrimaryButtonStyle}" Margin="0,0,10,0" Command="{Binding AddDraftCommand}">
                    <TextBlock Text="Thêm dòng" Foreground="#FFFFFFFF" />
                  </Button>
                  <Button Style="{StaticResource CompactDangerButtonStyle}">
                    <TextBlock Text="Xóa dòng" Foreground="#FFFFFFFF" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource CompactSecondaryButtonStyle}" Margin="0,0,10,0" Command="{Binding NewCommand}">
                <TextBlock Text="Mới" />
              </Button>
              <Button Style="{StaticResource CompactPrimaryButtonStyle}" Margin="0,0,10,0" Command="{Binding SaveReceiptCommand}">
                <TextBlock Text="Lưu" Foreground="#FFFFFFFF" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
