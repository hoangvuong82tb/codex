<Window x:Class="ASMILE.BO.App.Views.Auth.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Đăng nhập ASMILE BO"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="Black"
        FontFamily="Segoe UI Variable Text, Segoe UI">
        <Grid FocusManager.FocusedElement="{Binding ElementName=PasswordBox}">
        <Grid.Background>
            <ImageBrush ImageSource="file:///C:/Windows/Web/Wallpaper/Windows/img0.jpg"
                        Stretch="UniformToFill"
                        AlignmentX="Center"
                        AlignmentY="Center"/>
        </Grid.Background>

        <Border Background="#78000000"/>

        <Border Width="420"
                Padding="20,18,20,18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="24"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                Background="#22FFFFFF">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#66000000" Opacity="0.65"/>
            </Border.Effect>
            <StackPanel Opacity="0">
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.35"/>
                            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                From="0,26,0,0" To="0,0,0,0"
                                                Duration="0:0:0.35"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>

            <Ellipse Width="96" Height="96" Fill="#33FFFFFF" HorizontalAlignment="Center"/>
            <TextBlock Text="&#xE77B;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="44"
                       Foreground="#E5EEFF"
                       HorizontalAlignment="Center"
                       Margin="0,-74,0,26"/>

            <TextBlock Text="{Binding DisplayName}"
                       FontSize="36"
                       FontWeight="SemiBold"
                       Foreground="White"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="ASMILE BO Enterprise Shell"
                       FontSize="15"
                       Foreground="#BFD3F7"
                       Opacity="0.8"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,20"/>

            <TextBox Width="360"
                     Style="{StaticResource Win11PillTextBoxStyle}"
                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding UseAnotherAccount, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Margin="0,0,0,10"/>

            <Grid Width="360" Height="42">
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource Win11PillPasswordBoxStyle}"
                             Padding="16,0,86,0"
                             PasswordChanged="PasswordBox_OnPasswordChanged"
                             KeyDown="PasswordInput_OnKeyDown"/>

                <TextBox x:Name="PasswordText"
                         Style="{StaticResource Win11PillTextBoxStyle}"
                         Padding="16,0,86,0"
                         Text="{Binding VisiblePassword, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="Collapsed"
                         TextChanged="PasswordText_OnTextChanged"
                         KeyDown="PasswordInput_OnKeyDown"/>

                <TextBlock x:Name="PasswordPlaceholder"
                           Text="Password"
                           Foreground="#6B7280"
                           IsHitTestVisible="False"
                           Margin="16,0,86,0"
                           VerticalAlignment="Center"/>

                <Button x:Name="EyeButton"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,44,0"
                        Style="{StaticResource Win11GhostIconButton}"
                        Click="ShowPassword_OnChanged">
                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" Foreground="#E2E8F0" FontSize="14"/>
                </Button>

                <Button Width="36"
                        Height="36"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,2,0"
                        Style="{StaticResource Win11RoundPrimaryButton}"
                        Command="{Binding LoginCommand}">
                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White"/>
                </Button>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}"
                       FontSize="12"
                       Foreground="#FF6B6B"
                       TextAlignment="Center"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"/>

            <TextBlock HorizontalAlignment="Center" Margin="0,12,0,0" Cursor="Hand" Foreground="#FFFFFF" Opacity="0.85" FontSize="12" TextDecorations="Underline">
                <Hyperlink Command="{Binding ToggleAnotherAccountCommand}" Foreground="#FFFFFF">Đăng nhập bằng tài khoản khác</Hyperlink>
            </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,16">
            <Border Width="30" Height="30" CornerRadius="15" Background="#22FFFFFF" Margin="0,0,8,0">
                <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <Border Width="30" Height="30" CornerRadius="15" Background="#22FFFFFF" Margin="0,0,12,0">
                <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <Border Background="#22000000" CornerRadius="12" Padding="10,6">
                <TextBlock FontSize="11" Foreground="White" Opacity="0.78" Text="SQL Connected | Version 1.0.0"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
