<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ASMILE.BO.App.Views.Dialogs.PayableDebtDetailDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chi tiết công nợ nhà cung cấp" Width="1040" Height="640" MinWidth="980" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#F5F8FC" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" xmlns:dialogs="clr-namespace:ASMILE.BO.App.Views.Dialogs;assembly=ASMILE.BO.App">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="#FFFFFFFF" BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Chi tiết công nợ nhà cung cấp" FontSize="22" FontWeight="SemiBold" Foreground="#142C4D" />
          <TextBlock Margin="0,6,0,0" FontSize="15" Foreground="#2E4768" Text="{Binding SupplierInfoText}" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock FontSize="13" Foreground="#5B7090" HorizontalAlignment="Right" Text="{Binding PeriodText}" />
          <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#C0392B" HorizontalAlignment="Right" Text="{Binding ClosingText}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#FFFFFFFF" BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="12" Padding="10">
      <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False" IsReadOnly="True" RowHeight="42" ColumnHeaderHeight="40" FontSize="13" Background="#00FFFFFF" BorderThickness="0" AlternatingRowBackground="#FAFCFF" ColumnHeaderStyle="{StaticResource EnterpriseDebtDetailGridHeader}" CellStyle="{StaticResource EnterpriseDebtDetailGridCell}" ItemsSource="{Binding Transactions}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Ngày" Width="105" Binding="{Binding TransactionDate, StringFormat=dd/MM/yyyy}" />
          <DataGridTextColumn Header="Chứng từ" Width="130" Binding="{Binding DocumentNo}" />
          <DataGridTextColumn Header="Loại" Width="130" Binding="{Binding DocumentTypeText}" />
          <DataGridTextColumn Header="Diễn giải" Width="*" Binding="{Binding Description}" />
          <DataGridTextColumn Header="Phát sinh nợ" Width="130" Binding="{Binding CreditAmount, StringFormat={}{0:N0}}" />
          <DataGridTextColumn Header="Đã trả" Width="120" Binding="{Binding DebitAmount, StringFormat={}{0:N0}}" />
          <DataGridTextColumn Header="Còn lại" Width="120" Binding="{Binding BalanceAmount, StringFormat={}{0:N0}}" />
          <DataGridTextColumn Header="Trạng thái" Width="110" Binding="{Binding StatusText}" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Width="100" Height="34" Margin="0,0,8,0" Click="PrintPreview_Click">Xem trước in</Button>
      <Button Width="100" Height="34" IsDefault="True" IsCancel="True">Đóng</Button>
    </StackPanel>
  </Grid>
</Window>