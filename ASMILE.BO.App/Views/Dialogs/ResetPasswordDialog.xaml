<Window x:Class="ASMILE.BO.App.Views.Dialogs.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đặt lại mật khẩu" Height="400" Width="480" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Đặt lại mật khẩu" FontSize="20" FontWeight="SemiBold" Foreground="#0F2F5F"/>
        <TextBlock Grid.Row="1" Text="Chọn đúng tài khoản trước khi đặt mật khẩu tạm thời mới." Margin="0,5,0,16" Foreground="#64748B"/>
        <TextBlock Grid.Row="2" Text="Tài khoản *" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="3" x:Name="UserComboBox" Height="34" DisplayMemberPath="DisplayName" SelectionChanged="UserComboBox_SelectionChanged"/>
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="UserLabel" Foreground="#64748B" FontSize="12" Margin="0,0,0,10"/>
            <TextBlock Text="Mật khẩu mới *" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="34" Padding="9,5" MaxLength="128"/>
            <TextBlock Text="Nhập lại mật khẩu *" Foreground="#475569" FontSize="12" Margin="0,12,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="34" Padding="9,5" MaxLength="128"/>
            <CheckBox x:Name="MustChangePasswordCheckBox" Content="Bắt buộc đổi mật khẩu ở lần đăng nhập tiếp theo" IsChecked="True" Margin="0,12,0,0" Foreground="#334155"/>
            <TextBlock x:Name="ValidationTextBlock" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Hủy" Width="90" Height="36" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/><Button Content="Đặt lại" Width="100" Height="36" Background="#2563EB" Foreground="White" IsDefault="True" Click="Confirm_Click"/></StackPanel>
    </Grid>
</Window>
