<Window x:Class="ASMILE.BO.App.Views.Dialogs.ReceivablePaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thu tiền khách hàng" Height="420" Width="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Khách hàng" Margin="0,8"/>
            <ComboBox Grid.Column="1" Margin="0,4" ItemsSource="{Binding CustomerOptions}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="CustomerName"/>
            <TextBlock Grid.Row="1" Text="Ngày thu" Margin="0,8"/>
            <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,4" SelectedDate="{Binding ReceiptDate}"/>
            <TextBlock Grid.Row="2" Text="Số tiền" Margin="0,8"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="3" Text="Phương thức" Margin="0,8"/>
            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Methods}" SelectedItem="{Binding PaymentMethod}"/>
            <TextBlock Grid.Row="4" Text="Tài khoản" Margin="0,8"/>
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4" Text="{Binding BankAccount}"/>
            <TextBlock Grid.Row="5" Text="Ghi chú" Margin="0,8"/>
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,4" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Note}"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Lưu" Width="96" Margin="0,0,8,0" IsDefault="True" Click="OnSave"/>
            <Button Content="Hủy" Width="96" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
