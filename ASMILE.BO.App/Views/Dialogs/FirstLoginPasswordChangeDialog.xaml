<Window x:Class="ASMILE.BO.App.Views.Dialogs.FirstLoginPasswordChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu bắt buộc" Height="390" Width="480" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Đổi mật khẩu trước khi tiếp tục" FontSize="20" FontWeight="SemiBold" Foreground="#0F2F5F" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" x:Name="UserNameTextBlock" Margin="0,7,0,0" Foreground="#334155" FontWeight="SemiBold" />
        <TextBlock Grid.Row="2" Text="Tài khoản này cần đổi mật khẩu để bảo vệ phiên đăng nhập." Margin="0,5,0,18" Foreground="#64748B" TextWrapping="Wrap" />
        <TextBlock Grid.Row="3" Text="Mật khẩu mới" Foreground="#475569" FontSize="12" Margin="0,0,0,5" />
        <PasswordBox Grid.Row="4" x:Name="NewPasswordBox" AutomationProperties.AutomationId="FirstLoginNewPassword" Height="36" Padding="9,6" MaxLength="128" />
        <TextBlock Grid.Row="5" Text="Nhập lại mật khẩu mới" Foreground="#475569" FontSize="12" Margin="0,12,0,5" />
        <PasswordBox Grid.Row="6" x:Name="ConfirmPasswordBox" AutomationProperties.AutomationId="FirstLoginConfirmPassword" Height="36" Padding="9,6" MaxLength="128" VerticalAlignment="Top" />
        <StackPanel Grid.Row="7">
            <TextBlock Text="Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường và số." Margin="0,10,0,0" Foreground="#64748B" FontSize="12" />
            <TextBlock x:Name="ValidationTextBlock" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Thoát đăng nhập" Width="122" Height="36" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click" />
                <Button Content="Đổi mật khẩu" AutomationProperties.AutomationId="FirstLoginPasswordChangeSubmit" Width="112" Height="36" Background="#2563EB" Foreground="White" IsDefault="True" Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
