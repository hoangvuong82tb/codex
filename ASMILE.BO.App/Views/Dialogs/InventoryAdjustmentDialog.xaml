<Window x:Class="ASMILE.BO.App.Views.Dialogs.InventoryAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:appDtos="clr-namespace:ASMILE.BO.Application.DTOs;assembly=ASMILE.BO.Application"
        Title="Điều chỉnh tồn kho" Height="520" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Hàng hóa" Margin="0,8"/>
            <ComboBox Grid.Column="1" Margin="0,4" ItemsSource="{Binding StockOptions}" SelectedItem="{Binding SelectedStock}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type appDtos:InventoryStockBalanceDto}">
                        <TextBlock Text="{Binding ProductCode}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1" Text="Kho" Margin="0,8"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding SelectedStock.WarehouseCode}" IsReadOnly="True"/>
            <TextBlock Grid.Row="2" Text="Tồn hệ thống" Margin="0,8"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding SelectedStock.ClosingQuantity, Converter={StaticResource TrimNumberConverter}}" IsReadOnly="True"/>
            <TextBlock Grid.Row="3" Text="Tồn thực tế" Margin="0,8"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding ActualQuantityText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="4" Text="Chênh lệch" Margin="0,8"/>
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4" Text="{Binding DifferenceText, Mode=OneWay}" IsReadOnly="True"/>
            <TextBlock Grid.Row="5" Text="Lý do" Margin="0,8"/>
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,4" Text="{Binding Reason}"/>
            <TextBlock Grid.Row="6" Text="Ngày điều chỉnh" Margin="0,8"/>
            <DatePicker Grid.Row="6" Grid.Column="1" Margin="0,4" SelectedDate="{Binding AdjustmentDate}"/>
            <TextBlock Grid.Row="7" Text="Ghi chú" Margin="0,8"/>
            <TextBox Grid.Row="7" Grid.Column="1" Margin="0,4" Height="90" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding Note}"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Lưu" Width="96" Margin="0,0,8,0" IsDefault="True" Click="OnSave"/>
            <Button Content="Hủy" Width="96" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
