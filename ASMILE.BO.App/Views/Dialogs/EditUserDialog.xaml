<Window x:Class="ASMILE.BO.App.Views.Dialogs.EditUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chỉnh sửa người dùng" Height="500" Width="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Chỉnh sửa người dùng" FontSize="20" FontWeight="SemiBold" Foreground="#0F2F5F"/>
        <TextBlock Grid.Row="1" x:Name="UserNameTextBlock" Margin="0,5,0,16" Foreground="#64748B"/>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Tên hiển thị *" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/><TextBox x:Name="DisplayNameTextBox" Height="34" MaxLength="128" Margin="0,0,0,12"/>
            <TextBlock Text="Email" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/><TextBox x:Name="EmailTextBox" Height="34" MaxLength="256" Margin="0,0,0,12"/>
            <TextBlock Text="Ghi chú" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/><TextBox x:Name="NotesTextBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="500" Margin="0,0,0,12"/>
            <CheckBox x:Name="IsActiveCheckBox" Content="Tài khoản đang hoạt động" Margin="0,0,0,8" Foreground="#334155"/>
            <CheckBox x:Name="MustChangePasswordCheckBox" Content="Yêu cầu đổi mật khẩu ở lần đăng nhập tiếp theo" Foreground="#334155"/>
            <TextBlock x:Name="ValidationTextBlock" Margin="0,12,0,0" Foreground="#DC2626" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Hủy" Width="90" Height="36" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Lưu thay đổi" Width="135" Height="36" Background="#2563EB" Foreground="White" IsDefault="True" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
