<Window x:Class="ASMILE.BO.App.Views.Dialogs.LedgerEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm bút toán" Height="420" Width="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Ngày" Margin="0,8"/>
            <DatePicker Grid.Column="1" Margin="0,4" SelectedDate="{Binding EntryDate}"/>
            <TextBlock Grid.Row="1" Text="Số chứng từ" Margin="0,8"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding DocumentNo}"/>
            <TextBlock Grid.Row="2" Text="Diễn giải" Margin="0,8"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding Description}"/>
            <TextBlock Grid.Row="3" Text="TK Nợ" Margin="0,8"/>
            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4" ItemsSource="{Binding AccountCodes}" SelectedItem="{Binding DebitAccount}"/>
            <TextBlock Grid.Row="4" Text="TK Có" Margin="0,8"/>
            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4" ItemsSource="{Binding AccountCodes}" SelectedItem="{Binding CreditAccount}"/>
            <TextBlock Grid.Row="5" Text="Số tiền" Margin="0,8"/>
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,4" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Lưu" Width="96" Margin="0,0,8,0" IsDefault="True" Click="OnSave"/>
            <Button Content="Hủy" Width="96" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
