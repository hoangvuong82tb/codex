<Window x:Class="ASMILE.BO.App.Views.Dialogs.AddEditUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm người dùng" Height="570" Width="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Thêm người dùng" FontSize="20" FontWeight="SemiBold" Foreground="#0F2F5F"/>
        <TextBlock Grid.Row="1" Text="Nhập thông tin tài khoản. Mật khẩu tạm thời phải được đổi ở lần đăng nhập đầu tiên."
                   Margin="0,5,0,16" Foreground="#64748B" TextWrapping="Wrap"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12"><TextBlock Text="Tên đăng nhập *" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/><TextBox x:Name="UserNameTextBox" Height="34" MaxLength="64"/></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="Tên hiển thị *" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/><TextBox x:Name="DisplayNameTextBox" Height="34" MaxLength="128"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12"><TextBlock Text="Email" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/><TextBox x:Name="EmailTextBox" Height="34" MaxLength="256"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="Số điện thoại" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/><TextBox x:Name="PhoneTextBox" Height="34" MaxLength="32"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12"><TextBlock Text="Mật khẩu tạm thời *" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/><PasswordBox x:Name="PasswordBox" Height="34" MaxLength="128"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="Nhập lại mật khẩu *" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/><PasswordBox x:Name="ConfirmPasswordBox" Height="34" MaxLength="128"/></StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12"><TextBlock Text="Vai trò *" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/><ComboBox x:Name="RoleComboBox" Height="34" DisplayMemberPath="Name"/></StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12"><TextBlock Text="Ghi chú" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/><TextBox x:Name="NotesTextBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="500"/></StackPanel>
                <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" x:Name="MustChangePasswordCheckBox" Content="Bắt buộc đổi mật khẩu khi đăng nhập lần đầu" IsChecked="True" Foreground="#334155"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" x:Name="ValidationTextBlock" Margin="0,12,0,0" Foreground="#DC2626" TextWrapping="Wrap"/>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Hủy" Width="90" Height="36" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/><Button Content="Tạo người dùng" Width="135" Height="36" Background="#2563EB" Foreground="White" IsDefault="True" Click="Confirm_Click"/></StackPanel>
    </Grid>
</Window>
