<Window x:Class="ASMILE.BO.App.Views.Dialogs.UnlockUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mở khóa tài khoản" Height="250" Width="460" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Mở khóa tài khoản" FontSize="20" FontWeight="SemiBold" Foreground="#0F2F5F" />
        <TextBlock Grid.Row="1" Text="Chọn chính xác tài khoản cần mở khóa." Margin="0,5,0,16" Foreground="#64748B" />
        <TextBlock Grid.Row="2" Text="Tài khoản đang bị khóa" Foreground="#475569" FontSize="12" Margin="0,0,0,5" />
        <ComboBox Grid.Row="3" x:Name="UserComboBox" Height="36" DisplayMemberPath="DisplayName" SelectionChanged="UserComboBox_SelectionChanged" />
        <TextBlock Grid.Row="4" x:Name="ValidationTextBlock" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Hủy" Width="90" Height="36" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Mở khóa" Width="100" Height="36" Background="#2563EB" Foreground="White" IsDefault="True" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
