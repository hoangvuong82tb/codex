<Window x:Class="ASMILE.BO.App.Views.Dialogs.AlacarteRoomSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mở phòng phục vụ"
        Width="560"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Mở phòng phục vụ" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock x:Name="RoomInfoText" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Khách hàng" FontSize="12" Foreground="#475569"/>
                <TextBox x:Name="CustomerNameTextBox" Margin="0,6,0,0" Height="38" Padding="10,6"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Số điện thoại" FontSize="12" Foreground="#475569"/>
                <TextBox x:Name="PhoneTextBox" Margin="0,6,0,0" Height="38" Padding="10,6"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Số khách" FontSize="12" Foreground="#475569"/>
                <TextBox x:Name="GuestCountTextBox" Margin="0,6,0,0" Height="38" Padding="10,6"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Số bàn mở" FontSize="12" Foreground="#475569"/>
                <TextBox x:Name="TableCountTextBox" Margin="0,6,0,0" Height="38" Padding="10,6"/>
                <TextBlock x:Name="MaxTablesText" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Ghi chú" FontSize="12" Foreground="#475569"/>
            <TextBox x:Name="NoteTextBox" Margin="0,6,0,0" Height="88" Padding="10,8" AcceptsReturn="True" TextWrapping="Wrap"/>
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Quy tắc mở bàn" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="Phòng đã có sẵn toàn bộ bàn mặc định. Lưu cấu hình sẽ bật số bàn phục vụ theo số khách, các bàn còn lại sẽ ở trạng thái bàn chờ để mở thêm khi cần." TextWrapping="Wrap" FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Đóng" Height="42" Margin="0,0,6,0" Click="CloseButton_Click"/>
            <Button Grid.Column="1" Content="Lưu mở bàn" Height="42" Margin="6,0,0,0" Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
