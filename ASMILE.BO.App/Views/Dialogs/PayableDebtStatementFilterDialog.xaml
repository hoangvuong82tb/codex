<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ASMILE.BO.App.Views.Dialogs.PayableDebtStatementFilterDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="540" Height="430" MinWidth="500" MinHeight="430" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F7F9FC" FontFamily="Segoe UI Variable Display, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" xmlns:dialogs="clr-namespace:ASMILE.BO.App.Views.Dialogs;assembly=ASMILE.BO.App" Title="{Binding WindowTitle}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="2" Opacity="0.10" Color="#0F172A" />
      <Style x:Key="Win11DatePickerStyle" TargetType="{x:Type DatePicker}">
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="#CBD5E1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="Padding" Value="8,0" />
      </Style>
      <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#1E293B" />
        <Setter Property="Background" Value="#EEF4FF" />
        <Setter Property="BorderBrush" Value="#C7D7F2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Root" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Root" Property="Border.Background" Value="#E0EAFF" />
                  <Setter TargetName="Root" Property="Border.BorderBrush" Value="#AFC4EA" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Root" Property="Border.Background" Value="#D4E2FB" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.55" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="MinWidth" Value="138" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Background" Value="#2563EB" />
        <Setter Property="BorderBrush" Value="#2563EB" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Root" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Root" Property="Border.Background" Value="#1D4ED8" />
                  <Setter TargetName="Root" Property="Border.BorderBrush" Value="#1D4ED8" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Root" Property="Border.Background" Value="#1E40AF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.55" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Margin="16" Padding="18" Background="#FCFDFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Effect="{StaticResource CardShadow}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
        <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#0F2A55" Text="{Binding HeaderText}" />
        <TextBlock Margin="0,7,0,0" FontSize="13.5" Foreground="#52657F" TextWrapping="Wrap" Text="{Binding SupplierText}" />
      </StackPanel>
      <Border Grid.Row="1" Margin="0,18,0,0" Padding="14" CornerRadius="12" Background="#FFFFFFFF" BorderBrush="#DCE6F3" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Từ ngày" VerticalAlignment="Center" FontSize="14" Foreground="#334155" />
          <DatePicker Grid.Row="0" Grid.Column="1" Style="{StaticResource Win11DatePickerStyle}" SelectedDate="{Binding FromDate}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,14,0,0" Text="Đến ngày" VerticalAlignment="Center" FontSize="14" Foreground="#334155" />
          <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" Style="{StaticResource Win11DatePickerStyle}" SelectedDate="{Binding ToDate}" />
        </Grid>
      </Border>
      <TextBlock Grid.Row="2" Margin="2,10,0,0" FontSize="12.5" Foreground="#64748B" TextWrapping="Wrap" Text="{Binding HintText}" />
      <StackPanel Grid.Row="3" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" IsCancel="True" Content="Hủy" />
        <Button Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Content="{Binding ApplyText}" Click="Apply_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>