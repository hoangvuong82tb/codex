<Window x:Class="ASMILE.BO.App.Views.Dialogs.InventoryRowDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết dữ liệu" Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent">
    <Border Background="#F5F8FC" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="16" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12" Background="#E8F1FF">
                        <TextBlock Text="&#xE8D1;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="#1F2937"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{Binding BadgeBackground}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeForeground}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,14,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="32" Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="190"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Foreground="#64748B" FontSize="13" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#1F2937" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2">
                <TextBlock Text="Double-click hàng trong bảng để mở chi tiết. Dữ liệu lấy từ dòng đang chọn." Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="Đóng" Width="110" Height="36" HorizontalAlignment="Right" IsCancel="True" Background="White" BorderBrush="#DDE7F3" BorderThickness="1"/>
            </Grid>
        </Grid>
    </Border>
</Window>
