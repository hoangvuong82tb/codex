<Window x:Class="ASMILE.BO.App.Views.Dialogs.PrintPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem trước khi in"
        Height="520"
        Width="760"
        WindowStartupLocation="CenterOwner">
    <Border Background="#F3F7FC" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="ASMILE BO - Xem trước báo cáo" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding PreviewTitle}" Foreground="#5A6B84" FontWeight="SemiBold" Margin="0,4,0,0"/>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock Text="{Binding PreviewMetaLeft}" Foreground="#6B7D99" FontSize="12"/>
                    <TextBlock Text="{Binding PreviewMetaRight}" Foreground="#6B7D99" FontSize="12" DockPanel.Dock="Right"/>
                </DockPanel>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#DDE7F3"
                    BorderThickness="1"
                    Padding="16"
                    Margin="0,12,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding PreviewContent}" TextWrapping="Wrap" FontFamily="Consolas"/>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PreviewFooter}" VerticalAlignment="Center" Foreground="#6B7D99"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="In" Width="100" Margin="0,0,8,0"/>
                    <Button Content="Đóng" Width="100" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
