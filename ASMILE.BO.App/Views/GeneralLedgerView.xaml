                            <TextBlock Text="Th&#xF4;ng tin thay &#x111;&#x1ED5;i" FontWeight="Bold" Foreground="#0F2A55" Margin="0,0,0,10"/>
                            <DataGrid AutoGenerateColumns="False" Height="150" Margin="0,0,0,14">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tr&#x1B0;&#x1EDD;ng" Width="*"/>
