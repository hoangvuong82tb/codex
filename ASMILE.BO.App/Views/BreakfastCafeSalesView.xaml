<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ASMILE.BO.App.Views.BreakfastCafeSalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             xmlns:views="clr-namespace:ASMILE.BO.App.Views"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>
    <converters:StringEqualityConverter x:Key="StringEquality"/>
    <converters:StatusDisplayConverter x:Key="StatusDisplayConverter"/>

    <!-- Mini-sidebar button style -->
    <Style x:Key="MiniSidebarBtn" TargetType="Button">
      <Setter Property="Width" Value="65"/>
      <Setter Property="Height" Value="60"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="BorderBrush" Value="#3B82F6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Width="65" Height="60">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                <ContentPresenter HorizontalAlignment="Center" Margin="0,4,0,0"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#F1F5F9"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Active sidebar button -->
    <Style x:Key="MiniSidebarBtnActive" TargetType="Button" BasedOn="{StaticResource MiniSidebarBtn}">
      <Setter Property="Background" Value="#EFF6FF"/>
      <Setter Property="Foreground" Value="#1D4ED8"/>
      <Setter Property="BorderThickness" Value="3,0,0,0"/>
    </Style>

    <!-- Chip button for area/menu categories -->
    <Style x:Key="ChipBtn" TargetType="Button">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="60"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="chip" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="18" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="chip" Property="Background" Value="#F1F5F9"/>
                <Setter TargetName="chip" Property="BorderBrush" Value="#94A3B8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChipBtnActive" TargetType="Button" BasedOn="{StaticResource ChipBtn}">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#2563EB"/>
    </Style>

    <Style x:Key="PosReportTabItem" TargetType="TabItem">
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Root"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0,0,0,2"
                    MinHeight="{TemplateBinding MinHeight}"
                    Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="TabIcon"
                           Text="{TemplateBinding Tag}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{TemplateBinding Foreground}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="{x:Null}">
                <Setter TargetName="TabIcon" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="Tag" Value="">
                <Setter TargetName="TabIcon" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#FFF7ED"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="#F2994A"/>
                <Setter Property="Foreground" Value="#0F2A55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Table card style -->
    <Style x:Key="TableCardBtn" TargetType="Button">
      <Setter Property="Width" Value="150"/>
      <Setter Property="Height" Value="110"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="card" CornerRadius="10" BorderThickness="1" Padding="10,8"
                    Background="#F0FDF4" BorderBrush="#BBF7D0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding TableName}" FontWeight="Bold" FontSize="14"
                             Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                  <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4"
                          Background="#22C55E" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontSize="11"
                           Foreground="#166534" FontWeight="SemiBold" Margin="0,2,0,0"/>
                <TextBlock Grid.Row="2" Text="{Binding OpenOrderTotal, StringFormat={}{0:N0} đ}"
                           FontWeight="Bold" Foreground="#EA580C" FontSize="13"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Visibility="{Binding OpenOrderId, Converter={StaticResource B2V}, FallbackValue=Collapsed}"/>
                <TextBlock Grid.Row="3" Text="{Binding OpenOrderNumber}" FontSize="10"
                           Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="card" Property="Background" Value="#DCFCE7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Menu item list style -->
    <Style x:Key="MenuItemRow" TargetType="Button">
      <Setter Property="Height" Value="56"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="row" Background="Transparent" BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1" Padding="8,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="8" Background="#FFF7ED"
                        VerticalAlignment="Center" ClipToBounds="True">
                  <TextBlock Text="{Binding Emoji}" FontSize="20" HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                             Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{Binding Code}" FontSize="11" Foreground="#94A3B8"/>
                    <Border Background="#ECFDF3" CornerRadius="4" Padding="4,1"
                            Margin="6,0,0,0">
                      <TextBlock Text="{Binding StatusBadge}" FontSize="9"
                                 Foreground="#15803D" FontWeight="SemiBold"/>
                    </Border>
                  </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}"
                           FontWeight="Bold" FontSize="14" Foreground="#EA580C"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Grid.Column="3" Width="36" Height="36" CornerRadius="18"
                        Background="#2563EB" VerticalAlignment="Center">
                  <TextBlock Text="+" FontSize="18" Foreground="White" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="row" Property="Background" Value="#F8FAFC"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Order line row template -->
    <Style x:Key="OrderLineCard" TargetType="Border">
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="QtyBtn" TargetType="Button" BasedOn="{StaticResource EnterpriseModuleCmdSecondary}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="DelBtn" TargetType="Button" BasedOn="{StaticResource EnterpriseModuleCmdDanger}">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Payment method chip -->
    <Style x:Key="PayChip" TargetType="Button" BasedOn="{StaticResource EnterpriseModuleCmdSecondary}">
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinWidth" Value="90"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="PayChipActive" TargetType="Button" BasedOn="{StaticResource PayChip}">
      <Setter Property="Background" Value="#EFF6FF"/>
      <Setter Property="Foreground" Value="#1D4ED8"/>
      <Setter Property="BorderBrush" Value="#93C5FD"/>
    </Style>

    <!-- Action buttons -->
    <Style x:Key="ActionPrimaryBtn" TargetType="Button" BasedOn="{StaticResource EnterpriseModuleCmdInfo}">
      <Setter Property="Height" Value="44"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="ActionSuccessBtn" TargetType="Button" BasedOn="{StaticResource EnterpriseModuleCmdSuccess}">
      <Setter Property="Height" Value="50"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,0"/>
    </Style>

    <Style x:Key="ActionSecondaryBtn" TargetType="Button" BasedOn="{StaticResource EnterpriseModuleCmdSecondary}">
      <Setter Property="Height" Value="44"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,0"/>
    </Style>

    <Style x:Key="ActionDangerBtn" TargetType="Button" BasedOn="{StaticResource EnterpriseModuleCmdDanger}">
      <Setter Property="Height" Value="50"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,0"/>
    </Style>

    <Style x:Key="PosLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Resources>

  <Grid Background="#F0F4F8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- TOP BAR -->
    <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="36" Height="36" CornerRadius="10" Background="#FFF7ED" Margin="0,0,12,0">
            <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                       Foreground="#F2994A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock Text="Bán đồ ăn sáng &amp; cà phê" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#64748B"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding Summary.RevenueAmount, StringFormat=Hôm nay: {0:N0} đ}"
                     Foreground="#15803D" FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0"/>
          <TextBlock Text="{Binding Summary.OrderCount, StringFormat={}{0} đơn}"
                     Foreground="#2563EB" FontWeight="SemiBold" FontSize="12"/>
          <Button Command="{Binding ShowShiftSummaryCommand}"
                  Content="Tổng kết ca"
                  Tag="&#xE787;"
                  Margin="16,0,0,0"
                  Height="34"
                  MinWidth="112"
                  Padding="14,0"
                  FontSize="12"
                  Style="{StaticResource EnterpriseModuleCmdWarning}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- MAIN 2-COLUMN LAYOUT -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*"/>
        <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>

      <!-- ================================================================ -->
      <!-- LEFT COLUMN (60%): Mini-sidebar + Tab content -->
      <!-- ================================================================ -->
      <Grid Grid.Column="0">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Grid.ColumnSpan" Value="1"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsTabSettings}" Value="True">
                <Setter Property="Grid.ColumnSpan" Value="2"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsTabClosedOrders}" Value="True">
                <Setter Property="Grid.ColumnSpan" Value="2"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsTabReports}" Value="True">
                <Setter Property="Grid.ColumnSpan" Value="2"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="65"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MINI SIDEBAR -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
          <StackPanel Margin="0,8,0,0">
            <!-- Tab Khu vực -->
            <Button Tag="&#xE80F;" Command="{Binding NavigateLeftTabCommand}" CommandParameter="0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource MiniSidebarBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTabAreas}" Value="True">
                      <Setter Property="Background" Value="#EFF6FF"/>
                      <Setter Property="Foreground" Value="#1D4ED8"/>
                      <Setter Property="BorderThickness" Value="3,0,0,0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              Khu vực
            </Button>
            <!-- Tab Thực đơn -->
            <Button Tag="&#xE7BF;" Command="{Binding NavigateLeftTabCommand}" CommandParameter="1">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource MiniSidebarBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTabMenu}" Value="True">
                      <Setter Property="Background" Value="#EFF6FF"/>
                      <Setter Property="Foreground" Value="#1D4ED8"/>
                      <Setter Property="BorderThickness" Value="3,0,0,0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              Thực đơn
            </Button>
            <!-- Tab Đơn mở -->
            <Button Tag="&#xE8FD;" Command="{Binding NavigateLeftTabCommand}" CommandParameter="2">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource MiniSidebarBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTabOpenOrders}" Value="True">
                      <Setter Property="Background" Value="#EFF6FF"/>
                      <Setter Property="Foreground" Value="#1D4ED8"/>
                      <Setter Property="BorderThickness" Value="3,0,0,0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              Đơn mở
            </Button>
            <!-- Tab Cài đặt -->
            <Button Tag="&#xE713;" Command="{Binding NavigateLeftTabCommand}" CommandParameter="3">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource MiniSidebarBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTabSettings}" Value="True">
                      <Setter Property="Background" Value="#EFF6FF"/>
                      <Setter Property="Foreground" Value="#1D4ED8"/>
                      <Setter Property="BorderThickness" Value="3,0,0,0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              Cài đặt
            </Button>
            <!-- Tab Đơn đóng -->
            <Button Tag="&#xE81C;" Command="{Binding NavigateLeftTabCommand}" CommandParameter="4">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource MiniSidebarBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTabClosedOrders}" Value="True">
                      <Setter Property="Background" Value="#EFF6FF"/>
                      <Setter Property="Foreground" Value="#1D4ED8"/>
                      <Setter Property="BorderThickness" Value="3,0,0,0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              Đơn đóng
            </Button>
            <!-- Tab Báo cáo -->
            <Button Tag="&#xE9D2;" Command="{Binding NavigateLeftTabCommand}" CommandParameter="5">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource MiniSidebarBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTabReports}" Value="True">
                      <Setter Property="Background" Value="#EFF6FF"/>
                      <Setter Property="Foreground" Value="#1D4ED8"/>
                      <Setter Property="BorderThickness" Value="3,0,0,0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              Báo cáo
            </Button>
          </StackPanel>
        </Border>

        <!-- TAB CONTENT AREA -->
        <Grid Grid.Column="1">

          <!-- ================================================================ -->
          <!-- TAB 0: KHU VỰC / BÀN -->
          <!-- ================================================================ -->
          <Grid Visibility="{Binding IsTabAreas, Converter={StaticResource B2V}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="16,14,16,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="KHU VỰC" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                  <TextBlock Text="Chọn khu vực để chọn bàn" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Mang đi" Tag="&#xE710;"
                        Command="{Binding OpenTakeAwayCommand}"
                        Style="{StaticResource ActionPrimaryBtn}" Height="36" FontSize="12"
                        Padding="14,0"/>
              </Grid>
            </Border>

            <!-- Area chips + Table search + Status filter -->
            <Grid Grid.Row="1" Margin="16,10,16,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Area filter chips -->
              <ItemsControl Grid.Row="0" ItemsSource="{Binding Areas}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding .}" Margin="0,0,6,6" Height="34" MinWidth="60"
                            Padding="12,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Background="White" Foreground="#475569"
                            BorderBrush="#CBD5E1" BorderThickness="1"
                            Command="{Binding DataContext.SelectAreaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding .}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="chip" Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="chip" Property="Background" Value="#F1F5F9"/>
                              <Setter TargetName="chip" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                      <Button.Style>
                        <Style TargetType="Button">
                          <Style.Triggers>
                            <DataTrigger Value="True">
                              <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource StringEquality}">
                                  <Binding Path="."/>
                                  <Binding Path="DataContext.SelectedArea" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                </MultiBinding>
                              </DataTrigger.Binding>
                              <Setter Property="Background" Value="#2563EB"/>
                              <Setter Property="Foreground" Value="White"/>
                              <Setter Property="BorderBrush" Value="#2563EB"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Search + Status filter row -->
              <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding TableSearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource EnterpriseModuleTextBox}" Height="34"
                         FontSize="12" Padding="10,0"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding TableStatusFilterOptions}"
                          SelectedItem="{Binding TableStatusFilter}"
                          Style="{StaticResource EnterpriseModuleComboBox}"
                          Height="34" MinWidth="130" FontSize="12" Margin="8,0,0,0"/>
              </Grid>
            </Grid>

            <!-- Table count -->
            <Grid Grid.Row="2" Margin="16,8,16,4">
              <TextBlock FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center">
                <Run Text="{Binding FilteredTables.Count, Mode=OneWay}"/>
                <Run Text=" bàn"/>
              </TextBlock>
            </Grid>

            <!-- Table grid -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="16,0,8,8">
              <ItemsControl ItemsSource="{Binding FilteredTables}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TableCardBtn}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Empty">
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="Button">
                                    <Border x:Name="card" CornerRadius="10" BorderThickness="1"
                                            Padding="10,8" Background="#F0FDF4" BorderBrush="#BBF7D0">
                                      <Grid>
                                        <Grid.RowDefinitions>
                                          <RowDefinition Height="Auto"/>
                                          <RowDefinition Height="*"/>
                                          <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                          <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                          </Grid.ColumnDefinitions>
                                          <TextBlock Text="{Binding TableName}" FontWeight="Bold" FontSize="14"
                                                     Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                          <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4"
                                                  Background="#22C55E" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="#166534" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Text="{Binding SeatCount, StringFormat={}{0} chỗ}"
                                                   FontSize="10" Foreground="#94A3B8"/>
                                      </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="card" Property="Background" Value="#DCFCE7"/>
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Serving">
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="Button">
                                    <Border x:Name="card" CornerRadius="10" BorderThickness="1"
                                            Padding="10,8" Background="#EFF6FF" BorderBrush="#BFDBFE">
                                      <Grid>
                                        <Grid.RowDefinitions>
                                          <RowDefinition Height="Auto"/>
                                          <RowDefinition Height="Auto"/>
                                          <RowDefinition Height="*"/>
                                          <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                          <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                          </Grid.ColumnDefinitions>
                                          <TextBlock Text="{Binding TableName}" FontWeight="Bold" FontSize="14"
                                                     Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                          <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4"
                                                  Background="#3B82F6" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="#1E40AF" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        <TextBlock Grid.Row="2" Text="{Binding OpenOrderTotal, StringFormat={}{0:N0} đ}"
                                                   FontWeight="Bold" Foreground="#EA580C" FontSize="13"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                        <TextBlock Grid.Row="3" Text="{Binding OpenOrderNumber}" FontSize="10"
                                                   Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                      </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="card" Property="Background" Value="#DBEAFE"/>
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="AwaitingPayment">
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="Button">
                                    <Border x:Name="card" CornerRadius="10" BorderThickness="1"
                                            Padding="10,8" Background="#FFF7ED" BorderBrush="#FED7AA">
                                      <Grid>
                                        <Grid.RowDefinitions>
                                          <RowDefinition Height="Auto"/>
                                          <RowDefinition Height="Auto"/>
                                          <RowDefinition Height="*"/>
                                          <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                          <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                          </Grid.ColumnDefinitions>
                                          <TextBlock Text="{Binding TableName}" FontWeight="Bold" FontSize="14"
                                                     Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                          <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4"
                                                  Background="#F97316" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="#9A3412" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        <TextBlock Grid.Row="2" Text="{Binding OpenOrderTotal, StringFormat={}{0:N0} đ}"
                                                   FontWeight="Bold" Foreground="#EA580C" FontSize="13"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                        <TextBlock Grid.Row="3" Text="{Binding OpenOrderNumber}" FontSize="10"
                                                   Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                      </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="card" Property="Background" Value="#FED7AA"/>
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <!-- ================================================================ -->
          <!-- TAB 1: THỰC ĐƠN -->
          <!-- ================================================================ -->
          <Grid Visibility="{Binding IsTabMenu, Converter={StaticResource B2V}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="16,14,16,0">
              <StackPanel>
                <TextBlock Text="THỰC ĐƠN" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Chọn món để thêm vào đơn hiện tại" FontSize="12"
                           Foreground="#64748B" Margin="0,2,0,0"/>
              </StackPanel>
            </Border>

            <!-- Search + Filters -->
            <Grid Grid.Row="1" Margin="16,10,16,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource EnterpriseModuleTextBox}" Height="36"
                         FontSize="12" Padding="10,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding SortModes}"
                          SelectedItem="{Binding SelectedSortMode}"
                          Style="{StaticResource EnterpriseModuleComboBox}"
                          Height="36" MinWidth="120" FontSize="11" Margin="8,0,0,0"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding MenuViewModes}"
                          SelectedItem="{Binding SelectedMenuViewMode}"
                          Style="{StaticResource EnterpriseModuleComboBox}"
                          Height="36" MinWidth="110" FontSize="11" Margin="8,0,0,0"/>
              </Grid>

              <!-- Category chips -->
              <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding Name}"
                            Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChipBtn}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                              <Setter Property="Background" Value="#2563EB"/>
                              <Setter Property="Foreground" Value="White"/>
                              <Setter Property="BorderBrush" Value="#2563EB"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>

            <!-- Menu item count -->
            <TextBlock Grid.Row="2" Margin="16,6,16,0" FontSize="11" Foreground="#94A3B8">
              <Run Text="{Binding FilteredMenuItems.Count, Mode=OneWay}"/>
              <Run Text=" món"/>
            </TextBlock>

            <!-- Menu items list -->
            <ListBox Grid.Row="3"
                     ItemsSource="{Binding FilteredMenuItems}"
                     SelectedItem="{Binding SelectedMenuItemForSale, Mode=TwoWay}"
                     BorderThickness="0"
                     Background="Transparent"
                     Margin="0,4,0,0"
                     Visibility="{Binding IsMenuViewList, Converter={StaticResource B2V}}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <ContentPresenter/>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Background="Transparent" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8,6" Height="56"
                            Cursor="Hand"
                            MouseLeftButtonUp="MenuItemCard_MouseLeftButtonUp">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="44"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="92"/>
                          <ColumnDefinition Width="96"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="8" Background="#FFF7ED" VerticalAlignment="Center" ClipToBounds="True">
                          <TextBlock Text="{Binding Emoji}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Code}" FontSize="11" Foreground="#94A3B8"/>
                            <Border CornerRadius="4" Padding="4,1" Margin="6,0,0,0" Background="#ECFDF3">
                              <TextBlock Text="{Binding StatusBadge}" FontSize="9" Foreground="#15803D" FontWeight="SemiBold"/>
                            </Border>
                            <Border CornerRadius="4" Padding="4,1" Margin="6,0,0,0" Background="#FEF2F2" Visibility="{Binding HasStockWarning, Converter={StaticResource B2V}}">
                              <TextBlock Text="{Binding StockWarning}" FontSize="9" Foreground="#DC2626" FontWeight="SemiBold"/>
                            </Border>
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}" FontWeight="Bold" FontSize="14" Foreground="#EA580C" VerticalAlignment="Center" Margin="0,0,8,0" TextAlignment="Right"/>
                        <Button Grid.Column="3"
                                Width="84"
                                Height="36"
                                MinWidth="84"
                                Padding="10,0"
                                HorizontalAlignment="Left"
                                Content="Thêm món"
                                Tag="&#xE710;"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Style="{StaticResource EnterpriseModuleCmdInfo}"
                                IsEnabled="{Binding CanOrder}"
                                Click="MenuItemButton_Click"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Row="3"
                          Margin="16,4,16,8"
                          Visibility="{Binding IsMenuViewGrid, Converter={StaticResource B2V}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding FilteredMenuItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="184" Margin="0,0,10,10"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Cursor="Hand"
                            MouseLeftButtonUp="MenuItemCard_MouseLeftButtonUp">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="96"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FFF7ED" CornerRadius="6" ClipToBounds="True">
                          <Grid>
                            <Image Source="{Binding DisplayImageSource}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding HasImage, Converter={StaticResource B2V}}"/>
                            <Border Background="#FFF7ED" Visibility="{Binding HasNoImage, Converter={StaticResource B2V}}">
                              <TextBlock Text="{Binding Emoji}" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                          </Grid>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding Name}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="#0F172A"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   MaxHeight="34"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                          <Border CornerRadius="4" Padding="4,1" Background="#ECFDF3">
                            <TextBlock Text="{Binding StatusBadge}" FontSize="9" Foreground="#15803D" FontWeight="SemiBold"/>
                          </Border>
                          <Border CornerRadius="4" Padding="4,1" Margin="6,0,0,0" Background="#FEF2F2" Visibility="{Binding HasStockWarning, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding StockWarning}" FontSize="9" Foreground="#DC2626" FontWeight="SemiBold"/>
                          </Border>
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}" FontWeight="Bold" FontSize="14" Foreground="#EA580C"/>
                            <TextBlock Text="{Binding Code}" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                          </StackPanel>
                          <Button Grid.Column="1"
                                  Width="84"
                                  Height="36"
                                  MinWidth="84"
                                  Padding="10,0"
                                  Content="Thêm món"
                                  Tag="&#xE710;"
                                  FontSize="11"
                                  FontWeight="SemiBold"
                                  Style="{StaticResource EnterpriseModuleCmdInfo}"
                                  IsEnabled="{Binding CanOrder}"
                                  Click="MenuItemButton_Click"/>
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <!-- ================================================================ -->
          <!-- TAB 2: ĐƠN MỞ -->
          <!-- ================================================================ -->
          <Grid Visibility="{Binding IsTabOpenOrders, Converter={StaticResource B2V}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16,14,16,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="ĐƠN MỞ" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                  <TextBlock Text="Các đơn chưa thanh toán" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <ComboBox ItemsSource="{Binding OpenOrderSortOptions}"
                            SelectedItem="{Binding SelectedOpenOrderSort}"
                            Style="{StaticResource EnterpriseModuleComboBox}"
                            Height="34" MinWidth="130" FontSize="12" Margin="0,0,6,0"/>
                  <TextBlock Text="Cột" FontSize="12" Foreground="#64748B"
                             VerticalAlignment="Center" Margin="4,0,6,0"/>
                  <TextBox Text="{Binding OpenOrderColumnCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource EnterpriseModuleTextBox}"
                           Height="34" Width="52" FontSize="12" Padding="10,0"
                           HorizontalContentAlignment="Center" Margin="0,0,6,0"/>
                  <Button Content="Làm mới" Tag="&#xE72C;"
                          Command="{Binding RefreshCommand}"
                          Style="{StaticResource ActionSecondaryBtn}" Height="34" FontSize="11"
                          Padding="12,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="16,0,16,8">
              <StackPanel>
              <ItemsControl ItemsSource="{Binding OpenOrders}" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding DataContext.OpenOrderColumnCount, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding DataContext.OpenOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Padding="0" BorderThickness="0" Background="Transparent"
                            HorizontalContentAlignment="Stretch" Height="124" Margin="0,0,6,6">
                      <Border CornerRadius="12" BorderThickness="1" Padding="10,8" ClipToBounds="True">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#F0FDF4"/>
                            <Setter Property="BorderBrush" Value="#BBF7D0"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ServiceStatusText}" Value="Chờ thanh toán">
                                <Setter Property="Background" Value="#FFF7ED"/>
                                <Setter Property="BorderBrush" Value="#FED7AA"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding ServiceStatusText}" Value="Đã gửi bếp">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="BorderBrush" Value="#BFDBFE"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                          </Grid.RowDefinitions>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="{Binding TableName}" FontWeight="Bold" FontSize="15" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding OrderNumber}" FontSize="12" Foreground="#64748B" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="6" Padding="6,3" VerticalAlignment="Top">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="#DCFCE7"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding ServiceStatusText}" Value="Chờ thanh toán">
                                      <Setter Property="Background" Value="#FFF7ED"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ServiceStatusText}" Value="Đã gửi bếp">
                                      <Setter Property="Background" Value="#DBEAFE"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="{Binding ServiceStatusText}" FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#16A34A"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding ServiceStatusText}" Value="Chờ thanh toán">
                                        <Setter Property="Foreground" Value="#EA580C"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding ServiceStatusText}" Value="Đã gửi bếp">
                                        <Setter Property="Foreground" Value="#2563EB"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </Border>
                          </Grid>
                          <StackPanel Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Margin="0,4,0,0">
                            <StackPanel>
                              <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,6,0">
                                  <Border.Style>
                                    <Style TargetType="Border">
                                      <Setter Property="Background" Value="#22C55E"/>
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding ServiceStatusText}" Value="Chờ thanh toán">
                                          <Setter Property="Background" Value="#F97316"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ServiceStatusText}" Value="Đã gửi bếp">
                                          <Setter Property="Background" Value="#3B82F6"/>
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding LineCount, StringFormat={}{0} món}" FontSize="13" Foreground="#64748B"/>
                              </StackPanel>
                              <TextBlock Text="{Binding Note, TargetNullValue=Chưa đặt tên, FallbackValue=Chưa đặt tên, StringFormat=Người ăn: {0}}"
                                         FontSize="11" Foreground="#334155" FontWeight="SemiBold"
                                         TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            </StackPanel>
                          </StackPanel>
                          <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding OrderDate, StringFormat=HH:mm}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Bottom"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat={}{0:N0} đ}"
                                       FontWeight="Bold" FontSize="16" Foreground="#DC2626" HorizontalAlignment="Right"/>
                          </Grid>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Empty state -->
              <Border Visibility="{Binding HasNoOpenOrders, Converter={StaticResource B2V}}"
                      Padding="30">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                             Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                  <TextBlock Text="Không có đơn đang mở" FontWeight="SemiBold" FontSize="14"
                             Foreground="#475569" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- ================================================================ -->
          <!-- TAB 3: CÀI ĐẶT -->
          <Grid Visibility="{Binding IsTabSettings, Converter={StaticResource B2V}}">
            <views:BreakfastCafeSettingsView />
          </Grid>

          <!-- ================================================================ -->
          <!-- TAB 4: ĐƠN ĐÓNG -->
          <!-- ================================================================ -->
          <Grid Visibility="{Binding IsTabClosedOrders, Converter={StaticResource B2V}}">
            <views:BreakfastCafeClosedOrdersView/>
          </Grid>

          <!-- ================================================================ -->
          <!-- TAB 5: BÁO CÁO -->
          <!-- ================================================================ -->
          <Grid Visibility="{Binding IsTabReports, Converter={StaticResource B2V}}" Margin="16,12,16,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource AccountingPanelCard}" Padding="16" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Báo cáo bán đồ ăn sáng &amp; cà phê"
                             FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                  <TextBlock Text="Theo dõi chi tiết đơn hàng, món bán, thanh toán, khu vực và loại đơn từ dữ liệu POS thật."
                             FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Tải lại" Tag="&#xE72C;" Command="{Binding LoadReportsCommand}"
                          Style="{StaticResource EnterpriseModuleCmdSecondary}" Height="36" MinWidth="96"
                          Margin="0,0,8,0" Padding="12,0"/>
                  <Button Content="Xuất Excel" Tag="&#xE8A5;" Command="{Binding ExportReportsExcelCommand}"
                          Style="{StaticResource EnterpriseModuleCmdPrimary}" Height="36" MinWidth="116"
                          Padding="12,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource AccountingPanelCard}" Padding="14" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="155"/>
                  <ColumnDefinition Width="155"/>
                  <ColumnDefinition Width="190"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                  <TextBlock Text="Từ ngày" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                  <DatePicker SelectedDate="{Binding ReportFromDate}"
                              Style="{StaticResource EnterpriseModuleDatePicker}"
                              Width="145" Height="34" Language="vi-VN"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                  <TextBlock Text="Đến ngày" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                  <DatePicker SelectedDate="{Binding ReportToDate}"
                              Style="{StaticResource EnterpriseModuleDatePicker}"
                              Width="145" Height="34" Language="vi-VN"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                  <TextBlock Text="Trạng thái" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                  <ComboBox ItemsSource="{Binding ReportStatusFilters}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding ReportStatusFilter, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource EnterpriseModuleComboBox}"
                            Height="34"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                  <TextBlock Text="Tìm kiếm" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                  <TextBox Text="{Binding ReportSearchText, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource EnterpriseModuleTextBox}"
                           Height="34"
                           Tag="Tìm mã đơn, bàn, khu vực, khách..."/>
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,12">
                <Border Style="{StaticResource AccountingPanelCard}" Padding="14" Margin="0,0,10,0">
                  <StackPanel>
                    <TextBlock Text="Tổng đơn" FontSize="12" Foreground="#64748B"/>
                    <TextBlock Text="{Binding ReportOrderCount, StringFormat={}{0:N0}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource AccountingPanelCard}" Padding="14" Margin="0,0,10,0">
                  <StackPanel>
                    <TextBlock Text="Doanh thu" FontSize="12" Foreground="#64748B"/>
                    <TextBlock Text="{Binding ReportRevenueAmount, StringFormat={}{0:N0} đ}" FontSize="22" FontWeight="Bold" Foreground="#EA580C" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource AccountingPanelCard}" Padding="14" Margin="0,0,10,0">
                  <StackPanel>
                    <TextBlock Text="Đã thanh toán" FontSize="12" Foreground="#64748B"/>
                    <TextBlock Text="{Binding ReportPaidOrderCount, StringFormat={}{0:N0}}" FontSize="22" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource AccountingPanelCard}" Padding="14" Margin="0,0,10,0">
                  <StackPanel>
                    <TextBlock Text="Giảm giá" FontSize="12" Foreground="#64748B"/>
                    <TextBlock Text="{Binding ReportDiscountAmount, StringFormat={}{0:N0} đ}" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource AccountingPanelCard}" Padding="14">
                  <StackPanel>
                    <TextBlock Text="Trung bình/đơn" FontSize="12" Foreground="#64748B"/>
                    <TextBlock Text="{Binding ReportAverageOrderAmount, StringFormat={}{0:N0} đ}" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <Border Grid.Row="1" Style="{StaticResource AccountingPanelCard}" Padding="0">
                <TabControl SelectedIndex="{Binding ReportDetailTabIndex}"
                            ItemContainerStyle="{StaticResource PosReportTabItem}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,0,8,8">
                  <TabItem Header="Chi tiết đơn" Tag="&#xE8A5;">
                    <DataGrid ItemsSource="{Binding ReportOrders}" Style="{StaticResource EnterpriseModuleDataGrid}"
                              IsReadOnly="True" AutoGenerateColumns="False" RowHeaderWidth="0" BorderThickness="0">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderNumber}" Width="130"/>
                        <DataGridTextColumn Header="Ngày" Binding="{Binding OrderDateText}" Width="140"/>
                        <DataGridTextColumn Header="Khu vực" Binding="{Binding AreaName}" Width="120"/>
                        <DataGridTextColumn Header="Bàn/phòng" Binding="{Binding TableName}" Width="120"/>
                        <DataGridTextColumn Header="Loại đơn" Binding="{Binding OrderTypeText}" Width="120"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="120"/>
                        <DataGridTextColumn Header="Số món" Binding="{Binding LineCount}" Width="80"/>
                        <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="120"/>
                        <DataGridTextColumn Header="Đã thu" Binding="{Binding PaidAmount, StringFormat={}{0:N0}}" Width="120"/>
                        <DataGridTextColumn Header="Còn lại" Binding="{Binding RemainingAmount, StringFormat={}{0:N0}}" Width="120"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </TabItem>
                  <TabItem Header="Món bán" Tag="&#xE8D4;">
                    <DataGrid ItemsSource="{Binding ReportItems}" Style="{StaticResource EnterpriseModuleDataGrid}"
                              IsReadOnly="True" AutoGenerateColumns="False" RowHeaderWidth="0" BorderThickness="0">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã món" Binding="{Binding Code}" Width="130"/>
                        <DataGridTextColumn Header="Tên món" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="120"/>
                        <DataGridTextColumn Header="Doanh thu" Binding="{Binding RevenueAmount, StringFormat={}{0:N0}}" Width="140"/>
                        <DataGridTextColumn Header="Giá bình quân" Binding="{Binding AveragePrice, StringFormat={}{0:N0}}" Width="140"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </TabItem>
                  <TabItem Header="Thanh toán" Tag="&#xE8C7;">
                    <DataGrid ItemsSource="{Binding ReportPayments}" Style="{StaticResource EnterpriseModuleDataGrid}"
                              IsReadOnly="True" AutoGenerateColumns="False" RowHeaderWidth="0" BorderThickness="0">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Phương thức" Binding="{Binding PaymentMethodText}" Width="*"/>
                        <DataGridTextColumn Header="Số giao dịch" Binding="{Binding TransactionCount}" Width="130"/>
                        <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="150"/>
                        <DataGridTextColumn Header="Nháp" Binding="{Binding DraftCount}" Width="100"/>
                        <DataGridTextColumn Header="Đã ghi sổ" Binding="{Binding PostedCount}" Width="110"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </TabItem>
                  <TabItem Header="Khu vực" Tag="&#xE707;">
                    <DataGrid ItemsSource="{Binding ReportAreas}" Style="{StaticResource EnterpriseModuleDataGrid}"
                              IsReadOnly="True" AutoGenerateColumns="False" RowHeaderWidth="0" BorderThickness="0">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Khu vực" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Tổng đơn" Binding="{Binding OrderCount}" Width="120"/>
                        <DataGridTextColumn Header="Đơn đã thanh toán" Binding="{Binding PaidOrderCount}" Width="150"/>
                        <DataGridTextColumn Header="Doanh thu" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="160"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </TabItem>
                  <TabItem Header="Loại đơn" Tag="&#xE8FD;">
                    <DataGrid ItemsSource="{Binding ReportOrderTypes}" Style="{StaticResource EnterpriseModuleDataGrid}"
                              IsReadOnly="True" AutoGenerateColumns="False" RowHeaderWidth="0" BorderThickness="0">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Loại đơn" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Tổng đơn" Binding="{Binding OrderCount}" Width="120"/>
                        <DataGridTextColumn Header="Đơn đã thanh toán" Binding="{Binding PaidOrderCount}" Width="150"/>
                        <DataGridTextColumn Header="Doanh thu" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="160"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </TabItem>
                </TabControl>
              </Border>
            </Grid>
          </Grid>

        </Grid>
      </Grid>

      <!-- ================================================================ -->
      <!-- RIGHT COLUMN (40%): ĐƠN HÀNG HIỆN TẠI -->
      <!-- ================================================================ -->
      <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1,0,0,0"
              Visibility="{Binding ShowOrderPanel, Converter={StaticResource B2V}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- ORDER HEADER -->
          <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Order number + action -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="ĐƠN HÀNG HIỆN TẠI" FontSize="11" FontWeight="SemiBold"
                             Foreground="#64748B"/>
                  <TextBlock Text="{Binding CurrentOrderTitle}" FontSize="18" FontWeight="Bold"
                             Foreground="#0F172A" Margin="0,2,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding CurrentOrderTypeText}" FontSize="12"
                               Foreground="#2563EB" FontWeight="SemiBold"/>
                    <TextBlock Text=" · " Foreground="#CBD5E1"/>
                    <TextBlock Text="{Binding CurrentOrderStatusText}" FontSize="12"
                               Foreground="#EA580C" FontWeight="SemiBold"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
  <Button Content="Chia &#x111;&#x1A1;n" Tag="&#xE8A5;"
          Command="{Binding SplitOrderCommand}"
          Style="{StaticResource ActionSecondaryBtn}" Height="32" FontSize="11"
          Padding="10,0" Margin="0,0,6,0"/>
  <Button Content="G&#x1ED9;p &#x111;&#x1A1;n" Tag="&#xE8B4;"
          Command="{Binding StartMergeOrderCommand}"
          Style="{StaticResource ActionSecondaryBtn}" Height="32" FontSize="11"
          Padding="10,0" Margin="0,0,6,0"/>
  <Button Content="&#x110;&#x1ED5;i b&#xE0;n" Tag="&#xE8ED;"
          Command="{Binding StartChangeTableCommand}"
          Style="{StaticResource ActionSecondaryBtn}" Height="32" FontSize="11"
          Padding="10,0"/>
</StackPanel>
              </Grid>

              <!-- Table/room/seat info -->
              <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="#2563EB" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentSeatName}" FontWeight="SemiBold" FontSize="13"
                               Foreground="#0F172A" VerticalAlignment="Center" Margin="6,0,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding SelectedTable.SeatCount, StringFormat={}{0} chỗ}"
                             FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                </Grid>
              </Border>

              <!-- Split order tabs -->
              <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1"
                      CornerRadius="8" Padding="8" Margin="0,8,0,0"
                      Visibility="{Binding HasOrderTabs, Converter={StaticResource B2V}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding CurrentOrderTabs}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Command="{Binding DataContext.SelectOrderTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"
                                  Margin="0,0,6,0"
                                  Padding="10,6"
                                  MinWidth="92"
                                  Cursor="Hand">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource ActionSecondaryBtn}">
                                <Setter Property="Height" Value="42"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                    <Setter Property="BorderBrush" Value="#93C5FD"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                            <StackPanel>
                              <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                         TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding TotalText}" FontSize="10" Foreground="#64748B"
                                         HorizontalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBox Text="{Binding CurrentOrderTabName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EnterpriseModuleTextBox}"
                             Height="32" Width="112" FontSize="11" Padding="8,0"/>
                    <Button Content="Lưu tên" Tag="&#xE74E;"
                            Command="{Binding SaveOrderTabNameCommand}"
                            Style="{StaticResource ActionSecondaryBtn}"
                            Height="32" MinWidth="72" FontSize="11" Padding="8,0"
                            Margin="6,0,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <!-- ORDER LINES -->
          <Grid Grid.Row="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Empty state -->
            <Border Grid.RowSpan="2"
                    Visibility="{Binding HasNoOrderLines, Converter={StaticResource B2V}}"
                    Padding="30">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                           Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                <TextBlock Text="Chưa có món trong đơn" FontWeight="SemiBold" FontSize="14"
                           Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Chọn tab Thực đơn để thêm món" FontSize="12"
                           Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="16,8"
                    Visibility="{Binding HasOrderLines, Converter={StaticResource B2V}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <CheckBox IsChecked="{Binding SelectAllOrderLines, Mode=TwoWay}" VerticalAlignment="Center"/>
                  <TextBlock Text="Chọn tất cả" Margin="8,0,0,0" VerticalAlignment="Center"
                             FontSize="12" Foreground="#334155"/>
                  <TextBlock Text="{Binding SelectedOrderLineCount, StringFormat={}({0} món)}"
                             Margin="10,0,0,0" VerticalAlignment="Center"
                             FontSize="12" Foreground="#64748B"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Hủy món đã chọn"
                        Tag="&#xE74D;"
                        Command="{Binding CancelSelectedLinesCommand}"
                        Style="{StaticResource ActionSecondaryBtn}"
                        Height="32" MinWidth="132" FontSize="11" Padding="10,0"/>
              </Grid>
            </Border>

            <!-- Lines list -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"
                          Visibility="{Binding HasOrderLines, Converter={StaticResource B2V}}">
              <ItemsControl ItemsSource="{Binding CurrentOrderLines}" Margin="16,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource OrderLineCard}">
                      <Grid MinHeight="38">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="26"/>
                          <ColumnDefinition Width="40"/>
                          <ColumnDefinition Width="150"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>

                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8" Background="#FFF7ED" VerticalAlignment="Center">
                          <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                     Foreground="#F2994A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,8,0">
                          <TextBlock Text="{Binding MenuItemName}" FontWeight="SemiBold" FontSize="13"
                                     Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}" FontSize="11"
                                     Foreground="#64748B"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                          <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                            <Button x:Name="LineNoteButton"
                                    Command="{Binding DataContext.ToggleLineNotePopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="Ghi chú món"
                                    Style="{StaticResource ActionSecondaryBtn}"
                                    Height="30" MinWidth="78" FontSize="11" Padding="8,0">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ghi chú" VerticalAlignment="Center"/>
                              </StackPanel>
                            </Button>
                            <primitives:Popup IsOpen="{Binding IsNotePopupOpen, Mode=TwoWay}"
                                              PlacementTarget="{Binding ElementName=LineNoteButton}"
                                              Placement="Bottom"
                                              AllowsTransparency="True"
                                              StaysOpen="False">
                              <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                      CornerRadius="10" Padding="10" Width="260">
                                <Border.Effect>
                                  <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.16" Color="#64748B"/>
                                </Border.Effect>
                                <Grid>
                                  <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                  </Grid.RowDefinitions>
                                  <TextBlock Text="Ghi chú món" FontSize="12" FontWeight="SemiBold"
                                             Foreground="#0F172A" Margin="0,0,0,8"/>
                                  <TextBox Grid.Row="1"
                                           Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                           Style="{StaticResource EnterpriseModuleTextBox}"
                                           Height="34" FontSize="12" Padding="10,0"/>
                                  <Button Grid.Row="2" Content="Lưu" Tag="&#xE74E;"
                                          Command="{Binding PlacementTarget.Tag.SaveLineNoteCommand, RelativeSource={RelativeSource AncestorType={x:Type primitives:Popup}}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type primitives:Popup}}}"
                                          Style="{StaticResource ActionSecondaryBtn}"
                                          Height="32" MinWidth="72" FontSize="11" Padding="10,0"
                                          HorizontalAlignment="Right" Margin="0,10,0,0"/>
                                </Grid>
                              </Border>
                            </primitives:Popup>
                          </Grid>

                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Button Content="-" Style="{StaticResource QtyBtn}"
                                    Command="{Binding DataContext.DecreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <TextBlock Text="{Binding QuantityDisplay}" Width="34" TextAlignment="Center"
                                       VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                            <Button Content="+" Style="{StaticResource QtyBtn}"
                                    Command="{Binding DataContext.IncreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                          </StackPanel>

                          <TextBlock Text="{Binding LineTotalAmount, StringFormat={}{0:N0} đ}"
                                     FontWeight="Bold" FontSize="13" Foreground="#DC2626"
                                     VerticalAlignment="Center" Margin="0,0,14,0"/>

                          <Button Content="✕" Style="{StaticResource DelBtn}"
                                  VerticalAlignment="Center"
                                  Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <!-- ORDER FOOTER: Totals + Payment + Actions -->
          <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                  Padding="16,12">
            <StackPanel>
              <!-- Totals -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tạm tính" FontSize="12" Foreground="#475569"/>
                <TextBlock Grid.Column="1" Text="{Binding SubtotalAmount, StringFormat={}{0:N0} đ}"
                           FontSize="12" Foreground="#0F172A"/>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Giảm giá" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource EnterpriseModuleTextBox}" Height="30" Width="80"
                         FontSize="11" Padding="6,0"/>
                <Button Grid.Column="2" Content="Áp dụng" Tag="&#xE73E;"
                        Command="{Binding ApplyDiscountCommand}"
                        Style="{StaticResource ActionSecondaryBtn}" Height="30" MinWidth="60"
                        FontSize="10" Padding="6,0" Margin="6,0,0,0"/>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="VAT" FontSize="12" Foreground="#475569"/>
                <TextBlock Grid.Column="1" Text="{Binding VatAmount, StringFormat={}{0:N0} đ}"
                           FontSize="12" Foreground="#0F172A"/>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Phí phục vụ" FontSize="12" Foreground="#475569"/>
                <TextBlock Grid.Column="1" Text="{Binding ServiceChargeAmount, StringFormat={}{0:N0} đ}"
                           FontSize="12" Foreground="#0F172A"/>
              </Grid>

              <!-- Total -->
              <Border Background="#FFF7ED" CornerRadius="10" Padding="12,10" Margin="0,4,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="TỔNG CỘNG" FontSize="16" FontWeight="Bold" Foreground="#0F172A"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat={}{0:N0} đ}"
                             FontSize="22" FontWeight="Bold" Foreground="#DC2626"/>
                </Grid>
              </Border>

              <!-- Payment method chips -->
              <ItemsControl ItemsSource="{Binding PaymentMethods}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding .}"
                            Command="{Binding DataContext.SelectPaymentMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding .}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PayChip}">
                          <Style.Triggers>
                            <DataTrigger Value="True">
                              <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource StringEquality}">
                                  <Binding Path="."/>
                                  <Binding Path="DataContext.SelectedPaymentMethod" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                </MultiBinding>
                              </DataTrigger.Binding>
                              <Setter Property="Background" Value="#EFF6FF"/>
                              <Setter Property="Foreground" Value="#1D4ED8"/>
                              <Setter Property="BorderBrush" Value="#93C5FD"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Action buttons -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Content="Gửi bếp/bar"
                        Command="{Binding SendKitchenCommand}"
                        IsEnabled="{Binding CanSendKitchen}"
                        Style="{StaticResource ActionPrimaryBtn}" Margin="0,0,4,6"/>
                <Button Grid.Row="0" Grid.Column="1" Content="In toàn bộ bếp/bar"
                        Command="{Binding PrintAllKitchenBarCommand}"
                        Style="{StaticResource ActionSecondaryBtn}" Margin="4,0,4,6"/>
                <Button Grid.Row="0" Grid.Column="2" Content="In tạm tính"
                        Command="{Binding PrintProvisionalCommand}"
                        Style="{StaticResource ActionSecondaryBtn}" Margin="4,0,0,6"/>
                <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Thanh toán"
                        Command="{Binding PayOrderCommand}"
                        Style="{StaticResource ActionSuccessBtn}" Margin="0,0,4,0"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Hủy đơn"
                        Command="{Binding CancelOrderCommand}"
                        Style="{StaticResource ActionDangerBtn}" Margin="4,0,0,0"/>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>



