                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="GuestPagerSummary"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#64748B"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="GuestPreviousButton" Content="←" Click="OnGuestPreviousPage" Style="{StaticResource PagerButtonStyle}"/>
                                    <StackPanel x:Name="GuestPageButtons" Orientation="Horizontal"/>
                                    <Button x:Name="GuestNextButton" Content="→" Click="OnGuestNextPage" Style="{StaticResource PagerButtonStyle}"/>
                                    <ComboBox x:Name="GuestPageSizeBox"
                                              Width="118"
                                              Margin="8,0,0,0"
                                              SelectionChanged="OnGuestPageSizeChanged"
                                              Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Chi tiết khách đã chọn" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Grid.Row="1">
                            <Border x:Name="GuestEmptyState" Padding="16" Background="#F8FAFC" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Chưa chọn khách" FontSize="14" FontWeight="SemiBold" Foreground="#52657D"/>
                                    <TextBlock Margin="0,4,0,0" Text="Chọn một khách đang lưu trú trong danh sách để tiếp tục." TextWrapping="Wrap" FontSize="12" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="GuestDetailPanel" Visibility="Collapsed">
                                <TextBlock x:Name="GuestDetailName" FontSize="18" FontWeight="SemiBold" Foreground="#17365D"/>
                                <TextBlock x:Name="GuestDetailProfile" Margin="0,3,0,14" FontSize="12" Foreground="#64748B"/>
                                <Border Height="1" Margin="0,0,0,12" Background="#E2E8F0"/>
                                <TextBlock x:Name="GuestDetailRoom" Margin="0,3" FontSize="12" Foreground="#334155"/>
                                <TextBlock x:Name="GuestDetailDates" Margin="0,3" FontSize="12" Foreground="#334155"/>
                                <TextBlock x:Name="GuestDetailFolio" Margin="0,3" FontSize="12" Foreground="#334155"/>
                                <TextBlock x:Name="GuestDetailVip" Margin="0,3" FontSize="12" Foreground="#334155"/>
                                <Border Margin="0,16,0,0" Padding="12" Background="#FFF7ED" CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock Text="Lưu ý bàn giao" FontSize="12" FontWeight="SemiBold" Foreground="#9A3412"/>
                                        <TextBlock Margin="0,4,0,0" Text="Minibar chưa kiểm tra · 2 thẻ cần thu hồi · hành lý cần chuyển" TextWrapping="Wrap" FontSize="11" Foreground="#C2410C"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="Step2Content" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="35*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Padding="14,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <WrapPanel>
                                <StackPanel Width="112" Margin="0,0,8,6">
                                    <TextBlock Text="Hạng phòng" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="RoomTypeFilter" Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                                <StackPanel Width="76" Margin="0,0,8,6">
                                    <TextBlock Text="Tầng" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="RoomFloorFilter" Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                                <StackPanel Width="86" Margin="0,0,8,6">
                                    <TextBlock Text="Giường" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="RoomBedFilter" Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                                <StackPanel Width="112" Margin="0,0,8,6">
                                    <TextBlock Text="Trạng thái" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="RoomStatusFilter" Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                                <StackPanel Width="100" Margin="0,0,8,6">
                                    <TextBlock Text="Nhà buồng" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="RoomHousekeepingFilter" Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                                <StackPanel Width="112" Margin="0,0,8,6">
                                    <TextBlock Text="Giá" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="RoomPriceFilter" Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                                <CheckBox x:Name="ReadyRoomsOnlyCheckBox"
                                          Margin="0,18,8,6"
                                          Content="Chỉ phòng sẵn sàng"
                                          Style="{StaticResource ModernCheckBox}"/>
                                <Button Margin="0,15,6,6" Content="Tìm" Click="OnApplyRoomFilters" Style="{StaticResource PrimaryButton}"/>
                                <Button Margin="0,15,0,6" Content="Xóa lọc" Click="OnClearRoomFilters" Style="{StaticResource SecondaryButton}"/>
                            </WrapPanel>
                        </Border>

                        <DataGrid x:Name="RoomGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource ModernDataGrid}"
                                  SelectionChanged="OnRoomPreviewChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Phòng" Binding="{Binding Room}" Width="60"/>
                                <DataGridTextColumn Header="Hạng" Binding="{Binding RoomType}" Width="85"/>
                                <DataGridTextColumn Header="Tầng" Binding="{Binding Floor}" Width="48"/>
                                <DataGridTextColumn Header="Giường" Binding="{Binding Bed}" Width="60"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="92"/>
                                <DataGridTextColumn Header="Nhà buồng" Binding="{Binding HousekeepingStatus}" Width="75"/>
                                <DataGridTextColumn Header="Giá" Binding="{Binding PriceDisplay}" Width="92"/>
                                <DataGridTextColumn Header="Chênh lệch" Binding="{Binding DifferenceDisplay}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2"
                                Padding="12,9"
                                Background="#FBFCFE"
                                BorderBrush="#E2E8F0"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RoomPagerSummary"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#64748B"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="RoomPreviousButton" Content="←" Click="OnRoomPreviousPage" Style="{StaticResource PagerButtonStyle}"/>
                                    <StackPanel x:Name="RoomPageButtons" Orientation="Horizontal"/>
                                    <Button x:Name="RoomNextButton" Content="→" Click="OnRoomNextPage" Style="{StaticResource PagerButtonStyle}"/>
                                    <ComboBox x:Name="RoomPageSizeBox"
                                              Width="118"
                                              Margin="8,0,0,0"
                                              SelectionChanged="OnRoomPageSizeChanged"
                                              Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Chi tiết phòng đang xem" Style="{StaticResource SectionTitle}"/>
                        <Border x:Name="RoomGuestWarning"
                                Grid.Row="1"
                                Margin="0,0,0,12"
                                Padding="12"
                                Background="#FFF7ED"
                                CornerRadius="9">
                            <TextBlock Text="Vui lòng chọn khách trước khi chọn phòng."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="#C2410C"/>
                        </Border>
                        <Grid Grid.Row="2">
                            <Border x:Name="RoomEmptyState" Padding="16" Background="#F8FAFC" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Chưa chọn dòng phòng" FontSize="14" FontWeight="SemiBold" Foreground="#52657D"/>
                                    <TextBlock Margin="0,4,0,0" Text="Click một dòng để xem trước. Dòng được xem chưa phải phòng đã chọn." TextWrapping="Wrap" FontSize="12" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="RoomPreviewPanel" Visibility="Collapsed">
                                <TextBlock x:Name="RoomPreviewTitle" FontSize="20" FontWeight="SemiBold" Foreground="#17365D"/>
                                <TextBlock x:Name="RoomPreviewType" Margin="0,3,0,14" FontSize="12" Foreground="#64748B"/>
                                <Border Height="1" Margin="0,0,0,12" Background="#E2E8F0"/>
                                <TextBlock x:Name="RoomPreviewStatus" Margin="0,3" FontSize="12" Foreground="#334155"/>
                                <TextBlock x:Name="RoomPreviewBed" Margin="0,3" FontSize="12" Foreground="#334155"/>
                                <TextBlock x:Name="RoomPreviewPrice" Margin="0,3" FontSize="12" Foreground="#334155"/>
                                <TextBlock x:Name="RoomPreviewDifference" Margin="0,3" FontSize="12" Foreground="#334155"/>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="SelectPreviewRoomButton"
                                Grid.Row="3"
                                Margin="0,14,0,0"
                                Content="Chọn phòng này"
                                Click="OnSelectPreviewRoom"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="Step3Content" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="AdjustmentWarning"
                        Margin="0,0,0,10"
                        Padding="12,9"
                        Background="#FFF7ED"
                        CornerRadius="9">
                    <TextBlock x:Name="AdjustmentWarningText"
                               Text="Chưa đủ thông tin. Bạn vẫn có thể xem bước này; hãy chọn khách và phòng để kích hoạt các trường phụ thuộc."
                               FontSize="12"
                               Foreground="#C2410C"/>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Thông tin điều chỉnh" Style="{StaticResource SectionTitle}"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Thời điểm hiệu lực" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="EffectiveModeBox" SelectionChanged="OnAdjustmentChanged" Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ngày" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker x:Name="EffectiveDatePicker" SelectedDateChanged="OnAdjustmentDateChanged" Style="{StaticResource ModernDatePicker}"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Margin="0,14" Background="#E2E8F0"/>
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Giờ" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EffectiveTimeBox" Text="14:00" TextChanged="OnAdjustmentTextChanged" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Lý do đổi phòng" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ReasonBox" SelectionChanged="OnAdjustmentChanged" Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="4" Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Người yêu cầu" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="RequestedByBox" Text="Khách lưu trú" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Người phê duyệt" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ApprovedByBox" Text="Quản lý trực ca" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                    <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="AdjustmentNoteBox"
                                             Height="70"
                                             Padding="11,8"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Giá và chính sách" Style="{StaticResource SectionTitle}"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Giá cũ" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="OldPriceText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#17365D"/>
                                    <TextBlock Margin="0,12,0,0" Text="Chênh lệch" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="PriceDifferenceText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="#2F6BFF"/>
                                    <TextBlock Margin="0,12,0,0" Text="Tổng phát sinh" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TotalDifferenceText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="#17365D"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Giá mới" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="NewPriceText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#17365D"/>
                                    <TextBlock Margin="0,12,0,0" Text="Số đêm còn lại" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="RemainingNightsText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="#17365D"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Margin="0,16" Background="#E2E8F0"/>
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Chính sách giá" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="PricePolicyBox" SelectionChanged="OnAdjustmentChanged" Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Giá thỏa thuận" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="NegotiatedPriceBox" IsEnabled="False" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                    <TextBlock Text="Lý do miễn chênh lệch" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="WaiverReasonBox" IsEnabled="False" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="Step4Content" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <TextBlock Text="Phòng cũ" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="Kiểm tra và chốt Minibar" Tag="Minibar" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Đối chiếu tài sản trong phòng" Tag="Tài sản" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Thu hồi toàn bộ thẻ phòng cũ" Tag="Thu hồi thẻ" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Thông báo bộ phận Nhà buồng" Tag="Thông báo HSK" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Chuyển phòng cũ về trạng thái chờ dọn" Tag="Đưa phòng dọn" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <TextBlock Text="Phòng mới" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="Xác nhận phòng mới đã sạch" Tag="Phòng sạch" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Kiểm tra nhanh trang thiết bị" Tag="Kiểm tra" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Phát hành thẻ phòng mới" Tag="Thẻ mới" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Chuẩn bị giường phụ nếu có" Tag="Giường phụ" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Chuyển yêu cầu đặc biệt" Tag="Chuyển YCĐB" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <TextBlock Text="Khách và hành lý" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="Xác nhận phương án chuyển khách" Tag="Chuyển khách" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Kiểm đếm và bàn giao hành lý" Tag="Hành lý" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Điều phối Bellman" Tag="Bellman" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Thông báo lịch chuyển cho khách" Tag="Báo khách" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <TextBlock Text="Folio và hồ sơ" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="Chuyển Folio sang phòng mới" Tag="Chuyển Folio" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Chuyển package và quyền lợi" Tag="Chuyển package" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Chuyển ghi chú lưu trú" Tag="Chuyển ghi chú" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="0,8,0,0" Content="Chuyển thông tin VIP" Tag="Chuyển VIP" Checked="OnHandoverChanged" Unchecked="OnHandoverChanged" Style="{StaticResource ModernCheckBox}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="Step5Content" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="42*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Tóm tắt đổi phòng" Style="{StaticResource SectionTitle}"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Khách" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ConfirmGuestText" Grid.Column="1" Margin="0,0,0,9" FontSize="12" FontWeight="SemiBold" Foreground="#17365D"/>
                            <TextBlock Grid.Row="1" Text="Phòng cũ" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ConfirmOldRoomText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,9" FontSize="12" Foreground="#334155"/>
                            <TextBlock Grid.Row="2" Text="Phòng mới" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ConfirmNewRoomText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,9" FontSize="12" FontWeight="SemiBold" Foreground="#2F6BFF"/>
                            <TextBlock Grid.Row="3" Text="Ngày giờ hiệu lực" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ConfirmEffectiveText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,9" FontSize="12" Foreground="#334155"/>
                            <TextBlock Grid.Row="4" Text="Lý do" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ConfirmReasonText" Grid.Row="4" Grid.Column="1" Margin="0,0,0,9" FontSize="12" Foreground="#334155"/>
                            <TextBlock Grid.Row="5" Text="Giá" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ConfirmPriceText" Grid.Row="5" Grid.Column="1" Margin="0,0,0,9" FontSize="12" Foreground="#334155"/>
                            <TextBlock Grid.Row="6" Text="Chênh lệch" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ConfirmDifferenceText" Grid.Row="6" Grid.Column="1" Margin="0,0,0,9" FontSize="12" Foreground="#334155"/>
                            <TextBlock Grid.Row="7" Text="Người phê duyệt" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ConfirmApproverText" Grid.Row="7" Grid.Column="1" Margin="0,0,0,9" FontSize="12" Foreground="#334155"/>
                            <TextBlock Grid.Row="8" Text="Tác vụ bàn giao" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ConfirmHandoverText" Grid.Row="8" Grid.Column="1" FontSize="12" Foreground="#334155"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Kiểm tra sẵn sàng" Style="{StaticResource SectionTitle}"/>
                        <Border x:Name="ReadinessPanel" Grid.Row="1" Padding="14" Background="#FEF3C7" CornerRadius="10">
                            <StackPanel>
                                <TextBlock x:Name="ReadinessTitleText" Text="Chưa đủ thông tin" FontSize="15" FontWeight="SemiBold" Foreground="#A16207"/>
                                <TextBlock x:Name="ReadinessDescriptionText" Margin="0,4,0,0" Text="Hãy chọn khách và phòng mới trước khi xác nhận." TextWrapping="Wrap" FontSize="12" Foreground="#92400E"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Row="2" Margin="0,16,0,8" Text="Cảnh báo và tác vụ còn thiếu" FontSize="12" FontWeight="SemiBold" Foreground="#17365D"/>
                        <StackPanel x:Name="ReadinessIssuesPanel" Grid.Row="3"/>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="StepRuntimeError"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    MaxWidth="720"
                    Margin="0,12,0,0"
                    Padding="14,10"
                    Background="#FEE2E2"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                <TextBlock x:Name="StepRuntimeErrorText"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#B91C1C"/>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Padding="18,10"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FooterStepLabel"
                               Text="Bước 1/5 · Chọn khách"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#52657D"/>
                    <TextBlock x:Name="FooterStatusText"
                               Margin="0,2,0,0"
                               Text="Dữ liệu phòng và lưu trú được tải từ hệ thống thật"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               Foreground="#94A3B8"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Hủy" Click="OnClose" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="BackButton"
                            Margin="8,0,0,0"
                            Content="← Quay lại"
                            Click="OnBack"
                            Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="NextButton"
                            Margin="8,0,0,0"
                            Content="Tiếp tục →"
                            Click="OnNext"
                            Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="ConfirmButton"
                            Margin="8,0,0,0"
                            Content="Xác nhận đổi phòng"
                            Click="OnConfirm"
                            Style="{StaticResource PrimaryButton}"
                            Visibility="Collapsed"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
