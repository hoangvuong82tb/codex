<UserControl x:Class="ASMILE.BO.App.Views.ServiceRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             UseLayoutRounding="True" Loaded="OnLoaded">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
        <converters:PriorityToColorConverter x:Key="PriorityToColor"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>

        <!-- HEADER -->
        <Border Grid.ColumnSpan="2" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Yeu Cau Dich Vu (Service Request)" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding TotalOpen, StringFormat='Mo: {0}'}" Margin="0,0,12,0" Foreground="#EA580C" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalInProgress, StringFormat='Dang lam: {0}'}" Margin="0,0,12,0" Foreground="#2563EB" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalCompleted, StringFormat='Xong: {0}'}" Foreground="#16A34A" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="Lam moi" Command="{Binding RefreshCommand}" Style="{StaticResource FluentSecondaryButton}"/>
            </Grid>
        </Border>

        <!-- CREATE FORM -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F0F4F8" Padding="12,8" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1">
            <WrapPanel>
                <ComboBox ItemsSource="{Binding ServiceTypes}" Text="{Binding NewServiceType, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Width="150" Margin="0,0,4,4"/>
                <TextBox Text="{Binding NewRoomNumber, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,4,4"/>
                <TextBox Text="{Binding NewGuestName, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,4,4"/>
                <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding NewCategory}" Width="110" Margin="0,0,4,4"/>
                <ComboBox ItemsSource="{Binding PriorityFilters}" SelectedItem="{Binding NewPriority}" Width="80" Margin="0,0,4,4"/>
                <ComboBox Width="100" Margin="0,0,4,4" SelectedItem="{Binding NewChargeType}">
                    <ComboBox.ItemsSource><x:Array Type="system:String"><system:String>Complimentary</system:String><system:String>ImmediateCharge</system:String><system:String>ChargeAtCheckout</system:String></x:Array></ComboBox.ItemsSource>
                </ComboBox>
                <TextBox Text="{Binding NewCost, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,4,4"/>
                <Button Content="Tao Yeu Cau" Command="{Binding CreateRequestCommand}" Style="{StaticResource FluentPrimaryButton}" Padding="8,4" FontSize="11"/>
            </WrapPanel>
        </Border>

        <!-- REQUEST LIST -->
        <ScrollViewer Grid.Row="2" Grid.Column="0" Margin="12,8">
            <ItemsControl ItemsSource="{Binding Requests}">
                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ServiceRequestDto}">
                    <Border Padding="12,10" Margin="0,0,0,4" CornerRadius="8" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="OnRequestClick" Tag="{Binding}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding RequestNumber}" FontWeight="SemiBold" FontSize="13" Margin="0,0,8,0"/>
                                    <Border CornerRadius="3" Padding="4,1" Background="{Binding Status, Converter={StaticResource StatusToColor}}"><TextBlock Text="{Binding Status}" FontSize="10" Foreground="White"/></Border>
                                    <Border CornerRadius="3" Padding="4,1" Background="{Binding Priority, Converter={StaticResource PriorityToColor}}" Margin="4,0,0,0"><TextBlock Text="{Binding Priority}" FontSize="10" Foreground="White"/></Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding ServiceType}" FontSize="13"/>
                                    <TextBlock Text="{Binding RoomNumber, StringFormat=' - Phong {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,0"/>
                                    <TextBlock Text="{Binding GuestName, StringFormat=' - {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EstimatedCost, StringFormat='{}{0:N0} VND'}" FontWeight="SemiBold" Foreground="#2563EB" FontSize="12"/>
                                <TextBlock Text="{Binding AssignedDepartment}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ACTIONS + HISTORY -->
        <Border Grid.Row="2" Grid.Column="1" Background="White" BorderBrush="#DDE7F3" BorderThickness="1,0,0,0" Padding="16" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="CHI TIET" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding SelectedRequest.RequestNumber}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedRequest.ServiceType}"/>
                <TextBlock Text="{Binding SelectedRequest.GuestName}"/>
                <TextBlock Text="{Binding SelectedRequest.RoomNumber, StringFormat='Phong: {0}'}"/>
                <Separator Margin="0,8"/>
                <WrapPanel>
                    <Button Content="Phan cong" Command="{Binding AssignRequestCommand}" Style="{StaticResource FluentPrimaryButton}" Padding="8,4" FontSize="11" Margin="0,0,4,4"/>
                    <Button Content="Bat đau" Command="{Binding StartRequestCommand}" Style="{StaticResource FluentSecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,4,4"/>
                    <Button Content="Hoan thanh" Command="{Binding CompleteRequestCommand}" Style="{StaticResource FluentSecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,4,4"/>
                    <Button Content="Huy" Command="{Binding CancelRequestCommand}" Style="{StaticResource FluentSecondaryButton}" Padding="8,4" FontSize="11"/>
                </WrapPanel>
                <Separator Margin="0,8"/>
                <TextBlock Text="LICH SU" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding SelectedRequest.History}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Loading -->
        <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Dang tai..." Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
