<Window x:Class="ASMILE.BO.App.Views.StockReceiptDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết phiếu nhập"
        Width="1060"
        Height="700"
        MinWidth="1060"
        MinHeight="700"
        MaxWidth="1060"
        MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Text="{Binding SupplierName, StringFormat=Nhà cung cấp: {0}}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#1E3352" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Visibility="Collapsed" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Visibility="Collapsed" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Margin="0,8,10,0"
                           Text="{Binding ReceiptNo, StringFormat=Số phiếu: {0}}"
                           FontSize="14"
                           Foreground="#334D70" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Margin="0,8,0,0"
                           Text="{Binding ReceiptDate, StringFormat=Ngày chứng từ: {0:dd/MM/yyyy}}"
                           FontSize="14"
                           Foreground="#334D70" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Margin="0,8,10,0"
                           Text="{Binding ReceiverName, StringFormat=Người nhận hàng: {0}}"
                           FontSize="14"
                           Foreground="#334D70" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Margin="0,8,0,0"
                           Text="{Binding TotalAmount, StringFormat=Tổng tiền: {0:N0}}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#2F65D9" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,10"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10">
            <DataGrid ItemsSource="{Binding Details}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      RowHeight="38"
                      Background="White"
                      GridLinesVisibility="All"
                      HeadersVisibility="Column"
                      HorizontalAlignment="Stretch"
                      HorizontalGridLinesBrush="#CBD5E1"
                      VerticalGridLinesBrush="#CBD5E1"
                      BorderBrush="#CBD5E1"
                      CellStyle="{StaticResource EnterpriseDetailDataGridCell}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT" Binding="{Binding LineNo}" Width="70" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                    <DataGridTextColumn Header="Mã hàng" Binding="{Binding ItemCode}" Width="120" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                    <DataGridTextColumn Header="Tên hàng hóa" Binding="{Binding ItemName}" Width="*" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                    <DataGridTextColumn Header="ĐV tính" Binding="{Binding Unit}" Width="90" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                    <DataGridTextColumn Header="Kho" Binding="{Binding WarehouseCode}" Width="80" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                    <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, StringFormat={}{0:#,##0.####}}" Width="100" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat=N0}" Width="110" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding Amount, StringFormat=N0}" Width="130" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="132"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="PreviewPrintButton_Click"
                    Content="Xem trước in" />
            <Button Width="92"
                    Height="36"
                    IsDefault="True"
                    IsCancel="True"
                    Content="Đóng" />
        </StackPanel>

        <Border x:Name="PrintPreviewOverlay"
                Grid.RowSpan="3"
                Visibility="Collapsed"
                Background="#7A0F172A">
            <Grid Margin="40">
                <Border Background="White"
                        CornerRadius="12"
                        BorderBrush="#D5DFEB"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="12"
                                BorderBrush="#E2E8F0"
                                BorderThickness="0,0,0,1"
                                Background="#F8FAFC">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Xem trước in phiếu nhập"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#0F2747"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Width="90"
                                            Height="32"
                                            Margin="0,0,8,0"
                                            Click="OverlayPrintButton_Click"
                                            Content="In phiếu" />
                                    <Button Width="70"
                                            Height="32"
                                            Click="ClosePreviewOverlayButton_Click"
                                            Content="Đóng" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Padding="8">
                            <DocumentViewer x:Name="OverlayPreviewViewer" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
