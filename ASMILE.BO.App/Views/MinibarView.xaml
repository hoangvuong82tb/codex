<UserControl x:Class="ASMILE.BO.App.Views.MinibarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" Loaded="OnLoaded" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InvBoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:StringToBrushConverter x:Key="StringToBrush"/>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="68"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#16A34A"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#15803D"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#DC2626"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B91C1C"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ToolbarBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}"><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="0,0,6,4"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="ViewModeBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}"><Setter Property="Height" Value="30"/><Setter Property="Width" Value="54"/><Setter Property="Padding" Value="8,0"/><Setter Property="FontSize" Value="11"/></Style>

        <Style x:Key="FilterTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource FluentComboBox}">
            <Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="10,0,30,0"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Margin" Value="0,0,6,4"/>
        </Style>

        <Style x:Key="ModDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="RowHeight" Value="40"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="6,0"/>
            </Style></Setter.Value></Setter>
        </Style>

        <Style x:Key="InspectorTabBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="7,0"/><Setter Property="Margin" Value="0,0,2,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="PagerBtn" TargetType="Button" BasedOn="{StaticResource FluentPaginationButton}"><Setter Property="Foreground" Value="#475569"/><Setter Property="Margin" Value="2,0"/></Style>

        <Style x:Key="PagerPageBtn" TargetType="Button" BasedOn="{StaticResource FluentPaginationButton}">
            <Setter Property="Content" Value="{Binding Label}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="#2563EB"/><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                    <Setter Property="Width" Value="24"/><Setter Property="MinWidth" Value="24"/><Setter Property="MaxWidth" Value="24"/>
                    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SlidingDetailPanel" TargetType="Border" BasedOn="{StaticResource PanelCard}">
            <!-- Keep the inspector column reserved like Lost & Found.  When no room is selected,
                 the placeholder is shown instead of collapsing the card completely. -->
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>

        <DataTemplate x:Key="KpiCardTemplate" DataType="{x:Type vm:MinibarKpi}">
            <Border Background="{Binding BgColor, Converter={StaticResource StringToBrush}}" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,5" Width="110" Margin="0,0,6,4" Cursor="Hand" MouseLeftButtonDown="OnKpiClick" Tag="{Binding}">
                <StackPanel>
                    <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="Bold" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TreeItemTemplate" DataType="{x:Type vm:MinibarTreeItem}">
            <Border x:Name="TreeBorder" Padding="12,8" CornerRadius="8" Cursor="Hand" Margin="0,1" MouseLeftButtonDown="OnTreeItemClick" Tag="{Binding}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#475569"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Column="1" CornerRadius="10" Padding="6,1" MinWidth="24" HorizontalAlignment="Right">
                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F1F5F9"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger></Style.Triggers>
                        </Style></Border.Style>
                        <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" FontFamily="Segoe UI">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="TreeBorder" Property="Background" Value="#EFF6FF"/></DataTrigger></DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#3E83F3" Margin="0,0,14,0">
                        <TextBlock Text="MB" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Minibar Management Center" FontSize="21" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                        <TextBlock Text="Kiểm tra → Ghi nhận tiêu thụ → Supervisor duyệt → Post Folio → Check-out" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Xuất Excel" Style="{StaticResource ToolbarBtn}" Command="{Binding ExportExcelCommand}"/>
                    <Button Content="In" Style="{StaticResource ToolbarBtn}" Command="{Binding PrintReportCommand}"/>
                    <Button Content="Làm mới" Style="{StaticResource SecondaryBtn}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="16,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DashboardKpis}" ItemTemplate="{StaticResource KpiCardTemplate}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- TOOLBAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <WrapPanel>
                    <Button Content="Kiểm tra" Style="{StaticResource PrimaryBtn}" Command="{Binding OpenInspectFormCommand}" Margin="0,0,6,4"/>
                    <Button Content="Bổ sung" Style="{StaticResource ToolbarBtn}" Command="{Binding OpenRestockFormCommand}"/>
                    <Button Content="Kiểm kê" Style="{StaticResource ToolbarBtn}" Command="{Binding OpenInventoryFormCommand}"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>
                    <Button Content="Post Folio" Style="{StaticResource SuccessBtn}" Command="{Binding OpenPostFormCommand}" Margin="0,0,6,4"/>
                    <Button Content="Hủy Post" Style="{StaticResource DangerBtn}" Command="{Binding CancelPostCommand}" Margin="0,0,6,4"/>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Bảng" Command="{Binding SetGridViewCommand}" ToolTip="Xem dạng bảng"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ViewModeBtn}"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#64748B"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsGridView}" Value="True"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#3E83F3"/><Setter Property="BorderBrush" Value="#93C5FD"/></DataTrigger></Style.Triggers>
                    </Style></Button.Style></Button>
                    <Button Content="Thẻ" Command="{Binding SetCardViewCommand}" ToolTip="Xem dạng thẻ"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ViewModeBtn}"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#64748B"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsCardView}" Value="True"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#3E83F3"/><Setter Property="BorderBrush" Value="#93C5FD"/></DataTrigger></Style.Triggers>
                    </Style></Button.Style></Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTERS -->
        <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="16,8">
            <WrapPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="180" Margin="0,0,6,4"/>
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" Style="{StaticResource FilterCombo}" Width="120" Margin="0,0,6,4"/>
                <ComboBox ItemsSource="{Binding BuildingFilters}" SelectedItem="{Binding FilterBuilding}" Style="{StaticResource FilterCombo}" Width="70" Margin="0,0,6,4"/>
                <ComboBox ItemsSource="{Binding FloorFilters}" SelectedItem="{Binding FilterFloor}" Style="{StaticResource FilterCombo}" Width="70" Margin="0,0,6,4"/>
                <ComboBox ItemsSource="{Binding RoomTypeFilters}" SelectedItem="{Binding FilterRoomType}" Style="{StaticResource FilterCombo}" Width="80" Margin="0,0,6,4"/>
                <ComboBox ItemsSource="{Binding HousekeeperFilters}" SelectedItem="{Binding FilterHousekeeper}" Style="{StaticResource FilterCombo}" Width="120" Margin="0,0,6,4"/>
                <CheckBox IsChecked="{Binding FilterVipOnly}" Content="VIP" FontSize="12" VerticalAlignment="Center" Margin="4,0,8,0" FontFamily="Segoe UI"/>
                <CheckBox IsChecked="{Binding FilterPostedOnly}" Content="Đã Post" FontSize="12" VerticalAlignment="Center" Margin="4,0,8,0" FontFamily="Segoe UI"/>
                <CheckBox IsChecked="{Binding FilterUnpostedOnly}" Content="Chưa Post" FontSize="12" VerticalAlignment="Center" Margin="4,0,8,0" FontFamily="Segoe UI"/>
                <Button Content="Xóa lọc" Style="{StaticResource SecondaryBtn}" Command="{Binding ClearFiltersCommand}" Height="32" FontSize="11"/>
            </WrapPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

            <!-- LEFT TREE -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="8,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TreeItems}" ItemTemplate="{StaticResource TreeItemTemplate}"/>
                </ScrollViewer>
            </Border>

            <!-- CENTER -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="#EFF6FF" CornerRadius="8" Padding="10,6" Margin="10,8,10,0" Visibility="{Binding InfoMessage, Converter={StaticResource StringToVis}}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding InfoMessage}" FontSize="12" Foreground="#1E40AF" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        <Button Grid.Column="1" Content="×" Background="Transparent" BorderThickness="0" Foreground="#1E40AF" FontSize="16" FontWeight="SemiBold" Cursor="Hand" Click="OnDismissInfo"/>
                    </Grid>
                </Border>

                <!-- DATA GRID -->
                <ScrollViewer Grid.Row="0" Margin="10,8,10,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                    <DataGrid ItemsSource="{Binding FilteredRooms}" SelectedItem="{Binding SelectedRoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="OnDataGridSelectionChanged" Style="{StaticResource ModDataGrid}" MouseDoubleClick="OnDataGridDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Xem chi tiết" Command="{Binding SelectRoomCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
                                <MenuItem Header="Kiểm tra" Command="{Binding OpenInspectFormCommand}"/>
                                <MenuItem Header="Bổ sung" Command="{Binding OpenRestockFormCommand}"/>
                                <MenuItem Header="Post Folio" Command="{Binding OpenPostFormCommand}"/>
                                <MenuItem Header="Hủy Post" Command="{Binding CancelPostCommand}"/>
                                <Separator/><MenuItem Header="In" Command="{Binding PrintReportCommand}"/>
                                <MenuItem Header="Hồ sơ khách" Command="{Binding OpenGuestProfileCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomNumber}" Width="70"/>
                            <DataGridTextColumn Header="Khách" Binding="{Binding GuestName}" Width="130"/>
                            <DataGridTextColumn Header="Reservation" Binding="{Binding ReservationNumber}" Width="100"/>
                            <DataGridTextColumn Header="Housekeeper" Binding="{Binding Housekeeper}" Width="120"/>
                            <DataGridTextColumn Header="Kiểm tra" Binding="{Binding InspectionTime, StringFormat='{}{0:dd/MM HH:mm}'}" Width="100"/>
                            <DataGridTextColumn Header="Kiểm kê" Binding="{Binding InventoryDisplay}" Width="125"/>
                            <DataGridTextColumn Header="Số mặt hàng" Binding="{Binding ItemCount}" Width="80"/>
                            <DataGridTemplateColumn Header="Tiêu thụ" Width="110">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding ConsumptionDisplay}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#475569"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding HasConsumption}" Value="True"><Setter Property="Foreground" Value="#D97706"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Bổ sung" Binding="{Binding RestockDisplay}" Width="100"/>
                            <DataGridTemplateColumn Header="Posted" Width="80">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Border CornerRadius="10" Padding="6,2" Background="{Binding IsPosted, Converter={StaticResource StringToBrush}, ConverterParameter='true'}" >
                                        <TextBlock Text="{Binding PostedLabel}" FontSize="10" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="#16A34A"/>
                                    </Border>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Folio" Binding="{Binding FolioNumber}" Width="80"/>
                            <DataGridTextColumn Header="VAT" Binding="{Binding VatDisplay}" Width="95"/>
                            <DataGridTextColumn Header="Tổng" Binding="{Binding GrossDisplay}" Width="105"/>
                            <DataGridTemplateColumn Header="Trạng thái" Width="110">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Border CornerRadius="10" Padding="8,2" Background="{Binding StatusBg, Converter={StaticResource StringToBrush}}">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" FontFamily="Segoe UI"/>
                                    </Border>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Remark" Binding="{Binding Remark}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>

                <!-- CARD VIEW -->
                <ScrollViewer Grid.Row="0" Margin="10,8,10,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCardView, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding FilteredRooms}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:MinibarRoomDto}">
                            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,8,8" Width="260" Cursor="Hand" MouseLeftButtonDown="OnRoomCardClick" Tag="{Binding}">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding RoomNumber}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                                                <Border CornerRadius="4" Padding="4,1" Background="#FEF3C7" Margin="6,0,0,0" Visibility="{Binding IsVip, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="VIP" FontSize="9" FontWeight="Bold" Foreground="#D97706" FontFamily="Segoe UI"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding GuestName, TargetNullValue='—'}" FontSize="11" Foreground="#2563EB" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="10" Padding="8,2" Background="{Binding StatusBg, Converter={StaticResource StringToBrush}}">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" FontFamily="Segoe UI"/>
                                        </Border>
                                    </Grid>
                                    <Separator Margin="0,10" Background="#F1F5F9"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Tiêu thụ" FontSize="10" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                            <TextBlock Text="{Binding ConsumptionDisplay}" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#475569"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding HasConsumption}" Value="True"><Setter Property="Foreground" Value="#D97706"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style></TextBlock>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Trạng thái" FontSize="10" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                            <TextBlock Text="{Binding PostedLabel}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsPosted}" Value="True"><Setter Property="Foreground" Value="#16A34A"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style></TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding InspectionTime, StringFormat='Kiểm tra: {0:dd/MM HH:mm}', TargetNullValue='Chưa kiểm tra'}" FontSize="10" Foreground="#94A3B8" Margin="0,6,0,0" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="0" Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Đang tải..." FontSize="16" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                </Border>
            </Grid>

            <!-- RIGHT INSPECTOR -->
            <Border Grid.Column="2" Width="380" Margin="6,8,10,8" Style="{StaticResource SlidingDetailPanel}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedRoom.RoomNumber}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                                    <Border CornerRadius="4" Padding="4,1" Background="#FEF3C7" Margin="6,0,0,0" Visibility="{Binding SelectedRoom.IsVip, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="VIP" FontSize="9" FontWeight="Bold" Foreground="#D97706" FontFamily="Segoe UI"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedRoom.GuestName, TargetNullValue='—'}" FontSize="12" Foreground="#2563EB" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="×" Style="{StaticResource SecondaryBtn}" Width="30" Height="30" Padding="0" FontSize="16" FontWeight="SemiBold" ToolTip="Đóng chi tiết" Command="{Binding CloseDetailCommand}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="6,6" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Tổng quan" Click="OnDetailTabClick" Tag="0" Margin="0,0,2,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource InspectorTabBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="0"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style></Button>
                            <Button Content="Mặt hàng" Click="OnDetailTabClick" Tag="1" Margin="0,0,2,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource InspectorTabBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="1"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style></Button>
                            <Button Content="Charge" Click="OnDetailTabClick" Tag="2" Margin="0,0,2,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource InspectorTabBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="2"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style></Button>
                            <Button Content="Lịch sử" Click="OnDetailTabClick" Tag="3" Margin="0,0,2,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource InspectorTabBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="3"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style></Button>
                            <Button Content="Ghi chú" Click="OnDetailTabClick" Tag="4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource InspectorTabBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedDetailTab}" Value="4"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style></Button>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="22,16,22,16">
                            <!-- TAB 0: OVERVIEW -->
                            <StackPanel Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="THÔNG TIN PHÒNG" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Phòng" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRoom.RoomNumber}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Row="1" Text="Khách" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRoom.GuestName, TargetNullValue='—'}" FontSize="12" Foreground="#2563EB" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Row="2" Text="Reservation" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRoom.ReservationNumber, TargetNullValue='—'}" FontSize="12" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Row="3" Text="Arrival" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedRoom.ArrivalDate, StringFormat='{}{0:dd/MM/yyyy}', TargetNullValue='—'}" FontSize="12" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Row="4" Text="Departure" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedRoom.DepartureDate, StringFormat='{}{0:dd/MM/yyyy}', TargetNullValue='—'}" FontSize="12" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Row="5" Text="Housekeeper" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedRoom.Housekeeper, TargetNullValue='—'}" FontSize="12" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Row="6" Text="Supervisor" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedRoom.Supervisor, TargetNullValue='—'}" FontSize="12" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Row="7" Text="Kiểm tra" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedRoom.InspectionTime, StringFormat='{}{0:dd/MM HH:mm}', TargetNullValue='—'}" FontSize="12" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Row="8" Text="Trạng thái" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedRoom.StatusLabel}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                </Grid>
                                <Separator Margin="0,10" Background="#F1F5F9"/>
                                <WrapPanel>
                                    <Button Content="Mở hồ sơ khách" Style="{StaticResource SecondaryBtn}" Height="30" FontSize="11" Command="{Binding OpenGuestProfileCommand}" Margin="0,0,4,4"/>
                                    <Button Content="Mở Reservation" Style="{StaticResource SecondaryBtn}" Height="30" FontSize="11" Margin="0,0,4,4"/>
                                    <Button Content="Mở Folio" Style="{StaticResource SecondaryBtn}" Height="30" FontSize="11"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- TAB 1: ITEMS -->
                            <StackPanel Visibility="{Binding IsItemsTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="DANH SÁCH MINIBAR" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                                <ItemsControl ItemsSource="{Binding SelectedRoom.Items}">
                                    <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:MinibarLineItemDto}">
                                        <Border Padding="8,6" Margin="0,0,0,4" Background="#F8FAFC" CornerRadius="6">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding StandardQty, StringFormat='Chuẩn: {0}'}" FontSize="10" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                                        <TextBlock Text="{Binding RemainingQty, StringFormat=' | Còn: {0}'}" FontSize="10" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                                        <TextBlock FontSize="10" FontWeight="SemiBold" Margin="4,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#16A34A"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding Consumed, Mode=OneWay}" Value="0"><Setter Property="Foreground" Value="#94A3B8"/></DataTrigger></Style.Triggers>
                                                        </Style></TextBlock.Style><Run Text="{Binding Consumed, Mode=OneWay, StringFormat='Tiêu thụ: {0}'}"/></TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LineTotalDisplay}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" FontFamily="Segoe UI"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#475569"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding Consumed, Mode=OneWay}" Value="0"><Setter Property="Foreground" Value="#94A3B8"/></DataTrigger></Style.Triggers>
                                                    </Style></TextBlock.Style></TextBlock>
                                                    <TextBlock Text="{Binding VatDisplay}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" FontFamily="Segoe UI"/>
                                                    <TextBlock Text="{Binding LineGrossDisplay, StringFormat='Tổng: {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="#0F766E" HorizontalAlignment="Right" FontFamily="Segoe UI"/>
                                                    <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:N0} ₫/đv'}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- TAB 2: CHARGE -->
                            <StackPanel Visibility="{Binding IsChargeTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="THÔNG TIN CHARGE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                                <Border Background="#F8FAFC" CornerRadius="10" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                             <TextBlock Text="Tổng tiêu thụ" FontSize="12" FontFamily="Segoe UI"/><TextBlock Grid.Column="1" Text="{Binding SelectedRoom.ConsumptionDisplay}" FontSize="14" FontWeight="Bold" Foreground="#D97706" FontFamily="Segoe UI"/>
                                         </Grid>
                                         <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                             <TextBlock Text="VAT" FontSize="12" FontFamily="Segoe UI"/><TextBlock Grid.Column="1" Text="{Binding SelectedRoom.VatDisplay}" FontSize="12" FontFamily="Segoe UI"/>
                                         </Grid>
                                         <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                             <TextBlock Text="Tổng thanh toán" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/><TextBlock Grid.Column="1" Text="{Binding SelectedRoom.GrossDisplay}" FontSize="14" FontWeight="Bold" Foreground="#0F766E" FontFamily="Segoe UI"/>
                                         </Grid>
                                         <Separator Margin="0,8" Background="#E2E8F0"/>
                                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Post To" FontSize="12" FontFamily="Segoe UI"/><TextBlock Grid.Column="1" Text="{Binding SelectedRoom.PostTarget, TargetNullValue='—'}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                        </Grid>
                                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Folio" FontSize="12" FontFamily="Segoe UI"/><TextBlock Grid.Column="1" Text="{Binding SelectedRoom.FolioNumber, TargetNullValue='—'}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                        </Grid>
                                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Trạng thái" FontSize="12" FontFamily="Segoe UI"/><TextBlock Grid.Column="1" Text="{Binding SelectedRoom.PostedLabel}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding SelectedRoom.IsPosted}" Value="True"><Setter Property="Foreground" Value="#16A34A"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style></TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Button Content="Post Charge" Style="{StaticResource SuccessBtn}" Height="36" Margin="0,12,0,0" Command="{Binding OpenPostFormCommand}"/>
                            </StackPanel>

                            <!-- TAB 3: HISTORY -->
                            <StackPanel Visibility="{Binding IsHistoryTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="TIMELINE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                                <ItemsControl ItemsSource="{Binding RoomTimeline}">
                                    <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:MinibarTimelineEntry}">
                                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid><Border Width="10" Height="10" CornerRadius="5" Background="{Binding Color, Converter={StaticResource StringToBrush}}" Margin="0,2,0,0"/><Border Width="2" HorizontalAlignment="Center" Background="#E2E8F0" Margin="4,12,4,0" VerticalAlignment="Stretch"/></Grid>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Event}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="10" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#475569" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Separator Margin="0,10" Background="#E2E8F0"/>
                                <TextBlock Text="AUDIT LOG" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                                <ItemsControl ItemsSource="{Binding RoomAuditLog}">
                                    <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:MinibarAuditEntry}">
                                        <Border Padding="8,6" Margin="0,0,0,4" Background="#F8FAFC" CornerRadius="6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Action}" FontSize="11" FontWeight="SemiBold" Foreground="#3E83F3" FontFamily="Segoe UI"/><TextBlock Text="{Binding Actor, StringFormat=' — {0}'}" FontSize="10" Foreground="#64748B" FontFamily="Segoe UI"/></StackPanel>
                                                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#475569" FontFamily="Segoe UI" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="9" Foreground="#94A3B8" FontFamily="Segoe UI"/><TextBlock Text="{Binding Device, StringFormat=' • {0}'}" FontSize="9" Foreground="#94A3B8" FontFamily="Segoe UI"/></StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- TAB 4: REMARK -->
                            <StackPanel Visibility="{Binding IsRemarkTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="GHI CHÚ" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                                <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                                    <TextBlock Text="{Binding SelectedRoom.Remark, TargetNullValue='Không có ghi chú'}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="0" Grid.RowSpan="3" Background="White" Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="▯" FontSize="42" Foreground="#CBD5E1" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                            <TextBlock Text="Chọn một phòng" FontSize="15" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,10,0,0" FontFamily="Segoe UI"/>
                            <TextBlock Text="để xem thông tin minibar." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,3,0,0" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="5" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageDisplay}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    <Border CornerRadius="6" Padding="6,2" Margin="10,0,0,0" Background="#EFF6FF">
                        <TextBlock Text="Minibar" FontSize="11" Foreground="#2563EB" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x00AB;" Style="{StaticResource PagerBtn}" Command="{Binding FirstPageCommand}" IsEnabled="{Binding HasPrevPage}" ToolTip="Trang đầu"/>
                    <Button Content="&#x2039;" Style="{StaticResource PagerBtn}" Command="{Binding PrevPageCommand}" IsEnabled="{Binding HasPrevPage}" ToolTip="Trang trước"/>
                    <ItemsControl ItemsSource="{Binding PageButtons}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:MinibarPaginationButton}">
                            <Button Style="{StaticResource PagerPageBtn}" Command="{Binding DataContext.SetPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding PageNumber}"/>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="&#x203A;" Style="{StaticResource PagerBtn}" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" ToolTip="Trang sau"/>
                    <Button Content="&#x00BB;" Style="{StaticResource PagerBtn}" Command="{Binding LastPageCommand}" IsEnabled="{Binding HasNextPage}" ToolTip="Trang cuối"/>
                    <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemStringFormat="{}{0} / trang" Style="{StaticResource FluentComboBox}" Width="122" Height="32" MinWidth="0" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FORM OVERLAY -->
        <Border Grid.RowSpan="6" Background="#80000000" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Border Background="White" CornerRadius="14" MaxWidth="600" MaxHeight="700" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="14,14,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,14">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FormTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                                <Button Grid.Column="1" Content="×" Style="{StaticResource SecondaryBtn}" Width="30" Height="30" Padding="0" FontSize="16" FontWeight="SemiBold" Command="{Binding CloseFormCommand}"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12">
                            <StackPanel>
                                <Border Background="#FEF2F2" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" Visibility="{Binding FormErrorMessage, Converter={StaticResource StringToVis}}">
                                    <TextBlock Text="{Binding FormErrorMessage}" FontSize="12" Foreground="#DC2626" FontFamily="Segoe UI"/>
                                </Border>

                                <!-- INSPECT FORM -->
                                <StackPanel Visibility="{Binding IsInspectForm, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Housekeeper" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <ComboBox ItemsSource="{Binding HousekeeperFilters}" SelectedItem="{Binding InspectHousekeeper}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,10"/>
                                    <TextBlock Text="Supervisor" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <ComboBox ItemsSource="{Binding Supervisors}" SelectedItem="{Binding InspectSupervisor}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Ngày" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/><DatePicker SelectedDate="{Binding InspectDate}" Height="32" FontSize="12"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Giờ" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/><TextBox Text="{Binding InspectTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto"/></StackPanel>
                                    </Grid>
                                    <TextBlock Text="Ghi chú" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding InspectRemark, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,10"/>
                                </StackPanel>

                                <!-- RESTOCK FORM -->
                                <StackPanel Visibility="{Binding IsRestockForm, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Mặt hàng minibar" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <ComboBox ItemsSource="{Binding RestockItemOptions}" SelectedItem="{Binding SelectedRestockItem}" DisplayMemberPath="DisplayName" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,10"/>
                                    <TextBlock Text="Số lượng bổ sung" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding RestockQty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,10"/>
                                    <TextBlock Text="Kho xuất" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <ComboBox ItemsSource="{Binding WarehouseOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="WarehouseCode" SelectedValue="{Binding RestockWarehouse, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,10"/>
                                    <TextBlock Text="Người thực hiện" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <ComboBox ItemsSource="{Binding HousekeeperFilters}" SelectedItem="{Binding RestockBy}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,10"/>
                                    <TextBlock Text="Ghi chú" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding RestockRemark, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,10"/>
                                </StackPanel>

                                <!-- POST FORM -->
                                <StackPanel Visibility="{Binding IsPostForm, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Charge To" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <ComboBox ItemsSource="{Binding PostTargets}" SelectedItem="{Binding PostTarget}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,10"/>
                                    <TextBlock Text="Mã bút toán Folio (không bắt buộc)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding PostFolioNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,10"/>
                                    <TextBlock Text="Ghi chú" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding PostRemark, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,10"/>
                                </StackPanel>

                                <!-- INVENTORY FORM -->
                                <StackPanel Visibility="{Binding IsInventoryForm, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Mặt hàng kiểm kê" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="85"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding InventoryItemCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Margin="0,0,4,0" ToolTip="Mã hàng"/>
                                        <TextBox Grid.Column="1" Text="{Binding InventoryItemName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Margin="0,0,4,0" ToolTip="Tên hàng"/>
                                        <TextBox Grid.Column="2" Text="{Binding InventoryQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Margin="0,0,4,0" ToolTip="Số lượng"/>
                                        <TextBox Grid.Column="3" Text="{Binding InventoryUnitPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Margin="0,0,4,0" ToolTip="Đơn giá"/>
                                        <Button Grid.Column="4" Content="Thêm" Style="{StaticResource SecondaryBtn}" Command="{Binding AddInventoryLineCommand}"/>
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding InventoryLines}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" Height="150" Margin="0,0,0,10" Style="{StaticResource ModDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã" Binding="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                            <DataGridTextColumn Header="Mặt hàng" Binding="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                            <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                            <DataGridTemplateColumn Header="" Width="55">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Xóa" Padding="4,1" Command="{Binding DataContext.RemoveInventoryLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Ghi chú kiểm kê" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding InventoryRemark, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,10"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,14,14" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Hủy" Style="{StaticResource SecondaryBtn}" Width="90" Command="{Binding CloseFormCommand}" Margin="0,0,8,0"/>
                                <Button Content="Lưu" Width="90"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryBtn}"><Setter Property="Width" Value="90"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInspectForm}" Value="True"><Setter Property="Command" Value="{Binding SubmitInspectFormCommand}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsRestockForm}" Value="True"><Setter Property="Command" Value="{Binding SubmitRestockFormCommand}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsPostForm}" Value="True"><Setter Property="Command" Value="{Binding SubmitPostFormCommand}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsInventoryForm}" Value="True"><Setter Property="Command" Value="{Binding SubmitInventoryFormCommand}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style></Button.Style></Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
