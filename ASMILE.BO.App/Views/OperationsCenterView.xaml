                  <Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsTelemetryTabPerformance}" Value="True"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Content="Khuy&#7871;n ngh&#7883;" Command="{Binding NavigateTelemetrySubTabCommand}" CommandParameter="4" Height="30" MinWidth="120" FontSize="12" Margin="0,0,4,4" Padding="12,0" Cursor="Hand" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1">
