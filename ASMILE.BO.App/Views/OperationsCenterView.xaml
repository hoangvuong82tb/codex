                  <Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsTelemetryTabAll}" Value="True"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style>
