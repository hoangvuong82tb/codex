              <DataGrid Grid.Row="1" Style="{StaticResource EnterpriseModuleDataGrid}" IsReadOnly="True" Margin="0,0,0,8" ItemsSource="{Binding SelectedWorkflowReplaySession.Steps}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="B&#432;&#7899;c" Width="180" Binding="{Binding StepName}" />
                  <DataGridTextColumn Header="Tr&#7841;ng th&#225;i" Width="90" Binding="{Binding Status, Converter={StaticResource StatusDisplay}, ConverterParameter=status}" />
                  <DataGridTextColumn Header="B&#7855;t &#273;&#7847;u" Width="130" Binding="{Binding StartedAtUtc, StringFormat=dd/MM HH:mm:ss}" />
                  <DataGridTextColumn Header="Ho&#224;n t&#7845;t" Width="130" Binding="{Binding CompletedAtUtc, StringFormat=dd/MM HH:mm:ss}" />
                  <DataGridTextColumn Header="L&#7895;i" Width="*" Binding="{Binding ErrorMessage, Converter={StaticResource StatusDisplay}, ConverterParameter=message}" />
                </DataGrid.Columns>
              </DataGrid>
              <DataGrid Grid.Row="2" Style="{StaticResource EnterpriseModuleDataGrid}" IsReadOnly="True" ItemsSource="{Binding SelectedWorkflowReplaySession.Metrics}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Ch&#7881; s&#7889;" Width="180" Binding="{Binding MetricName}" />
                  <DataGridTextColumn Header="Nh&#243;m" Width="120" Binding="{Binding Category}" />
                  <DataGridTextColumn Header="M&#7913;c &#273;&#7897;" Width="90" Binding="{Binding Severity}" />
                  <DataGridTextColumn Header="Th&#7901;i l&#432;&#7907;ng" Width="90" Binding="{Binding DurationMs}" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
        </TabControl>
      </controls:EnterpriseStatePresenter.StateContent>
    </controls:EnterpriseStatePresenter>
    <TextBlock Grid.Row="3" Style="{StaticResource CaptionTextStyle}" Margin="2,10,0,0" Text="{Binding StatusMessage}" />
  </Grid>
</UserControl>
