                    <DataGridTextColumn Header="&#272;&#7889;i t&#432;&#7907;ng" Width="140" Binding="{Binding EntityName, Converter={StaticResource StatusDisplay}, ConverterParameter=module}" />
                    <DataGridTextColumn Header="H&#7871;t h&#7841;n" Width="70" Binding="{Binding ExpiredCount}" />
