                    <DataGridTextColumn Header="Th&#7901;i gian" Width="135" Binding="{Binding TimeText}"/>
                    <DataGridTextColumn Header="T&#225;c v&#7909;" Width="200" Binding="{Binding OperationName}"/>
                    <DataGridTextColumn Header="Th&#7901;i l&#432;&#7907;ng" Width="100" Binding="{Binding DurationDisplay}"/>
                    <DataGridTextColumn Header="Module" Width="150" Binding="{Binding ModuleDisplay}"/>
                    <DataGridTextColumn Header="M&#7913;c &#273;&#7897;" Width="100" Binding="{Binding SeverityDisplay}"/>
                    <DataGridTextColumn Header="Th&#244;ng b&#225;o" Width="*" Binding="{Binding MessageDisplay}"/>
                  </DataGrid.Columns>
                </DataGrid>
                <DataGrid Visibility="{Binding IsTelemetryTabErrors, Converter={StaticResource B2V}}" Style="{StaticResource EnterpriseModuleDataGrid}" IsReadOnly="True" ItemsSource="{Binding RuntimeErrorDisplayItems}">
