                    <DataGridTextColumn Header="Th&#7901;i gian" Width="135" Binding="{Binding TimeText}"/>
                    <DataGridTextColumn Header="Lo&#7841;i s&#7921; ki&#7879;n" Width="130" Binding="{Binding EventTypeDisplay}"/>
                    <DataGridTextColumn Header="Module" Width="140" Binding="{Binding ModuleDisplay}"/>
                    <DataGridTextColumn Header="T&#225;c v&#7909;" Width="160" Binding="{Binding OperationName}"/>
                    <DataGridTextColumn Header="Th&#7901;i l&#432;&#7907;ng" Width="85" Binding="{Binding DurationDisplay}"/>
                    <DataGridTextColumn Header="M&#7913;c &#273;&#7897;" Width="100" Binding="{Binding SeverityDisplay}"/>
                    <DataGridTextColumn Header="Tr&#7841;ng th&#225;i" Width="110" Binding="{Binding StatusDisplay}"/>
                    <DataGridTextColumn Header="Th&#244;ng b&#225;o" Width="*" Binding="{Binding MessageDisplay}"/>
