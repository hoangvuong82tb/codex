                <DataGrid Visibility="{Binding IsTelemetryTabSlow, Converter={StaticResource B2V}}" Style="{StaticResource EnterpriseModuleDataGrid}" IsReadOnly="True" ItemsSource="{Binding SlowOperationDisplayItems}">
