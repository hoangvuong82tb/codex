                  <DataGridTextColumn Header="T&#7841;m d&#7915;ng" Width="80" Binding="{Binding IsPaused}" />
                </DataGrid.Columns>
              </DataGrid>
              <DataGrid Grid.Row="1" Grid.Column="1" Style="{StaticResource EnterpriseModuleDataGrid}" IsReadOnly="True" ItemsSource="{Binding JobExecutions}" SelectedItem="{Binding SelectedJobExecution}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="V&#224;o h&#224;ng &#273;&#7907;i" Width="125" Binding="{Binding QueuedAtUtc, StringFormat=dd/MM HH:mm:ss}" />
