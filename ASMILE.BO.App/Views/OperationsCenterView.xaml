                </Button>
              </WrapPanel>
              <Grid Grid.Row="3" MinHeight="300">
                <DataGrid Visibility="{Binding IsTelemetryTabAll, Converter={StaticResource B2V}}" Style="{StaticResource EnterpriseModuleDataGrid}" IsReadOnly="True" ItemsSource="{Binding TelemetryDisplayItems}">
