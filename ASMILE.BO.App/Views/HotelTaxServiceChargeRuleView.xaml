<UserControl x:Class="ASMILE.BO.App.Views.HotelTaxServiceChargeRuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource HotelSettingsButtonBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/></Style>
        <Style x:Key="SettingsTextBox" TargetType="TextBox" BasedOn="{StaticResource HotelSettingsTextBoxBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="SettingsComboBox" TargetType="ComboBox" BasedOn="{StaticResource HotelSettingsComboBoxBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,0"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/></Style>
    </UserControl.Resources>
    <Grid Background="Transparent" Margin="0,0,0,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Padding="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Thuế &amp; phí dịch vụ" FontSize="22" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Cấu hình tỷ lệ, phạm vi áp dụng, làm tròn và mapping tài chính theo cơ sở." Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Làm mới" Command="{Binding LoadCommand}" Style="{StaticResource SettingsButton}"/><Button Content="+ Thêm cấu hình" Command="{Binding NewItemCommand}" Style="{StaticResource SettingsPrimaryButton}" Margin="0"/></StackPanel></Grid></Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Từ khóa" Grid.Column="0" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBlock Text="Loại" Grid.Column="1" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" ToolTip="Tìm theo mã, tên hoặc dịch vụ"/><ComboBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKindFilter}" Style="{StaticResource SettingsComboBox}"/><Button Grid.Row="1" Grid.Column="3" Content="Tìm" Command="{Binding SearchCommand}" Style="{StaticResource SettingsButton}" Margin="8,0,0,0"/></Grid></Border>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
            <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="False"><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#F8FAFC" CornerRadius="10" ClipToBounds="True" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="Mã" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/><TextBlock Grid.Column="1" Text="Loại" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/><TextBlock Grid.Column="2" Text="Tên / dịch vụ" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/><TextBlock Grid.Column="3" Text="Tỷ lệ" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/></Grid></Border><ListBox ItemContainerStyle="{StaticResource HotelSettingsListBoxItemStyle}" HorizontalContentAlignment="Stretch" Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="#475569"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding Name}" Foreground="#17365D"/><TextBlock Text="{Binding ApplicableService}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="3" Text="{Binding Rate, StringFormat={}{0:0.####}%}" Foreground="#17365D"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
            <Border Grid.Column="1" Margin="16,0,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16"><StackPanel><StackPanel><TextBlock Text="Chi tiết thuế/phí dịch vụ" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="{Binding SelectedSummary}" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/><StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Loại" Foreground="#475569"/><ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" Style="{StaticResource SettingsComboBox}" Margin="0,4,0,10"/><TextBlock Text="Mã" Foreground="#475569"/><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,10"/><TextBlock Text="Tên" Foreground="#475569"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,10"/><TextBlock Text="Tỷ lệ (%)" Foreground="#475569"/><TextBox Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,10"/><CheckBox Content="Đã bao gồm trong giá (Inclusive)" IsChecked="{Binding IsInclusive}" Margin="0,0,0,10"/><TextBlock Text="Dịch vụ áp dụng" Foreground="#475569"/><TextBox Text="{Binding ApplicableService, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,10"/><TextBlock Text="Rate plan áp dụng (tuỳ chọn)" Foreground="#475569"/><TextBox Text="{Binding ApplicableRatePlan, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,10"/><TextBlock Text="Quy tắc làm tròn" Foreground="#475569"/><TextBox Text="{Binding RoundingMode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,10"/><TextBlock Text="Mapping BO" Foreground="#475569"/><TextBox Text="{Binding AccountingMapping, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,10"/><TextBlock Text="Hiệu lực từ / đến" Foreground="#475569"/><Grid Margin="0,4,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding EffectiveFrom, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}"/><TextBox Grid.Column="2" Text="{Binding EffectiveTo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}"/></Grid><TextBlock Text="Mô tả" Foreground="#475569"/><TextBox Style="{StaticResource HotelSettingsTextBoxBase}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="58" TextWrapping="Wrap" AcceptsReturn="True" Padding="10,8" BorderBrush="#D7E2F0" Margin="0,4,0,14"/><StackPanel Orientation="Horizontal"><Button Content="Hủy" Command="{Binding CancelEditCommand}" Style="{StaticResource SettingsButton}"/><Button Content="Lưu" Command="{Binding SaveCommand}" Style="{StaticResource SettingsPrimaryButton}" Margin="0"/></StackPanel></StackPanel><StackPanel Visibility="{Binding IsReadOnlyPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Loại" Foreground="#64748B" Margin="0,0,0,3"/><TextBlock Text="{Binding SelectedKindLabel}" Foreground="#17365D" FontWeight="SemiBold"/><TextBlock Text="Trạng thái" Foreground="#64748B" Margin="0,14,0,3"/><TextBlock Text="{Binding SelectedStatus}" Foreground="#17365D" FontWeight="SemiBold"/><TextBlock Text="Workspace này lưu dữ liệu thật theo property, có hiệu lực, rowversion và audit; không dùng danh mục mô tả chung." Foreground="#64748B" TextWrapping="Wrap" Margin="0,14,0,16"/><StackPanel Orientation="Horizontal"><Button Content="Sửa" Command="{Binding EditItemCommand}" Style="{StaticResource SettingsPrimaryButton}"/><Button Content="Bật / tạm ngưng" Command="{Binding ToggleActiveCommand}" Style="{StaticResource SettingsButton}" Margin="0"/></StackPanel></StackPanel><Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap"/></Border><Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0" Visibility="{Binding HasInfo, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding InfoMessage}" Foreground="#166534" TextWrapping="Wrap"/></Border></StackPanel></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>



