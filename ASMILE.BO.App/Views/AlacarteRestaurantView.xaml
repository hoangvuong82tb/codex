                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="10,8" Background="#FBFDFF" Effect="{StaticResource CardShadow}">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding OccurredAt, StringFormat=HH:mm}" FontSize="12" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/>
                              <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <!-- TAB 1: KHU VỰC / PHÒNG BÀN -->
        <Grid Visibility="{Binding IsRoomsTab, Converter={StaticResource B2V}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

          <!-- Header -->
          <Border Grid.Row="0" Padding="18,14,18,0"><StackPanel>
            <TextBlock Text="PHÒNG PHỤC VỤ" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Chọn phòng để mở đơn — phục vụ theo phòng, món giống nhau các bàn" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/></StackPanel></Border>

          <!-- Search + filter -->
          <Grid Grid.Row="1" Margin="18,10,18,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel Grid.Row="0">
              <Button Content="Tất cả" Margin="0,0,8,8" Height="34" MinWidth="60" Padding="14,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                      Command="{Binding SelectFloorCommand}">
                <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#CBD5E1"/>
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border></ControlTemplate></Setter.Value></Setter>
                  <Style.Triggers><DataTrigger Binding="{Binding SelectedFloor}" Value=""><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <ItemsControl ItemsSource="{Binding Floors}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Content="{Binding .}" Margin="0,0,8,8" Height="34" MinWidth="70" Padding="14,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                          Command="{Binding DataContext.SelectFloorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding .}">
                    <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#CBD5E1"/>
                      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border></ControlTemplate></Setter.Value></Setter></Style></Button.Style></Button>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></WrapPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal">
              <DatePicker SelectedDate="{Binding SelectedDate}" Style="{StaticResource EnterpriseModuleDatePicker}" Height="36" Width="140" FontSize="12" Margin="0,0,8,0"/>
              <Border CornerRadius="10" Background="White" BorderBrush="#D5E1EF" BorderThickness="1" Height="36" Padding="10,0" Width="220">
                <TextBox Text="{Binding TableSearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="4,0" FontSize="12" Foreground="#64748B"/></Border>
              <ComboBox ItemsSource="{Binding TableStatusFilterOptions}" SelectedItem="{Binding TableStatusFilter}" Style="{StaticResource EnterpriseModuleComboBox}" Height="36" MinWidth="150" FontSize="12" Margin="8,0,0,0"/></StackPanel></Grid>

          <!-- Room count -->
          <TextBlock Grid.Row="2" Margin="18,6,18,0" FontSize="11" Foreground="#94A3B8"><Run Text="{Binding FilteredRooms.Count, Mode=OneWay}"/><Run Text=" phòng"/></TextBlock>

          <!-- Empty state -->
          <Border Grid.Row="3" Padding="40" Visibility="{Binding FilteredRooms.Count, Converter={StaticResource InvBool}, FallbackValue=Visible}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#CBD5E1" HorizontalAlignment="Center"/><TextBlock Text="Chưa có phòng nào." FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>

          <!-- Room cards -->
          <ScrollViewer x:Name="RoomCardsScroller" Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="14,4,8,8" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <ItemsControl ItemsSource="{Binding FilteredRooms}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Margin="4" Width="180" Height="140" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                        Command="{Binding DataContext.SelectRoomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        MouseDoubleClick="RoomCard_MouseDoubleClick">
                  <Button.ContextMenu><ContextMenu>
                    <MenuItem Header="Mở phòng"
                              Command="{Binding PlacementTarget.Tag.OpenRoomInOrdersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                      <MenuItem.Style><Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Status}" Value="Occupied"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="Serving"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="Reserved"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                      </Style></MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="Xem chi tiết"
                              Command="{Binding PlacementTarget.Tag.OpenRoomInOrdersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                      <MenuItem.Style><Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Status}" Value="Occupied"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="Serving"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="Reserved"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                      </Style></MenuItem.Style>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Hủy / xóa đơn phòng"
                              Command="{Binding PlacementTarget.Tag.CancelRoomOrderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                  </ContextMenu></Button.ContextMenu>
                  <Button.Style><Style TargetType="Button">
                      <Setter Property="BorderBrush" Value="#CBD5E1"/>
                      <Setter Property="BorderThickness" Value="1"/>
                      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                        <Border x:Name="card" CornerRadius="14" BorderThickness="{TemplateBinding BorderThickness}" Padding="14,14" Background="#F8FAFC" BorderBrush="{TemplateBinding BorderBrush}">
                          <StackPanel><Border HorizontalAlignment="Right" Width="8" Height="8" CornerRadius="4" Background="#64748B" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Margin="0,4,0,0"><Run Text="{Binding TableCount, StringFormat={}{0} bàn}" FontSize="12" Foreground="#64748B"/><Run Text=" · " Foreground="#CBD5E1"/><Run Text="{Binding Capacity, StringFormat={}{0} khách}" FontSize="12" Foreground="#64748B"/></TextBlock>
                            <TextBlock Text="{Binding Status, FallbackValue=Trống}" FontWeight="Bold" FontSize="14" Foreground="#475569" Margin="0,8,0,0"/></StackPanel></Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="#F1F5F9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Status}" Value="Available"><Setter Property="BorderBrush" Value="#BBF7D0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                        <Border x:Name="card" CornerRadius="14" BorderThickness="{TemplateBinding BorderThickness}" Padding="14,14" Background="#EFFDF5" BorderBrush="{TemplateBinding BorderBrush}">
                          <StackPanel><Border HorizontalAlignment="Right" Width="8" Height="8" CornerRadius="4" Background="#16A34A" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Margin="0,4,0,0"><Run Text="{Binding TableCount, StringFormat={}{0} bàn}" FontSize="12" Foreground="#64748B"/><Run Text=" · " Foreground="#CBD5E1"/><Run Text="{Binding Capacity, StringFormat={}{0} khách}" FontSize="12" Foreground="#64748B"/></TextBlock>
                            <TextBlock Text="Trống" FontWeight="Bold" FontSize="14" Foreground="#16A34A" Margin="0,8,0,0"/></StackPanel></Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="#DCFCE7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Reserved"><Setter Property="BorderBrush" Value="#FED7AA"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                        <Border x:Name="card" CornerRadius="14" BorderThickness="{TemplateBinding BorderThickness}" Padding="14,14" Background="#FFF7ED" BorderBrush="{TemplateBinding BorderBrush}">
                          <StackPanel><Border HorizontalAlignment="Right" Width="8" Height="8" CornerRadius="4" Background="#F59E0B" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Margin="0,4,0,0"><Run Text="{Binding TableCount, StringFormat={}{0} bàn}" FontSize="12" Foreground="#64748B"/><Run Text=" · " Foreground="#CBD5E1"/><Run Text="{Binding Capacity, StringFormat={}{0} khách}" FontSize="12" Foreground="#64748B"/></TextBlock>
                            <TextBlock Text="Đã đặt" FontWeight="Bold" FontSize="14" Foreground="#F59E0B" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding BookingSummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="#9A3412" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="#FED7AA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Serving"><Setter Property="BorderBrush" Value="#FECACA"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                        <Border x:Name="card" CornerRadius="14" BorderThickness="{TemplateBinding BorderThickness}" Padding="14,14" Background="#FEF2F2" BorderBrush="{TemplateBinding BorderBrush}">
                          <StackPanel><Border HorizontalAlignment="Right" Width="8" Height="8" CornerRadius="4" Background="#DC2626" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Margin="0,4,0,0"><Run Text="{Binding TableCount, StringFormat={}{0} bàn}" FontSize="12" Foreground="#64748B"/><Run Text=" · " Foreground="#CBD5E1"/><Run Text="{Binding Capacity, StringFormat={}{0} khách}" FontSize="12" Foreground="#64748B"/></TextBlock>
                            <TextBlock Text="Đang phục vụ" FontWeight="Bold" FontSize="14" Foreground="#DC2626" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ServingSummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="#991B1B" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="#FEE2E2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Occupied"><Setter Property="BorderBrush" Value="#FECACA"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                        <Border x:Name="card" CornerRadius="14" BorderThickness="{TemplateBinding BorderThickness}" Padding="14,14" Background="#FFF1F2" BorderBrush="{TemplateBinding BorderBrush}">
                          <StackPanel><Border HorizontalAlignment="Right" Width="8" Height="8" CornerRadius="4" Background="#EA580C" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Margin="0,4,0,0"><Run Text="{Binding TableCount, StringFormat={}{0} bàn}" FontSize="12" Foreground="#64748B"/><Run Text=" · " Foreground="#CBD5E1"/><Run Text="{Binding Capacity, StringFormat={}{0} khách}" FontSize="12" Foreground="#64748B"/></TextBlock>
                            <TextBlock Text="Đang phục vụ" FontWeight="Bold" FontSize="14" Foreground="#EA580C" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ServingSummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="#9A3412" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="#FFE4E6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Locked"><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                        <Border x:Name="card" CornerRadius="14" BorderThickness="{TemplateBinding BorderThickness}" Padding="14,14" Background="#F8FAFC" BorderBrush="{TemplateBinding BorderBrush}">
                          <StackPanel><Border HorizontalAlignment="Right" Width="8" Height="8" CornerRadius="4" Background="#64748B" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding RoomName}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Margin="0,4,0,0"><Run Text="{Binding Name}" FontSize="12" Foreground="#64748B"/><Run Text=" · " Foreground="#CBD5E1"/><Run Text="{Binding SeatCount, StringFormat={}{0} người}" FontSize="12" Foreground="#64748B"/></TextBlock>
                            <TextBlock Text="Khóa" FontWeight="Bold" FontSize="14" Foreground="#475569" Margin="0,8,0,0"/></StackPanel></Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="#F1F5F9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></DataTrigger>
                      <!-- Selected state: blue border highlight -->
                      <DataTrigger Value="True">
                        <DataTrigger.Binding>
                          <MultiBinding Converter="{StaticResource EqConv}">
                            <Binding Path="Id"/>
                            <Binding Path="DataContext.SelectedRoom.Id" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                          </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                        <Setter Property="BorderThickness" Value="2"/>
                      </DataTrigger>
                    </Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>

        <!-- TAB 2: BÁO GIÁ -->
        <Grid Visibility="{Binding IsReservationsTab, Converter={StaticResource B2V}}" Background="Transparent"
              Height="{Binding ViewportHeight, ElementName=MainScrollViewer}">
          <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
          <!-- Customer info card -->
          <Border Grid.Row="0" Grid.Column="0" Margin="18,8,8,8" Background="White" BorderBrush="#DBE6F3" BorderThickness="1" CornerRadius="14" Padding="14,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="Th&#x00F4;ng tin kh&#x00E1;ch" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                <TextBlock Text="Kh&#x00E1;ch h&#x00E0;ng" Style="{StaticResource KpiLabel}"/>
                <TextBox Text="{Binding ReservationCustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="34" FontSize="12" Margin="0,2,0,8"/>
                <TextBlock Text="S&#x0110;T" Style="{StaticResource KpiLabel}"/>
                <TextBox Text="{Binding ReservationPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="34" FontSize="12" Margin="0,2,0,8"/>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="S&#x1ED1; b&#x00E0;n" Style="{StaticResource KpiLabel}"/>
                    <TextBox Text="{Binding ReservationGuestCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="34" FontSize="12" Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="S&#x1ED1; ng&#x01B0;&#x1EDD;i/b&#x00E0;n" Style="{StaticResource KpiLabel}"/>
                    <TextBox Text="{Binding QuoteGuestsPerTable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="34" FontSize="12" Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="Su&#x1EA5;t l&#x1EBB;" Style="{StaticResource KpiLabel}"/>
                    <TextBox Text="{Binding QuoteOddServingText, Mode=OneWay}" Style="{StaticResource EnterpriseModuleTextBox}" Height="34" FontSize="12" Margin="0,2,0,0" IsReadOnly="True" Background="#F8FAFC" Foreground="#0F172A"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="T&#x1ED5;ng s&#x1ED1; kh&#x00E1;ch" Style="{StaticResource KpiLabel}"/>
                <TextBox Text="{Binding QuoteGuestCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="34" FontSize="12" Margin="0,2,0,8"/>
                <TextBlock Text="Ph&#x00F2;ng" Style="{StaticResource KpiLabel}"/>
                <ComboBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" DisplayMemberPath="Name" Style="{StaticResource EnterpriseModuleComboBox}" Height="34" Margin="0,2,0,8"/>
                <TextBlock Text="Ng&#x00E0;y &#x0111;&#x1EB7;t" Style="{StaticResource KpiLabel}"/>
                <DatePicker SelectedDate="{Binding QuoteDate}" Height="34" FontSize="11" VerticalContentAlignment="Center" Margin="0,2,0,8"/>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="T&#x1EEB;" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding QuoteStartTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="34" FontSize="11" Margin="0,2,0,0"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="&#x0110;&#x1EBF;n" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding QuoteEndTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="34" FontSize="11" Margin="0,2,0,0"/></StackPanel>
                </Grid>
                <Button Content="L&#x01B0;u" Tag="&#xE74E;" Style="{StaticResource ActionPrimaryBtn}" Height="36" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
<!-- LEFT: Sub-tab bar (fixed) -->
          <Border Grid.Row="0" Grid.Column="1" Margin="8,8,8,8" Background="White" BorderBrush="#DBE6F3" BorderThickness="1" CornerRadius="14" Padding="12,10" ClipToBounds="True">
          <Grid Background="Transparent">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Height="32" VerticalAlignment="Top">
            <Button Content="Chọn món" Command="{Binding NavigateQuoteSubTabCommand}" CommandParameter="0" Margin="0,0,10,0"><Button.Style><Style TargetType="Button"><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Padding" Value="0,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsQuoteFoodTab}" Value="True"><Setter Property="Foreground" Value="#2563EB"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <Button Content="Dịch vụ kèm" Command="{Binding NavigateQuoteSubTabCommand}" CommandParameter="1" Margin="0,0,10,0"><Button.Style><Style TargetType="Button"><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Padding" Value="0,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsQuoteServiceTab}" Value="True"><Setter Property="Foreground" Value="#2563EB"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <Button Content="Menu có sẵn" Command="{Binding NavigateQuoteSubTabCommand}" CommandParameter="2"><Button.Style><Style TargetType="Button"><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Padding" Value="0,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsQuotePackageTab}" Value="True"><Setter Property="Foreground" Value="#2563EB"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          </StackPanel>

          <!-- LEFT: Scrollable content -->
          <!-- LEFT: Scrollable content - no outer ScrollViewer, each tab has its own scroll -->
          <Grid Grid.Row="1" Margin="0,4,0,0" Background="Transparent">
              <!-- TAB: Chọn món -->
              <Grid Visibility="{Binding IsQuoteFoodTab, Converter={StaticResource B2V}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Grid.Row="0" CornerRadius="10" Background="White" BorderBrush="#D5E1EF" BorderThickness="1" Height="36" Padding="10,0" Margin="0,0,0,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBox Grid.Column="1" Text="{Binding MenuSearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12" Foreground="#64748B"/></Grid></Border>
              <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,6">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <ComboBox Grid.Column="0" ItemsSource="{Binding QuoteMenuCategories}" SelectedItem="{Binding SelectedMenuCategory}" DisplayMemberPath="Name" Style="{StaticResource EnterpriseModuleComboBox}" Height="30" FontSize="11"/>
                  <ComboBox Grid.Column="2" ItemsSource="{Binding MenuSortModes}" SelectedItem="{Binding SelectedMenuSortMode}" Style="{StaticResource EnterpriseModuleComboBox}" Height="30" FontSize="11"/>
                </Grid>
              </Border><TextBlock Grid.Row="2" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"><Run Text="{Binding QuoteMenuTotalCount, Mode=OneWay}"/><Run Text=" món"/></TextBlock>
              <ScrollViewer x:Name="QuoteFoodScrollViewer" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
              <ItemsControl ItemsSource="{Binding PagedQuoteMenuItems}" PreviewMouseWheel="ItemsControl_PreviewMouseWheel"><ItemsControl.ItemTemplate><DataTemplate>
