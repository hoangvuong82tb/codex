                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                  </ControlTemplate></Setter.Value></Setter>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOrderServiceTab}" Value="True">
                      <Setter Property="Background" Value="#0078D4"/>
                      <Setter Property="BorderBrush" Value="#0078D4"/>
                      <Setter Property="Foreground" Value="White"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Thông tin" Command="{Binding NavigateOrderDetailTabCommand}" CommandParameter="4" Margin="0,0,6,0" Padding="12,6" Cursor="Hand" FontSize="12" FontWeight="SemiBold">
