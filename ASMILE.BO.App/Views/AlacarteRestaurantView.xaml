                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="12"/>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="12" Padding="10,8" VerticalAlignment="Top">
                                  <StackPanel>
                                    <TextBlock Text="{Binding ReservationDateTime, StringFormat=dd/M}" FontSize="18" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ReservationDateTime, StringFormat=HH:mm}" FontSize="10" FontWeight="SemiBold" Foreground="#991B1B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                  </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="2">
                                  <TextBlock Text="{Binding CustomerName, TargetNullValue='Khách vãng lai'}" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                  <TextBlock FontSize="11" Foreground="#334155" Margin="0,5,0,0">
                                    <Run Text="{Binding GuestCount, StringFormat={}{0} khách}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding TableName, TargetNullValue='Chưa chốt bàn'}"/>
                                  </TextBlock>
                                  <TextBlock Text="{Binding Phone, TargetNullValue='—'}" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
