                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="LỊCH ĐẶT PHÒNG" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock FontSize="12" Foreground="#64748B" Margin="0,4,0,0">
                      <Run Text="{Binding SelectedRoom.Name, TargetNullValue='Chưa chọn phòng'}" FontWeight="SemiBold" Foreground="#2563EB"/>
                      <Run Text=" · "/>
                      <Run Text="{Binding SelectedRoom.Status, TargetNullValue='—'}"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0">
