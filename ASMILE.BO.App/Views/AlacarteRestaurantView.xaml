            <Border CornerRadius="10" Background="White" BorderBrush="#D5E1EF" BorderThickness="1" Height="36" Padding="10,0" Width="240">
              <TextBox Text="{Binding SelectedOrderSearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12" Foreground="#0F172A"/>
            </Border>
            <TextBlock Text="{Binding FilteredOpenOrders.Count, StringFormat={}{0} đơn mở}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0"/>
          </StackPanel>

          <!-- Order + room table list -->
          <Grid Grid.Row="1" Margin="14,4,8,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DBE6F3" BorderThickness="1" CornerRadius="14" Effect="{StaticResource CardShadow}">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="14,12" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Danh sách đơn mở" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/><TextBlock Text="{Binding FilteredOpenOrders.Count, StringFormat=  ({0})}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/></StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                  <Grid>
                    <ItemsControl ItemsSource="{Binding FilteredOpenOrders}"><ItemsControl.ItemTemplate><DataTemplate>
                      <Border CornerRadius="12" Padding="10,8" Margin="4,4,4,6" Cursor="Hand">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#DBE6F3"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                              <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                  <MultiBinding Converter="{StaticResource EqConv}">
                                    <Binding Path="DataContext.SelectedOrder.OrderNo" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="OrderNo"/>
                                  </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="BorderThickness" Value="2"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Border.InputBindings><MouseBinding Command="{Binding DataContext.SelectOpenOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MouseAction="LeftClick"/></Border.InputBindings>
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                          </Grid.RowDefinitions>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Border Width="36" Height="36" CornerRadius="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="#FEF2F2"/>
                                <Style.Triggers>
                                  <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                      <MultiBinding Converter="{StaticResource EqConv}">
                                          <Binding Path="DataContext.SelectedOrder.OrderNo" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                          <Binding Path="OrderNo"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="#DBEAFE"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="#DC2626"/>
                                  <Style.Triggers>
                                    <DataTrigger Value="True">
                                      <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource EqConv}">
                                          <Binding Path="DataContext.SelectedOrder.OrderNo" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                          <Binding Path="OrderNo"/>
                                        </MultiBinding>
                                      </DataTrigger.Binding>
                                      <Setter Property="Foreground" Value="#2563EB"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Border>
                          <StackPanel Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding OrderNo}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                              <TextBlock Text=" · " Foreground="#CBD5E1"/>
                              <TextBlock Text="{Binding RoomName}" FontSize="13" Foreground="#2563EB" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                              <TextBlock Text="{Binding CustomerName, TargetNullValue='—'}" FontSize="12" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text=" · " Foreground="#CBD5E1"/>
                              <TextBlock Text="{Binding GuestCount, StringFormat={}{0} khách}" FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0} đ}" FontWeight="Bold" FontSize="14" Foreground="#DC2626" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                              <Button Width="22" Height="22" Padding="0"
                                      Command="{Binding DataContext.CancelOpenOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"
                                      Background="#DC2626" Foreground="White" BorderBrush="#DC2626" BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                  <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                      <TextBlock Text="X" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                  </ControlTemplate>
                                </Button.Template>
                              </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#DC2626" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Border Padding="34" Visibility="{Binding FilteredOpenOrders.Count, Converter={StaticResource B2V}, FallbackValue=Collapsed}"><StackPanel HorizontalAlignment="Center"><TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#CBD5E1" HorizontalAlignment="Center"/><TextBlock Text="Không có đơn đang mở" FontWeight="SemiBold" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
                  </Grid>
                </ScrollViewer>
              </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#DBE6F3" BorderThickness="1" CornerRadius="14" Effect="{StaticResource CardShadow}">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="14,12" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Bàn của phòng" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                      <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0"><Run Text="{Binding SelectedOrderRoomDisplayName, Mode=OneWay, TargetNullValue='Chọn đơn để xem bàn'}"/><Run Text=" · "/><Run Text="{Binding SelectedOrderRoomTableCount, Mode=OneWay}"/><Run Text=" bàn"/></TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="Số cột" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <ItemsControl ItemsSource="{Binding OpenOrderTableColumnOptions}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Content="{Binding}" Width="28" Height="28" Margin="0,0,2,0" Padding="0"
                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                    Command="{Binding DataContext.SetOpenOrderTableColumnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                              <Button.Style>
                                <Style TargetType="Button">
                                  <Setter Property="Background" Value="#F3F3F3"/>
                                  <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                  <Setter Property="BorderThickness" Value="1"/>
                                  <Setter Property="Foreground" Value="#616161"/>
                                  <Setter Property="Template">
                                    <Setter.Value>
                                      <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="6">
                                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                      </ControlTemplate>
                                    </Setter.Value>
                                  </Setter>
                                  <Style.Triggers>
                                    <DataTrigger Value="True">
                                      <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource EqConv}">
                                          <Binding Path="DataContext.OpenOrderTableColumnCount" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                          <Binding/>
                                        </MultiBinding>
                                      </DataTrigger.Binding>
                                      <Setter Property="Background" Value="#0078D4"/>
                                      <Setter Property="BorderBrush" Value="#0078D4"/>
                                      <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18,22,22" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                  <StackPanel>
                    <Border Margin="12,10,12,12" Padding="14,12" CornerRadius="14" BorderThickness="1" BorderBrush="#FCD34D" Background="#FFFBEB" Cursor="Hand"
                            MouseLeftButtonDown="SummaryTableCard_MouseLeftButtonDown"
                            Visibility="{Binding HasSelectedOrder, Converter={StaticResource B2V}}">
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock FontSize="15" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis">
                          <Run Text="BÀN TỔNG"/>
                          <Run Text=" - " Foreground="#94A3B8"/>
                          <Run Text="{Binding SelectedOrderAreaDisplayName, Mode=OneWay, TargetNullValue='—'}"/>
                          <Run Text=" - " Foreground="#94A3B8"/>
                          <Run Text="{Binding SelectedOrderRoomDisplayName, Mode=OneWay, TargetNullValue='—'}"/>
                        </TextBlock>
                        <Ellipse Grid.Column="1" Width="8" Height="8" Fill="#3B82F6" VerticalAlignment="Center" Margin="8,0,0,0"/>

                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <TextBlock Grid.ColumnSpan="2" FontSize="13" Foreground="#2563EB" FontWeight="SemiBold">
                            <Run Text="{Binding SelectedOrder.Status, TargetNullValue='Đang phục vụ'}"/>
                          </TextBlock>
                          <StackPanel Grid.Row="1" Margin="0,10,10,0">
                            <TextBlock FontSize="12" Foreground="#475569"><Run Text="Khách hàng: "/><Run Text="{Binding SelectedOrder.CustomerName, TargetNullValue='—'}" FontWeight="SemiBold" Foreground="#0F172A"/></TextBlock>
                            <TextBlock FontSize="12" Foreground="#475569" Margin="0,4,0,0"><Run Text="SĐT: "/><Run Text="{Binding SelectedOrder.CustomerPhone, TargetNullValue='—'}" FontWeight="SemiBold" Foreground="#0F172A"/></TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,10,0,0">
                            <TextBlock FontSize="12" Foreground="#475569"><Run Text="Tổng khách: "/><Run Text="{Binding SelectedOrder.GuestCount, TargetNullValue=0}" FontWeight="SemiBold" Foreground="#0F172A"/></TextBlock>
                            <TextBlock FontSize="12" Foreground="#475569" Margin="0,4,0,0">
                              <Run Text="Giờ phục vụ: "/>
                              <Run Text="{Binding SelectedOrder.StartTime, TargetNullValue='—'}" FontWeight="SemiBold" Foreground="#0F172A"/>
                              <Run Text=" - "/>
                              <Run Text="{Binding SelectedOrder.EndTime, TargetNullValue='—'}" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </TextBlock>
                          </StackPanel>
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,64,0,0" FontSize="12" Foreground="#F97316" FontWeight="Bold" HorizontalAlignment="Right">
                            <Run Text="{Binding SelectedOrder.TotalAmount, StringFormat={}{0:N0} đ, TargetNullValue='0 đ'}"/>
                          </TextBlock>
                        </Grid>

                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding SelectedOrder.OrderNo, TargetNullValue='—'}"/>
                          </TextBlock>
                          <TextBlock Grid.Column="1" FontSize="11" Foreground="#94A3B8" Margin="10,0,0,0">
                            <Run Text="{Binding SelectedOrderRoomTableCount, Mode=OneWay}"/><Run Text=" bàn"/>
                          </TextBlock>
                        </Grid>
                      </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding SelectedOrderDetailTables}" Margin="0,6,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="{Binding DataContext.OpenOrderTableColumnCount, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Margin="6" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch" HorizontalAlignment="Center" VerticalAlignment="Top"
                                  MouseDoubleClick="RoomTableCard_MouseDoubleClick"
                                  Command="{Binding DataContext.SelectOpenOrderTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Border x:Name="RoomTableCard" Width="154" Height="120" BorderThickness="1" CornerRadius="14" Padding="12,10">
                              <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
                              </Border.Effect>
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="#F8FAFC"/>
                                  <Setter Property="BorderBrush" Value="#D6E4F5"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Serving">
                                      <Setter Property="Background" Value="#EFF6FF"/>
                                      <Setter Property="BorderBrush" Value="#9CC2FF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Đang phục vụ">
                                      <Setter Property="Background" Value="#EFF6FF"/>
                                      <Setter Property="BorderBrush" Value="#9CC2FF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Trống">
                                      <Setter Property="Background" Value="#F1FDF5"/>
                                      <Setter Property="BorderBrush" Value="#A7F3C0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Bàn chờ">
                                      <Setter Property="Background" Value="#FFF7ED"/>
                                      <Setter Property="BorderBrush" Value="#FDBA74"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center" Margin="8,0,0,0">
                                  <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                      <Setter Property="Fill" Value="#94A3B8"/>
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Serving">
                                          <Setter Property="Fill" Value="#3B82F6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Đang phục vụ">
                                          <Setter Property="Fill" Value="#3B82F6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Trống">
                                          <Setter Property="Fill" Value="#22C55E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Bàn chờ">
                                          <Setter Property="Fill" Value="#F59E0B"/>
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Ellipse.Style>
                                </Ellipse>

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0" FontSize="13">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                      <Setter Property="Text" Value="{Binding Status}"/>
                                      <Setter Property="Foreground" Value="#64748B"/>
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Serving">
                                          <Setter Property="Foreground" Value="#2563EB"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Đang phục vụ">
                                          <Setter Property="Foreground" Value="#2563EB"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Trống">
                                          <Setter Property="Foreground" Value="#15803D"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Bàn chờ">
                                          <Setter Property="Foreground" Value="#C2410C"/>
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>

                                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0">
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                  <StackPanel>
                                    <TextBlock FontSize="11" Foreground="#F97316" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                      <Run Text="{Binding TableAmount, StringFormat={}{0:N0} đ}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding RoomName}"/>
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding Status}" Value="Serving">
                                            <Setter Property="Text" Value="{Binding DataContext.SelectedOrder.OrderNo, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding Status}" Value="Đang phục vụ">
                                            <Setter Property="Text" Value="{Binding DataContext.SelectedOrder.OrderNo, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                    </TextBlock>
                                  </StackPanel>
                                  <TextBlock Grid.Column="1" FontSize="11" Foreground="#94A3B8" Margin="10,0,0,0">
                                    <Run Text="{Binding SeatCount}"/><Run Text=" chỗ"/>
                                  </TextBlock>
                                </Grid>
                              </Grid>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- TAB 4: DS BÁO GIÁ -->
        <Grid Visibility="{Binding IsContractsTab, Converter={StaticResource B2V}}" Height="{Binding ViewportHeight, ElementName=MainScrollViewer}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>

          <!-- LEFT: Danh sách báo giá -->
          <Border Grid.Column="0" Background="White" BorderBrush="#DBE6F3" BorderThickness="1" CornerRadius="14" Margin="0,0,8,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <!-- Header -->
              <Border Grid.Row="0" Padding="16,14" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <TextBlock Text="DANH SÁCH BÁO GIÁ" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/></Border>
              <!-- Search -->
              <Border Grid.Row="1" Padding="10,8" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <TextBox Text="{Binding QuoteSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="30" FontSize="12"/>
              </Border>
              <!-- Tab filter row -->
              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,10,10,6">
                <Button Content="Đã duyệt" Style="{StaticResource ActionBtn}" Height="30" FontSize="11" Margin="0,0,3,0"
                        Command="{Binding SwitchQuoteListTabCommand}" CommandParameter="0"
                        Background="{Binding QuoteListTabIndex, Converter={StaticResource QuoteTabBgConverter}, ConverterParameter=0}"
                        Foreground="{Binding QuoteListTabIndex, Converter={StaticResource QuoteTabFgConverter}, ConverterParameter=0}"
                        BorderBrush="{Binding QuoteListTabIndex, Converter={StaticResource QuoteTabBrConverter}, ConverterParameter=0}"/>
                <Button Content="Chưa duyệt" Style="{StaticResource ActionBtn}" Height="30" FontSize="11" Margin="3,0,3,0"
                        Command="{Binding SwitchQuoteListTabCommand}" CommandParameter="1"
                        Background="{Binding QuoteListTabIndex, Converter={StaticResource QuoteTabBgConverter}, ConverterParameter=1}"
                        Foreground="{Binding QuoteListTabIndex, Converter={StaticResource QuoteTabFgConverter}, ConverterParameter=1}"
                        BorderBrush="{Binding QuoteListTabIndex, Converter={StaticResource QuoteTabBrConverter}, ConverterParameter=1}"/>
                <Button Content="Đang phục vụ" Style="{StaticResource ActionBtn}" Height="30" FontSize="11" Margin="3,0,3,0"
                        Command="{Binding SwitchQuoteListTabCommand}" CommandParameter="2"
                        Background="{Binding QuoteListTabIndex, Converter={StaticResource QuoteTabBgConverter}, ConverterParameter=2}"
                        Foreground="{Binding QuoteListTabIndex, Converter={StaticResource QuoteTabFgConverter}, ConverterParameter=2}"
                        BorderBrush="{Binding QuoteListTabIndex, Converter={StaticResource QuoteTabBrConverter}, ConverterParameter=2}"/>
                <Button Content="Đã phục vụ" Style="{StaticResource ActionBtn}" Height="30" FontSize="11" Margin="3,0,0,0"
                        Command="{Binding SwitchQuoteListTabCommand}" CommandParameter="3"
                        Background="{Binding QuoteListTabIndex, Converter={StaticResource QuoteTabBgConverter}, ConverterParameter=3}"
                        Foreground="{Binding QuoteListTabIndex, Converter={StaticResource QuoteTabFgConverter}, ConverterParameter=3}"
                        BorderBrush="{Binding QuoteListTabIndex, Converter={StaticResource QuoteTabBrConverter}, ConverterParameter=3}"/>
              </StackPanel>
              <!-- Quote cards -->
              <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
              <Grid>
              <ItemsControl ItemsSource="{Binding QuotePager.Items}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{Binding CardBackground}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="10,8,10,0" Cursor="Hand">
                  <Border.InputBindings><MouseBinding Command="{Binding DataContext.SelectSavedQuoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MouseAction="LeftClick"/></Border.InputBindings>
                  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding QuoteNo}" FontWeight="Bold" FontSize="13" Foreground="{Binding QuoteNoBrush}"/><TextBlock Text=" · " Foreground="#CBD5E1"/><TextBlock Text="{Binding CustomerName}" FontSize="12" Foreground="#475569"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Border Background="{Binding TagBackground}" BorderBrush="{Binding TagBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Visibility="{Binding HasWorkflowTag, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding ApprovalTagText}" FontSize="10" FontWeight="Bold" Foreground="{Binding TagForeground}"/>
                      </Border>
                      <Button Width="22" Height="22" Margin="6,0,0,0"
                              Background="#DC2626" Foreground="White" BorderBrush="#DC2626"
                              BorderThickness="1" Cursor="Hand"
                              Command="{Binding DataContext.DeleteQuoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              Visibility="{Binding CanDelete, Converter={StaticResource B2V}}">
                        <Button.Template><ControlTemplate TargetType="Button">
                          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="1" CornerRadius="4">
                            <TextBlock Text="X" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                        </ControlTemplate></Button.Template>
                      </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="{Binding EventDate, StringFormat=dd/MM}" FontSize="11" Foreground="#94A3B8"/><TextBlock Text=" · " Foreground="#CBD5E1"/><TextBlock Text="{Binding RoomName}" FontSize="11" Foreground="#2563EB"/></StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="{Binding TotalAmount, StringFormat={}{0:N0} đ}" FontWeight="Bold" FontSize="14" Foreground="{Binding AmountBrush}"/>
                  </Grid></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <Border Padding="40" Visibility="{Binding QuotePager.Items.Count, Converter={StaticResource B2V}, FallbackValue=Collapsed}"><TextBlock FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"><Run Text="Không có báo giá "/><Run Text="{Binding QuoteListTabIndex, Converter={StaticResource QuoteTabLabelConverter}}"/></TextBlock></Border>
              </Grid>
              </ScrollViewer>
              <!-- Pager -->
              <Border Grid.Row="4" Padding="18,14" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Background="White" Visibility="{Binding HasFilteredSavedQuotes, Converter={StaticResource B2V}, FallbackValue=Visible}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#475569" Text="{Binding QuotePager.PageText}"/>
                  <controls:TablePagerControl Grid.Column="1" DataContext="{Binding QuotePager}"/>
                </Grid>
              </Border>
            </Grid></Border>

          <!-- CENTER: Chi tiết báo giá -->
          <Border Grid.Column="1" Background="White" BorderBrush="#DBE6F3" BorderThickness="1" CornerRadius="14" Margin="8,0,8,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- Fixed header -->
            <Grid Grid.Row="0" Margin="12,12,12,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock FontSize="15" FontWeight="Bold" Foreground="{Binding SelectedSavedQuote.QuoteNoBrush, TargetNullValue=#0F172A}"><Run Text="{Binding SelectedSavedQuote.QuoteNo, TargetNullValue='Chọn báo giá'}"/></TextBlock>
                <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"><Run Text="Người BG: "/><Run Text="{Binding SelectedSavedQuote.PreparedBy, TargetNullValue='—'}"/></TextBlock>
              </StackPanel>
              <Border Grid.Column="1" Background="{Binding SelectedSavedQuote.TagBackground}" BorderBrush="{Binding SelectedSavedQuote.TagBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Top" Visibility="{Binding SelectedSavedQuote.HasWorkflowTag, Converter={StaticResource B2V}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding SelectedSavedQuote.ApprovalTagText}" FontSize="11" FontWeight="Bold" Foreground="{Binding SelectedSavedQuote.TagForeground}"/>
              </Border>
            </Grid>

            <!-- Fixed customer info -->
            <Border Grid.Row="1" Margin="12,8,12,0" Background="#F8FAFC" CornerRadius="8" Padding="8,7">
              <StackPanel>
                <TextBlock FontSize="11" Foreground="#64748B"><Run Text="Khách: "/><Run Text="{Binding SelectedSavedQuote.CustomerName, TargetNullValue='—'}" FontWeight="SemiBold" Foreground="#0F172A"/></TextBlock>
                <TextBlock FontSize="10" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"><Run Text="SĐT: "/><Run Text="{Binding SelectedSavedQuote.Phone, TargetNullValue='—'}"/><Run Text="  ·  "/><Run Text="{Binding SelectedSavedQuote.TableCount, StringFormat={}{0} bàn, FallbackValue=0}"/><Run Text="  ·  "/><Run Text="{Binding SelectedSavedQuote.GuestCount, StringFormat={}{0} khách, FallbackValue=0}"/><Run Text="  ·  Chuẩn bàn "/><Run Text="{Binding SelectedSavedQuote.TableStandard, FallbackValue=10}"/><Run Text="  ·  "/><Run Text="{Binding SelectedSavedQuote.RoomName, TargetNullValue='—'}" Foreground="#2563EB"/></TextBlock>
                <TextBlock FontSize="10" Foreground="#64748B" Margin="0,2,0,0"><Run Text="Ngày: "/><Run Text="{Binding SelectedSavedQuote.EventDate, StringFormat=dd/MM/yyyy, TargetNullValue='—'}"/><Run Text="  "/><Run Text="{Binding SelectedSavedQuote.StartTime, TargetNullValue='—'}"/><Run Text=" - "/><Run Text="{Binding SelectedSavedQuote.EndTime, TargetNullValue='—'}"/></TextBlock></StackPanel></Border>

            <!-- Scrollable items -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12,8,12,0" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <StackPanel>
              <TextBlock Text="BÀN PHỤC VỤ" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,6"/>
              <ItemsControl ItemsSource="{Binding CurrentQuoteTables}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#F8FAFC" BorderBrush="#DBE6F3" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,6,6">
                      <TextBlock FontSize="10" Foreground="#334155">
                        <Run Text="{Binding DisplayName}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding GuestCount}"/>
                        <Run Text=" khách"/>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="MÓN ĂN" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,6"/>
              <Border Background="#EFF6FF" CornerRadius="7,7,0,0" Padding="6,5">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="72"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Tên món" FontSize="9" FontWeight="Bold" Foreground="#2563EB"/>
                  <TextBlock Grid.Column="1" Text="SL" FontSize="9" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="Đơn giá" FontSize="9" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="Th.tiền" FontSize="9" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                </Grid>
              </Border>
              <Border BorderBrush="#DBEAFE" BorderThickness="1,0,1,1" CornerRadius="0,0,7,7" Margin="0,0,0,10">
                <ItemsControl ItemsSource="{Binding SelectedSavedFoodLines}"><ItemsControl.ItemTemplate><DataTemplate>
                  <Border BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="6,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="72"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding PricingRule}" FontSize="9" Foreground="#64748B" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                      <TextBlock Text="{Binding EffectiveQuantityDisplay, StringFormat=x{0}}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding Quantity, StringFormat=Gốc x{0}}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding Total, StringFormat={}{0:N0} đ}" FontWeight="SemiBold" FontSize="10" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </Border>

              <TextBlock Text="DỊCH VỤ" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" Margin="0,2,0,6"/>
              <Border Background="#F0FDFA" CornerRadius="7,7,0,0" Padding="6,5">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="72"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Tên dịch vụ" FontSize="9" FontWeight="Bold" Foreground="#0F766E"/>
                  <TextBlock Grid.Column="1" Text="SL" FontSize="9" FontWeight="Bold" Foreground="#0F766E" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="Đơn giá" FontSize="9" FontWeight="Bold" Foreground="#0F766E" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="Th.tiền" FontSize="9" FontWeight="Bold" Foreground="#0F766E" HorizontalAlignment="Right"/>
                </Grid>
              </Border>
              <Border BorderBrush="#CCFBF1" BorderThickness="1,0,1,1" CornerRadius="0,0,7,7">
                <ItemsControl ItemsSource="{Binding SelectedSavedServiceLines}"><ItemsControl.ItemTemplate><DataTemplate>
                  <Border BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="6,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="72"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding PricingRule}" FontSize="9" Foreground="#64748B" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                      <TextBlock Text="{Binding EffectiveQuantityDisplay, StringFormat=x{0}}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding Quantity, StringFormat=Gốc x{0}}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding Total, StringFormat={}{0:N0} đ}" FontWeight="SemiBold" FontSize="10" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </Border>
            </StackPanel></ScrollViewer>

            <!-- Fixed total + buttons -->
            <StackPanel Grid.Row="3" Margin="12,8,12,12">
              <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Tạm tính" FontSize="11" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding QuoteBaseAmount, StringFormat={}{0:N0} đ}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A"/></Grid>
              <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Giảm giá" FontSize="11" Foreground="#DC2626"/><TextBlock Grid.Column="1" Text="{Binding QuoteDiscountDisplay, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" Foreground="#DC2626"/></Grid>
              <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Đặt cọc" FontSize="11" Foreground="#16A34A"/><TextBlock Grid.Column="1" Text="{Binding QuoteDepositDisplay, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" Foreground="#16A34A"/></Grid>
              <Border Background="#FFF7ED" CornerRadius="8" Padding="10,8" Margin="0,4,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="TỔNG CỘNG" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/><TextBlock Text="{Binding QuoteRemainingAmount, StringFormat=Còn lại: {0:N0} đ}" FontSize="10" Foreground="#EA580C"/></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding QuoteFinalAmount, StringFormat={}{0:N0} đ}" FontWeight="Bold" FontSize="18" Foreground="#DC2626" VerticalAlignment="Center"/></Grid></Border>
              <!-- Edit mode buttons (quotes not yet served/paid) -->
              <Grid Visibility="{Binding SelectedSavedQuote.IsReadOnly, Converter={StaticResource InvBool}, FallbackValue=Visible}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Content="Sửa" Style="{StaticResource ActionBtn}" Height="34" FontSize="11" Margin="0,0,4,0"
                        Command="{Binding EditSavedQuoteCommand}" CommandParameter="{Binding SelectedSavedQuote}"/><Button Grid.Column="1" Content="Lưu" Style="{StaticResource ActionPrimaryBtn}" Height="34" FontSize="11" Margin="2,0,2,0"
                        Command="{Binding SaveSelectedQuoteDetailsCommand}"/>
                <Button Grid.Column="2" Content="Duyệt" Style="{StaticResource ActionGreenBtn}" Height="34" FontSize="11" Margin="2,0,2,0"
                        Command="{Binding ApproveQuoteCommand}" CommandParameter="{Binding SelectedSavedQuote}"/>
                <Button Grid.Column="3" Content="Xóa" Style="{StaticResource ActionRedBtn}" Height="34" FontSize="11" Margin="2,0,2,0"
                        Command="{Binding DeleteQuoteCommand}" CommandParameter="{Binding SelectedSavedQuote}"
                        Visibility="{Binding SelectedSavedQuote.CanDelete, Converter={StaticResource B2V}, FallbackValue=Collapsed}"/>
                <Button Grid.Column="4" Content="Xem/In" Style="{StaticResource ActionBtn}" Height="34" FontSize="11" Margin="4,0,0,0" Command="{Binding PrintQuoteCommand}"/>
              </Grid>
              <!-- Read-only mode buttons (served/paid quotes) -->
              <Grid Visibility="{Binding SelectedSavedQuote.IsReadOnly, Converter={StaticResource B2V}, FallbackValue=Collapsed}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Content="Sao chép" Style="{StaticResource ActionPrimaryBtn}" Height="40" FontSize="13" Margin="0,0,6,0"
                        Command="{Binding CopySavedQuoteCommand}" CommandParameter="{Binding SelectedSavedQuote}"/>
                <Button Grid.Column="1" Content="Xem/In" Style="{StaticResource ActionBtn}" Height="40" FontSize="13" Margin="6,0,0,0" Command="{Binding PrintQuoteCommand}"/>
              </Grid></StackPanel></Grid></Border>

          <!-- RIGHT: Bổ sung chi tiết -->
          <Border Grid.Column="2" Background="White" BorderBrush="#DBE6F3" BorderThickness="1" CornerRadius="14" Margin="8,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <StackPanel Margin="16,14">
              <TextBlock Text="BỔ SUNG CHI TIẾT" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,4"/>
              <TextBlock Text="Hoàn thiện thông tin báo giá trước khi gửi khách" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,14"/>

              <!-- 1. THANH TOÁN -->
              <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="THANH TOÁN" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,8"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Đặt cọc" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding QuoteDeposit, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Style="{StaticResource EnterpriseModuleTextBox}" Height="34"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Còn lại" Style="{StaticResource KpiLabel}"/><TextBox Style="{StaticResource EnterpriseModuleTextBox}" Height="34" Background="#F1F5F9" IsReadOnly="True" Text="Tự động tính"/></StackPanel></Grid>
                  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Phương thức TT" Style="{StaticResource KpiLabel}"/><ComboBox ItemsSource="{Binding QuotePaymentMethodOptions}" SelectedItem="{Binding QuotePaymentMethod}" Style="{StaticResource EnterpriseModuleComboBox}" Height="34"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="TK nhận thanh toán" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding QuoteBankAccount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="34"/></StackPanel></Grid>
                </StackPanel></Border>

              <!-- 2. GIẢM GIÁ & KHUYẾN MẠI -->
              <Border Background="#FFFBEB" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="GIẢM GIÁ &amp; KHUYẾN MẠI" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,8"/>
                  <TextBlock Text="Giảm giá" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding QuoteDiscount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Style="{StaticResource EnterpriseModuleTextBox}" Height="34" Margin="0,0,0,8"/>
                  <TextBlock Text="Khuyến mại / Quà tặng" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding QuotePromotion, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel></Border>

              <!-- 3. ĐIỀU KHOẢN -->
              <Border Background="#EFF6FF" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="ĐIỀU KHOẢN" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,8"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="HL báo giá (ngày)" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding QuoteValidityDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="34"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,4,0"><TextBlock Text="Hủy trước (ngày)" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding QuoteCancelDeadlineDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="34"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Phí hủy (%)" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding QuoteCancelFeePercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="34"/></StackPanel></Grid>
                </StackPanel></Border>

              <!-- 4. GHI CHÚ -->
              <Border Background="#F0FDF4" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="GHI CHÚ &amp; YÊU CẦU" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,8"/>
                  <TextBlock Text="Yêu cầu đặc biệt (dị ứng, ăn chay, trang trí...)" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding QuoteNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="56" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel></Border>

              <!-- 5. TRẠNG THÁI -->
              <Border Background="#F5F3FF" CornerRadius="8" Padding="12,10">
                <StackPanel>
                  <TextBlock Text="TRẠNG THÁI" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,8"/>
                  <ComboBox ItemsSource="{Binding QuoteStatusOptions}" SelectedItem="{Binding QuoteStatus}" Style="{StaticResource EnterpriseModuleComboBox}" Height="34"/></StackPanel></Border>
            </StackPanel></ScrollViewer></Border>
        </Grid>

        <!-- TAB 5: DỊCH VỤ -->
        <Grid Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

          <!-- Header -->
          <Border Grid.Row="0" Padding="16,14,16,0"><StackPanel>
            <TextBlock Text="DỊCH VỤ &amp; MÓN ĂN" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Chọn món và dịch vụ để thêm vào đơn hiện tại" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/></StackPanel></Border>

          <!-- Sub-tab bar -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,10,16,0">
            <Button Content="Món ăn" Command="{Binding NavigateServicesSubTabCommand}" CommandParameter="0" Margin="0,0,14,0"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Padding" Value="0,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsServicesFoodTab}" Value="True"><Setter Property="Foreground" Value="#2563EB"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <Button Content="Dịch vụ" Command="{Binding NavigateServicesSubTabCommand}" CommandParameter="1"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Padding" Value="0,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsServicesSvcTab}" Value="True"><Setter Property="Foreground" Value="#2563EB"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          </StackPanel>

          <!-- Sub-tab content -->

          <!-- MÓN ĂN sub-tab -->
          <Grid Grid.Row="2" Visibility="{Binding IsServicesFoodTab, Converter={StaticResource B2V}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- Search + Sort + View mode -->
            <Grid Grid.Row="0" Margin="16,10,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox Text="{Binding MenuSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" FontSize="12" Padding="10,0"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding MenuSortModes}" SelectedItem="{Binding SelectedMenuSortMode}" Style="{StaticResource EnterpriseModuleComboBox}" Height="36" MinWidth="120" FontSize="11" Margin="8,0,0,0"/>
              <ComboBox Grid.Column="2" ItemsSource="{Binding MenuViewModes}" SelectedItem="{Binding SelectedMenuViewMode}" Style="{StaticResource EnterpriseModuleComboBox}" Height="36" MinWidth="110" FontSize="11" Margin="8,0,0,0"/></Grid>

            <!-- Category chips -->
            <WrapPanel Grid.Row="1" Margin="16,8,16,0">
              <Button Content="Tất cả" Margin="0,0,8,0" Height="34" MinWidth="60" Padding="14,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                      Command="{Binding SelectMenuCategoryCommand}">
                <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#CBD5E1"/>
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border></ControlTemplate></Setter.Value></Setter>
                  <Style.Triggers><DataTrigger Binding="{Binding SelectedMenuCategory}" Value="{x:Null}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <ItemsControl ItemsSource="{Binding MenuCategories}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Content="{Binding Name}" Margin="0,0,8,0" Height="34" MinWidth="60" Padding="14,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                        Command="{Binding DataContext.SelectMenuCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                  <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#CBD5E1"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border></ControlTemplate></Setter.Value></Setter></Style></Button.Style></Button>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></WrapPanel>

            <!-- Count -->
            <TextBlock Grid.Row="2" Margin="16,6,16,0" FontSize="11" Foreground="#94A3B8"><Run Text="{Binding QuoteMenuTotalCount, Mode=OneWay}"/><Run Text=" món"/></TextBlock>

            <!-- Grid view -->
            <ScrollViewer x:Name="MenuGridScroller" Grid.Row="3" Margin="16,4,16,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsMenuViewGrid, Converter={StaticResource B2V}}" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
              <ItemsControl ItemsSource="{Binding FilteredMenuItems}" PreviewMouseWheel="ItemsControl_PreviewMouseWheel"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border Width="184" Margin="0,0,10,10" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10" Cursor="Hand">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Border Grid.Row="0" Background="#FFF7ED" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                          <Image Source="{Binding DisplayImageSource}" Stretch="UniformToFill" Visibility="{Binding HasImage, Converter={StaticResource B2V}}"/>
                          <Border Background="#FFF7ED" Visibility="{Binding HasNoImage, Converter={StaticResource B2V}}"><TextBlock Text="{Binding Emoji}" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
                      <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="34"/>
                      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding Code}" FontSize="10" Foreground="#94A3B8"/><Border CornerRadius="4" Padding="4,1" Margin="6,0,0,0" Background="#ECFDF3"><TextBlock Text="{Binding StatusBadge}" FontSize="9" Foreground="#15803D" FontWeight="SemiBold"/></Border></StackPanel>
                      <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}" FontWeight="Bold" FontSize="14" Foreground="#EA580C"/>
                        <Button Grid.Column="1" Width="76" Height="34" Content="Thêm" Tag="&#xE710;" FontSize="11" FontWeight="SemiBold" Style="{StaticResource ActionPrimaryBtn}"/></Grid></Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>

            <!-- List view -->
            <ListBox Grid.Row="3" ItemsSource="{Binding FilteredMenuItems}" BorderThickness="0" Background="Transparent" Margin="16,4,16,8" Visibility="{Binding IsMenuViewList, Converter={StaticResource B2V}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
