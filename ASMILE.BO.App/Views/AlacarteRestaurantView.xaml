                      </Grid>
                      <Border Background="#FFF7ED" CornerRadius="8" Padding="10,8" Margin="0,4,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel><TextBlock Text="Còn lại" FontSize="12" FontWeight="Bold" Foreground="#EA580C"/></StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.RemainingAmount, StringFormat={}{0:N0} đ}" FontSize="16" FontWeight="Bold" Foreground="#EA580C"/>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- PRINT HISTORY TAB -->
          <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="16,0,16,8" Visibility="{Binding IsOrderPrintHistoryTab, Converter={StaticResource B2V}}"><StackPanel>
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
              <StackPanel>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Lịch sử phiếu bếp / bar" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Theo dõi từng lần gửi món, phiếu tăng giảm và điều chỉnh sau khi đã lên bếp/bar." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="999" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedOrderPreparationTickets.Count, StringFormat={}{0} phiếu}" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/>
                  </Border>
                </Grid>

                <ItemsControl ItemsSource="{Binding SelectedOrderPreparationTickets}" Visibility="{Binding HasSelectedOrderPreparationTickets, Converter={StaticResource B2V}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="{Binding TicketNo}" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Border Background="#FFF7ED" CornerRadius="999" Padding="8,3" Margin="0,0,6,0">
                                  <TextBlock Text="{Binding Station}" FontSize="10" FontWeight="SemiBold" Foreground="#EA580C"/>
                                </Border>
                                <Border Background="#EFF6FF" CornerRadius="999" Padding="8,3">
                                  <TextBlock Text="{Binding TicketType}" FontSize="10" FontWeight="SemiBold" Foreground="#2563EB"/>
                                </Border>
                              </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                              <TextBlock Text="{Binding SentAt, StringFormat={}{0:dd/MM HH:mm:ss}}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                              <TextBlock Text="{Binding Lines.Count, StringFormat={}{0} dòng món}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                            </StackPanel>
                          </Grid>

                          <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="0,8,0,0">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>
                                  <StackPanel>
                                    <TextBlock Text="{Binding MenuItemName}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding KitchenNote, TargetNullValue=''}" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                  </StackPanel>
                                  <TextBlock Grid.Column="1" Text="{Binding Qty, StringFormat=x{0:0.##}}" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <Button Content="Xem phiếu" Command="{Binding DataContext.PreviewPreparationTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ActionBtn}" Height="32" MinWidth="92" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Visibility="{Binding HasSelectedOrderPreparationTickets, Converter={StaticResource InvBool}}">
                  <TextBlock Text="Đơn này chưa có phiếu bếp/bar nào được tạo." FontSize="11" Foreground="#64748B"/>
                </Border>
              </StackPanel>
            </Border>

          </StackPanel></ScrollViewer>
        </Grid>

        <!-- BOTTOM HALF: Payment -->
        <Border Grid.Row="1" BorderBrush="#DBE6F3" BorderThickness="0,1,0,0" Padding="16,12" Visibility="{Binding IsOpenOrdersTab, Converter={StaticResource B2V}}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" VerticalAlignment="Center"/>
          <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="Chốt thực đơn" Command="{Binding FinalizeOrderCommand}" Style="{StaticResource ActionGreenBtn}" Height="36" FontSize="12" Margin="0,0,6,0"/>
              <Button Grid.Column="1" Content="In phiếu tạm" Command="{Binding PrintOrderReceiptCommand}" Style="{StaticResource ActionBtn}" Height="36" FontSize="12" Margin="0,0,6,0"/>
              <Button Grid.Column="2" Content="In bếp/bar" Command="{Binding PrintOrderKitchenCommand}" Style="{StaticResource ActionBtn}" Height="36" FontSize="12" IsEnabled="{Binding CanPrintKitchen}"/>
            </Grid>
            <UniformGrid Columns="3" Margin="0,0,0,6"><Button Content="Tiền mặt" Style="{StaticResource ActionPrimaryBtn}" Height="36" FontSize="12" Margin="0,0,6,0"/><Button Content="Chuyển khoản" Style="{StaticResource ActionBtn}" Height="36" FontSize="12" Margin="0,0,6,0"/><Button Content="Công nợ" Style="{StaticResource ActionBtn}" Height="36" FontSize="12"/></UniformGrid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="Thanh toán" Command="{Binding PayOrderCommand}" Style="{StaticResource ActionGreenBtn}" Height="42" FontSize="13" Margin="0,0,6,0"/>
              <Button Grid.Column="1" Content="Hủy đơn" Command="{Binding CancelOrderCommand}" Style="{StaticResource ActionRedBtn}" Height="42" FontSize="13" Margin="6,0,0,0"/></Grid></StackPanel></Grid></Border>
      </Grid></Border>
    </Grid>

    <Grid x:Name="OrderItemPickerOverlay"
          Grid.Row="0"
          Grid.RowSpan="2"
          Grid.Column="0"
          Grid.ColumnSpan="3"
          Background="#14FFFFFF"
          Visibility="{Binding IsOrderItemPickerOpen, Converter={StaticResource B2V}}"
          Panel.ZIndex="20">
      <Canvas x:Name="OrderItemPickerCanvasRoot"
              Background="Transparent"
              MouseMove="OrderItemPickerCanvas_MouseMove"
              MouseLeftButtonUp="OrderItemPickerCanvas_MouseLeftButtonUp"
              LostMouseCapture="OrderItemPickerCanvas_LostMouseCapture">
      <Border x:Name="OrderItemPickerDialogCard" Width="1530" Height="750" MinWidth="1280" MinHeight="600" Background="#FFFFFFFF" CornerRadius="12" BorderBrush="#D5DFEB" BorderThickness="1"
              Canvas.Left="170"
              Canvas.Top="72"
              >
        <Border.Effect>
          <DropShadowEffect BlurRadius="26" ShadowDepth="8" Color="#220F172A" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
          <Grid Margin="20">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" Background="Transparent"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="OrderItemPickerDialogHeader_MouseLeftButtonDown">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="8" Background="#E8F4FD">
                  <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Th&#xEA;m m&#xF3;n / d&#x1ECB;ch v&#x1EE5;" FontSize="18" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding CloseOrderItemPickerCommand}" ToolTip="&#x110;&#xF3;ng" Width="36" Height="36" Padding="0" Margin="4,0,0,0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                  <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#616161"/>
                </Button>
              </StackPanel>
            </Grid>

            <!-- Search + Tabs -->
            <Grid Grid.Row="1" Margin="0,0,0,12"
                  Visibility="{Binding IsOrderItemPickerMinimized, Converter={StaticResource InvBool}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <!-- Search -->
              <Border Background="#F3F3F3" CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1" Height="40">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#616161" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  <TextBox Grid.Column="1"
                           Text="{Binding OrderItemPickerSearchText, UpdateSourceTrigger=PropertyChanged}"
                           Background="Transparent"
                           BorderThickness="0"
                           FontSize="13"
                           Foreground="#1A1A1A"
                           VerticalContentAlignment="Center"
                           Margin="8,0,12,0"/>
                </Grid>
              </Border>
              <!-- Tab buttons -->
              <Button Grid.Column="1" Content="M&#xF3;n &#x103;n" Command="{Binding NavigateOrderItemPickerTabCommand}" CommandParameter="0"
                      MinWidth="100" Height="40" Margin="8,0,6,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Padding="16,0">
                <Button.Style>
                  <Style TargetType="Button">
                    <Setter Property="Background" Value="#F3F3F3"/>
                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Foreground" Value="#616161"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="Button">
                          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOrderItemPickerFoodTab}" Value="True">
                        <Setter Property="Background" Value="#0078D4"/>
                        <Setter Property="BorderBrush" Value="#0078D4"/>
                        <Setter Property="Foreground" Value="White"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Grid.Column="2" Content="D&#x1ECB;ch v&#x1EE5;" Command="{Binding NavigateOrderItemPickerTabCommand}" CommandParameter="1"
                      MinWidth="100" Height="40" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Padding="16,0">
                <Button.Style>
                  <Style TargetType="Button">
                    <Setter Property="Background" Value="#F3F3F3"/>
                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Foreground" Value="#616161"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="Button">
                          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOrderItemPickerServiceTab}" Value="True">
                        <Setter Property="Background" Value="#0078D4"/>
                        <Setter Property="BorderBrush" Value="#0078D4"/>
                        <Setter Property="Foreground" Value="White"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </Grid>

            <!-- Category chips (food only) -->
            <Grid Grid.Row="2" Margin="0,0,0,8"
                  Visibility="{Binding IsOrderItemPickerMinimized, Converter={StaticResource InvBool}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ItemsControl ItemsSource="{Binding OrderItemPickerCategories}">
              <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOrderItemPickerFoodTab}" Value="True"/>
                        <Condition Binding="{Binding IsOrderItemPickerMinimized}" Value="False"/>
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </ItemsControl.Style>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding}"
                          Command="{Binding DataContext.SelectOrderItemPickerCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          Margin="0,0,6,6" Padding="12,6" Cursor="Hand" FontSize="12">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Background" Value="#F3F3F3"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Foreground" Value="#424242"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <DataTrigger Value="True">
                            <DataTrigger.Binding>
                              <MultiBinding Converter="{StaticResource EqConv}">
                                <Binding/>
                                <Binding Path="DataContext.SelectedOrderItemPickerCategory" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                              </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="Background" Value="#0078D4"/>
                            <Setter Property="BorderBrush" Value="#0078D4"/>
                            <Setter Property="Foreground" Value="White"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

              <!-- View toggle (food only) -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsOrderItemPickerFoodTab, Converter={StaticResource B2V}}">
                <Button Width="32" Height="32" Padding="0" Margin="0,0,2,0"
                        Command="{Binding ToggleOrderItemPickerViewCommand}" CommandParameter="list"
                        Background="#0078D4" BorderBrush="#0078D4" BorderThickness="1" Cursor="Hand">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Setter Property="Background" Value="#F3F3F3"/>
                      <Setter Property="BorderBrush" Value="#E0E0E0"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6">
                              <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#616161" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOrderItemPickerListView}" Value="True">
                          <Setter Property="Background" Value="#0078D4"/>
                          <Setter Property="BorderBrush" Value="#0078D4"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="Button">
                                <Border Background="#0078D4" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="6">
                                  <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Width="32" Height="32" Padding="0"
                        Command="{Binding ToggleOrderItemPickerViewCommand}" CommandParameter="card"
                        Background="#F3F3F3" BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Setter Property="Background" Value="#F3F3F3"/>
                      <Setter Property="BorderBrush" Value="#E0E0E0"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6">
                              <TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#616161" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOrderItemPickerCardView}" Value="True">
                          <Setter Property="Background" Value="#0078D4"/>
                          <Setter Property="BorderBrush" Value="#0078D4"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="Button">
                                <Border Background="#0078D4" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="6">
                                  <TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </StackPanel>
            </Grid>

            <!-- Main 2-column -->
            <Grid Grid.Row="3" Visibility="{Binding IsOrderItemPickerMinimized, Converter={StaticResource InvBool}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2*"/>
              </Grid.ColumnDefinitions>

              <!-- LEFT: Items list -->
              <Border Grid.Column="0" Background="#F9F9F9" CornerRadius="12" BorderBrush="#E8E8E8" BorderThickness="1">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <!-- Food list -->
                  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                Visibility="{Binding IsOrderItemPickerFoodTab, Converter={StaticResource B2V}}" Margin="4">
                    <Grid>
                    <!-- List mode -->
                    <ItemsControl ItemsSource="{Binding OrderItemPickerMenuItems}" Visibility="{Binding IsOrderItemPickerListView, Converter={StaticResource B2V}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="White" CornerRadius="10" Padding="12,10" Margin="2,0,2,4" Cursor="Hand" BorderBrush="#EEEEEE" BorderThickness="1">
                            <Border.Effect>
                              <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
                            </Border.Effect>
                            <Border.InputBindings>
                              <MouseBinding MouseAction="LeftClick"
                                            Command="{Binding DataContext.PrepareMenuItemForOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                              <MouseBinding MouseAction="LeftDoubleClick"
                                            Command="{Binding DataContext.QuickAddOrderItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/>
                                  <Border CornerRadius="4" Background="#FEE2E2" Padding="4,1" Margin="6,0,0,0">
                                    <Border.Style>
                                      <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                          <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                              <MultiBinding Converter="{StaticResource IsAlreadyAddedConverter}">
                                                <Binding Path="Id"/>
                                                <Binding Path="DataContext.AddedFoodItemIds" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                              </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Visibility" Value="Visible"/>
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Border.Style>
                                    <TextBlock Text="Đã thêm" FontSize="9" FontWeight="Bold" Foreground="#DC2626"/>
                                  </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="#888888" Margin="0,3,0,0"/>
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding UnitPrice, StringFormat={}{0:N0}&#x111;}" FontSize="13" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Card mode -->
                    <ItemsControl ItemsSource="{Binding OrderItemPickerMenuItems}" Visibility="{Binding IsOrderItemPickerCardView, Converter={StaticResource B2V}}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Width="130" Background="White" CornerRadius="12" BorderBrush="#EEEEEE" BorderThickness="1" Padding="0" Margin="2,2,6,6" Cursor="Hand">
                            <Border.Effect>
                              <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                            </Border.Effect>
                            <Border.InputBindings>
                              <MouseBinding MouseAction="LeftClick"
                                            Command="{Binding DataContext.PrepareMenuItemForOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                              <MouseBinding MouseAction="LeftDoubleClick"
                                            Command="{Binding DataContext.QuickAddOrderItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <StackPanel>
                              <!-- Image area -->
                              <Border Height="90" Background="#F3F3F3" CornerRadius="12,12,0,0">
                                <Grid>
                                  <TextBlock Text="{Binding Emoji, TargetNullValue='🍽️'}"
                                             FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  <Image Source="{Binding ImagePath}" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2"/>
                                  <Border CornerRadius="3" Background="#FEE2E2" Padding="4,1"
                                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4">
                                    <Border.Style>
                                      <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                          <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                              <MultiBinding Converter="{StaticResource IsAlreadyAddedConverter}">
                                                <Binding Path="Id"/>
                                                <Binding Path="DataContext.AddedFoodItemIds" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                              </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Visibility" Value="Visible"/>
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Border.Style>
                                    <TextBlock Text="Đã thêm" FontSize="9" FontWeight="Bold" Foreground="#DC2626"/>
                                  </Border>
                                </Grid>
                              </Border>
                              <StackPanel Margin="10,8">
                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0}&#x111;}" FontSize="12" FontWeight="Bold" Foreground="#0078D4" Margin="0,3,0,0"/>
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Grid>
                  </ScrollViewer>

                  <!-- Service list -->
                  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsOrderItemPickerServiceTab, Converter={StaticResource B2V}}" Margin="4">
                    <ItemsControl ItemsSource="{Binding OrderItemPickerServices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="White" CornerRadius="10" BorderBrush="#EEEEEE" BorderThickness="1" Padding="12,10" Margin="2,0,2,4">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Unit}" FontSize="11" Foreground="#888888" Margin="0,3,0,0"/>
                              </StackPanel>
                              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Price, StringFormat={}{0:N0}&#x111;}" FontSize="13" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="Th&#xEA;m" Height="30" Width="56" FontSize="11" FontWeight="SemiBold"
                                        Command="{Binding DataContext.AddServiceToSelectedOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="0">
                                  <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                      <Border x:Name="svcBtn" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                      </Border>
                                      <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                          <Setter TargetName="svcBtn" Property="Background" Value="#106EBE"/>
                                        </Trigger>
                                      </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                  </Button.Template>
                                </Button>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <!-- Food pager (simplified) -->
                  <Border Grid.Row="1" Margin="4,2,4,4" Padding="8,6" Background="White" CornerRadius="8"
                          Visibility="{Binding IsOrderItemPickerFoodTab, Converter={StaticResource B2V}}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding OrderItemPickerMenuRangeSummary}" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Width="28" Height="28" FontSize="10"
                                Command="{Binding PreviousOrderItemPickerMenuPageCommand}"
                                IsEnabled="{Binding CanGoPreviousOrderItemPickerMenuPage}"
                                Background="#F3F3F3" BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand" Padding="0"/>
                        <TextBlock Text="{Binding OrderItemPickerMenuPageIndex}" FontSize="12" FontWeight="SemiBold" Foreground="#1A1A1A"
                                   VerticalAlignment="Center" Margin="10,0"/>
                        <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Width="28" Height="28" FontSize="10"
                                Command="{Binding NextOrderItemPickerMenuPageCommand}"
                                IsEnabled="{Binding CanGoNextOrderItemPickerMenuPage}"
                                Background="#F3F3F3" BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand" Padding="0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>
              </Border>

              <!-- RIGHT: Cấu hình & preview -->
              <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E8E8E8" BorderThickness="1" Padding="16">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <!-- Selected item header -->
                  <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="{Binding OrderItemPickerSelectedItemTitle, TargetNullValue='Chọn một món bên trái'}"
                               FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding OrderItemPickerSelectedItemSubtitle}" FontSize="11" Foreground="#888888" Margin="0,3,0,0" TextWrapping="Wrap"/>
                  </StackPanel>

                  <!-- Config -->
                  <StackPanel Grid.Row="1" Visibility="{Binding HasSelectedOrderItemPickerMenuItem, Converter={StaticResource B2V}}">
                    <!-- Scope chips -->
                    <TextBlock Text="Áp dụng cho" FontSize="11" Foreground="#888888" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding OrderItemPickerScopeOptions}" Margin="0,0,0,10">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Content="{Binding Label}" Margin="0,0,6,6" Padding="10,5" Cursor="Hand" FontSize="11"
                                  Command="{Binding DataContext.SetOrderItemPickerScopeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding Value}">
                            <Button.Style>
                              <Style TargetType="Button">
                                <Setter Property="Background" Value="#F3F3F3"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#616161"/>
                                <Setter Property="Template">
                                  <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                      </Border>
                                    </ControlTemplate>
                                  </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                  <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                      <MultiBinding Converter="{StaticResource EqConv}">
                                        <Binding Path="Value"/>
                                        <Binding Path="DataContext.SelectedOrderItemPickerScope" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                      </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="#0078D4"/>
                                    <Setter Property="BorderBrush" Value="#0078D4"/>
                                    <Setter Property="Foreground" Value="White"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Rule chips -->
                    <TextBlock Text="Quy tắc số lượng" FontSize="11" Foreground="#888888" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding OrderItemPickerServingRuleOptions}" Margin="0,0,0,10">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Content="{Binding Label}" Margin="0,0,6,6" Padding="10,5" Cursor="Hand" FontSize="11"
                                  Command="{Binding DataContext.SetOrderItemPickerServingRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding Value}">
                            <Button.Style>
                              <Style TargetType="Button">
                                <Setter Property="Background" Value="#F3F3F3"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#616161"/>
                                <Setter Property="Template">
                                  <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                      </Border>
                                    </ControlTemplate>
                                  </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                  <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                      <MultiBinding Converter="{StaticResource EqConv}">
                                        <Binding Path="Value"/>
                                        <Binding Path="DataContext.SelectedOrderItemPickerServingRule" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                      </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="#0078D4"/>
                                    <Setter Property="BorderBrush" Value="#0078D4"/>
                                    <Setter Property="Foreground" Value="White"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Conditional quantity fields -->
                    <StackPanel Margin="0,0,0,10" Visibility="{Binding IsOrderItemPickerPerTableWithExtraRule, Converter={StaticResource B2V}}">
                      <TextBlock Text="Phần bù / khách vượt" FontSize="11" Foreground="#888888" Margin="0,0,0,4"/>
                      <TextBox Text="{Binding OrderItemPickerExtraUnitQuantity, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Visibility="{Binding IsOrderItemPickerManualRule, Converter={StaticResource B2V}}">
                      <TextBlock Text="SL thủ công / bàn" FontSize="11" Foreground="#888888" Margin="0,0,0,4"/>
                      <TextBox Text="{Binding OrderItemPickerManualQuantity, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Preview plan rows -->
                    <TextBlock Text="Preview áp dụng" FontSize="11" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding OrderItemPickerPlanRows}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="#E8F4FD" BorderBrush="#BFE0FA" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,6"
                                  ToolTipService.InitialShowDelay="150">
                            <Border.ToolTip>
                              <ToolTip Style="{StaticResource CleanToolTip}">
                                <Border Background="White" CornerRadius="14" Padding="0" MaxWidth="300" BorderBrush="#E8ECF0" BorderThickness="1">
                                  <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
                                  </Border.Effect>
                                  <StackPanel>
                                    <!-- Header -->
                                    <Border Background="#0078D4" CornerRadius="13,13,0,0" Padding="14,10">
                                      <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="6,0,0,0"
                                                   Text="{Binding TableName}"/>
                                        <TextBlock FontSize="11" Foreground="#B3D4F5" Margin="4,0,0,0" VerticalAlignment="Center">
                                          <Run Text="{Binding GuestCount, StringFormat={}{0} khách}"/>
                                        </TextBlock>
                                      </StackPanel>
                                    </Border>
                                    <!-- Body: existing items text -->
                                    <Border Padding="14,10">
                                      <TextBlock Text="{Binding ExistingItemsDisplay}" FontSize="12" Foreground="#1A1A1A"
                                                 TextWrapping="Wrap" LineHeight="22"/>
                                    </Border>
                                    <!-- Footer: adding -->
                                    <Border Background="#E8F4FD" CornerRadius="0,0,13,13" Padding="14,8" BorderBrush="#BFE0FA" BorderThickness="0,1,0,0">
                                      <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="11" Foreground="#0078D4" Margin="4,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center">
                                          <Run Text="Th&#xEA;m:&#xA0;x"/>
                                          <Run Text="{Binding DisplayQuantity, StringFormat={}{0:N0}}"/>
                                        </TextBlock>
                                      </StackPanel>
                                    </Border>
                                  </StackPanel>
                                </Border>
                              </ToolTip>
                            </Border.ToolTip>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#0078D4">
                              <Run Text="{Binding TableName}"/>
                              <Run Text=" - "/>
                              <Run Text="{Binding DisplayQuantity, StringFormat={}{0:N0}}"/>
                            </TextBlock>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- Apply button -->
                  <Button Grid.Row="2"
                          Content="Lưu món xuống các bàn đã chọn"
                          Command="{Binding ApplyPreparedMenuItemPlanCommand}"
                          Height="42" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"
                          IsEnabled="{Binding HasSelectedOrderItemPickerMenuItem}"
                          Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="btn" Background="{TemplateBinding Background}" CornerRadius="10">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btn" Property="Background" Value="#106EBE"/>
                          </Trigger>
                          <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="btn" Property="Background" Value="#CCCCCC"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </Grid>
              </Border>

            </Grid>

            <!-- Bottom close -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
              <Button Content="&#x110;&#xF3;ng" Command="{Binding CloseOrderItemPickerCommand}" HorizontalAlignment="Right"
                      Width="80" Height="36" FontSize="13"
                      Background="White" BorderBrush="#D1D1D1" BorderThickness="1" Cursor="Hand" Foreground="#424242">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="btn" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="btn" Property="Background" Value="#F3F3F3"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>
          </Grid>
        </Grid>

      </Border>
      </Canvas>
    </Grid>

    <Grid x:Name="ServingPlanOverlay"
          Grid.Row="0"
          Grid.RowSpan="2"
          Grid.Column="0"
          Grid.ColumnSpan="3"
          Background="#14FFFFFF"
          Visibility="{Binding IsServingPlanDialogOpen, Converter={StaticResource B2V}}"
          Panel.ZIndex="21">
      <Canvas x:Name="ServingPlanCanvasRoot"
              Background="Transparent"
              MouseMove="ServingPlanCanvas_MouseMove"
              MouseLeftButtonUp="ServingPlanCanvas_MouseLeftButtonUp"
              LostMouseCapture="ServingPlanCanvas_LostMouseCapture">
      <Border x:Name="ServingPlanDialogCard"
              Width="920"
              Height="680"
              MinWidth="760"
              MinHeight="500"
              Canvas.Left="230"
              Canvas.Top="86"
              Background="White"
              CornerRadius="12"
              BorderBrush="#D5DFEB"
              BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="26" ShadowDepth="8" Color="#220F172A" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
          <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10" Background="#00FFFFFF"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="ServingPlanDialogHeader_MouseLeftButtonDown">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Cấu hình bàn phục vụ" FontSize="20" FontWeight="SemiBold" Foreground="#0F2747"/>
                  <TextBlock FontSize="12" Foreground="#64748B" Margin="0,4,0,0">
                    <Run Text="{Binding SelectedOrderRoomDisplayName, Mode=OneWay, TargetNullValue='Phòng'}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding RoomServingPlanSummary, Mode=OneWay}"/>
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Kéo để di chuyển" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <Button Command="{Binding HideServingPlanDialogCommand}" ToolTip="Ẩn tạm" Style="{StaticResource ModalHeaderActionButton}">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  </Button>
                  <Button Command="{Binding ToggleServingPlanDialogMinimizedCommand}" ToolTip="Thu gọn / mở rộng nội dung" Style="{StaticResource ModalHeaderActionButton}">
                    <TextBlock Text="&#xE739;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  </Button>
                  <Button Command="{Binding CloseServingPlanDialogCommand}" ToolTip="Tắt cửa sổ" Style="{StaticResource ModalHeaderActionButton}" Margin="0">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>

            <Border Grid.Row="1" Background="#FFFFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12"
                    Visibility="{Binding IsServingPlanDialogMinimized, Converter={StaticResource InvBool}}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Tổng quan"
                          Command="{Binding NavigateServingPlanTabCommand}"
                          CommandParameter="0"
                          MinWidth="110"
                          Height="38"
                          Margin="0,0,8,0">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#D9E2EC"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsServingPlanOverviewTab}" Value="True">
                            <Setter Property="Background" Value="#2563EB"/>
                            <Setter Property="BorderBrush" Value="#2563EB"/>
                            <Setter Property="Foreground" Value="White"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button Content="Danh sách bàn"
                          Command="{Binding NavigateServingPlanTabCommand}"
                          CommandParameter="1"
                          MinWidth="126"
                          Height="38"
                          Margin="0,0,8,0">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#D9E2EC"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsServingPlanTablesTab}" Value="True">
                            <Setter Property="Background" Value="#2563EB"/>
                            <Setter Property="BorderBrush" Value="#2563EB"/>
                            <Setter Property="Foreground" Value="White"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button Content="Nhóm phục vụ"
                          Command="{Binding NavigateServingPlanTabCommand}"
                          CommandParameter="2"
                          MinWidth="138"
                          Height="38">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#D9E2EC"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsServingPlanGroupsTab}" Value="True">
                            <Setter Property="Background" Value="#2563EB"/>
                            <Setter Property="BorderBrush" Value="#2563EB"/>
                            <Setter Property="Foreground" Value="White"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,14,0,0" Visibility="{Binding IsServingPlanOverviewTab, Converter={StaticResource B2V}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="0.8*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                      <TextBlock Text="Tóm tắt phục vụ" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                      <UniformGrid Columns="3" Margin="0,10,0,0">
                        <Border Background="#EFF6FF" CornerRadius="12" Padding="10" Margin="0,0,8,0">
                          <StackPanel>
                            <TextBlock Text="Bàn phục vụ" FontSize="10" Foreground="#64748B"/>
                            <TextBlock Text="{Binding RoomServingPlanServingTableCount}" FontSize="18" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Border>
                        <Border Background="#FFF7ED" CornerRadius="12" Padding="10" Margin="0,0,8,0">
                          <StackPanel>
                            <TextBlock Text="Bàn chờ" FontSize="10" Foreground="#64748B"/>
                            <TextBlock Text="{Binding RoomServingPlanWaitingTableCount}" FontSize="18" FontWeight="Bold" Foreground="#C2410C" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Border>
                        <Border Background="#ECFDF5" CornerRadius="12" Padding="10">
                          <StackPanel>
                            <TextBlock Text="Tổng khách" FontSize="10" Foreground="#64748B"/>
                            <TextBlock Text="{Binding RoomServingPlanTotalGuests}" FontSize="18" FontWeight="Bold" Foreground="#15803D" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Border>
                      </UniformGrid>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="12" Margin="8,0,0,0">
                    <StackPanel>
                      <TextBlock Text="Cảnh báo" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                      <Border CornerRadius="12" Padding="10" Margin="0,10,0,0">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#ECFDF5"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding RoomServingPlanHasSoftWarnings}" Value="True">
                                <Setter Property="Background" Value="#FFF7ED"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RoomServingPlanWarningText}" FontSize="10" TextWrapping="Wrap">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#15803D"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding RoomServingPlanHasSoftWarnings}" Value="True">
                                  <Setter Property="Foreground" Value="#C2410C"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </Border>
            <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14"
                    Visibility="{Binding IsServingPlanDialogMinimized, Converter={StaticResource InvBool}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Danh sách bàn của phòng" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Grid.Column="1" Text="Bật/tắt phục vụ và chỉnh số khách trực tiếp tại đây" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Visibility="{Binding IsServingPlanTablesTab, Converter={StaticResource B2V}}">
                <ItemsControl ItemsSource="{Binding RoomServingPlanRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,8" Background="White">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="116"/>
                            <ColumnDefinition Width="86"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding TableName}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding CapacityHint}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding ExtraGuests, StringFormat=Phần bù: +{0} khách}" FontSize="10" Margin="0,4,0,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="#94A3B8"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverStandard}" Value="True">
                                      <Setter Property="Foreground" Value="#C2410C"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                          <ToggleButton Grid.Column="1"
                                        IsChecked="{Binding IsServing, Mode=TwoWay}"
                                        Margin="12,0,10,0"
                                        Height="36"
                                        Cursor="Hand">
                            <ToggleButton.Style>
                              <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="#FFF7ED"/>
                                <Setter Property="BorderBrush" Value="#FDBA74"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#C2410C"/>
                                <Setter Property="Template">
                                  <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                      </Border>
                                    </ControlTemplate>
                                  </Setter.Value>
                                </Setter>
                                <Setter Property="Content" Value="Bàn chờ"/>
                                <Style.Triggers>
                                  <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#DBEAFE"/>
                                    <Setter Property="BorderBrush" Value="#93C5FD"/>
                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                    <Setter Property="Content" Value="Phục vụ"/>
                                  </Trigger>
                                </Style.Triggers>
                              </Style>
                            </ToggleButton.Style>
                          </ToggleButton>
                          <TextBox Grid.Column="2"
                                   Text="{Binding GuestCount, UpdateSourceTrigger=PropertyChanged}"
                                   Height="36"
                                   VerticalContentAlignment="Center"
                                   HorizontalContentAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <Grid Grid.Row="1" Margin="0,10,0,0" Visibility="{Binding IsServingPlanGroupsTab, Converter={StaticResource B2V}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="0.95*"/>
                  <ColumnDefinition Width="1.05*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,8,0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Danh sách nhóm phục vụ" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Nhóm hệ thống chỉ đọc, nhóm tùy chỉnh dùng để gom các bàn có cùng cách lên món." FontSize="10" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Button Grid.Column="1"
                              Content="+ Nhóm mới"
                              Command="{Binding NewServingGroupCommand}"
                              Style="{StaticResource ActionPrimaryBtn}"
                              Height="34"
                              MinWidth="108"
                              FontSize="11"
                              Margin="12,0,0,0"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding ServingGroupEditorRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Command="{Binding DataContext.SelectServingGroupEditorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand"
                                    Margin="0,0,0,8">
                              <Button.Template>
                                <ControlTemplate TargetType="Button">
                                  <Border x:Name="GroupItemCard" Background="White" BorderBrush="#D9E7F6" BorderThickness="1" CornerRadius="12" Padding="10">
                                    <Grid>
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                      </Grid.ColumnDefinitions>
                                      <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding DisplaySubtitle}" FontSize="10" Foreground="#2563EB" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding TableSummary}" FontSize="10" Foreground="#64748B" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                      </StackPanel>
                                      <Border Grid.Column="1" CornerRadius="999" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Top">
                                        <Border.Style>
                                          <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Style.Triggers>
                                              <DataTrigger Binding="{Binding IsSystemDefined}" Value="True">
                                                <Setter Property="Background" Value="#DBEAFE"/>
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="9"
                                                   FontWeight="SemiBold">
                                          <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                              <Setter Property="Text" Value="Tùy chỉnh"/>
                                              <Setter Property="Foreground" Value="#15803D"/>
                                              <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSystemDefined}" Value="True">
                                                  <Setter Property="Text" Value="Hệ thống"/>
                                                  <Setter Property="Foreground" Value="#1D4ED8"/>
                                                </DataTrigger>
                                              </Style.Triggers>
                                            </Style>
                                          </TextBlock.Style>
                                        </TextBlock>
                                      </Border>
                                    </Grid>
                                  </Border>
                                  <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                      <Setter TargetName="GroupItemCard" Property="BorderBrush" Value="#93C5FD"/>
                                    </Trigger>
                                  </ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Button.Template>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="12" Margin="8,0,0,0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Thiết lập nhóm phục vụ" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Tên nhóm" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ServingGroupEditorName, UpdateSourceTrigger=PropertyChanged}" Height="36" IsEnabled="{Binding CanEditSelectedServingGroup}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Quy tắc món" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding ServingGroupEditorServingRuleOptions}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  SelectedValue="{Binding ServingGroupEditorServingRule, Mode=TwoWay}"
                                  Height="36"
                                  IsEnabled="{Binding CanEditSelectedServingGroup}"/>
                      </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                      <TextBlock Text="Ghi chú" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                      <TextBox Text="{Binding ServingGroupEditorNote, UpdateSourceTrigger=PropertyChanged}"
                               Height="70"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               VerticalScrollBarVisibility="Auto"
                               IsEnabled="{Binding CanEditSelectedServingGroup}"/>
                    </StackPanel>
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#D9E7F6" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,12,0,0">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Chọn bàn thuộc nhóm" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock Grid.Row="1" Text="{Binding SelectedServingGroupTableSummary}" FontSize="10" Foreground="#2563EB" Margin="0,4,0,0"/>
                        <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                          <ItemsControl ItemsSource="{Binding ServingGroupTableSelectionRows}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,6">
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="Auto"/>
                                      <ColumnDefinition Width="*"/>
                                      <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              IsEnabled="{Binding CanSelect}"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                      <TextBlock Text="{Binding TableName}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/>
                                      <TextBlock Text="{Binding StatusHint}" FontSize="10" Foreground="#64748B" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="999" Padding="8,3" VerticalAlignment="Center" Margin="12,0,0,0">
                                      <Border.Style>
                                        <Style TargetType="Border">
                                          <Setter Property="Background" Value="#FFEDD5"/>
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServing}" Value="True">
                                              <Setter Property="Background" Value="#DBEAFE"/>
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </Border.Style>
                                      <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                          <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#C2410C"/>
                                            <Style.Triggers>
                                              <DataTrigger Binding="{Binding IsServing}" Value="True">
                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </TextBlock.Style>
                                      </TextBlock>
                                    </Border>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </Grid>
                    </Border>
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Nhóm hệ thống lấy theo cấu hình bàn hiện tại. Muốn chia nhóm vận hành thực tế, hãy tạo nhóm tùy chỉnh."
                                 FontSize="10"
                                 Foreground="#64748B"
                                 TextWrapping="Wrap"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"/>
                      <Button Grid.Column="1"
                              Content="Xóa nhóm"
                              Command="{Binding DeleteServingGroupCommand}"
                              CommandParameter="{Binding SelectedServingGroupEditor}"
                              Style="{StaticResource ActionBtn}"
                              Height="36"
                              MinWidth="96"
                              Margin="0,0,8,0"
                              IsEnabled="{Binding CanDeleteSelectedServingGroup}"/>
                      <Button Grid.Column="2"
                              Content="Lưu nhóm"
                              Command="{Binding SaveServingGroupCommand}"
                              Style="{StaticResource ActionPrimaryBtn}"
                              Height="36"
                              MinWidth="108"
                              IsEnabled="{Binding CanEditSelectedServingGroup}"/>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
            </Border>

            <Border Grid.Row="3" Background="#FFFFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,14,0,0"
                    Visibility="{Binding IsServingPlanDialogMinimized, Converter={StaticResource InvBool}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="180"/>
                  <ColumnDefinition Width="190"/>
                  <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding RoomServingPlanSummary, Mode=OneWay}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                <Button Grid.Column="1"
                        Content="Đóng"
                        Command="{Binding CloseServingPlanDialogCommand}"
                        Style="{StaticResource ActionBtn}"
                        Height="42"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="2"
                        Content="Cân lại tự động"
                        Command="{Binding AutoBalanceRoomServingPlanCommand}"
                        Style="{StaticResource ActionBtn}"
                        Height="42"
                        Margin="6,0"/>
                <Button Grid.Column="3"
                        Content="Lưu cấu hình bàn"
                        Command="{Binding ApplyRoomServingPlanCommand}"
                        Style="{StaticResource ActionPrimaryBtn}"
                        Height="42"
                        Margin="6,0,0,0"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>
      </Canvas>
    </Grid>

    <Canvas x:Name="RoomSetupCanvas"
            Visibility="{Binding IsRoomSetupDialogOpen, Converter={StaticResource B2V}}"
            Panel.ZIndex="1000"
            Background="Transparent"
            IsHitTestVisible="True"
            MouseMove="RoomSetupCanvas_MouseMove"
            MouseLeftButtonUp="RoomSetupCanvas_MouseLeftButtonUp"
            LostMouseCapture="RoomSetupCanvas_LostMouseCapture">
      <Border x:Name="RoomSetupDialogCard" Width="520" Padding="22" Background="White" CornerRadius="18" BorderBrush="#DBE6F3" BorderThickness="1"
              Canvas.Left="700" Canvas.Top="70">
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" ShadowDepth="8" Color="#220F172A" Opacity="0.35"/>
        </Border.Effect>
        <StackPanel>
          <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,14"
                  Cursor="SizeAll"
                  PreviewMouseLeftButtonDown="RoomSetupDialogHeader_MouseLeftButtonDown">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Mở phòng phục vụ" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock FontSize="12" Foreground="#64748B" Margin="0,4,0,0">
                  <Run Text="{Binding RoomSetupRoom.RoomType, TargetNullValue='Khu vực'}"/>
                  <Run Text=" · "/>
                  <Run Text="{Binding RoomSetupRoom.Name, TargetNullValue='Phòng'}"/>
                </TextBlock>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="Kéo để di chuyển" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
          </Border>

          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Khách hàng" FontSize="12" Foreground="#475569"/>
              <TextBox Text="{Binding RoomSetupCustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Height="38" Padding="10,6"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Text="Số điện thoại" FontSize="12" Foreground="#475569"/>
              <TextBox Text="{Binding RoomSetupPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Height="38" Padding="10,6"/>
            </StackPanel>
          </Grid>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Số khách" FontSize="12" Foreground="#475569"/>
              <TextBox Text="{Binding RoomSetupGuestCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Height="38" Padding="10,6"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Text="Số bàn mở" FontSize="12" Foreground="#475569"/>
              <TextBox Text="{Binding RoomSetupTableCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Height="38" Padding="10,6"/>
              <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0">
                <Run Text="Tối đa "/>
                <Run Text="{Binding RoomSetupMaxTables, Mode=OneWay}"/>
                <Run Text=" bàn của phòng này"/>
              </TextBlock>
            </StackPanel>
          </Grid>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Giờ bắt đầu" FontSize="12" Foreground="#475569"/>
              <TextBox Text="{Binding RoomSetupStartTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Height="38" Padding="10,6"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Text="Giờ kết thúc" FontSize="12" Foreground="#475569"/>
              <TextBox Text="{Binding RoomSetupEndTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Height="38" Padding="10,6"/>
              <TextBlock Text="Nhập theo định dạng HH:mm, ví dụ 17:00 - 21:00." FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0"/>
            </StackPanel>
          </Grid>

          <StackPanel Margin="0,14,0,0">
            <TextBlock Text="Ghi chú" FontSize="12" Foreground="#475569"/>
            <TextBox Text="{Binding RoomSetupNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Height="88" Padding="10,8" AcceptsReturn="True" TextWrapping="Wrap"/>
          </StackPanel>

          <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Quy tắc mở bàn" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
              <TextBlock Text="Phòng đã có sẵn toàn bộ bàn mặc định. Lưu cấu hình sẽ bật số bàn phục vụ theo số khách, các bàn còn lại sẽ ở trạng thái bàn chờ để mở thêm khi cần." TextWrapping="Wrap" FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Đóng" Command="{Binding CloseRoomSetupDialogCommand}" Style="{StaticResource ActionBtn}" Height="42" Margin="0,0,6,0"/>
            <Button Grid.Column="1" Content="Lưu mở bàn" Command="{Binding SaveRoomSetupCommand}" Style="{StaticResource ActionPrimaryBtn}" Height="42" Margin="6,0,0,0"/>
          </Grid>
        </StackPanel>
      </Border>
    </Canvas>

    </Grid></UserControl>
