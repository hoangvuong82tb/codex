                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                      <TextBlock TextAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#0F172A">
                        <Run Text="Tháng "/><Run Text="{Binding RoomCalendarMonth, StringFormat=MM}"/><Run Text="/"/><Run Text="{Binding RoomCalendarMonth, StringFormat=yyyy}"/>
                      </TextBlock>
                      <TextBlock Text="Ngày có booking được đánh dấu xanh. Bấm vào ngày để lọc danh sách." FontSize="10" Foreground="#94A3B8" Margin="0,3,0,0" TextAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="▸" Width="32" Height="32" FontSize="12" Padding="0"
