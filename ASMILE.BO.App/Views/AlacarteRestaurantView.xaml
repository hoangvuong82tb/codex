                  <ComboBox Grid.Column="0" ItemsSource="{Binding QuoteMenuPageSizeOptions}" SelectedItem="{Binding QuoteMenuPageSize}" Style="{StaticResource EnterpriseModuleComboBox}" Height="30" MinWidth="60" FontSize="11" Margin="0,0,8,0"/>
                  <TextBlock Grid.Column="1" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"><Run Text="Hi&#x1EC3;n th&#x1ECB; "/><Run Text="{Binding PagedQuoteMenuItems.Count, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="/"/><Run Text="{Binding QuoteMenuTotalCount, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" m&#x00F3;n"/></TextBlock>
                  <Button Grid.Column="2" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Command="{Binding PreviousQuoteMenuPageCommand}" IsEnabled="{Binding CanGoPreviousQuoteMenuPage}" Width="30" Height="28" Padding="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"/>
