                      <Run Text="{Binding RoomReservedDateCount, Mode=OneWay}"/>
                      <Run Text=" ngày đã đặt"/>
                    </TextBlock>
                  </Border>
                </Grid>
              </Border>

              <Border Grid.Row="1" Background="White" BorderBrush="#DBE6F3" BorderThickness="1" CornerRadius="18" Padding="16,14" Margin="0,12,0,12">
