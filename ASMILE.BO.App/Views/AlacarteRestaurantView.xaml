                    <Button Content="In thử bếp" Click="TestKitchenPrinterButton_Click" Style="{StaticResource ActionBtn}" Height="38" MinWidth="96" Padding="12,0" Margin="0,0,8,0"/>
                    <Button Content="In thử bar" Click="TestBarPrinterButton_Click" Style="{StaticResource ActionBtn}" Height="38" MinWidth="96" Padding="12,0"/>
                  </StackPanel>
                  <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
                    <StackPanel>
                      <TextBlock Text="Cách nhập máy in" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,6"/>
                      <TextBlock Text="• Nhập tên máy in Windows đúng như đang dùng ở bán cà phê / ăn sáng." FontSize="11" Foreground="#475569" Margin="0,0,0,4" TextWrapping="Wrap"/>
                      <TextBlock Text="• Hoặc nhập IP máy in mạng theo dạng `192.168.1.50` hay `192.168.1.50:9100`." FontSize="11" Foreground="#475569" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </StackPanel></Border>
                <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="16,14"><StackPanel>
                  <TextBlock Text="Hóa đơn &amp; quy tắc in" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,14"/>
                  <TextBlock Text="Máy in hóa đơn" Style="{StaticResource KpiLabel}"/>
                  <ComboBox ItemsSource="{Binding AvailablePrinterNames}" Text="{Binding ReceiptPrinterName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Style="{StaticResource EnterpriseModuleComboBox}" Height="36" Margin="0,0,0,10"/>
                  <TextBlock Text="Khổ giấy hóa đơn" Style="{StaticResource KpiLabel}"/>
                  <ComboBox ItemsSource="{Binding PrinterPaperSizeOptions}" SelectedItem="{Binding ReceiptPaperSize, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleComboBox}" Height="36" Margin="0,0,0,12"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="In thử hóa đơn" Click="TestReceiptPrinterButton_Click" Style="{StaticResource ActionBtn}" Height="38" MinWidth="116" Padding="12,0" Margin="0,0,8,0"/>
                    <Button Content="Lưu cấu hình in" Command="{Binding SaveSettingsCommand}" Style="{StaticResource ActionPrimaryBtn}" Height="38" MinWidth="120" Padding="12,0"/>
                  </StackPanel>
                  <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                      <TextBlock Text="Quy tắc in" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,8"/>
                      <TextBlock Text="· Món bếp sẽ in theo máy in bếp đã cấu hình." FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                      <TextBlock Text="· Đồ uống / món bar sẽ in theo máy in bar đã cấu hình." FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                      <TextBlock Text="· Hóa đơn / tạm tính sẽ dùng máy in hóa đơn." FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                      <TextBlock Text="· Chấp nhận nhập tên máy in Windows hoặc IP máy in mạng theo dạng `192.168.x.x[:9100]`." FontSize="12" Foreground="#2563EB" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </StackPanel></Border></Grid>
              <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="TEST IN THẬT" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,6"/>
                  <TextBlock Text="Màn này dùng để xem mẫu phiếu thật trước khi in ra máy bếp và máy hóa đơn đang cấu hình." FontSize="12" Foreground="#64748B" Margin="0,0,0,14" TextWrapping="Wrap"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,8,0">
                      <StackPanel>
                        <TextBlock Text="Phiếu bếp thật" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding KitchenPrintTestSummary}" FontSize="11" Foreground="#64748B" Margin="0,6,0,12" TextWrapping="Wrap"/>
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                          <StackPanel>
                            <TextBlock Text="Máy in đang dùng" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding KitchenPrinterName}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding KitchenPaperSize, StringFormat=Khổ giấy: {0}}" FontSize="11" Foreground="#475569" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                          <Button Content="Xem mẫu phiếu bếp" Command="{Binding PreviewKitchenSampleTicketCommand}" Style="{StaticResource ActionBtn}" Height="38" MinWidth="140" Padding="12,0" Margin="0,0,8,0"/>
                          <Button Content="In phiếu bếp thật" Command="{Binding PrintKitchenSampleTicketCommand}" Style="{StaticResource ActionPrimaryBtn}" Height="38" MinWidth="140" Padding="12,0"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="12" Padding="14" Margin="8,0,0,0">
                      <StackPanel>
                        <TextBlock Text="Phiếu thanh toán thật" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding ReceiptPrintTestSummary}" FontSize="11" Foreground="#64748B" Margin="0,6,0,12" TextWrapping="Wrap"/>
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                          <StackPanel>
                            <TextBlock Text="Máy in đang dùng" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding ReceiptPrinterName}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding ReceiptPaperSize, StringFormat=Khổ giấy: {0}}" FontSize="11" Foreground="#475569" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                          <Button Content="Xem mẫu thanh toán" Command="{Binding PreviewReceiptSampleTicketCommand}" Style="{StaticResource ActionBtn}" Height="38" MinWidth="146" Padding="12,0" Margin="0,0,8,0"/>
                          <Button Content="In phiếu thanh toán thật" Command="{Binding PrintReceiptSampleTicketCommand}" Style="{StaticResource ActionPrimaryBtn}" Height="38" MinWidth="170" Padding="12,0"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- 3. Nhóm món -->
            <Grid Visibility="{Binding IsSettingsMenuGroups, Converter={StaticResource B2V}}"><Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="NHÓM MÓN" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                  <StackPanel>
                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12"><StackPanel>
                      <TextBlock Text="Thêm / sửa nhóm" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,14"/>
                      <TextBlock Text="Mã nhóm" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding SettingMenuGroupCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,12"/>
                      <TextBlock Text="Tên nhóm" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding SettingMenuGroupName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,12"/>
                      <TextBlock Text="Thứ tự sắp xếp" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding SettingMenuGroupSortOrder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,14"/>
                      <StackPanel Orientation="Horizontal"><Button Content="Lưu nhóm" Command="{Binding SaveSettingMenuGroupCommand}" Style="{StaticResource ActionPrimaryBtn}" Height="38" MinWidth="96" Padding="12,0" Margin="0,0,8,0"/><Button Content="Tạo mới" Command="{Binding NewSettingMenuGroupCommand}" Style="{StaticResource ActionBtn}" Height="38" MinWidth="88" Padding="12,0"/></StackPanel>
                    </StackPanel></Border>
                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="16,14"><StackPanel>
                      <TextBlock Text="Nhóm được phép bán trong module" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                      <TextBlock Text="Chỉ các nhóm được tick mới hiện trong bán hàng À La Carte." FontSize="12" Foreground="#64748B" Margin="0,4,0,12"/>
                      <ItemsControl ItemsSource="{Binding SettingCategorySelections}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                              <DockPanel LastChildFill="True">
                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                  <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                                  <TextBlock Foreground="#64748B" FontSize="11">
                                    <Run Text="{Binding Code}"/><Run Text=" · "/><Run Text="{Binding ItemCount}"/><Run Text=" món"/>
                                  </TextBlock>
                                </StackPanel>
                              </DockPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel></Border>
                  </StackPanel>
                </ScrollViewer>
                <DataGrid Grid.Column="1" ItemsSource="{Binding SettingMenuGroups}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="42" Style="{StaticResource EnterpriseModuleDataGrid}">
                  <DataGrid.Columns><DataGridTextColumn Header="Mã nhóm" Binding="{Binding Code}" Width="130"/><DataGridTextColumn Header="Tên nhóm" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Thứ tự" Binding="{Binding SortOrder}" Width="80"/><DataGridTextColumn Header="Số món" Binding="{Binding ItemCount}" Width="80"/><DataGridTemplateColumn Header="Cho bán" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsAllowed}" IsEnabled="False" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tác vụ" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Sửa" Command="{Binding DataContext.EditSettingMenuGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ActionBtn}" Height="28" FontSize="11" Padding="8,0" Margin="0,0,4,0"/><Button Content="Ngừng" Command="{Binding DataContext.DeleteSettingMenuGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ActionBtn}" Height="28" FontSize="11" Padding="8,0" Foreground="#DC2626"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></Grid>

            <!-- 4. Món bán -->
            <Grid Visibility="{Binding IsSettingsMenuItems, Converter={StaticResource B2V}}"><Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="MÓN BÁN" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,12,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                  <TextBlock Text="Thông tin món bán" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,14"/>
                  <TextBlock Text="Mã món" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding SettingMenuItemCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,12"/>
                  <TextBlock Text="Tên món" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding SettingMenuItemName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,12"/>
                  <TextBlock Text="Nhóm món" Style="{StaticResource KpiLabel}"/><ComboBox ItemsSource="{Binding SettingMenuGroups}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SettingMenuItemCategoryId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleComboBox}" Height="36" Margin="0,0,0,12"/>
                  <TextBlock Text="Phân loại bán hàng" Style="{StaticResource KpiLabel}"/><ComboBox ItemsSource="{Binding SettingMenuItemTypeOptions}" SelectedItem="{Binding SettingMenuItemType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleComboBox}" Height="36" Margin="0,0,0,12"/>
                  <TextBlock Text="Giá bán (VNĐ)" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding SettingMenuItemPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,12"/>
                  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="VAT (%)" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding SettingMenuItemVatRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Khu in / CB" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding SettingMenuItemStation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36"/></StackPanel></Grid>
                  <CheckBox Content="Quản lý định lượng" IsChecked="{Binding SettingMenuItemHasRecipe}" Margin="0,0,0,8" FontSize="12" Foreground="#334155"/>
                  <CheckBox Content="Đang bán" IsChecked="{Binding SettingMenuItemIsActive}" Margin="0,0,0,14" FontSize="12" Foreground="#334155"/>
                  <StackPanel Orientation="Horizontal"><Button Content="Lưu món" Command="{Binding SaveSettingMenuItemCommand}" Style="{StaticResource ActionPrimaryBtn}" Height="38" MinWidth="96" Padding="12,0" Margin="0,0,8,0"/><Button Content="Tạo mới" Command="{Binding NewSettingMenuItemCommand}" Style="{StaticResource ActionBtn}" Height="38" MinWidth="88" Padding="12,0"/></StackPanel>
                  <TextBlock Text="Phân loại này sẽ quyết định món hiển thị ở tab đồ ăn, rượu, đồ uống hay dịch vụ trong bán hàng." FontSize="11" Foreground="#94A3B8" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel></ScrollViewer></Border>
                <DataGrid Grid.Column="1" ItemsSource="{Binding SettingMenuItems}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="42" Style="{StaticResource EnterpriseModuleDataGrid}">
                  <DataGrid.Columns><DataGridTextColumn Header="Mã món" Binding="{Binding Code}" Width="120"/><DataGridTextColumn Header="Tên món" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Nhóm" Binding="{Binding GroupName}" Width="150"/><DataGridTextColumn Header="Loại" Binding="{Binding ItemType}" Width="90"/><DataGridTextColumn Header="Giá" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="100"/><DataGridTextColumn Header="VAT" Binding="{Binding VatRate, StringFormat={}{0}%}" Width="55"/><DataGridTextColumn Header="Khu" Binding="{Binding Station}" Width="90"/><DataGridTemplateColumn Header="ĐL" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding HasRecipe}" IsEnabled="False" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Bán" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsActive}" IsEnabled="False" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tác vụ" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Sửa" Command="{Binding DataContext.EditSettingMenuItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ActionBtn}" Height="28" FontSize="11" Padding="8,0" Margin="0,0,4,0"/><Button Content="Ngừng" Command="{Binding DataContext.DeleteSettingMenuItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ActionBtn}" Height="28" FontSize="11" Padding="8,0" Foreground="#DC2626"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></Grid>

            <!-- 5. Dịch vụ bổ sung -->
            <Grid Visibility="{Binding IsSettingsExtServices, Converter={StaticResource B2V}}"><Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="DỊCH VỤ BỔ SUNG" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,12,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                  <TextBlock Text="Thêm / sửa dịch vụ" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,14"/>
                  <TextBlock Text="Mã dịch vụ" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding SettingExtServiceCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,12"/>
                  <TextBlock Text="Tên dịch vụ" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding SettingExtServiceName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,12"/>
                  <TextBlock Text="Loại dịch vụ" Style="{StaticResource KpiLabel}"/><ComboBox ItemsSource="{Binding SettingServiceTypeOptions}" SelectedItem="{Binding SettingExtServiceType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleComboBox}" Height="36" Margin="0,0,0,12"/>
                  <TextBlock Text="Đơn giá" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding SettingExtServicePrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,12"/>
                  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="VAT (%)" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding SettingExtServiceVatRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Đơn vị tính" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding SettingExtServiceUnit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36"/></StackPanel></Grid>
                  <CheckBox Content="Giá đã gồm VAT" IsChecked="{Binding SettingExtServiceVatIncluded}" Margin="0,0,0,8" FontSize="12" Foreground="#334155"/>
                  <CheckBox Content="Đang bán" IsChecked="{Binding SettingExtServiceIsActive}" Margin="0,0,0,14" FontSize="12" Foreground="#334155"/>
                  <StackPanel Orientation="Horizontal"><Button Content="Lưu dịch vụ" Command="{Binding SaveSettingExtServiceCommand}" Style="{StaticResource ActionPrimaryBtn}" Height="38" MinWidth="106" Padding="12,0" Margin="0,0,8,0"/><Button Content="Tạo mới" Command="{Binding NewSettingExtServiceCommand}" Style="{StaticResource ActionBtn}" Height="38" MinWidth="88" Padding="12,0"/></StackPanel>
                </StackPanel></ScrollViewer></Border>
                <DataGrid Grid.Column="1" ItemsSource="{Binding SettingExtServices}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="42" Style="{StaticResource EnterpriseModuleDataGrid}">
                  <DataGrid.Columns><DataGridTextColumn Header="Mã DV" Binding="{Binding Code}" Width="110"/><DataGridTextColumn Header="Dịch vụ" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Loại" Binding="{Binding ServiceType}" Width="160"/><DataGridTextColumn Header="Đơn giá" Binding="{Binding Price, StringFormat={}{0:N0} đ}" Width="120"/><DataGridTextColumn Header="VAT" Binding="{Binding VatRate, StringFormat={}{0:N0}%}" Width="70"/><DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="80"/><DataGridTemplateColumn Header="Bán" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsActive}" IsEnabled="False" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tác vụ" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Sửa" Command="{Binding DataContext.EditSettingExtServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ActionBtn}" Height="28" FontSize="11" Padding="8,0" Margin="0,0,4,0"/><Button Content="Ngừng" Command="{Binding DataContext.DeleteSettingExtServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ActionBtn}" Height="28" FontSize="11" Padding="8,0" Foreground="#DC2626"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></Grid>

            <!-- 6. Thanh toán -->
            <Grid Visibility="{Binding IsSettingsPayment, Converter={StaticResource B2V}}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="THANH TOÁN" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Chuẩn hóa phương thức thanh toán, thuế và chính sách vận hành quầy thu ngân." Style="{StaticResource MutedLabel}" Margin="0,4,0,0"/>
              </StackPanel>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource BoxCard}" Margin="0,0,12,0"><StackPanel>
                  <TextBlock Text="Phương thức thanh toán" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                  <TextBlock Text="Bật các phương thức đang cho phép dùng ở À La Carte." Style="{StaticResource MutedLabel}" Margin="0,0,0,12"/>
                  <DataGrid ItemsSource="{Binding SettingPaymentMethods}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="38" Style="{StaticResource EnterpriseModuleDataGrid}" Margin="0,0,0,14">
                    <DataGrid.Columns><DataGridTextColumn Header="Phương thức" Binding="{Binding Name}" Width="*"/><DataGridTemplateColumn Header="Bật" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsEnabled}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Phí phục vụ mặc định (%)" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding DefaultServiceChargeRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,12"/>
                      <CheckBox Content="Cho phép công nợ" IsChecked="{Binding SettingEnableDebt}" Margin="0,0,0,8" FontSize="12" Foreground="#334155"/>
                      <CheckBox Content="Cho phép ghi phòng" IsChecked="{Binding SettingEnableRoomCharge}" Margin="0,0,0,8" FontSize="12" Foreground="#334155"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="VAT mặc định (%)" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding DefaultVatRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,12"/>
                      <CheckBox Content="Tự động tính VAT" IsChecked="{Binding SettingEnableAutoVat}" Margin="0,0,0,8" FontSize="12" Foreground="#334155"/>
                      <CheckBox Content="Làm tròn tiền" IsChecked="{Binding EnableAutoTableColor}" Margin="0,0,0,8" FontSize="12" Foreground="#334155"/>
                    </StackPanel>
                  </Grid>
                  <Button Content="Lưu cấu hình thanh toán" Command="{Binding SaveSettingsCommand}" Style="{StaticResource ActionPrimaryBtn}" Height="38" MinWidth="180" Padding="12,0" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource BoxCard}" Margin="12,0,0,0"><StackPanel>
                  <TextBlock Text="Lưu ý vận hành" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                  <TextBlock Text="Các cấu hình dưới đây quyết định cách tính tiền, VAT và nghiệp vụ thanh toán trong lúc chốt đơn." Style="{StaticResource MutedLabel}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                  <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="Khuyến nghị" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                      <TextBlock Text="• Chỉ bật công nợ khi đã có quy trình duyệt rõ ràng." FontSize="11" Foreground="#475569" Margin="0,6,0,4" TextWrapping="Wrap"/>
                      <TextBlock Text="• Ghi phòng nên dùng cùng kiểm tra mã khách hoặc mã phòng." FontSize="11" Foreground="#475569" Margin="0,0,0,4" TextWrapping="Wrap"/>
                      <TextBlock Text="• VAT và phí phục vụ nên khóa theo quy định dùng chung của nhà hàng." FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="12">
                    <TextBlock Text="Mục này đã dùng dữ liệu thật, không còn mockup. Khi lưu sẽ ghi về file cấu hình cục bộ của module À La Carte." FontSize="11" Foreground="#1D4ED8" TextWrapping="Wrap"/>
                  </Border>
                </StackPanel></Border>
              </Grid>
            </Grid>

            <!-- 7. Đặt bàn / Đặt cọc -->
            <Grid Visibility="{Binding IsSettingsReservation, Converter={StaticResource B2V}}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="ĐẶT BÀN / ĐẶT CỌC" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Thiết lập quy tắc giữ bàn, cảnh báo và xử lý cọc cho lịch đặt trước." Style="{StaticResource MutedLabel}" Margin="0,4,0,0"/>
              </StackPanel>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource BoxCard}" Margin="0,0,12,0"><StackPanel>
                  <TextBlock Text="Quy tắc đặt bàn" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                  <TextBlock Text="Giữ bàn (phút)" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding DefaultHoldMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,12"/>
                  <TextBlock Text="Cảnh báo trước (phút)" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding AlertBeforeMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,12"/>
                  <TextBlock Text="Tỷ lệ cọc mặc định (%)" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding DefaultDepositRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36"/>
                </StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource BoxCard}" Margin="12,0,0,0"><StackPanel>
                  <TextBlock Text="Tự động hóa no-show" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                  <TextBlock Text="Hủy sau (phút)" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding SettingAutoCancelMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,12"/>
                  <CheckBox Content="Cho phép đặt cọc nhiều lần" IsChecked="{Binding SettingAllowMultiDeposit}" Margin="0,0,0,8" FontSize="12" Foreground="#334155"/>
                  <CheckBox Content="Tự động hủy no-show" IsChecked="{Binding SettingAutoCancelNoShow}" Margin="0,0,0,12" FontSize="12" Foreground="#334155"/>
                  <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                    <TextBlock Text="Khuyến nghị chỉ bật tự động hủy khi quy trình đặt cọc và xác nhận khách đã ổn định, để tránh mất lịch đặt thực tế." FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                  </Border>
                  <Button Content="Lưu cấu hình đặt bàn" Command="{Binding SaveSettingsCommand}" Style="{StaticResource ActionPrimaryBtn}" Height="38" MinWidth="160" Padding="12,0" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel></Border>
              </Grid>
            </Grid>

            <!-- 8. Hóa đơn -->
            <Grid Visibility="{Binding IsSettingsDocuments, Converter={StaticResource B2V}}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="HÓA ĐƠN / CHỨNG TỪ" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Chuẩn hóa mẫu in, số liên và thông tin hiển thị trên phiếu." Style="{StaticResource MutedLabel}" Margin="0,4,0,0"/>
              </StackPanel>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource BoxCard}" Margin="0,0,12,0"><StackPanel>
                  <TextBlock Text="Cấu hình in chứng từ" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                  <TextBlock Text="Số liên in" Style="{StaticResource KpiLabel}"/><TextBox Text="{Binding SettingPrintCopies, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,12"/>
                  <CheckBox Content="In logo công ty" IsChecked="{Binding SettingPrintLogo}" Margin="0,0,0,8" FontSize="12" Foreground="#334155"/>
                  <CheckBox Content="Hiển thị VAT" IsChecked="{Binding SettingPrintVat}" Margin="0,0,0,12" FontSize="12" Foreground="#334155"/>
                  <Button Content="Lưu cấu hình chứng từ" Command="{Binding SaveSettingsCommand}" Style="{StaticResource ActionPrimaryBtn}" Height="38" MinWidth="170" Padding="12,0" HorizontalAlignment="Left"/>
                </StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource BoxCard}" Margin="12,0,0,0"><StackPanel>
                  <TextBlock Text="Mẫu in đang dùng" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                  <TextBlock Text="Các biểu mẫu hiện áp dụng cho hóa đơn, tạm tính, phiếu đặt bàn và hợp đồng." Style="{StaticResource MutedLabel}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                  <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel>
                      <TextBlock Text="Nội dung hiện có" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                      <TextBlock Text="• Hóa đơn thanh toán" FontSize="11" Foreground="#475569" Margin="0,6,0,4"/>
                      <TextBlock Text="• Phiếu tạm tính" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                      <TextBlock Text="• Phiếu đặt bàn / báo giá" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                      <TextBlock Text="• Hợp đồng / chứng từ liên quan" FontSize="11" Foreground="#475569"/>
                    </StackPanel>
                  </Border>
                </StackPanel></Border>
              </Grid>
            </Grid>

            <!-- 9. Phân quyền -->
            <Grid Visibility="{Binding IsSettingsPermissions, Converter={StaticResource B2V}}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="PHÂN QUYỀN" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Kiểm soát các thao tác nhạy cảm áp dụng ngay trong quy trình vận hành nhà hàng." Style="{StaticResource MutedLabel}" Margin="0,4,0,0"/>
              </StackPanel>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource BoxCard}" Margin="0,0,12,0"><StackPanel>
                  <TextBlock Text="Quy tắc áp dụng" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                  <TextBlock Text="Những quyền này nên khớp với vai trò thu ngân, quản lý ca và quản lý nhà hàng." Style="{StaticResource MutedLabel}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                  <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                    <TextBlock Text="Khi thay đổi phân quyền, hệ thống sẽ dùng ngay ở các thao tác như hủy món, hủy đơn, sửa giá và in lại chứng từ." FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                  </Border>
                  <Button Content="Lưu phân quyền" Command="{Binding SaveSettingsCommand}" Style="{StaticResource ActionPrimaryBtn}" Height="38" MinWidth="130" Padding="12,0" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource BoxCard}" Margin="12,0,0,0"><StackPanel>
                  <TextBlock Text="Danh sách quyền" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                  <ItemsControl ItemsSource="{Binding SettingPermissions}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/><CheckBox Grid.Column="1" IsChecked="{Binding IsGranted}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></Border>
              </Grid>
            </Grid>

            <!-- 10. Tích hợp -->
            <Grid Visibility="{Binding IsSettingsIntegration, Converter={StaticResource B2V}}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="ĐỒNG BỘ / TÍCH HỢP" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Theo dõi trạng thái kết nối với các nghiệp vụ liên quan của hệ thống." Style="{StaticResource MutedLabel}" Margin="0,4,0,0"/>
              </StackPanel>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource BoxCard}" Margin="0,0,12,0"><StackPanel>
                  <TextBlock Text="Trạng thái tích hợp" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                  <ItemsControl ItemsSource="{Binding SettingIntegrations}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="{Binding Name}" FontSize="13" Foreground="#0F172A"/></StackPanel>
                      <Border Grid.Column="1" Style="{StaticResource SettingsBadge}"><TextBlock FontSize="11" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Đã sẵn sàng"/><Setter Property="Foreground" Value="#16A34A"/><Style.Triggers><DataTrigger Binding="{Binding IsReady}" Value="False"><Setter Property="Text" Value="Chưa cấu hình"/><Setter Property="Foreground" Value="#64748B"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource BoxCard}" Margin="12,0,0,0"><StackPanel>
                  <TextBlock Text="Phạm vi kết nối" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                  <TextBlock Text="Mục này theo dõi các đầu mối như công nợ, quỹ tiền, kho định lượng và những luồng liên quan đến in ấn, thanh toán." Style="{StaticResource MutedLabel}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                  <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                    <TextBlock Text="Nếu một tích hợp chưa sẵn sàng, giao diện sẽ vẫn cho cấu hình nhưng cần hoàn thiện phần backend hoặc mapping trước khi dùng thật." FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                  </Border>
                  <Button Content="Lưu cấu hình tích hợp" Command="{Binding SaveSettingsCommand}" Style="{StaticResource ActionPrimaryBtn}" Height="38" MinWidth="160" Padding="12,0" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel></Border>
              </Grid>
            </Grid>


            <!-- 12. Nhóm phục vụ -->
            <Grid Visibility="{Binding IsSettingsServingGroups, Converter={StaticResource B2V}}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="NHÓM PHỤC VỤ" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>
              <Grid Grid.Row="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource BoxCard}" Background="#F8FBFF" BorderBrush="#D8E6F5" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Màn này dùng lại editor nhóm phục vụ từ popup cấu hình bàn để quản trị tách riêng, rõ hơn cho vận hành." FontSize="12" Foreground="#1D4ED8" TextWrapping="Wrap"/>
                    <TextBlock FontSize="11" Foreground="#475569" Margin="0,6,0,0" TextWrapping="Wrap">
                      <Run Text="Đơn đang chọn: "/>
                      <Run Text="{Binding SelectedOrder.OrderNo, TargetNullValue='Chưa chọn đơn mở'}" FontWeight="SemiBold"/>
                      <Run Text=" · "/>
                      <Run Text="{Binding SelectedOrderRoomDisplayName, Mode=OneWay, TargetNullValue='—'}"/>
                    </TextBlock>
                  </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource BoxCard}" Background="#F8FAFC" BorderBrush="#E2E8F0" Padding="12" Margin="0,0,8,0">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Danh sách nhóm phục vụ" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                          <TextBlock Text="Nhóm hệ thống chỉ đọc, nhóm tùy chỉnh dùng để gom các bàn có cùng cách lên món." FontSize="10" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ Nhóm mới" Command="{Binding NewServingGroupCommand}" Style="{StaticResource ActionPrimaryBtn}" Height="34" MinWidth="108" FontSize="11" Margin="12,0,0,0"/>
                      </Grid>
                      <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ServingGroupEditorRows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Command="{Binding DataContext.SelectServingGroupEditorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,0,8">
                                <Button.Template>
                                  <ControlTemplate TargetType="Button">
                                    <Border x:Name="GroupItemCard" Background="White" BorderBrush="#D9E7F6" BorderThickness="1" CornerRadius="12" Padding="10">
                                      <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                                          <TextBlock Text="{Binding DisplaySubtitle}" FontSize="10" Foreground="#2563EB" Margin="0,4,0,0"/>
                                          <TextBlock Text="{Binding TableSummary}" FontSize="10" Foreground="#64748B" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                                          <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource SettingsBadge}">
                                              <Setter Property="Background" Value="#DCFCE7"/>
                                              <Style.Triggers><DataTrigger Binding="{Binding IsSystemDefined}" Value="True"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger></Style.Triggers>
                                            </Style>
                                          </Border.Style>
                                          <TextBlock FontSize="9" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                              <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Tùy chỉnh"/><Setter Property="Foreground" Value="#15803D"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsSystemDefined}" Value="True"><Setter Property="Text" Value="Hệ thống"/><Setter Property="Foreground" Value="#1D4ED8"/></DataTrigger></Style.Triggers>
                                              </Style>
                                            </TextBlock.Style>
                                          </TextBlock>
                                        </Border>
                                      </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GroupItemCard" Property="BorderBrush" Value="#93C5FD"/></Trigger></ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Button.Template>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Grid>
                  </Border>
                  <Border Grid.Column="1" Style="{StaticResource BoxCard}" Background="#FFFFFF" BorderBrush="#E2E8F0" Padding="12" Margin="8,0,0,0">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <TextBlock Text="Thiết lập nhóm phục vụ" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                      <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                          <TextBlock Text="Tên nhóm" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                          <TextBox Text="{Binding ServingGroupEditorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" IsEnabled="{Binding CanEditSelectedServingGroup}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                          <TextBlock Text="Quy tắc món" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                          <ComboBox ItemsSource="{Binding ServingGroupEditorServingRuleOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding ServingGroupEditorServingRule, Mode=TwoWay}" Style="{StaticResource EnterpriseModuleComboBox}" Height="36" IsEnabled="{Binding CanEditSelectedServingGroup}"/>
                        </StackPanel>
                      </Grid>
                      <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="Ghi chú" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ServingGroupEditorNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEditSelectedServingGroup}"/>
                      </StackPanel>
                      <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#D9E7F6" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,12,0,0">
                        <Grid>
                          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                          <TextBlock Text="Chọn bàn thuộc nhóm" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                          <TextBlock Grid.Row="1" Text="{Binding SelectedServingGroupTableSummary}" FontSize="10" Foreground="#2563EB" Margin="0,4,0,0"/>
                          <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ServingGroupTableSelectionRows}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" IsEnabled="{Binding CanSelect}"/>
                                      <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding TableName}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding StatusHint}" FontSize="10" Foreground="#64748B" Margin="0,3,0,0"/>
                                      </StackPanel>
                                      <Border Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Border.Style>
                                          <Style TargetType="Border" BasedOn="{StaticResource SettingsBadge}">
                                            <Setter Property="Background" Value="#FFEDD5"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsServing}" Value="True"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger></Style.Triggers>
                                          </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="SemiBold">
                                          <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                              <Setter Property="Foreground" Value="#C2410C"/>
                                              <Style.Triggers><DataTrigger Binding="{Binding IsServing}" Value="True"><Setter Property="Foreground" Value="#1D4ED8"/></DataTrigger></Style.Triggers>
                                            </Style>
                                          </TextBlock.Style>
                                        </TextBlock>
                                      </Border>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </Grid>
                      </Border>
                      <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Chọn một đơn mở trước, sau đó bạn có thể tạo nhóm vận hành tùy chỉnh độc lập với nhóm hệ thống." FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Xóa nhóm" Command="{Binding DeleteServingGroupCommand}" CommandParameter="{Binding SelectedServingGroupEditor}" Style="{StaticResource ActionBtn}" Height="36" MinWidth="96" Margin="0,0,8,0" IsEnabled="{Binding CanDeleteSelectedServingGroup}"/>
                        <Button Grid.Column="2" Content="Lưu nhóm" Command="{Binding SaveServingGroupCommand}" Style="{StaticResource ActionPrimaryBtn}" Height="36" MinWidth="108" IsEnabled="{Binding CanEditSelectedServingGroup}"/>
                      </Grid>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
            </Grid>

            <!-- 11. Thông tin nhà hàng -->
            <Grid Visibility="{Binding IsSettingsRestaurant, Converter={StaticResource B2V}}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="THÔNG TIN NHÀ HÀNG" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Thông tin này sẽ được dùng lại trên báo giá, hợp đồng, phiếu thanh toán và mẫu in liên quan." Style="{StaticResource MutedLabel}" Margin="0,4,0,0"/>
