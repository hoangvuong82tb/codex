                              <Run Text=" · "/>
                              <Run Text="{Binding PricingMode}"/>
                              <Run Text=" · "/>
                              <Run Text="{Binding LineCount, StringFormat={}{0} món}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Price, StringFormat={}{0:N0} đ}" FontSize="11" Foreground="#EA580C" FontWeight="SemiBold" Margin="0,4,0,0"/>
                          </StackPanel>
                          <Button Grid.Column="2"
                                  Content="+"
                                  Style="{StaticResource ActionPrimaryBtn}"
                                  Height="30"
                                  Width="30"
                                  MinWidth="30"
                                  FontSize="16"
                                  Padding="0"
                                  Command="{Binding DataContext.AddMenuPackageToQuoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel></ScrollViewer>
            </Grid>
          </Grid></Border>

          <!-- RIGHT: Fixed header -->
          <Grid Grid.Row="0" Grid.Column="2" Margin="8,8,18,8" ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#DBE6F3" BorderThickness="1" CornerRadius="14,14,0,0" Padding="20,16,20,8" Margin="0,0,17,0">
              <StackPanel>
              <TextBlock Text="{Binding RestaurantQuoteTitle}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding RestaurantContactLine}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              <TextBlock Text="BẢNG BÁO GIÁ" FontSize="18" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,14,0,4"/>
              <TextBlock FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,8"><Run Text="{Binding QuoteNo, Mode=OneWay}" FontWeight="Bold" Foreground="#2563EB"/><Run Text="  ·  Người báo giá: "/><Run Text="{Binding PreparedByName, Mode=OneWay}" FontWeight="SemiBold" Foreground="#64748B"/></TextBlock>
              <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock FontSize="11" Foreground="#64748B"><Run Text="Khách hàng: "/><Run Text="{Binding ReservationCustomerName, TargetNullValue='................................................................'}" FontWeight="SemiBold" Foreground="#0F172A"/></TextBlock>
                    <TextBlock FontSize="11" Foreground="#64748B" Margin="0,4,0,0"><Run Text="Số bàn: "/><Run Text="{Binding ReservationGuestCount, FallbackValue=1, TargetNullValue=1}" FontWeight="SemiBold" Foreground="#0F172A"/><Run Text="  ·  Khách: "/><Run Text="{Binding QuoteGuestCount, FallbackValue=1, TargetNullValue=1}" FontWeight="SemiBold" Foreground="#0F172A"/><Run Text="  ·  Phòng: "/><Run Text="{Binding SelectedRoom.Name, TargetNullValue='Chọn phòng'}" FontWeight="SemiBold" Foreground="#2563EB"/></TextBlock></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock FontSize="11" Foreground="#64748B"><Run Text="SĐT: "/><Run Text="{Binding ReservationPhone, TargetNullValue='................................................................'}" FontWeight="SemiBold" Foreground="#0F172A"/></TextBlock>
                    <TextBlock FontSize="11" Foreground="#64748B" Margin="0,4,0,0"><Run Text="Ngày: "/><Run Text="{Binding QuoteDate, StringFormat=dd/MM/yyyy}" FontWeight="SemiBold" Foreground="#0F172A"/><Run Text="  "/><Run Text="{Binding QuoteStartTime, FallbackValue=17:00}"/><Run Text=" - "/><Run Text="{Binding QuoteEndTime, FallbackValue=21:00}"/></TextBlock></StackPanel></Grid></Border>
            </StackPanel></Border>

          <!-- RIGHT: Scrollable quote tables -->
          <ScrollViewer x:Name="QuotePreviewScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Margin="0" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <Border Background="White" BorderBrush="#DBE6F3" BorderThickness="1,0,1,1" CornerRadius="0,0,14,14" Padding="20,8,20,16">
            <StackPanel>

              <!-- Menu table header -->
              <Border Background="#2563EB" CornerRadius="8,8,0,0" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <TextBlock Text="STT" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="MÓN ĂN" FontSize="11" FontWeight="Bold" Foreground="White"/>
                <TextBlock Grid.Column="2" Text="Đơn giá" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="SL/bàn" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Thành tiền/bàn" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5"/></Grid></Border>

              <!-- Menu items table -->
              <Border BorderBrush="#E5E7EB" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Margin="0,0,0,12">
                <Grid>
                <ItemsControl ItemsSource="{Binding QuoteLines}" PreviewMouseWheel="ItemsControl_PreviewMouseWheel"><ItemsControl.ItemTemplate><DataTemplate>
                  <Border x:Name="menuItem" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="8">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LineNoDisplay}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding PricingRule}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Button Content="−" Width="22" Height="22" FontSize="12" FontWeight="Bold" Padding="0" Background="#F1F5F9" BorderThickness="0" Cursor="Hand"
                              Command="{Binding DataContext.DecreaseQuoteQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                      <StackPanel>
                        <TextBlock Text="{Binding Quantity}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CalculatedQuantityDisplay}" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                      </StackPanel>
                      <Button Content="+" Width="22" Height="22" FontSize="12" FontWeight="Bold" Padding="0" Background="#F1F5F9" BorderThickness="0" Cursor="Hand"
                              Command="{Binding DataContext.IncreaseQuoteQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel>
                    <TextBlock Grid.Column="4" Text="{Binding Total, StringFormat={}{0:N0} &#x0111;}" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <Button Grid.Column="5" Width="24" Height="24" Padding="0" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" Cursor="Hand" ToolTip="X&#x00F3;a m&#x00F3;n"
                            Command="{Binding DataContext.RemoveFromQuoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                      <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button></Grid></Border>
                  <DataTemplate.Triggers><DataTrigger Binding="{Binding Type}" Value="Dịch vụ"><Setter TargetName="menuItem" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Border Padding="20" Visibility="{Binding QuoteLines.Count, Converter={StaticResource B2V}, FallbackValue=Collapsed}"><TextBlock Text="Click món hoặc dịch vụ bên trái để thêm" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/></Border>
                </Grid>
              </Border>

              <!-- Service table header -->
              <Border Background="#0F766E" CornerRadius="8,8,0,0" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <TextBlock Text="STT" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="DỊCH VỤ" FontSize="11" FontWeight="Bold" Foreground="White"/>
                <TextBlock Grid.Column="2" Text="Đơn giá" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="SL" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Thành tiền" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5"/></Grid></Border>

              <!-- Service items table -->
              <Border BorderBrush="#E5E7EB" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Margin="0,0,0,14">
                <Grid>
                <ItemsControl ItemsSource="{Binding QuoteLines}" PreviewMouseWheel="ItemsControl_PreviewMouseWheel"><ItemsControl.ItemTemplate><DataTemplate>
                  <Border x:Name="svcItem" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="8">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LineNoDisplay}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding PricingRule}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Button Content="−" Width="22" Height="22" FontSize="12" FontWeight="Bold" Padding="0" Background="#F1F5F9" BorderThickness="0" Cursor="Hand"
                              Command="{Binding DataContext.DecreaseQuoteQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                      <StackPanel>
                        <TextBlock Text="{Binding Quantity}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CalculatedQuantityDisplay}" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                      </StackPanel>
                      <Button Content="+" Width="22" Height="22" FontSize="12" FontWeight="Bold" Padding="0" Background="#F1F5F9" BorderThickness="0" Cursor="Hand"
                              Command="{Binding DataContext.IncreaseQuoteQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel>
                    <TextBlock Grid.Column="4" Text="{Binding Total, StringFormat={}{0:N0} &#x0111;}" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <Button Grid.Column="5" Width="24" Height="24" Padding="0" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" Cursor="Hand" ToolTip="X&#x00F3;a d&#x1ECB;ch v&#x1EE5;"
                            Command="{Binding DataContext.RemoveFromQuoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                      <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button></Grid></Border>
                  <DataTemplate.Triggers><DataTrigger Binding="{Binding Type}" Value="Món ăn"><Setter TargetName="svcItem" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </Grid>
              </Border>

              <!-- Totals per table -->
              <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                <StackPanel>
                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tạm tính món / 1 bàn" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding QuoteSubtotal, StringFormat={}{0:N0} đ}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/></Grid>
                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Dịch vụ / phòng" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding QuoteServiceTotal, StringFormat={}{0:N0} đ}" FontWeight="SemiBold" FontSize="12" Foreground="#2563EB"/></Grid>
                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="VAT (8%)" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding QuoteVat, StringFormat={}{0:N0} đ}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A"/></Grid>
                <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,4"/><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tổng / 1 bàn" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/><TextBlock Grid.Column="1" Text="{Binding QuoteTotal, StringFormat={}{0:N0} đ}" FontWeight="Bold" FontSize="16" Foreground="#DC2626"/></Grid>
                </StackPanel>
              </Border>

              <!-- Total for all tables -->
              <Border Background="#FFF7ED" CornerRadius="10" Padding="14,12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="TỔNG BÁO GIÁ" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/><TextBlock FontSize="11" Foreground="#64748B"><Run Text="{Binding ReservationGuestCount, FallbackValue=1, TargetNullValue=1}"/><Run Text=" bàn · "/><Run Text="{Binding QuoteGuestCount, FallbackValue=1, TargetNullValue=1}"/><Run Text=" khách"/></TextBlock></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding QuoteGrandTotal, StringFormat={}{0:N0} đ}" FontWeight="Bold" FontSize="20" Foreground="#DC2626" VerticalAlignment="Center"/></Grid></Border>

              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Content="Lưu báo giá" Tag="&#xE74E;" Command="{Binding SaveQuoteCommand}" Style="{StaticResource ActionGreenBtn}" Height="42" FontSize="13" Margin="0,0,4,0"/>
                <Button Grid.Column="1" Content="In báo giá" Tag="&#xE749;" Command="{Binding PrintQuoteCommand}" Style="{StaticResource ActionPrimaryBtn}" Height="42" FontSize="13" Margin="4,0,0,0"/></Grid>
