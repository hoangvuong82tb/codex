                    </StackPanel>
                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#D5E1EF" BorderThickness="1" CornerRadius="999" Padding="10,6" VerticalAlignment="Center">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#334155">
                        <Run Text="{Binding SelectedDateReservationCount, Mode=OneWay}"/>
                        <Run Text=" booking"/>
                      </TextBlock>
                    </Border>
                  </Grid>

                  <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding SelectedDateReservations}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="#FAFCFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,8" Cursor="Hand">
                              <Border.InputBindings>
                                <MouseBinding Command="{Binding DataContext.SelectRoomReservationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MouseAction="LeftClick"/>
                              </Border.InputBindings>
