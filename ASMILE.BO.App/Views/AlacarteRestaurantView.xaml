                    <TextBlock Text="T3" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="T4" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="T5" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="T6" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="T7" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                  </UniformGrid>

                  <ItemsControl ItemsSource="{Binding RoomCalendarDays}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="7"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Height="46" Margin="2" Padding="0"
                                Command="{Binding DataContext.SelectRoomCalendarDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
