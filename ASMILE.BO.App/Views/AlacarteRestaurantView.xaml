                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedRoomCalendarEmptyText}" FontSize="13" Foreground="#94A3B8" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </Border>

        <!-- TOP HALF: Order Info + Dish List -->
