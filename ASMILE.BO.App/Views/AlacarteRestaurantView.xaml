                  <Button Grid.Column="4" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Command="{Binding NextQuoteMenuPageCommand}" IsEnabled="{Binding CanGoNextQuoteMenuPage}" Width="30" Height="28" Padding="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"/>
                </Grid>
              </Border>              </Grid>

              <!-- TAB: Dịch vụ kèm -->
