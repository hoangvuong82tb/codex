<UserControl x:Class="ASMILE.BO.App.Views.MenuRecipe.Screens.MenuSettingsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ASMILE.BO.App;component/Views/MenuRecipe/MenuRecipeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                <Grid Visibility="{Binding IsSectionSettings, Converter={StaticResource B2V}}" Margin="16,12,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AccountingPanelCard}" Padding="20" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="C&#x1EA5;u h&#xEC;nh module" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,16"/>
                            <TextBlock Text="Th&#xF4;ng tin h&#x1EC7; th&#x1ED1;ng" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="T&#x1ED5;ng m&#xF3;n:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalMenuCount, StringFormat={}{0:N0}}" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="Nh&#xF3;m:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DashboardCategoryCount, StringFormat={}{0:N0}}" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Text="C&#xF3; &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HasRecipeCount, StringFormat={}{0:N0}}" FontSize="13" Foreground="#16A34A" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Text="C&#x1EA3;nh b&#xE1;o:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DashboardWarningCount, StringFormat={}{0:N0}}" FontSize="13" Foreground="#EA580C" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Height="1" Background="#E5E7EB" Margin="0,12"/>
                            <CheckBox IsChecked="{Binding CanEdit}" Content="Cho ph&#xE9;p ch&#x1EC9;nh s&#x1EED;a" FontSize="13" Foreground="#1E293B"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource AccountingPanelCard}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Th&#x1ED1;ng k&#xEA;" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,16"/>
                            <TextBlock Text="Phi&#xEA;n b&#x1EA3;n: 1.0.0" FontSize="13" Foreground="#64748B"/>
                            <TextBlock Text="Backend: MenuCatalog + MenuRecipeService" FontSize="13" Foreground="#64748B" Margin="0,6,0,0"/>
                            <TextBlock Text="Database: SQL Server" FontSize="13" Foreground="#64748B" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
</UserControl>


