<UserControl x:Class="ASMILE.BO.App.Views.MenuRecipe.Screens.MenuRecipeManagementScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ASMILE.BO.App;component/Views/MenuRecipe/MenuRecipeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                <Grid Visibility="{Binding IsSectionRecipe, Converter={StaticResource B2V}}" Margin="16,12,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource AccountingPanelCard}" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="&#x110;&#x1ECB;nh l&#x1B0;&#x1EE3;ng m&#xF3;n" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock Text="Ch&#x1ECD;n m&#xF3;n, th&#xEA;m nguy&#xEA;n li&#x1EC7;u, l&#x1B0;u &#x111;&#x1ECB;nh m&#x1EE9;c v&#xE0; xem gi&#xE1; v&#x1ED1;n ngay tr&#xEA;n m&#xE0;n n&#xE0;y." FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="L&#x1B0;u &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng" Command="{Binding SaveRecipeCommand}" Style="{StaticResource EnterpriseModuleCmdPrimary}" Tag="&#xE74E;" Height="34" FontSize="12" Padding="12,0"/>
                                <Button Content="T&#xED;nh gi&#xE1; v&#x1ED1;n" Command="{Binding CalculateCostCommand}" Style="{StaticResource EnterpriseModuleCmdInfo}" Tag="&#xE8EC;" Height="34" FontSize="12" Padding="12,0" Margin="8,0,0,0"/>
                                <Button Content="Sang m&#xF3;n &#x103;n" Command="{Binding NavigateSectionCommand}" CommandParameter="1" Style="{StaticResource EnterpriseModuleCmdSecondary}" Tag="&#xE8A5;" Height="34" FontSize="12" Padding="12,0" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource AccountingPanelCard}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Danh s&#xE1;ch m&#xF3;n" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}" Height="34" ToolTip="T&#xEC;m m&#xF3;n"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FilterCategoryId}" Style="{StaticResource FCombo}" Height="34" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" ToolTip="L&#x1ECD;c nh&#xF3;m"/>
                                </Grid>
                                <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredMenuCards}" SelectedItem="{Binding SelectedMenuCard}"
                          Style="{StaticResource EnterpriseModuleDataGrid}" AutoGenerateColumns="False" RowHeaderWidth="0"
                          RowHeight="42" BorderThickness="1" CanUserResizeColumns="False" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="M&#xF3;n" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                        <TextBlock Text="{Binding Code}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="TT" Width="98">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ActiveStatusBadge}" FontSize="11" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding RecipeStatusBadge}" FontSize="11" Foreground="#2563EB" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource AccountingPanelCard}" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="0.9*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedMenuTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding HeaderMetaText}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Nguy&#xEA;n li&#x1EC7;u" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding TotalIngredientsText}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Gi&#xE1; v&#x1ED1;n" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding CostDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="#DC2626"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="LN" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding MarginRateDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding MarginBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource AccountingPanelCard}" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Nguy&#xEA;n li&#x1EC7;u" Style="{StaticResource FLabel}"/>
                                                <ComboBox ItemsSource="{Binding IngredientLookup}" DisplayMemberPath="ItemName" SelectedItem="{Binding SelectedIngredient}" Style="{StaticResource FCombo}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="Kho xu&#x1EA5;t" Style="{StaticResource FLabel}"/>
                                                <ComboBox ItemsSource="{Binding WarehouseLookup}" DisplayMemberPath="WarehouseName" SelectedItem="{Binding SelectedWarehouse}" Style="{StaticResource FCombo}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                                <TextBlock Text="SL" Style="{StaticResource FLabel}"/>
                                                <TextBox Text="{Binding IngredientQuantityInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}" TextAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                                <TextBlock Text="HH%" Style="{StaticResource FLabel}"/>
                                                <TextBox Text="{Binding IngredientLossRateInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}" TextAlignment="Right"/>
                                            </StackPanel>
                                            <Button Grid.Column="4" Content="Th&#xEA;m" Command="{Binding AddRecipeLineCommand}" Style="{StaticResource EnterpriseModuleCmdPrimary}" Tag="&#xE710;" Height="38" FontSize="12" Padding="12,0" Margin="10,20,0,0"/>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1">
                                        <DataGrid ItemsSource="{Binding RecipeLines}" Style="{StaticResource EnterpriseModuleDataGrid}" IsReadOnly="False"
                              Visibility="{Binding HasRecipeLines, Converter={StaticResource B2V}}" AutoGenerateColumns="False"
                              CanUserAddRows="False" RowHeaderWidth="0" RowHeight="36" ColumnHeaderHeight="36"
                              BorderBrush="#E5E7EB" BorderThickness="1" CanUserResizeColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Width="40" Binding="{Binding LineNo}" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Nguy&#xEA;n li&#x1EC7;u" Width="2*" MinWidth="170" Binding="{Binding ItemName}" IsReadOnly="True">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="#0F172A"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="&#x110;VT" Width="58" Binding="{Binding UnitName}" IsReadOnly="True"/>
                                                <DataGridTemplateColumn Header="SL" Width="86" HeaderStyle="{StaticResource CategoryGridNumberHeader}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Quantity, StringFormat={}{0:N2}}" Style="{StaticResource CategoryGridNumberText}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="HH%" Width="72" HeaderStyle="{StaticResource CategoryGridNumberHeader}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding LossRatePercent, StringFormat={}{0:N1}}" Style="{StaticResource CategoryGridNumberText}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding LossRatePercent, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Sau HH" Width="92" Binding="{Binding EffectiveQuantity, StringFormat={}{0:N2}}" IsReadOnly="True" HeaderStyle="{StaticResource CategoryGridNumberHeader}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CategoryGridNumberText}">
                                                            <Setter Property="Foreground" Value="#2563EB"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Kho" Width="1.1*" Binding="{Binding WarehouseDisplay}" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Gi&#xE1;" Width="92" Binding="{Binding EstimatedUnitCost, StringFormat={}{0:N0}}" IsReadOnly="True" HeaderStyle="{StaticResource CategoryGridNumberHeader}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CategoryGridNumberText}">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTemplateColumn Header="BB" Width="48" HeaderStyle="{StaticResource CategoryGridCenterHeader}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsRequired}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="T&#xE1;c v&#x1EE5;" Width="82" HeaderStyle="{StaticResource CategoryGridCenterHeader}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Button Style="{StaticResource ActionBtn}" ToolTip="L&#xEA;n" Command="{Binding DataContext.MoveRecipeLineUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}">
                                                                    <TextBlock Text="&#xE74A;" Style="{StaticResource CategoryGridActionIcon}"/>
                                                                </Button>
                                                                <Button Style="{StaticResource ActionBtn}" ToolTip="Xu&#x1ED1;ng" Command="{Binding DataContext.MoveRecipeLineDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}">
                                                                    <TextBlock Text="&#xE74B;" Style="{StaticResource CategoryGridActionIcon}"/>
                                                                </Button>
                                                                <Button Style="{StaticResource ActionDelBtn}" ToolTip="X&#xF3;a" Command="{Binding DataContext.RemoveRecipeLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}">
                                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource CategoryGridActionIcon}"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel Visibility="{Binding NoRecipeLines, Converter={StaticResource B2V}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Ch&#x1B0;a c&#xF3; nguy&#xEA;n li&#x1EC7;u &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            <TextBlock Text="Ch&#x1ECD;n nguy&#xEA;n li&#x1EC7;u, nh&#x1EAD;p s&#x1ED1; l&#x1B0;&#x1EE3;ng v&#xE0; b&#x1EA5;m Th&#xEA;m." FontSize="12" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="0.9*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource AccountingPanelCard}" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TotalEffectiveQuantityDisplay}" FontSize="12" Foreground="#2563EB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding IngredientLineTotalDisplay}" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource AccountingPanelCard}" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="C&#x1EA3;nh b&#xE1;o &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#FEE2E2" CornerRadius="9" Padding="8,2" Visibility="{Binding HasWarnings, Converter={StaticResource B2V}}">
                                            <TextBlock Text="{Binding CostWarningCount}" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Kh&#xF4;ng c&#xF3;" FontSize="12" Foreground="#16A34A" FontWeight="SemiBold" Visibility="{Binding NoCostWarnings, Converter={StaticResource B2V}}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
</UserControl>


