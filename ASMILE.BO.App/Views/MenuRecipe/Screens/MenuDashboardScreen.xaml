<UserControl x:Class="ASMILE.BO.App.Views.MenuRecipe.Screens.MenuDashboardScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ASMILE.BO.App;component/Views/MenuRecipe/MenuRecipeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                <Grid Visibility="{Binding IsSectionDashboard, Converter={StaticResource B2V}}" Margin="16,12,12,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="T&#x1ED5;ng quan" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AccountingKpiCard}" Margin="0,0,8,8" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="T&#x1ED5;ng m&#xF3;n" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding DashboardTotalItems}" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AccountingKpiCard}" Margin="4,0,4,8" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="C&#xF3; &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding DashboardHasRecipeCount}" FontSize="28" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource AccountingKpiCard}" Margin="8,0,0,8" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="Ch&#x1B0;a &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding DashboardNoRecipeCount}" FontSize="28" FontWeight="Bold" Foreground="#EA580C" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource AccountingKpiCard}" Margin="0,0,8,8" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="S&#x1ED1; nh&#xF3;m m&#xF3;n" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding DashboardCategoryCount}" FontSize="28" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AccountingKpiCard}" Margin="4,0,4,8" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="Ng&#x1B0;ng b&#xE1;n" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding DashboardInactiveCount}" FontSize="28" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource AccountingKpiCard}" Margin="8,0,0,8" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="C&#x1EA3;nh b&#xE1;o" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding DashboardWarningCount}" FontSize="28" FontWeight="Bold" Foreground="#EA580C" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource AccountingPanelCard}" Padding="16" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Thao t&#xE1;c nhanh" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button Content="M&#xF3;n &#x103;n" Tag="&#xE8D4;" Command="{Binding NavigateSectionCommand}" CommandParameter="1" Style="{StaticResource EnterpriseModuleCmdPrimary}" Height="34" FontSize="12"/>
                                        <Button Content="T&#xED;nh gi&#xE1; v&#x1ED1;n" Tag="&#xE8EC;" Command="{Binding NavigateSectionCommand}" CommandParameter="5" Style="{StaticResource EnterpriseModuleCmdSecondary}" Height="34" FontSize="12" Margin="8,0,0,0"/>
                                        <Button Content="C&#x1EA3;nh b&#xE1;o" Tag="&#xE814;" Command="{Binding NavigateSectionCommand}" CommandParameter="6" Style="{StaticResource EnterpriseModuleCmdSecondary}" Height="34" FontSize="12" Margin="8,0,0,0"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
</UserControl>


