<UserControl x:Class="ASMILE.BO.App.Views.MenuRecipe.Screens.MenuIngredientsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ASMILE.BO.App;component/Views/MenuRecipe/MenuRecipeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                <Grid Visibility="{Binding IsSectionIngredients, Converter={StaticResource B2V}}" Margin="16,12,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource AccountingPanelCard}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Nguy&#xEA;n li&#x1EC7;u" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding IngredientSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}" Width="300" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource AccountingPanelCard}" Padding="0">
                        <DataGrid ItemsSource="{Binding FilteredIngredients}" Style="{StaticResource EnterpriseModuleDataGrid}" AutoGenerateColumns="False" RowHeaderWidth="0" RowHeight="36" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="M&#xE3; NVL" Width="100" Binding="{Binding ItemCode}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="T&#xEA;n nguy&#xEA;n li&#x1EC7;u" Width="*" Binding="{Binding ItemName}" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="&#x110;&#x1A1;n v&#x1ECB;" Width="70" Binding="{Binding UnitName}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Gi&#xE1; v&#x1ED1;n" Width="100" Binding="{Binding ReferenceUnitCost, StringFormat={}{0:N0}}" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#2563EB"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="T&#x1ED3;n kho" Width="90" Binding="{Binding AvailableQuantity, StringFormat={}{0:N2}}" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
</UserControl>


