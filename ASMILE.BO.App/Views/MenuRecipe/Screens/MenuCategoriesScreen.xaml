<UserControl x:Class="ASMILE.BO.App.Views.MenuRecipe.Screens.MenuCategoriesScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ASMILE.BO.App;component/Views/MenuRecipe/MenuRecipeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                <!-- SECTION 2: CATEGORIES with detail panel -->
                <Grid Visibility="{Binding IsSectionCategories, Converter={StaticResource B2V}}" Margin="16,12,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- LEFT: Category list -->
                    <Border Grid.Column="0" Style="{StaticResource AccountingPanelCard}" Padding="0" Margin="0,0,12,0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,14,14,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentCategoryCatalogTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Nhóm món"
                                                Margin="0,0,6,0"
                                                Height="28"
                                                MinWidth="88"
                                                FontSize="11"
                                                Command="{Binding SetSelectedMenuCatalogTabCommand}"
                                                CommandParameter="0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource EnterpriseModuleCmdSecondary}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFoodCatalogSelected}" Value="True">
                                                            <Setter Property="Background" Value="#2563EB"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderBrush" Value="#2563EB"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Nhóm dịch vụ"
                                                Height="28"
                                                MinWidth="104"
                                                FontSize="11"
                                                Command="{Binding SetSelectedMenuCatalogTabCommand}"
                                                CommandParameter="1">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource EnterpriseModuleCmdSecondary}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsServiceCatalogSelected}" Value="True">
                                                            <Setter Property="Background" Value="#2563EB"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderBrush" Value="#2563EB"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                                <Button Content="{Binding CreateCategoryButtonText}" Tag="&#xE710;" Style="{StaticResource EnterpriseModuleCmdSecondary}" Height="28" FontSize="11" Padding="8,0" Margin="12,0,0,0" Command="{Binding ShowCreateCategoryCommand}" ToolTip="Thêm nhóm mới"/>
                            </StackPanel>
                            <!-- Create category inline -->
                            <Border Grid.Row="1" Margin="10,0,10,8" Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Visibility="{Binding IsCreatingCategory,Converter={StaticResource B2V}}">
                                <StackPanel>
                                    <TextBlock Text="T&#xEA;n nh&#xF3;m" Style="{StaticResource FLabel}"/>
                                    <TextBox Style="{StaticResource FTextBox}" Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                                    <TextBlock Text="M&#xE3; nh&#xF3;m" Style="{StaticResource FLabel}" Margin="0,8,0,4"/>
                                    <TextBox Style="{StaticResource FTextBox}" Text="{Binding NewCategoryCode, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                                    <TextBlock Text="Nh&#xF3;m cha" Style="{StaticResource FLabel}" Margin="0,8,0,4"/>
                                    <ComboBox ItemsSource="{Binding NewCategoryParentOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding NewCategoryParentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource FCombo}"
                                              Height="30"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="H&#x1EE7;y" Tag="&#xE711;" Command="{Binding CancelCreateCategoryCommand}" Style="{StaticResource EnterpriseModuleCmdSecondary}" Height="28" MinWidth="68" Padding="6,0"/>
                                        <Button Content="L&#x1B0;u nh&#xF3;m" Tag="&#xE74E;" Command="{Binding CreateCategoryCommand}" IsEnabled="{Binding CanSaveCategory,Mode=OneWay}" Style="{StaticResource EnterpriseModuleCmdPrimary}" Height="28" MinWidth="92" Padding="6,0" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="CategoryListBox" Grid.Row="2" ItemsSource="{Binding FilteredCategoryCards}" SelectedItem="{Binding EditingCategory}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="3,0,0,0"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                                <Condition Property="IsSelected" Value="False"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding HierarchyText}" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Code}" FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#E8EDF5" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemCountText}" FontSize="11" Foreground="#475569"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <!-- RIGHT: Detail panel -->
                    <ScrollViewer x:Name="CategoryDetailScrollViewer"
                        Grid.Column="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Width="{Binding ActualWidth, ElementName=CategoryDetailScrollViewer}">
                            <!-- No selection (visible when EditingCategory is null) -->
                            <Border Padding="30" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditingCategory}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#DDE7F3"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="CornerRadius" Value="14"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CategoryEmptySelectionTitle}" FontSize="18" Foreground="#475569" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CategoryEmptySelectionDescription}" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- Category detail (visible when a category is selected) -->
                            <Border Background="White" BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="14" Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditingCategory}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <!-- Header -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding EditCategoryName}" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                <Border CornerRadius="10" Padding="8,2" Background="#E8EDF5" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EditingCategory.ItemCountText}" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding EditCategoryCode}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding EditingCategory.HierarchyText}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Món ăn" Tag="&#xE8D4;" Command="{Binding NavigateSectionCommand}" CommandParameter="1" IsEnabled="{Binding CanManageCategoryMenuItems}" Style="{StaticResource EnterpriseModuleCmdSecondary}" Height="30" FontSize="11" Padding="8,0" ToolTip="Chỉ nhóm con nhóm món mới thêm và quản lý món"/>
                                            <Button Content="X&#xF3;a nh&#xF3;m" Tag="&#xE74D;" Command="{Binding DeleteCategoryCommand}" CommandParameter="{Binding EditingCategory}" IsEnabled="{Binding CanDeleteCategory}" Style="{StaticResource EnterpriseModuleCmdDanger}" Height="30" FontSize="11" Padding="8,0" Margin="6,0,0,0" ToolTip="Xóa nhóm hoặc ngưng sử dụng nếu đang có dữ liệu liên quan"/>
                                            <Button Content="L&#x1B0;u" Tag="&#xE74E;" Command="{Binding SaveCategoryEditCommand}" Style="{StaticResource EnterpriseModuleCmdPrimary}" Height="30" FontSize="11" Padding="10,0" Margin="6,0,0,0" ToolTip="L&#x1B0;u thay &#x111;&#x1ED5;i nh&#xF3;m"/>
                                            <Button Content="Ng&#x1B0;ng SD" Tag="&#xE7BA;" Command="{Binding ToggleCategoryActiveCommand}" CommandParameter="{Binding EditingCategory}" Style="{StaticResource EnterpriseModuleCmdSecondary}" Height="30" FontSize="11" Padding="8,0" Margin="6,0,0,0" ToolTip="Ng&#x1B0;ng s&#x1EED; d&#x1EE5;ng nh&#xF3;m"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- KPIs -->
                                    <Grid Margin="0,14,0,0" Visibility="{Binding ShowCategoryKpis, Converter={StaticResource B2V}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource AccountingKpiCard}" Padding="12,10" Height="72" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="T&#x1ED5;ng m&#xF3;n" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding EditingCategory.ItemCount}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource AccountingKpiCard}" Padding="12,10" Height="72" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Text="&#x110;ang b&#xE1;n" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding CategoryDetailActiveCount}" FontSize="22" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource AccountingKpiCard}" Padding="12,10" Height="72" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="C&#xF3; &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding CategoryDetailRecipeCount}" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <!-- KPI row 2 -->
                                    <Grid Margin="0,8,0,14" Visibility="{Binding ShowCategoryKpis, Converter={StaticResource B2V}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource AccountingKpiCard}" Padding="12,10" Height="60" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Ch&#x1B0;a &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng: " FontSize="12" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding CategoryDetailNoRecipeCount}" FontSize="14" FontWeight="Bold" Foreground="#EA580C"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource AccountingKpiCard}" Padding="12,10" Height="60" Margin="6,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Gi&#xE1; TB: " FontSize="12" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding CategoryDetailAvgPriceDisplay}" FontSize="14" FontWeight="Bold" Foreground="#2563EB"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <!-- Edit form -->
                                    <TextBlock Text="Th&#xF4;ng tin nh&#xF3;m" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="T&#xEA;n nh&#xF3;m" Style="{StaticResource FLabel}"/>
                                            <TextBox Text="{Binding EditCategoryName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="M&#xE3; nh&#xF3;m" Style="{StaticResource FLabel}"/>
                                            <TextBox Text="{Binding EditCategoryCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Nh&#xF3;m cha" Style="{StaticResource FLabel}"/>
                                            <ComboBox ItemsSource="{Binding EditCategoryParentOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding EditCategoryParentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource FCombo}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="6" IsChecked="{Binding EditCategoryIsActive}" Content="&#x110;ang ho&#x1EA1;t &#x111;&#x1ED9;ng" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                    </Grid>
                                    <!-- Items and ingredients in category -->
                                    <Grid Margin="0,18,0,0" Visibility="{Binding ShowCategoryItemsPanel, Converter={StaticResource B2V}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="1.15*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource AccountingPanelCard}" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Danh s&#xE1;ch m&#xF3;n trong nh&#xF3;m" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                                <DataGrid ItemsSource="{Binding CategoryDetailItems}" SelectedItem="{Binding SelectedCategoryMenuItem}"
                          Style="{StaticResource EnterpriseModuleDataGrid}" AutoGenerateColumns="False" RowHeaderWidth="0"
                          RowHeight="40" MaxHeight="260" BorderBrush="#E5E7EB" BorderThickness="1"
                          HorizontalScrollBarVisibility="Disabled" CanUserResizeColumns="False" ColumnHeaderHeight="36">
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Header="M&#xF3;n" Width="2*">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                                        <TextBlock Text="{Binding Code}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="Gi&#xE1;" Width="108" Binding="{Binding UnitPriceDisplay}" IsReadOnly="True" HeaderStyle="{StaticResource CategoryGridNumberHeader}">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CategoryGridNumberText}">
                                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>
                                                        <DataGridTemplateColumn Header="TT" Width="118">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ActiveStatusBadge}" FontSize="11" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding RecipeStatusBadge}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Header="T&#xE1;c v&#x1EE5;" Width="70" HeaderStyle="{StaticResource CategoryGridCenterHeader}">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Button Style="{StaticResource ActionBtn}" Width="26" Height="26"
                                  Command="{Binding DataContext.GoToMenuItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip="Chuy&#x1EC3;n sang m&#xE0;n M&#xF3;n &#x103;n">
                                                                            <TextBlock Text="&#xE8A5;" Style="{StaticResource CategoryGridActionIcon}"/>
                                                                        </Button>
                                                                        <Button Style="{StaticResource ActionBtn}" Width="26" Height="26" Margin="4,0,0,0"
                                  Command="{Binding DataContext.GoToMenuItemRecipeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip="M&#x1EDF; tab &#x110;&#x1ECB;nh l&#x1B0;&#x1EE3;ng">
                                                                            <TextBlock Text="&#xE70F;" Style="{StaticResource CategoryGridActionIcon}"/>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <!-- Empty items state -->
                                                <StackPanel Margin="0,10,0,0" Visibility="Collapsed">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CategoryDetailItems.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Nh&#xF3;m n&#xE0;y ch&#x1B0;a c&#xF3; m&#xF3;n." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Recipe lines for selected item -->
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource AccountingPanelCard}" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Nguy&#xEA;n li&#x1EC7;u &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedCategoryMenuItem}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style></TextBlock>
                                                <DataGrid ItemsSource="{Binding SelectedCategoryRecipeLines}"
                          AutoGenerateColumns="False" RowHeaderWidth="0" RowHeight="36" MaxHeight="260" BorderBrush="#E5E7EB" BorderThickness="1"
                          HorizontalScrollBarVisibility="Disabled" CanUserResizeColumns="False" ColumnHeaderHeight="36">
                                                    <DataGrid.Style>
                                                        <Style TargetType="DataGrid" BasedOn="{StaticResource EnterpriseModuleDataGrid}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasSelectedCategoryRecipeLines}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGrid.Style>
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Header="Nguy&#xEA;n li&#x1EC7;u" Width="2*">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ItemName}"/>
                                                                        <TextBlock Text="{Binding UnitName}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="SL" Width="92" Binding="{Binding Quantity, StringFormat={}{0:N2}}" IsReadOnly="True" HeaderStyle="{StaticResource CategoryGridNumberHeader}">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CategoryGridNumberText}"/>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>
                                                        <DataGridTextColumn Header="Sau HH" Width="100" Binding="{Binding EffectiveQuantity, StringFormat={}{0:N2}}" IsReadOnly="True" HeaderStyle="{StaticResource CategoryGridNumberHeader}">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CategoryGridNumberText}">
                                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>
                                                        <DataGridTextColumn Header="Gi&#xE1;" Width="100" Binding="{Binding EstimatedUnitCost, StringFormat={}{0:N0}}" IsReadOnly="True" HeaderStyle="{StaticResource CategoryGridNumberHeader}">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CategoryGridNumberText}">
                                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <!-- No recipe lines empty state -->
                                                <Border Margin="0,10,0,0" Padding="14" CornerRadius="10" Background="#F8FAFC">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedCategoryMenuItem}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasSelectedCategoryRecipeLines}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="Ch&#x1B0;a c&#xF3; &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng cho m&#xF3;n n&#xE0;y." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                        <Button Content="Nh&#x1EAD;p &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng" Tag="&#xE9D2;" Style="{StaticResource EnterpriseModuleCmdPrimary}" Height="30" FontSize="11" Padding="10,0" HorizontalAlignment="Center" Margin="0,6,0,0"
                            Command="{Binding GoToMenuItemRecipeCommand}" CommandParameter="{Binding SelectedCategoryMenuItem}"/>
                                                    </StackPanel>
                                                </Border>
