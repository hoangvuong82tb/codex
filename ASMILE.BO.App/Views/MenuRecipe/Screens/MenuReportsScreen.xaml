<UserControl x:Class="ASMILE.BO.App.Views.MenuRecipe.Screens.MenuReportsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ASMILE.BO.App;component/Views/MenuRecipe/MenuRecipeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                <Grid Visibility="{Binding IsSectionWarnings, Converter={StaticResource B2V}}" Margin="16,12,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource AccountingPanelCard}" Padding="14" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#EA580C" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="C&#x1EA3;nh b&#xE1;o" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button Content="L&#xE0;m m&#x1EDB;i" Tag="&#xE72C;" Command="{Binding NavigateSectionCommand}" CommandParameter="6" Style="{StaticResource EnterpriseModuleCmdSecondary}" Height="32" FontSize="12" Padding="10,0" Margin="16,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource AccountingPanelCard}" Padding="0">
                        <DataGrid ItemsSource="{Binding AllItemWarnings}" Style="{StaticResource EnterpriseModuleDataGrid}" AutoGenerateColumns="False" RowHeaderWidth="0" RowHeight="34" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="M&#xE3; m&#xF3;n" Width="100" Binding="{Binding ItemCode}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="T&#xEA;n m&#xF3;n" Width="*" Binding="{Binding ItemName}" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="M&#x1EE9;c" Width="70" Binding="{Binding Severity}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="N&#x1ED9;i dung" Width="300" Binding="{Binding Message}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
</UserControl>


