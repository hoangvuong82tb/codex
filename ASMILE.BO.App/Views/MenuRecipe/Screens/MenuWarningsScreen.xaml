<UserControl x:Class="ASMILE.BO.App.Views.MenuRecipe.Screens.MenuWarningsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ASMILE.BO.App;component/Views/MenuRecipe/MenuRecipeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="WarningBadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Visibility="{Binding IsSectionWarnings, Converter={StaticResource B2V}}" Margin="16,14,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AccountingPanelCard}" Padding="18,16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="C&#x1EA3;nh b&#xE1;o m&#xF3;n &#x103;n" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="Theo d&#xF5;i thi&#x1EBF;u &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng, thi&#x1EBF;u gi&#xE1; v&#x1ED1;n, kho h&#x1EBF;t ho&#x1EB7;c kh&#xF4;ng &#x111;&#x1EE7; nguy&#xEA;n li&#x1EC7;u." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="L&#xE0;m m&#x1EDB;i" Tag="&#xE72C;" Command="{Binding NavigateSectionCommand}" CommandParameter="6" Style="{StaticResource EnterpriseModuleCmdInfo}" Height="36" FontSize="12" Padding="12,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource AccountingPanelCard}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="T&#x1ED5;ng c&#x1EA3;nh b&#xE1;o" FontSize="12" Foreground="#64748B"/>
                    <TextBlock Text="{Binding DashboardWarningCount}" FontSize="26" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AccountingPanelCard}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Nghi&#xEA;m tr&#x1ECD;ng" FontSize="12" Foreground="#64748B"/>
                    <TextBlock Text="{Binding CriticalAllWarningCount}" FontSize="26" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AccountingPanelCard}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Kho h&#x1EBF;t / thi&#x1EBF;u" FontSize="12" Foreground="#64748B"/>
                    <TextBlock Text="{Binding StockAllWarningCount}" FontSize="26" FontWeight="SemiBold" Foreground="#EA580C" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AccountingPanelCard}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Gi&#xE1; v&#x1ED1;n / &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng" FontSize="12" Foreground="#64748B"/>
                    <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,4,0,0">
                        <Run Text="{Binding CostAllWarningCount, Mode=OneWay}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding RecipeAllWarningCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource AccountingPanelCard}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding AllItemWarnings}"
                          Style="{StaticResource EnterpriseModuleDataGrid}"
                          Visibility="{Binding HasAllWarnings, Converter={StaticResource B2V}}"
                          AutoGenerateColumns="False"
                          RowHeaderWidth="0"
                          RowHeight="42"
                          ColumnHeaderHeight="38"
                          BorderThickness="0"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="M&#x1EE9;c" Width="112">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F59E0B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="error">
                                                        <Setter Property="Background" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SeverityText}" Style="{StaticResource WarningBadgeText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                <DataGridTextColumn Header="Lo&#x1EA1;i" Binding="{Binding WarningTypeText, Mode=OneWay}" Width="110"/>
                <DataGridTextColumn Header="M&#xE3; m&#xF3;n" Binding="{Binding ItemCode, Mode=OneWay}" Width="95"/>
                <DataGridTextColumn Header="T&#xEA;n m&#xF3;n" Binding="{Binding ItemName, Mode=OneWay}" Width="180"/>
                <DataGridTextColumn Header="Nguy&#xEA;n li&#x1EC7;u" Binding="{Binding IngredientName, Mode=OneWay}" Width="170"/>
                <DataGridTextColumn Header="C&#x1EA7;n" Binding="{Binding RequiredDisplay, Mode=OneWay}" Width="72"/>
                <DataGridTextColumn Header="T&#x1ED3;n" Binding="{Binding AvailableDisplay, Mode=OneWay}" Width="72"/>
                <DataGridTextColumn Header="Thi&#x1EBF;u" Binding="{Binding MissingDisplay, Mode=OneWay}" Width="72"/>
                <DataGridTextColumn Header="N&#x1ED9;i dung chi ti&#x1EBF;t" Binding="{Binding Message, Mode=OneWay}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Visibility="{Binding NoAllWarnings, Converter={StaticResource B2V}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="#16A34A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Kh&#xF4;ng c&#xF3; c&#x1EA3;nh b&#xE1;o" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="C&#xE1;c m&#xF3;n hi&#x1EC7;n kh&#xF4;ng thi&#x1EBF;u &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng, gi&#xE1; v&#x1ED1;n ho&#x1EB7;c t&#x1ED3;n kho ti&#xEA;u hao." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
