<UserControl x:Class="ASMILE.BO.App.Views.MenuRecipe.Screens.MenuPreparationAreasScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ASMILE.BO.App;component/Views/MenuRecipe/MenuRecipeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Visibility="{Binding IsSectionPreparationAreas, Converter={StaticResource B2V}}" Margin="16,12,12,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource AccountingPanelCard}" Padding="18">
            <StackPanel>
                <TextBlock Text="Khu chế biến" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,14"/>
                <TextBlock Text="Mã khu" Style="{StaticResource FLabel}"/>
                <TextBox Text="{Binding EditPreparationAreaCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}" />

                <TextBlock Text="Tên khu" Style="{StaticResource FLabel}" Margin="0,12,0,4"/>
                <TextBox Text="{Binding EditPreparationAreaName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}" />

                <TextBlock Text="Nhóm trạm" Style="{StaticResource FLabel}" Margin="0,12,0,4"/>
                <ComboBox ItemsSource="{Binding PreparationStationGroups}"
                          SelectedItem="{Binding EditPreparationAreaStationGroup}"
                          Style="{StaticResource FCombo}" />

                <CheckBox Content="Đang sử dụng"
                          IsChecked="{Binding EditPreparationAreaIsActive}"
                          FontSize="13"
                          Foreground="#1E293B"
                          Margin="0,12,0,0"/>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Lưu khu chế biến"
                            Tag="&#xE74E;"
                            Command="{Binding SavePreparationAreaSettingsCommand}"
                            IsEnabled="{Binding CanSavePreparationArea}"
                            Style="{StaticResource EnterpriseModuleCmdPrimary}"
                            Height="34"
                            FontSize="12"
                            Padding="10,0"/>
                    <Button Grid.Column="1"
                            Content="Mới"
                            Tag="&#xE710;"
                            Command="{Binding ClearPreparationAreaFormCommand}"
                            Style="{StaticResource EnterpriseModuleCmdSecondary}"
                            Height="34"
                            FontSize="12"
                            Padding="10,0"
                            Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource AccountingPanelCard}" Padding="18">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="Danh sách khu chế biến" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding PreparationAreaSettings.Count, StringFormat=Tổng: {0:N0}}"
                               FontSize="12"
                               Foreground="#64748B"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <DataGrid ItemsSource="{Binding PreparationAreaSettings}"
                          SelectedItem="{Binding SelectedPreparationAreaSetting}"
                          Style="{StaticResource EnterpriseModuleDataGrid}"
                          AutoGenerateColumns="False"
                          RowHeaderWidth="0"
                          RowHeight="40"
                          ColumnHeaderHeight="36"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã khu" Binding="{Binding Code}" Width="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Tên khu" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Nhóm trạm" Binding="{Binding StationGroup}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="120" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Tác vụ" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Sửa"
                                                Command="{Binding DataContext.EditPreparationAreaSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource EnterpriseModuleCmdSecondary}"
                                                Height="28"
                                                MinWidth="72"
                                                FontSize="11"
                                                Padding="8,0"
                                                Margin="0,0,6,0"/>
                                        <Button Content="Xóa"
                                                Command="{Binding DataContext.DeletePreparationAreaSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource EnterpriseModuleCmdDanger}"
                                                Height="28"
                                                MinWidth="72"
                                                FontSize="11"
                                                Padding="8,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
