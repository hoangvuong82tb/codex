<UserControl x:Class="ASMILE.BO.App.Views.MenuRecipe.Screens.MenuCostingScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ASMILE.BO.App;component/Views/MenuRecipe/MenuRecipeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                <Grid Visibility="{Binding IsSectionCost, Converter={StaticResource B2V}}" Margin="16,12,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource AccountingPanelCard}" Padding="16" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="T&#xED;nh gi&#xE1; v&#x1ED1;n" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,14"/>
                            <TextBlock Text="Ph&#x1EA1;m vi" Style="{StaticResource FLabel}"/>
                            <ComboBox SelectedIndex="{Binding CostScopeIndex}" Style="{StaticResource FCombo}" Margin="0,0,0,12">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:String>M&#xF3;n hi&#x1EC7;n t&#x1EA1;i</sys:String>
                                        <sys:String>Theo nh&#xF3;m</sys:String>
                                        <sys:String>T&#x1EA5;t c&#x1EA3;</sys:String>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                            <TextBlock Text="M&#xF3;n chi ti&#x1EBF;t" Style="{StaticResource FLabel}"/>
                            <ComboBox ItemsSource="{Binding MenuCards}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCostMenuCard}" Style="{StaticResource FCombo}" Margin="0,0,0,12" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"/>
                            <TextBlock Text="Nh&#xF3;m m&#xF3;n" Style="{StaticResource FLabel}"/>
                            <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedCostCategoryId}" Style="{StaticResource FCombo}" Margin="0,0,0,12" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"/>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="&#x110;&#x1ED1;i t&#x1B0;&#x1EE3;ng &#x111;ang t&#xED;nh" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CostTargetText}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Button Content="B&#x1EAF;t &#x111;&#x1EA7;u t&#xED;nh" Command="{Binding RunCostCalculationCommand}" Style="{StaticResource EnterpriseModuleCmdInfo}" Tag="&#xE8EC;" Height="38" FontSize="13" Padding="16,0"/>
                            <Border Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding CostProgressText}" FontSize="13" Foreground="#475569"/>
                                    <ProgressBar Height="4" IsIndeterminate="True" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.1*"/>
                            <RowDefinition Height="0.9*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource AccountingPanelCard}" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="&#x110;&#xE3; t&#xED;nh" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CostProcessedCount, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="T&#x1ED5;ng gi&#xE1; v&#x1ED1;n" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CostTotalEstimated, StringFormat={}{0:N0} &#x111;}" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="T&#x1ED5;ng gi&#xE1; b&#xE1;n" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CostTotalSelling, StringFormat={}{0:N0} &#x111;}" FontSize="20" FontWeight="Bold" Foreground="#2563EB"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource AccountingPanelCard}" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Chi ti&#x1EBF;t m&#xF3;n / nh&#xF3;m m&#xF3;n" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding CostDetailRows}" SelectedItem="{Binding SelectedCostDetailRow}" Style="{StaticResource EnterpriseModuleDataGrid}" AutoGenerateColumns="False" RowHeaderWidth="0" RowHeight="36" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="M&#xF3;n" Width="2*" Binding="{Binding Name}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Nh&#xF3;m" Width="1.2*" Binding="{Binding CategoryName}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Gi&#xE1; b&#xE1;n" Width="95" Binding="{Binding SellingPrice, StringFormat={}{0:N0}}" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Gi&#xE1; v&#x1ED1;n" Width="95" Binding="{Binding EstimatedCost, StringFormat={}{0:N0}}" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="LN%" Width="70" Binding="{Binding MarginRate, StringFormat={}{0:P1}}" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="NL" Width="50" Binding="{Binding LineCount}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="CB" Width="50" Binding="{Binding WarningCount}" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource AccountingPanelCard}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Nguy&#xEA;n li&#x1EC7;u &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng c&#x1EE7;a m&#xF3;n &#x111;ang ch&#x1ECD;n" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding CostIngredientRows}" Style="{StaticResource EnterpriseModuleDataGrid}" AutoGenerateColumns="False" RowHeaderWidth="0" RowHeight="34" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nguy&#xEA;n li&#x1EC7;u" Width="2*" Binding="{Binding ItemName}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="SL" Width="75" Binding="{Binding Quantity, StringFormat={}{0:N2}}" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Sau HH" Width="85" Binding="{Binding EffectiveQuantity, StringFormat={}{0:N2}}" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Gi&#xE1;" Width="90" Binding="{Binding UnitCost, StringFormat={}{0:N0}}" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Th&#xE0;nh ti&#x1EC1;n" Width="105" Binding="{Binding LineCost, StringFormat={}{0:N0}}" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="C&#x1EA3;nh b&#xE1;o" Width="1.2*" Binding="{Binding Warning}" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
</UserControl>


