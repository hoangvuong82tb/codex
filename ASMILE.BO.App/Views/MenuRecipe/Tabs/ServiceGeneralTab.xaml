<UserControl x:Class="ASMILE.BO.App.Views.MenuRecipe.Tabs.ServiceGeneralTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ASMILE.BO.App;component/Views/MenuRecipe/MenuRecipeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer Padding="28,28,28,20">
        <Grid MaxWidth="1040">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="Thông tin dịch vụ"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Text="Mã dịch vụ *" Style="{StaticResource FLabel}"/>
                            <TextBox Text="{Binding EditingService.Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Text="Tên dịch vụ *" Style="{StaticResource FLabel}"/>
                            <TextBox Text="{Binding EditingService.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Text="Loại dịch vụ *" Style="{StaticResource FLabel}"/>
                            <ComboBox ItemsSource="{Binding ServiceTypeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Code"
                                      SelectedValue="{Binding EditingService.ServiceType}"
                                      Style="{StaticResource FCombo}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Text="Đơn vị dịch vụ *" Style="{StaticResource FLabel}"/>
                            <TextBox Text="{Binding EditingService.UnitName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}" ToolTip="Ví dụ: lần, bộ, ngày, người"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Text="Đơn giá chuẩn (VNĐ) *" Style="{StaticResource FLabel}"/>
                            <TextBox Text="{Binding ServicePriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                            <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                <TextBlock Text="VAT (%) *"
                                           Style="{StaticResource FLabel}"
                                           VerticalAlignment="Center"/>
                                <CheckBox Content="Giá đã gồm VAT"
                                          IsChecked="{Binding EditingService.IsVatIncluded}"
                                          FontSize="12"
                                          Foreground="#334155"
                                          VerticalContentAlignment="Center"
                                          Margin="12,0,0,0"
                                          HorizontalAlignment="Right"/>
                            </DockPanel>
                            <TextBox Text="{Binding ServiceVatRateText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="Ghi chú phạm vi / cách triển khai" Style="{StaticResource FLabel}"/>
                        <TextBox Text="{Binding EditingService.Note, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FTextBox}"
                                 Height="92"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"/>
                    </StackPanel>

                    <Border Margin="0,14,0,0"
                            Background="#FFFBEB"
                            BorderBrush="#FCD34D"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="Gợi ý nhập liệu"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#92400E"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="• Dịch vụ nên đặt mã ngắn, dễ gọi khi thêm vào báo giá như `MC`, `LED`, `FLOWER`, `SINGER`."
                                       FontSize="12"
                                       Foreground="#78350F"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="• Ghi chú nên mô tả rõ phạm vi dịch vụ hoặc điều kiện áp dụng, ví dụ: `MC dẫn 4 giờ`, `Màn LED 300 inch / 1 buổi`."
                                       FontSize="12"
                                       Foreground="#78350F"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="• Nếu là phụ thu như phí phục vụ, hãy xếp vào loại `Phụ thu / phụ phí` để dễ nhận biết."
                                       FontSize="12"
                                       Foreground="#78350F"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="Đặc thù dịch vụ"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,0,0,16"/>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Phù hợp cho các hạng mục mua ngoài / thuê ngoài"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="MC, Ca sỹ, Cổng hoa, Màn LED, Âm thanh, Ánh sáng, Photobooth, Trang trí..."
                                       FontSize="12"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Nguyên tắc quản lý"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="• Không khai báo định lượng nguyên liệu." FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBlock Text="• Không cần khu chế biến, không vào bếp/bar." FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBlock Text="• Thêm trực tiếp vào báo giá và đơn phục vụ." FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBlock Text="• Đơn giá chuẩn là giá bán mặc định, vẫn có thể điều chỉnh khi lên đơn." FontSize="12" Foreground="#475569"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Tóm tắt nhanh"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#1D4ED8"
                                       Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Loại dịch vụ" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedServiceTypeDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>

                                <TextBlock Grid.Row="1" Text="Đơn giá chuẩn" FontSize="12" Foreground="#64748B" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedServicePriceDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="2" Text="VAT" FontSize="12" Foreground="#64748B" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EditingService.VatRate, StringFormat={}{0:P0}}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,6,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Ảnh dịch vụ" Style="{StaticResource FLabel}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource AccountingPanelCard}" Padding="10" Height="214">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding SelectedImageFullPath}"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding HasImage, Converter={StaticResource B2V}}"/>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding NoImage, Converter={StaticResource B2V}}">
                                        <TextBlock Text="&#xE91B;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="34"
                                                   Foreground="#CBD5E1"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Chưa có ảnh dịch vụ"
                                                   FontSize="12"
                                                   Foreground="#94A3B8"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="Chọn ảnh"
                                        Command="{Binding SelectMenuImageCommand}"
                                        Style="{StaticResource EnterpriseModuleCmdInfo}"
                                        Tag="&#xE8B6;"
                                        Height="32"
                                        FontSize="11"
                                        Padding="8,0"/>
                                <Button Grid.Column="2"
                                        Content="Xóa"
                                        Command="{Binding RemoveMenuImageCommand}"
                                        Style="{StaticResource EnterpriseModuleCmdDanger}"
                                        Tag="&#xE74D;"
                                        Height="32"
                                        FontSize="11"
                                        Padding="8,0"
                                        Visibility="{Binding HasImage, Converter={StaticResource B2V}}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding SelectedImagePath}"
                               FontSize="11"
                               Foreground="#94A3B8"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,6,0,0"
                               ToolTip="{Binding SelectedImagePath}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
