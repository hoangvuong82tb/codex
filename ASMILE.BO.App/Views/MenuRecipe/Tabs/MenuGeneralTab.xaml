<UserControl x:Class="ASMILE.BO.App.Views.MenuRecipe.Tabs.MenuGeneralTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ASMILE.BO.App;component/Views/MenuRecipe/MenuRecipeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                                                <ScrollViewer Padding="28,28,28,20">
                                                    <Grid MaxWidth="960">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="20"/>
                                                                <ColumnDefinition Width="260"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- LEFT: Identity info -->
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding GeneralInfoSectionTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,18"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="12"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                                                        <TextBlock Text="M&#xE3; m&#xF3;n *" Style="{StaticResource FLabel}"/>
                                                                        <TextBox Text="{Binding EditingItem.Code,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                                                        <TextBlock Text="T&#xEA;n m&#xF3;n *" Style="{StaticResource FLabel}"/>
                                                                        <TextBox Text="{Binding EditingItem.Name,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                                                        <TextBlock Text="{Binding CategoryLabelText}" Style="{StaticResource FLabel}"/>
                                                                        <ComboBox ItemsSource="{Binding VisibleMenuCategories}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectedValue="{Binding EditingItem.MenuCategoryId}" Style="{StaticResource FCombo}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                                                        <TextBlock Text="&#x110;&#x1A1;n v&#x1ECB; b&#xE1;n *" Style="{StaticResource FLabel}"/>
                                                                        <TextBox Text="{Binding EditingItem.UnitName,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                                                                        <TextBlock Text="Gi&#xE1; b&#xE1;n (VN&#x110;) *" Style="{StaticResource FLabel}"/>
                                                                        <TextBox Text="{Binding UnitPriceText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                                                                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                                                            <TextBlock Text="VAT (%) *"
                                                                                       Style="{StaticResource FLabel}"
                                                                                       VerticalAlignment="Center"/>
                                                                            <CheckBox Content="Giá đã gồm VAT"
                                                                                      IsChecked="{Binding EditingItem.IsVatIncluded}"
                                                                                      FontSize="12"
                                                                                      Foreground="#334155"
                                                                                      VerticalContentAlignment="Center"
                                                                                      Margin="12,0,0,0"
                                                                                      HorizontalAlignment="Right"/>
                                                                        </DockPanel>
                                                                        <TextBox Text="{Binding VatRateText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0">
                                                                        <TextBlock Text="Ghi ch&#xFA;" Style="{StaticResource FLabel}"/>
                                                                        <TextBox Text="{Binding EditingItem.Note,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}" Height="62" TextWrapping="Wrap" AcceptsReturn="True"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>

                                                            <!-- RIGHT: Settings + Image -->
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Thi&#x1EBF;t l&#x1EAD;p &amp; h&#xEC;nh &#x1EA3;nh" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,18"/>
                                                                <StackPanel Margin="0,0,0,14">
                                                                    <TextBlock Text="Khu ch&#x1EBF; bi&#x1EBF;n" Style="{StaticResource FLabel}"/>
                                                                    <ComboBox ItemsSource="{Binding PreparationAreaSettings}"
                                                                              DisplayMemberPath="Name"
                                                                              SelectedValuePath="Code"
                                                                              SelectedValue="{Binding SelectedPreparationArea}"
                                                                              IsTextSearchEnabled="True"
                                                                              Style="{StaticResource FCombo}"/>
                                                                </StackPanel>
                                                                <StackPanel Margin="0,0,0,14">
                                                                    <TextBlock Text="Tr&#x1EA1;ng th&#xE1;i" Style="{StaticResource FLabel}"/>
                                                                    <Button Content="{Binding ActiveStatusText,Mode=OneWay}" Command="{Binding ToggleActiveCommand}" Style="{StaticResource EnterpriseModuleCmdWarning}" Tag="&#xE7BA;" Height="38" FontSize="13"/>
                                                                </StackPanel>
                                                                <StackPanel Margin="0,0,0,14">
                                                                    <CheckBox Content="Qu&#x1EA3;n l&#xFD; &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng" IsChecked="{Binding EditingItem.HasRecipeManagement}" FontSize="13" Foreground="#1E293B" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                                                                    <CheckBox Content="M&#xF3;n &#x111;&#x1EB7;c tr&#x1B0;ng" IsChecked="{Binding EditingItem.IsCombo}" FontSize="13" Foreground="#1E293B" VerticalContentAlignment="Center"/>
                                                                </StackPanel>
                                                                <!-- Image -->
                                                                <TextBlock Text="&#x1EA2;nh m&#xF3;n &#x103;n" Style="{StaticResource FLabel}"/>
                                                                <Border Style="{StaticResource AccountingPanelCard}" Padding="10" Height="214">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="*"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                                                            <Grid>
                                                                                <Image Source="{Binding SelectedImageFullPath}" Stretch="UniformToFill" Visibility="{Binding HasImage, Converter={StaticResource B2V}}"/>
                                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoImage,Converter={StaticResource B2V}}">
                                                                                    <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="Ch&#x1B0;a c&#xF3; &#x1EA3;nh" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="8"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Button Grid.Column="0" Content="Ch&#x1ECD;n &#x1EA3;nh" Command="{Binding SelectMenuImageCommand}" Style="{StaticResource EnterpriseModuleCmdInfo}" Tag="&#xE8B6;" Height="32" FontSize="11" Padding="8,0"/>
                                                                            <Button Grid.Column="2" Content="X&#xF3;a" Command="{Binding RemoveMenuImageCommand}" Style="{StaticResource EnterpriseModuleCmdDanger}" Tag="&#xE74D;" Height="32" FontSize="11" Padding="8,0" Visibility="{Binding HasImage, Converter={StaticResource B2V}}"/>
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                                <TextBlock Text="{Binding SelectedImagePath}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding SelectedImagePath}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </ScrollViewer>
</UserControl>


