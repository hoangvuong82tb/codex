<UserControl x:Class="ASMILE.BO.App.Views.MenuRecipe.Tabs.MenuRecipeTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ASMILE.BO.App;component/Views/MenuRecipe/MenuRecipeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                                                <ScrollViewer Margin="18,22,18,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="230"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="240"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="1.4*"/>
                                                                <ColumnDefinition Width="82"/>
                                                                <ColumnDefinition Width="76"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Nguy&#xEA;n li&#x1EC7;u" Style="{StaticResource FLabel}"/>
                                                                <ComboBox ItemsSource="{Binding IngredientLookup}" DisplayMemberPath="ItemName" SelectedItem="{Binding SelectedIngredient}" Style="{StaticResource FCombo}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                                <TextBlock Text="Kho" Style="{StaticResource FLabel}"/>
                                                                <ComboBox ItemsSource="{Binding WarehouseLookup}" DisplayMemberPath="WarehouseName" SelectedItem="{Binding SelectedWarehouse}" Style="{StaticResource FCombo}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                                <TextBlock Text="SL" Style="{StaticResource FLabel}"/>
                                                                <TextBox Text="{Binding IngredientQuantityInput,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}" TextAlignment="Right"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                                                <TextBlock Text="HH%" Style="{StaticResource FLabel}"/>
                                                                <TextBox Text="{Binding IngredientLossRateInput,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}" TextAlignment="Right"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                                                <Button Content="Th&#xEA;m" Command="{Binding AddRecipeLineCommand}" Style="{StaticResource EnterpriseModuleCmdPrimary}" Tag="&#xE710;" Height="38" FontSize="12" Padding="12,0" ToolTip="Th&#xEA;m nguy&#xEA;n li&#x1EC7;u"/>
                                                                <Button Content="L&#x1B0;u" Command="{Binding SaveRecipeCommand}" Style="{StaticResource EnterpriseModuleCmdSecondary}" Tag="&#xE74E;" Height="38" FontSize="12" Padding="12,0" Margin="10,0,0,0" ToolTip="L&#x1B0;u &#x111;&#x1ECB;nh l&#x1B0;&#x1EE3;ng"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <Grid Grid.Row="1" Margin="12,0,12,4">
                                                        <DataGrid ItemsSource="{Binding RecipeLines}" SelectedItem="{Binding SelectedRecipeLine, Mode=TwoWay}" Style="{StaticResource EnterpriseModuleDataGrid}" IsReadOnly="False" Visibility="{Binding HasRecipeLines,Converter={StaticResource B2V}}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" RowHeight="34" ColumnHeaderHeight="36" BorderBrush="#E5E7EB" BorderThickness="1" SelectionUnit="FullRow" PreviewMouseLeftButtonDown="RecipeGrid_PreviewMouseLeftButtonDown">
                                                            <DataGrid.Resources>
                                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource AccountingGridCell}">
                                                                    <Setter Property="Padding" Value="6,0"/>
                                                                </Style>
                                                            </DataGrid.Resources>
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="STT" Width="34" Binding="{Binding LineNo}" IsReadOnly="True"/>
                                                                <DataGridTextColumn Header="Nguy&#xEA;n li&#x1EC7;u" Width="2*" MinWidth="150" Binding="{Binding ItemName}" IsReadOnly="True">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            <Setter Property="Foreground" Value="#0F172A"/>
                                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                                <DataGridTextColumn Header="&#x110;VT" Width="45" Binding="{Binding UnitName}" IsReadOnly="True"/>
                                                                <DataGridTemplateColumn Header="SL &#x111;&#x1ECB;nh m&#x1EE9;c" Width="90">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Quantity, StringFormat={}{0:N2}}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                                        <DataTemplate>
                                                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTemplateColumn Header="HH%" Width="55">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding LossRatePercent, StringFormat={}{0:N1}}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                                        <DataTemplate>
                                                                            <TextBox Text="{Binding LossRatePercent, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTextColumn Header="SL sau HH" Width="75" IsReadOnly="True">
                                                                    <DataGridTextColumn.Binding>
                                                                        <Binding Path="EffectiveQuantity" StringFormat="{}{0:N2}"/>
                                                                    </DataGridTextColumn.Binding>
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            <Setter Property="Foreground" Value="#2563EB"/>
                                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                                <DataGridTextColumn Header="Kho" Width="*" MinWidth="90" Binding="{Binding WarehouseDisplay}" IsReadOnly="True">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                                <DataGridTextColumn Header="Gi&#xE1; v&#x1ED1;n" Width="70" Binding="{Binding EstimatedUnitCost, StringFormat={}{0:N0}}" IsReadOnly="True">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                                <DataGridTemplateColumn Header="BB" Width="40">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox IsChecked="{Binding IsRequired}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTemplateColumn Header="Ghi ch&#xFA;" Width="*" MinWidth="90">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Note}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                                        <DataTemplate>
                                                                            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTemplateColumn Header="Thao t&#xE1;c" Width="75">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                                <Button Style="{StaticResource ActionBtn}" ToolTip="L&#xEA;n" Command="{Binding DataContext.MoveRecipeLineUpCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}">
                                                                                    <TextBlock Text="&#xE74A;" Style="{StaticResource CategoryGridActionIcon}"/>
                                                                                </Button>
                                                                                <Button Style="{StaticResource ActionBtn}" ToolTip="Xu&#x1ED1;ng" Command="{Binding DataContext.MoveRecipeLineDownCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}">
                                                                                    <TextBlock Text="&#xE74B;" Style="{StaticResource CategoryGridActionIcon}"/>
                                                                                </Button>
                                                                                <Button Style="{StaticResource ActionDelBtn}" ToolTip="X&#xF3;a" Command="{Binding DataContext.RemoveRecipeLineCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}">
                                                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource CategoryGridActionIcon}"/>
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <StackPanel Visibility="{Binding NoRecipeLines,Converter={StaticResource B2V}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="Ch&#x1B0;a c&#xF3; nguy&#xEA;n li&#x1EC7;u" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Ch&#x1ECD;n nguy&#xEA;n li&#x1EC7;u + Th&#xEA;m." FontSize="12" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Border Grid.Row="2" Margin="12,0,12,10" Padding="10,6" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Visibility="{Binding HasRecipeFooter,Converter={StaticResource B2V}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding TotalIngredientsText}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TotalEffectiveQuantityDisplay}" FontSize="12" Foreground="#2563EB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="12" Margin="12,4,12,12">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                                                <TextBlock Text="Nguyên liệu thay thế" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding SelectedRecipeLine.ItemName, StringFormat= - {0}}" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center" Margin="6,1,0,0"/>
                                                            </StackPanel>
                                                            <Grid Grid.Row="1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*"/>
                                                                    <ColumnDefinition Width="96"/>
                                                                    <ColumnDefinition Width="86"/>
                                                                    <ColumnDefinition Width="116"/>
                                                                    <ColumnDefinition Width="1.4*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="Nguyên liệu thay thế" Style="{StaticResource FLabel}"/>
                                                                    <ComboBox ItemsSource="{Binding AvailableSubstituteItems}" DisplayMemberPath="ItemName" SelectedItem="{Binding SelectedSubstituteItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FCombo}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                                    <TextBlock Text="Tỷ lệ" Style="{StaticResource FLabel}"/>
                                                                    <TextBox Text="{Binding SubstituteConversionRate,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}" TextAlignment="Right"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                                    <TextBlock Text="Ưu tiên" Style="{StaticResource FLabel}"/>
                                                                    <TextBox Text="{Binding SubstitutePriority,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}" TextAlignment="Right"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                                                    <TextBlock Text="Tự động" Style="{StaticResource FLabel}"/>
                                                                    <CheckBox Content="Cho phép" IsChecked="{Binding SubstituteAutoReplace}" Height="38" VerticalContentAlignment="Center" Foreground="#334155"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="4" Margin="10,0,0,0">
                                                                    <TextBlock Text="Ghi chú" Style="{StaticResource FLabel}"/>
                                                                    <TextBox Text="{Binding SubstituteNotes,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FTextBox}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                                                    <Button Content="Thêm" Command="{Binding AddSubstituteCommand}" Style="{StaticResource EnterpriseModuleCmdPrimary}" Tag="&#xE710;" Height="38" FontSize="12" Padding="12,0" ToolTip="Thêm nguyên liệu thay thế"/>
                                                                    <Button Content="Lưu" Command="{Binding SaveSubstituteCommand}" Style="{StaticResource EnterpriseModuleCmdSecondary}" Tag="&#xE74E;" Height="38" FontSize="12" Padding="12,0" Margin="10,0,0,0" ToolTip="Lưu nguyên liệu thay thế"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                    <Grid Grid.Row="4" Margin="12,0,12,10">
                                                        <DataGrid ItemsSource="{Binding SubstituteIngredients}" SelectedItem="{Binding SelectedSubstituteIngredient, Mode=TwoWay}" Style="{StaticResource EnterpriseModuleDataGrid}" IsReadOnly="True" Visibility="{Binding HasSubstituteIngredients,Converter={StaticResource B2V}}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" RowHeight="34" ColumnHeaderHeight="36" BorderBrush="#E5E7EB" BorderThickness="1">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="STT" Width="42" Binding="{Binding RowNo}"/>
                                                                <DataGridTextColumn Header="Nguyên liệu thay thế" Width="2*" MinWidth="160" Binding="{Binding SubstituteItemName}"/>
                                                                <DataGridTextColumn Header="Tỷ lệ" Width="70" Binding="{Binding ConversionRate, StringFormat={}{0:N2}}">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CategoryGridNumberText}"/>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                                <DataGridTextColumn Header="Ưu tiên" Width="70" Binding="{Binding Priority}">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CategoryGridNumberText}"/>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                                <DataGridTemplateColumn Header="Tự động" Width="70">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox IsChecked="{Binding AutoReplace}" IsEnabled="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTextColumn Header="Ghi chú" Width="*" MinWidth="120" Binding="{Binding Notes}"/>
                                                                <DataGridTextColumn Header="Ngày tạo" Width="105" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy}}"/>
                                                                <DataGridTemplateColumn Header="Thao tác" Width="76">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <Button Style="{StaticResource ActionDelBtn}" ToolTip="Xóa" Command="{Binding DataContext.DeleteSubstituteCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" HorizontalAlignment="Center">
                                                                                <TextBlock Text="&#xE74D;" Style="{StaticResource CategoryGridActionIcon}"/>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <StackPanel Visibility="{Binding NoSubstituteIngredients,Converter={StaticResource B2V}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="Chưa có nguyên liệu thay thế" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Thêm nguyên liệu thay thế để sử dụng khi nguyên liệu chính không đủ tồn kho." FontSize="12" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                                </ScrollViewer>
</UserControl>


