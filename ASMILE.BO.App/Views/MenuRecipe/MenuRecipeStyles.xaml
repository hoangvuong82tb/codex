<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="FTextBox" TargetType="TextBox" BasedOn="{StaticResource EnterpriseModuleTextBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="FCombo" TargetType="ComboBox" BasedOn="{StaticResource EnterpriseModuleComboBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        <Style x:Key="FLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FLabelReq" TargetType="TextBlock" BasedOn="{StaticResource FLabel}">
            <Setter Property="Text" Value="{Binding RelativeSource={RelativeSource Self}, StringFormat='{}{0} *'}"/>
        </Style>
        <!-- Tab style -->
        <Style x:Key="RecipeTabButton" TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="TabIcon" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="TabIcon" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="">
                                <Setter TargetName="TabIcon" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sidebar button styles (unchanged) -->
        <Style x:Key="SBtnBase" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="0,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SBtn0" TargetType="Button" BasedOn="{StaticResource SBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="0">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SBtn1" TargetType="Button" BasedOn="{StaticResource SBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="1">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SBtn2" TargetType="Button" BasedOn="{StaticResource SBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="2">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SBtn3" TargetType="Button" BasedOn="{StaticResource SBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="3">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SBtn4" TargetType="Button" BasedOn="{StaticResource SBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="4">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SBtn5" TargetType="Button" BasedOn="{StaticResource SBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="5">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SBtn6" TargetType="Button" BasedOn="{StaticResource SBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="6">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SBtn8" TargetType="Button" BasedOn="{StaticResource SBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="8">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Small action buttons use the same Win11 icon-button surface as shared enterprise dialogs. -->
        <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource EnterpriseDialogIconButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#FCFEFF"/>
            <Setter Property="BorderBrush" Value="#D4DEE9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ActionDelBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0,8,0"/>
        </Style>
        <Style x:Key="CategoryGridNumberHeader" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="8,0,12,0"/>
        </Style>
        <Style x:Key="CategoryGridCenterHeader" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="CategoryGridNumberText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CategoryGridActionIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
</ResourceDictionary>
