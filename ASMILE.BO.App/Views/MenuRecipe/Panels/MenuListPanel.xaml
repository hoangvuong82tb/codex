<UserControl x:Class="ASMILE.BO.App.Views.MenuRecipe.Panels.MenuListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ASMILE.BO.App;component/Views/MenuRecipe/MenuRecipeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                    <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Header with count -->
                            <Border Grid.Row="0" Padding="14,12,14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentMenuCatalogTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding LastUpdatedDisplay}" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="Món ăn"
                                                    Margin="0,0,6,0"
                                                    Height="28"
                                                    MinWidth="78"
                                                    FontSize="11"
                                                    Command="{Binding SetSelectedMenuCatalogTabCommand}"
                                                    CommandParameter="0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource EnterpriseModuleCmdSecondary}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFoodCatalogSelected}" Value="True">
                                                                <Setter Property="Background" Value="#2563EB"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Dịch vụ"
                                                    Height="28"
                                                    MinWidth="78"
                                                    FontSize="11"
                                                    Command="{Binding SetSelectedMenuCatalogTabCommand}"
                                                    CommandParameter="1">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource EnterpriseModuleCmdSecondary}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsServiceCatalogSelected}" Value="True">
                                                                <Setter Property="Background" Value="#2563EB"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding CreateMenuButtonText}" Tag="&#xE710;" Style="{StaticResource EnterpriseModuleCmdSecondary}" Height="28" FontSize="11" Padding="6,0"
                        ToolTip="Th&#xEA;m m&#xF3;n m&#x1EDB;i" Command="{Binding CreateNewMenuCommand}"/>
                                </Grid>
                            </Border>
                            <!-- Search -->
                            <Border Grid.Row="1" Margin="10,0,10,4">
                                <StackPanel>
                                    <TextBlock Text="T&#xEC;m ki&#x1EBF;m" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                    <TextBox Style="{StaticResource FTextBox}" Height="32" ToolTip="T&#xEC;m theo m&#xE3; ho&#x1EB7;c t&#xEA;n m&#xF3;n" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Border>
                            <!-- Category filter -->
                            <Border Grid.Row="2" Margin="10,6,10,0">
                                <Grid>
                                    <TextBlock Text="Nhóm món:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" Visibility="{Binding ShowFoodCatalogFilters, Converter={StaticResource B2V}}"/>
                                    <TextBlock Text="Loại dịch vụ:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" Visibility="{Binding ShowServiceTypeFilter, Converter={StaticResource B2V}}"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="3" Margin="10,0,10,4">
                                <Grid>
                                    <ComboBox ItemsSource="{Binding VisibleMenuCategories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FilterCategoryId}" Style="{StaticResource FCombo}" Height="32" FontSize="12" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" Visibility="{Binding ShowFoodCatalogFilters, Converter={StaticResource B2V}}"/>
                                    <ComboBox ItemsSource="{Binding ServiceTypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding SelectedServiceTypeFilter}" Style="{StaticResource FCombo}" Height="32" FontSize="12" Visibility="{Binding ShowServiceTypeFilter, Converter={StaticResource B2V}}"/>
                                </Grid>
                            </Border>
                            <!-- Filter chips -->
                            <Border Grid.Row="4" Margin="10,0,10,4">
                                <ItemsControl ItemsSource="{Binding FilterChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding .}" Margin="0,0,4,4" Height="24" FontSize="10" Padding="8,0" Command="{Binding DataContext.SelectFilterChipCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="chip" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="chip" Property="Background" Value="#E2E8F0"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <!-- Menu items list -->
                            <Grid Grid.Row="5">
                                <Grid>
                                    <ListBox ItemsSource="{Binding FilteredMenuCards}" SelectedItem="{Binding SelectedMenuCard}" SelectionMode="Single" BorderThickness="0" Background="Transparent" Visibility="{Binding HasMenuItems,Converter={StaticResource B2V}}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="bd" Background="Transparent" Cursor="Hand" BorderThickness="0,0,0,0">
                                                                <ContentPresenter Margin="0"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#EEF4FF"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                                                    <Setter TargetName="bd" Property="BorderThickness" Value="3,0,0,0"/>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                        <Condition Property="IsSelected" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="14,10" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                            <Border Grid.Column="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsInactive}" Value="False">
                                                                                <Setter Property="Background" Value="#1D4ED8"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsInactive}" Value="True">
                                                                                <Setter Property="Background" Value="#94A3B8"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding ActiveStatusBadge}" FontSize="9" Foreground="White"/>
                                                            </Border>
                                                        </Grid>
                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding Code}" FontSize="11" Foreground="#94A3B8"/>
                                                            <TextBlock Text=" - " FontSize="11" Foreground="#CBD5E1"/>
                                                            <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Grid Grid.Row="2" Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding UnitPriceDisplay}" FontSize="14" Foreground="#2563EB" FontWeight="SemiBold"/>
                                                            <Border Grid.Column="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasRecipe}" Value="True">
                                                                                <Setter Property="Background" Value="#16A34A"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding HasRecipe}" Value="False">
                                                                                <Setter Property="Background" Value="#94A3B8"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding RecipeStatusBadge}" FontSize="9" Foreground="White"/>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Visibility="{Binding NoMenuItems,Converter={StaticResource B2V}}" HorizontalAlignment="Center" Margin="0,20,0,0">
                                        <TextBlock Text="{Binding NoItemsFoundText}" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        <Button Content="X&#xF3;a b&#x1ED9; l&#x1ECD;c" Tag="&#xE71C;" Command="{Binding RefreshAllCommand}" Style="{StaticResource EnterpriseModuleCmdSecondary}" Height="30" FontSize="11" Padding="10,0" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
</UserControl>


