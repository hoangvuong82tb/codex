<UserControl x:Class="ASMILE.BO.App.Views.MenuRecipe.Panels.MenuSidebarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ASMILE.BO.App;component/Views/MenuRecipe/MenuRecipeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="0,10,0,0">
                        <Button Command="{Binding ToggleSidebarCommand}"
                    Style="{StaticResource SBtnBase}"
                    Height="38"
                    ToolTip="{Binding SidebarToggleToolTip}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding SidebarToggleGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Danh m&#x1EE5;c" Visibility="{Binding SidebarTextVisibility}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Height="1" Background="#E5E7EB" Margin="10,6,10,8"/>
                        <Button Style="{StaticResource SBtn0}" Command="{Binding NavigateSectionCommand}" CommandParameter="0" ToolTip="T&#x1ED5;ng quan">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" TextAlignment="Center"/>
                                <TextBlock Text="T&#x1ED5;ng quan" Visibility="{Binding SidebarTextVisibility}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SBtn1}" Command="{Binding NavigateSectionCommand}" CommandParameter="1" ToolTip="M&#xF3;n &#x103;n">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" TextAlignment="Center"/>
                                <TextBlock Text="M&#xF3;n &#x103;n" Visibility="{Binding SidebarTextVisibility}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SBtn2}" Command="{Binding NavigateSectionCommand}" CommandParameter="2" ToolTip="Nh&#xF3;m m&#xF3;n">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" TextAlignment="Center"/>
                                <TextBlock Text="Nh&#xF3;m m&#xF3;n" Visibility="{Binding SidebarTextVisibility}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SBtn4}" Command="{Binding NavigateSectionCommand}" CommandParameter="4" ToolTip="Khu ch&#x1EBF; bi&#x1EBF;n">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" TextAlignment="Center"/>
                                <TextBlock Text="Khu ch&#x1EBF; bi&#x1EBF;n" Visibility="{Binding SidebarTextVisibility}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SBtn3}" Command="{Binding NavigateSectionCommand}" CommandParameter="3" ToolTip="Nguy&#xEA;n li&#x1EC7;u">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" TextAlignment="Center"/>
                                <TextBlock Text="Nguy&#xEA;n li&#x1EC7;u" Visibility="{Binding SidebarTextVisibility}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SBtn5}" Command="{Binding NavigateSectionCommand}" CommandParameter="5" ToolTip="Gi&#xE1; v&#x1ED1;n">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" TextAlignment="Center"/>
                                <TextBlock Text="Gi&#xE1; v&#x1ED1;n" Visibility="{Binding SidebarTextVisibility}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SBtn6}" Command="{Binding NavigateSectionCommand}" CommandParameter="6" ToolTip="C&#x1EA3;nh b&#xE1;o">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" TextAlignment="Center"/>
                                <TextBlock Text="C&#x1EA3;nh b&#xE1;o" Visibility="{Binding SidebarTextVisibility}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SBtn8}" Command="{Binding NavigateSectionCommand}" CommandParameter="8" ToolTip="C&#xE0;i &#x111;&#x1EB7;t">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" TextAlignment="Center"/>
                                <TextBlock Text="C&#xE0;i &#x111;&#x1EB7;t" Visibility="{Binding SidebarTextVisibility}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
</UserControl>


