<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ASMILE.BO.App.Views.AssetManagementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" xmlns:controls="clr-namespace:ASMILE.BO.App.Controls" FontFamily="Segoe UI, Segoe UI Variable Text" UseLayoutRounding="True" SnapsToDevicePixels="True" xmlns:views="clr-namespace:ASMILE.BO.App.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}" BasedOn="{StaticResource EnterpriseModuleTextBox}" />
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource EnterpriseModuleComboBox}" />
      <Style x:Key="{x:Type DatePicker}" TargetType="{x:Type DatePicker}" BasedOn="{StaticResource EnterpriseModuleDatePicker}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="#F0FEFF" />
        <Setter Property="BorderBrush" Value="#C4D2E4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#243B5D" />
        <Setter Property="Padding" Value="10,0,34,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type DatePicker}">
              <Grid>
                <Border Name="Root" CornerRadius="12" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
                  <Grid>
                    <primitives:DatePickerTextBox Name="PART_TextBox" BorderThickness="0" Background="#00FFFFFF" Foreground="{TemplateBinding Control.Foreground}" Padding="{TemplateBinding Control.Padding}" VerticalContentAlignment="Center" />
                    <primitives:ToggleButton Name="PART_Button" Width="30" HorizontalAlignment="Right" Margin="0,1,1,1" BorderThickness="0" Background="#00FFFFFF" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                      <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#5D7292" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </primitives:ToggleButton>
                  </Grid>
                </Border>
                <primitives:Popup Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                  <Border Margin="0,6,0,0" Background="#FFFFFFFF" BorderBrush="#D4DEEB" BorderThickness="1" CornerRadius="12" Padding="6">
                    <Calendar Name="PART_Calendar" BorderThickness="0" Background="#FFFFFFFF" />
                  </Border>
                </primitives:Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Root" Property="Border.BorderBrush" Value="#6D9FE3" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Root" Property="Border.BorderBrush" Value="#AEC3DE" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.55" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="#1E293B" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="{x:Type TabControl}" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
      </Style>
      <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}" BasedOn="{StaticResource AccountingTabButton}">
        <Setter Property="Margin" Value="0,0,6,0" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#F6F8FB">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <controls:EnterpriseCommandToolbar Grid.Row="0" SearchPlaceholder="Tìm mã, tên tài sản hoặc nhóm tài sản..." RefreshText="Làm mới" ShowExportImport="False" Margin="18,14,18,0" SearchText="{Binding PermissionFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RefreshCommand="{Binding RefreshCommand}">
      <controls:EnterpriseCommandToolbar.ActionsContent>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Content="Chạy báo cáo" Command="{Binding RunReportCommand}" />
        </StackPanel>
      </controls:EnterpriseCommandToolbar.ActionsContent>
    </controls:EnterpriseCommandToolbar>
    <DockPanel Grid.Row="1" Margin="18,14,18,12">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="TSCD &amp; CCDC" Style="{StaticResource AppTitleTextStyle}" />
        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" Text="{Binding StatusText}" />
      </StackPanel>
      <primitives:UniformGrid DockPanel.Dock="Right" Columns="5" Width="960">
        <controls:EnterpriseSummaryCard Title="Giá trị TSCD" Subtitle="Giá trị còn lại" IconGlyph="" Margin="0,0,10,0" Value="{Binding FixedAssetValueText}" />
        <controls:EnterpriseSummaryCard Title="Nguyên giá" IconGlyph="" Margin="0,0,10,0" Value="{Binding TotalOriginaloost, StringFormat=N0}" Subtitle="{Binding TotalAccumulatedDepreciation, StringFormat=KH lũy kế {0:N0}}" />
        <controls:EnterpriseSummaryCard Title="Giá trị CCDC" Subtitle="Giá trị còn lại" IconGlyph="" Margin="0,0,10,0" Value="{Binding ToolAssetValueText}" />
        <controls:EnterpriseSummaryCard Title="Đã phân bổ" IconGlyph="" Margin="0,0,10,0" Value="{Binding TotalAllocatedAmCount, StringFormat=N0}" Subtitle="{Binding TotalToolRemainingAmCount, StringFormat=Còn lại {0:N0}}" />
        <controls:EnterpriseSummaryCard Title="Theo dõi bút toán" Subtitle="Tài sản đang tải" IconGlyph="" Value="{Binding FixedAssets.Count}" />
      </primitives:UniformGrid>
    </DockPanel>
    <controls:EnterpriseStatePresenter Grid.Row="2" EmptyText="Chưa có dữ liệu TSCD/CCDC." IsLoading="{Binding IsBusy}">
      <controls:EnterpriseStatePresenter.StateContent>
        <Grid Margin="18,0,18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:EnterpriseFilterPanel Grid.Column="0" Title="Bộ lọc" Margin="0,0,12,0">
            <controls:EnterpriseFilterPanel.PanelContent>
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Text="TSCD/CCDC từ dữ liệu đã lưu" Foreground="#64748B" Margin="0,2,0,12" />
                  <TextBlock Text="Từ ngày" Foreground="#475569" />
                  <DatePicker Margin="0,4,0,10" SelectedDate="{Binding FromDate}" />
                  <TextBlock Text="Đến ngày" Foreground="#475569" />
                  <DatePicker Margin="0,4,0,10" SelectedDate="{Binding ToDate}" />
                  <TextBlock Text="Kỳ xử lý" Foreground="#475569" />
                  <TextBox Margin="0,4,0,10" Text="{Binding PeriodoCode, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Text="Tìm kiếm" Foreground="#475569" />
                  <TextBox Margin="0,4,0,12" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" HorizontalAlignment="Left" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Áp dụng" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                  <TextBlock Text="Kiểm tra trực tiếp" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ValidationMessages}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                            <StackPanel>
                              <TextBlock FontWeight="SemiBold" Foreground="#9A3412">
                                <Run Text="{Binding Severity}" />
                                <Run Text=" - " />
                                <Run Text="{Binding Scope}" />
                              </TextBlock>
                              <TextBlock Foreground="#334155" TextWrapping="Wrap" Text="{Binding Message}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </DockPanel>
            </controls:EnterpriseFilterPanel.PanelContent>
          </controls:EnterpriseFilterPanel>
          <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="TSCD">
              <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource EnterpriseModulePanelCard}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150" />
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="100" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" DisplayMemberPath="oCategoryName" ItemsSource="{Binding FixedAssetoategories}" SelectedItem="{Binding SelectedFixedAssetoCategory}" />
                    <TextBox Grid.Column="1" Margin="8,0,0,0" ToolTip="Mã tài sản" Text="{Binding QuickFixedAsset.AssetoCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" Margin="8,0,0,0" ToolTip="Tên tài sản" Text="{Binding QuickFixedAsset.AssetName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="3" Margin="8,0,0,0" ToolTip="Nguyên giá" Text="{Binding QuickFixedAsset.Originaloost, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="4" Margin="8,0,0,0" ToolTip="Tài khoản đối ứng" Text="{Binding QuickFixedAsset.oCounterAccCountoCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="5" Margin="8,0,0,0" ToolTip="Thời gian khấu hao" Text="{Binding QuickFixedAsset.UsefulLifeMonths, UpdateSourceTrigger=PropertyChanged}" />
                    <DatePicker Grid.Column="6" Margin="8,0,0,0" SelectedDate="{Binding QuickFixedAsset.PurchaseDate}" />
                    <Button Grid.Column="7" Style="{StaticResource EnterpriseModuleCmdPrimary}" Command="{Binding CreateFixedAssetCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                        <TextBlock Text="Tạo" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
                <DataGrid Grid.Row="1" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding FixedAssets}" SelectedItem="{Binding SelectedFixedAsset}" PreviewKeyDown="FixedAssetGrid_PreviewKeyDown">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Width="120" Binding="{Binding AssetoCode}" />
                    <DataGridTextColumn Header="Tên TSCD" Width="2*" Binding="{Binding AssetName}" />
                    <DataGridTextColumn Header="Nhóm" Width="150" Binding="{Binding CCategoryName}" />
                    <DataGridTextColumn Header="Ngày mua" Width="95" Binding="{Binding PurchaseDate, StringFormat=dd/MM/yyyy}" />
                    <DataGridTextColumn Header="Nguyên giá" Width="120" Binding="{Binding Originaloost, StringFormat=N0}" />
                    <DataGridTextColumn Header="KH lũy kế" Width="120" Binding="{Binding AccumulatedDepreciation, StringFormat=N0}" />
                    <DataGridTextColumn Header="Còn lại" Width="120" Binding="{Binding RemainingValue, StringFormat=N0}" />
                    <DataGridTextColumn Header="PP KH" Width="105" Binding="{Binding DepreciationMethod}" />
                    <DataGridTextColumn Header="Trạng thái" Width="95" Binding="{Binding Status}" />
                    <DataGridTextColumn Header="Bút toán" Width="150" Binding="{Binding JournalHeaderId}" />
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding ApproveFixedAssetCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Duyệt" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Command="{Binding PostFixedAssetCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Ghi sổ" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding oCancelFixedAssetApprovalCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Hủy duyệt" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding ReverseFixedAssetCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Đảo bút toán" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding DisposeFixedAssetCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Ghi giảm" />
                    </StackPanel>
                  </Button>
                  <ComboBox Width="130" DisplayMemberPath="Label" Margin="0,0,8,0" ItemsSource="{Binding AdjustmentTypes}" SelectedItem="{Binding QuickFixedAsset.AdjustmentType}" />
                  <TextBox Width="110" Margin="0,0,8,0" Text="{Binding QuickFixedAsset.AdjustmentAmCount, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding AdjustFixedAssetCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Điều chỉnh" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding OpenSelectedDrilldownCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Xem chi tiết" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem Header="Khấu hao">
              <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="170" />
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding Depreciations}" SelectedItem="{Binding SelectedDepreciation}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Kỳ" Width="95" Binding="{Binding DepreciationPeriod}" />
                    <DataGridTextColumn Header="Ngày" Width="95" Binding="{Binding DepreciationDate, StringFormat=dd/MM/yyyy}" />
                    <DataGridTextColumn Header="Mã TSCD" Width="120" Binding="{Binding AssetoCode}" />
                    <DataGridTextColumn Header="Tên TSCD" Width="2*" Binding="{Binding AssetName}" />
                    <DataGridTextColumn Header="Khấu hao" Width="120" Binding="{Binding DepreciationAmCount, StringFormat=N0}" />
                    <DataGridTextColumn Header="Lũy kế" Width="120" Binding="{Binding AccumulatedAfter, StringFormat=N0}" />
                    <DataGridTextColumn Header="Còn lại" Width="120" Binding="{Binding RemainingValueAfter, StringFormat=N0}" />
                    <DataGridTextColumn Header="Trạng thái" Width="95" Binding="{Binding Status}" />
                    <DataGridTextColumn Header="Bút toán" Width="150" Binding="{Binding JournalHeaderId}" />
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding PreviewDepreciationCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Xem trước" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Command="{Binding BatchDepreciationCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Ghi sổ hàng loạt" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding PostSelectedDepreciationCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Ghi sổ dòng chọn" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding ReverseDepreciationCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Đảo bút toán" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <DataGrid Grid.Row="2" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding DepreciationSchedule}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Kỳ kế hoạch" Width="110" Binding="{Binding Period}" />
                    <DataGridTextColumn Header="Ngày" Width="105" Binding="{Binding DepreciationDate, StringFormat=dd/MM/yyyy}" />
                    <DataGridTextColumn Header="Khấu hao" Width="130" Binding="{Binding DepreciationAmCount, StringFormat=N0}" />
                    <DataGridTextColumn Header="Lũy kế sau" Width="130" Binding="{Binding AccumulatedAfter, StringFormat=N0}" />
                    <DataGridTextColumn Header="Còn lại sau" Width="130" Binding="{Binding RemainingValueAfter, StringFormat=N0}" />
                    <DataGridTextColumn Header="Trạng thái" Width="100" Binding="{Binding Status}" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>
            <TabItem Header="CCDC">
              <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource EnterpriseModulePanelCard}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150" />
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" DisplayMemberPath="oCategoryName" ItemsSource="{Binding ToolAssetoategories}" SelectedItem="{Binding SelectedToolAssetoCategory}" />
                    <TextBox Grid.Column="1" Margin="8,0,0,0" ToolTip="Mã CCDC" Text="{Binding QuickToolAsset.TooloCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" Margin="8,0,0,0" ToolTip="Tên CCDC" Text="{Binding QuickToolAsset.ToolName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="3" Margin="8,0,0,0" ToolTip="Nguyên giá" Text="{Binding QuickToolAsset.Originaloost, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="4" Margin="8,0,0,0" ToolTip="Số lượng" Text="{Binding QuickToolAsset.Quantity, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="5" Margin="8,0,0,0" ToolTip="Số kỳ phân bổ" Text="{Binding QuickToolAsset.AllocationMonths, UpdateSourceTrigger=PropertyChanged}" />
                    <DatePicker Grid.Column="6" Margin="8,0,0,0" SelectedDate="{Binding QuickToolAsset.PurchaseDate}" />
                    <Button Grid.Column="7" Style="{StaticResource EnterpriseModuleCmdPrimary}" Command="{Binding CreateToolAssetCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                        <TextBlock Text="Tạo" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
                <DataGrid Grid.Row="1" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding ToolAssets}" SelectedItem="{Binding SelectedToolAsset}" PreviewKeyDown="ToolAssetGrid_PreviewKeyDown">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Width="120" Binding="{Binding TooloCode}" />
                    <DataGridTextColumn Header="Tên CCDC" Width="2*" Binding="{Binding ToolName}" />
                    <DataGridTextColumn Header="Nhóm" Width="150" Binding="{Binding CCategoryName}" />
                    <DataGridTextColumn Header="Ngày mua" Width="95" Binding="{Binding PurchaseDate, StringFormat=dd/MM/yyyy}" />
                    <DataGridTextColumn Header="Nguyên giá" Width="120" Binding="{Binding Originaloost, StringFormat=N0}" />
                    <DataGridTextColumn Header="Đã PB" Width="120" Binding="{Binding AllocatedAmCount, StringFormat=N0}" />
                    <DataGridTextColumn Header="Còn lại" Width="120" Binding="{Binding RemainingAmCount, StringFormat=N0}" />
                    <DataGridTextColumn Header="Sđ kỳ" Width="80" Binding="{Binding AllocationMonths}" />
                    <DataGridTextColumn Header="Trạng thái" Width="105" Binding="{Binding Status}" />
                    <DataGridTextColumn Header="Bút toán" Width="150" Binding="{Binding JournalHeaderId}" />
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBox Width="90" Margin="0,0,8,0" Text="{Binding QuickToolAsset.IssueQuantity, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Command="{Binding IssueToolAssetCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Xuất dùng/Ghi sổ" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding RecoverToolAssetCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Thu hồi" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding DisposeToolAssetCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Ghi giảm" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding OpenSelectedDrilldownCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Xem chi tiết" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem Header="Phân bổ">
              <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding AllocationSchedules}" SelectedItem="{Binding SelectedAllocationSchedule}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Kỳ" Width="95" Binding="{Binding AllocationPeriod}" />
                    <DataGridTextColumn Header="Ngày" Width="95" Binding="{Binding AllocationDate, StringFormat=dd/MM/yyyy}" />
                    <DataGridTextColumn Header="Mã CCDC" Width="120" Binding="{Binding TooloCode}" />
                    <DataGridTextColumn Header="Tên CCDC" Width="2*" Binding="{Binding ToolName}" />
                    <DataGridTextColumn Header="Phân bổ" Width="120" Binding="{Binding AllocationAmCount, StringFormat=N0}" />
                    <DataGridTextColumn Header="Lũy kế" Width="120" Binding="{Binding AccumulatedAfter, StringFormat=N0}" />
                    <DataGridTextColumn Header="Còn lại" Width="120" Binding="{Binding RemainingAfter, StringFormat=N0}" />
                    <DataGridTextColumn Header="Trạng thái" Width="95" Binding="{Binding Status}" />
                    <DataGridTextColumn Header="Bút toán" Width="150" Binding="{Binding JournalHeaderId}" />
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding PreviewAllocationCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Xem lịch phân bổ" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Command="{Binding RunAllocationCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Chạy phân bổ" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding PostSelectedAllocationCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Ghi sổ dòng chọn" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding ReverseAllocationCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Đảo bút toán" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem Header="Báo cáo">
              <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="130" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource EnterpriseModulePanelCard}">
                  <StackPanel Orientation="Horizontal">
                    <ComboBox DisplayMemberPath="Label" SelectedValuePath="Code" Width="230" Margin="0,0,8,0" ItemsSource="{Binding ReportoCodes}" SelectedValue="{Binding SelectedReportoCode}" />
                    <ComboBox Width="110" Margin="0,0,8,0" ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding SelectedExportFormat}" />
                    <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Command="{Binding RunReportCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                        <TextBlock Text="Chạy" />
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding ExportReportCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                        <TextBlock Text="Xuất" />
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding ToggleFavoriteReportCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                        <TextBlock Text="Ưa thích" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
                <DataGrid Grid.Row="1" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding ReportRows}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Cột 1" Width="150" Binding="{Binding Column1}" />
                    <DataGridTextColumn Header="Cột 2" Width="2*" Binding="{Binding Column2}" />
                    <DataGridTextColumn Header="Cột 3" Width="160" Binding="{Binding Column3}" />
                    <DataGridTextColumn Header="Cột 4" Width="140" Binding="{Binding Column4}" />
                    <DataGridTextColumn Header="Số tiền" Width="120" Binding="{Binding AmCount1}" />
                    <DataGridTextColumn Header="Còn lại" Width="120" Binding="{Binding AmCount2}" />
                    <DataGridTextColumn Header="Trạng thái" Width="110" Binding="{Binding Status}" />
                    <DataGridTextColumn Header="Bút toán" Width="100" Binding="{Binding JournalStatus}" />
                  </DataGrid.Columns>
                </DataGrid>
                <Grid Row="2" Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource EnterpriseModulePanelCard}" Margin="0,0,6,0">
                    <StackPanel>
                      <TextBlock Text="Báo cáo ưa thích" FontWeight="SemiBold" />
                      <ItemsControl ItemsSource="{Binding FavoriteReports}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Foreground="#1D4ED8" Margin="0,0,0,6" Text="{Binding Label}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Style="{StaticResource EnterpriseModulePanelCard}" Margin="6,0,0,0">
                    <DataGrid Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding ReportHistory}">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Báo cáo" Width="*" Binding="{Binding ReportoCode}" />
                        <DataGridTextColumn Header="Trạng thái" Width="90" Binding="{Binding Status}" />
                        <DataGridTextColumn Header="Dòng" Width="70" Binding="{Binding RowoCount}" />
                        <DataGridTextColumn Header="Bắt đầu" Width="110" Binding="{Binding StartedAt, StringFormat=dd/MM HH:mm}" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Border>
                </Grid>
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
      </controls:EnterpriseStatePresenter.StateContent>
    </controls:EnterpriseStatePresenter>
    <Border Grid.Row="3" Background="#FFFFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Foreground="#64748B" Text="{Binding LastRefreshText}" />
        <TextBlock Foreground="#334155" Text="{Binding PostingVisibilityText}" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
