<Window x:Class="ASMILE.BO.App.Views.HousekeepingMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhắn nhà buồng" Width="1420" Height="880"
        MinWidth="1160" MinHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="ModTextBox" TargetType="TextBox"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModCombo" TargetType="ComboBox"><Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/><Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#7B8DA6" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="6" Stretch="Uniform"/></Grid></Border><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="9" Margin="0,2"><ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="BlueBtn" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="GrayBtn" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="OutlineBtn" TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="TabBtn" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="MinWidth" Value="70"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="10,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModDataGrid" TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="#FAFBFD"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ColumnHeaderHeight" Value="42"/><Setter Property="RowHeight" Value="48"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2F6FC"/><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="10,0"/></Style></Setter.Value></Setter></Style>
        <Style x:Key="BadgeRed" TargetType="Border"><Setter Property="Background" Value="#FEE2E2"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="BadgeOrange" TargetType="Border"><Setter Property="Background" Value="#FFF7ED"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="BadgeBlue" TargetType="Border"><Setter Property="Background" Value="#DBEAFE"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="BadgeGreen" TargetType="Border"><Setter Property="Background" Value="#DCFCE7"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="BadgeGray" TargetType="Border"><Setter Property="Background" Value="#F3F4F6"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="BadgeYellow" TargetType="Border"><Setter Property="Background" Value="#FEF9C3"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="#FAFBFD"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12,10"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8B5CF6" Offset="0"/><GradientStop Color="#7C3AED" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE90B;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="Nhắn nhà buồng" FontSize="20" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Gửi và theo dõi yêu cầu phối hợp giữa Lễ tân và Nhà buồng." FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="+ Tạo yêu cầu" Click="OnCreateRequest" Style="{StaticResource BlueBtn}"/><Button Content="Làm mới" Click="OnRefresh" Style="{StaticResource GrayBtn}" Margin="8,0,0,0"/><Button Content="Đóng" Click="OnClose" Style="{StaticResource GrayBtn}" Margin="8,0,0,0"/></StackPanel>
            </Grid>
        </Border>

        <!-- METRICS -->
        <Border Grid.Row="1" Margin="14,10,14,0" Padding="14,12" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Đang mở" FontSize="11" Foreground="#94A3B8"/><TextBlock x:Name="MetricOpen" FontSize="22" FontWeight="Bold" Foreground="#17365D" Text="18"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,3,0"><StackPanel><TextBlock Text="Khẩn cấp" FontSize="11" Foreground="#94A3B8"/><TextBlock x:Name="MetricUrgent" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Text="3"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,3,0"><StackPanel><TextBlock Text="Đang xử lý" FontSize="11" Foreground="#94A3B8"/><TextBlock x:Name="MetricProcessing" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Text="7"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,3,0"><StackPanel><TextBlock Text="Chờ xác nhận" FontSize="11" Foreground="#94A3B8"/><TextBlock x:Name="MetricPendingConfirm" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Text="4"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,3,0"><StackPanel><TextBlock Text="Quá hạn" FontSize="11" Foreground="#94A3B8"/><TextBlock x:Name="MetricOverdue" FontSize="22" FontWeight="Bold" Foreground="#EA580C" Text="2"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Hoàn thành HN" FontSize="11" Foreground="#94A3B8"/><TextBlock x:Name="MetricCompleted" FontSize="22" FontWeight="Bold" Foreground="#16A34A" Text="12"/></StackPanel></Border>
            </Grid>
        </Border>

        <!-- FILTER -->
        <Border Grid.Row="2" Margin="14,8,14,6" Padding="12,10" Background="White" CornerRadius="12" BorderBrush="#D8E2F0" BorderThickness="1">
            <WrapPanel>
                <StackPanel Margin="0,0,8,4"><TextBlock Text="Từ khóa" FontSize="11" Foreground="#94A3B8"/><TextBox x:Name="SearchBox" Width="180" Style="{StaticResource ModTextBox}"/></StackPanel>
                <StackPanel Margin="0,0,8,4"><TextBlock Text="Tầng" FontSize="11" Foreground="#94A3B8"/><ComboBox Width="80" Style="{StaticResource ModCombo}" x:Name="FloorFilter" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/></ComboBox></StackPanel>
                <StackPanel Margin="0,0,8,4"><TextBlock Text="Loại yêu cầu" FontSize="11" Foreground="#94A3B8"/><ComboBox Width="140" Style="{StaticResource ModCombo}" x:Name="TypeFilter" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Dọn phòng ngay"/><ComboBoxItem Content="Kiểm tra phòng"/><ComboBoxItem Content="Kiểm tra Minibar"/><ComboBoxItem Content="Bổ sung đồ dùng"/><ComboBoxItem Content="Thay ga/gối"/><ComboBoxItem Content="Sửa thiết bị"/><ComboBoxItem Content="Lost &amp; Found"/><ComboBoxItem Content="Khác"/></ComboBox></StackPanel>
                <StackPanel Margin="0,0,8,4"><TextBlock Text="Ưu tiên" FontSize="11" Foreground="#94A3B8"/><ComboBox Width="110" Style="{StaticResource ModCombo}" x:Name="PriorityFilter" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Khẩn cấp"/><ComboBoxItem Content="Cao"/><ComboBoxItem Content="Bình thường"/><ComboBoxItem Content="Thấp"/></ComboBox></StackPanel>
                <StackPanel Margin="0,0,8,4"><TextBlock Text="Trạng thái" FontSize="11" Foreground="#94A3B8"/><ComboBox Width="130" Style="{StaticResource ModCombo}" x:Name="StatusFilter" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Mới tạo"/><ComboBoxItem Content="Đang xử lý"/><ComboBoxItem Content="Chờ xác nhận"/><ComboBoxItem Content="Hoàn thành"/><ComboBoxItem Content="Quá hạn"/></ComboBox></StackPanel>
                <StackPanel Margin="0,0,8,4"><TextBlock Text=" " FontSize="11"/><CheckBox x:Name="ChkUrgent" Content="Khẩn cấp" FontSize="12" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,5,0,0" Checked="OnQuickFilterChanged" Unchecked="OnQuickFilterChanged"/></StackPanel>
                <StackPanel Margin="0,0,8,4"><TextBlock Text=" " FontSize="11"/><CheckBox x:Name="ChkOverdue" Content="Quá hạn" FontSize="12" Foreground="#EA580C" VerticalAlignment="Center" Margin="0,5,0,0" Checked="OnQuickFilterChanged" Unchecked="OnQuickFilterChanged"/></StackPanel>
                <StackPanel Margin="8,16,6,4"><Button Content="Tìm" Click="OnRefresh" Style="{StaticResource BlueBtn}" Width="80"/></StackPanel>
                <StackPanel Margin="0,16,0,4"><Button Content="Xóa lọc" Click="OnClearFilter" Style="{StaticResource GrayBtn}"/></StackPanel>
            </WrapPanel>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Row="3" Margin="14,4,14,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="6.3*" MinWidth="520"/><ColumnDefinition Width="16"/><ColumnDefinition Width="3.7*" MinWidth="370"/></Grid.ColumnDefinitions>

            <!-- LEFT: Request Grid -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid><TextBlock Text="Danh sách yêu cầu" FontSize="14" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#94A3B8" x:Name="ResultCount" Text="18 yêu cầu"/></Grid>
                    </Border>
                    <DataGrid Grid.Row="1" x:Name="RequestGrid" Style="{StaticResource ModDataGrid}" SelectionChanged="OnRequestSelected">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Ưu tiên" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Border Padding="6,3" CornerRadius="8" HorizontalAlignment="Left" Background="{Binding PriorityBadge}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Priority}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding PriorityColor}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Mã YC" Binding="{Binding RequestId}" Width="70"/>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomNumber}" Width="55"/>
                            <DataGridTextColumn Header="Loại" Binding="{Binding RequestType}" Width="110"/>
                            <DataGridTextColumn Header="Nội dung" Binding="{Binding Content}" Width="160"/>
                            <DataGridTextColumn Header="Phụ trách" Binding="{Binding Assignee}" Width="85"/>
                            <DataGridTextColumn Header="Tạo lúc" Binding="{Binding CreatedAt}" Width="70"/>
                            <DataGridTemplateColumn Header="Trạng thái" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Border Padding="8,3" CornerRadius="10" Background="{Binding StatusBadge}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Cảnh báo" Binding="{Binding Alert}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- RIGHT: Detail + Tabs -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border x:Name="DetailCard" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                        <Grid><StackPanel x:Name="DetailEmpty"><TextBlock Text="Chọn một yêu cầu để xem chi tiết." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,20"/></StackPanel>
                            <StackPanel x:Name="DetailContent" Visibility="Collapsed">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" x:Name="DetailAvatarBorder" Background="#8B5CF6"><TextBlock x:Name="DetailInitials" FontSize="15" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DetailReqId" FontSize="15" FontWeight="SemiBold" Foreground="#102E5A"/>
                                        <Border Grid.Column="1" Margin="8,0,0,0" x:Name="DetailPriorityBadge" Style="{StaticResource BadgeRed}" VerticalAlignment="Center"><TextBlock x:Name="DetailPriority" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626"/></Border>
                                        <Border Grid.Column="2" Margin="6,0,0,0" x:Name="DetailStatusBadge" Style="{StaticResource BadgeBlue}" VerticalAlignment="Center"><TextBlock x:Name="DetailStatus" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/></Border>
                                    </Grid><TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#64748B"><Run x:Name="DetailRoomMeta"/><Run Text=" · "/><Run x:Name="DetailCreated"/></TextBlock></StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="..." Click="OnMoreActions" Style="{StaticResource OutlineBtn}" Height="32" FontSize="14" Padding="8,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tabs -->
                    <Border Margin="0,8,0,0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Padding="12,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Nội dung" Click="OnTabClick" Tag="0" Style="{StaticResource TabBtn}"/>
                                    <Button Content="Trao đổi" Click="OnTabClick" Tag="1" Style="{StaticResource TabBtn}"/>
                                    <Button Content="Lịch sử" Click="OnTabClick" Tag="2" Style="{StaticResource TabBtn}"/>
                                    <Button Content="Phòng" Click="OnTabClick" Tag="3" Style="{StaticResource TabBtn}"/>
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="460">
                                <StackPanel x:Name="TabContent" Margin="14,10"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Quick Actions -->
                    <Border Margin="0,10,0,0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                        <StackPanel x:Name="ActionPanel">
                            <TextBlock Text="Thao tác" FontSize="13" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,10"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Cập nhật tiến độ" Click="OnUpdateProgress" Style="{StaticResource BlueBtn}" Height="38" FontSize="13" Padding="0,0"/>
                                <Button Grid.Column="2" Content="Phân công" Click="OnAssign" Style="{StaticResource OutlineBtn}" Height="38" FontSize="13" Padding="0,0"/>
                            </Grid>
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Hoàn thành" Click="OnComplete" Style="{StaticResource OutlineBtn}" Height="38" FontSize="13" Padding="0,0"/>
                                <Button Grid.Column="2" Content="Hủy yêu cầu" Click="OnCancelRequest" Style="{StaticResource GrayBtn}" Height="38" FontSize="13" Padding="0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="4" Padding="14,10" Margin="14,10,14,12" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#64748B" x:Name="FooterTotal" Text="Tổng: 32 yêu cầu · 18 đang mở"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="← Trước" Style="{StaticResource GrayBtn}" Click="OnPrevPage"/>
                    <Button Content="Sau →" Style="{StaticResource GrayBtn}" Margin="8,0,0,0" Click="OnNextPage"/>
                    <Button Content="Đóng" Click="OnClose" Style="{StaticResource GrayBtn}" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
