<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ASMILE.BO.App.Views.TaxFinancialReportingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" xmlns:controls="clr-namespace:ASMILE.BO.App.Controls" FontFamily="Segoe UI, Segoe UI Variable Text" UseLayoutRounding="True" SnapsToDevicePixels="True" xmlns:views="clr-namespace:ASMILE.BO.App.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}" BasedOn="{StaticResource EnterpriseModuleTextBox}" />
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource EnterpriseModuleComboBox}" />
      <Style x:Key="{x:Type DatePicker}" TargetType="{x:Type DatePicker}" BasedOn="{StaticResource EnterpriseModuleDatePicker}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="#F0FEFF" />
        <Setter Property="BorderBrush" Value="#C4D2E4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#243B5D" />
        <Setter Property="Padding" Value="10,0,34,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type DatePicker}">
              <Grid>
                <Border Name="Root" CornerRadius="12" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
                  <Grid>
                    <primitives:DatePickerTextBox Name="PART_TextBox" BorderThickness="0" Background="#00FFFFFF" Foreground="{TemplateBinding Control.Foreground}" Padding="{TemplateBinding Control.Padding}" VerticalContentAlignment="Center" />
                    <primitives:ToggleButton Name="PART_Button" Width="30" HorizontalAlignment="Right" Margin="0,1,1,1" BorderThickness="0" Background="#00FFFFFF" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                      <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#5D7292" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </primitives:ToggleButton>
                  </Grid>
                </Border>
                <primitives:Popup Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                  <Border Margin="0,6,0,0" Background="#FFFFFFFF" BorderBrush="#D4DEEB" BorderThickness="1" CornerRadius="12" Padding="6">
                    <Calendar Name="PART_Calendar" BorderThickness="0" Background="#FFFFFFFF" />
                  </Border>
                </primitives:Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Root" Property="Border.BorderBrush" Value="#6D9FE3" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Root" Property="Border.BorderBrush" Value="#AEC3DE" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.55" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="#1E293B" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="{x:Type TabControl}" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
      </Style>
      <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}" BasedOn="{StaticResource AccountingTabButton}">
        <Setter Property="Margin" Value="0,0,6,0" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#F6F8FB">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <controls:EnterpriseCommandToolbar Grid.Row="0" SearchPlaceholder="Tìm hóa đơn, mã thuế hoặc nguồn chứng từ..." RefreshText="Làm mới" ShowExportImport="False" Margin="18,14,18,0" SearchText="{Binding PermissionFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RefreshCommand="{Binding RefreshCommand}">
      <controls:EnterpriseCommandToolbar.ActionsContent>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Content="Chạy báo cáo" Command="{Binding RunReportCommand}" />
        </StackPanel>
      </controls:EnterpriseCommandToolbar.ActionsContent>
    </controls:EnterpriseCommandToolbar>
    <DockPanel Grid.Row="1" Margin="18,14,18,12">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Thuế &amp; Báo cáo tài chính" Style="{StaticResource AppTitleTextStyle}" />
        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" Text="{Binding StatusText}" />
      </StackPanel>
      <primitives:UniformGrid DockPanel.Dock="Right" Columns="5" Width="960">
        <controls:EnterpriseSummaryCard Title="VAT phải nộp" Subtitle="Sau khấu trừ" IconGlyph="" Margin="0,0,10,0" Value="{Binding VatPayableText}" />
        <controls:EnterpriseSummaryCard Title="VAT còn khấu trừ" Subtitle="Chuyển kỳ sau" IconGlyph="" Margin="0,0,10,0" Value="{Binding VatReceivableText}" />
        <controls:EnterpriseSummaryCard Title="Tổng tài sản" Subtitle="Theo snapshot" IconGlyph="" Margin="0,0,10,0" Value="{Binding TotalAssets, StringFormat=N0}" />
        <controls:EnterpriseSummaryCard Title="Lợi nhuận trước thuế" IconGlyph="" Margin="0,0,10,0" Value="{Binding ProfitBeforeTax, StringFormat=N0}" Subtitle="{Binding BalanceStatusText}" />
        <controls:EnterpriseSummaryCard Title="Khóa kỳ" Subtitle="Trạng thái kỳ" IconGlyph="" Value="{Binding olosingStateText}" />
      </primitives:UniformGrid>
    </DockPanel>
    <controls:EnterpriseStatePresenter Grid.Row="2" EmptyText="Chưa có dữ liệu thuế hoặc báo cáo tài chính." IsLoading="{Binding IsBusy}">
      <controls:EnterpriseStatePresenter.StateContent>
        <Grid Margin="18,0,18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:EnterpriseFilterPanel Grid.Column="0" Title="Bộ lọc" Margin="0,0,12,0">
            <controls:EnterpriseFilterPanel.PanelContent>
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Text="Thuế và BCTC từ dữ liệu đã lưu" Foreground="#64748B" Margin="0,2,0,12" />
                  <TextBlock Text="Kỳ" Foreground="#475569" />
                  <TextBox Margin="0,4,0,10" Text="{Binding PeriodoCode, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Text="Từ ngày" Foreground="#475569" />
                  <DatePicker Margin="0,4,0,10" SelectedDate="{Binding FromDate}" />
                  <TextBlock Text="Đến ngày" Foreground="#475569" />
                  <DatePicker Margin="0,4,0,10" SelectedDate="{Binding ToDate}" />
                  <TextBlock Text="Chiều VAT" Foreground="#475569" />
                  <ComboBox DisplayMemberPath="Label" Margin="0,4,0,10" ItemsSource="{Binding VatDirections}" SelectedItem="{Binding SelectedVatDirection}" />
                  <TextBlock Text="Tìm kiếm" Foreground="#475569" />
                  <TextBox Margin="0,4,0,12" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" HorizontalAlignment="Left" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Áp dụng" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                  <TextBlock Text="Kiểm tra trực tiếp" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ValidationMessages}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                            <StackPanel>
                              <TextBlock FontWeight="SemiBold" Foreground="#9A3412">
                                <Run Text="{Binding Severity}" />
                                <Run Text=" - " />
                                <Run Text="{Binding Scope}" />
                              </TextBlock>
                              <TextBlock Foreground="#334155" TextWrapping="Wrap" Text="{Binding Message}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </DockPanel>
            </controls:EnterpriseFilterPanel.PanelContent>
          </controls:EnterpriseFilterPanel>
          <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="VAT">
              <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource EnterpriseModulePanelCard}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="115" />
                      <ColumnDefinition Width="115" />
                      <ColumnDefinition Width="115" />
                      <ColumnDefinition Width="115" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" DisplayMemberPath="Code" ItemsSource="{Binding TaxoCodes}" SelectedItem="{Binding SelectedTaxoCode}" />
                    <TextBox Grid.Column="1" Margin="8,0,0,0" ToolTip="Số hóa đơn" Text="{Binding QuickVat.InvoiceNo, UpdateSourceTrigger=PropertyChanged}" />
                    <DatePicker Grid.Column="2" Margin="8,0,0,0" SelectedDate="{Binding QuickVat.InvoiceDate}" />
                    <TextBox Grid.Column="3" Margin="8,0,0,0" ToolTip="Giá trị tính thuế" Text="{Binding QuickVat.TaxBaseAmCount, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="4" Margin="8,0,0,0" ToolTip="Tiền thuế" Text="{Binding QuickVat.TaxAmCount, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="5" Margin="8,0,0,0" DisplayMemberPath="Label" SelectedValuePath="Value" ToolTip="Đầu vào/đầu ra" ItemsSource="{Binding VatEntryDirections}" SelectedValue="{Binding QuickVat.Direction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="6" Margin="8,0,0,0" ToolTip="Nguồn chứng từ" Text="{Binding QuickVat.SourceType, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="7" Style="{StaticResource EnterpriseModuleCmdPrimary}" Command="{Binding CreateVatTransactionCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                        <TextBlock Text="Tạo" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
                <DataGrid Grid.Row="1" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding VatTransactions}" SelectedItem="{Binding SelectedVatTransaction}" PreviewKeyDown="Grid_PreviewKeyDown">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Kỳ" Width="90" Binding="{Binding DeclarationPeriod}" />
                    <DataGridTextColumn Header="Chiều" Width="85" Binding="{Binding Direction}" />
                    <DataGridTextColumn Header="Mã thuế" Width="95" Binding="{Binding TaxoCode}" />
                    <DataGridTextColumn Header="Hóa đơn" Width="120" Binding="{Binding InvoiceNo}" />
                    <DataGridTextColumn Header="Ngày HĐ" Width="95" Binding="{Binding InvoiceDate, StringFormat=dd/MM/yyyy}" />
                    <DataGridTextColumn Header="Thuế suất" Width="90" Binding="{Binding TaxRate, StringFormat=N2}" />
                    <DataGridTextColumn Header="Giá trị tính thuế" Width="125" Binding="{Binding TaxBaseAmCount, StringFormat=N0}" />
                    <DataGridTextColumn Header="Tiền thuế" Width="115" Binding="{Binding TaxAmCount, StringFormat=N0}" />
                    <DataGridTextColumn Header="Nguồn" Width="115" Binding="{Binding SourceType}" />
                    <DataGridTextColumn Header="Trạng thái" Width="95" Binding="{Binding Status}" />
                    <DataGridTextColumn Header="Bút toán" Width="150" Binding="{Binding JournalHeaderId}" />
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding GenerateDeclarationCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Lập tờ khai" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Command="{Binding LockDeclarationCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Khóa" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding ReopenDeclarationCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Mở lại" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding ExportDeclarationCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Xuất tờ khai" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding OpenSelectedDrilldownCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Xem chi tiết" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem Header="Tờ khai">
              <DataGrid Margin="0,12,0,0" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding Declarations}" SelectedItem="{Binding SelectedDeclaration}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Kỳ" Width="110" Binding="{Binding DeclarationPeriod}" />
                  <DataGridTextColumn Header="Loại thuế" Width="100" Binding="{Binding TaxType}" />
                  <DataGridTextColumn Header="VAT vào" Width="130" Binding="{Binding InputVatAmCount, StringFormat=N0}" />
                  <DataGridTextColumn Header="VAT ra" Width="130" Binding="{Binding OutputVatAmCount, StringFormat=N0}" />
                  <DataGridTextColumn Header="Phải nộp" Width="130" Binding="{Binding NetVatPayable, StringFormat=N0}" />
                  <DataGridTextColumn Header="Trạng thái" Width="110" Binding="{Binding Status}" />
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="Báo cáo tài chính">
              <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="170" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                  <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Command="{Binding GenerateFinancialStatementsCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Lập BCTC" />
                    </StackPanel>
                  </Button>
                  <TextBlock VerticalAlignment="Center" Foreground="#334155" FontWeight="SemiBold" Text="{Binding BalanceStatusText}" />
                </StackPanel>
                <DataGrid Grid.Row="1" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding StatementLines}" SelectedItem="{Binding SelectedStatementLine}" PreviewKeyDown="Grid_PreviewKeyDown">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã chỉ tiêu" Width="140" Binding="{Binding LineoCode}" />
                    <DataGridTextColumn Header="Chỉ tiêu" Width="2*" Binding="{Binding LineName}" />
                    <DataGridTextColumn Header="Số tiền" Width="130" Binding="{Binding AmCount, StringFormat=N0}" />
                    <DataGridTextColumn Header="Thuyết minh" Width="180" Binding="{Binding Note}" />
                  </DataGrid.Columns>
                </DataGrid>
                <DataGrid Grid.Row="2" Style="{StaticResource EnterpriseModuleDataGrid}" Margin="0,10,0,0" ItemsSource="{Binding SnapshotBalances}" SelectedItem="{Binding SelectedSnapshotBalance}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Tài khoản" Width="120" Binding="{Binding AccCountoCode}" />
                    <DataGridTextColumn Header="ĐK Nợ" Width="110" Binding="{Binding OpeningDebit, StringFormat=N0}" />
                    <DataGridTextColumn Header="ĐK Có" Width="110" Binding="{Binding Openingoredit, StringFormat=N0}" />
                    <DataGridTextColumn Header="PS Nợ" Width="110" Binding="{Binding PeriodDebit, StringFormat=N0}" />
                    <DataGridTextColumn Header="PS Có" Width="110" Binding="{Binding Periodoredit, StringFormat=N0}" />
                    <DataGridTextColumn Header="oK Nợ" Width="110" Binding="{Binding olosingDebit, StringFormat=N0}" />
                    <DataGridTextColumn Header="oK Có" Width="110" Binding="{Binding olosingoredit, StringFormat=N0}" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>
            <TabItem Header="Kết chuyển">
              <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="170" />
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding olosingEntries}" SelectedItem="{Binding SelectedolosingEntry}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Kỳ" Width="100" Binding="{Binding Period}" />
                    <DataGridTextColumn Header="Ngày Ko" Width="105" Binding="{Binding olosingDate, StringFormat=dd/MM/yyyy}" />
                    <DataGridTextColumn Header="Trạng thái" Width="100" Binding="{Binding Status}" />
                    <DataGridTextColumn Header="Bút toán" Width="160" Binding="{Binding JournalHeaderId}" />
                    <DataGridTextColumn Header="Ghi chú" Width="2*" Binding="{Binding Notes}" />
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding PreviewolosingCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Xem kết chuyển" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Command="{Binding BatcholosingCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Kết chuyển hàng loạt" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding ReverseolosingCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Đảo bút toán" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding LockPeriodCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Khóa kỳ" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding UnlockPeriodCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Mở khóa" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding OpenSelectedDrilldownCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                      <TextBlock Text="Xem chi tiết" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <DataGrid Grid.Row="2" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding olosingLines}" SelectedItem="{Binding SelectedolosingLine}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Tài khoản" Width="140" Binding="{Binding AccCountoCode}" />
                    <DataGridTextColumn Header="Nợ" Width="130" Binding="{Binding DebitAmCount, StringFormat=N0}" />
                    <DataGridTextColumn Header="Có" Width="130" Binding="{Binding oreditAmCount, StringFormat=N0}" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>
            <TabItem Header="Báo cáo">
              <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="150" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource EnterpriseModulePanelCard}">
                  <StackPanel Orientation="Horizontal">
                    <ComboBox DisplayMemberPath="Label" SelectedValuePath="Code" Width="230" Margin="0,0,8,0" ItemsSource="{Binding ReportoCodes}" SelectedValue="{Binding SelectedReportoCode}" />
                    <ComboBox Width="110" Margin="0,0,8,0" ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding SelectedExportFormat}" />
                    <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Command="{Binding RunReportCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                        <TextBlock Text="Chạy" />
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding ExportReportCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                        <TextBlock Text="Xuất" />
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Command="{Binding ToggleFavoriteReportCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" />
                        <TextBlock Text="Ưa thích" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
                <DataGrid Grid.Row="1" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding ReportRows}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Cột 1" Width="150" Binding="{Binding Column1}" />
                    <DataGridTextColumn Header="Cột 2" Width="2*" Binding="{Binding Column2}" />
                    <DataGridTextColumn Header="Cột 3" Width="160" Binding="{Binding Column3}" />
                    <DataGridTextColumn Header="Cột 4" Width="140" Binding="{Binding Column4}" />
                    <DataGridTextColumn Header="Nợ/oơ sở" Width="115" Binding="{Binding Debit}" />
                    <DataGridTextColumn Header="Có/Thuế" Width="115" Binding="{Binding oredit}" />
                    <DataGridTextColumn Header="Số tiền" Width="115" Binding="{Binding AmCount}" />
                    <DataGridTextColumn Header="Trạng thái" Width="115" Binding="{Binding Status}" />
                  </DataGrid.Columns>
                </DataGrid>
                <Grid Row="2" Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource EnterpriseModulePanelCard}" Margin="0,0,6,0">
                    <StackPanel>
                      <TextBlock Text="Báo cáo ưa thích" FontWeight="SemiBold" />
                      <ItemsControl ItemsSource="{Binding FavoriteReports}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Foreground="#1D4ED8" Margin="0,0,0,6" Text="{Binding Label}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Style="{StaticResource EnterpriseModulePanelCard}" Margin="6,0,0,0">
                    <DataGrid Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding ReportHistory}">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Báo cáo" Width="*" Binding="{Binding ReportoCode}" />
                        <DataGridTextColumn Header="Trạng thái" Width="90" Binding="{Binding Status}" />
                        <DataGridTextColumn Header="Dòng" Width="70" Binding="{Binding RowoCount}" />
                        <DataGridTextColumn Header="Bắt đầu" Width="110" Binding="{Binding StartedAt, StringFormat=dd/MM HH:mm}" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Border>
                </Grid>
              </Grid>
            </TabItem>
            <TabItem Header="ohi tiết bút toán">
              <DataGrid Margin="0,12,0,0" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding JournalDrilldownRows}" SelectedItem="{Binding SelectedJournalDrilldown}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Ngày" Width="95" Binding="{Binding EntryDate, StringFormat=dd/MM/yyyy}" />
                  <DataGridTextColumn Header="Bút toán" Width="130" Binding="{Binding EntryNo}" />
                  <DataGridTextColumn Header="Nguồn" Width="120" Binding="{Binding SourceType}" />
                  <DataGridTextColumn Header="Số nguồn" Width="130" Binding="{Binding SourceNo}" />
                  <DataGridTextColumn Header="Diễn giải" Width="2*" Binding="{Binding Description}" />
                  <DataGridTextColumn Header="Nợ" Width="110" Binding="{Binding DebitAmCount, StringFormat=N0}" />
                  <DataGridTextColumn Header="Có" Width="110" Binding="{Binding oreditAmCount, StringFormat=N0}" />
                  <DataGridTextColumn Header="Trạng thái" Width="105" Binding="{Binding StatusDisplay}" />
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
          </TabControl>
        </Grid>
      </controls:EnterpriseStatePresenter.StateContent>
    </controls:EnterpriseStatePresenter>
    <Border Grid.Row="3" Background="#FFFFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Foreground="#64748B" Text="{Binding LastRefreshText}" />
        <TextBlock Foreground="#334155" Text="{Binding PostingVisibilityText}" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
