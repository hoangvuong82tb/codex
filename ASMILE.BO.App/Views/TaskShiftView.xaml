<UserControl x:Class="ASMILE.BO.App.Views.TaskShiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" Loaded="OnLoaded">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Cong Viec &amp; Ca (Task &amp; Shift)" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding TotalOpen, StringFormat='Mo: {}{0}'}" Margin="0,0,12,0" Foreground="#EA580C" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalOverdue, StringFormat='Tre: {}{0}'}" Margin="0,0,12,0" Foreground="#DC2626" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalCompleted, StringFormat='Xong: {}{0}'}" Foreground="#16A34A" FontWeight="SemiBold"/></StackPanel></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F0F4F8" Padding="12,8">
            <WrapPanel><ComboBox ItemsSource="{Binding TaskTypes}" Text="{Binding NewTaskType, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Width="120" Margin="0,0,4,4"/><TextBox Text="{Binding NewModule, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,4,4"/><TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,4,4"/><ComboBox ItemsSource="{Binding Shifts}" SelectedItem="{Binding NewPriority}" Width="80" Margin="0,0,4,4"/><Button Content="Tao" Command="{Binding CreateTaskCommand}" Style="{StaticResource FluentPrimaryButton}" Padding="8,4" FontSize="11"/></WrapPanel>
        </Border>
        <ScrollViewer Grid.Row="2" Grid.Column="0" Margin="12,8">
            <ItemsControl ItemsSource="{Binding Tasks}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:TaskDto}">
                <Border Padding="12,10" Margin="0,0,0,4" CornerRadius="8" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="OnClick" Tag="{Binding}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding TaskNumber}" FontWeight="SemiBold" Margin="0,0,8,0"/><Border CornerRadius="3" Padding="4,1" Background="{Binding Status, Converter={StaticResource StatusToColor}}"><TextBlock Text="{Binding Status}" FontSize="10" Foreground="White"/></Border></StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="450" Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="{Binding TaskType}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding SourceModule, StringFormat=' - {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding AssignedStaffName, StringFormat=' → {0}'}" FontSize="11" Foreground="#2563EB"/></StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding AssignedShift}" FontSize="11"/><TextBlock Text="{Binding EstimatedMinutes, StringFormat='{}{0} min'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="2" Grid.Column="1" Background="White" BorderBrush="#DDE7F3" BorderThickness="1,0,0,0" Padding="16" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="CHI TIET" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding SelectedTask.TaskNumber}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedTask.Description}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <Separator Margin="0,8"/>
                <WrapPanel><Button Content="Phan cong" Command="{Binding AssignTaskCommand}" Style="{StaticResource FluentPrimaryButton}" Padding="8,4" Margin="0,0,4,4"/><Button Content="Bat đau" Command="{Binding StartTaskCommand}" Style="{StaticResource FluentSecondaryButton}" Padding="8,4" Margin="0,0,4,4"/><Button Content="Hoan thanh" Command="{Binding CompleteTaskCommand}" Style="{StaticResource FluentSecondaryButton}" Padding="8,4"/></WrapPanel>
                <Separator Margin="0,8"/>
                <ItemsControl ItemsSource="{Binding SelectedTask.History}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </Border>
        <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"><TextBlock Text="Dang tai..." Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
</UserControl>
