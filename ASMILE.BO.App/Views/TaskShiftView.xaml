<UserControl x:Class="ASMILE.BO.App.Views.TaskShiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" Loaded="OnLoaded">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StatusToColorConverter x:Key="StatusColor"/>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
        <Style x:Key="Primary" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="Secondary" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="12,0"/><Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="FilterBox" TargetType="TextBox"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
        <Style x:Key="FilterCombo" TargetType="ComboBox"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,0"/><Setter Property="MinWidth" Value="115"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
        <Style x:Key="TaskGrid" TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RowHeight" Value="42"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1D4ED8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="8,0"/></Style></Setter.Value></Setter></Style>
    </UserControl.Resources>
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="20,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="12" Background="#2563EB" Margin="0,0,14,0"><TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Công việc &amp; ca" FontSize="21" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Điều phối công việc, ca trực và tiến độ xử lý của các bộ phận" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/></StackPanel></StackPanel><Button Grid.Column="1" Content="Làm mới" Style="{StaticResource Secondary}" Command="{Binding RefreshCommand}"/></Grid></Border>
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="16,10"><UniformGrid Columns="4"><Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"><StackPanel><TextBlock Text="Tổng công việc" FontSize="11" Foreground="#2563EB"/><TextBlock Text="{Binding Tasks.Count}" FontSize="18" FontWeight="Bold" Foreground="#1D4ED8"/></StackPanel></Border><Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"><StackPanel><TextBlock Text="Đang mở" FontSize="11" Foreground="#C2410C"/><TextBlock Text="{Binding TotalOpen}" FontSize="18" FontWeight="Bold" Foreground="#C2410C"/></StackPanel></Border><Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"><StackPanel><TextBlock Text="Quá hạn" FontSize="11" Foreground="#B91C1C"/><TextBlock Text="{Binding TotalOverdue}" FontSize="18" FontWeight="Bold" Foreground="#B91C1C"/></StackPanel></Border><Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10,7"><StackPanel><TextBlock Text="Hoàn thành" FontSize="11" Foreground="#15803D"/><TextBlock Text="{Binding TotalCompleted}" FontSize="18" FontWeight="Bold" Foreground="#15803D"/></StackPanel></Border></UniformGrid></Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="16,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><TextBox Text="{Binding NewTaskType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}" Width="150" ToolTip="Loại công việc" Margin="0,0,6,4"/><TextBox Text="{Binding NewModule, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}" Width="120" ToolTip="Nguồn module" Margin="0,0,6,4"/><TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}" Width="260" ToolTip="Mô tả công việc" Margin="0,0,6,4"/><ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding NewPriority}" Style="{StaticResource FilterCombo}" Width="115" Margin="0,0,6,4"/><Button Content="Tạo công việc" Style="{StaticResource Primary}" Command="{Binding CreateTaskCommand}" Margin="0,0,8,4"/></WrapPanel><WrapPanel Grid.Row="1" Margin="0,4,0,0"><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}" Width="220" ToolTip="Tìm mã, mô tả, loại hoặc nhân sự" Margin="0,0,6,4"/><ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" Style="{StaticResource FilterCombo}" Width="125" Margin="0,0,6,4"/><ComboBox ItemsSource="{Binding PriorityFilters}" SelectedItem="{Binding FilterPriority}" Style="{StaticResource FilterCombo}" Width="115" Margin="0,0,6,4"/><ComboBox ItemsSource="{Binding ShiftFilters}" SelectedItem="{Binding FilterShift}" Style="{StaticResource FilterCombo}" Width="120" Margin="0,0,6,4"/><Button Content="Xóa lọc" Style="{StaticResource Secondary}" Command="{Binding ClearFiltersCommand}" Margin="0,0,6,4"/></WrapPanel></Grid></Border>
        <Grid Grid.Row="3" Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,10,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Danh sách công việc" FontSize="15" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Grid.Column="1" Text="{Binding FilteredTasks.Count, StringFormat={}{0} kết quả}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding FilteredTasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}" Style="{StaticResource TaskGrid}" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Mã" Binding="{Binding TaskNumber}" Width="95"/><DataGridTextColumn Header="Loại" Binding="{Binding TaskType}" Width="125"/><DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Ưu tiên" Binding="{Binding PriorityDisplay}" Width="90"/><DataGridTextColumn Header="Ca" Binding="{Binding AssignedShift}" Width="90"/><DataGridTextColumn Header="Nhân sự" Binding="{Binding AssignedStaffName}" Width="130"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay}" Width="115"/><DataGridTextColumn Header="Hạn xử lý" Binding="{Binding DueTimeDisplay}" Width="140"/></DataGrid.Columns></DataGrid></Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Chi tiết công việc" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,12"/><Border Background="#F8FAFC" CornerRadius="8" Padding="12" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"><StackPanel><TextBlock Text="{Binding SelectedTask.TaskNumber}" FontSize="17" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock Text="{Binding SelectedTask.Description}" TextWrapping="Wrap" Foreground="#475569" Margin="0,4,0,10"/><StackPanel Orientation="Horizontal"><Border Background="{Binding SelectedTask.Status, Converter={StaticResource StatusColor}}" CornerRadius="10" Padding="8,2" Margin="0,0,6,0"><TextBlock Text="{Binding SelectedTask.StatusDisplay}" Foreground="White" FontSize="10"/></Border><TextBlock Text="{Binding SelectedTask.PriorityDisplay}" Foreground="#C2410C" FontSize="11" VerticalAlignment="Center"/></StackPanel><Separator Margin="0,12"/><TextBlock Text="{Binding SelectedTask.TaskType, StringFormat=Loại: {0}}" Foreground="#475569"/><TextBlock Text="{Binding SelectedTask.SourceModule, StringFormat=Nguồn: {0}}" Foreground="#475569"/><TextBlock Text="{Binding SelectedTask.AssignedShift, StringFormat=Ca: {0}, TargetNullValue=Ca: Chưa phân công}" Foreground="#475569"/><TextBlock Text="{Binding SelectedTask.AssignedStaffName, StringFormat=Nhân sự: {0}, TargetNullValue=Nhân sự: Chưa phân công}" Foreground="#475569"/><TextBlock Text="{Binding SelectedTask.DueTimeDisplay, StringFormat=Hạn: {0}}" Foreground="#475569" Margin="0,0,0,10"/><TextBlock Text="Phân công cho" FontWeight="SemiBold" Foreground="#17365D" Margin="0,4,0,4"/><TextBox Text="{Binding AssignStaff, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}" ToolTip="Tên nhân sự" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Shifts}" SelectedItem="{Binding AssignShift}" Style="{StaticResource FilterCombo}" Margin="0,0,0,8"/><WrapPanel><Button Content="Phân công" Style="{StaticResource Primary}" Command="{Binding AssignTaskCommand}" Margin="0,0,6,6"/><Button Content="Bắt đầu" Style="{StaticResource Secondary}" Command="{Binding StartTaskCommand}" Margin="0,0,6,6"/><Button Content="Hoàn thành" Style="{StaticResource Secondary}" Command="{Binding CompleteTaskCommand}" Margin="0,0,0,6"/></WrapPanel><Separator Margin="0,6,0,10"/><TextBlock Text="Lịch sử xử lý" FontWeight="SemiBold" Foreground="#17365D" Margin="0,0,0,6"/><ItemsControl ItemsSource="{Binding SelectedTask.History}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><TextBlock Text="Chọn một công việc để xem chi tiết và thao tác." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,18,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/></StackPanel></ScrollViewer></Border></Grid>
        <Border Grid.Row="4" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,1,0,0" Padding="16,8"><Grid><TextBlock Text="{Binding InfoMessage}" Foreground="#15803D" FontSize="11"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="11" HorizontalAlignment="Right"/></Grid></Border>
        <Border Grid.RowSpan="5" Background="#66000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"><TextBlock Text="Đang tải dữ liệu..." Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
</UserControl>
