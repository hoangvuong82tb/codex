<UserControl x:Class="ASMILE.BO.App.Views.HotelPropertyProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="BorderBrush" Value="#C7D6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#EFF6FF"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#93C5FD"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#DBEAFE"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Background" Value="#F1F5F9"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#E2E8F0"/><Setter Property="Foreground" Value="#94A3B8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" TextElement.Foreground="White" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryBorder" Property="Background" Value="#1D4ED8"/><Setter TargetName="PrimaryBorder" Property="BorderBrush" Value="#1D4ED8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimaryBorder" Property="Background" Value="#1E40AF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimaryBorder" Property="Background" Value="#CBD5E1"/><Setter TargetName="PrimaryBorder" Property="BorderBrush" Value="#CBD5E1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#10213F"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C7D6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Background" Value="#F8FAFC"/><Setter TargetName="InputBorder" Property="BorderBrush" Value="#E2E8F0"/><Setter Property="Foreground" Value="#94A3B8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent" Margin="0,0,0,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Padding="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Thông tin cơ sở &amp; lịch nghiệp vụ" FontSize="22" FontWeight="SemiBold" Foreground="#102E5A"/>
                    <TextBlock Text="Hồ sơ property, múi giờ, tiền tệ và business date dùng chung cho Front Office." Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                    <Button Content="Làm mới" Command="{Binding LoadCommand}" Style="{StaticResource ActionButton}"/>
                    <Button Content="Sửa" Command="{Binding EditItemCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
            <Border BorderBrush="#D8E3F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="20" Background="#FFFFFF">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Mã cơ sở" Style="{StaticResource FieldLabel}"/><TextBox Grid.Column="1" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Text="Tên cơ sở" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" Text="Địa chỉ" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="3" Text="Điện thoại" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="4" Text="Email" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="5" Text="Mã số thuế" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding TaxCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="6" Text="Múi giờ" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TimeZoneId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="7" Text="Tiền tệ" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="8" Text="Business date" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="8" Grid.Column="1" Text="{Binding BusinessDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="9" Text="Giờ nhận / trả" Style="{StaticResource FieldLabel}"/>
                        <Grid Grid.Row="9" Grid.Column="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding CheckInTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0"/><TextBox Text="{Binding CheckOutTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" Grid.Column="2" HorizontalAlignment="Stretch" Margin="0"/></Grid>
                        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Hủy" Command="{Binding CancelEditCommand}" Style="{StaticResource ActionButton}"/>
                            <Button Content="Lưu cấu hình" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="16,0,0,0" Background="#F8FAFC" BorderBrush="#D8E3F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16">
                <StackPanel>
                    <TextBlock Text="Tóm tắt cấu hình" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A"/>
                    <TextBlock Text="Phạm vi" Foreground="#64748B" Margin="0,16,0,2"/><TextBlock Text="{Binding ScopeSummary}" Foreground="#17365D" TextWrapping="Wrap"/>
                    <TextBlock Text="Trạng thái" Foreground="#64748B" Margin="0,14,0,2"/><TextBlock Text="{Binding Status}" Foreground="#17365D" FontWeight="SemiBold"/>
                    <TextBlock Text="Bản ghi này là cấu hình property thật, không phải dữ liệu mẫu trong ViewModel." Foreground="#64748B" TextWrapping="Wrap" Margin="0,16,0,12"/>
                    <Button Content="Bật / tạm ngưng" Command="{Binding ToggleActiveCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="0"/>
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap"/></Border>
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0" Visibility="{Binding HasInfo, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding InfoMessage}" Foreground="#166534" TextWrapping="Wrap"/></Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
