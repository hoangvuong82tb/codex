<UserControl x:Class="ASMILE.BO.App.Views.CleaningInProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" Loaded="OnLoaded" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:StringToBrushConverter x:Key="StringToBrush"/>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ToolbarBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Height" Value="36"/><Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/><Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FilterTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/>
        </Style>
        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource FluentComboBox}">
            <Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="10,0,30,0"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/>
        </Style>
        <Style x:Key="ModDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#2563EB"/>
                <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="6,0"/></Style></Setter.Value></Setter>
        </Style>
        <Style x:Key="PagerBtn" TargetType="Button" BasedOn="{StaticResource FluentPaginationButton}">
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
        <Style x:Key="PagerPageBtn" TargetType="Button" BasedOn="{StaticResource FluentPaginationButton}">
            <Setter Property="Content" Value="{Binding Label}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="#2563EB"/><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                    <Setter Property="Width" Value="24"/><Setter Property="MinWidth" Value="24"/><Setter Property="MaxWidth" Value="24"/>
                    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InspectorTabBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,0"/><Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Border Background="#F1F5F9" CornerRadius="3"><Border x:Name="PART_Indicator" Background="#2563EB" CornerRadius="3" HorizontalAlignment="Left"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="OverdueProgressBar" TargetType="ProgressBar" BasedOn="{StaticResource ProgressBar}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Border Background="#F1F5F9" CornerRadius="3"><Border x:Name="PART_Indicator" Background="#DC2626" CornerRadius="3" HorizontalAlignment="Left"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Padding="20,14" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2563EB" Offset="0"/><GradientStop Color="#1D4ED8" Offset="1"/></LinearGradientBrush></Border.Background>
                    <TextBlock Text="&#xE8D1;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Đang dọn" FontSize="19" FontWeight="SemiBold" Foreground="#102E5A"/>
                        <Border CornerRadius="10" Padding="6,2" Margin="10,0,0,0" Background="#EFF6FF">
                            <TextBlock Text="{Binding ActiveCleaningCount, StringFormat='{}{0} phòng đang dọn'}" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB"/></Border></StackPanel>
                    <TextBlock Text="Cleaning In Progress — Dashboard giám sát tiến độ vệ sinh phòng theo thời gian thực." FontSize="12" Foreground="#64748B"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryBtn}"/>
                    <Button Content="Xuất Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0"/>
                    <Button Content="In" Command="{Binding PrintListCommand}" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0"/></StackPanel></Grid></Border>

        <!-- KPI DASHBOARD -->
        <Border Grid.Row="1" Padding="10,7" Background="#FAFBFD" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding DashboardKpis}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:CleaningKpi}">
                    <Border Width="110" Margin="0,0,6,4" Padding="8,5" CornerRadius="8" Background="{Binding BgColor}" BorderBrush="{Binding Color}" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="OnKpiClick">
                        <StackPanel><TextBlock Text="{Binding Label}" FontSize="9" Foreground="{Binding Color}"/><TextBlock Text="{Binding Value}" FontSize="16" FontWeight="Bold" Foreground="{Binding Color}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>

        <!-- TOOLBAR -->
        <Border Grid.Row="2" Padding="12,7" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <WrapPanel>
                <Button Content="Phân công" Command="{Binding AssignHousekeeperCommand}" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,4"/>
                <Button Content="Bắt đầu dọn" Command="{Binding StartCleaningCommand}" Style="{StaticResource ToolbarBtn}"/>
                <Button Content="Tạm dừng" Command="{Binding PauseCleaningCommand}" Style="{StaticResource ToolbarBtn}"/>
                <Button Content="Tiếp tục" Command="{Binding ResumeCleaningCommand}" Style="{StaticResource ToolbarBtn}" Foreground="#0891B2"/>
                <Button Content="Hoàn thành" Command="{Binding CompleteCleaningCommand}" Style="{StaticResource ToolbarBtn}" Foreground="#16A34A"/>
                <Button Content="Gửi Inspection" Command="{Binding CompleteCleaningCommand}" Style="{StaticResource ToolbarBtn}" Foreground="#7C3AED"/>
                <Button Content="Đổi NV" Command="{Binding ChangeHousekeeperCommand}" Style="{StaticResource ToolbarBtn}" Foreground="#D97706"/>
                <Button Content="Upload ảnh" Command="{Binding UploadPhotoCommand}" Style="{StaticResource ToolbarBtn}"/>
                <Separator Width="1" Height="20" Background="#E2E8F0" Margin="6,8" Style="{x:Null}"/>
                <Button Content="&#xE8A9;" FontFamily="Segoe MDL2 Assets" Width="36" Style="{StaticResource ToolbarBtn}" Padding="0" ToolTip="Xem Grid" Command="{Binding SetGridViewCommand}"/>
                <Button Content="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Width="36" Style="{StaticResource ToolbarBtn}" Padding="0" ToolTip="Xem Card" Command="{Binding SetCardViewCommand}"/>
                <Button Content="&#xECAA;" FontFamily="Segoe MDL2 Assets" Width="36" Style="{StaticResource ToolbarBtn}" Padding="0" ToolTip="Xem theo Tầng" Command="{Binding SetFloorViewCommand}"/>
                <Separator Width="1" Height="20" Background="#E2E8F0" Margin="6,8" Style="{x:Null}"/>
                <Button Content="Batch Assign" Command="{Binding BatchAssignCommand}" Style="{StaticResource ToolbarBtn}" FontSize="10" Padding="8,0"/>
                <Button Content="Batch Complete" Command="{Binding BatchCompleteCommand}" Style="{StaticResource ToolbarBtn}" FontSize="10" Padding="8,0"/>
                <Button Content="Batch Inspect" Command="{Binding BatchInspectCommand}" Style="{StaticResource ToolbarBtn}" FontSize="10" Padding="8,0"/></WrapPanel></Border>

        <!-- FILTER -->
        <Border Grid.Row="3" Padding="10,6" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="150" Margin="0,0,6,4"/>
                <ComboBox ItemsSource="{x:Static vm:CleaningInProgressViewModel.StatusFilters}" SelectedItem="{Binding FilterStatus}" Style="{StaticResource FilterCombo}" Width="120" Margin="0,0,6,4"/>
                <ComboBox ItemsSource="{Binding HousekeeperFilters}" SelectedItem="{Binding FilterHousekeeper}" Style="{StaticResource FilterCombo}" Width="120" Margin="0,0,6,4"/>
                <ComboBox ItemsSource="{Binding SupervisorFilters}" SelectedItem="{Binding FilterSupervisor}" Style="{StaticResource FilterCombo}" Width="130" Margin="0,0,6,4"/>
                <ComboBox ItemsSource="{Binding FloorFilters}" SelectedItem="{Binding FilterFloor}" Style="{StaticResource FilterCombo}" Width="70" Margin="0,0,6,4"/>
                <ComboBox ItemsSource="{x:Static vm:CleaningInProgressViewModel.BuildingFilters}" SelectedItem="{Binding FilterBuilding}" Style="{StaticResource FilterCombo}" Width="70" Margin="0,0,6,4"/>
                <ComboBox ItemsSource="{x:Static vm:CleaningInProgressViewModel.RoomTypeFilters}" SelectedItem="{Binding FilterRoomType}" Style="{StaticResource FilterCombo}" Width="90" Margin="0,0,6,4"/>
                <ComboBox ItemsSource="{x:Static vm:CleaningInProgressViewModel.DurationFilters}" SelectedItem="{Binding FilterDuration}" Style="{StaticResource FilterCombo}" Width="100" Margin="0,0,6,4"/>
                <CheckBox Content="VIP" IsChecked="{Binding FilterVipOnly}" FontSize="11" Margin="0,4,8,0"/>
                <CheckBox Content="Rush" IsChecked="{Binding FilterRushOnly}" FontSize="11" Margin="0,4,8,0"/>
                <Button Content="Xóa lọc" Style="{StaticResource SecondaryBtn}" Height="32" FontSize="11" Margin="0,0,0,4" Padding="8,0" Command="{Binding ClearFiltersCommand}"/></WrapPanel></Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

            <!-- LEFT TREE -->
            <Border Grid.Column="0" Margin="10,8,4,8" Style="{StaticResource PanelCard}" Padding="0">
                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="12,9" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"><TextBlock Text="Danh mục" FontSize="13" FontWeight="SemiBold" Foreground="#102E5A"/></Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="6,4">
                        <TreeView x:Name="RoomTree" ItemsSource="{Binding TreeItems}" BorderThickness="0" Background="Transparent" SelectedItemChanged="OnTreeItemSelected">
                            <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Padding" Value="2,3"/></Style></TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate><HierarchicalDataTemplate DataType="{x:Type vm:CleaningTreeItem}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}" FontSize="12" Foreground="#334155"/><TextBlock Text="{Binding Count, StringFormat=' ({0})'}" FontSize="10" Foreground="#94A3B8" Margin="3,0,0,0"/></StackPanel></HierarchicalDataTemplate></TreeView.ItemTemplate></TreeView></ScrollViewer></Grid></Border>

            <!-- CENTER DATAGRID -->
            <Border Grid.Column="1" Margin="4,8,6,8" Style="{StaticResource PanelCard}" Padding="0">
                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#EFF6FF" Padding="10,6" Visibility="{Binding InfoMessage, Converter={StaticResource StringToVis}}"><TextBlock Text="{Binding InfoMessage}" FontSize="12" Foreground="#2563EB"/></Border>

                    <!-- GRID VIEW -->
                    <DataGrid Grid.Row="1" Style="{StaticResource ModDataGrid}" ItemsSource="{Binding FilteredRooms}" SelectedItem="{Binding SelectedRoom, Mode=TwoWay}" SelectionChanged="OnRoomSelectionChanged" MouseDoubleClick="OnRoomDoubleClick" Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                        <DataGrid.ContextMenu><ContextMenu FontFamily="Segoe UI" FontSize="12">
                            <MenuItem Header="Phân công" Command="{Binding AssignHousekeeperCommand}"/>
                            <MenuItem Header="Bắt đầu dọn" Command="{Binding StartCleaningCommand}"/>
                            <MenuItem Header="Tạm dừng" Command="{Binding PauseCleaningCommand}"/>
                            <MenuItem Header="Tiếp tục" Command="{Binding ResumeCleaningCommand}"/>
                            <MenuItem Header="Hoàn thành" Command="{Binding CompleteCleaningCommand}"/>
                            <Separator/><MenuItem Header="Inspection Pass" Command="{Binding PassInspectionCommand}"/>
                            <MenuItem Header="Inspection Fail" Command="{Binding RejectInspectionCommand}"/>
                            <Separator/><MenuItem Header="Đổi nhân viên" Command="{Binding ChangeHousekeeperCommand}"/></ContextMenu></DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Chọn" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type vm:CleaningInProgressDto}"><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Phòng" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type vm:CleaningInProgressDto}"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding CleaningColor, Converter={StaticResource StringToBrush}}" Margin="0,0,4,0"/><TextBlock Text="{Binding RoomNumber}" FontSize="12" FontWeight="SemiBold" Foreground="#17365D"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Loại" Width="45" Binding="{Binding RoomType}"/>
                            <DataGridTextColumn Header="Khách" Width="100" Binding="{Binding GuestName}"/>
                            <DataGridTextColumn Header="Checkout" Width="90" Binding="{Binding CheckoutTime, StringFormat='{}{0:HH:mm dd/MM}'}"/>
                            <DataGridTextColumn Header="NV dọn" Width="95" Binding="{Binding AssignedTo}"/>
                            <DataGridTextColumn Header="Bắt đầu" Width="70" Binding="{Binding StartTime, StringFormat='{}{0:HH:mm}'}"/>
                            <DataGridTemplateColumn Header="Thời gian" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type vm:CleaningInProgressDto}"><StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ElapsedMinutes, StringFormat='{}{0}ph'}" FontSize="11" Foreground="#475569"/>
                                <TextBlock Text=" &#x26A0;" FontFamily="Segoe UI" FontSize="10" Foreground="#DC2626" Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}" ToolTip="Quá SLA"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dự kiến xong" Width="80" Binding="{Binding ExpectedFinish, StringFormat='{}{0:HH:mm}'}"/>
                            <DataGridTemplateColumn Header="Tiến độ" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type vm:CleaningInProgressDto}"><StackPanel>
                                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Width="70"><ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource ProgressBar}"><Style.Triggers><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
                                <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" FontSize="9" Foreground="#94A3B8"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Checklist" Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type vm:CleaningInProgressDto}"><TextBlock FontSize="10" Foreground="#475569"><Run Text="{Binding ChecklistProgress, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding ChecklistTotal, Mode=OneWay}"/></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Ưu tiên" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type vm:CleaningInProgressDto}"><StackPanel Orientation="Horizontal">
                                <Border CornerRadius="4" Padding="3,1" Margin="0,0,2,0" Background="#FFF0F5" Visibility="{Binding IsVip, Converter={StaticResource BoolToVis}}"><TextBlock Text="VIP" FontSize="9" Foreground="#E32F70" FontWeight="SemiBold"/></Border>
                                <Border CornerRadius="4" Padding="3,1" Background="#FFF7ED" Visibility="{Binding IsRush, Converter={StaticResource BoolToVis}}"><TextBlock Text="RUSH" FontSize="9" Foreground="#EA580C" FontWeight="SemiBold"/></Border></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Trạng thái" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type vm:CleaningInProgressDto}"><Border CornerRadius="6" Padding="5,2" Background="{Binding CleaningBg, Converter={StaticResource StringToBrush}}" HorizontalAlignment="Left"><TextBlock Text="{Binding CleaningLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding CleaningColor, Converter={StaticResource StringToBrush}}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ghi chú" Width="110" Binding="{Binding Remark}"/></DataGrid.Columns></DataGrid>

                    <!-- CARD VIEW -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCardView, Converter={StaticResource BoolToVis}}">
                        <WrapPanel Margin="10">
                            <ItemsControl ItemsSource="{Binding FilteredRooms}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:CleaningInProgressDto}">
                                    <Border Width="240" Margin="4" Padding="12" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="OnCardClick">
                                        <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.06" Color="#000000"/></Border.Effect>
                                        <StackPanel>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="10" Height="10" Fill="{Binding CleaningColor, Converter={StaticResource StringToBrush}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RoomNumber}" FontSize="16" FontWeight="Bold" Foreground="#102E5A"/>
                                                    <TextBlock Text="{Binding RoomType}" FontSize="11" Foreground="#94A3B8" Margin="4,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                                <Border Grid.Column="1" CornerRadius="4" Padding="3,1" Background="{Binding CleaningBg, Converter={StaticResource StringToBrush}}"><TextBlock Text="{Binding CleaningLabel}" FontSize="8" FontWeight="SemiBold" Foreground="{Binding CleaningColor, Converter={StaticResource StringToBrush}}"/></Border></Grid>
                                            <TextBlock Text="{Binding GuestName}" FontSize="11" Foreground="#64748B" Margin="0,4,0,2"/>
                                            <TextBlock FontSize="10" Foreground="#94A3B8" Margin="0,0,0,4"><Run Text="NV: "/><Run Text="{Binding AssignedTo}" Foreground="#475569" FontWeight="SemiBold"/></TextBlock>
                                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Style="{StaticResource ProgressBar}" Margin="0,0,0,4"/>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock FontSize="10" Foreground="#94A3B8"><Run Text="Đã dọn: "/><Run Text="{Binding ElapsedMinutes, StringFormat='{}{0}ph'}" Foreground="#475569"/></TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding RemainingMinutes, StringFormat='Còn {0}ph'}" FontSize="10" Foreground="#2563EB" FontWeight="SemiBold"/></Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border CornerRadius="4" Padding="3,1" Margin="0,0,2,0" Background="#FFF0F5" Visibility="{Binding IsVip, Converter={StaticResource BoolToVis}}"><TextBlock Text="VIP" FontSize="8" Foreground="#E32F70" FontWeight="SemiBold"/></Border>
                                                <Border CornerRadius="4" Padding="3,1" Background="#FFF7ED" Visibility="{Binding IsRush, Converter={StaticResource BoolToVis}}"><TextBlock Text="RUSH" FontSize="8" Foreground="#EA580C" FontWeight="SemiBold"/></Border>
                                                <Border CornerRadius="4" Padding="3,1" Background="#FEF2F2" Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}"><TextBlock Text="OVERDUE" FontSize="8" Foreground="#DC2626" FontWeight="SemiBold"/></Border></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></WrapPanel></ScrollViewer>

                    <!-- FLOOR VIEW -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsFloorView, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding FloorViews}" Margin="10">
                            <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:FloorViewDto}">
                                <Border Margin="0,0,0,8" Padding="10" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Floor, StringFormat='Tầng {0}'}" FontSize="14" FontWeight="Bold" Foreground="#102E5A" Margin="0,0,0,6"/>
                                        <WrapPanel>
                                            <ItemsControl ItemsSource="{Binding Rooms}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:CleaningInProgressDto}">
                                                    <Border Width="80" Height="70" Margin="2" CornerRadius="8" Background="{Binding CleaningBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding CleaningColor, Converter={StaticResource StringToBrush}}" BorderThickness="1" Cursor="Hand" ToolTip="{Binding RoomNumber}">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding RoomNumber}" FontSize="13" FontWeight="Bold" Foreground="#102E5A" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding CleaningLabel}" FontSize="8" Foreground="{Binding CleaningColor, Converter={StaticResource StringToBrush}}" HorizontalAlignment="Center"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>

            <!-- RIGHT INSPECTOR -->
            <Border Grid.Column="2" Width="380" Margin="6,8,10,8" Style="{StaticResource PanelCard}" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedRoom.RoomNumber}" FontSize="18" FontWeight="Bold" Foreground="#102E5A"/><Border CornerRadius="4" Padding="3,1" Margin="6,0,0,0" Background="{Binding SelectedRoom.CleaningBg, Converter={StaticResource StringToBrush}}"><TextBlock Text="{Binding SelectedRoom.CleaningLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding SelectedRoom.CleaningColor, Converter={StaticResource StringToBrush}}"/></Border></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="{Binding SelectedRoom.RoomTypeName}" FontSize="12" Foreground="#64748B"/><TextBlock Text=" · " Foreground="#CBD5E1"/><TextBlock Text="{Binding SelectedRoom.Floor, StringFormat='Tầng {0}'}" FontSize="12" Foreground="#64748B"/></StackPanel></StackPanel>
                            <Button Grid.Column="1" Content="&#x2715;" Width="28" Height="28" Command="{Binding CloseDetailCommand}" Style="{StaticResource SecondaryBtn}" FontSize="12" Padding="0"/></Grid></Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,6,10,0">
                        <Button x:Name="TabOverview" Content="Tổng quan" Width="70" Style="{StaticResource InspectorTabBtn}" Click="OnDetailTabClick" Tag="0" Margin="0,0,2,0"/>
                        <Button x:Name="TabCleaning" Content="Dọn phòng" Width="75" Style="{StaticResource InspectorTabBtn}" Click="OnDetailTabClick" Tag="1" Margin="0,0,2,0"/>
                        <Button x:Name="TabChecklist" Content="Checklist" Width="65" Style="{StaticResource InspectorTabBtn}" Click="OnDetailTabClick" Tag="2" Margin="0,0,2,0"/>
                        <Button x:Name="TabTimeline" Content="Timeline" Width="65" Style="{StaticResource InspectorTabBtn}" Click="OnDetailTabClick" Tag="3" Margin="0,0,2,0"/>
                        <Button x:Name="TabHistory" Content="Lịch sử" Width="60" Style="{StaticResource InspectorTabBtn}" Click="OnDetailTabClick" Tag="4"/></StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="10,6,10,10">
                        <StackPanel>
                            <!-- TAB 0: Overview -->
                            <StackPanel x:Name="DetailTab0" Visibility="Visible">
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,6"><StackPanel>
                                    <TextBlock Text="Thông tin phòng" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Phòng: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.RoomNumber}" Foreground="#17365D" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Loại: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.RoomTypeName}" Foreground="#17365D"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Tầng: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.Floor, StringFormat='Tầng {0}'}" Foreground="#17365D"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Tòa: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.Building}" Foreground="#17365D"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Khu: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.Area}" Foreground="#17365D"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="FO Status: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.FoStatus}" Foreground="#17365D"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="HK Status: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.CleaningLabel}" Foreground="{Binding SelectedRoom.CleaningColor, Converter={StaticResource StringToBrush}}" FontWeight="SemiBold"/></TextBlock></StackPanel></Border>
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,6"><StackPanel>
                                    <TextBlock Text="Khách" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Tên: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.GuestName}" Foreground="#17365D"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Check-out: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.CheckoutTime, StringFormat='{}{0:HH:mm dd/MM}'}" Foreground="#DC2626"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="VIP: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.GuestVip}" Foreground="#E32F70" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Yêu cầu ĐB: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.SpecialRequest}" Foreground="#D97706"/></TextBlock></StackPanel></Border>
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Visibility="{Binding SelectedRoom.NextGuest, Converter={StaticResource StringToVis}}"><StackPanel>
                                    <TextBlock Text="Khách sắp đến" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Tên: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.NextGuest}" Foreground="#17365D"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="ETA: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.ExpectedArrival, StringFormat='{}{0:HH:mm dd/MM}'}" Foreground="#2563EB"/></TextBlock></StackPanel></Border></StackPanel>

                            <!-- TAB 1: Cleaning -->
                            <StackPanel x:Name="DetailTab1" Visibility="Collapsed">
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,6"><StackPanel>
                                    <TextBlock Text="Phân công" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Housekeeper: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.AssignedTo}" Foreground="#17365D" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Supervisor: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.Supervisor}" Foreground="#17365D"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Bắt đầu: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.StartTime, StringFormat='{}{0:HH:mm}'}" Foreground="#2563EB"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Dự kiến xong: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.ExpectedFinish, StringFormat='{}{0:HH:mm}'}" Foreground="#0891B2"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Đã dọn: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.ElapsedMinutes, StringFormat='{}{0} phút'}" Foreground="#17365D"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Còn lại: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.RemainingMinutes, StringFormat='~{0} phút'}" Foreground="#2563EB" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Tạm dừng: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.TotalPauseMinutes, StringFormat='{}{0} phút'}" Foreground="#F59E0B"/></TextBlock></StackPanel></Border>
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" Visibility="{Binding SelectedRoom.CurrentTask, Converter={StaticResource StringToVis}}"><StackPanel>
                                    <TextBlock Text="Công việc hiện tại" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SelectedRoom.CurrentTask}" FontSize="13" FontWeight="SemiBold" Foreground="#2563EB"/></StackPanel></Border>
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,6"><StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="Tiến độ" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/><TextBlock Text="{Binding SelectedRoom.ProgressPercent, StringFormat='  {0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB"/></StackPanel>
                                    <ProgressBar Value="{Binding SelectedRoom.ProgressPercent, Mode=OneWay}" Style="{StaticResource ProgressBar}" Margin="0,0,0,6"/></StackPanel></Border>
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Visibility="{Binding SelectedRoom.IsOverdue, Converter={StaticResource BoolToVis}}">
                                    <Border CornerRadius="6" Padding="8,6" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"><StackPanel>
                                        <TextBlock Text="&#x26A0; QUÁ HẠN SLA" FontSize="13" FontWeight="Bold" Foreground="#DC2626"/><TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#991B1B"><Run Text="Vượt "/><Run Text="{Binding SelectedRoom.ElapsedMinutes, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" phút — SLA: "/><Run Text="{Binding SelectedRoom.ExpectedDurationMinutes, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" phút"/></TextBlock></StackPanel></Border></Border></StackPanel>

                            <!-- TAB 2: Checklist -->
                            <StackPanel x:Name="DetailTab2" Visibility="Collapsed">
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10"><StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="Checklist vệ sinh" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/><TextBlock Text="{Binding SelectedRoom.ProgressPercent, StringFormat='  {0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB"/></StackPanel>
                                    <ProgressBar Value="{Binding SelectedRoom.ProgressPercent, Mode=OneWay}" Style="{StaticResource ProgressBar}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Checklist}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:CleaningChecklistItem}">
                                        <Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding IconGlyph}" FontSize="14" Width="26"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11" Foreground="#334155"/>
                                            <TextBlock Grid.Column="2" Text="&#x2713;" FontSize="13" Foreground="#16A34A" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Grid.Column="2" Text="&#x25CB;" FontSize="13" Foreground="#CBD5E1"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel>

                            <!-- TAB 3: Timeline -->
                            <StackPanel x:Name="DetailTab3" Visibility="Collapsed">
                                <ItemsControl ItemsSource="{Binding RoomTimeline}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:CleaningTimelineEntry}">
                                    <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm dd/MM}'}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                        <Rectangle Grid.Column="1" Width="2" Fill="#E2E8F0" HorizontalAlignment="Center"/><Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding Color, Converter={StaticResource StringToBrush}}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="10,7" BorderBrush="#F1F5F9" BorderThickness="1" Margin="0,0,0,6"><StackPanel><TextBlock Text="{Binding Event}" FontSize="11" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#64748B"/></StackPanel></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>

                            <!-- TAB 4: History -->
                            <StackPanel x:Name="DetailTab4" Visibility="Collapsed">
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,6"><StackPanel>
                                    <TextBlock Text="Thông tin bổ sung" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Maintenance: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.MaintenanceNote, TargetNullValue='Không'}" Foreground="#D97706"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Lost &amp; Found: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.LostFoundNote, TargetNullValue='Không'}" Foreground="#7C3AED"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Minibar: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.MinibarStatus}" Foreground="{Binding SelectedRoom.MinibarStatusColor, Converter={StaticResource StringToBrush}}" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Ảnh: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.PhotoUrls.Count, StringFormat='{}{0} ảnh'}" Foreground="#64748B"/></TextBlock></StackPanel></Border>
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,6"><StackPanel>
                                    <TextBlock Text="Kiểm tra" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Inspector: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.Inspector}" Foreground="#17365D" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Thời gian: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.InspectionTime, StringFormat='{}{0:HH:mm}'}" Foreground="#7C3AED"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1"><Run Text="Kết quả: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.InspectionPassed, StringFormat='{}{0}'}" Foreground="#16A34A" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="11" Margin="0,1" Visibility="{Binding SelectedRoom.InspectionReason, Converter={StaticResource StringToVis}}"><Run Text="Lý do: " Foreground="#94A3B8"/><Run Text="{Binding SelectedRoom.InspectionReason}" Foreground="#DC2626"/></TextBlock></StackPanel></Border>
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10"><StackPanel>
                                    <TextBlock Text="Ghi chú" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SelectedRoom.Remark, TargetNullValue='—'}" FontSize="11" Foreground="#64748B"/></StackPanel></Border></StackPanel></StackPanel></ScrollViewer></Grid></Border>

            <!-- Empty detail -->
            <Border Grid.Column="2" Width="380" Margin="6,8,10,8" Style="{StaticResource PanelCard}" Visibility="{Binding IsDetailClosed, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE8D1;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                    <TextBlock Text="Chọn một phòng" FontSize="16" FontWeight="SemiBold" Foreground="#52657D" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="để xem tiến độ dọn phòng." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/></StackPanel></Border></Grid>

        <!-- FOOTER -->
        <Border Grid.Row="5" Padding="14,8" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding PageDisplay}" FontSize="11" Foreground="#64748B"/>
                    <Border CornerRadius="6" Padding="6,2" Margin="10,0,0,0" Background="#EFF6FF"><TextBlock FontSize="11" Foreground="#2563EB" FontWeight="SemiBold"><Run Text="Đang dọn: "/><Run Text="{Binding CleaningCount, Mode=OneWay}"/><Run Text=" · Tạm dừng: "/><Run Text="{Binding PausedCount, Mode=OneWay}"/><Run Text=" · Overdue: "/><Run Text="{Binding OverdueCount, Mode=OneWay}"/></TextBlock></Border></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x00AB;" Command="{Binding FirstPageCommand}" Style="{StaticResource PagerBtn}" IsEnabled="{Binding HasPrevPage}" ToolTip="Trang đầu"/>
                    <Button Content="&#x2039;" Command="{Binding PrevPageCommand}" Style="{StaticResource PagerBtn}" IsEnabled="{Binding HasPrevPage}" ToolTip="Trang trước"/>
                    <ItemsControl ItemsSource="{Binding PageButtons}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:CleaningPaginationButton}">
                            <Button Style="{StaticResource PagerPageBtn}" Command="{Binding DataContext.SetPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding PageNumber}"/>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="&#x203A;" Command="{Binding NextPageCommand}" Style="{StaticResource PagerBtn}" IsEnabled="{Binding HasNextPage}" ToolTip="Trang sau"/>
                    <Button Content="&#x00BB;" Command="{Binding LastPageCommand}" Style="{StaticResource PagerBtn}" IsEnabled="{Binding HasNextPage}" ToolTip="Trang cuối"/>
                    <ComboBox ItemsSource="{x:Static vm:CleaningInProgressViewModel.PageSizeOptions}" SelectedItem="{Binding PageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemStringFormat="{}{0} / trang" Style="{StaticResource FluentComboBox}" Width="122" Height="32" MinWidth="0" Margin="8,0,0,0"/>
                </StackPanel></Grid></Border></Grid></UserControl>
