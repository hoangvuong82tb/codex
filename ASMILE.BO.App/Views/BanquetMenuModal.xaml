<Window x:Class="ASMILE.BO.App.Views.BanquetMenuModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
        Title="Chọn thực đơn" Width="1100" Height="720"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip" Background="White"
        FontFamily="Segoe UI" ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#0F2A55" Margin="0,0,0,8"/>

    <Grid Grid.Row="1" Visibility="{Binding IsCustomMenu, Converter={StaticResource B2V}}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <ScrollViewer Grid.Column="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Margin="0,0,4,0">
        <ItemsControl ItemsSource="{Binding CategoryNodes}" Margin="4,0">
          <ItemsControl.ItemTemplate><DataTemplate>
            <StackPanel>
              <Button Height="30" Padding="4,0" FontSize="12" Cursor="Hand" HorizontalContentAlignment="Left"
                      Background="Transparent" Foreground="#475569" BorderThickness="0"
                      Command="{Binding DataContext.ToggleCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="▶" Width="14" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center"
                             Visibility="{Binding HasChildren, Converter={StaticResource B2V}}"/>
                  <TextBlock Text="{Binding Category.Name}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </StackPanel>
              </Button>
              <ItemsControl ItemsSource="{Binding Children}" Visibility="{Binding IsExpanded, Converter={StaticResource B2V}}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Height="28" Padding="18,0,4,0" FontSize="12" Cursor="Hand" HorizontalContentAlignment="Left"
                          Background="Transparent" Foreground="#64748B" BorderThickness="0"
                          Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding Category.Id}">
                    <TextBlock Text="{Binding Category.Name}"/>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               Height="34" FontSize="13" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,0,6"/>

      <Grid Grid.Row="1" Grid.Column="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="6*"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,4,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ItemsSource}" Margin="4">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Margin="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Cursor="Hand">
                  <Border.InputBindings><MouseBinding Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" MouseAction="LeftClick"/></Border.InputBindings>
                  <StackPanel>
                    <Border Height="85" Background="#FFF7ED" CornerRadius="4,4,0,0" ClipToBounds="True">
                      <Grid><Image Source="{Binding DisplayImageSource}" Stretch="UniformToFill"/>
                        <TextBlock Text="{Binding Emoji}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <StackPanel Margin="5,3,5,2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="10" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}" FontWeight="Bold" FontSize="10" Foreground="#EA580C" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8" Margin="4,0,0,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,6">
              <TextBlock Text="Món đã chọn" FontSize="13" FontWeight="Bold" Foreground="#1E3352"/>
              <TextBlock FontSize="11" Foreground="#64748B"><Run Text="{Binding SelectedItems.Count}"/><Run Text=" món"/></TextBlock>
            </StackPanel>
            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="4" Padding="4,3" Margin="0,0,0,2">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="66"/><ColumnDefinition Width="60"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                <TextBlock Text="STT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                <TextBlock Grid.Column="1" Text="Tên món" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                <TextBlock Grid.Column="2" Text="ĐV" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                <TextBlock Grid.Column="3" Text="SL" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Đơn giá" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="5" Text="Thành tiền" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding SelectedItems}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="2,5">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="66"/><ColumnDefinition Width="60"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding LineNo}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding FoodItem.Name}" FontSize="11" FontWeight="SemiBold" Foreground="#0F2A55" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="2" Text="{Binding UnitName}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                      <Grid Grid.Column="3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Content="−" Width="18" Height="18" FontSize="9" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="11" FontWeight="Bold" Foreground="#0F2A55" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="+" Width="18" Height="18" FontSize="9" Background="#EFF6FF" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                      </Grid>
                      <TextBlock Grid.Column="4" Text="{Binding UnitPrice, StringFormat={}{0:N0}}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                      <TextBlock Grid.Column="5" Text="{Binding LineTotal, StringFormat={}{0:N0} đ}" FontSize="11" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="6" Padding="6,4" Margin="0,4,0,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#64748B"><Run Text="{Binding TotalItems}"/><Run Text=" món"/></TextBlock>
                <TextBlock Grid.Column="1" Text="Tổng tiền 1 bàn: " FontSize="11" FontWeight="SemiBold" Foreground="#0F2A55" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat={}{0:N0} đ}" FontSize="12" FontWeight="Bold" Foreground="#EA580C" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowPresetLayout, Converter={StaticResource B2V}}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- LEFT: Category tree + existing packages -->
        <Grid Grid.Column="0" Grid.RowSpan="2">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/></Grid.RowDefinitions>

          <!-- Food category tree -->
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Margin="0,0,4,0">
            <StackPanel>
              <TextBlock Text="Danh mục món" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="6,4,0,4"/>
              <ItemsControl ItemsSource="{Binding CategoryNodes}" Margin="4,0">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <StackPanel>
                    <Button Height="30" Padding="4,0" FontSize="12" Cursor="Hand" HorizontalContentAlignment="Left"
                            Background="Transparent" Foreground="#475569" BorderThickness="0"
                            Command="{Binding DataContext.ToggleCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶" Width="14" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center"
                                   Visibility="{Binding HasChildren, Converter={StaticResource B2V}}"/>
                        <TextBlock Text="{Binding Category.Name}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                      </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Children}" Visibility="{Binding IsExpanded, Converter={StaticResource B2V}}">
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Height="28" Padding="18,0,4,0" FontSize="12" Cursor="Hand" HorizontalContentAlignment="Left"
                                Background="Transparent" Foreground="#64748B" BorderThickness="0"
                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Category.Id}">
                          <TextBlock Text="{Binding Category.Name}"/>
                        </Button>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- Separator + Existing packages header -->
          <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="6,8,6,4" Margin="0,4,4,0">
            <Grid>
              <TextBlock Text="Gói đã có" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
              <Button HorizontalAlignment="Right" Height="26" Padding="8,0" FontSize="10" FontWeight="SemiBold"
                      Background="#059669" Foreground="White" BorderThickness="0" Cursor="Hand"
                      Command="{Binding OpenNewPackageEditorCommand}">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13"/></Style></Button.Resources>
                <TextBlock Text="+ Tạo mới"/>
              </Button>
            </Grid>
          </Border>

          <!-- Existing packages list -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
            <ItemsControl ItemsSource="{Binding PackageListSource}" Margin="4,2">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Padding="8,7" Margin="0,1" CornerRadius="6" Cursor="Hand" Background="White">
                  <Border.InputBindings><MouseBinding Command="{Binding DataContext.AttachPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" MouseAction="LeftClick"/></Border.InputBindings>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#0F2A55" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} đ/bàn}" FontSize="11" Foreground="#059669" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <!-- RIGHT: Search + Food grid -->
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Height="34" FontSize="13" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,0,6"/>

        <Grid Grid.Row="1" Grid.Column="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="6*"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>

          <!-- Food items grid -->
          <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,4,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ItemsSource}" Margin="4">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border Margin="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Cursor="Hand">
                    <Border.InputBindings><MouseBinding Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" MouseAction="LeftClick"/></Border.InputBindings>
                    <StackPanel>
                      <Border Height="85" Background="#FFF7ED" CornerRadius="4,4,0,0" ClipToBounds="True">
                        <Grid><Image Source="{Binding DisplayImageSource}" Stretch="UniformToFill"/>
                          <TextBlock Text="{Binding Emoji}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                      <StackPanel Margin="5,3,5,2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="10" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}" FontWeight="Bold" FontSize="10" Foreground="#EA580C" Margin="0,2,0,0"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <!-- RIGHT PANEL: Selected items + Package form -->
          <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8" Margin="4,0,0,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

              <!-- Package editor toggle -->
              <StackPanel Grid.Row="0" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Tạo gói mới" FontSize="13" FontWeight="Bold" Foreground="#1E3352" VerticalAlignment="Center"/>
                  <ToggleButton Margin="8,0,0,0" IsChecked="{Binding ShowPackageEditor}" Width="40" Height="20"
                                Background="#E2E8F0" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                                Command="{Binding OpenNewPackageEditorCommand}">
                    <ToggleButton.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></ToggleButton.Resources>
                  </ToggleButton>
                </StackPanel>
              </StackPanel>

              <!-- Package name + price form (when editor open) -->
              <Border Grid.Row="1" Padding="0,0,0,6" Visibility="{Binding ShowPackageEditor, Converter={StaticResource B2V}}">
                <StackPanel>
                  <TextBlock Text="Tên gói" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                  <TextBox Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="13" Padding="8,0" Margin="0,0,0,4"/>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Đơn giá/bàn" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                      <TextBox Text="{Binding PackagePrice, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="13" Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="VAT %" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                      <TextBox Text="{Binding PackageVatRate, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="13" Padding="8,0"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Selected items header -->
              <StackPanel Grid.Row="2" Margin="0,6,0,0">
                <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="4" Padding="4,3" Margin="0,0,0,2">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="66"/><ColumnDefinition Width="60"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                    <TextBlock Text="STT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Grid.Column="1" Text="Tên món" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Grid.Column="2" Text="ĐV" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Grid.Column="3" Text="SL" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="Đơn giá" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    <TextBlock Grid.Column="5" Text="Thành tiền" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                  </Grid>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                  <ItemsControl ItemsSource="{Binding SelectedItems}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="2,5">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="66"/><ColumnDefinition Width="60"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding LineNo}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding FoodItem.Name}" FontSize="11" FontWeight="SemiBold" Foreground="#0F2A55" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="2" Text="{Binding UnitName}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                          <Grid Grid.Column="3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Content="−" Width="18" Height="18" FontSize="9" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="11" FontWeight="Bold" Foreground="#0F2A55" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="+" Width="18" Height="18" FontSize="9" Background="#EFF6FF" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                          </Grid>
                          <TextBlock Grid.Column="4" Text="{Binding UnitPrice, StringFormat={}{0:N0}}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                          <TextBlock Grid.Column="5" Text="{Binding LineTotal, StringFormat={}{0:N0} đ}" FontSize="11" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>

              <!-- Totals + Save -->
              <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="6" Padding="6,4" Margin="0,4,0,0" Visibility="{Binding ShowPackageEditor, Converter={StaticResource B2V}}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="#64748B"><Run Text="{Binding TotalItems}"/><Run Text=" món"/></TextBlock>
                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0} đ}" FontSize="13" FontWeight="Bold" Foreground="#EA580C"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Hủy" Height="32" Padding="14,0" FontSize="11" Margin="0,0,6,0"
                          Background="White" Foreground="#64748B" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand"
                          Command="{Binding CancelPackageEditorCommand}">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                  </Button>
                  <Button Grid.Column="2" Content="Lưu gói" Height="32" Padding="14,0" FontSize="11" FontWeight="SemiBold"
                          Background="#059669" Foreground="White" BorderThickness="0" Cursor="Hand"
                          Command="{Binding SavePackageCommand}">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                  </Button>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>