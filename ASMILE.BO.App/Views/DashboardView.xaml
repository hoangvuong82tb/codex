<UserControl x:Class="ASMILE.BO.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="Dashboard điều hành" Style="{StaticResource SectionTitleTextStyle}" DockPanel.Dock="Left" />
                <Button Content="Làm mới" Command="{Binding LoadCommand}" DockPanel.Dock="Right" />
            </DockPanel>

            <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Tổng hàng hóa" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalItems}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Nhà cung cấp" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalSuppliers}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Số kho đang vận hành" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalWarehouses}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ContentCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Giá trị tồn kho" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding InventoryValue, StringFormat={}{0:N0}}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="KPI vận hành tháng hiện tại" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Tiến độ xử lý phiếu nhập" Foreground="{StaticResource TextSecondaryBrush}" />
                                <ProgressBar Value="76" Maximum="100" Height="10" />
                                <TextBlock Text="76%" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock Text="Tiến độ xử lý phiếu xuất" Foreground="{StaticResource TextSecondaryBrush}" />
                                <ProgressBar Value="68" Maximum="100" Height="10" />
                                <TextBlock Text="68%" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Độ sẵn sàng dữ liệu kho" Foreground="{StaticResource TextSecondaryBrush}" />
                                <ProgressBar Value="91" Maximum="100" Height="10" />
                                <TextBlock Text="91%" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ContentCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Công nợ và doanh thu" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Border Style="{StaticResource StatusBadgeStyle}" Background="#E6F4EA" Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock Text="Phải thu" DockPanel.Dock="Left" />
                                <TextBlock Text="320,500,000" DockPanel.Dock="Right" Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource StatusBadgeStyle}" Background="#FFF4E6" Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock Text="Phải chi" DockPanel.Dock="Left" />
                                <TextBlock Text="210,300,000" DockPanel.Dock="Right" Foreground="{StaticResource AccentOrangeBrush}" FontWeight="SemiBold" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource StatusBadgeStyle}" Background="#EEF2FF">
                            <DockPanel>
                                <TextBlock Text="Doanh số tháng" DockPanel.Dock="Left" />
                                <TextBlock Text="850,750,000" DockPanel.Dock="Right" Foreground="{StaticResource AccentPurpleBrush}" FontWeight="SemiBold" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Nhắc việc" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="• 3 hóa đơn bán hàng chưa thu tiền" Margin="0,0,0,8" />
                        <TextBlock Text="• 2 phiếu nhập kho chờ duyệt" Margin="0,0,0,8" />
                        <TextBlock Text="• 2 hợp đồng sắp hết hạn" Margin="0,0,0,8" />
                        <TextBlock Text="• 1 cảnh báo tồn kho thấp" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ContentCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Phiếu tháng này" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="Phiếu nhập" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ReceiptsThisMonth}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Phiếu xuất" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding IssuesThisMonth}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="SLA hoàn tất đúng hạn" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="92%" FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ContentCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Hoạt động gần đây" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="• Phiếu xuất kho PX000123 đã được tạo - 10 phút trước" Margin="0,0,0,8" />
                        <TextBlock Text="• Hóa đơn bán hàng HD000456 đã thu tiền - 20 phút trước" Margin="0,0,0,8" />
                        <TextBlock Text="• Nhập kho từ NCC A - PN000789 - 30 phút trước" Margin="0,0,0,8" />
                        <TextBlock Text="• Cập nhật danh mục hàng hóa - 45 phút trước" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
