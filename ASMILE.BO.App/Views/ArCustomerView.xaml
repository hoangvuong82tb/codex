                                <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Credit Limit" FontSize="10" Foreground="#2563EB" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.CreditLimit, StringFormat='{}{0:N0} ₫'}" FontSize="12" FontWeight="Bold" Foreground="#2563EB" FontFamily="Segoe UI"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Available Credit" FontSize="10" Foreground="#64748B" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.AvailableCredit, StringFormat='{}{0:N0} ₫'}" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedItem.IsOverCreditLimit}" Value="True"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <!-- Credit Limit Warning -->
                                <Border Grid.Row="2" Background="#FEF2F2" CornerRadius="4" Padding="6,3" Margin="0,6,0,0" Visibility="{Binding SelectedItem.IsOverCreditLimit, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="⚠ CREDIT LIMIT EXCEEDED" FontSize="9" FontWeight="Bold" Foreground="#DC2626" FontFamily="Segoe UI"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Quick Stats -->
                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#F8FAFC" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Hóa đơn mở" FontSize="10" Foreground="#475569" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedItem.OpenInvoiceCount}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" FontFamily="Segoe UI"/>
                            </Grid>
                            <Grid Grid.Row="1" Background="#F8FAFC" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Thanh toán chờ" FontSize="10" Foreground="#475569" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedItem.PendingPayment, StringFormat='{}{0:N0} ₫'}" FontSize="10" Foreground="#D97706" FontFamily="Segoe UI"/>
                            </Grid>
                            <Grid Grid.Row="2" Background="#F8FAFC" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Đặt cọc" FontSize="10" Foreground="#475569" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedItem.TotalDeposit, StringFormat='{}{0:N0} ₫'}" FontSize="10" Foreground="#2563EB" FontFamily="Segoe UI"/>
                            </Grid>
                            <Grid Grid.Row="3" Background="#F8FAFC" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Đã hoàn" FontSize="10" Foreground="#475569" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedItem.TotalRefund, StringFormat='{}{0:N0} ₫'}" FontSize="10" Foreground="#64748B" FontFamily="Segoe UI"/>
                            </Grid>
                        </Grid>

                        <!-- Last Activity -->
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="HOẠT ĐỘNG GẦN ĐÂY" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <Grid Grid.Row="1" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Last Stay" FontSize="9" Foreground="#64748B" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.LastStayDate, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="9" Foreground="#475569" FontFamily="Segoe UI"/>
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Last Reservation" FontSize="9" Foreground="#64748B" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.LastReservationDate, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="9" Foreground="#475569" FontFamily="Segoe UI"/>
                                </Grid>
                                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Last Payment" FontSize="9" Foreground="#64748B" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.LastPaymentDate, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="9" Foreground="#475569" FontFamily="Segoe UI"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Warnings -->
                        <Border CornerRadius="8" Padding="10,7" Visibility="{Binding SelectedItem.HasWarning, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FEF2F2"/>
                                    <Setter Property="BorderBrush" Value="#FECACA"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="⚠ CẢNH BÁO" FontSize="10" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <ItemsControl ItemsSource="{Binding SelectedItem.Warnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type system:String}">
                                            <TextBlock Text="{Binding}" FontSize="9" Foreground="#DC2626" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ ROW 4: FOOTER ═══ -->
        <Border Grid.Row="4" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageDisplay}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    <Border CornerRadius="5" Padding="5,1" Margin="8,0,0,0" Background="#EFF6FF">
                        <TextBlock Text="AR Customer Master" FontSize="10" Foreground="#2563EB" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x00AB;" Style="{StaticResource PagerBtn}" Command="{Binding FirstPageCommand}" IsEnabled="{Binding HasPrevPage}" ToolTip="Trang đầu"/>
                    <Button Content="&#x2039;" Style="{StaticResource PagerBtn}" Command="{Binding PrevPageCommand}" IsEnabled="{Binding HasPrevPage}" ToolTip="Trang trước"/>
                    <ItemsControl ItemsSource="{Binding PageButtons}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArCustomerPaginationButton}">
                            <Button Style="{StaticResource PagerPageBtn}" Command="{Binding DataContext.SetPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding PageNumber}"/>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="&#x203A;" Style="{StaticResource PagerBtn}" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" ToolTip="Trang sau"/>
                    <Button Content="&#x00BB;" Style="{StaticResource PagerBtn}" Command="{Binding LastPageCommand}" IsEnabled="{Binding HasNextPage}" ToolTip="Trang cuối"/>
                    <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemStringFormat="{}{0} / trang" Style="{StaticResource FluentComboBox}" Width="122" Height="32" MinWidth="0" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ FORM OVERLAY ═══════════════════════════════════════ -->
        <Border Grid.RowSpan="5" Background="#80000000" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Border Background="White" CornerRadius="12" MaxWidth="520" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="12,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FormTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                                <Button Grid.Column="1" Content="Đóng" Style="{StaticResource SecondaryBtn}" Width="52" Height="28" Padding="6,0" Command="{Binding CloseFormCommand}"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,10">
                            <StackPanel>
                                <Border Background="#FEF2F2" CornerRadius="6" Padding="8,5" Margin="0,0,0,8" Visibility="{Binding FormErrorMessage, Converter={StaticResource StringToVis}}">
                                    <TextBlock Text="{Binding FormErrorMessage}" FontSize="10" Foreground="#DC2626" FontFamily="Segoe UI"/>
                                </Border>

                                <!-- EDIT FORM -->
                                <StackPanel Visibility="{Binding IsEditForm, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Tên khách hàng *" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding EditCustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Tên tắt" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                            <TextBox Text="{Binding EditShortName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Loại KH" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                            <ComboBox SelectedItem="{Binding EditCustomerType}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0">
                                                <ComboBoxItem Content="Corporate"/><ComboBoxItem Content="TravelAgent"/><ComboBoxItem Content="Company"/>
                                                <ComboBoxItem Content="Government"/><ComboBoxItem Content="VIP"/><ComboBoxItem Content="Individual"/><ComboBoxItem Content="OTA"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="MST" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding EditTaxCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                                    <TextBlock Text="Địa chỉ" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Phone" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                            <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Email" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                            <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Credit Limit" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                            <TextBox Text="{Binding EditCreditLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Credit Days" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                            <TextBox Text="{Binding EditCreditDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Sales" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding EditSalesPerson, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                                </StackPanel>

                                <!-- PAYMENT FORM -->
                                <StackPanel Visibility="{Binding IsPaymentForm, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Số tiền thu *" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                                    <TextBlock Text="Phương thức" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                    <ComboBox SelectedItem="{Binding PaymentMethod}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Tiền mặt"/><ComboBoxItem Content="Chuyển khoản"/>
                                        <ComboBoxItem Content="Thẻ tín dụng"/><ComboBoxItem Content="Ví điện tử"/><ComboBoxItem Content="Séc"/>
                                    </ComboBox>
                                    <TextBlock Text="Số tham chiếu" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding PaymentReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                                </StackPanel>

                                <!-- EMAIL FORM -->
                                <StackPanel Visibility="{Binding IsEmailForm, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Loại Email" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                    <ComboBox SelectedItem="{Binding EmailType}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Statement"/><ComboBoxItem Content="Invoice"/><ComboBoxItem Content="Reminder"/><ComboBoxItem Content="BalanceConfirmation"/>
                                    </ComboBox>
                                    <TextBlock Text="Email *" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding EmailTo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                                    <TextBlock Text="Nội dung" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding EmailBody, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Hủy" Style="{StaticResource SecondaryBtn}" Width="70" Command="{Binding CloseFormCommand}" Margin="0,0,6,0"/>
                                <Button Content="Lưu" Width="70">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditForm}" Value="True"><Setter Property="Command" Value="{Binding SubmitEditFormCommand}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding IsPaymentForm}" Value="True"><Setter Property="Command" Value="{Binding SubmitPaymentFormCommand}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding IsEmailForm}" Value="True"><Setter Property="Command" Value="{Binding SubmitEmailFormCommand}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.RowSpan="5" Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Đang tải..." FontSize="14" Foreground="#64748B" FontFamily="Segoe UI"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
