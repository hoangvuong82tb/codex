<UserControl x:Class="ASMILE.BO.App.Views.HotelRoomConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource HotelSettingsButtonBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/></Style>
        <Style x:Key="SettingsTextBox" TargetType="TextBox" BasedOn="{StaticResource HotelSettingsTextBoxBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/></Style>
    </UserControl.Resources>
    <Grid Background="Transparent" Margin="0,0,0,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Padding="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Quản lý phòng" FontSize="22" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Danh mục phòng độc lập: thêm, sửa, gắn hạng phòng, tòa nhà, tầng và trạng thái khai thác." Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Làm mới" Command="{Binding LoadCommand}" Style="{StaticResource SettingsButton}"/><Button Content="+ Thêm phòng" Command="{Binding NewRoomCommand}" Style="{StaticResource SettingsPrimaryButton}" Margin="0"/></StackPanel></Grid></Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Từ khóa" Grid.Column="0" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" ToolTip="Tìm theo số phòng hoặc tên phòng"/><Button Grid.Row="1" Grid.Column="2" Content="Tìm" Command="{Binding SearchCommand}" Style="{StaticResource SettingsButton}" Margin="8,0,0,0"/></Grid></Border>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
            <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="False"><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#F8FAFC" CornerRadius="10" ClipToBounds="True" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="Số phòng" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/><TextBlock Grid.Column="1" Text="Tên phòng" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/><TextBlock Grid.Column="2" Text="Hạng phòng" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/><TextBlock Grid.Column="3" Text="Tòa / tầng" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/></Grid></Border><ListBox ItemContainerStyle="{StaticResource HotelSettingsListBoxItemStyle}" Grid.Row="1" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom, Mode=TwoWay}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RoomNumber}" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="#17365D" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding HotelRoomTypeName}" Foreground="#475569" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding Building}" Foreground="#475569"><TextBlock.ToolTip><TextBlock Text="{Binding Floor}"/></TextBlock.ToolTip></TextBlock></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
            <Border Grid.Column="1" Margin="16,0,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16"><StackPanel><StackPanel><TextBlock Text="Chi tiết phòng" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="{Binding SelectedSummary}" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/><StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Số phòng *" Foreground="#475569"/><TextBox Text="{Binding RoomNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,8"/><TextBlock Text="Tên hiển thị" Foreground="#475569"/><TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,8"/><TextBlock Text="Hạng phòng *" Foreground="#475569"/><ComboBox Style="{StaticResource HotelSettingsComboBoxBase}" ItemsSource="{Binding RoomTypes}" SelectedItem="{Binding SelectedRoomType, Mode=TwoWay}" DisplayMemberPath="Name" Height="34" Padding="10,0" BorderBrush="#D7E2F0" Margin="0,4,0,8"/><TextBlock Text="Tòa nhà *" Foreground="#475569"/><ComboBox Style="{StaticResource HotelSettingsComboBoxBase}" ItemsSource="{Binding Buildings}" SelectedItem="{Binding SelectedBuilding, Mode=TwoWay}" DisplayMemberPath="Name" Height="34" Padding="10,0" BorderBrush="#D7E2F0" Margin="0,4,0,8"/><TextBlock Text="Tầng *" Foreground="#475569"/><ComboBox Style="{StaticResource HotelSettingsComboBoxBase}" ItemsSource="{Binding Floors}" SelectedItem="{Binding SelectedFloor, Mode=TwoWay}" DisplayMemberPath="Name" Height="34" Padding="10,0" BorderBrush="#D7E2F0" Margin="0,4,0,8"/><TextBlock Text="Khu vực" Foreground="#475569"/><ComboBox Style="{StaticResource HotelSettingsComboBoxBase}" ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea, Mode=TwoWay}" DisplayMemberPath="Name" Height="34" Padding="10,0" BorderBrush="#D7E2F0" Margin="0,4,0,8"/><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,5,0"><TextBlock Text="Tình trạng" Foreground="#475569"/><TextBox Text="{Binding RoomCondition, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Hướng nhìn" Foreground="#475569"/><TextBox Text="{Binding View, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,0"/></StackPanel></Grid><TextBlock Text="Loại giường" Foreground="#475569"/><TextBox Text="{Binding BedType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,10"/><StackPanel Orientation="Horizontal"><CheckBox Content="Cho phép hút thuốc" IsChecked="{Binding IsSmoking}"/><CheckBox Content="Connecting" IsChecked="{Binding IsConnecting}" Margin="18,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Hủy" Command="{Binding CancelEditCommand}" Style="{StaticResource SettingsButton}"/><Button Content="Lưu phòng" Command="{Binding SaveCommand}" Style="{StaticResource SettingsPrimaryButton}" Margin="0"/></StackPanel></StackPanel><StackPanel Visibility="{Binding IsReadOnlyPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Trạng thái" Foreground="#64748B" Margin="0,0,0,3"/><TextBlock Text="{Binding SelectedStatus}" Foreground="#17365D" FontWeight="SemiBold"/><TextBlock Text="Hạng phòng, tòa nhà, tầng và khu vực được chọn từ các danh mục master độc lập." Foreground="#64748B" TextWrapping="Wrap" Margin="0,14,0,16"/><StackPanel Orientation="Horizontal"><Button Content="Sửa" Command="{Binding EditRoomCommand}" Style="{StaticResource SettingsPrimaryButton}"/><Button Content="Bật / tạm ngưng" Command="{Binding ToggleActiveCommand}" Style="{StaticResource SettingsButton}" Margin="0"/></StackPanel></StackPanel><Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap"/></Border><Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0" Visibility="{Binding HasInfo, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding InfoMessage}" Foreground="#166534" TextWrapping="Wrap"/></Border></StackPanel></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>




