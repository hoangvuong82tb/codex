                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ STEP B: QUÉT GIẤY TỜ ═══ -->
        <Grid Visibility="{Binding IsStepB, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5*" MinWidth="420"/><ColumnDefinition Width="16"/><ColumnDefinition Width="3*" MinWidth="260"/></Grid.ColumnDefinitions>

            <!-- LEFT: SCAN INPUT -->
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="26,22">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
