                        <Border Height="1" Background="#E2E8F0" Margin="0,2,0,10"/>

                        <!-- Row 2: Action buttons (SINGLE ROW, equal size) -->
                        <WrapPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <Button Content="Quét CCCD" Style="{StaticResource ActionBtn}" IsEnabled="False" TabIndex="22"/>
                            <Button Content="Quét Passport" Style="{StaticResource ActionBtn}" IsEnabled="False" Margin="8,0,0,0"/>
                            <Button Content="Nạp ảnh" Style="{StaticResource ActionBtn}" IsEnabled="False" Margin="8,0,0,0"/>
                            <Button Content="Tìm khách cũ" Style="{StaticResource ActionBtn}" TabIndex="23" Margin="8,0,0,0"/>
                            <Button Content="Xóa kết quả" Style="{StaticResource ActionBtn}" Margin="8,0,0,0"/>
                        </WrapPanel>

                        <Border Height="1" Background="#E2E8F0" Margin="0,2,0,10"/>

                        <!-- Row 3+: Form fields (2 columns, same as Step A) -->
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Họ và tên" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding SelectedGuest.FullName, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" TabIndex="24"/>
                            </Grid>
                            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Giới tính" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Text="{Binding SelectedGuest.Gender, RelativeSource={RelativeSource AncestorType=UserControl}}" TabIndex="25"><ComboBoxItem Content="Nam"/><ComboBoxItem Content="Nữ"/></ComboBox>
                            </Grid>
                        </Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Ngày sinh" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
