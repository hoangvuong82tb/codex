                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding SelectedGuest.IssuePlace, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsCCCD, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}" TabIndex="30"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding SelectedGuest.ExpiryDate, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsPassport, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}" TabIndex="30"/>
                            </Grid>
                        </Grid>
                        <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Địa chỉ" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding SelectedGuest.PermanentAddress, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" TabIndex="31"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: PREVIEW -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20,18">
