                            <TextBlock Text="Phòng" FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Text="{Binding Modal.Workspace.SelectedRoomType.Name, FallbackValue=Chưa chọn, TargetNullValue=—}"/>
