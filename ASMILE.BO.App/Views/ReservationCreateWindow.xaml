                <StackPanel>
                    <TextBlock Text="Chi tiết giấy tờ" FontSize="16" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,14"/>

                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Khách" FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI"><Run Text="Khách "/><Run Text="{Binding SelectedGuest.GuestIndex, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=—}"/></TextBlock>
                            <TextBlock FontSize="13" Foreground="#6F8198" FontFamily="Segoe UI" Text="{Binding SelectedGuest.Role, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=Người lớn}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Giấy tờ" FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Text="{Binding SelectedGuest.DocumentType, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=CCCD}"/>
                            <TextBlock FontSize="13" Foreground="#6F8198" FontFamily="Segoe UI" Text="{Binding SelectedGuest.DocumentNumber, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=—}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Họ tên" FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Text="{Binding SelectedGuest.FullName, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=—}"/>
                            <TextBlock FontSize="13" Foreground="#6F8198" FontFamily="Segoe UI"><Run Text="{Binding SelectedGuest.Gender, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=—}"/><Run Text=" · "/><Run Text="{Binding SelectedGuest.DateOfBirth, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=—}"/></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Địa chỉ" FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            <TextBlock FontSize="13" Foreground="#6F8198" FontFamily="Segoe UI" Text="{Binding SelectedGuest.PermanentAddress, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=—}"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="14,10" CornerRadius="8" BorderThickness="1" Background="#F0FDF4" BorderBrush="#86EFAC">
                        <TextBlock Text="Chưa quét" FontSize="13" FontFamily="Segoe UI" TextAlignment="Center" Foreground="#166534"/>
                    </Border>

                    <Button Content="Bỏ qua bước này →" Click="SkipToStepC" Margin="0,8,0,0"
                            Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Padding="4,2" Cursor="Hand" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ STEP C: HỒ SƠ KHÁCH ═══ -->
        <Grid Visibility="{Binding IsStepC, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5*" MinWidth="420"/><ColumnDefinition Width="16"/><ColumnDefinition Width="3*" MinWidth="260"/></Grid.ColumnDefinitions>

            <!-- LEFT: GUEST PROFILE -->
