                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" TabIndex="72"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: REALTIME SUMMARY -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="22,24">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Chi tiết tài chính" FontSize="16" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,18"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.Resources>
                            <Style x:Key="SLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#718198"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                            <Style x:Key="SValue" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="Nguồn giá" Style="{StaticResource SLabel}"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PriceSourceLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource SValue}"/>
                        <TextBlock Grid.Row="1" Text="Rate Code" Style="{StaticResource SLabel}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RateCodeValue, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource SValue}"/>
                        <TextBlock Grid.Row="2" Text="Room Rate" Style="{StaticResource SLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RoomRateDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource SValue}"/>
                        <TextBlock Grid.Row="3" Text="Số đêm" Style="{StaticResource SLabel}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Modal.Workspace.Nights, Mode=OneWay}" Style="{StaticResource SValue}"/>
                        <TextBlock Grid.Row="4" Text="Room Charge" Style="{StaticResource SLabel}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RoomChargeDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource SValue}" Foreground="#2F6BFF"/>
                        <TextBlock Grid.Row="5" Text="VAT" Style="{StaticResource SLabel}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding VatLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource SValue}"/>
                        <TextBlock Grid.Row="6" Text="Discount" Style="{StaticResource SLabel}"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DiscountDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource SValue}" Foreground="#16A34A"/>
                        <TextBlock Grid.Row="7" Text="Deposit" Style="{StaticResource SLabel}"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DepositDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource SValue}"/>
                        <TextBlock Grid.Row="8" Text="Payment" Style="{StaticResource SLabel}"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding PaymentDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource SValue}"/>
                        <TextBlock Grid.Row="9" Text="Currency" Style="{StaticResource SLabel}"/><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding CurrencyValue, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource SValue}"/>
                    </Grid>

                    <Border Grid.Row="2" Background="#EFF6FF" CornerRadius="10" Padding="16,14" BorderBrush="#93C5FD" BorderThickness="1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Còn phải thu" FontSize="13" Foreground="#1E40AF" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding BalanceDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#2F6BFF" FontFamily="Segoe UI"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ STEP F: GHI CHÚ ═══ -->
        <Grid Visibility="{Binding IsStepF, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5*" MinWidth="400"/><ColumnDefinition Width="24"/><ColumnDefinition Width="3*" MinWidth="260"/></Grid.ColumnDefinitions>

            <!-- LEFT: NOTES INPUT -->
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="26,24">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Ghi chú" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,14"/>

                    <StackPanel Grid.Row="1">
                        <!-- Booking Notes -->
                        <TextBlock Text="Ghi chú đặt phòng" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Height="120" Text="{Binding BookingNotes, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,8" TabIndex="73" Margin="0,0,0,18"/>

                        <!-- Internal Notes -->
                        <TextBlock Text="Ghi chú nội bộ" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Height="100" Text="{Binding Modal.Workspace.InternalNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,8" TabIndex="74" Margin="0,0,0,18"/>

                        <!-- Special Requests -->
                        <TextBlock Text="Yêu cầu đặc biệt" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Height="90" Text="{Binding SpecialRequests, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,8" TabIndex="75" Margin="0,0,0,18"/>

                        <Border Height="1" Background="#E2E8F0" Margin="0,0,0,18"/>

                        <!-- Transport / Flight -->
                        <TextBlock Text="Vận chuyển &amp; Chuyến bay" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Đón" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource VatToggleSwitch}" IsChecked="{Binding NeedPickup, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" TabIndex="76"/>
                            </Grid>
                            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Tiễn" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource VatToggleSwitch}" IsChecked="{Binding NeedDropoff, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" TabIndex="77"/>
                            </Grid>
                        </Grid>

                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="CB đến" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding FlightArrival, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" TabIndex="78"/>
                            </Grid>
                            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Giờ đến" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding FlightArrivalTime, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" TabIndex="79"/>
                            </Grid>
                        </Grid>

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="CB đi" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding FlightDeparture, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" TabIndex="80"/>
                            </Grid>
                            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Giờ đi" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding FlightDepartureTime, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" TabIndex="81"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: REALTIME SUMMARY -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="22,24">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Tóm tắt ghi chú" FontSize="16" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,18"/>

                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Ghi chú đặt phòng" FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                            <TextBlock FontSize="13" Foreground="#6F8198" FontFamily="Segoe UI" Text="{Binding BookingNotesPreview, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Ghi chú nội bộ" FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                            <TextBlock FontSize="13" Foreground="#6F8198" FontFamily="Segoe UI" Text="{Binding InternalNotesPreview, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Yêu cầu đặc biệt" FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                            <TextBlock FontSize="13" Foreground="#6F8198" FontFamily="Segoe UI" Text="{Binding SpecialRequestsPreview, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Vận chuyển" FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto" MinWidth="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock FontSize="13" Foreground="#6F8198" FontFamily="Segoe UI" Text="Đón:"/>
                                <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Text="{Binding PickupDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                <TextBlock Grid.Column="2" FontSize="13" Foreground="#6F8198" FontFamily="Segoe UI" Text="Tiễn:"/>
                                <TextBlock Grid.Column="3" FontSize="13" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Text="{Binding DropoffDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Chuyến bay đến" FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Text="{Binding FlightArrivalDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Chuyến bay đi" FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Text="{Binding FlightDepartureDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="14,10" CornerRadius="8" BorderThickness="1" Background="#F0FDF4" BorderBrush="#86EFAC" Visibility="{Binding HasNotes, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="Đã có ghi chú" FontSize="13" FontFamily="Segoe UI" TextAlignment="Center" Foreground="#166534"/>
                    </Border>
                    <Border Padding="14,10" CornerRadius="8" BorderThickness="1" Background="#FAFBFD" BorderBrush="#E2E8F0">
                        <TextBlock Text="Không có ghi chú" FontSize="13" FontFamily="Segoe UI" TextAlignment="Center" Foreground="#94A3B8"/>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNotes, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ STEP G: XÁC NHẬN ═══ -->
        <Grid Visibility="{Binding IsStepG, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5.5*" MinWidth="420"/><ColumnDefinition Width="24"/><ColumnDefinition Width="2.5*" MinWidth="240"/></Grid.ColumnDefinitions>

            <!-- LEFT: CONFIRMATION SUMMARY -->
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="26,24">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Xác nhận đặt phòng" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                    <TextBlock Text="Vui lòng kiểm tra toàn bộ thông tin trước khi tạo đặt phòng." FontSize="13" Foreground="#64748B" Margin="0,0,0,18"/>

                    <!-- Change Summary (Edit Mode only) -->
                    <Border Background="#FFF7ED" CornerRadius="10" Padding="16,14" Margin="0,0,0,12" BorderBrush="#FED7AA" BorderThickness="1"
                            Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="Tóm tắt thay đổi" FontSize="14" FontWeight="SemiBold" Foreground="#C2410C" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding ChangeSummary, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <TextBlock FontSize="12" Foreground="#9A3412" Margin="0,2,0,0" Text="{Binding Display}"/>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Chưa có thay đổi." FontSize="12" Foreground="#9A3412" FontStyle="Italic"
                                       Visibility="{Binding HasChanges, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}, FallbackValue=Visible}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding HasChanges, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 1. LƯU TRÚ -->
                    <Border Background="#FAFBFD" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Lưu trú" FontSize="14" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI"/>
                                <Button Grid.Column="1" Content="Chỉnh sửa" Click="GoToStepA" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" FontSize="12" Padding="8,4" TabIndex="82"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI"><Run Text="Ngày đến: "/><Run Text="{Binding Modal.Workspace.ArrivalDate, StringFormat=dd/MM/yyyy}" Foreground="#17365D" FontWeight="SemiBold"/><Run Text=" 14:00"/></TextBlock>
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,2,0,0"><Run Text="Ngày đi: "/><Run Text="{Binding Modal.Workspace.DepartureDate, StringFormat=dd/MM/yyyy}" Foreground="#17365D" FontWeight="SemiBold"/><Run Text=" 12:00"/></TextBlock>
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,2,0,0"><Run Text="Số đêm: "/><Run Text="{Binding Modal.Workspace.Nights, Mode=OneWay}" Foreground="#2563EB" FontWeight="SemiBold"/></TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI"><Run Text="HP dự kiến: "/><Run Text="{Binding RoomTypeDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="#17365D" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,2,0,0"><Run Text="Khách: "/><Run Text="{Binding GuestsSummary, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="#17365D" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,2,0,0"><Run Text="Meal: RO"/></TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 2. KHÁCH -->
                    <Border Background="#FAFBFD" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Khách" FontSize="14" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI"/>
                                <Button Grid.Column="1" Content="Chỉnh sửa" Click="GoToStepC" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" FontSize="12" Padding="8,4" TabIndex="83"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Text="{Binding GuestNameDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                    <TextBlock FontSize="12" Foreground="#6F8198" FontFamily="Segoe UI" Margin="0,2,0,0" Text="{Binding SelectedGuest.Phone, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=—, TargetNullValue=—}"/>
                                    <TextBlock FontSize="12" Foreground="#6F8198" FontFamily="Segoe UI" Margin="0,2,0,0" Text="{Binding SelectedGuest.Email, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=—, TargetNullValue=—}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontSize="12" Foreground="#6F8198" FontFamily="Segoe UI"><Run Text="Quốc tịch: "/><Run Text="{Binding SelectedGuest.Nationality, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=—, TargetNullValue=—}" Foreground="#17365D"/></TextBlock>
                                    <TextBlock FontSize="12" Foreground="#6F8198" FontFamily="Segoe UI" Margin="0,2,0,0"><Run Text="Giấy tờ: "/><Run Text="{Binding SelectedGuest.DocumentType, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=—, TargetNullValue=—}" Foreground="#17365D"/><Run Text=" · "/><Run Text="{Binding SelectedGuest.DocumentNumber, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=—, TargetNullValue=—}" Foreground="#17365D"/></TextBlock>
                                    <TextBlock FontSize="12" Foreground="#6F8198" FontFamily="Segoe UI" Margin="0,2,0,0"><Run Text="Khách đi cùng: "/><Run Text="{Binding Modal.Workspace.Adults}" Foreground="#17365D"/><Run Text=" người"/></TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 3. ĐẶT PHÒNG -->
                    <Border Background="#FAFBFD" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Đặt phòng" FontSize="14" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI"/>
                                <Button Grid.Column="1" Content="Chỉnh sửa" Click="GoToStepD" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" FontSize="12" Padding="8,4" TabIndex="84"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI"><Run Text="Rate Code: "/><Run Text="{Binding RateCodeValue, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#17365D" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,2,0,0"><Run Text="Payment: "/><Run Text="{Binding PaymentDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="#17365D" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,2,0,0"><Run Text="Nguồn: "/><Run Text="{Binding StepGSourceDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="#17365D" FontWeight="SemiBold"/></TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI"><Run Text="Lễ tân: Admin"/></TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 4. TÀI CHÍNH -->
                    <Border Background="#FAFBFD" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Tài chính" FontSize="14" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI"/>
                                <Button Grid.Column="1" Content="Chỉnh sửa" Click="GoToStepE" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" FontSize="12" Padding="8,4" TabIndex="85"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI"><Run Text="Nguồn giá: "/><Run Text="{Binding PriceSourceLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="#17365D" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,2,0,0"><Run Text="Room Rate: "/><Run Text="{Binding RoomRateDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="#2563EB" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,2,0,0"><Run Text="Room Charge: "/><Run Text="{Binding RoomChargeDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="#17365D" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="12" Foreground="#6F8198" FontFamily="Segoe UI" Margin="0,2,0,0"><Run Text="Deposit: "/><Run Text="{Binding DepositDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/><Run Text=" · VAT: "/><Run Text="{Binding VatLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI"><Run Text="Discount: "/><Run Text="{Binding DiscountDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="#16A34A" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,2,0,0"><Run Text="Payment: "/><Run Text="{Binding PaymentDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="#17365D" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,2,0,0"><Run Text="Currency: "/><Run Text="{Binding CurrencyValue, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#17365D" FontWeight="SemiBold"/></TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 5. GHI CHÚ -->
                    <Border Background="#FAFBFD" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Ghi chú" FontSize="14" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI"/>
                                <Button Grid.Column="1" Content="Chỉnh sửa" Click="GoToStepF" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" FontSize="12" Padding="8,4" TabIndex="86"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="12" Foreground="#6F8198" FontFamily="Segoe UI" Text="{Binding BookingNotesPreview, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                    <TextBlock FontSize="12" Foreground="#6F8198" FontFamily="Segoe UI" Margin="0,2,0,0" Text="{Binding SpecialRequestsPreview, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontSize="12" Foreground="#6F8198" FontFamily="Segoe UI"><Run Text="Đón: "/><Run Text="{Binding PickupDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="#17365D"/><Run Text=" · Tiễn: "/><Run Text="{Binding DropoffDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="#17365D"/></TextBlock>
                                    <TextBlock FontSize="12" Foreground="#6F8198" FontFamily="Segoe UI" Margin="0,2,0,0" Text="{Binding FlightArrivalDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                    <TextBlock FontSize="12" Foreground="#6F8198" FontFamily="Segoe UI" Margin="0,2,0,0" Text="{Binding FlightDepartureDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- LAST: BALANCE BAR -->
                    <Border Background="#EFF6FF" CornerRadius="10" Padding="16,14" BorderBrush="#93C5FD" BorderThickness="1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Còn phải thu" FontSize="13" Foreground="#1E40AF" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding BalanceDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#2F6BFF" FontFamily="Segoe UI"/>
                        </Grid>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: STEP STATUS + VALIDATION -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="22,24">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Kiểm tra trước khi tạo" FontSize="16" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,18"/>

                    <!-- Step Status List -->
                    <ItemsControl ItemsSource="{Binding StepGStatuses, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,0,0,4" Background="#FAFBFD" CornerRadius="6">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" Foreground="{Binding IconColor}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Width="20"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" Foreground="{Binding FgColor}" FontFamily="Segoe UI" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11" Foreground="{Binding IconColor}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Validation Issues -->
                    <Border Background="#FEF2F2" CornerRadius="8" Padding="12,10" BorderBrush="#FECACA" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanCreateReservation, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Cần bổ sung" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding StepGIssues, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12" Foreground="#B91C1C" FontFamily="Segoe UI" Margin="0,0,0,4" Text="{Binding Label}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- All Good -->
                    <Border Padding="14,10" CornerRadius="8" BorderThickness="1" Background="#F0FDF4" BorderBrush="#86EFAC"
                            Visibility="{Binding CanCreateReservation, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="✓ Sẵn sàng tạo đặt phòng" FontSize="13" FontFamily="Segoe UI" TextAlignment="Center" Foreground="#166534" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        </Grid></ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="3" Padding="20,14" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="#DC2626" TextWrapping="Wrap" Visibility="{Binding Modal.Workspace.HasError, Converter={StaticResource BoolVis}}"><Run Text="{Binding Modal.Workspace.ErrorMessage}"/></TextBlock>
                    <TextBlock Text="{Binding CurrentStepLabel, StringFormat=Bước {0}/G}" FontSize="13" Foreground="#64748B"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Hủy" Command="{Binding Modal.CloseCommand}" Style="{StaticResource ModernFooterBtn}" Background="#F3F6FA" Foreground="#52657D"/>
                    <Button Content="← Quay lại" Command="{Binding GoBackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ModernFooterBtn}" Background="#F3F6FA" Foreground="#52657D" Margin="10,0,0,0" Visibility="{Binding CanGoBack, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}"/>
                    <Button Content="Tiếp theo →" Command="{Binding GoNextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ModernFooterBtn}" Background="#2F6BFF" Foreground="White" FontWeight="SemiBold" Margin="10,0,0,0" Visibility="{Binding CanGoNext, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}"/>
                    <Button Content="{Binding FooterActionLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding Modal.SaveNewCommand}" IsEnabled="{Binding CanCreateReservation, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ModernFooterBtn}" Background="#16A34A" Foreground="White" FontWeight="SemiBold" Margin="10,0,0,0" Visibility="{Binding IsLastStep, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
