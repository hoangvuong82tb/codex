                    <StackPanel Grid.Row="1">
                        <!-- Row 1: Chọn khách + Loại giấy tờ (same row) -->
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Chọn khách" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" ItemsSource="{Binding Guests, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedIndex="{Binding SelectedGuestIndex, RelativeSource={RelativeSource AncestorType=UserControl}}" TabIndex="33">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="Khách "/><TextBlock Text="{Binding GuestIndex}"/><TextBlock Text=" - Người lớn"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Loại giấy tờ" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" SelectedValue="{Binding DocumentType, RelativeSource={RelativeSource AncestorType=UserControl}}" TabIndex="34">
                                    <ComboBoxItem Content="CCCD"/><ComboBoxItem Content="Hộ chiếu"/><ComboBoxItem Content="CMND"/><ComboBoxItem Content="GPLX"/><ComboBoxItem Content="Khác"/>
                                </ComboBox>
                            </Grid>
                        </Grid>

                        <Border Height="1" Background="#E2E8F0" Margin="0,2,0,10"/>

                        <!-- Row 2: Action buttons -->
                        <WrapPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <Button Content="Tìm khách cũ" Style="{StaticResource ActionBtn}" TabIndex="35"/>
                            <Button Content="Xóa dữ liệu" Style="{StaticResource ActionBtn}" Margin="8,0,0,0" Foreground="#DC2626" Background="#FEF2F2" BorderBrush="#FECACA"/>
                        </WrapPanel>

                        <Border Height="1" Background="#E2E8F0" Margin="0,2,0,10"/>

                        <!-- Form: 2 columns -->
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Họ và tên" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding SelectedGuest.FullName, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" TabIndex="36"/>
                            </Grid>
                            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Giới tính" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Text="{Binding SelectedGuest.Gender, RelativeSource={RelativeSource AncestorType=UserControl}}" TabIndex="37"><ComboBoxItem Content="Nam"/><ComboBoxItem Content="Nữ"/></ComboBox>
                            </Grid>
                        </Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Ngày sinh" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding SelectedGuest.DateOfBirth, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" TabIndex="38"/>
                            </Grid>
                            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Quốc tịch" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding SelectedGuest.Nationality, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" TabIndex="39"/>
                            </Grid>
                        </Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Số CCCD" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI" Visibility="{Binding IsCCCD, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="Số hộ chiếu" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI" Visibility="{Binding IsPassport, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding SelectedGuest.DocumentNumber, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" TabIndex="40"/>
                            </Grid>
                            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Quê quán" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI" Visibility="{Binding IsCCCD, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="Quốc gia cấp" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI" Visibility="{Binding IsPassport, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding SelectedGuest.BirthPlace, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsCCCD, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding SelectedGuest.Nationality, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsPassport, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}"/>
                            </Grid>
                        </Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Ngày cấp" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding SelectedGuest.IssueDate, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" TabIndex="41"/>
