                        </StackPanel>
                    </Border>

                    <!-- Khách -->
                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Khách" FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI"><Run Text="{Binding Modal.Workspace.Adults}"/><Run Text=" người lớn"/> <Run Text="·" Foreground="#CBD5E1"/> <Run Text="{Binding Modal.Workspace.Children}"/><Run Text=" trẻ em"/></TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Dịch vụ -->
                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Dịch vụ" FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,0,0,6"/>
