                                <TextBlock Grid.Column="6" Text="VAT" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <ToggleButton Grid.Column="8" Style="{StaticResource VatToggleSwitch}" IsChecked="{Binding IsVatIncluded, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" TabIndex="64"/>
                                <TextBlock Grid.Column="10" VerticalAlignment="Center" FontSize="13" Foreground="#17365D" FontFamily="Segoe UI">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Chưa gồm VAT"/>
