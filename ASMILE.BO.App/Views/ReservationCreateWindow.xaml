                            <TextBlock Text="Lưu trú" FontSize="12" Foreground="#7B8DA6" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI"><Run Text="{Binding Modal.Workspace.ArrivalDate, StringFormat=dd/MM/yyyy}"/> <Run Text="14:00" FontWeight="Normal" Foreground="#6F8198"/></TextBlock>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,2,0,0"><Run Text="→ "/><Run Text="{Binding Modal.Workspace.DepartureDate, StringFormat=dd/MM/yyyy}"/> <Run Text="12:00" FontWeight="Normal" Foreground="#6F8198"/></TextBlock>
                            <TextBlock Margin="0,4,0,0" FontSize="13" FontFamily="Segoe UI"><Run Text="{Binding Modal.Workspace.Nights, Mode=OneWay}"/><Run Text=" đêm" Foreground="#6F8198"/></TextBlock>
