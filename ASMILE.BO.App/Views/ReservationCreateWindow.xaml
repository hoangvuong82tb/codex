                                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="13" Foreground="#17365D" FontFamily="Segoe UI" Text="{Binding PriceSourceLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
