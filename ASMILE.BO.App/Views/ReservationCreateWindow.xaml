<UserControl x:Class="ASMILE.BO.App.Views.ReservationCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Wizard"
        
        
        
        
        
        
        Background="#F8FAFC"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Modal.CloseCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- ═══ MODERN CONTROL STYLES ═══ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/><Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/></Trigger>
                    <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F4F6FA"/><Setter Property="Foreground" Value="#5F6F85"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#7B8DA6" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="6" Stretch="Uniform"/>
                    </Grid>
                </Border>
                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="8" Margin="0,2" SnapsToDevicePixels="True"><ScrollViewer MaxHeight="200"><ItemsPresenter/></ScrollViewer></Border>
                </Popup></Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/><Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
                <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#17365D"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="4,2">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style></Setter.Value></Setter>
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
                <Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                        <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" BorderThickness="0" Background="Transparent" Padding="10,0" VerticalContentAlignment="Center" FontSize="14" Foreground="#17365D"/>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="#F2F6FD" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2F6BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsFocused" Value="True"><Setter Property="BorderBrush" Value="#2F6BFF"/><Setter Property="BorderThickness" Value="1.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ModernSelectBtn" TargetType="Button">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#2F6BFF"/><Setter Property="Background" Value="#F2F6FD"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E8F0FF"/><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border Background="Transparent" Padding="4,2">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="CheckBox" Width="18" Height="18" CornerRadius="4" Background="White" BorderBrush="#BFCDE0" BorderThickness="1.5" SnapsToDevicePixels="True">
                            <Path x:Name="CheckMark" Data="M4,9 L7,12 L14,5" Stroke="White" StrokeThickness="2" Fill="Transparent" Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="2" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBox" Property="Background" Value="#2F6BFF"/><Setter TargetName="CheckBox" Property="BorderBrush" Value="#2F6BFF"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBox" Property="BorderBrush" Value="#2F6BFF"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="110"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#2F6BFF"/><Setter Property="Background" Value="#F2F6FD"/>
            <Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E8F0FF"/><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#94A3B8"/><Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/><Setter TargetName="Bd" Property="BorderBrush" Value="#E2E8F0"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ModernFooterBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="22,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- Backward-compatible aliases for steps B-G -->
        <Style x:Key="Fl" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#475569"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
        <Style x:Key="Fi" TargetType="TextBox"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="Fs" TargetType="ComboBox"><Setter Property="Height" Value="36"/><Setter Property="BorderBrush" Value="#CBD5E1"/></Style>
        <Style x:Key="Fd" TargetType="DatePicker"><Setter Property="Height" Value="36"/></Style>
        <Style x:Key="SectionCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
        <Style x:Key="SecTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#102E5A"/><Setter Property="Margin" Value="0,0,0,10"/></Style>

        <!-- Modern ToggleSwitch for VAT -->
        <Style x:Key="VatToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="46" Height="24" CornerRadius="12"
                                Background="#D8E2F0" BorderThickness="0" SnapsToDevicePixels="True">
                            <Border x:Name="Thumb" Width="20" Height="20" CornerRadius="10"
                                    Background="White" HorizontalAlignment="Left" Margin="2,0,0,0"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.18" Color="#000000"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2F6BFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4A8EFF" Offset="0"/><GradientStop Color="#1765F2" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="{Binding WindowTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="20" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="{Binding WindowSubtitle, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="2" Content="✕" Command="{Binding Modal.CloseCommand}" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#64748B" Cursor="Hand" Width="32" Height="32"/>
            </Grid>
        </Border>

        <!-- WIZARD STEP BAR -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
            <ItemsControl ItemsSource="{Binding Steps, RelativeSource={RelativeSource AncestorType=UserControl}}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="148" Height="64" CornerRadius="10" Margin="0,0,4,0"
                                Background="{Binding Bg}" BorderBrush="{Binding Brd}" BorderThickness="1.5"
                                Cursor="Hand" ToolTip="{Binding Label}" Padding="12,8"
                                MouseLeftButtonDown="Step_Click" Tag="{Binding Index}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{Binding BadgeBg}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Letter}" FontSize="15" FontWeight="Bold" Foreground="{Binding BadgeFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Fg}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{Binding Fg}" Opacity="0.7"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" Visibility="{Binding IconVis}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="▸" FontSize="16" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Visibility="{Binding ShowArrow}"/>
                    </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- BODY: STEP CONTENT -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="#F8FAFC">
        <Grid Margin="24,20,24,16">

        <!-- ═══ STEP A: THÔNG TIN LƯU TRÚ ═══ -->
        <Grid Visibility="{Binding IsStepA, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5*" MinWidth="420"/><ColumnDefinition Width="16"/><ColumnDefinition Width="3*" MinWidth="260"/></Grid.ColumnDefinitions>

            <!-- LEFT: DATA ENTRY -->
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="26,22">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Thông tin lưu trú" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,14"/>

                    <StackPanel Grid.Row="1">
                        <!-- ROW 1: Confirm | Phòng -->
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Confirm" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Text="Tự sinh" IsTabStop="False"/>
                            </Grid>
                            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Số phòng" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Text="Chưa phân phòng"/>
                                <Button Grid.Column="3" Content="…" Style="{StaticResource ModernSelectBtn}" TabIndex="3"/>
                            </Grid>
                        </Grid>

                        <!-- ROW 2: HP dự kiến | HP thực tế -->
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                <TextBlock Text="HP dự kiến" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" ItemsSource="{Binding Modal.Workspace.RoomTypes}" SelectedItem="{Binding Modal.Workspace.SelectedRoomType}" DisplayMemberPath="Name" TabIndex="4"/>
                                <Button Grid.Column="3" Content="…" Style="{StaticResource ModernSelectBtn}" TabIndex="5"/>
                            </Grid>
                            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="HP thực tế" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" TabIndex="6"><ComboBoxItem Content="(Giống dự kiến)"/></ComboBox>
                            </Grid>
                        </Grid>

                        <Border Height="1" Background="#E2E8F0" Margin="0,2,0,10"/>

                        <!-- ROW 3: Ngày đến | Ngày đi -->
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Ngày đến" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <DatePicker Grid.Column="1" Style="{StaticResource ModernDatePicker}" SelectedDate="{Binding Modal.Workspace.ArrivalDate}" TabIndex="7"/>
                                <TextBox Grid.Column="3" Style="{StaticResource ModernTextBox}" Text="14:00" TextAlignment="Center" TabIndex="8"/>
                            </Grid>
                            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Ngày đi" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <DatePicker Grid.Column="1" Style="{StaticResource ModernDatePicker}" SelectedDate="{Binding Modal.Workspace.DepartureDate}" TabIndex="9"/>
                                <TextBox Grid.Column="3" Style="{StaticResource ModernTextBox}" Text="12:00" TextAlignment="Center" TabIndex="10"/>
                            </Grid>
                        </Grid>

                        <!-- ROW 4: Số đêm | Book Status -->
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Số đêm" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Column="1" Text="{Binding Modal.Workspace.Nights, Mode=OneWay}" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#2F6BFF" FontFamily="Segoe UI"/>
                            </Grid>
                            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Book Status" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" TabIndex="11"><ComboBoxItem Content="Reserved"/><ComboBoxItem Content="Confirmed"/><ComboBoxItem Content="Tentative"/></ComboBox>
                            </Grid>
                        </Grid>

                        <Border Height="1" Background="#E2E8F0" Margin="0,2,0,10"/>

                        <!-- ROW 5: Số khách -->
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Số khách" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="Người lớn" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/><TextBox Text="{Binding Modal.Workspace.Adults, UpdateSourceTrigger=PropertyChanged}" Width="65" Style="{StaticResource ModernTextBox}" TextAlignment="Center" TabIndex="12"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="Trẻ em" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/><TextBox Text="{Binding Modal.Workspace.Children, UpdateSourceTrigger=PropertyChanged}" Width="65" Style="{StaticResource ModernTextBox}" TextAlignment="Center" TabIndex="13"/></StackPanel>
                            <StackPanel Grid.Column="5"><TextBlock Text="Sơ sinh" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/><TextBox Text="0" Width="65" Style="{StaticResource ModernTextBox}" TextAlignment="Center" TabIndex="14"/></StackPanel>
                            <StackPanel Grid.Column="7"><TextBlock Text="Giường thêm" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/><TextBox Text="0" Width="72" Style="{StaticResource ModernTextBox}" TextAlignment="Center" TabIndex="15"/></StackPanel>
                        </Grid>

                        <Border Height="1" Background="#E2E8F0" Margin="0,2,0,10"/>

                        <!-- ROW 6: Dịch vụ -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/><ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Meal Code" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" TabIndex="16"><ComboBoxItem Content="RO"/><ComboBoxItem Content="BB"/><ComboBoxItem Content="HB"/><ComboBoxItem Content="FB"/></ComboBox>
                            <CheckBox Grid.Column="3" Content="BF" Style="{StaticResource ModernCheckBox}" TabIndex="17"/>
                            <CheckBox Grid.Column="5" Content="Connecting Room" Style="{StaticResource ModernCheckBox}" TabIndex="18"/>
                            <CheckBox Grid.Column="7" Content="Complimentary" Style="{StaticResource ModernCheckBox}" TabIndex="19"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: PREVIEW -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20,18">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Chi tiết đặt phòng" FontSize="16" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,14"/>

                    <!-- Lưu trú -->
                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
