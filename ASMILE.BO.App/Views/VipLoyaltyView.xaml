<UserControl x:Class="ASMILE.BO.App.Views.VipLoyaltyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" Loaded="OnLoaded">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
        <converters:LevelToColorConverter x:Key="LevelToColor"/>
        <converters:EarnRedeemColorConverter x:Key="EarnRedeemColor"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="VIP &amp; Loyalty" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding TotalGold, StringFormat='Gold: {}{0}'}" Margin="0,0,12,0" Foreground="#F2994A" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalPlatinum, StringFormat='Platinum: {}{0}'}" Margin="0,0,12,0" Foreground="#7C3AED" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalDiamond, StringFormat='Diamond: {}{0}'}" Foreground="#2563EB" FontWeight="SemiBold"/></StackPanel></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F0F4F8" Padding="12,8">
            <WrapPanel><TextBox Text="{Binding NewGuestName, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,4,4"/><ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding NewLevel}" Width="100" Margin="0,0,4,4"/><Button Content="Dang ky VIP" Command="{Binding EnrollMemberCommand}" Style="{StaticResource FluentPrimaryButton}" Padding="8,4" FontSize="11"/></WrapPanel>
        </Border>
        <ScrollViewer Grid.Row="2" Grid.Column="0" Margin="12,8">
            <ItemsControl ItemsSource="{Binding Members}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:VipProfileDto}">
                <Border Padding="12,10" Margin="0,0,0,4" CornerRadius="8" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="OnClick" Tag="{Binding}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding VipNumber}" FontWeight="SemiBold" Margin="0,0,8,0"/><Border CornerRadius="3" Padding="4,1" Background="{Binding Level, Converter={StaticResource LevelToColor}}"><TextBlock Text="{Binding Level}" FontSize="11" Foreground="White" FontWeight="Bold"/></Border></StackPanel>
                            <TextBlock Text="{Binding GuestName}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="{Binding PointsBalance, StringFormat='{}{0:N0} pts'}" FontSize="12" Foreground="#2563EB" FontWeight="SemiBold"/><TextBlock Text="{Binding LifetimePoints, StringFormat=' (Doi: {}{0:N0})'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding TotalStayCount, StringFormat='{}{0} stays'}" FontSize="12"/><TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N0} VND'}" FontSize="12" Foreground="#16A34A" FontWeight="SemiBold"/></StackPanel>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="2" Grid.Column="1" Background="White" BorderBrush="#DDE7F3" BorderThickness="1,0,0,0" Padding="16" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="CHI TIET VIP" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding SelectedMember.GuestName}" FontSize="16" FontWeight="SemiBold"/>
                <Border CornerRadius="3" Padding="6,2" Background="{Binding SelectedMember.Level, Converter={StaticResource LevelToColor}}" HorizontalAlignment="Left" Margin="0,4,0,0"><TextBlock Text="{Binding SelectedMember.Level}" FontSize="12" Foreground="White" FontWeight="Bold"/></Border>
                <TextBlock Text="{Binding SelectedMember.PointsBalance, StringFormat='Diem: {}{0:N0}'}" FontSize="14" FontWeight="Bold" Foreground="#2563EB" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding SelectedMember.TotalStayCount, StringFormat='So lan o: {}{0}'}"/>
                <TextBlock Text="{Binding SelectedMember.TotalRevenue, StringFormat='Tong doanh thu: {}{0:N0} VND'}" Foreground="#16A34A"/>
                <Separator Margin="0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBox Text="{Binding EarnPoints, UpdateSourceTrigger=PropertyChanged}" Width="60"/><TextBox Text="{Binding EarnDescription, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="4,0,0,0"/><Button Content="+ Tich" Command="{Binding EarnCommand}" Style="{StaticResource FluentPrimaryButton}" Padding="6,4" FontSize="11" Margin="4,0,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBox Text="{Binding RedeemPoints, UpdateSourceTrigger=PropertyChanged}" Width="60"/><TextBox Text="{Binding RedeemDescription, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="4,0,0,0"/><Button Content="- Doi" Command="{Binding RedeemCommand}" Style="{StaticResource FluentSecondaryButton}" Padding="6,4" FontSize="11" Margin="4,0,0,0"/></StackPanel>
                <Separator Margin="0,8"/>
                <TextBlock Text="GIAO DICH" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding SelectedMember.Transactions}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:LoyaltyTransactionDto}">
                    <Border Padding="4,2"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PointsDisplay}" FontWeight="SemiBold" Foreground="{Binding Type, Converter={StaticResource EarnRedeemColor}}" Width="60"/><TextBlock Text="{Binding Description}" FontSize="11"/></StackPanel></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </Border>
        <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"><TextBlock Text="Dang tai..." Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
</UserControl>
