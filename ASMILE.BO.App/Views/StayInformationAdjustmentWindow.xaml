<Window x:Class="ASMILE.BO.App.Views.StayInformationAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Điều chỉnh thông tin lưu trú" Width="1140" Height="780" MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ModTextBox" TargetType="TextBox"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModCombo" TargetType="ComboBox"><Setter Property="Height" Value="38"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/><Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#7B8DA6" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="6" Stretch="Uniform"/></Grid></Border><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="9" Margin="0,2"><ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="TabBtn" TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="MinWidth" Value="80"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="10,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="BlueBtn" TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="GrayBtn" TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="20,16" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="11"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B158FF" Offset="0"/><GradientStop Color="#7D2BE1" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Điều chỉnh thông tin lưu trú" FontSize="18" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Điều chỉnh thông tin khách, lưu trú và hạng giá." FontSize="12" Foreground="#64748B"/></StackPanel>
                <Button Grid.Column="2" Content="Đóng" Click="OnClose" Style="{StaticResource GrayBtn}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="16,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <!-- Guest selector -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" Margin="0,0,0,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Khách:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,12,0"/>
                    <StackPanel Orientation="Horizontal"><TextBox Text="Nguyễn Văn An" Width="180" Style="{StaticResource ModTextBox}"/><TextBlock Text="Phòng 201 · Deluxe" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Margin="12,0,0,0"/></StackPanel>
                </Grid>
            </Border>
            <!-- Tabs -->
            <Border Padding="10,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal">
                <Button Content="Khách lưu trú" Click="OnTabClick" Tag="0" Style="{StaticResource TabBtn}"/>
                <Button Content="Thời gian" Click="OnTabClick" Tag="1" Style="{StaticResource TabBtn}"/>
                <Button Content="Phòng &amp; giá" Click="OnTabClick" Tag="2" Style="{StaticResource TabBtn}"/>
                <Button Content="Yêu cầu ĐB" Click="OnTabClick" Tag="3" Style="{StaticResource TabBtn}"/>
                <Button Content="Ghi chú &amp; LS" Click="OnTabClick" Tag="4" Style="{StaticResource TabBtn}"/>
            </StackPanel></Border>
            <!-- Tab content -->
            <Border Background="White" CornerRadius="0,0,12,12" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TabContent" Margin="0,4">
                        <!-- Tab 0: Guests -->
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Khách chính" FontSize="11" Foreground="#94A3B8"/><TextBox Text="Nguyễn Văn An" Style="{StaticResource ModTextBox}" Margin="0,2,0,10"/>
                                <TextBlock Text="Điện thoại" FontSize="11" Foreground="#94A3B8"/><TextBox Text="0912-345-678" Style="{StaticResource ModTextBox}" Margin="0,2,0,10"/>
                                <TextBlock Text="Quốc tịch" FontSize="11" Foreground="#94A3B8"/><TextBox Text="Việt Nam" Style="{StaticResource ModTextBox}" Margin="0,2,0,10"/>
                                <TextBlock Text="VIP Level" FontSize="11" Foreground="#94A3B8"/><ComboBox Style="{StaticResource ModCombo}"><ComboBoxItem Content="Standard"/><ComboBoxItem Content="Gold" IsSelected="True"/><ComboBoxItem Content="Platinum"/></ComboBox>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Khách đi cùng" FontSize="11" Foreground="#94A3B8"/><TextBox Text="Lê Thị Hoa" Style="{StaticResource ModTextBox}" Margin="0,2,0,10"/>
                                <TextBlock Text="Email" FontSize="11" Foreground="#94A3B8"/><TextBox Text="an.nguyen@email.com" Style="{StaticResource ModTextBox}" Margin="0,2,0,10"/>
                                <TextBlock Text="Số giấy tờ" FontSize="11" Foreground="#94A3B8"/><TextBox Text="CCCD 079202012345" Style="{StaticResource ModTextBox}" Margin="0,2,0,10"/>
                                <TextBlock Text="Membership" FontSize="11" Foreground="#94A3B8"/><TextBox Text="M-0042" Style="{StaticResource ModTextBox}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" Padding="14,12" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="Hủy" Click="OnClose" Style="{StaticResource GrayBtn}" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Lưu nháp" Style="{StaticResource GrayBtn}" Margin="0,0,8,0"/>
                    <Button Content="Xác nhận điều chỉnh" Click="OnConfirm" Style="{StaticResource BlueBtn}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
