<UserControl x:Class="ASMILE.BO.App.Views.BreakfastCafeClosedOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="#F5F8FC">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>
    <converters:InverseBooleanConverter x:Key="InvBool"/>
    <converters:StatusDisplayConverter x:Key="StatusConv"/>

    <!-- Accounting-standard card shadow -->
    <DropShadowEffect x:Key="CardShadow" ShadowDepth="1" BlurRadius="14" Opacity="0.06" Color="#667A98"/>

    <Style x:Key="Win11Btn" TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="BorderBrush" Value="#DDE7F3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFF7ED"/>
                <Setter Property="BorderBrush" Value="#94A3B8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Win11IconBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F1F5F9"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- FILTER BAR -->
    <!-- ================================================================== -->
    <Border Grid.Row="0" Padding="20,10,20,10" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border CornerRadius="10" Background="White" BorderBrush="#D5E1EF" BorderThickness="1" Height="38" Padding="10,0" Margin="0,0,8,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Style="{StaticResource AccountingFilterTextBox}" BorderThickness="0" Background="Transparent"
                     Text="{Binding ClosedOrderSearchText, UpdateSourceTrigger=PropertyChanged}"/>
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" Margin="0,0,8,0">
          <TextBlock Text="Từ ngày" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
          <DatePicker Width="130" Height="38" SelectedDate="{Binding ClosedOrderFromDate, Mode=TwoWay}"
                      Style="{StaticResource EnterpriseModuleDatePicker}" Language="vi-VN"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,8,0">
          <TextBlock Text="Đến ngày" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
          <DatePicker Width="130" Height="38" SelectedDate="{Binding ClosedOrderToDate, Mode=TwoWay}"
                      Style="{StaticResource EnterpriseModuleDatePicker}" Language="vi-VN"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Margin="0,0,8,0">
          <TextBlock Text="Trạng thái" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
          <ComboBox Style="{StaticResource AccountingFilterComboBox}" Width="130"
                    ItemsSource="{Binding ClosedOrderStatusFilters}" DisplayMemberPath="Label" SelectedValuePath="Value"
                    SelectedValue="{Binding ClosedOrderStatusFilter, Mode=TwoWay}"/>
        </StackPanel>
        <StackPanel Grid.Column="4" Margin="0,0,8,0">
          <TextBlock Text="Sắp xếp" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
          <ComboBox Style="{StaticResource AccountingFilterComboBox}" Width="130"
                    ItemsSource="{Binding ClosedOrderSortOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                    SelectedValue="{Binding ClosedOrderSortOption, Mode=TwoWay}"/>
        </StackPanel>
      </Grid>
    </Border>
<!-- 3-COLUMN BODY -->
    <!-- ================================================================== -->
    <Grid Grid.Row="1" Margin="24,12,12,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="440"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="360"/>
      </Grid.ColumnDefinitions>

      <!-- ================================================================ -->
      <!-- COL 1: ORDER LIST -->
      <!-- ================================================================ -->
      <Border Grid.Column="0" CornerRadius="14" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" Margin="0,0,8,0">
        <Border.Effect><StaticResource ResourceKey="CardShadow"/></Border.Effect>
        <ListBox ItemsSource="{Binding ClosedOrders}" SelectedItem="{Binding SelectedClosedOrder, Mode=TwoWay}"
                 BorderThickness="0" Background="Transparent">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="MinHeight" Value="82"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Padding="16,14" BorderBrush="#E1EAF6" BorderThickness="0,0,0,1"
                            Cursor="Hand" Background="Transparent" CornerRadius="0">
                      <Grid >
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="14" VerticalAlignment="Center">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="#DCFCE7"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="✓" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#16A34A"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Text" Value="✕"/><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                          <TextBlock FontWeight="SemiBold" FontSize="16" Foreground="#0F172A" TextWrapping="NoWrap">
                            <Run Text="{Binding TableName, TargetNullValue='Mang đi'}"/><Run Text=" · "/><Run Text="{Binding OrderNumber}"/>
                          </TextBlock>
                          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="#DCFCE7"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock FontSize="13" FontWeight="SemiBold">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Đã thanh toán"/><Setter Property="Foreground" Value="#16A34A"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Text" Value="Đã hủy"/><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding OrderDate, StringFormat=HH:mm dd/MM}" FontSize="13" Foreground="#94A3B8"/>
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat={}{0:N0} đ}" FontSize="18" FontWeight="Bold" Foreground="#EA580C" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Root" Property="Background" Value="#FFF3E6"/>
                        <Setter TargetName="Root" Property="BorderBrush" Value="#3B82F6"/>
                        <Setter TargetName="Root" Property="BorderThickness" Value="4,0,0,0"/>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Root" Property="Background" Value="#FFF7ED"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </Border>

      <!-- ================================================================ -->
      <!-- COL 2: ORDER DETAIL -->
      <!-- ================================================================ -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0">
        <StackPanel>
          <!-- Empty: no orders -->
          <Border CornerRadius="14" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" Padding="40"
                  Visibility="{Binding HasClosedOrders, Converter={StaticResource InvBool}}">
            <Border.Effect><StaticResource ResourceKey="CardShadow"/></Border.Effect>
            <StackPanel HorizontalAlignment="Center" Margin="0,80,0,0">
              <TextBlock Text="&#xE974;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
              <TextBlock Text="Chưa có đơn đóng nào" FontSize="16" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>

          <!-- Detail content -->
          <StackPanel Visibility="{Binding HasSelectedClosedOrder, Converter={StaticResource B2V}}">
            <!-- Order Header -->
            <Border CornerRadius="14" Padding="20,16" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" Margin="0,0,0,12">
              <Border.Effect><StaticResource ResourceKey="CardShadow"/></Border.Effect>
              <Grid >
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="Bold" FontSize="22" Foreground="#0F172A">
                      <Run Text="{Binding SelectedClosedOrder.TableName, TargetNullValue='Mang đi'}"/><Run Text=" · "/><Run Text="{Binding SelectedClosedOrder.OrderNumber}"/>
                    </TextBlock>
                    <Border CornerRadius="6" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#DCFCE7"/>
                          <Style.Triggers><DataTrigger Binding="{Binding SelectedClosedOrder.Status}" Value="Cancelled"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger></Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock FontSize="14" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Đã thanh toán"/><Setter Property="Foreground" Value="#16A34A"/>
                            <Style.Triggers><DataTrigger Binding="{Binding SelectedClosedOrder.Status}" Value="Cancelled"><Setter Property="Text" Value="Đã hủy"/><Setter Property="Foreground" Value="#DC2626"/></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource AccountingCmdSecondary}" Height="36" Padding="14,0" Margin="0,0,8,0"
                            Command="{Binding DataContext.PrintClosedOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding SelectedClosedOrder}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="In"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Text="{Binding SelectedClosedOrder.OrderDate, StringFormat=HH:mm dd/MM/yyyy}" FontSize="14" Foreground="#94A3B8"/>
              </Grid>
            </Border>

            <!-- Order Info Card -->
            <Border CornerRadius="14" Padding="20,16" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" Margin="0,0,0,12">
              <Border.Effect><StaticResource ResourceKey="CardShadow"/></Border.Effect>
              <StackPanel>
                <TextBlock Text="THÔNG TIN ĐƠN HÀNG" FontSize="12" FontWeight="SemiBold" Foreground="#0F2A55" Margin="0,0,0,12"/>
                <Grid >
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock FontSize="14" Margin="0,4"><Run Text="Bàn: " Foreground="#64748B"/><Run Text="{Binding SelectedClosedOrder.TableName, TargetNullValue='Mang đi'}" Foreground="#0F172A"/></TextBlock>
                    <TextBlock FontSize="14" Margin="0,4"><Run Text="Giờ đóng: " Foreground="#64748B"/><Run Text="{Binding SelectedClosedOrder.OrderDate, StringFormat=HH:mm dd/MM}" Foreground="#0F172A"/></TextBlock>
                    <TextBlock FontSize="14" Margin="0,4"><Run Text="Loại: " Foreground="#64748B"/><Run Text="{Binding ClosedOrderTypeText, Mode=OneWay}" Foreground="#0F172A"/></TextBlock>
                    <TextBlock FontSize="14" Margin="0,4"><Run Text="Ghi chú: " Foreground="#64748B"/><Run Text="{Binding SelectedClosedOrder.Note, TargetNullValue='—'}" Foreground="#0F172A"/></TextBlock>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock FontSize="14" Margin="0,4"><Run Text="Trạng thái: " Foreground="#64748B"/><Run Text="{Binding SelectedClosedOrder.Status, Converter={StaticResource StatusConv}}" Foreground="#0F172A"/></TextBlock>
                    <TextBlock FontSize="14" Margin="0,4"><Run Text="Phương thức: " Foreground="#64748B"/><Run Text="{Binding ClosedOrderPaymentMethod, Mode=OneWay, TargetNullValue='—'}" Foreground="#0F172A"/></TextBlock>
                    <TextBlock FontSize="14" Margin="0,4"><Run Text="Phòng: " Foreground="#64748B"/><Run Text="{Binding SelectedClosedOrder.RoomReference, TargetNullValue='—'}" Foreground="#0F172A"/></TextBlock>
                    <TextBlock FontSize="14" Margin="0,4"><Run Text="Mã đơn: " Foreground="#64748B"/><Run Text="{Binding SelectedClosedOrder.OrderNumber}" Foreground="#0F172A"/></TextBlock>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Items Card -->
            <Border CornerRadius="14" Padding="20,16" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" Margin="0,0,0,12">
              <Border.Effect><StaticResource ResourceKey="CardShadow"/></Border.Effect>
              <StackPanel>
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F2A55" Margin="0,0,0,12">
                  <Run Text="DANH SÁCH MÓN ("/><Run Text="{Binding ClosedOrderDetailLines.Count, Mode=OneWay}"/><Run Text=" món)"/>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding ClosedOrderDetailLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="10,10" BorderBrush="#E1EAF6" BorderThickness="0,0,0,1" MinHeight="44">
                        <Grid >
                          <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding LineNo, Mode=OneWay}" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MenuItemName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="13" Foreground="#94A3B8"><Run Text="{Binding Quantity, Mode=OneWay, StringFormat={}{0:N2}}"/><Run Text=" × "/><Run Text="{Binding UnitPrice, Mode=OneWay, StringFormat={}{0:N0} đ}"/></TextBlock>
                          </StackPanel>
                          <TextBlock Grid.Column="3" Text="{Binding LineTotalAmount, Mode=OneWay, StringFormat={}{0:N0} đ}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Totals Card -->
            <Border CornerRadius="14" Padding="20,16" Background="#F8FAFC" BorderBrush="#DDE7F3" BorderThickness="1">
              <Border.Effect><StaticResource ResourceKey="CardShadow"/></Border.Effect>
              <StackPanel>
                <TextBlock Text="TỔNG THANH TOÁN" FontSize="12" FontWeight="SemiBold" Foreground="#0F2A55" Margin="0,0,0,14"/>
                <Grid >
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Text="Tạm tính" FontSize="14" Foreground="#64748B"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedClosedOrder.SubtotalAmount, StringFormat={}{0:N0} đ}" FontSize="14" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Row="1" Text="Giảm giá" FontSize="14" Foreground="#DC2626" Margin="0,4,0,0"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedClosedOrder.DiscountAmount, StringFormat=-{0:N0} đ}" FontSize="14" Foreground="#DC2626" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                  <TextBlock Grid.Row="2" Text="Phí DV" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedClosedOrder.ServiceChargeAmount, StringFormat={}{0:N0} đ}" FontSize="14" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                  <TextBlock Grid.Row="3" Text="VAT" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedClosedOrder.VatAmount, StringFormat={}{0:N0} đ}" FontSize="14" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                  <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,14,0,0">
                    <Grid ><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="TỔNG CỘNG" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                      <TextBlock Grid.Column="1" Text="{Binding SelectedClosedOrder.TotalAmount, StringFormat={}{0:N0} đ}" FontSize="32" FontWeight="Bold" Foreground="#EA580C" HorizontalAlignment="Right"/>
                    </Grid>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- ================================================================ -->
      <!-- COL 3: TIMELINE + ACTIONS -->
      <!-- ================================================================ -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
        <StackPanel Visibility="{Binding HasSelectedClosedOrder, Converter={StaticResource B2V}}">
          <!-- Timeline -->
          <Border CornerRadius="14" Padding="20,16" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" Margin="0,0,0,12">
            <Border.Effect><StaticResource ResourceKey="CardShadow"/></Border.Effect>
            <StackPanel>
              <TextBlock Text="LỊCH SỬ XỬ LÝ" FontSize="12" FontWeight="SemiBold" Foreground="#0F2A55" Margin="0,0,0,14"/>
              <ItemsControl ItemsSource="{Binding ClosedOrderTimeline}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,14" MinHeight="40">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Width="10" Height="10" CornerRadius="5" Background="#3B82F6" VerticalAlignment="Top" Margin="0,5,10,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Action}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0">
                          <Run Text="{Binding Time, StringFormat=HH:mm}"/><Run Text=" · "/><Run Text="{Binding Actor}"/>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Quick Actions -->
          <Border CornerRadius="14" Padding="20,16" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" Margin="0,0,0,12">
            <Border.Effect><StaticResource ResourceKey="CardShadow"/></Border.Effect>
            <StackPanel>
              <TextBlock Text="THAO TÁC NHANH" FontSize="12" FontWeight="SemiBold" Foreground="#0F2A55" Margin="0,0,0,12"/>
              <Grid >
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource AccountingCmdSecondary}" Height="52" Margin="0,0,4,4"
                        Command="{Binding DataContext.PrintClosedOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SelectedClosedOrder}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    <TextBlock Text="In hóa đơn" FontSize="13" Margin="0,2,0,0"/>
                  </StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource AccountingCmdSecondary}" Height="52" Margin="4,0,0,4" IsEnabled="False">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE792;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    <TextBlock Text="Xuất PDF" FontSize="13" Margin="0,2,0,0"/>
                  </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource AccountingCmdSecondary}" Height="52" Margin="0,0,4,0"
                        Command="{Binding DataContext.CreateSimilarOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SelectedClosedOrder}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    <TextBlock Text="Tạo đơn tương tự" FontSize="13" Margin="0,2,0,0"/>
                  </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource AccountingCmdSecondary}" Height="52" Margin="4,0,0,0"
                        Command="{Binding DataContext.ExportClosedOrdersExcelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7A1;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    <TextBlock Text="Xuất Excel" FontSize="13" Margin="0,2,0,0"/>
                  </StackPanel>
                </Button>
                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource AccountingCmdSecondary}" Height="44" Margin="4,4,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding DataContext.RefundClosedOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SelectedClosedOrder}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"/>
                    <TextBlock Text="Hoàn tiền đơn này" FontSize="13"/>
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Info KPIs -->
          <Border CornerRadius="14" Padding="20,16" Background="White" BorderBrush="#DDE7F3" BorderThickness="1">
            <Border.Effect><StaticResource ResourceKey="CardShadow"/></Border.Effect>
            <StackPanel>
              <TextBlock Text="THÔNG TIN HỮU ÍCH" FontSize="12" FontWeight="SemiBold" Foreground="#0F2A55" Margin="0,0,0,14"/>
              <Grid >
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" CornerRadius="8" Background="#FFF7ED" Padding="12,10" Margin="0,0,4,6">
                  <StackPanel>
                    <TextBlock Text="{Binding ClosedOrderDetailLines.Count, Mode=OneWay, StringFormat={}{0}}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Món" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" CornerRadius="8" Background="#FFF7ED" Padding="12,10" Margin="4,0,0,6">
                  <StackPanel>
                    <TextBlock Text="{Binding AverageServiceMinutes, Mode=OneWay, StringFormat={}{0} ph}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Thời gian TB" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" CornerRadius="8" Background="#FFF7ED" Padding="12,10" Margin="0,0,4,0">
                  <StackPanel>
                    <TextBlock Text="{Binding SelectedClosedOrder.DiscountAmount, StringFormat={}{0:N0} đ}" FontSize="16" FontWeight="Bold" Foreground="#DC2626"/>
                    <TextBlock Text="Giảm giá" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" CornerRadius="8" Background="#FFF7ED" Padding="12,10" Margin="4,0,0,0">
                  <StackPanel>
                    <TextBlock Text="{Binding SelectedClosedOrder.VatAmount, StringFormat={}{0:N0} đ}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="VAT" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
