<UserControl x:Class="ASMILE.BO.App.Views.HotelHousekeepingSupplyCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="ButtonBase" TargetType="Button" BasedOn="{StaticResource HotelSettingsButtonBase}">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/></Style>
        <Style x:Key="Input" TargetType="TextBox" BasedOn="{StaticResource HotelSettingsTextBoxBase}"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,0"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style>
    </UserControl.Resources>
    <Grid Background="Transparent" Margin="0,0,0,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Định mức đồ vải &amp; tiện nghi" FontSize="22" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Quản lý master độc lập theo cơ sở; không trộn với tồn kho và tác vụ housekeeping." Foreground="#64748B" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Làm mới" Command="{Binding LoadCommand}" Style="{StaticResource ButtonBase}"/><Button Content="+ Đồ vải" Command="{Binding NewLinenCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="+ Tiện nghi" Command="{Binding NewAmenityCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Từ khóa" Grid.Column="0" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="Tìm theo mã, tên hoặc nhóm"/><Button Grid.Row="1" Grid.Column="1" Content="Tìm" Command="{Binding LoadCommand}" Style="{StaticResource ButtonBase}" Margin="8,0,0,0"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DataMessage}" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
            <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="False"><TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="Đồ vải"><DataGrid Background="Transparent" ItemsSource="{Binding LinenTypes}" SelectedItem="{Binding SelectedLinen, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="110"/><DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Nhóm" Binding="{Binding Category}" Width="130"/><DataGridTextColumn Header="PAR" Binding="{Binding DefaultParLevel}" Width="70"/><DataGridTextColumn Header="Vòng giặt" Binding="{Binding MaxWashCycles}" Width="90"/><DataGridCheckBoxColumn Header="Dùng" Binding="{Binding IsActive}" Width="60"/></DataGrid.Columns></DataGrid></TabItem>
                <TabItem Header="Tiện nghi"><DataGrid Background="Transparent" ItemsSource="{Binding AmenityTypes}" SelectedItem="{Binding SelectedAmenity, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="110"/><DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Nhóm" Binding="{Binding Category}" Width="130"/><DataGridTextColumn Header="PAR" Binding="{Binding DefaultParLevel}" Width="70"/><DataGridTextColumn Header="Ngưỡng" Binding="{Binding MinAlertThreshold}" Width="85"/><DataGridCheckBoxColumn Header="Dùng" Binding="{Binding IsActive}" Width="60"/></DataGrid.Columns></DataGrid></TabItem>
            </TabControl></Border>
            <Border Grid.Column="1" Margin="16,0,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16"><StackPanel><StackPanel>
                <TextBlock Text="Chi tiết danh mục" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="{Binding SelectedSummary}" Foreground="#64748B" Margin="0,4,0,14"/>
                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Mã"/><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,3,0,7"/><TextBlock Text="Tên"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,3,0,7"/><TextBlock Text="Nhóm"/><TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,3,0,7"/><TextBlock Text="Định mức chuẩn"/><TextBox Text="{Binding DefaultParLevel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,3,0,7"/><TextBlock Text="{Binding LimitLabel}"/><TextBox Text="{Binding LimitValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,3,0,10"/><StackPanel Orientation="Horizontal"><Button Content="Hủy" Command="{Binding CancelEditCommand}" Style="{StaticResource ButtonBase}"/><Button Content="Lưu" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/></StackPanel></StackPanel>
                <StackPanel Visibility="{Binding IsReadOnlyPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Trạng thái" Foreground="#64748B"/><TextBlock Text="{Binding SelectedStatus}" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock Text="Danh mục được lưu độc lập theo property, có kiểm tra trùng mã và optimistic concurrency." Foreground="#64748B" TextWrapping="Wrap" Margin="0,14,0,16"/><StackPanel Orientation="Horizontal"><Button Content="Sửa" Command="{Binding EditItemCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Bật / tạm ngưng" Command="{Binding ToggleActiveCommand}" Style="{StaticResource ButtonBase}" Margin="0"/></StackPanel></StackPanel>
                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap"/></Border><Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0" Visibility="{Binding HasInfo, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding InfoMessage}" Foreground="#166534" TextWrapping="Wrap"/></Border>
            </StackPanel></StackPanel></Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="Các thao tác tồn kho, cấp bù và giao dịch vẫn nằm ở màn vận hành Housekeeping." Foreground="#64748B" Margin="0,12,0,0"/>
    </Grid>
</UserControl>



