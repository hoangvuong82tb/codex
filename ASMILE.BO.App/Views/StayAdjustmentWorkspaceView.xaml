<UserControl x:Class="ASMILE.BO.App.Views.StayAdjustmentWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="StayAdjustmentActionCardStyle" TargetType="Button">
            <Setter Property="Width" Value="236"/>
            <Setter Property="Height" Value="92"/>
            <Setter Property="Margin" Value="9,10"/>
            <Setter Property="Padding" Value="16,0,14,0"/>
            <Setter Property="Background" Value="#FFFFFFF2"/>
            <Setter Property="BorderBrush" Value="#D5E3F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Direction="0" Opacity="0.08" Color="#1A3A5C"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#AFCBF7"/>
                                <Setter TargetName="Card" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.04,0.04" Center="0.04,0.04" RadiusX="0.32" RadiusY="0.32">
                <GradientStop Color="#106aa7ff" Offset="0"/><GradientStop Color="#00ffffff" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Style="{StaticResource HubContainerStyle}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <Button Content="← Quay lại Lễ tân" Command="{Binding BackCommand}" Style="{StaticResource HubBackButtonStyle}"/>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,32">
                    <TextBlock Text="Điều chỉnh lưu trú" Style="{StaticResource HubHeaderStyle}" FontSize="32"/>
                    <TextBlock Text="Đổi phòng, gia hạn và điều chỉnh thông tin lưu trú." Style="{StaticResource HubSubtitleStyle}" FontSize="16"/>
                </StackPanel>

                <WrapPanel Grid.Row="2" HorizontalAlignment="Center" MaxWidth="1060">
                    <Button x:Name="RoomMoveCardButton" Click="OnRoomMove" Style="{StaticResource StayAdjustmentActionCardStyle}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource HubIconBoxStyle}"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4A8EFF" Offset="0"/><GradientStop Color="#1765F2" Offset="1"/></LinearGradientBrush></Border.Background>
                                <Path Width="28" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M2,7 H18 M14,3 L18,7 L14,11 M22,17 H6 M10,13 L6,17 L10,21"
                                      Fill="Transparent" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Đổi phòng" Style="{StaticResource HubCardTitleStyle}"/>
                        </Grid>
                    </Button>
                    <Border Style="{StaticResource HubCardStyle}" MouseLeftButtonDown="OnExtendStay">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource HubIconBoxStyle}"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#31C9B8" Offset="0"/><GradientStop Color="#00A58F" Offset="1"/></LinearGradientBrush></Border.Background>
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Gia hạn lưu trú" Style="{StaticResource HubCardTitleStyle}"/>
                        </Grid>
                    </Border>
                    <Button x:Name="RoomMoveExtendCardButton" Click="OnMoveAndExtend" Style="{StaticResource StayAdjustmentActionCardStyle}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource HubIconBoxStyle}"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFAD39" Offset="0"/><GradientStop Color="#ED7900" Offset="1"/></LinearGradientBrush></Border.Background>
                                <Grid Width="30" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M2,7 H19 M15,3 L19,7 L15,11 M22,18 H5 M9,14 L5,18 L9,22"
                                          Fill="Transparent" Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                    <Ellipse Width="10" Height="10" Margin="18,0,0,18"
                                             HorizontalAlignment="Left" VerticalAlignment="Top"
                                             Fill="#ED7900" Stroke="White" StrokeThickness="1.5"/>
                                    <Path Data="M23,3.5 V6.5 L25,7.5"
                                          Fill="Transparent" Stroke="White" StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Đổi phòng + Gia hạn" Style="{StaticResource HubCardTitleStyle}"/>
                        </Grid>
                    </Button>
                    <Border Style="{StaticResource HubCardStyle}" MouseLeftButtonDown="OnModifyInfo">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource HubIconBoxStyle}"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B158FF" Offset="0"/><GradientStop Color="#7D2BE1" Offset="1"/></LinearGradientBrush></Border.Background>
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Điều chỉnh thông tin" Style="{StaticResource HubCardTitleStyle}"/>
                        </Grid>
                    </Border>
                </WrapPanel>

                <Border x:Name="RoomMoveOpenError"
                        Grid.Row="3"
                        MaxWidth="760"
                        Margin="0,22,0,0"
                        Padding="14,10"
                        HorizontalAlignment="Center"
                        Background="#FEE2E2"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="Collapsed">
                    <TextBlock x:Name="RoomMoveOpenErrorText"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#B91C1C"/>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
