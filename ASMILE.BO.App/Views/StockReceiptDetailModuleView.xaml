<UserControl x:Class="ASMILE.BO.App.Views.StockReceiptDetailModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASMILE.BO.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding SupplierName, StringFormat=Nhà cung cấp: {0}}"
                           FontSize="15" FontWeight="SemiBold" Foreground="#1E3352" />
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,10,0"
                           Text="{Binding ReceiptNo, StringFormat=Số phiếu: {0}}"
                           FontSize="14" Foreground="#334D70" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                           Text="{Binding ReceiptDate, StringFormat=Ngày chứng từ: {0:dd/MM/yyyy}}"
                           FontSize="14" Foreground="#334D70" />
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,10,0"
                           Text="{Binding ReceiverName, StringFormat=Người nhận hàng: {0}}"
                           FontSize="14" Foreground="#334D70" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                           Text="{Binding TotalAmount, StringFormat=Tổng tiền: {0:N0}}"
                           FontSize="14" FontWeight="SemiBold" Foreground="#2F65D9" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,10"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10">
            <DataGrid ItemsSource="{Binding DetailsPager.Items}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      RowHeight="38"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      CellStyle="{StaticResource EnterpriseDashedDataGridCell}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT" Binding="{Binding LineNo}" Width="70" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                    <DataGridTextColumn Header="Mã hàng" Binding="{Binding ItemCode}" Width="120" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                    <DataGridTextColumn Header="Tên hàng hóa" Binding="{Binding ItemName}" Width="*" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                    <DataGridTextColumn Header="ĐV tính" Binding="{Binding Unit}" Width="90" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                    <DataGridTextColumn Header="Kho" Binding="{Binding WarehouseCode}" Width="80" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                    <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, StringFormat={}{0:#,##0.####}}" Width="100" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat=N0}" Width="110" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding Amount, StringFormat=N0}" Width="130" ElementStyle="{StaticResource EnterpriseDetailGridText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="#5A6F8E"
                       FontSize="14"
                       Text="{Binding DetailsPager.PageText}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <controls:TablePagerControl DataContext="{Binding DetailsPager}" Margin="0,0,12,0" />
                <Button Width="132" Height="36" Margin="0,0,10,0" Command="{Binding ShowPreviewCommand}" Content="Xem trước in" />
                <Button Width="92" Height="36" Command="{Binding CloseCommand}" Content="Đóng" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
