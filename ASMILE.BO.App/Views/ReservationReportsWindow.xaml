<Window x:Class="ASMILE.BO.App.Views.ReservationReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Báo cáo đặt phòng"
        Width="1360" Height="840"
        MinWidth="1160" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F7F9FC"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="GrayBtn" TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="10" Background="#F0FDF4"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Báo cáo đặt phòng" FontSize="19" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Tổng hợp và phân tích dữ liệu đặt phòng" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/></StackPanel>
                <Button Grid.Column="2" Content="Làm mới" Click="OnRefreshClick" Style="{StaticResource GrayBtn}"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" Margin="16,14,16,16" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                <Border Width="72" Height="72" CornerRadius="18" Background="#F0FDF4" Margin="0,0,0,20"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#86EFAC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="Chưa triển khai Reservation Reports" FontSize="18" FontWeight="SemiBold" Foreground="#102E5A" TextAlignment="Center"/>
                <TextBlock Text="Báo cáo sẽ cung cấp danh sách đặt phòng, khách đến/đi, theo trạng thái/nguồn/hạng phòng, đã hủy, No Show và xuất Excel/PDF." FontSize="14" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
                <Border Background="#F8FAFC" CornerRadius="10" Padding="16,14" Margin="0,20,0,0" Width="440">
                    <StackPanel>
                        <TextBlock Text="Các mẫu báo cáo dự kiến" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Border Background="White" CornerRadius="6" Padding="8,4" Margin="0,0,6,6" BorderBrush="#E2E8F0" BorderThickness="1"><TextBlock Text="Danh sách ĐP" FontSize="12" Foreground="#64748B"/></Border>
                            <Border Background="White" CornerRadius="6" Padding="8,4" Margin="0,0,6,6" BorderBrush="#E2E8F0" BorderThickness="1"><TextBlock Text="Khách đến" FontSize="12" Foreground="#64748B"/></Border>
                            <Border Background="White" CornerRadius="6" Padding="8,4" Margin="0,0,6,6" BorderBrush="#E2E8F0" BorderThickness="1"><TextBlock Text="Khách đi" FontSize="12" Foreground="#64748B"/></Border>
                            <Border Background="White" CornerRadius="6" Padding="8,4" Margin="0,0,6,6" BorderBrush="#E2E8F0" BorderThickness="1"><TextBlock Text="Theo trạng thái" FontSize="12" Foreground="#64748B"/></Border>
                            <Border Background="White" CornerRadius="6" Padding="8,4" Margin="0,0,6,6" BorderBrush="#E2E8F0" BorderThickness="1"><TextBlock Text="Theo nguồn" FontSize="12" Foreground="#64748B"/></Border>
                            <Border Background="White" CornerRadius="6" Padding="8,4" Margin="0,0,6,6" BorderBrush="#E2E8F0" BorderThickness="1"><TextBlock Text="Theo hạng phòng" FontSize="12" Foreground="#64748B"/></Border>
                            <Border Background="White" CornerRadius="6" Padding="8,4" Margin="0,0,6,6" BorderBrush="#E2E8F0" BorderThickness="1"><TextBlock Text="Chưa phân phòng" FontSize="12" Foreground="#64748B"/></Border>
                            <Border Background="White" CornerRadius="6" Padding="8,4" Margin="0,0,6,6" BorderBrush="#E2E8F0" BorderThickness="1"><TextBlock Text="Đã hủy" FontSize="12" Foreground="#64748B"/></Border>
                            <Border Background="White" CornerRadius="6" Padding="8,4" Margin="0,0,6,6" BorderBrush="#E2E8F0" BorderThickness="1"><TextBlock Text="No Show" FontSize="12" Foreground="#64748B"/></Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Background="#FFF7ED" CornerRadius="10" Padding="16,14" Margin="0,12,0,0" Width="440" BorderBrush="#FED7AA" BorderThickness="1">
                    <StackPanel><TextBlock Text="⚠ Trạng thái" FontSize="13" FontWeight="SemiBold" Foreground="#C2410C" Margin="0,0,0,4"/><TextBlock FontSize="12" Foreground="#9A3412" Text="BLOCKED BY BACKEND — Chưa có Reservation Report service chuyên biệt. ReportEngine hiện có phục vụ kế toán/tài chính, chưa có reservation reporting."/></StackPanel>
                </Border>
                <Button Content="Làm mới" Click="OnRefreshClick" Style="{StaticResource GrayBtn}" Margin="0,20,0,0" Width="120"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
