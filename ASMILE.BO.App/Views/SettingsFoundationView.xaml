<UserControl x:Class="ASMILE.BO.App.Views.SettingsFoundationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" Loaded="OnLoaded">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:TabIndexToVisibilityConverter x:Key="TabToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="20,14">
            <TextBlock Text="Cau Hinh He Thong (Settings Foundation)" FontSize="23" FontWeight="SemiBold"/>
        </Border>
        <Border Grid.Row="1" Background="#F0F4F8" Padding="12,8"><WrapPanel>
            <Button Content="Toa Nha" Command="{Binding SetTabCommand}" CommandParameter="0" Style="{StaticResource FluentSecondaryButton}" Margin="0,0,4,0" Padding="8,4"/>
            <Button Content="Tien Nghi" Command="{Binding SetTabCommand}" CommandParameter="1" Style="{StaticResource FluentSecondaryButton}" Margin="0,0,4,0" Padding="8,4"/>
            <Button Content="Phan Khuc" Command="{Binding SetTabCommand}" CommandParameter="2" Style="{StaticResource FluentSecondaryButton}" Margin="0,0,4,0" Padding="8,4"/>
            <Button Content="Nguon DP" Command="{Binding SetTabCommand}" CommandParameter="3" Style="{StaticResource FluentSecondaryButton}" Margin="0,0,4,0" Padding="8,4"/>
            <Button Content="Quoc Gia" Command="{Binding SetTabCommand}" CommandParameter="4" Style="{StaticResource FluentSecondaryButton}" Padding="8,4"/>
        </WrapPanel></Border>
        <Grid Grid.Row="2" Margin="12,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBox Text="{Binding NewCode, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,4,0"/><TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,4,0"/><Button Content="Them" Command="{Binding AddItemCommand}" Style="{StaticResource FluentPrimaryButton}" Padding="8,4"/></StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Buildings}" Visibility="{Binding ActiveTab, Converter={StaticResource TabToVis}, ConverterParameter=0}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:MasterDataItem}"><Border Padding="8,4" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Width="80"/><TextBlock Text="{Binding Name}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <ListBox Grid.Row="1" ItemsSource="{Binding Amenities}" Visibility="{Binding ActiveTab, Converter={StaticResource TabToVis}, ConverterParameter=1}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:MasterDataItem}"><Border Padding="8,4" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Width="80"/><TextBlock Text="{Binding Name}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <ListBox Grid.Row="1" ItemsSource="{Binding MarketSegments}" Visibility="{Binding ActiveTab, Converter={StaticResource TabToVis}, ConverterParameter=2}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:MasterDataItem}"><Border Padding="8,4" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Width="80"/><TextBlock Text="{Binding Name}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <ListBox Grid.Row="1" ItemsSource="{Binding Sources}" Visibility="{Binding ActiveTab, Converter={StaticResource TabToVis}, ConverterParameter=3}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:MasterDataItem}"><Border Padding="8,4" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Width="80"/><TextBlock Text="{Binding Name}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <ListBox Grid.Row="1" ItemsSource="{Binding Countries}" Visibility="{Binding ActiveTab, Converter={StaticResource TabToVis}, ConverterParameter=4}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:MasterDataItem}"><Border Padding="8,4" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Width="80"/><TextBlock Text="{Binding Name}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
        </Grid>
        <Border Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"><TextBlock Text="Dang tai..." Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
</UserControl>
