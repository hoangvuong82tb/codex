<UserControl x:Class="ASMILE.BO.App.Views.MessageCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" Loaded="OnLoaded">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
        <converters:StringToVisibilityConverter x:Key="StrToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Trung Tam Tin Nhan (Message Center)" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding TotalUnread, StringFormat='Chua doc: {0}'}" Margin="0,0,12,0" Foreground="#DC2626" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalPending, StringFormat='Cho tra loi: {0}'}" Foreground="#EA580C" FontWeight="SemiBold"/></StackPanel></StackPanel>
                <Button Grid.Column="1" Content="Lam moi" Command="{Binding RefreshCommand}" Style="{StaticResource FluentSecondaryButton}"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F0F4F8" Padding="12,8" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1">
            <WrapPanel>
                <ComboBox ItemsSource="{Binding MessageTypes}" SelectedItem="{Binding NewType}" Width="150" Margin="0,0,4,4"/>
                <TextBox Text="{Binding NewGuest, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,4,4"/>
                <TextBox Text="{Binding NewRoom, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,4,4"/>
                <TextBox Text="{Binding NewSubject, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,4,4"/>
                <TextBox Text="{Binding NewContent, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,4,4"/>
                <CheckBox Content="Can TL" IsChecked="{Binding NewRequiresResponse}" Margin="4,3,4,0"/>
                <Button Content="Gui" Command="{Binding CreateMessageCommand}" Style="{StaticResource FluentPrimaryButton}" Padding="8,4" FontSize="11"/>
            </WrapPanel>
        </Border>
        <ScrollViewer Grid.Row="2" Grid.Column="0" Margin="12,8">
            <ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:MessageDto}">
                <Border Padding="12,10" Margin="0,0,0,4" CornerRadius="8" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="OnClick" Tag="{Binding}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding MessageNumber}" FontWeight="SemiBold" Margin="0,0,8,0"/><Border CornerRadius="3" Padding="4,1" Background="{Binding Status, Converter={StaticResource StatusToColor}}"><TextBlock Text="{Binding Status}" FontSize="10" Foreground="White"/></Border></StackPanel>
                            <TextBlock Text="{Binding Subject}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Content}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="500" Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="{Binding GuestName}" FontSize="11"/><TextBlock Text="{Binding RoomNumber, StringFormat=' - Phong {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding AssignedStaff}" FontSize="11"/><TextBlock Text="{Binding Channel}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="2" Grid.Column="1" Background="White" BorderBrush="#DDE7F3" BorderThickness="1,0,0,0" Padding="16" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="CHI TIET" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding SelectedMessage.Subject}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedMessage.Content}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <Separator Margin="0,8"/>
                <TextBlock Text="{Binding SelectedMessage.GuestName}"/>
                <TextBlock Text="{Binding SelectedMessage.RoomNumber, StringFormat='Phong: {0}'}"/>
                <TextBlock Text="{Binding SelectedMessage.ResponseContent, StringFormat='Tra loi: {0}'}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding SelectedMessage.ResponseContent, Converter={StaticResource StrToVis}}"/>
                <Separator Margin="0,8"/>
                <Button Content="Danh dau da doc" Command="{Binding MarkReadCommand}" Style="{StaticResource FluentSecondaryButton}" Padding="8,4" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBox Text="{Binding ReplyContent, UpdateSourceTrigger=PropertyChanged}" Width="200"/><Button Content="Tra loi" Command="{Binding SendReplyCommand}" Style="{StaticResource FluentPrimaryButton}" Padding="6,4" FontSize="11" Margin="4,0,0,0"/></StackPanel>
                <Separator Margin="0,8"/>
                <ItemsControl ItemsSource="{Binding SelectedMessage.History}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </Border>
        <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"><TextBlock Text="Dang tai..." Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
</UserControl>
