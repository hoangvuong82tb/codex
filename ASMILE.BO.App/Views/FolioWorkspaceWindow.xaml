<Window x:Class="ASMILE.BO.App.Views.FolioWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folio" Width="1520" Height="920" MinWidth="1300" MinHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#94A3B8"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModernComboBox" TargetType="ComboBox"><Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/><Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#7B8DA6" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="9" Height="5" Stretch="Uniform"/></Grid></Border><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="8" Margin="0,2"><ScrollViewer MaxHeight="200"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Height" Value="32"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Height" Value="32"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="10,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PagerButtonStyle" TargetType="Button"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="26"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <ControlTemplate x:Key="RibbonBtn" TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
        <Style x:Key="ModernDataGrid" TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="#FAFBFD"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="RowHeight" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2F6FC"/><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="6,0"/></Style></Setter.Value></Setter></Style>
        <Style x:Key="PanelCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="FolioListItem" TargetType="Border"><Setter Property="Padding" Value="10,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderBrush" Value="#E2E8F0"/></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#102E5A"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="Auto"/>  <!-- Top Summary -->
            <RowDefinition Height="*"/>     <!-- Body -->
            <RowDefinition Height="Auto"/>  <!-- Bottom Summary -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══ -->
        <Border Padding="16,10" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F59E0B" Offset="0"/><GradientStop Color="#D97706" Offset="1"/></LinearGradientBrush></Border.Background>
                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Folio" FontSize="18" FontWeight="SemiBold" Foreground="#102E5A"/>
                    <TextBlock Text="Quản lý toàn bộ giao dịch tài chính của hồ sơ lưu trú." FontSize="12" Foreground="#64748B"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Làm mới" Click="OnRefresh" Style="{StaticResource SecondaryButton}"/>
                    <Button Content="In" Click="OnPrint" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/>
                    <Button Content="Xuất" Click="OnExport" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/>
                    <Button Content="Đóng" Click="OnClose" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ TOOLBAR ══ -->
        <Border Grid.Row="1" Padding="12,6" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBox x:Name="FwSearchBox" Width="180" Style="{StaticResource ModernTextBox}" Margin="0,0,4,4"/>
                <ComboBox x:Name="FwTypeFilter" Width="110" Style="{StaticResource ModernComboBox}" Margin="0,0,4,4"/>
                <ComboBox x:Name="FwCurrFilter" Width="70" Style="{StaticResource ModernComboBox}" Margin="0,0,4,4"/>
                <ComboBox x:Name="FwDeptFilter" Width="80" Style="{StaticResource ModernComboBox}" Margin="0,0,4,4"/>
                <ComboBox x:Name="FwStatusFilter" Width="90" Style="{StaticResource ModernComboBox}" Margin="0,0,4,4"/>
                <Button Content="Tìm" Click="OnApplyFilter" Style="{StaticResource PrimaryButton}" Margin="0,0,4,4"/>
                <Button Content="Xóa" Click="OnClearFilter" Style="{StaticResource SecondaryButton}" Margin="0,0,4,4"/>
            </WrapPanel>
        </Border>

        <!-- ══ TOP SUMMARY STRIP ══ -->
        <Border Grid.Row="2" Padding="10,5" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <WrapPanel x:Name="SummaryStrip" HorizontalAlignment="Center"/>
        </Border>

        <!-- ══ BODY: 3 columns ══ -->
        <Grid Grid.Row="3" Margin="8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Side Tabs + Folio List -->
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel x:Name="SideTabPanel" Margin="2,0,2,4"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FolioListPanel"/>
                </ScrollViewer>
            </Grid>

            <!-- CENTER: Transaction Workspace -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Ribbon -->
                    <RowDefinition Height="*"/>     <!-- Content Area (side tab content) -->
                    <RowDefinition Height="Auto"/>  <!-- Pager -->
                </Grid.RowDefinitions>

                <!-- Ribbon -->
                <Border Padding="8,4,8,2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0">
                    <StackPanel x:Name="RibbonPanel" Orientation="Horizontal"/>
                </Border>

                <!-- Side Tab Content Areas -->
                <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,1,0">
                    <Grid>
                    <!-- Overview -->
                    <StackPanel x:Name="OverviewContentArea" Visibility="Collapsed" Margin="12,8">
                        <StackPanel x:Name="OverviewContent"/>
                    </StackPanel>
                    <!-- Transactions (default) -->
                    <Grid x:Name="TxnContentArea" Visibility="Visible">
                        <DataGrid x:Name="TxnGrid" Style="{StaticResource ModernDataGrid}" SelectionChanged="OnTxnSelected" MouseDoubleClick="OnTxnMouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Thời gian" Binding="{Binding TimeDisplay}" Width="80"/>
                                <DataGridTextColumn Header="Mã GD" Binding="{Binding Id}" Width="80"/>
                                <DataGridTextColumn Header="Tham chiếu" Binding="{Binding Reference}" Width="90"/>
                                <DataGridTextColumn Header="Loại" Binding="{Binding Type}" Width="70"/>
                                <DataGridTextColumn Header="Diễn giải" Binding="{Binding Description}" Width="140"/>
                                <DataGridTextColumn Header="BP" Binding="{Binding Dept}" Width="45"/>
                                <DataGridTextColumn Header="Outlet" Binding="{Binding Outlet}" Width="90"/>
                                <DataGridTextColumn Header="SL" Binding="{Binding Qty}" Width="35"/>
                                <DataGridTextColumn Header="ĐG" Binding="{Binding Price}" Width="70"/>
                                <DataGridTextColumn Header="Tiền" Binding="{Binding AmountDisplay}" Width="85"/>
                                <DataGridTextColumn Header="Thuế" Binding="{Binding TaxDisplay}" Width="60"/>
                                <DataGridTextColumn Header="Disc" Binding="{Binding DiscountDisplay}" Width="55"/>
                                <DataGridTextColumn Header="P.DV" Binding="{Binding ScDisplay}" Width="55"/>
                                <DataGridTextColumn Header="Tệ" Binding="{Binding Currency}" Width="40"/>
                                <DataGridTextColumn Header="Người TT" Binding="{Binding Payer}" Width="65"/>
                                <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="75"/>
                                <DataGridTextColumn Header="T.Thái" Binding="{Binding Status}" Width="65"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <!-- Payments -->
                    <StackPanel x:Name="PaymentContentArea" Visibility="Collapsed" Margin="10,6">
                        <StackPanel x:Name="PaymentContent"/>
                    </StackPanel>
                    <!-- Deposits -->
                    <StackPanel x:Name="DepositContentArea" Visibility="Collapsed" Margin="10,6">
                        <StackPanel x:Name="DepositContent"/>
                    </StackPanel>
                    <!-- Refunds -->
                    <StackPanel x:Name="RefundContentArea" Visibility="Collapsed" Margin="10,6">
                        <StackPanel x:Name="RefundContent"/>
                    </StackPanel>
                    <!-- Routing -->
                    <StackPanel x:Name="RoutingContentArea" Visibility="Collapsed" Margin="10,6">
                        <StackPanel x:Name="RoutingContent"/>
                    </StackPanel>
                    <!-- History -->
                    <StackPanel x:Name="HistoryContentArea" Visibility="Collapsed" Margin="10,6">
                        <StackPanel x:Name="HistoryContent"/>
                    </StackPanel>
                    <!-- Documents -->
                    <StackPanel x:Name="DocumentContentArea" Visibility="Collapsed" Margin="10,6">
                        <StackPanel x:Name="DocumentContent"/>
                    </StackPanel>
                    </Grid>
                </Border>

                <!-- Pager -->
                <Border Grid.Row="2" Padding="8,5" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxnPagerSummary" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="TxnPrevBtn" Content="←" Click="OnTxnPrevPage" Style="{StaticResource PagerButtonStyle}"/>
                            <StackPanel x:Name="TxnPageBtns" Orientation="Horizontal"/>
                            <Button x:Name="TxnNextBtn" Content="→" Click="OnTxnNextPage" Style="{StaticResource PagerButtonStyle}"/>
                            <ComboBox x:Name="TxnPageSizeBox" Width="110" Margin="4,0,0,0" SelectionChanged="OnTxnPageSizeChanged" Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT: Inspector -->
            <Border Grid.Column="4" Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <StackPanel x:Name="InspectorTabs" Orientation="Horizontal" Margin="6,4,0,0"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,6">
                        <StackPanel x:Name="InspectorPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ BOTTOM SUMMARY ══ -->
        <Border Grid.Row="4" Padding="10,5" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <WrapPanel x:Name="BottomSummary" HorizontalAlignment="Center"/>
        </Border>

        <!-- ══ FOOTER ══ -->
        <Border Grid.Row="5" Padding="10,6" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                <Button HorizontalAlignment="Right" Content="Đóng" Click="OnClose" Style="{StaticResource SecondaryButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
