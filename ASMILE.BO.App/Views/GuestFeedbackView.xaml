<UserControl x:Class="ASMILE.BO.App.Views.GuestFeedbackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             UseLayoutRounding="True" Loaded="OnLoaded">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
        <converters:FeedbackTypeColorConverter x:Key="FeedbackTypeColor"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Phan Hoi &amp; Khieu Nai (Guest Feedback)" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding TotalNew, StringFormat='Moi: {}{0}'}" Margin="0,0,12,0" Foreground="#EA580C" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalResolved, StringFormat='Da giai quyet: {}{0}'}" Margin="0,0,12,0" Foreground="#16A34A" FontWeight="SemiBold"/><TextBlock Text="{Binding AvgRating, StringFormat='Diem TB: {}{0:F1}/5'}" Foreground="#F2994A" FontWeight="SemiBold"/></StackPanel></StackPanel>
                <Button Grid.Column="1" Content="Lam moi" Command="{Binding RefreshCommand}" Style="{StaticResource FluentSecondaryButton}"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F0F4F8" Padding="12,8" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1">
            <WrapPanel>
                <ComboBox ItemsSource="{Binding FeedbackTypes}" SelectedItem="{Binding NewType}" Width="120" Margin="0,0,4,4"/>
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding NewCategory}" Width="120" Margin="0,0,4,4"/>
                <TextBox Text="{Binding NewGuest, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,4,4"/>
                <TextBox Text="{Binding NewRoom, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,4,4"/>
                <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,4,4"/>
                <ComboBox Width="80" Margin="0,0,4,4" SelectedItem="{Binding NewPriority}"><ComboBox.ItemsSource><x:Array Type="system:String"><system:String>Normal</system:String><system:String>High</system:String><system:String>Urgent</system:String></x:Array></ComboBox.ItemsSource></ComboBox>
                <TextBox Text="{Binding NewRating, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,4,4"/>
                <Button Content="Ghi nhan" Command="{Binding CreateFeedbackCommand}" Style="{StaticResource FluentPrimaryButton}" Padding="8,4" FontSize="11"/>
            </WrapPanel>
        </Border>
        <ScrollViewer Grid.Row="2" Grid.Column="0" Margin="12,8">
            <ItemsControl ItemsSource="{Binding Feedbacks}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:FeedbackDto}">
                <Border Padding="12,10" Margin="0,0,0,4" CornerRadius="8" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="OnClick" Tag="{Binding}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding FeedbackType}" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="{Binding FeedbackType, Converter={StaticResource FeedbackTypeColor}}"/><Border CornerRadius="3" Padding="4,1" Background="{Binding Status, Converter={StaticResource StatusToColor}}"><TextBlock Text="{Binding Status}" FontSize="10" Foreground="White"/></Border></StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="500" Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="{Binding GuestName}" FontSize="11"/><TextBlock Text="{Binding RoomNumber, StringFormat=' - Phong {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding Rating, StringFormat=' - {0}/5★'}" FontSize="11" Foreground="#F2994A"/></StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="2" Grid.Column="1" Background="White" BorderBrush="#DDE7F3" BorderThickness="1,0,0,0" Padding="16" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="CHI TIET" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding SelectedFeedback.FeedbackNumber}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedFeedback.FeedbackType}"/>
                <TextBlock Text="{Binding SelectedFeedback.Description}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <Separator Margin="0,8"/>
                <WrapPanel>
                    <Button Content="Phan cong" Command="{Binding AssignFeedbackCommand}" Style="{StaticResource FluentPrimaryButton}" Padding="8,4" Margin="0,0,4,4"/>
                    <Button Content="Giai quyet" Command="{Binding ResolveFeedbackCommand}" Style="{StaticResource FluentSecondaryButton}" Padding="8,4" Margin="0,0,4,4"/>
                    <Button Content="Dong" Command="{Binding CloseFeedbackCommand}" Style="{StaticResource FluentSecondaryButton}" Padding="8,4"/>
                </WrapPanel>
                <Separator Margin="0,8"/>
                <ItemsControl ItemsSource="{Binding SelectedFeedback.History}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </Border>
        <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"><TextBlock Text="Dang tai..." Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
</UserControl>
