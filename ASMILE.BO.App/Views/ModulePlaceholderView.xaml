<UserControl x:Class="ASMILE.BO.App.Views.ModulePlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource ContentCardStyle}" Margin="12">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="580">
            <TextBlock Text="{Binding Title}" Style="{StaticResource AppTitleTextStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Description}" Margin="0,10,0,0" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
            <Border Margin="0,18,0,0" Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Center">
                <TextBlock Text="Đã tích hợp vào Windows 11 shell - chờ hoàn thiện nghiệp vụ chi tiết" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
