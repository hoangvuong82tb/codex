<UserControl x:Class="ASMILE.BO.App.Views.ShellNavigationFlyoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:model="clr-namespace:ASMILE.BO.App.Models"
             xmlns:dto="clr-namespace:ASMILE.BO.Application.DTOs;assembly=ASMILE.BO.Application"
             xmlns:controls="clr-namespace:ASMILE.BO.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="660"
             d:DesignWidth="760">
    <Border Width="760"
            Height="660"
            Style="{StaticResource ShellNavigationFlyoutCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="NavigationSearchBox"
                     Grid.Row="0"
                     Style="{StaticResource StartSearchBoxStyle}"
                     Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Tìm kiếm module, báo cáo và dữ liệu"
                     AutomationProperties.AutomationId="ShellNavigationSearchBox"
                     ToolTip="Ctrl+P" />

            <DockPanel Grid.Row="1"
                       Margin="2,16,2,12"
                       LastChildFill="False">
                <TextBlock Text="{Binding BreadcrumbText}"
                           Style="{StaticResource ShellNavigationCaptionTextStyle}"
                           DockPanel.Dock="Left"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="470" />
                <TextBlock Text="{Binding ShellStatusMessage}"
                           Style="{StaticResource ShellNavigationCaptionTextStyle}"
                           DockPanel.Dock="Right"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="230" />
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.92*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="250" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource ShellNavigationSectionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Pinned modules"
                                   Style="{StaticResource StartSectionHeaderTextStyle}" />
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,10,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding StartFilteredPinnedModules}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:AppModuleInfo}">
                                        <controls:StartPinnedAppTileControl Module="{Binding}"
                                                                            OpenCommand="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource ShellNavigationSectionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Recent modules"
                                   Style="{StaticResource StartSectionHeaderTextStyle}" />
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,10,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RecentModules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:AppModuleInfo}">
                                        <Button Style="{StaticResource ShellNavigationListButtonStyle}"
                                                Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28"
                                                        Height="28"
                                                        CornerRadius="8"
                                                        Background="#22FFFFFF"
                                                        BorderBrush="#45FFFFFF"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <Image Source="{Binding IconImage}"
                                                           Width="18"
                                                           Height="18"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource ShellNavigationSectionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Quick actions"
                                   Style="{StaticResource StartSectionHeaderTextStyle}" />
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,10,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RecommendedItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:StartRecommendedItem}">
                                        <controls:RecommendedItemControl Item="{Binding}"
                                                                         OpenCommand="{Binding DataContext.OpenRecommendedItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource ShellNavigationSectionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Search and reports"
                                   Style="{StaticResource StartSectionHeaderTextStyle}" />
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,10,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding GlobalSearchResults}"
                                              Visibility="{Binding IsGlobalSearchOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type dto:GlobalSearchResultDto}">
                                            <Button Style="{StaticResource ShellNavigationListButtonStyle}"
                                                    AutomationProperties.Name="{Binding Title}"
                                                    AutomationProperties.AutomationId="{Binding TargetRoute}"
                                                    Command="{Binding DataContext.OpenGlobalSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#E6F0FF"
                                                            CornerRadius="8"
                                                            Padding="6,3"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#2563EB" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="12.3"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding ShellReportModules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type model:AppModuleInfo}">
                                            <Button Style="{StaticResource ShellNavigationListButtonStyle}"
                                                    Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding IconGlyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="16"
                                                               Foreground="{Binding AccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="12.3"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Style="{StaticResource ShellNavigationFooterStyle}"
                    Margin="-18,12,-18,-12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="32"
                                Height="32"
                                CornerRadius="16"
                                Background="#28FFFFFF"
                                BorderBrush="#58FFFFFF"
                                BorderThickness="1">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#2A4567"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserName}"
                                       FontSize="12.4"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentCompanyStatus}"
                                       FontSize="10.8"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableCompanies}"
                              SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Height="30"
                              Margin="10,0,0,0"
                              ToolTip="Current company" />

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding AvailableBranches}"
                              SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Height="30"
                              Margin="8,0,0,0"
                              ToolTip="Current branch" />

                    <Button Grid.Column="3"
                            Style="{StaticResource PowerButtonStyle}"
                            Margin="10,0,0,0"
                            Command="{Binding QuickActionCommand}"
                            CommandParameter="logout"
                            ToolTip="Sign out">
                        <TextBlock Text="&#xE7E8;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="#2A4567" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
