<UserControl x:Class="ASMILE.BO.App.Views.TelephoneCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="Input" TargetType="TextBox"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
        <Style x:Key="Primary" TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="16,0"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="Secondary" TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="16,0"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/></Style>
    </UserControl.Resources>
    <Grid Background="#F7F9FC">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" Padding="22,16" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="10" Background="#E0F2FE"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="{Binding WorkspaceTitle}" FontSize="20" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Dữ liệu cuộc gọi và danh bạ theo cơ sở" Foreground="#64748B" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="2" Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource Secondary}"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" Padding="18,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="250" Style="{StaticResource Input}" ToolTip="Số điện thoại, tên khách hoặc phòng" Margin="0,0,8,0"/>
                <Button Content="Tìm" Command="{Binding RefreshCommand}" Style="{StaticResource Primary}"/>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2" Margin="16,14">
            <Grid Visibility="{Binding IsCallsMode, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="10">
                    <DataGrid ItemsSource="{Binding Calls}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="40" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns><DataGridTextColumn Header="Thời gian" Binding="{Binding StartedAtUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/><DataGridTextColumn Header="Hướng" Binding="{Binding Direction}" Width="90"/><DataGridTextColumn Header="Số điện thoại" Binding="{Binding PhoneNumber}" Width="140"/><DataGridTextColumn Header="Khách" Binding="{Binding GuestName}" Width="*"/><DataGridTextColumn Header="Phòng" Binding="{Binding RoomNumber}" Width="80"/><DataGridTextColumn Header="Thời lượng" Binding="{Binding DurationSeconds, StringFormat={}{0}s}" Width="90"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="100"/></DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="12,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Ghi cuộc gọi" FontSize="17" FontWeight="SemiBold" Foreground="#17365D" Margin="0,0,0,14"/><TextBlock Text="Số điện thoại" Foreground="#64748B"/><TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,4,0,10"/><TextBlock Text="Tên khách" Foreground="#64748B"/><TextBox Text="{Binding GuestName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,4,0,10"/><TextBlock Text="Phòng" Foreground="#64748B"/><TextBox Text="{Binding RoomNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,4,0,10"/><TextBlock Text="Chủ đề" Foreground="#64748B"/><TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,4,0,10"/><TextBlock Text="Thời lượng (giây)" Foreground="#64748B"/><TextBox Text="{Binding DurationSeconds}" Style="{StaticResource Input}" Margin="0,4,0,10"/><TextBlock Text="Ghi chú" Foreground="#64748B"/><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8" BorderBrush="#D8E2F0" Margin="0,4,0,14"/><Button Content="Lưu cuộc gọi" Command="{Binding LogCallCommand}" Style="{StaticResource Primary}"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="{Binding InfoMessage}" Foreground="#15803D" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></ScrollViewer>
                </Border>
            </Grid>
            <Grid Visibility="{Binding IsContactsMode, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="10"><DataGrid ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="40" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Tên" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Điện thoại" Binding="{Binding PhoneNumber}" Width="150"/><DataGridTextColumn Header="Phòng" Binding="{Binding RoomNumber}" Width="90"/><DataGridTextColumn Header="Nhóm" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="Cập nhật" Binding="{Binding UpdatedAtUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/></DataGrid.Columns></DataGrid></Border>
                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="12,0,0,0"><StackPanel><TextBlock Text="Danh bạ" FontSize="17" FontWeight="SemiBold" Foreground="#17365D" Margin="0,0,0,14"/><TextBlock Text="Tên liên hệ" Foreground="#64748B"/><TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,4,0,10"/><TextBlock Text="Điện thoại" Foreground="#64748B"/><TextBox Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,4,0,10"/><TextBlock Text="Phòng" Foreground="#64748B"/><TextBox Text="{Binding ContactRoom, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,4,0,10"/><TextBlock Text="Nhóm" Foreground="#64748B"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding ContactCategory}" Height="36" Margin="0,4,0,10"/><TextBlock Text="Ghi chú" Foreground="#64748B"/><TextBox Text="{Binding ContactNotes, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8" BorderBrush="#D8E2F0" Margin="0,4,0,14"/><Button Content="Lưu liên hệ" Command="{Binding SaveContactCommand}" Style="{StaticResource Primary}"/><Button Content="Ẩn liên hệ đang chọn" Command="{Binding DeactivateContactCommand}" IsEnabled="{Binding HasContactSelection}" Style="{StaticResource Secondary}" Margin="0,8,0,0"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="{Binding InfoMessage}" Foreground="#15803D" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
            </Grid>
            <Border Background="#66000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"><TextBlock Text="Đang tải..." Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        </Grid>
    </Grid>
</UserControl>
