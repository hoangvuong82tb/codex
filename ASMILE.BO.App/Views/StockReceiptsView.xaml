                  </StackPanel>
                  <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                    <TextBlock Text="Người nhận hàng" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox Style="{StaticResource FluentComboBox}" IsEditable="False" IsTextSearchEnabled="True" SelectedValuePath="Name" DisplayMemberPath="Display" HorizontalAlignment="Stretch" ItemsSource="{Binding EmployeeLookup}" SelectedValue="{Binding ReceiverName, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Hạn sử dụng (nếu có)" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Border Style="{StaticResource VoucherDateHostStyle}">
                      <DatePicker Style="{StaticResource VoucherDatePickerStyle}" SelectedDate="{Binding ExpiryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Tài khoản nợ / có" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Style="{StaticResource FluentTextBox}" Text="{Binding DebitAccountCode, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBox Grid.Column="2" Style="{StaticResource FluentTextBox}" Text="{Binding CreditAccountCode, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" HorizontalAlignment="Stretch">
                    <TextBlock Text="Tên sản phẩm" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox Style="{StaticResource FluentComboBox}" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" SelectedValuePath="Id" DisplayMemberPath="Display" HorizontalAlignment="Stretch" IsDropDownOpen="{Binding IsDetailProductDropdownOpen, Mode=TwoWay}" Text="{Binding DetailProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding FilteredItemLookup}" SelectedValue="{Binding DetailProductItemId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                    <Grid Margin="0,0,0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="VAT" Foreground="#223B5A" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <CheckBox Grid.Column="1" Content="Giá đã gồm VAT" IsChecked="{Binding DetailPriceIncludesVat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#223B5A" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <ComboBox Style="{StaticResource FluentComboBox}" IsEditable="False" HorizontalAlignment="Stretch" ItemsSource="{Binding VatRateOptions}" SelectedItem="{Binding DetailVatRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding StringFormat={}{0:N0}%}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Số lượng" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource FluentTextBox}" Text="{Binding DetailQuantityInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="Đơn giá" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource FluentTextBox}" Text="{Binding DetailUnitPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N0}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Thành tiền" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource FluentTextBox}" Text="{Binding DetailAmount, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N0}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Kho nhập" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,12,0,6" />
                <ComboBox Style="{StaticResource FluentComboBox}" IsEditable="False" SelectedValuePath="Id" DisplayMemberPath="Display" ItemsSource="{Binding WarehouseLookup}" SelectedValue="{Binding DetailWarehouseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                  <Button Style="{StaticResource CompactPrimaryButtonStyle}" Margin="0,0,10,0" Command="{Binding AddDetailFromFormCommand}">
                    <TextBlock Text="Thêm dòng" Foreground="#FFFFFFFF" />
                  </Button>
                  <Button Style="{StaticResource CompactDangerButtonStyle}" Command="{Binding RemoveDetailCommand}" CommandParameter="{Binding SelectedDetail}">
                    <TextBlock Text="Xóa dòng" Foreground="#FFFFFFFF" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="#D9E5F4" BorderThickness="0,1,0,0" Padding="0,12,0,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CompactSecondaryButtonStyle}" Margin="0,0,10,0" Command="{Binding NewCommand}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" Foreground="#1F3653" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="Mới" Foreground="#1F3653" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource CompactPrimaryButtonStyle}" Margin="0,0,10,0" Command="{Binding SaveCommand}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" Foreground="#FFFFFFFF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="Lưu" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource CompactDangerButtonStyle}" Command="{Binding DeleteCommand}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" Foreground="#FFFFFFFF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="Xóa" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <Border Name="ReceiptDetailModal" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Background="#800F172A" Panel.ZIndex="20">
          <Grid Name="ReceiptDetailModalHost">
            <Border Name="ReceiptDetailFloatingWindow" Background="#FFFFFFFF" Width="1180" Height="700" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" BorderBrush="#D5DFEB" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
              <UIElement.RenderTransform>
                <TranslateTransform x:Name="ReceiptDetailWindowTransform" X="0" Y="0" />
              </UIElement.RenderTransform>
              <Grid Margin="16">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Row="0" Margin="0,0,0,10" Background="#00FFFFFF" MouseLeftButtonDown="ReceiptWindowHeader_MouseLeftButtonDown" MouseMove="ReceiptWindowHeader_MouseMove" MouseLeftButtonUp="ReceiptWindowHeader_MouseLeftButtonUp">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Chi tiết phiếu nhập" FontSize="20" FontWeight="SemiBold" Foreground="#0F2747" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Width="34" Height="34" ToolTip="Đóng" Click="CloseReceiptDetailModal_Click">
                    <TextBlock Text="✕" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  </Button>
                </Grid>
                <Border Grid.Row="1" Background="#FFFFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                  <Grid Name="ReceiptDetailHeaderPanel">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                  </Grid>
                </Border>
                <Border Grid.Row="2" Margin="0,12,0,10" Background="#FFFFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="10">
                  <DataGrid Name="ReceiptDetailGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" RowHeight="38" Background="#FFFFFFFF" GridLinesVisibility="All" HeadersVisibility="Column" HorizontalAlignment="Stretch" HorizontalGridLinesBrush="#CBD5E1" VerticalGridLinesBrush="#CBD5E1" BorderBrush="#CBD5E1" CellStyle="{StaticResource EnterpriseDetailDataGridCell}">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="STT" Width="70" ElementStyle="{StaticResource EnterpriseDetailGridText}" Binding="{Binding LineNo}" />
                      <DataGridTextColumn Header="Mã hàng" Width="120" ElementStyle="{StaticResource EnterpriseDetailGridText}" Binding="{Binding ItemCode}" />
                      <DataGridTextColumn Header="Tên hàng hóa" Width="*" ElementStyle="{StaticResource EnterpriseDetailGridText}" Binding="{Binding ItemName}" />
                      <DataGridTextColumn Header="ĐV tính" Width="90" ElementStyle="{StaticResource EnterpriseDetailGridText}" Binding="{Binding Unit}" />
                      <DataGridTextColumn Header="Kho" Width="80" ElementStyle="{StaticResource EnterpriseDetailGridText}" Binding="{Binding WarehouseCode}" />
                      <DataGridTextColumn Header="Số lượng" Width="100" ElementStyle="{StaticResource EnterpriseDetailGridText}" Binding="{Binding Quantity, StringFormat={}{0:#,##0.####}}" />
                      <DataGridTextColumn Header="Đơn giá" Width="110" ElementStyle="{StaticResource EnterpriseDetailGridText}" Binding="{Binding UnitPrice, StringFormat=N0}" />
                      <DataGridTextColumn Header="VAT %" Width="82" ElementStyle="{StaticResource EnterpriseDetailGridText}" Binding="{Binding VatRate, StringFormat={}{0:N0}%}" />
                      <DataGridTextColumn Header="Tiền VAT" Width="110" ElementStyle="{StaticResource EnterpriseDetailGridText}" Binding="{Binding VatAmount, StringFormat=N0}" />
                      <DataGridTextColumn Header="Thành tiền" Width="130" ElementStyle="{StaticResource EnterpriseDetailGridText}" Binding="{Binding Amount, StringFormat=N0}" />
                    </DataGrid.Columns>
                  </DataGrid>
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Width="132" Height="36" Margin="0,0,10,0" Content="Xem trước in" Click="PreviewInAppButton_Click" />
                  <Button Width="92" Height="36" Content="Đóng" Click="CloseReceiptDetailModal_Click" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Name="ReceiptPrintPreviewModal" Visibility="Collapsed" Background="#7A0F172A" Panel.ZIndex="30">
              <Grid>
                <Border Background="#FFFFFFFF" Width="1060" Height="640" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" BorderBrush="#D5DFEB" BorderThickness="1">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Xem trước in phiếu nhập" FontSize="18" FontWeight="SemiBold" Foreground="#0F2747" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                          <Button Width="90" Height="32" Margin="0,0,8,0" Content="In phiếu" Click="PrintFromInAppPreviewButton_Click" />
                          <Button Width="70" Height="32" Content="Đóng" Click="CloseInAppPreviewButton_Click" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Grid.Row="1" Padding="8">
                      <DocumentViewer Name="ReceiptPreviewViewer" />
                    </Border>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
