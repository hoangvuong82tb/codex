<Window x:Class="ASMILE.BO.App.Views.CreateShiftLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo nhật ký ca" Width="650" Height="680" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Tạo nhật ký ca" FontSize="22" FontWeight="SemiBold" Foreground="#17365D" Margin="0,0,0,4"/>
                <TextBlock Text="Ghi nhận bàn giao, theo dõi hoặc công việc vận hành không phải sự cố." Foreground="#64748B" Margin="0,0,0,18"/>
                <TextBlock Text="Ca"/><ComboBox x:Name="ShiftBox" Margin="0,4,0,12" Height="32"/>
                <TextBlock Text="Tiêu đề"/><TextBox x:Name="TitleBox" Margin="0,4,0,12" Height="32"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="Danh mục"/><ComboBox x:Name="CategoryBox" Margin="0,4,0,12" Height="32"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Ưu tiên"/><ComboBox x:Name="PriorityBox" Margin="0,4,0,12" Height="32"/></StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="Phòng"/><TextBox x:Name="RoomBox" Margin="0,4,0,12" Height="32"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Khách"/><TextBox x:Name="GuestBox" Margin="0,4,0,12" Height="32"/></StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="Mã đặt phòng"/><TextBox x:Name="ReservationBox" Margin="0,4,0,12" Height="32"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Phân công"/><TextBox x:Name="AssignedBox" Margin="0,4,0,12" Height="32"/></StackPanel>
                </Grid>
                <TextBlock Text="Mô tả"/><TextBox x:Name="DescriptionBox" Margin="0,4,0,12" Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                <CheckBox x:Name="VipBox" Content="Khách VIP" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Hủy" Width="90" Height="34" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="Lưu nhật ký" Width="120" Height="34" Background="#2F6BFF" Foreground="White" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
