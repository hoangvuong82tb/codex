<UserControl x:Class="ASMILE.BO.App.Views.SearchReservationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             Background="#F8FAFC">
    <UserControl.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding SearchCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <converters:StayNightsConverter x:Key="NightsConv" />

        <!-- Status badge colors -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Confirmed"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Tentative"><Setter Property="Background" Value="#FFF7ED"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Draft"><Setter Property="Background" Value="#F1F5F9"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Background" Value="#F3F4F6"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NoShow"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="CheckedIn"><Setter Property="Background" Value="#DCFCE7"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Confirmed"><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Tentative"><Setter Property="Foreground" Value="#C2410C"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Draft"><Setter Property="Foreground" Value="#475569"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Foreground" Value="#6B7280"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NoShow"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="CheckedIn"><Setter Property="Foreground" Value="#166534"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Modern filter control styles -->
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/><Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SearchComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#94A3B8" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="6" Stretch="Uniform"/>
                    </Grid>
                </Border>
                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="8" Margin="0,2" SnapsToDevicePixels="True"><ScrollViewer MaxHeight="200"><ItemsPresenter/></ScrollViewer></Border>
                </Popup></Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SearchDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="38"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
                <Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                        <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" BorderThickness="0" Background="Transparent" Padding="12,0" VerticalContentAlignment="Center" FontSize="13" FontFamily="Segoe UI"/>
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="6" Background="#EFF6FF" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#2F6BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsFocused" Value="True"><Setter Property="BorderBrush" Value="#2F6BFF"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- DataGrid styles -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="RowHeight" Value="40"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value><Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F2F6FC"/><Setter Property="Foreground" Value="#475569"/>
                    <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="Padding" Value="12,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style></Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value><Style TargetType="DataGridRow">
                    <Setter Property="BorderBrush" Value="#F1F5F9"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#7B8DA6"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style x:Key="DetailValue" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style x:Key="DetailRow" TargetType="Border"><Setter Property="Background" Value="#FAFBFD"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,0,8"/></Style>

        <Style x:Key="BlueBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Background" Value="#94A3B8"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="GrayBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="10" Background="#EFF6FF">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Tìm đặt phòng" FontSize="19" FontWeight="SemiBold" Foreground="#102E5A" FontFamily="Segoe UI"/>
                    <TextBlock Text="Tra cứu theo số đặt phòng, tên khách hoặc ngày lưu trú" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource GrayBtn}"/>
            </Grid>
        </Border>

        <!-- ═══ FILTER CARD ═══ -->
        <Border Grid.Row="1" Margin="16,14,16,6" Padding="18,16" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,14,6"><TextBlock Text="Từ khóa" FontSize="12" Foreground="#64748B" Margin="0,0,0,5"/><TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBox}" Width="220" TabIndex="1"/></StackPanel>
                <StackPanel Margin="0,0,14,6"><TextBlock Text="Trạng thái" FontSize="12" Foreground="#64748B" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}" Style="{StaticResource SearchComboBox}" Width="150" TabIndex="2"/></StackPanel>
                <StackPanel Margin="0,0,14,6"><TextBlock Text="Ngày đến từ" FontSize="12" Foreground="#64748B" Margin="0,0,0,5"/><DatePicker SelectedDate="{Binding FilterArrivalFrom}" Style="{StaticResource SearchDatePicker}" Width="140" TabIndex="3"/></StackPanel>
                <StackPanel Margin="0,0,14,6"><TextBlock Text="Ngày đến đến" FontSize="12" Foreground="#64748B" Margin="0,0,0,5"/><DatePicker SelectedDate="{Binding FilterArrivalTo}" Style="{StaticResource SearchDatePicker}" Width="140" TabIndex="4"/></StackPanel>
                <StackPanel Margin="0,16,8,6" Orientation="Horizontal">
                    <Button Content="Xóa lọc" Command="{Binding ClearFiltersCommand}" Style="{StaticResource GrayBtn}" TabIndex="6"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ═══ MAIN: DataGrid + Detail Panel ═══ -->
        <Grid Grid.Row="2" Margin="16,8,16,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>

            <!-- DataGrid Card -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="18,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Danh sách đặt phòng" FontSize="14" FontWeight="SemiBold" Foreground="#102E5A"/>
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="#94A3B8" Text="{Binding TotalCount, StringFormat={}{0} kết quả}"/>
                        </Grid>
                    </Border>

                    <!-- EMPTY -->
                    <Border Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" Background="White">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Không tìm thấy đặt phòng phù hợp." FontSize="14" Foreground="#64748B"/><Button Content="Xóa bộ lọc" Command="{Binding ClearFiltersCommand}" Style="{StaticResource GrayBtn}" Margin="0,14,0,0"/></StackPanel>
                    </Border>

                    <!-- LOADING -->
                    <Border Grid.Row="1" Background="#D9FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar Width="160" Height="6" IsIndeterminate="True"/><TextBlock Text="Đang tải..." Margin="0,10,0,0" Foreground="#64748B"/></StackPanel>
                    </Border>

                    <!-- ERROR -->
                    <Border Grid.Row="1" Visibility="{Binding HasError, Converter={StaticResource BoolVis}}" Background="White">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                            <TextBlock Text="Không thể tải danh sách." FontSize="14" FontWeight="SemiBold" Foreground="#DC2626" TextAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}" FontSize="13" Foreground="#991B1B" TextAlignment="Center" Margin="0,6,0,0"/>
                            <Button Content="Thử lại" Command="{Binding RefreshCommand}" Style="{StaticResource BlueBtn}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Reservations}" SelectedItem="{Binding SelectedReservation}"
                              Style="{StaticResource ModernDataGrid}" MouseDoubleClick="OnDataGridDoubleClick" TabIndex="7">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Trạng thái" Width="120">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Border Style="{StaticResource StatusBadge}"><TextBlock Style="{StaticResource StatusText}" Text="{Binding Status}"/></Border>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Số ĐP" Binding="{Binding ReservationNumber}" Width="130">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#17365D"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tên khách" Binding="{Binding GuestName}" Width="170"/>
                            <DataGridTextColumn Header="Ngày đến" Binding="{Binding ArrivalDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Ngày đi" Binding="{Binding DepartureDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTemplateColumn Header="Số đêm" Width="70">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding Nights, Mode=OneWay}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ng.lớn" Binding="{Binding AdultCount}" Width="60"/>
                            <DataGridTextColumn Header="Trẻ em" Binding="{Binding ChildCount}" Width="60"/>
                            <DataGridTextColumn Header="Nguồn" Binding="{Binding Source}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Detail Panel -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,16">
                            <TextBlock Text="Chi tiết đặt phòng" FontSize="14" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,14"/>

                            <!-- Empty state -->
                            <Border Background="#FAFBFD" CornerRadius="8" Padding="24,20"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style></Border.Style>
                                <TextBlock Text="Chọn một đặt phòng để xem chi tiết." FontSize="13" Foreground="#94A3B8" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Detail content -->
                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                                <Border Style="{StaticResource DetailRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="Số đặt phòng"/>
                                        <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedReservation.ReservationNumber, Mode=OneWay, FallbackValue=—}"/>
                                        <TextBlock Style="{StaticResource DetailLabel}" Margin="0,8,0,0" Text="Trạng thái"/>
                                        <Border Style="{StaticResource StatusBadge}" Margin="0,4,0,0" DataContext="{Binding SelectedReservation}"><TextBlock Style="{StaticResource StatusText}" Text="{Binding Status, Mode=OneWay, FallbackValue=—}"/></Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource DetailRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="Tên khách"/>
                                        <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedReservation.GuestName, Mode=OneWay, FallbackValue=—}"/>
                                        <TextBlock Style="{StaticResource DetailLabel}" Margin="0,6,0,0" Text="Điện thoại"/><TextBlock Text="{Binding SelectedReservation.GuestPhone, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" FontSize="13" Foreground="#17365D"/>
                                        <TextBlock Style="{StaticResource DetailLabel}" Margin="0,6,0,0" Text="Email"/><TextBlock Text="{Binding SelectedReservation.GuestEmail, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" FontSize="13" Foreground="#17365D" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource DetailRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="Ngày đến"/>
                                        <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedReservation.ArrivalDate, Mode=OneWay, StringFormat=dd/MM/yyyy, FallbackValue=—}"/>
                                        <TextBlock Style="{StaticResource DetailLabel}" Margin="0,6,0,0" Text="Ngày đi"/>
                                        <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedReservation.DepartureDate, Mode=OneWay, StringFormat=dd/MM/yyyy, FallbackValue=—}"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#2563EB" FontWeight="SemiBold"
                                                   Text="{Binding SelectedReservation.Nights, Mode=OneWay, StringFormat='Số đêm: {0}'}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource DetailRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="Người lớn"/><TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedReservation.AdultCount, Mode=OneWay}"/>
                                        <TextBlock Style="{StaticResource DetailLabel}" Margin="0,6,0,0" Text="Trẻ em"/><TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedReservation.ChildCount, Mode=OneWay}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource DetailRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="Loại phòng"/><TextBlock Text="—" FontSize="13" Foreground="#17365D"/>
                                        <TextBlock Style="{StaticResource DetailLabel}" Margin="0,6,0,0" Text="Số phòng"/><TextBlock Text="—" FontSize="13" Foreground="#17365D"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource DetailRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="Nguồn"/><TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedReservation.Source, Mode=OneWay, FallbackValue=—}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action buttons -->
                    <Border Grid.Row="1" Padding="14,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Button Content="Xem chi tiết" Style="{StaticResource BlueBtn}" IsEnabled="{Binding HasSelection}" Click="OnViewDetailClick"/>
                            <Button Content="Chọn đặt phòng" Style="{StaticResource GrayBtn}" IsEnabled="{Binding HasSelection}" Margin="0,6,0,0" Click="OnSelectClick"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ FOOTER ═══ -->
        <Border Grid.Row="3" Padding="18,12" Margin="16,10,16,16" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="#64748B" FontSize="13" Text="{Binding TotalCount, StringFormat={}Tổng: {0} kết quả}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="← Trước" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}" Style="{StaticResource GrayBtn}" TabIndex="10"/>
                    <Button Content="Sau →" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" Style="{StaticResource GrayBtn}" Margin="8,0,0,0" TabIndex="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
