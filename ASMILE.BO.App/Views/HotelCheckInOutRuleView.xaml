<UserControl x:Class="ASMILE.BO.App.Views.HotelCheckInOutRuleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
 <UserControl.Resources>
  <Style x:Key="B" TargetType="Button" BasedOn="{StaticResource HotelSettingsButtonBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="P" TargetType="Button" BasedOn="{StaticResource B}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/></Style>
  <Style x:Key="T" TargetType="TextBox" BasedOn="{StaticResource HotelSettingsTextBoxBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="9,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style>
 </UserControl.Resources>
 <Grid Background="Transparent" Margin="0,0,0,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Padding="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Quy tắc nhận / trả phòng" FontSize="22" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Early check-in, late check-out, giấy tờ, thanh toán và phê duyệt theo property." Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Làm mới" Command="{Binding LoadCommand}" Style="{StaticResource B}"/><Button Content="+ Thêm quy tắc" Command="{Binding NewItemCommand}" Style="{StaticResource P}" Margin="0"/></StackPanel></Grid></Border>
  <Border Grid.Row="1" Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Từ khóa" Grid.Column="0" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" ToolTip="Tìm theo mã, tên hoặc mô tả"/><Button Grid.Row="1" Grid.Column="1" Content="Tìm" Command="{Binding SearchCommand}" Style="{StaticResource B}" Margin="8,0,0,0"/></Grid></Border>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
   <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="False"><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#F8FAFC" CornerRadius="10" ClipToBounds="True" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="Mã" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Tên" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Trạng thái" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></Border><ListBox ItemContainerStyle="{StaticResource HotelSettingsListBoxItemStyle}" HorizontalContentAlignment="Stretch" Background="Transparent" Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="#17365D"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding EffectiveFrom, StringFormat={}{0:dd/MM/yyyy}}" Foreground="#64748B" FontSize="11"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding IsActive, StringFormat='{}{0}'}" Foreground="#2563EB"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
   <Border Grid.Column="1" Margin="16,0,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16"><StackPanel><StackPanel><TextBlock Text="Chi tiết quy tắc" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="{Binding SelectedSummary}" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/><StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Mã"/><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,4,0,8"/><TextBlock Text="Tên"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,4,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,8"><TextBlock Text="Hiệu lực từ"/><DatePicker Style="{StaticResource HotelSettingsDatePickerBase}" SelectedDate="{Binding EffectiveFrom, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,8"><TextBlock Text="Hiệu lực đến"/><DatePicker Style="{StaticResource HotelSettingsDatePickerBase}" SelectedDate="{Binding EffectiveTo, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,8"><TextBlock Text="Grace early (phút)"/><TextBox Text="{Binding EarlyCheckInGraceMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,8"><TextBlock Text="Grace late (phút)"/><TextBox Text="{Binding LateCheckOutGraceMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,4,0,0"/></StackPanel></Grid><TextBlock Text="Vai trò duyệt early / late"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding EarlyCheckInApprovalRole, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,0,4,0"/><TextBox Grid.Column="1" Text="{Binding LateCheckOutApprovalRole, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="4,0,0,0"/></Grid><TextBlock Text="Charge code early / late"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding EarlyCheckInChargeCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,0,4,0"/><TextBox Grid.Column="1" Text="{Binding LateCheckOutChargeCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="4,0,0,0"/></Grid><CheckBox Content="Bắt buộc giấy tờ khách" IsChecked="{Binding RequireGuestDocument}" Margin="0,3,0,7"/><CheckBox Content="Bắt buộc xác thực thanh toán" IsChecked="{Binding RequirePaymentAuthorization}" Margin="0,0,0,10"/><TextBlock Text="Mô tả"/><TextBox Style="{StaticResource HotelSettingsTextBoxBase}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="52" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" Margin="0,4,0,10"/><StackPanel Orientation="Horizontal"><Button Content="Hủy" Command="{Binding CancelEditCommand}" Style="{StaticResource B}"/><Button Content="Lưu" Command="{Binding SaveCommand}" Style="{StaticResource P}" Margin="0"/></StackPanel></StackPanel><StackPanel Visibility="{Binding IsReadOnlyPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Trạng thái" Foreground="#64748B"/><TextBlock Text="{Binding SelectedStatus}" FontWeight="SemiBold" Foreground="#17365D" Margin="0,3,0,14"/><TextBlock Text="Quy tắc này là danh mục cấu hình độc lập; khi nối vào check-in/out, nghiệp vụ tác nghiệp vẫn giữ ở Front Office." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,16"/><StackPanel Orientation="Horizontal"><Button Content="Sửa" Command="{Binding EditItemCommand}" Style="{StaticResource P}"/><Button Content="Bật / tạm ngưng" Command="{Binding ToggleActiveCommand}" Style="{StaticResource B}" Margin="0"/></StackPanel></StackPanel><Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,14,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap"/></Border><Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0" Visibility="{Binding HasInfo, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding InfoMessage}" Foreground="#166534" TextWrapping="Wrap"/></Border></StackPanel></StackPanel></Border>
  </Grid>
 </Grid>
</UserControl>




