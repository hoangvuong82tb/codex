                                                <Border BorderBrush="#DBE7F3" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                                                    <Grid>
                                                        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <Grid Background="#EAF2FB"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><TextBlock Text="Nghiệp vụ" Margin="14,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#10213F"/><TextBlock Grid.Column="1" Text="Tài khoản mặc định" Margin="14,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#10213F"/><TextBlock Grid.Column="2" Text="Tài khoản đang dùng" Margin="14,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#10213F"/><TextBlock Grid.Column="3" Text="Trạng thái" Margin="14,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#10213F"/></Grid>
                                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding GeneralLedgerPostingMaps}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E5EEF8" BorderThickness="0,1,0,0" Padding="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding BusinessName}" Margin="14,0" VerticalAlignment="Center" Foreground="#10213F" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding DefaultAccountCode}" Margin="14,0" VerticalAlignment="Center" Foreground="#475569"/><ComboBox Grid.Column="2" Margin="14,0" ItemsSource="{Binding DataContext.LedgerAccountOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="AccountCode" SelectedValuePath="AccountCode" SelectedValue="{Binding SelectedAccountCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsFormComboBoxStyle}"/><Border Grid.Column="3" Background="#DCFCE7" CornerRadius="11" Padding="10,4" Margin="14,0" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="#16A34A" FontWeight="SemiBold" FontSize="12"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"><Button Tag="&#xE711;" Content="Hủy" Style="{StaticResource SettingsActionSecondaryButton}" Margin="0,0,10,0" Command="{Binding CancelGeneralLedgerPanelCommand}"/><Button Tag="&#xE72C;" Content="Khôi phục mặc định" Style="{StaticResource SettingsActionSecondaryButton}" Margin="0,0,10,0" Command="{Binding RestoreGeneralLedgerPostingDefaultsCommand}"/><Button Tag="&#xE74E;" Content="Lưu thiết lập" Style="{StaticResource SettingsActionOrangeButton}" Command="{Binding SaveGeneralLedgerPostingCommand}"/></StackPanel>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsLedgerPeriodPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <UniformGrid Columns="3" Margin="0,0,0,14"><Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Trạng thái kỳ" Foreground="#64748B" FontSize="12"/><TextBlock Text="{Binding LedgerCurrentPeriod}" FontSize="24" FontWeight="SemiBold" Foreground="#10213F" Margin="0,6,0,2"/><Border Background="#DCFCE7" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="{Binding LedgerPeriodStatus}" Foreground="#16A34A" FontWeight="SemiBold" FontSize="12"/></Border></StackPanel></Border><Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Thời gian" Foreground="#64748B" FontSize="12"/><TextBlock Text="{Binding LedgerPeriodFromDate}" FontSize="18" FontWeight="SemiBold" Foreground="#10213F" Margin="0,8,0,2"/><TextBlock Text="{Binding LedgerPeriodToDate, StringFormat=đến {0}}" Foreground="#64748B"/></StackPanel></Border><Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0"><StackPanel><TextBlock Text="Khóa sổ" Foreground="#64748B" FontSize="12"/><TextBlock Text="{Binding LedgerLastLockedDate}" FontSize="18" FontWeight="SemiBold" Foreground="#10213F" Margin="0,8,0,2"/><TextBlock Text="{Binding LedgerLockedBy, StringFormat=Người khóa: {0}}" Foreground="#64748B"/></StackPanel></Border></UniformGrid>
                                        <Border Style="{StaticResource SettingsSectionCardStyle}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,14"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#F97316" Margin="0,0,10,0"/><TextBlock Text="Chỉnh kỳ kế toán" FontSize="16" FontWeight="SemiBold" Foreground="#10213F"/></StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Kỳ hiện tại" Style="{StaticResource SettingsFieldLabelStyle}"/><TextBox Text="{Binding LedgerCurrentPeriod, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsFormTextBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Trạng thái" Style="{StaticResource SettingsFieldLabelStyle}"/><TextBox Text="{Binding LedgerPeriodStatus, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsFormTextBoxStyle}"/></StackPanel></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Từ ngày" Style="{StaticResource SettingsFieldLabelStyle}"/><TextBox Text="{Binding LedgerPeriodFromDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsFormTextBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Đến ngày" Style="{StaticResource SettingsFieldLabelStyle}"/><TextBox Text="{Binding LedgerPeriodToDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsFormTextBoxStyle}"/></StackPanel></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Ngày khóa sổ gần nhất" Style="{StaticResource SettingsFieldLabelStyle}"/><TextBox Text="{Binding LedgerLastLockedDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsFormTextBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Người khóa sổ" Style="{StaticResource SettingsFieldLabelStyle}"/><TextBox Text="{Binding LedgerLockedBy, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsFormTextBoxStyle}"/></StackPanel></Grid></StackPanel></Border>
                                        <WrapPanel HorizontalAlignment="Right" Margin="0,6,0,0"><Button Tag="&#xE72E;" Content="Khóa kỳ" Style="{StaticResource SettingsActionOrangeButton}" Margin="0,0,10,8" Command="{Binding LockGeneralLedgerPeriodCommand}"/><Button Tag="&#xE785;" Content="Mở khóa kỳ" Style="{StaticResource SettingsActionSecondaryButton}" Margin="0,0,10,8" Command="{Binding UnlockGeneralLedgerPeriodCommand}"/><Button Tag="&#xE710;" Content="Tạo kỳ mới" Style="{StaticResource SettingsActionSecondaryButton}" Margin="0,0,10,8" Command="{Binding CreateGeneralLedgerPeriodCommand}"/><Button Tag="&#xE76C;" Content="Chuyển kỳ sau" Style="{StaticResource SettingsActionPrimaryButton}" Margin="0,0,0,8" Command="{Binding MoveNextGeneralLedgerPeriodCommand}"/></WrapPanel>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsLedgerReportsPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Style="{StaticResource SettingsSectionCardStyle}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,14"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#2563EB" Margin="0,0,10,0"/><TextBlock Text="Mẫu báo cáo" FontSize="16" FontWeight="SemiBold" Foreground="#10213F"/></StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Mẫu sổ cái mặc định" Style="{StaticResource SettingsFieldLabelStyle}"/><TextBox Text="{Binding LedgerDefaultGeneralLedgerReport, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsFormTextBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Mẫu cân đối phát sinh" Style="{StaticResource SettingsFieldLabelStyle}"/><TextBox Text="{Binding LedgerDefaultTrialBalanceReport, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsFormTextBoxStyle}"/></StackPanel></Grid><StackPanel Margin="0,12,0,0"><TextBlock Text="Định dạng xuất mặc định" Style="{StaticResource SettingsFieldLabelStyle}"/><ComboBox Text="{Binding LedgerDefaultExportFormat, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Style="{StaticResource SettingsFormComboBoxStyle}"><ComboBoxItem Content="Excel"/><ComboBoxItem Content="PDF"/></ComboBox></StackPanel></StackPanel></Border>
                                        <Border Style="{StaticResource SettingsSectionCardStyle}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#16A34A" Margin="0,0,10,0"/><TextBlock Text="Quyền xuất/in" FontSize="16" FontWeight="SemiBold" Foreground="#10213F"/></StackPanel><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Cho phép in báo cáo" FontWeight="SemiBold" Foreground="#10213F"/><CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleSwitchStyle}" IsChecked="{Binding LedgerAllowPrintReports}"/></Grid><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Cho phép xuất Excel" FontWeight="SemiBold" Foreground="#10213F"/><CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleSwitchStyle}" IsChecked="{Binding LedgerAllowExportExcel}"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Cho phép xuất PDF" FontWeight="SemiBold" Foreground="#10213F"/><CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleSwitchStyle}" IsChecked="{Binding LedgerAllowExportPdf}"/></Grid></StackPanel></Border>
                                        <Border Style="{StaticResource SettingsSectionCardStyle}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#F97316" Margin="0,0,10,0"/><TextBlock Text="Chữ ký báo cáo" FontSize="16" FontWeight="SemiBold" Foreground="#10213F"/></StackPanel><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Hiển thị chữ ký kế toán" FontWeight="SemiBold" Foreground="#10213F"/><CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleSwitchStyle}" IsChecked="{Binding LedgerShowAccountantSignature}"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Hiển thị chữ ký giám đốc" FontWeight="SemiBold" Foreground="#10213F"/><CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleSwitchStyle}" IsChecked="{Binding LedgerShowDirectorSignature}"/></Grid></StackPanel></Border>
                                        <Border Style="{StaticResource SettingsSectionCardStyle}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#2563EB" Margin="0,0,10,0"/><TextBlock Text="Ghi chú cuối báo cáo" FontSize="16" FontWeight="SemiBold" Foreground="#10213F"/></StackPanel><TextBox Text="{Binding LedgerReportFooterNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsFormTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" Height="96" VerticalContentAlignment="Top" Padding="12"/></StackPanel></Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"><Button Tag="&#xE711;" Content="Hủy" Style="{StaticResource SettingsActionSecondaryButton}" Margin="0,0,10,0" Command="{Binding CancelGeneralLedgerPanelCommand}"/><Button Tag="&#xE74E;" Content="Lưu báo cáo" Style="{StaticResource SettingsActionOrangeButton}" Command="{Binding SaveGeneralLedgerReportsCommand}"/></StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource SettingsCardStyle}" Visibility="{Binding IsModuleSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" CornerRadius="14" Background="#EFF6FF" Margin="0,0,14,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding ModuleSettingsIconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ModuleSettingsTitle}" FontSize="22" FontWeight="SemiBold" Foreground="#10213F"/>
                                            <Border Style="{StaticResource SettingsStatusBadgeStyle}" Margin="12,2,0,0">
                                                <TextBlock Text="{Binding ModuleSettingsStatus}" Foreground="#16A34A" FontWeight="SemiBold" FontSize="12"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ModuleSettingsDescription}" Foreground="#64748B" FontSize="13" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Tag="&#xE72B;" Content="Quay lại danh sách" Style="{StaticResource SettingsActionSecondaryButton}" Margin="0,0,10,8" Command="{Binding BackToInstalledAppsCommand}"/>
                                        <Button Tag="&#xE72C;" Content="Khôi phục mặc định" Style="{StaticResource SettingsActionSecondaryButton}" Margin="0,0,10,8" Command="{Binding ResetDefaultCommand}"/>
                                        <Button Tag="&#xE74E;" Content="Lưu cấu hình" Style="{StaticResource SettingsActionOrangeButton}" Command="{Binding SaveSettingsCommand}"/>
                                    </WrapPanel>
                                </Grid>

                                <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,14" Visibility="{Binding ModuleHasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#F97316" FontSize="17" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Có thay đổi chưa lưu. Hãy lưu cấu hình hoặc khôi phục mặc định trước khi rời màn hình." Foreground="#9A3412" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>

                                <Border Background="#F8FBFF" BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ModuleSettingsSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsFormTextBoxStyle}" Height="40" VerticalContentAlignment="Center" Padding="12,0" ToolTip="Tìm kiếm cài đặt trong module"/>
                                        <TextBlock Grid.Column="1" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#64748B" Margin="-34,0,12,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding FilteredModuleSettingSections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ModuleSettingSectionViewModel}">
                                            <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#2563EB" Margin="0,0,10,0"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="#10213F"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type models:ModuleSettingItemViewModel}">
                                                                <Border BorderBrush="#E8F0FA" BorderThickness="0,1,0,0" Padding="0,11">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2.1*"/>
                                                                            <ColumnDefinition Width="18"/>
                                                                            <ColumnDefinition Width="1.4*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#10213F"/>
                                                                            <TextBlock Text="{Binding Description}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                            <TextBlock Text="{Binding DisabledReason}" Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasDisabledReason, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                            <TextBlock Text="{Binding ValidationError}" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                        </StackPanel>
                                                                        <Grid Grid.Column="2" VerticalAlignment="Center" IsEnabled="{Binding IsEnabled}">
                                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsFormTextBoxStyle}" Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsFormTextBoxStyle}" Visibility="{Binding IsNumber, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsFormComboBoxStyle}" Visibility="{Binding IsSelect, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                            <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsToggleSwitchStyle}" HorizontalAlignment="Right" Visibility="{Binding IsToggle, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12" Visibility="{Binding HasModuleValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding ModuleValidationErrors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#B91C1C" Margin="0,2" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FBFF" BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12" Visibility="{Binding IsInstalledAppsDetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Tìm kiếm ứng dụng" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                    <TextBlock Text="Dùng ô tìm kiếm phía trên để lọc theo tên hoặc mô tả ứng dụng." Foreground="#64748B" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Trạng thái" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding InstalledAppStatusFilters}" SelectedItem="{Binding InstalledAppStatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsFormComboBoxStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding CurrentDetail.Cards}">
                            <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasEditableForm}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsLedgerAccountSettingsVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsGeneralLedgerSettingsVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsModuleSettingsVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SettingCardViewModel}">
                                    <Border Margin="0,0,0,8">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Title}" Value="Ứng dụng đã cài">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource SettingsTextSecondaryBrush}" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:SettingItemViewModel}">
                                                        <Button Style="{StaticResource SettingsSettingRowButtonStyle}" HorizontalAlignment="Stretch"
                                                                IsEnabled="{Binding IsClickable}"
                                                                Click="OnSettingRowClick">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Foreground="#1E4F8F"/>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource SettingsTextPrimaryBrush}"/>
                                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource SettingsTextSecondaryBrush}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{Binding Value}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SettingsTextSecondaryBrush}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsToggle}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <CheckBox Grid.Column="2" IsChecked="{Binding ToggleValue, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                    <CheckBox.Style>
                                                                        <Style TargetType="CheckBox" BasedOn="{StaticResource SettingsToggleSwitchStyle}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsToggle}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </CheckBox.Style>
                                                                </CheckBox>
                                                                <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,0" Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Reset" Style="{StaticResource SettingsSecondaryButton}" Margin="0,0,8,0" Command="{Binding ResetEditableCommand}"/>
                                <Button Content="Cancel" Style="{StaticResource SettingsSecondaryButton}" Margin="0,0,8,0" Command="{Binding CancelEditableCommand}"/>
                                <Button Content="Save" Style="{StaticResource SettingsPrimaryButton}" Command="{Binding SaveEditableCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>





