<UserControl x:Class="ASMILE.BO.App.Views.GroupReservationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" Loaded="OnLoaded"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ScoreToBrushConverter x:Key="ScoreToBrush"/>
        <converters:RoutingToVisibilityConverter x:Key="RoutingToSplitVis"/>
        <converters:RoutingToFixedVisConverter x:Key="RoutingToFixedVis"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:StringToBrushConverter x:Key="StringToBrush"/>

        <!-- ═══ STYLES ═══ -->
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#6D28D9"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F5F3FF"/><Setter TargetName="Bd" Property="BorderBrush" Value="#C4B5FD"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7E2F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7E2F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#7B8DA6" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="8" Height="4" Stretch="Uniform"/>
                                </Grid>
                            </Border>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="7" Margin="0,2">
                                    <ScrollViewer MaxHeight="200"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ColumnHeaderHeight" Value="44"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F5F3FF"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="8,0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="PagerBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ PROGRESS BAR ═══ -->
        <Style x:Key="MiniProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#F1F5F9" CornerRadius="3" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" Background="#7C3AED" CornerRadius="2" HorizontalAlignment="Left"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Padding="22,16" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7C3AED" Offset="0"/><GradientStop Color="#5B21B6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Danh sách đoàn" FontSize="20" FontWeight="SemiBold" Foreground="#102E5A"/>
                        <Border CornerRadius="10" Padding="6,3" Margin="12,0,0,0" Background="#F5F3FF">
                            <TextBlock Text="{Binding TotalFilteredCount, StringFormat='{}{0} đoàn'}" FontSize="12" FontWeight="SemiBold" Foreground="#6D28D9"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Quản lý toàn bộ hồ sơ đoàn và điều phối nghiệp vụ." FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryBtn}"/>
                    <Button Content="Xuất Excel" Command="{Binding ExportToExcelCommand}" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ DASHBOARD KPI CARDS ═══ -->
        <Border Grid.Row="1" Padding="16,10" Background="#FAFBFD" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding DashboardKpis}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GroupDashboardKpi}">
                        <Border Width="130" Margin="0,0,8,4" Padding="12,8" CornerRadius="10"
                                Background="{Binding BgColor}" BorderBrush="{Binding Color}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{Binding Color}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="Bold" Foreground="{Binding Color}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ═══ TOOLBAR ═══ -->
        <Border Grid.Row="2" Padding="16,8" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <WrapPanel>
                <Button Content="+ Tạo đoàn" Command="{Binding OpenCreateGroupCommand}" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,4"/>
                <Button Content="Đặt phòng" Command="{Binding OpenGroupReservationCommand}" Style="{StaticResource ToolbarBtn}"/>
                <Button Content="Phân phòng" Command="{Binding RunAutoAssignmentCommand}" Style="{StaticResource ToolbarBtn}"/>
                <Button Content="Check-in" Command="{Binding OpenGroupCheckInCommand}" Style="{StaticResource ToolbarBtn}"/>
                <Button Content="Check-out" Command="{Binding OpenGroupCheckOutCommand}" Style="{StaticResource ToolbarBtn}"/>
<Button Content="Rooming List" Command="{Binding OpenRoomingListCommand}" Style="{StaticResource ToolbarBtn}"/>
                <Button Content="Master Folio" Command="{Binding OpenFolioWindowCommand}" Style="{StaticResource ToolbarBtn}"/>
                <Button Content="Đặt cọc" Command="{Binding OpenDepositWindowCommand}" Style="{StaticResource ToolbarBtn}"/>
                <Button Content="Hóa đơn" Command="{Binding OpenInvoiceWindowCommand}" Style="{StaticResource ToolbarBtn}"/>
                <Button Content="Email" Command="{Binding OpenEmailWindowCommand}" Style="{StaticResource ToolbarBtn}"/>
                <Button Content="In" Command="{Binding OpenPrintWindowCommand}" Style="{StaticResource ToolbarBtn}"/>
                <Button Content="Nhân bản" Command="{Binding DuplicateGroupCommand}" Style="{StaticResource ToolbarBtn}"/>
<Button Content="Xác nhận đoàn" Command="{Binding ConfirmGroupCommand}" Style="{StaticResource ToolbarBtn}" Foreground="#166534" BorderBrush="#BBF7D0"/>
<Button Content="Đóng đoàn" Command="{Binding CloseGroupCommand}" Style="{StaticResource ToolbarBtn}" Foreground="#DC2626" BorderBrush="#FECACA"/>
            </WrapPanel>
        </Border>

        <!-- ═══ FILTER BAR ═══ -->
        <Border Grid.Row="3" Padding="14,8" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel>
                    <StackPanel Margin="0,0,8,4" Width="200">
                        <TextBlock Text="Tìm kiếm" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,4" Width="130">
                        <TextBlock Text="Trạng thái" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{x:Static vm:GroupReservationViewModel.StatusFilters}" SelectedItem="{Binding FilterStatus}" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,4" Width="120">
                        <TextBlock Text="Market" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{x:Static vm:GroupReservationViewModel.MarketFilters}" SelectedItem="{Binding FilterMarket}" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,4" Width="120">
                        <TextBlock Text="Nguồn" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{x:Static vm:GroupReservationViewModel.SourceFilters}" SelectedItem="{Binding FilterSource}" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,4" Width="120">
                        <TextBlock Text="Loại đoàn" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{x:Static vm:GroupReservationViewModel.GroupTypeFilters}" SelectedItem="{Binding FilterGroupType}" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                    <Button x:Name="BtnMoreFilters" Content="Thêm bộ lọc ▾" Style="{StaticResource SecondaryBtn}" Height="32" FontSize="11" Margin="0,14,8,4" Padding="10,0"
                            Command="{Binding ToggleFilterCommand}"/>
                    <Button Content="Xóa lọc" Style="{StaticResource SecondaryBtn}" Height="32" FontSize="11" Margin="0,14,0,4" Padding="10,0"
                            Command="{Binding ClearFiltersCommand}"/>
                </WrapPanel>
                <WrapPanel Grid.Row="1" Visibility="{Binding IsFilterExpanded, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <StackPanel Margin="0,0,8,4" Width="120">
                        <TextBlock Text="Quốc gia" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{x:Static vm:GroupReservationViewModel.CountryFilters}" SelectedItem="{Binding FilterCountry}" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,4" Width="120">
                        <TextBlock Text="VIP" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{x:Static vm:GroupReservationViewModel.VipFilters}" SelectedItem="{Binding FilterVip}" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,4" Width="130">
                        <TextBlock Text="Thanh toán" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{x:Static vm:GroupReservationViewModel.PaymentFilters}" SelectedItem="{Binding FilterPayment}" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: DataGrid -->
            <Border Grid.Column="0" Margin="12,10,6,10" Style="{StaticResource PanelCard}" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <!-- INFO BANNER -->
                    <Border x:Name="InfoBanner" Background="#F0FDF4" CornerRadius="0" Padding="10,6"
                            Visibility="{Binding InfoMessage, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="{Binding InfoMessage}" FontSize="12" Foreground="#16A34A"/>
                    </Border>

                    <!-- DATA GRID -->
                    <DataGrid x:Name="GroupGrid" Grid.Row="0" Style="{StaticResource ModDataGrid}"
                              ItemsSource="{Binding FilteredGroups}"
                              SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                              SelectionChanged="OnGroupSelectionChanged"
                              MouseDoubleClick="OnGroupDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu FontFamily="Segoe UI" FontSize="12">
                                <MenuItem Header="Mở Group Workspace" Command="{Binding SelectGroupCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Đặt phòng đoàn" Command="{Binding OpenGroupReservationCommand}"/>
                                <MenuItem Header="Phân phòng" Command="{Binding RunAutoAssignmentCommand}"/>
<MenuItem Header="Rooming List" Command="{Binding OpenRoomingListCommand}"/>
                                <MenuItem Header="Danh sách khách" Command="{Binding OpenGuestListCommand}"/>
                                <Separator/>
                                <MenuItem Header="Check-in đoàn" Command="{Binding OpenGroupCheckInCommand}"/>
                                <MenuItem Header="Check-out đoàn" Command="{Binding OpenGroupCheckOutCommand}"/>
                                <Separator/>
                                <MenuItem Header="Master Folio" Command="{Binding OpenFolioWindowCommand}"/>
                                <MenuItem Header="Đặt cọc" Command="{Binding OpenDepositWindowCommand}"/>
                                <MenuItem Header="Hóa đơn" Command="{Binding OpenInvoiceWindowCommand}"/>
                                <Separator/>
                                <MenuItem Header="Đóng đoàn" Command="{Binding CloseGroupCommand}"/>
                                <MenuItem Header="Nhân bản" Command="{Binding DuplicateGroupCommand}"/>
                                <MenuItem Header="Xóa đoàn nháp" Command="{Binding DeleteDraftGroupCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <!-- Row number -->
                            <DataGridTextColumn Header="#" Width="40" Binding="{Binding GroupCode}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#94A3B8"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Mã đoàn + Tên -->
                            <DataGridTemplateColumn Header="Mã đoàn / Tên đoàn" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:GroupListDto}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,4">
                                            <TextBlock Text="{Binding GroupCode}" FontSize="12" FontWeight="SemiBold" Foreground="#17365D"/>
                                            <TextBlock Text="{Binding GroupName}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Leader -->
                            <DataGridTextColumn Header="Trưởng đoàn" Width="120" Binding="{Binding LeaderName}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Company / Agent -->
                            <DataGridTemplateColumn Header="Công ty / Đại lý" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:GroupListDto}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,4">
                                            <TextBlock Text="{Binding CompanyName}" FontSize="12" Foreground="#17365D" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding AgencyName}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Arrival / Departure -->
                            <DataGridTemplateColumn Header="Đến / Đi" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:GroupListDto}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="12" Foreground="#17365D">
                                                <Run Text="{Binding ArrivalDate, StringFormat='{}{0:dd/MM}'}"/><Run Text=" → "/><Run Text="{Binding DepartureDate, StringFormat='{}{0:dd/MM}'}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Nights, StringFormat='{}{0} đêm'}" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Rooms -->
                            <DataGridTemplateColumn Header="Phòng" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:GroupListDto}">
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ConfirmedRooms}" FontSize="13" FontWeight="SemiBold" Foreground="#17365D"/>
                                                <TextBlock Text=" / " FontSize="11" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding ExpectedRooms}" FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Style="{StaticResource MiniProgressBar}" Width="80" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Guests -->
                            <DataGridTextColumn Header="Khách" Width="65" Binding="{Binding TotalGuests}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Market -->
                            <DataGridTextColumn Header="Market" Width="90" Binding="{Binding Market}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Source -->
                            <DataGridTextColumn Header="Nguồn" Width="90" Binding="{Binding Source}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Revenue -->
                            <DataGridTextColumn Header="Doanh thu" Width="120" Binding="{Binding TotalRevenue, StringFormat='{}{0:N0} đ'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#17365D"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Balance / Deposit -->
                            <DataGridTemplateColumn Header="Còn lại" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:GroupListDto}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OutstandingBalance, StringFormat='{}{0:N0} đ'}" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626"/>
                                            <TextBlock Text="{Binding TotalDeposit, StringFormat='Đã cọc {0:N0}'}" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status -->
                            <DataGridTemplateColumn Header="Trạng thái" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:GroupListDto}">
                                        <Border Style="{StaticResource StatusBadge}"
                                                Background="{Binding StatusColor, Converter={StaticResource StringToBrush}}" Opacity="0.12"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Warning badges -->
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:GroupListDto}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="4" Padding="3,2" Margin="0,0,2,0"
                                                    Background="#FEF2F2" Visibility="{Binding HasDepositIssue, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="💰" FontSize="10" ToolTip="Thiếu đặt cọc"/>
                                            </Border>
                                            <Border CornerRadius="4" Padding="3,2" Margin="0,0,2,0"
                                                    Background="#FFF7ED" Visibility="{Binding HasRoomingPending, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="🏠" FontSize="10" ToolTip="Chưa hoàn tất phân phòng"/>
                                            </Border>
                                            <Border CornerRadius="4" Padding="3,2"
                                                    Background="#FEF2F2" Visibility="{Binding HasBalanceIssue, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="⚠" FontSize="10" ToolTip="Còn công nợ"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <!-- Row style with color -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Draft">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="No Show">
                                        <Setter Property="Background" Value="#FFFBEB"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Closed">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- Loading overlay -->
                    <Border Grid.Row="0" Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Đang tải dữ liệu..." Foreground="#64748B" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: Preview Panel -->
            <Border Grid.Column="1" Width="420" Margin="6,10,12,10" Style="{StaticResource PanelCard}"
                    Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <Border Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedGroup.GroupName}" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedGroup.GroupCode}" FontSize="12" Foreground="#7C3AED" FontWeight="SemiBold"/>
                                    <TextBlock Text=" · " FontSize="12" Foreground="#CBD5E1"/>
                                    <TextBlock Text="{Binding SelectedGroup.CompanyName}" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Width="32" Height="32" Command="{Binding CloseDetailCommand}"
                                    Style="{StaticResource SecondaryBtn}" FontSize="14" Padding="0"/>
                        </Grid>
                    </Border>

                    <!-- Preview Tabs -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,10,14,0">
                        <Button x:Name="TabOverview" Content="Tổng quan" Width="80" Style="{StaticResource ToolbarBtn}" Height="30" FontSize="11" Padding="6,0"
                                Click="OnTabClick" Tag="0" Margin="0,0,2,0"/>
                        <Button x:Name="TabRooms" Content="Phòng" Width="70" Style="{StaticResource ToolbarBtn}" Height="30" FontSize="11" Padding="6,0"
                                Click="OnTabClick" Tag="1" Margin="0,0,2,0"/>
                        <Button x:Name="TabGuests" Content="Khách" Width="70" Style="{StaticResource ToolbarBtn}" Height="30" FontSize="11" Padding="6,0"
                                Click="OnTabClick" Tag="2" Margin="0,0,2,0"/>
                        <Button x:Name="TabFinance" Content="Tài chính" Width="80" Style="{StaticResource ToolbarBtn}" Height="30" FontSize="11" Padding="6,0"
                                Click="OnTabClick" Tag="3" Margin="0,0,2,0"/>
                        <Button x:Name="TabNotes" Content="Ghi chú" Width="75" Style="{StaticResource ToolbarBtn}" Height="30" FontSize="11" Padding="6,0"
                                Click="OnTabClick" Tag="4"/>
                    </StackPanel>

                    <!-- Preview Content -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="14,8,14,14">
                        <StackPanel>
                            <!-- TAB 0: Overview -->
                            <StackPanel x:Name="PreviewTab0" Visibility="Visible">
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Thông tin đoàn" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Trưởng đoàn:" Width="90" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.LeaderName}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Loại đoàn:" Width="90" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.GroupType}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Quốc gia:" Width="90" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.Country}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="VIP:" Width="90" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.VipLevel}" FontSize="11" Foreground="#7C3AED" FontWeight="SemiBold"/></StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Lưu trú" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Ngày đến:" Width="90" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.ArrivalDate, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Ngày đi:" Width="90" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.DepartureDate, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Số đêm:" Width="90" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.Nights, StringFormat='{}{0} đêm'}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Quy mô" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Phòng:" Width="90" FontSize="11" Foreground="#94A3B8"/><TextBlock FontSize="11" Foreground="#17365D"><Run Text="{Binding SelectedGroup.ConfirmedRooms}"/><Run Text=" / "/><Run Text="{Binding SelectedGroup.ExpectedRooms}"/></TextBlock></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Khách:" Width="90" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.TotalGuests}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Tiến độ:" Width="90" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.ProgressPercent, StringFormat='{}{0}%'}" FontSize="11" Foreground="#7C3AED" FontWeight="SemiBold"/></StackPanel>
                                        <ProgressBar Value="{Binding SelectedGroup.ProgressPercent, Mode=OneWay}" Style="{StaticResource MiniProgressBar}" Width="280" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Kinh doanh" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Market:" Width="90" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.Market}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Nguồn:" Width="90" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.Source}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Sales:" Width="90" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.SalesPerson}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- TAB 1: Room Summary -->
                            <StackPanel x:Name="PreviewTab1" Visibility="Collapsed">
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <WrapPanel>
                                        <Border Width="110" Background="White" CornerRadius="8" Padding="10,8" Margin="0,0,6,4">
                                            <StackPanel><TextBlock Text="Tổng phòng" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.ExpectedRooms}" FontSize="18" FontWeight="Bold" Foreground="#17365D"/></StackPanel>
                                        </Border>
                                        <Border Width="110" Background="#F0FDF4" CornerRadius="8" Padding="10,8" Margin="0,0,6,4">
                                            <StackPanel><TextBlock Text="Đã phân" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.ConfirmedRooms}" FontSize="18" FontWeight="Bold" Foreground="#16A34A"/></StackPanel>
                                        </Border>
                                        <Border Width="110" Background="#FFF7ED" CornerRadius="8" Padding="10,8" Margin="0,0,6,4">
                                            <StackPanel><TextBlock Text="Chưa phân" FontSize="10" Foreground="#94A3B8"/><TextBlock FontSize="18" FontWeight="Bold" Foreground="#D97706"><Run Text="{Binding SelectedGroup.ExpectedRooms}"/></TextBlock></StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </Border>
                                <TextBlock Text="Danh sách phòng" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,8,0,6"/>
                                <ItemsControl ItemsSource="{Binding SelectedGroup.RoomingList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GroupRoomDto}">
                                            <Border Padding="10,6" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding RoomNumber}" FontWeight="SemiBold" FontSize="12"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding GuestName}" FontSize="11" Foreground="#334155"/>
                                                        <TextBlock Text="{Binding RoomType}" FontSize="10" Foreground="#94A3B8"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" CornerRadius="6" Padding="6,2" Background="#2563EB" Opacity="0.12">
                                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="10" Foreground="#2563EB" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- TAB 2: Guest Summary -->
                            <StackPanel x:Name="PreviewTab2" Visibility="Collapsed">
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <WrapPanel>
                                        <Border Width="110" Background="White" CornerRadius="8" Padding="10,8" Margin="0,0,6,4">
                                            <StackPanel><TextBlock Text="Tổng khách" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.TotalGuests}" FontSize="18" FontWeight="Bold" Foreground="#17365D"/></StackPanel>
                                        </Border>
                                        <Border Width="110" Background="#F0FDF4" CornerRadius="8" Padding="10,8" Margin="0,0,6,4">
                                            <StackPanel><TextBlock Text="Đã check-in" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.CheckedInGuests}" FontSize="18" FontWeight="Bold" Foreground="#16A34A"/></StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </Border>
                                <ProgressBar Value="{Binding SelectedGroup.GuestProgressPercent, Mode=OneWay}" Style="{StaticResource MiniProgressBar}" Width="360" Margin="0,4,0,8"/>
                                <TextBlock Text="Danh sách khách" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,4,0,6"/>
                                <ItemsControl ItemsSource="{Binding SelectedGroup.RoomingList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GroupRoomDto}">
                                            <Border Padding="10,6" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding GuestName}" FontSize="12" FontWeight="SemiBold" Foreground="#17365D"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding RoomNumber}" FontSize="10" Foreground="#94A3B8" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Adults, StringFormat='{}{0} NL'}" FontSize="10" Foreground="#94A3B8" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Children, StringFormat='{}{0} TE'}" FontSize="10" Foreground="#94A3B8"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="6" Padding="4,2" Background="#F2994A" Opacity="0.15"
                                                            Visibility="{Binding IsVip, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="VIP" FontSize="10" Foreground="#EA580C" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- TAB 3: Financial -->
                            <StackPanel x:Name="PreviewTab3" Visibility="Collapsed">
                                <Border Background="#F5F3FF" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Doanh thu" FontSize="11" Foreground="#7C3AED"/>
                                        <TextBlock Text="{Binding SelectedGroup.TotalRevenue, StringFormat='{}{0:N0} VND'}" FontSize="20" FontWeight="Bold" Foreground="#6D28D9"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Chi tiết tài chính" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Đã đặt cọc:" Width="110" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.TotalDeposit, StringFormat='{}{0:N0} VND'}" FontSize="11" FontWeight="SemiBold" Foreground="#16A34A"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Cần đặt cọc:" Width="110" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.DepositRequired, StringFormat='{}{0:N0} VND'}" FontSize="11" Foreground="#EA580C"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Còn lại:" Width="110" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.OutstandingBalance, StringFormat='{}{0:N0} VND'}" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626"/></StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Phân bổ thanh toán" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Công ty:" Width="110" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.CompanyPayAmount, StringFormat='{}{0:N0}'}" FontSize="11" Foreground="#2563EB"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Khách:" Width="110" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.GuestPayAmount, StringFormat='{}{0:N0}'}" FontSize="11" Foreground="#EA580C"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Hình thức:" Width="110" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedGroup.PaymentMethod}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F0FDF4" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Cấu hình billing" FontSize="12" FontWeight="SemiBold" Foreground="#166534" Margin="0,0,0,6"/>
                                        <TextBlock Text="Tỷ lệ này được lưu vào dữ liệu đoàn thật." FontSize="10" Foreground="#64748B" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Công ty %" Width="62" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <TextBox Width="58" Style="{StaticResource FilterTextBox}" Text="{Binding CompanyPayPct, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Khách %" Width="55" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <TextBox Width="58" Style="{StaticResource FilterTextBox}" Text="{Binding GuestPayPct, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                            <Button Content="Lưu billing" Command="{Binding ApplyCompanyBillingCommand}" Style="{StaticResource PrimaryBtn}" Height="32" Padding="10,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedGroup.Routing, StringFormat='Định tuyến hiện tại: {0}'}" FontSize="10" Foreground="#166534" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#EFF6FF" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Master Folio" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding SelectedGroup.MasterFolioCode}" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SelectedGroup.MasterFolioBalance, StringFormat='{}{0:N0} VND'}" FontSize="18" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- TAB 4: Notes -->
                            <StackPanel x:Name="PreviewTab4" Visibility="Collapsed">
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Ghi chú chung" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedGroup.Notes}" FontSize="11" Foreground="#334155" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF7ED" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Ghi chú nội bộ" FontSize="12" FontWeight="SemiBold" Foreground="#D97706" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedGroup.InternalNotes}" FontSize="11" Foreground="#334155" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#EFF6FF" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Ghi chú Lễ tân" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedGroup.FoNotes}" FontSize="11" Foreground="#334155" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F0FDF4" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Ghi chú Nhà buồng" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedGroup.HkNotes}" FontSize="11" Foreground="#334155" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F5F3FF" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Ghi chú Kinh doanh" FontSize="12" FontWeight="SemiBold" Foreground="#7C3AED" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedGroup.SalesNotes}" FontSize="11" Foreground="#334155" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Empty detail state -->
            <Border Grid.Column="1" Width="420" Margin="6,10,12,10" Style="{StaticResource PanelCard}"
                    Visibility="{Binding IsDetailClosed, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                    <TextBlock Text="Chọn một đoàn" FontSize="16" FontWeight="SemiBold" Foreground="#52657D" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="để xem chi tiết và điều phối nghiệp vụ." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ FIXED FOOTER ═══ -->
        <Border Grid.Row="5" Padding="16,10" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageDisplay}" FontSize="12" Foreground="#64748B"/>
                    <Border CornerRadius="6" Padding="6,3" Margin="12,0,0,0" Background="#F5F3FF">
                        <TextBlock FontSize="11" Foreground="#7C3AED" FontWeight="SemiBold">
                            <Run Text="Tổng: "/><Run Text="{Binding TotalFilteredCount, Mode=OneWay}"/><Run Text=" đoàn · "/><Run Text="{Binding TotalRooms, Mode=OneWay}"/><Run Text=" phòng · "/><Run Text="{Binding TotalGuests, Mode=OneWay}"/><Run Text=" khách"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="‹" Command="{Binding PrevPageCommand}" Style="{StaticResource PagerBtn}" IsEnabled="{Binding HasPrevPage}"/>
                        <ItemsControl ItemsSource="{Binding PageButtons}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}"
                                            Command="{Binding DataContext.SetPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding PageNumber}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PagerBtn}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="#2F6BFF"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#2F6BFF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="›" Command="{Binding NextPageCommand}" Style="{StaticResource PagerBtn}" IsEnabled="{Binding HasNextPage}"/>
                        <ComboBox ItemsSource="{x:Static vm:GroupReservationViewModel.PageSizeOptions}"
                                  SelectedItem="{Binding PageSize, Mode=TwoWay}"
                                  Style="{StaticResource FilterCombo}" Width="122" Margin="8,0,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding StringFormat={}{0} dòng / trang}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
