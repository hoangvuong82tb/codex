<UserControl x:Class="ASMILE.BO.App.Views.StartMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:model="clr-namespace:ASMILE.BO.App.Models"
             xmlns:controls="clr-namespace:ASMILE.BO.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="700">
    <Border Width="700"
            Height="640"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,16"
            Style="{StaticResource StartMenuCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0"
                     Style="{StaticResource StartSearchBoxStyle}"
                     Text="{Binding StartSearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Tìm kiếm ứng dụng" />

            <DockPanel Grid.Row="1" Margin="2,16,2,12" LastChildFill="False">
                <TextBlock Text="D? ghim" Style="{StaticResource StartSectionHeaderTextStyle}" DockPanel.Dock="Left" />
                <Button Content="Tất cả ứng dụng"
                        Style="{StaticResource StartAllAppsButtonStyle}"
                        DockPanel.Dock="Right"
                        Command="{Binding QuickActionCommand}"
                        CommandParameter="all-apps" />
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="220" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" ItemsSource="{Binding StartFilteredPinnedModules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type model:AppModuleInfo}">
                            <controls:StartPinnedAppTileControl Module="{Binding}"
                                                                OpenCommand="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#36FFFFFF"
                            BorderBrush="#A8C5DF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Đề xuất"
                                       Style="{StaticResource StartSectionHeaderTextStyle}"
                                       FontSize="13.5" />

                            <ScrollViewer Grid.Row="1"
                                          Margin="0,10,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding RecommendedItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type model:StartRecommendedItem}">
                                            <controls:RecommendedItemControl Item="{Binding}"
                                                                             OpenCommand="{Binding DataContext.OpenRecommendedItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#2DFFFFFF"
                            BorderBrush="#9EBFDB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Tất cả ứng dụng"
                                       Style="{StaticResource StartSectionHeaderTextStyle}"
                                       FontSize="13.5" />

                            <ScrollViewer Grid.Row="1"
                                          Margin="0,10,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding StartFilteredAllModules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type model:AppModuleInfo}">
                                            <Button Style="{StaticResource RecommendedItemButtonStyle}"
                                                    HorizontalContentAlignment="Stretch"
                                                    AutomationProperties.Name="{Binding Title}"
                                                    AutomationProperties.AutomationId="{Binding Key}"
                                                    Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding IconImage}"
                                                           Width="19"
                                                           Height="19"
                                                           Stretch="Uniform"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="12.2" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.8" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource StartMenuFooterStyle}" Margin="-18,12,-18,-12">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Width="30"
                                Height="30"
                                CornerRadius="15"
                                Background="#26FFFFFF"
                                BorderBrush="#56FFFFFF"
                                BorderThickness="1">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#2A4567"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Administrator" FontSize="12.4" FontWeight="SemiBold" />
                            <TextBlock Text="Quản trị hệ thống" FontSize="10.8" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Style="{StaticResource PowerButtonStyle}"
                            DockPanel.Dock="Right"
                            Command="{Binding QuickActionCommand}"
                            CommandParameter="logout"
                            ToolTip="Đăng xuất">
                        <TextBlock Text="&#xE7E8;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="#2A4567" />
                    </Button>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
