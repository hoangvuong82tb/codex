<UserControl x:Class="ASMILE.BO.App.Views.ArLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" Loaded="OnLoaded"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InvBoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:StringToBrushConverter x:Key="StringToBrush"/>

        <!-- ═══ COLORS ═══ -->
        <SolidColorBrush x:Key="OpenColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="PartiallyPaidColor" Color="#2563EB"/>
        <SolidColorBrush x:Key="PaidColor" Color="#16A34A"/>
        <SolidColorBrush x:Key="OverdueColor" Color="#DC2626"/>
        <SolidColorBrush x:Key="ClosedColor" Color="#64748B"/>
        <SolidColorBrush x:Key="DisputedColor" Color="#7C3AED"/>

        <!-- ═══ INLINE STYLES ═══ -->
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#16A34A"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#15803D"/></Trigger></Style.Triggers>
        </Style>

        <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#D97706"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B45309"/></Trigger></Style.Triggers>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B91C1C"/></Trigger></Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ViewModeBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="54"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="FilterTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7E2F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource FluentComboBox}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,0,30,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
        </Style>

        <Style x:Key="ModDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#EFF6FF"/>
                        <Setter Property="Foreground" Value="#1E40AF"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="6,0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InspectorTabBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PagerBtn" TargetType="Button" BasedOn="{StaticResource FluentPaginationButton}">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <Style x:Key="PagerPageBtn" TargetType="Button" BasedOn="{StaticResource FluentPaginationButton}">
            <Setter Property="Content" Value="{Binding Label}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="#2563EB"/><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                    <Setter Property="Width" Value="24"/><Setter Property="MinWidth" Value="24"/><Setter Property="MaxWidth" Value="24"/>
                    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SlidingDetailPanel" TargetType="Border" BasedOn="{StaticResource PanelCard}">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="1,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><TranslateTransform X="0"/></Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ KPI CARD TEMPLATE ═══ -->
        <DataTemplate x:Key="KpiCardTemplate" DataType="{x:Type vm:ArKpi}">
            <Border Background="{Binding BgColor, Converter={StaticResource StringToBrush}}" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,5" Width="120" Margin="0,0,6,4" Cursor="Hand" MouseLeftButtonDown="OnKpiClick" Tag="{Binding}">
                <StackPanel>
                    <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="Bold" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" FontFamily="Segoe UI"/>
                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══ TREE ITEM TEMPLATE ═══ -->
        <DataTemplate x:Key="TreeItemTemplate" DataType="{x:Type vm:ArTreeItem}">
            <Border x:Name="TreeBorder" Padding="12,8" CornerRadius="8" Cursor="Hand" Margin="0,1" MouseLeftButtonDown="OnTreeItemClick" Tag="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Column="1" CornerRadius="10" Padding="6,1" MinWidth="24" HorizontalAlignment="Right">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" FontFamily="Segoe UI">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="TreeBorder" Property="Background" Value="#EFF6FF"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══ STATUS PILL ═══ -->
        <DataTemplate x:Key="StatusPillTemplate">
            <Border CornerRadius="10" Padding="8,2" Background="{Binding StatusBg, Converter={StaticResource StringToBrush}}">
                <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" FontFamily="Segoe UI"/>
            </Border>
        </DataTemplate>

        <!-- ═══ AR TYPE BADGE ═══ -->
        <DataTemplate x:Key="ArTypeBadgeTemplate">
            <Border CornerRadius="8" Padding="6,1" Background="{Binding ArTypeBg, Converter={StaticResource StringToBrush}}">
                <TextBlock Text="{Binding ArTypeBadge}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding ArTypeColor, Converter={StaticResource StringToBrush}}" FontFamily="Segoe UI"/>
            </Border>
        </DataTemplate>

        <!-- ═══ CARD VIEW ITEM ═══ -->
        <DataTemplate x:Key="CardViewTemplate" DataType="{x:Type vm:ArLedgerItemDto}">
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,8,8" Width="280" Cursor="Hand" MouseLeftButtonDown="OnItemCardClick" Tag="{Binding}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CompanyName}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ArNo}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="10" Padding="8,2" Background="{Binding StatusBg, Converter={StaticResource StringToBrush}}">
                            <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" FontFamily="Segoe UI"/>
                        </Border>
                    </Grid>
                    <Separator Margin="0,10" Background="#F1F5F9"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Còn nợ" FontSize="10" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                            <TextBlock Text="{Binding Outstanding, StringFormat='{}{0:N0} ₫'}" FontSize="14" FontWeight="Bold" Foreground="#DC2626" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Đã thu" FontSize="10" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                            <TextBlock Text="{Binding Paid, StringFormat='{}{0:N0} ₫'}" FontSize="14" FontWeight="Bold" Foreground="#16A34A" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Grid>
                    <Separator Margin="0,8" Background="#F1F5F9"/>
                    <StackPanel>
                        <TextBlock FontSize="11" FontFamily="Segoe UI" Foreground="#64748B">
                            <Run Text="Hạn: "/><Run Text="{Binding DueDate, StringFormat='{}{0:dd/MM/yyyy}'}" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ArTypeBadgeTemplate}"/>
                            <TextBlock Text="{Binding Currency}" FontSize="10" Foreground="#94A3B8" Margin="6,0,0,0" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- MAIN LAYOUT                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0: HEADER ═══ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="12" Background="#2CC7D8" Margin="0,0,14,0">
                            <TextBlock Text="AR" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Công nợ — Accounts Receivable Ledger Center" FontSize="21" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                            <TextBlock Text="Quản lý toàn bộ công nợ doanh nghiệp, đại lý, OTA — Reservation → Check-out → Folio → Invoice → Payment → Accounting" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Export Excel" Style="{StaticResource ToolbarBtn}" Command="{Binding ExportExcelCommand}" ToolTip="Xuất Excel"/>
                    <Button Content="Export PDF" Style="{StaticResource ToolbarBtn}" Command="{Binding ExportPdfCommand}" ToolTip="Xuất PDF"/>
                    <Button Content="Làm mới" Style="{StaticResource SecondaryBtn}" Command="{Binding RefreshCommand}" ToolTip="Làm mới dữ liệu"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ ROW 1: DASHBOARD KPI ═══ -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="16,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DashboardKpis}" ItemTemplate="{StaticResource KpiCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ═══ ROW 2: TOOLBAR ═══ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <WrapPanel>
                    <Button Content="Thu tiền" Style="{StaticResource SuccessBtn}" Command="{Binding OpenPaymentFormCommand}" Margin="0,0,6,4" ToolTip="Thu tiền từ công nợ"/>
                    <Button Content="Đối chiếu" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,4" ToolTip="Đối chiếu công nợ"/>
                    <Button Content="Xuất hóa đơn" Style="{StaticResource ToolbarBtn}" ToolTip="Xuất hóa đơn"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>
                    <Button Content="In Statement" Style="{StaticResource ToolbarBtn}" Command="{Binding PrintStatementCommand}" ToolTip="In sao kê công nợ"/>
                    <Button Content="Gửi Email" Style="{StaticResource ToolbarBtn}" Command="{Binding OpenEmailFormCommand}" ToolTip="Gửi email sao kê/hóa đơn/nhắc nợ"/>
                    <Button Content="Khóa công nợ" Style="{StaticResource WarningBtn}" Command="{Binding CloseArCommand}" Margin="0,0,6,4" ToolTip="Khóa công nợ đã thanh toán"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>
                    <Button Content="Ghi chú" Style="{StaticResource ToolbarBtn}" Command="{Binding OpenNoteFormCommand}" ToolTip="Thêm ghi chú"/>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Bảng" Command="{Binding SetGridViewCommand}" ToolTip="Xem dạng bảng">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ViewModeBtn}">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGridView}" Value="True"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#2563EB"/><Setter Property="BorderBrush" Value="#93C5FD"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Thẻ" Command="{Binding SetCardViewCommand}" ToolTip="Xem dạng thẻ">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ViewModeBtn}">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCardView}" Value="True"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#2563EB"/><Setter Property="BorderBrush" Value="#93C5FD"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ ROW 3: FILTER BAR ═══ -->
        <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="16,8">
            <WrapPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="160" Margin="0,0,6,4" ToolTip="Tìm: AR, Invoice, Company, Guest, Phone, Tax Code, Email, Reservation, Folio"/>
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" Style="{StaticResource FilterCombo}" Width="110" Margin="0,0,6,4" ToolTip="Lọc theo trạng thái"/>
                <ComboBox ItemsSource="{Binding ArTypeFilters}" SelectedItem="{Binding FilterArType}" Style="{StaticResource FilterCombo}" Width="110" Margin="0,0,6,4" ToolTip="Lọc theo loại AR"/>
                <ComboBox ItemsSource="{Binding OverdueFilters}" SelectedItem="{Binding FilterOverdue}" Style="{StaticResource FilterCombo}" Width="100" Margin="0,0,6,4" ToolTip="Lọc theo quá hạn"/>
                <ComboBox ItemsSource="{Binding CurrencyFilters}" SelectedItem="{Binding FilterCurrency}" Style="{StaticResource FilterCombo}" Width="80" Margin="0,0,6,4" ToolTip="Lọc theo tiền tệ"/>
                <ComboBox ItemsSource="{Binding MarketFilters}" SelectedItem="{Binding FilterMarket}" Style="{StaticResource FilterCombo}" Width="100" Margin="0,0,6,4" ToolTip="Lọc theo thị trường"/>
                <ComboBox ItemsSource="{Binding SourceFilters}" SelectedItem="{Binding FilterSource}" Style="{StaticResource FilterCombo}" Width="100" Margin="0,0,6,4" ToolTip="Lọc theo nguồn"/>
                <ComboBox ItemsSource="{Binding SalesmanFilters}" SelectedItem="{Binding FilterSalesman}" Style="{StaticResource FilterCombo}" Width="120" Margin="0,0,6,4" ToolTip="Lọc theo Sales"/>
                <Button Content="Xóa lọc" Style="{StaticResource SecondaryBtn}" Command="{Binding ClearFiltersCommand}" Height="32" FontSize="11" ToolTip="Xóa tất cả bộ lọc"/>
            </WrapPanel>
        </Border>

        <!-- ═══ ROW 4: MAIN CONTENT (3-COLUMN) ═══ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: TREEVIEW -->
            <Border Grid.Column="0" Margin="10,8,4,8" Style="{StaticResource PanelCard}" Padding="0">
                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TreeItems}" ItemTemplate="{StaticResource TreeItemTemplate}" Margin="6,4"/>
                </ScrollViewer>
            </Border>

            <!-- CENTER PANEL: DATAGRID / CARD VIEW -->
            <Border Grid.Column="1" Margin="4,8,6,8" Style="{StaticResource PanelCard}" Padding="0">
                <Grid Background="White">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <!-- INFO BANNER -->
                <Border Background="#EFF6FF" CornerRadius="8" Padding="10,6" Margin="10,8,10,0" Visibility="{Binding InfoMessage, Converter={StaticResource StringToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding InfoMessage}" FontSize="12" Foreground="#1E40AF" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        <Button Grid.Column="1" Content="×" Background="Transparent" BorderThickness="0" Foreground="#1E40AF" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI" Cursor="Hand" Width="28" Height="28" Padding="0" Click="OnDismissInfo"/>
                    </Grid>
                </Border>

                <!-- ERROR BANNER -->
                <Border Background="#FEF2F2" CornerRadius="8" Padding="10,6" Margin="10,8,10,0" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#DC2626" FontFamily="Segoe UI"/>
                </Border>

                <!-- DATA GRID VIEW -->
                <ScrollViewer Grid.Row="0" Margin="10,8,10,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                    <DataGrid ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource ModDataGrid}" MouseDoubleClick="OnDataGridDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Xem Invoice" Command="{Binding SelectItemCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
                                <MenuItem Header="Thu tiền" Command="{Binding OpenPaymentFormCommand}"/>
                                <MenuItem Header="Xuất hóa đơn"/>
                                <MenuItem Header="Gửi Email" Command="{Binding OpenEmailFormCommand}"/>
                                <MenuItem Header="In Statement" Command="{Binding PrintStatementCommand}"/>
                                <Separator/>
                                <MenuItem Header="Lịch sử" Command="{Binding OpenDetailCommand}"/>
                                <MenuItem Header="Documents"/>
                                <MenuItem Header="Khóa công nợ" Command="{Binding CloseArCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AR No" Binding="{Binding ArNo}" Width="90"/>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNo}" Width="90"/>
                            <DataGridTextColumn Header="Doanh nghiệp" Binding="{Binding CompanyName}" Width="180"/>
                            <DataGridTemplateColumn Header="Loại" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ArTypeBadgeTemplate}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Khách" Binding="{Binding GuestName}" Width="120"/>
                            <DataGridTextColumn Header="Reservation" Binding="{Binding ReservationNo}" Width="100"/>
                            <DataGridTextColumn Header="Folio" Binding="{Binding FolioNo}" Width="80"/>
                            <DataGridTextColumn Header="Ngày phát sinh" Binding="{Binding IssueDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="100"/>
                            <DataGridTextColumn Header="Ngày đến hạn" Binding="{Binding DueDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="100"/>
                            <DataGridTemplateColumn Header="Còn nợ" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Outstanding, StringFormat='{}{0:N0} ₫'}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Outstanding}" Value="0"><Setter Property="Foreground" Value="#16A34A"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Đã thu" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Paid, StringFormat='{}{0:N0} ₫'}" FontFamily="Segoe UI" FontSize="12" Foreground="#16A34A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='{}{0:N0} ₫'}" Width="120"/>
                            <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="60"/>
                            <DataGridTemplateColumn Header="Credit Limit" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CreditLimit, StringFormat='{}{0:N0} ₫'}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#475569"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCreditLimitExceeded}" Value="True"><Setter Property="Foreground" Value="#DC2626"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Quá hạn" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OverdueDays, StringFormat='{}{0} ngày'}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#DC2626"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Trạng thái" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" Background="{Binding StatusBg, Converter={StaticResource StringToBrush}}">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" FontFamily="Segoe UI"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>

                <!-- CARD VIEW -->
                <ScrollViewer Grid.Row="0" Margin="10,8,10,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCardView, Converter={StaticResource BoolToVis}}">
                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding FilteredItems}" ItemTemplate="{StaticResource CardViewTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </WrapPanel>
                </ScrollViewer>

                <!-- LOADING OVERLAY -->
                <Border Grid.Row="0" Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Đang tải..." FontSize="16" Foreground="#64748B" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: INSPECTOR -->
            <Border Grid.Column="2" Width="380" Margin="6,8,10,8" Style="{StaticResource SlidingDetailPanel}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <!-- Inspector Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedItem.CompanyName}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <ContentPresenter Content="{Binding SelectedItem}" ContentTemplate="{StaticResource StatusPillTemplate}"/>
                                    <TextBlock Text="{Binding SelectedItem.Outstanding, StringFormat=' — Còn nợ: {0:N0} ₫'}" FontSize="11" Foreground="#64748B" Margin="6,0,0,0" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="×" Style="{StaticResource SecondaryBtn}" Width="30" Height="30" Padding="0" FontSize="16" FontWeight="SemiBold" Command="{Binding CloseDetailCommand}" ToolTip="Đóng"/>
                        </Grid>
                    </Border>

                    <!-- Tab Row -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Tổng quan" Click="OnDetailTabClick" Tag="0" Margin="0,0,2,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource InspectorTabBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDetailTab}" Value="0"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Invoices" Click="OnDetailTabClick" Tag="1" Margin="0,0,2,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource InspectorTabBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDetailTab}" Value="1"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Payments" Click="OnDetailTabClick" Tag="2" Margin="0,0,2,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource InspectorTabBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDetailTab}" Value="2"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Lịch sử" Click="OnDetailTabClick" Tag="3" Margin="0,0,2,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource InspectorTabBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDetailTab}" Value="3"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Documents" Click="OnDetailTabClick" Tag="4" Margin="0,0,2,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource InspectorTabBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDetailTab}" Value="4"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Ghi chú" Click="OnDetailTabClick" Tag="5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource InspectorTabBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDetailTab}" Value="5"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Tab Content -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0">
                        <Grid Margin="22,16,22,16">

                        <!-- TAB 0: OVERVIEW -->
                        <StackPanel Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="THÔNG TIN DOANH NGHIỆP" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Tên DN" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.CompanyName}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1" Text="AR Number" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.ArNo}" FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="2" Text="Mã KH" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.CompanyCode}" FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="3" Text="MST" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.TaxCode, TargetNullValue='—'}" FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="4" Text="Địa chỉ" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.Address, TargetNullValue='—'}" FontSize="12" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="5" Text="Điện thoại" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedItem.Phone, TargetNullValue='—'}" FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="6" Text="Email" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedItem.Email, TargetNullValue='—'}" FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="7" Text="Sales" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedItem.SalesPerson, TargetNullValue='—'}" FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="8" Text="Market" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedItem.Market, TargetNullValue='—'}" FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="9" Text="Source" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedItem.Source, TargetNullValue='—'}" FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="10" Text="Credit Limit" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedItem.CreditLimit, StringFormat='{}{0:N0} ₫'}" FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="11" Text="Current Balance" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding SelectedItem.Balance, StringFormat='{}{0:N0} ₫'}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="12" Text="Available Credit" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Row="12" Grid.Column="1" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCreditLimitExceeded}" Value="True"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding CreditLimit, StringFormat='{}{0:N0} ₫', Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                            <Separator Margin="0,10" Background="#F1F5F9"/>
                            <TextBlock Text="CREDIT LIMIT" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#F0FDF4" CornerRadius="8" Padding="8,6" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="Limit" FontSize="9" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                        <TextBlock Text="{Binding SelectedItem.CreditLimit, StringFormat='{}{0:N0}'}" FontSize="12" FontWeight="Bold" Foreground="#16A34A" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFFBEB" CornerRadius="8" Padding="8,6" Margin="2,0">
                                    <StackPanel>
                                        <TextBlock Text="Used" FontSize="9" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                        <TextBlock Text="{Binding SelectedItem.Balance, StringFormat='{}{0:N0}'}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#EFF6FF" CornerRadius="8" Padding="8,6" Margin="4,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Available" FontSize="9" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                        <TextBlock Text="{Binding SelectedItem.CreditLimit, StringFormat='{}{0:N0}'}" FontSize="12" FontWeight="Bold" Foreground="#2563EB" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- Credit Limit Warning -->
                            <Border Background="#FEF2F2" CornerRadius="8" Padding="10,8" Margin="0,8,0,0" Visibility="{Binding SelectedItem.IsCreditLimitExceeded, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="CREDIT LIMIT EXCEEDED" FontSize="11" FontWeight="Bold" Foreground="#DC2626" FontFamily="Segoe UI"/>
                            </Border>
                        </StackPanel>

                        <!-- TAB 1: INVOICES -->
                        <StackPanel Visibility="{Binding IsInvoicesTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DANH SÁCH HÓA ĐƠN" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                            <ItemsControl ItemsSource="{Binding SelectedItem.Invoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ArInvoiceDto}">
                                        <Border Padding="10,8" Margin="0,0,0,6" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding InvoiceNo}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                                                    <Border CornerRadius="8" Padding="6,1" Background="{Binding StatusBg, Converter={StaticResource StringToBrush}}">
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" FontFamily="Segoe UI"/>
                                                    </Border>
                                                </Grid>
                                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="10" FontFamily="Segoe UI" Foreground="#94A3B8">
                                                        <Run Text="Phát hành: "/><Run Text="{Binding IssueDate, StringFormat='{}{0:dd/MM/yyyy}'}" Foreground="#475569"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1" FontSize="10" FontFamily="Segoe UI" Foreground="#94A3B8">
                                                        <Run Text="Đến hạn: "/><Run Text="{Binding DueDate, StringFormat='{}{0:dd/MM/yyyy}'}" Foreground="#475569"/>
                                                    </TextBlock>
                                                </Grid>
                                                <Grid Grid.Row="2" Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Amount, StringFormat='Tiền: {0:N0} ₫'}" FontSize="10" Foreground="#475569" FontFamily="Segoe UI"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Vat, StringFormat='VAT: {0:N0} ₫'}" FontSize="10" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Balance, StringFormat='Còn: {0:N0} ₫'}" FontSize="10" FontWeight="SemiBold" Foreground="#DC2626" FontFamily="Segoe UI"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- TAB 2: PAYMENTS -->
                        <StackPanel Visibility="{Binding IsPaymentsTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="LỊCH SỬ THANH TOÁN" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                            <ItemsControl ItemsSource="{Binding SelectedItem.Payments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ArPaymentDto}">
                                        <Border Padding="10,8" Margin="0,0,0,6" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ReceiptNo}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:N0} ₫'}" FontSize="13" FontWeight="Bold" Foreground="#16A34A" FontFamily="Segoe UI" TextAlignment="Right" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="10" FontFamily="Segoe UI" Foreground="#94A3B8">
                                                            <Run Text="Ngày: "/><Run Text="{Binding PaymentDate, StringFormat='{}{0:dd/MM/yyyy}'}" Foreground="#475569"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="10" FontFamily="Segoe UI" Foreground="#94A3B8" Margin="0,2,0,0">
                                                            <Run Text="Cashier: "/><Run Text="{Binding Cashier}" Foreground="#475569"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Method}" FontSize="10" Foreground="#2563EB" FontFamily="Segoe UI"/>
                                                        <TextBlock Text="{Binding Reference, TargetNullValue='—'}" FontSize="10" Foreground="#94A3B8" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- TAB 3: HISTORY (TIMELINE + AUDIT LOG) -->
                        <StackPanel Visibility="{Binding IsHistoryTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="TIMELINE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                            <ItemsControl ItemsSource="{Binding ItemTimeline}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ArTimelineEntry}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid>
                                                <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Color, Converter={StaticResource StringToBrush}}" Margin="0,2,0,0"/>
                                                <Border Width="2" HorizontalAlignment="Center" Background="#E2E8F0" Margin="4,12,4,0" VerticalAlignment="Stretch"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Event}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="10" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#475569" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Margin="0,10" Background="#E2E8F0"/>
                            <TextBlock Text="AUDIT LOG" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                            <ItemsControl ItemsSource="{Binding ItemAuditLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ArAuditEntry}">
                                        <Border Padding="8,6" Margin="0,0,0,4" Background="#F8FAFC" CornerRadius="6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Action}" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" FontFamily="Segoe UI"/>
                                                    <TextBlock Text="{Binding Actor, StringFormat=' — {0}'}" FontSize="10" Foreground="#64748B" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#475569" FontFamily="Segoe UI" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="9" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                                    <TextBlock Text="{Binding Device, StringFormat=' • {0}'}" FontSize="9" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- TAB 4: DOCUMENTS -->
                        <StackPanel Visibility="{Binding IsDocumentsTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="TÀI LIỆU ĐÍNH KÈM" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                            <ItemsControl ItemsSource="{Binding SelectedItem.Documents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ArDocumentDto}">
                                        <Border Margin="0,0,0,8" Background="#F8FAFC" CornerRadius="10" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="8" Background="#DBEAFE" Margin="0,0,10,0">
                                                    <TextBlock Text="PDF" FontSize="9" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <Border CornerRadius="6" Padding="4,1" Background="#EFF6FF">
                                                            <TextBlock Text="{Binding TypeLabel}" FontSize="9" Foreground="#2563EB" FontFamily="Segoe UI"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding UploadDate, StringFormat=' • {0:dd/MM/yyyy}'}" FontSize="10" Foreground="#94A3B8" Margin="4,0,0,0" FontFamily="Segoe UI"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="#F8FAFC" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" Margin="0,4,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="+" FontFamily="Segoe UI" FontSize="24" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Upload tài liệu" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 5: NOTES -->
                        <StackPanel Visibility="{Binding IsNotesTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="GHI CHÚ" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                            <ItemsControl ItemsSource="{Binding SelectedItem.Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ArNoteDto}">
                                        <Border Padding="10,8" Margin="0,0,0,6" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border CornerRadius="6" Padding="4,1" Background="#EFF6FF">
                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="9" Foreground="#2563EB" FontFamily="Segoe UI"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Author, StringFormat=' • {0}'}" FontSize="10" Foreground="#94A3B8" Margin="4,0,0,0" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Content}" FontSize="11" Foreground="#475569" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="9" Foreground="#94A3B8" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Empty inspector state -->
                    <Border Grid.Row="2" Background="White" Panel.ZIndex="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="—" FontFamily="Segoe UI" FontSize="28" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chọn một khoản công nợ" FontSize="16" FontWeight="SemiBold" Foreground="#52657D" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="để xem thông tin chi tiết, invoices, payments và lịch sử." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ ROW 5: FOOTER ═══ -->
        <Border Grid.Row="5" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageDisplay}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    <Border CornerRadius="6" Padding="6,2" Margin="10,0,0,0" Background="#EFF6FF">
                        <TextBlock Text="AR Ledger" FontSize="11" Foreground="#2563EB" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x00AB;" Style="{StaticResource PagerBtn}" Command="{Binding FirstPageCommand}" IsEnabled="{Binding HasPrevPage}" ToolTip="Trang đầu"/>
                    <Button Content="&#x2039;" Style="{StaticResource PagerBtn}" Command="{Binding PrevPageCommand}" IsEnabled="{Binding HasPrevPage}" ToolTip="Trang trước"/>
                    <ItemsControl ItemsSource="{Binding PageButtons}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArPaginationButton}">
                            <Button Style="{StaticResource PagerPageBtn}" Command="{Binding DataContext.SetPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding PageNumber}"/>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="&#x203A;" Style="{StaticResource PagerBtn}" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" ToolTip="Trang sau"/>
                    <Button Content="&#x00BB;" Style="{StaticResource PagerBtn}" Command="{Binding LastPageCommand}" IsEnabled="{Binding HasNextPage}" ToolTip="Trang cuối"/>
                    <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemStringFormat="{}{0} / trang" Style="{StaticResource FluentComboBox}" Width="122" Height="32" MinWidth="0" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- FORM OVERLAY                                                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.RowSpan="6" Background="#80000000" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Border Background="White" CornerRadius="14" MaxWidth="560" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <!-- Form Header -->
                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="14,14,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FormTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                                <Button Grid.Column="1" Content="Đóng" Style="{StaticResource SecondaryBtn}" Width="58" Height="30" Padding="8,0" Command="{Binding CloseFormCommand}"/>
                            </Grid>
                        </Border>

                        <!-- Form Body -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12">
                            <StackPanel>

                                <!-- FORM ERROR -->
                                <Border Background="#FEF2F2" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" Visibility="{Binding FormErrorMessage, Converter={StaticResource StringToVis}}">
                                    <TextBlock Text="{Binding FormErrorMessage}" FontSize="12" Foreground="#DC2626" FontFamily="Segoe UI"/>
                                </Border>

                                <!-- PAYMENT FORM -->
                                <StackPanel Visibility="{Binding IsRecordPaymentForm, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Số tiền thu *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,10"/>

                                    <TextBlock Text="Ngày thu" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <DatePicker SelectedDate="{Binding PaymentDate}" Height="32" FontSize="12" Margin="0,0,0,10"/>

                                    <TextBlock Text="Phương thức" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <ComboBox SelectedItem="{Binding PaymentMethod}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Tiền mặt"/>
                                        <ComboBoxItem Content="Chuyển khoản"/>
                                        <ComboBoxItem Content="Thẻ tín dụng"/>
                                        <ComboBoxItem Content="Thẻ ghi nợ"/>
                                        <ComboBoxItem Content="Ví điện tử"/>
                                        <ComboBoxItem Content="Séc"/>
                                    </ComboBox>

                                    <TextBlock Text="Cashier" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <ComboBox SelectedItem="{Binding PaymentCashier}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Nguyễn Văn Thu Ngân"/>
                                        <ComboBoxItem Content="Trần Thị Cashier"/>
                                        <ComboBoxItem Content="Lê Văn Teller"/>
                                        <ComboBoxItem Content="Phạm Thị Payment"/>
                                    </ComboBox>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Số tham chiếu" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                            <TextBox Text="{Binding PaymentReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Ghi chú" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                            <TextBox Text="{Binding PaymentRemark, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- EMAIL FORM -->
                                <StackPanel Visibility="{Binding IsEmailForm, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Loại Email" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <ComboBox SelectedItem="{Binding EmailType}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Statement"/>
                                        <ComboBoxItem Content="Invoice"/>
                                        <ComboBoxItem Content="Reminder"/>
                                        <ComboBoxItem Content="BalanceConfirmation"/>
                                    </ComboBox>

                                    <TextBlock Text="Email người nhận *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding EmailTo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,10"/>

                                    <TextBlock Text="Tiêu đề" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding EmailSubject, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,10"/>

                                    <TextBlock Text="Nội dung" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding EmailBody, UpdateSourceTrigger=PropertyChanged}" Height="120" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,10"/>
                                </StackPanel>

                                <!-- NOTE FORM -->
                                <StackPanel Visibility="{Binding IsNoteForm, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Loại ghi chú" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <ComboBox SelectedItem="{Binding NoteType}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Reminder"/>
                                        <ComboBoxItem Content="PhoneCall"/>
                                        <ComboBoxItem Content="Email"/>
                                        <ComboBoxItem Content="Internal"/>
                                        <ComboBoxItem Content="Accounting"/>
                                    </ComboBox>

                                    <TextBlock Text="Nội dung *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                    <TextBox Text="{Binding NoteContent, UpdateSourceTrigger=PropertyChanged}" Height="100" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,10"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Form Footer -->
                        <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,14,14" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Hủy" Style="{StaticResource SecondaryBtn}" Width="90" Command="{Binding CloseFormCommand}" Margin="0,0,8,0"/>
                                <Button Content="Lưu" Width="90">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                                            <Setter Property="Width" Value="90"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecordPaymentForm}" Value="True"><Setter Property="Command" Value="{Binding SubmitPaymentFormCommand}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding IsEmailForm}" Value="True"><Setter Property="Command" Value="{Binding SubmitEmailFormCommand}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding IsNoteForm}" Value="True"><Setter Property="Command" Value="{Binding SubmitNoteFormCommand}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
