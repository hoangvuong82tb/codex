                                    <DataGridTemplateColumn Header="Kết quả đối chiếu" Width="136">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result}" Value="Chênh lệch">
                                                                            <Setter Property="Background" Value="#FFF7ED"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Result}" FontWeight="SemiBold" FontSize="12">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                                        <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result}" Value="Chênh lệch">
                                                                                <Setter Property="Foreground" Value="#F97316"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Trạng thái" Width="126">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Chưa đối chiếu">
                                                                            <Setter Property="Background" Value="#EEF2FF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                                        <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Chưa đối chiếu">
                                                                                <Setter Property="Foreground" Value="#475569"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Grid.Row="1" Margin="14,10,14,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ReconciliationPageText}" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource ReconciliationPagerButton}" Content="‹" Command="{Binding PreviousReconciliationPageCommand}"/>
                                            <ItemsControl ItemsSource="{Binding ReconciliationPageButtons}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.GoToReconciliationPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ReconciliationPagerButton}">
                                                                    <Setter Property="Content" Value="{Binding Label}"/>
                                                                    <Setter Property="IsEnabled" Value="True"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Setter Property="MinWidth" Value="24"/>
                                                                            <Setter Property="MaxWidth" Value="24"/>
                                                                            <Setter Property="Width" Value="24"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Background" Value="#FB923C"/>
                                                                            <Setter Property="BorderBrush" Value="#FB923C"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                            <Button Style="{StaticResource ReconciliationPagerButton}" Content="›" Margin="0,0,8,0" Command="{Binding NextReconciliationPageCommand}"/>
                                            <ComboBox Style="{StaticResource FilterComboBox}"
                                                      Width="118"
                                                      Height="30"
                                                      ItemsSource="{Binding ReconciliationPageSizeOptions}"
                                                      SelectedItem="{Binding SelectedReconciliationPageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Tuổi nợ / Đến hạn">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="1.35*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource FilterCard}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="216"/>
                                        <ColumnDefinition Width="216"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Style="{StaticResource FilterField}">
                                        <TextBlock Style="{StaticResource FilterLabel}" Text="Từ ngày"/>
                                        <DatePicker Style="{StaticResource FilterDatePicker}" Width="199" SelectedDate="{Binding FromDate}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Style="{StaticResource FilterField}">
                                        <TextBlock Style="{StaticResource FilterLabel}" Text="Đến ngày"/>
                                        <DatePicker Style="{StaticResource FilterDatePicker}" Width="198" SelectedDate="{Binding ToDate}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Style="{StaticResource FilterField}">
                                        <TextBlock Style="{StaticResource FilterLabel}" Text="Trạng thái"/>
                                        <ComboBox Style="{StaticResource StatusFilterComboBox}" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Style="{StaticResource FilterField}">
                                        <TextBlock Style="{StaticResource FilterLabel}" Text="Điều kiện"/>
                                        <CheckBox Content="Chỉ quá hạn" IsChecked="{Binding OverdueOnly}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="4" Style="{StaticResource CmdPrimary}" Command="{Binding OpenOverdueDrilldownCommand}" MinWidth="120" VerticalAlignment="Bottom" Content="Xem quá hạn"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource PanelCard}" Padding="18" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Buckets tuổi nợ" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Bucket0To30, StringFormat=0-30 ngày: {0:N0}}" Margin="0,12,0,4"/>
                                    <ProgressBar Value="{Binding Bucket0To30}" Maximum="{Binding RemainingAmount}" Height="8"/>
                                    <TextBlock Text="{Binding Bucket31To60, StringFormat=31-60 ngày: {0:N0}}" Margin="0,12,0,4"/>
                                    <ProgressBar Value="{Binding Bucket31To60}" Maximum="{Binding RemainingAmount}" Height="8"/>
                                    <TextBlock Text="{Binding Bucket61To90, StringFormat=61-90 ngày: {0:N0}}" Margin="0,12,0,4"/>
                                    <ProgressBar Value="{Binding Bucket61To90}" Maximum="{Binding RemainingAmount}" Height="8"/>
                                    <TextBlock Text="{Binding Bucket90Plus, StringFormat=>90 ngày: {0:N0}}" Margin="0,12,0,4"/>
                                    <ProgressBar Value="{Binding Bucket90Plus}" Maximum="{Binding RemainingAmount}" Height="8"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelCard}" Padding="0" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="54"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Nhà cung cấp quá hạn / đến hạn" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0"/>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding DueSoonPager.Items}" AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã NCC" Binding="{Binding SupplierCode}" Width="90"/>
                                            <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding SupplierName}" Width="*"/>
                                            <DataGridTextColumn Header="Quá hạn" Binding="{Binding OverdueAmount, StringFormat={}{0:N0}}" Width="120"/>
                                            <DataGridTextColumn Header="Còn nợ" Binding="{Binding ClosingBalance, StringFormat={}{0:N0}}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Grid.Row="2" Margin="12,10,12,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DueSoonPager.PageText}" VerticalAlignment="Center" Foreground="#475569"/>
                                        <controls:TablePagerControl Grid.Column="1" DataContext="{Binding DueSoonPager}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Báo cáo">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ReportCards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFFFF"
                                                    BorderBrush="#DDE7F3"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="14"
                                                    Margin="0,0,12,12"
                                                    MinHeight="168">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#CBD5E1" Opacity="0.18" BlurRadius="14" ShadowDepth="2"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="38" Height="38" CornerRadius="10" Background="{Binding IconBackground}" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding IconGlyph}"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="18"
                                                                       Foreground="{Binding AccentBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" Foreground="#10213F" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Top"/>
                                                    </Grid>

                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
                                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#64748B" Margin="0,1,6,0"/>
                                                        <TextBlock Text="Xem trước dữ liệu" FontSize="11.5" Foreground="#475569"/>
                                                    </StackPanel>

                                                    <Grid Grid.Row="2" Margin="0,0,0,12">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding PrimaryLabel}" Foreground="#64748B" FontSize="11.5"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding PrimaryValue}" Foreground="#10213F" FontSize="11.5" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Row="1" Text="{Binding SecondaryLabel}" Foreground="#64748B" FontSize="11.5" Margin="0,7,0,0"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SecondaryValue}" Foreground="#10213F" FontSize="11.5" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                                    </Grid>

                                                    <WrapPanel Grid.Row="3">
                                                        <Button Style="{StaticResource PayableReportPreviewButton}"
                                                                Command="{Binding DataContext.PreviewReportCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                <TextBlock Text="Xem trước" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource PayableReportExcelButton}"
                                                                Command="{Binding DataContext.ExportReportCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                <TextBlock Text="Xuất Excel" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource PayableReportCardButton}"
                                                                Command="{Binding DataContext.PrintReportCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                <TextBlock Text="In" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Padding="16" Visibility="{Binding IsSupplierDetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Chi tiết nhà cung cấp" FontSize="18" FontWeight="SemiBold" Foreground="#0F2A55"/>
                    <Border Margin="0,14,0,12" Padding="14" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedSummary.SupplierName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedSummary.SupplierCode}" Margin="0,4,0,0" Foreground="#64748B"/>
                            <TextBlock Text="{Binding SelectedSummary.ClosingBalance, StringFormat=Còn phải trả: {0:N0}}" Margin="0,10,0,0" FontSize="17" FontWeight="SemiBold" Foreground="#C2410C"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Tuổi nợ" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Bucket0To30, StringFormat=0-30 ngày: {0:N0}}" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Bucket31To60, StringFormat=31-60 ngày: {0:N0}}" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Bucket61To90, StringFormat=61-90 ngày: {0:N0}}" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Bucket90Plus, StringFormat=>90 ngày: {0:N0}}" Foreground="#334155"/>
                    <Separator Margin="0,14"/>
                    <TextBlock Text="Phát sinh đang chọn" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding SelectedTransaction.DocumentNo}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedTransaction.TransactionDate, StringFormat=Ngày: {0:dd/MM/yyyy}}" Foreground="#64748B" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedTransaction.Description}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,0"/>
                    <Border Margin="0,14,0,0" Padding="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedTransactionPayable, StringFormat=Phải trả: {0:N0}}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding SelectedTransactionPaid, StringFormat=Đã trả: {0:N0}}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding SelectedTransactionRemaining, StringFormat=Còn lại của chứng từ: {0:N0}}" FontWeight="SemiBold" Foreground="#C2410C" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding SelectedTransactionSupplierBalance, StringFormat=Số dư NCC sau chứng từ: {0:N0}}" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Visibility="{Binding IsReportTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource PanelCard}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Tổng quan công nợ" FontSize="16" FontWeight="SemiBold" Foreground="#0F2A55" Margin="0,0,0,12"/>
                        <Border Background="#EFF6FF" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Tổng phải trả" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalPayable, StringFormat={}{0:N0}}" Foreground="#2563EB" FontSize="22" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Background="#ECFDF5" CornerRadius="10" Padding="8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Đã thanh toán" Foreground="#16A34A" FontSize="10.5"/>
                                    <TextBlock Text="{Binding PaidAmount, StringFormat={}{0:N0}}" Foreground="#16A34A" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFF7ED" CornerRadius="10" Padding="8" Margin="3,0">
                                <StackPanel>
                                    <TextBlock Text="Còn phải trả" Foreground="#F97316" FontSize="10.5"/>
                                    <TextBlock Text="{Binding RemainingAmount, StringFormat={}{0:N0}}" Foreground="#F97316" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FEF2F2" CornerRadius="10" Padding="8" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Quá hạn" Foreground="#EF4444" FontSize="10.5"/>
                                    <TextBlock Text="{Binding OverdueAmount, StringFormat={}{0:N0}}" Foreground="#EF4444" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="Tuổi nợ" FontWeight="SemiBold" Foreground="#0F2A55" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="0 - 30 ngày" Foreground="#16A34A"/><TextBlock Grid.Column="1" Text="{Binding Bucket0To30, StringFormat={}{0:N0}}" Foreground="#10213F" FontWeight="SemiBold"/></Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="31 - 60 ngày" Foreground="#3B82F6"/><TextBlock Grid.Column="1" Text="{Binding Bucket31To60, StringFormat={}{0:N0}}" Foreground="#10213F" FontWeight="SemiBold"/></Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="61 - 90 ngày" Foreground="#F59E0B"/><TextBlock Grid.Column="1" Text="{Binding Bucket61To90, StringFormat={}{0:N0}}" Foreground="#10213F" FontWeight="SemiBold"/></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="> 90 ngày" Foreground="#EF4444"/><TextBlock Grid.Column="1" Text="{Binding Bucket90Plus, StringFormat={}{0:N0}}" Foreground="#10213F" FontWeight="SemiBold"/></Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Thao tác nhanh" FontSize="16" FontWeight="SemiBold" Foreground="#0F2A55" Margin="0,0,0,12"/>
                        <UniformGrid Columns="4">
                            <Button Style="{StaticResource CmdSecondary}" Command="{Binding OpenSummaryTabCommand}" Margin="0,0,6,0" MinHeight="58">
                                <StackPanel>
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Chi tiết PT" TextAlignment="Center" FontSize="10.5"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource CmdSecondary}" Command="{Binding PaymentCommand}" Margin="0,0,6,0" MinHeight="58">
                                <StackPanel>
                                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Thanh toán" TextAlignment="Center" FontSize="10.5"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource CmdSecondary}" Command="{Binding GenerateReportCommand}" Margin="0,0,6,0" MinHeight="58">
                                <StackPanel>
                                    <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Đối chiếu CN" TextAlignment="Center" FontSize="10.5"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource CmdSecondary}" Command="{Binding OpenOverdueDrilldownCommand}" MinHeight="58">
                                <StackPanel>
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Tuổi nợ / CN" TextAlignment="Center" FontSize="10.5"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Visibility="{Binding IsReconciliationTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource PanelCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Chi tiết đối chiếu" FontSize="17" FontWeight="SemiBold" Foreground="#0F2A55" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="54" Height="54" CornerRadius="14" Background="#FEE2E2" Margin="0,0,12,0">
                                <TextBlock Text="{Binding SelectedReconciliationRow.AvatarText}"
                                           Foreground="#EF4444"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedReconciliationRow.SupplierCode}" FontSize="16" FontWeight="SemiBold" Foreground="#10213F"/>
                                <TextBlock Text="{Binding SelectedReconciliationRow.SupplierName}" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Border CornerRadius="10" Background="#FFF7ED" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <TextBlock Text="{Binding SelectedReconciliationRow.Result}" Foreground="#F97316" FontWeight="SemiBold"/>
                        </Border>

                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Hệ thống" Foreground="#2563EB" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedReconciliationRow.SystemBalance, StringFormat={}{0:N0}}" Foreground="#2563EB" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="VND" Foreground="#64748B" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#ECFDF5" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="3,0">
                                <StackPanel>
                                    <TextBlock Text="NCC xác nhận" Foreground="#16A34A" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedReconciliationRow.SupplierConfirmedBalance, StringFormat={}{0:N0}}" Foreground="#16A34A" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="VND" Foreground="#64748B" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="10" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Chênh lệch" Foreground="#EF4444" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedReconciliationRow.Difference, StringFormat={}{0:N0}}" Foreground="#EF4444" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="VND" Foreground="#64748B" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="Thông tin đối chiếu" FontWeight="SemiBold" Foreground="#0F2A55" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Kỳ đối chiếu:" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedReconciliationRow.Period}" Foreground="#10213F" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Ngày đối chiếu:" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedReconciliationRow.ReconciledAt}" Foreground="#10213F" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Người đối chiếu:" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedReconciliationRow.ReconciledBy}" Foreground="#10213F" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Trạng thái:" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedReconciliationRow.Result}" Foreground="#F97316" FontWeight="SemiBold"/>
                        </Grid>

                        <TextBlock Text="Ghi chú" FontWeight="SemiBold" Foreground="#0F2A55" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding SelectedReconciliationRow.Note}" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <TextBlock Text="Thao tác" FontWeight="SemiBold" Foreground="#0F2A55" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <Button Style="{StaticResource CmdSecondary}" Command="{Binding ViewReconciliationDetailCommand}" CommandParameter="{Binding SelectedReconciliationRow}" Margin="0,0,6,0" MinHeight="40">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" Margin="0,0,6,0"/>
                                    <TextBlock Text="Xem chi tiết"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource CmdSecondary}" Command="{Binding AttachReconciliationFileCommand}" Margin="6,0,0,0" MinHeight="40">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" Margin="0,0,6,0"/>
                                    <TextBlock Text="Đính kèm file"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <Button Style="{StaticResource CmdPrimary}" Command="{Binding ConfirmSupplierReconciliationCommand}" MinHeight="40" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0"/>
                                <TextBlock Text="Ghi nhận NCC xác nhận" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PanelCard}" Margin="0,12,0,0" Padding="10,7">
            <TextBlock Text="{Binding StatusBarText}" Foreground="#5A6B84"/>
        </Border>
    </Grid>
</UserControl>









