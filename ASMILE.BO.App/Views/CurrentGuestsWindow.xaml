<Window x:Class="ASMILE.BO.App.Views.CurrentGuestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khách hiện tại" Width="1440" Height="900"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- ═══ INPUT STYLES ═══ -->
        <Style x:Key="ModTextBox" TargetType="TextBox"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

        <Style x:Key="ModCombo" TargetType="ComboBox"><Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/><Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#7B8DA6" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="6" Stretch="Uniform"/></Grid></Border><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="9" Margin="0,2"><ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>

        <Style x:Key="ModDatePicker" TargetType="DatePicker"><Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="CalendarStyle" Value="{StaticResource FoModernCalendarStyle}"/><Setter Property="FirstDayOfWeek" Value="Monday"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker"><Grid><Border x:Name="Root" Background="White" BorderBrush="#D7E2F0" BorderThickness="1" CornerRadius="9" SnapsToDevicePixels="True"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Grid Grid.Column="0"><DatePickerTextBox x:Name="PART_TextBox" BorderThickness="0" Background="Transparent" Padding="12,0" VerticalContentAlignment="Center" FontSize="13" FontFamily="Segoe UI" Foreground="#17365D"/><TextBlock x:Name="Watermark" Text="Chọn ngày" IsHitTestVisible="False" Background="White" FontSize="13" FontFamily="Segoe UI" Foreground="#94A3B8" Padding="12,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid><ToggleButton x:Name="PART_Button" Grid.Column="1" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><Border Width="28" Height="28" CornerRadius="7" Background="#F2F6FD"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2F6BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ToggleButton></Grid><Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"><Calendar x:Name="PART_Calendar" Style="{StaticResource FoModernCalendarStyle}" Language="vi-VN" BorderThickness="0" Background="White" SelectedDate="{Binding SelectedDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" DisplayDate="{Binding DisplayDate, RelativeSource={RelativeSource TemplatedParent}}"/></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#AFCBF7"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#2F6BFF"/></Trigger><DataTrigger Binding="{Binding SelectedDate, RelativeSource={RelativeSource Self}}" Value="{x:Null}"><Setter TargetName="Watermark" Property="Visibility" Value="Visible"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

        <!-- ═══ BUTTONS ═══ -->
        <Style x:Key="BlueBtn" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>

        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource BlueBtn}"><Setter Property="Background" Value="#16A34A"/></Style>
        <Style x:Key="OrangeBtn" TargetType="Button" BasedOn="{StaticResource BlueBtn}"><Setter Property="Background" Value="#F59E0B"/></Style>

        <Style x:Key="GrayBtn" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>

        <Style x:Key="OutlineBtn" TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

        <Style x:Key="TabBtn" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="MinWidth" Value="80"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

        <!-- ═══ DATAGRID ═══ -->
        <Style x:Key="ModDataGrid" TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="#FAFBFD"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ColumnHeaderHeight" Value="42"/><Setter Property="RowHeight" Value="44"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2F6FC"/><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="10,0"/></Style></Setter.Value></Setter></Style>

        <!-- ═══ BADGES ═══ -->
        <Style x:Key="BadgeBlue" TargetType="Border"><Setter Property="Background" Value="#DBEAFE"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="BadgeGreen" TargetType="Border"><Setter Property="Background" Value="#DCFCE7"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="BadgeOrange" TargetType="Border"><Setter Property="Background" Value="#FFF7ED"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="BadgeRed" TargetType="Border"><Setter Property="Background" Value="#FEE2E2"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="BadgeGray" TargetType="Border"><Setter Property="Background" Value="#F3F4F6"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="#FAFBFD"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinWidth" Value="110"/></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#0F172A"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2563EB" Offset="0"/><GradientStop Color="#1D4ED8" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="Khách hiện tại" FontSize="20" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Theo dõi khách đang lưu trú, phòng ở và tình trạng dịch vụ." FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Làm mới" Click="OnRefresh" Style="{StaticResource GrayBtn}"/><Button Content="Đóng" Click="OnClose" Style="{StaticResource GrayBtn}" Margin="8,0,0,0"/></StackPanel>
            </Grid>
        </Border>

        <!-- ═══ METRIC ROW ═══ -->
        <Border Grid.Row="1" Margin="14,10,14,0" Padding="14,12" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Khách đang lưu trú" FontSize="11" Foreground="#94A3B8"/><TextBlock x:Name="MetricTotalGuests" FontSize="22" FontWeight="Bold" Foreground="#17365D" Text="58"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0"><StackPanel><TextBlock Text="Phòng có khách" FontSize="11" Foreground="#94A3B8"/><TextBlock x:Name="MetricOccupiedRooms" FontSize="22" FontWeight="Bold" Foreground="#17365D" Text="31"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0"><StackPanel><TextBlock Text="Trả phòng hôm nay" FontSize="11" Foreground="#94A3B8"/><TextBlock x:Name="MetricDeparting" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Text="12"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0"><StackPanel><TextBlock Text="Quá hạn" FontSize="11" Foreground="#94A3B8"/><TextBlock x:Name="MetricOverstay" FontSize="22" FontWeight="Bold" Foreground="#EA580C" Text="2"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Folio cần chú ý" FontSize="11" Foreground="#94A3B8"/><TextBlock x:Name="MetricFolioAlert" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Text="5"/></StackPanel></Border>
            </Grid>
        </Border>

        <!-- ═══ FILTER BAR ═══ -->
        <Border Grid.Row="2" Margin="14,8,14,6" Padding="12,10" Background="White" CornerRadius="12" BorderBrush="#D8E2F0" BorderThickness="1">
            <WrapPanel>
                <StackPanel Margin="0,0,8,4"><TextBlock Text="Từ khóa" FontSize="11" Foreground="#94A3B8"/><TextBox x:Name="SearchBox" Width="180" Style="{StaticResource ModTextBox}" KeyDown="OnSearchKeyDown"/></StackPanel>
                <StackPanel Margin="0,0,8,4"><TextBlock Text="Tầng" FontSize="11" Foreground="#94A3B8"/><ComboBox Width="90" Style="{StaticResource ModCombo}" x:Name="FloorFilter" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/></ComboBox></StackPanel>
                <StackPanel Margin="0,0,8,4"><TextBlock Text="Hạng phòng" FontSize="11" Foreground="#94A3B8"/><ComboBox Width="120" Style="{StaticResource ModCombo}" x:Name="RoomTypeFilter" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Standard"/><ComboBoxItem Content="Deluxe"/><ComboBoxItem Content="Superior"/><ComboBoxItem Content="Junior"/><ComboBoxItem Content="Suite"/></ComboBox></StackPanel>
                <StackPanel Margin="0,0,8,4"><TextBlock Text="Trạng thái" FontSize="11" Foreground="#94A3B8"/><ComboBox Width="140" Style="{StaticResource ModCombo}" x:Name="StatusFilter" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Đang lưu trú"/><ComboBoxItem Content="Trả hôm nay"/><ComboBoxItem Content="Quá hạn"/><ComboBoxItem Content="Gia hạn"/></ComboBox></StackPanel>
                <StackPanel Margin="0,0,8,4"><TextBlock Text="Ngày trả" FontSize="11" Foreground="#94A3B8"/><DatePicker Width="140" Style="{StaticResource ModDatePicker}" x:Name="DepartureFilter"/></StackPanel>
                <StackPanel Margin="0,0,8,4"><TextBlock Text="Folio" FontSize="11" Foreground="#94A3B8"/><ComboBox Width="130" Style="{StaticResource ModCombo}" x:Name="FolioFilter" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Bình thường"/><ComboBoxItem Content="Còn phải thu"/><ComboBoxItem Content="Vượt hạn mức"/></ComboBox></StackPanel>
                <StackPanel Margin="0,0,8,4"><TextBlock Text=" " FontSize="11"/><CheckBox x:Name="ChkDeparting" Content="Trả hôm nay" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="0,5,0,0" Checked="OnQuickFilterChanged" Unchecked="OnQuickFilterChanged"/></StackPanel>
                <StackPanel Margin="0,0,0,4"><TextBlock Text=" " FontSize="11"/><CheckBox x:Name="ChkAlert" Content="Cần chú ý" FontSize="12" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,5,0,0" Checked="OnQuickFilterChanged" Unchecked="OnQuickFilterChanged"/></StackPanel>
                <StackPanel Margin="14,16,6,4"><Button Content="Tìm" Click="OnRefresh" Style="{StaticResource BlueBtn}" Width="80"/></StackPanel>
                <StackPanel Margin="0,16,0,4"><Button Content="Xóa lọc" Click="OnClearFilter" Style="{StaticResource GrayBtn}"/></StackPanel>
            </WrapPanel>
        </Border>

        <!-- ═══ MAIN: 2 cột ═══ -->
        <Grid Grid.Row="3" Margin="14,4,14,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="6.3*" MinWidth="520"/><ColumnDefinition Width="16"/><ColumnDefinition Width="3.7*" MinWidth="380"/></Grid.ColumnDefinitions>

            <!-- ═══ CỘT TRÁI: Danh sách khách ═══ -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Danh sách khách đang lưu trú" FontSize="14" FontWeight="SemiBold" Foreground="#102E5A"/>
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="#94A3B8" x:Name="ResultCount" Text="28 khách"/>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" x:Name="GuestGrid" Style="{StaticResource ModDataGrid}" SelectionChanged="OnGuestSelected">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Trạng thái" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" Background="{Binding StatusBadgeBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusColorBrush}" VerticalAlignment="Center"/>
                                </Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomNumber}" Width="65"/>
                            <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="160"/>
                            <DataGridTextColumn Header="Vai trò" Binding="{Binding Role}" Width="90"/>
                            <DataGridTextColumn Header="Ngày đến" Binding="{Binding Arrival}" Width="100"/>
                            <DataGridTextColumn Header="Ngày đi" Binding="{Binding Departure}" Width="100"/>
                            <DataGridTextColumn Header="Đêm" Binding="{Binding Nights}" Width="45"/>
                            <DataGridTextColumn Header="Hạng" Binding="{Binding RoomType}" Width="75"/>
                            <DataGridTextColumn Header="Điện thoại" Binding="{Binding Phone}" Width="110"/>
                            <DataGridTextColumn Header="Folio" Binding="{Binding FolioId}" Width="80"/>
                            <DataGridTemplateColumn Header="Cảnh báo" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <TextBlock Text="{Binding Alert}" FontSize="11" Foreground="{Binding AlertColor}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ═══ CỘT PHẢI: Chi tiết + Tabs ═══ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Guest Header Card -->
                    <Border x:Name="DetailCard" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                        <Grid>
                            <StackPanel x:Name="DetailEmpty">
                                <TextBlock Text="Chọn một khách để xem thông tin." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,30"/>
                            </StackPanel>
                            <StackPanel x:Name="DetailContent" Visibility="Collapsed">
                            <!-- Guest header row -->
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#2563EB"><TextBlock x:Name="DetailInitials" Text="NA" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailName" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" Text="Nguyễn Văn An"/>
                                    <Border Grid.Column="1" Margin="8,0,0,0" x:Name="DetailBadgeRole" Style="{StaticResource BadgeBlue}" VerticalAlignment="Center"><TextBlock x:Name="DetailRoleText" Text="Khách chính" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/></Border>
                                </Grid>
                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#64748B"><Run x:Name="DetailRoomMeta" Text="Phòng 201 · Deluxe"/><Run Text=" · "/><Run x:Name="DetailStatusMeta" Text="Đang lưu trú"/></TextBlock></StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Xem HS" Click="OnViewProfile" Style="{StaticResource OutlineBtn}" Height="32" FontSize="12" Padding="10,0"/>
                                    <Button Content="..." Click="OnMoreActions" Style="{StaticResource OutlineBtn}" Height="32" FontSize="12" Padding="10,0" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <!-- Mini metrics -->
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0"><StackPanel><TextBlock Text="Số đêm" FontSize="10" Foreground="#94A3B8"/><TextBlock x:Name="DetailNights" FontSize="18" FontWeight="Bold" Foreground="#17365D" Text="3"/></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}" Margin="2,0,2,0"><StackPanel><TextBlock Text="Ngày đi" FontSize="10" Foreground="#94A3B8"/><TextBlock x:Name="DetailDeparture" FontSize="18" FontWeight="Bold" Foreground="#17365D" Text="27/07"/></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}" Margin="2,0,2,0"><StackPanel><TextBlock Text="Khách/phòng" FontSize="10" Foreground="#94A3B8"/><TextBlock x:Name="DetailGuestCount" FontSize="18" FontWeight="Bold" Foreground="#17365D" Text="2"/></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0"><StackPanel><TextBlock Text="Còn phải thu" FontSize="10" Foreground="#94A3B8"/><TextBlock x:Name="DetailBalance" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Text="2.4M"/></StackPanel></Border>
                            </Grid>
                        </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tabs -->
                    <Border Margin="0,10,0,0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Padding="12,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Tổng quan" Click="OnTabClick" Tag="0" Style="{StaticResource TabBtn}"/>
                                    <Button Content="Lưu trú" Click="OnTabClick" Tag="1" Style="{StaticResource TabBtn}"/>
                                    <Button Content="Giấy tờ" Click="OnTabClick" Tag="2" Style="{StaticResource TabBtn}"/>
                                    <Button Content="Phòng &amp; DV" Click="OnTabClick" Tag="3" Style="{StaticResource TabBtn}"/>
                                    <Button Content="Folio" Click="OnTabClick" Tag="4" Style="{StaticResource TabBtn}"/>
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                <StackPanel x:Name="TabContent" Margin="16,12"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Quick actions -->
                    <Border Margin="0,10,0,0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Thao tác nhanh" FontSize="13" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,10"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Gia hạn lưu trú" Click="OnExtendStay" Style="{StaticResource BlueBtn}" Height="38" FontSize="13" Padding="0,0"/>
                                <Button Grid.Column="2" Content="Đổi phòng" Click="OnChangeRoom" Style="{StaticResource OutlineBtn}" Height="38" FontSize="13" Padding="0,0"/>
                            </Grid>
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Thêm khách" Click="OnAddGuest" Style="{StaticResource OutlineBtn}" Height="38" FontSize="13" Padding="0,0"/>
                                <Button Grid.Column="2" Content="Nhắn nhà buồng" Click="OnHousekeeping" Style="{StaticResource GrayBtn}" Height="38" FontSize="13" Padding="0,0"/>
                            </Grid>
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Xem Folio" Click="OnViewFolio" Style="{StaticResource OutlineBtn}" Height="38" FontSize="13" Padding="0,0"/>
                                <Button Grid.Column="2" Content="Chuẩn bị Check-out" Click="OnPrepCheckout" Style="{StaticResource OrangeBtn}" Height="38" FontSize="13" Padding="0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══ FOOTER ═══ -->
        <Border Grid.Row="4" Padding="14,10" Margin="14,10,14,12" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#64748B" x:Name="FooterTotal" Text="Tổng: 28 khách · 17 phòng"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="PageInfo" Text="Trang 1/2" VerticalAlignment="Center" FontSize="12" Foreground="#94A3B8" Margin="0,0,12,0"/>
                    <Button Content="← Trước" Style="{StaticResource GrayBtn}" Click="OnPrevPage"/>
                    <Button Content="Sau →" Style="{StaticResource GrayBtn}" Margin="8,0,0,0" Click="OnNextPage"/>
                    <Button Content="Đóng" Click="OnClose" Style="{StaticResource GrayBtn}" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
