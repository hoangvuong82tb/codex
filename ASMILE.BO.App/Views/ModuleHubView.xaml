<UserControl x:Class="ASMILE.BO.App.Views.ModuleHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ASMILE.BO.App.Models"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <DataTemplate DataType="{x:Type models:ModuleHubCard}">
            <Border Style="{StaticResource HubCardStyle}" Visibility="{Binding IsVisible, Converter={StaticResource BoolVis}}"
                    Tag="{Binding Id}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding Command}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource HubIconBoxStyle}" Background="{Binding IconColor}">
                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource HubCardTitleStyle}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.04,0.04" Center="0.04,0.04" RadiusX="0.32" RadiusY="0.32">
                <GradientStop Color="#106aa7ff" Offset="0"/>
                <GradientStop Color="#00ffffff" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Style="{StaticResource HubContainerStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Content="← Quay lại" Command="{Binding BackCommand}" Style="{StaticResource HubBackButtonStyle}"/>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,32">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource HubHeaderStyle}"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource HubSubtitleStyle}"/>
                </StackPanel>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding Cards}" Style="{StaticResource HubGridStyle}"/>

                <Border Grid.Row="3" Margin="0,20,0,0" Padding="12,10" CornerRadius="8"
                        Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1"
                        Visibility="{Binding ComingSoonMessage, Converter={StaticResource BoolVis}, TargetNullValue=Collapsed, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding ComingSoonMessage}" Foreground="#1E40AF" TextAlignment="Center"/>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
