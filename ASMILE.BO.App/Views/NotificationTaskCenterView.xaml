<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ASMILE.BO.App.Views.NotificationTaskCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:ASMILE.BO.App.Controls"
             mc:Ignorable="d" FontFamily="Segoe UI">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="B2V"/></UserControl.Resources>

  <Grid Background="#F6F8FB">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="18,16,18,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Trung tâm thông báo" Style="{StaticResource AppTitleTextStyle}"/>
        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" Text="{Binding StatusMessage}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Content="Đánh dấu tất cả đã đọc" Command="{Binding MarkAllReadCommand}" Height="32" FontSize="11" Padding="10,0" Margin="0,0,4,0"/>
        <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Content="Hoàn tất đã chọn" Command="{Binding CompleteAllSelectedCommand}" Height="32" FontSize="11" Padding="10,0" Margin="0,0,4,0"/>
        <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Content="Chọn tất cả" Command="{Binding SelectAllItemsCommand}" Height="32" FontSize="11" Padding="10,0" Margin="0,0,4,0"/>
        <Button Style="{StaticResource EnterpriseModuleCmdInfo}" Content="Xuất CSV" Command="{Binding ExportCommand}" Height="32" FontSize="11" Padding="10,0" Margin="0,0,4,0"/>
	        <Button Style="{StaticResource EnterpriseModuleCmdInfo}" Content="🖨 In phiếu" Command="{Binding PrintTasksCommand}" Height="32" FontSize="11" Padding="10,0" Margin="0,0,6,0"/>
        <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Content="+ Tạo công việc" Command="{Binding ToggleCreateTaskCommand}" Margin="0,0,6,0"/>
        <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Content="🤖 AI" Command="{Binding ShowAiAssistantCommand}" Height="32" FontSize="11" Padding="8,0" Margin="0,0,6,0"/>
        <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Content="Làm mới" Command="{Binding RefreshCommand}"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="18,0,18,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <!-- SIDEBAR (permanent, no overlap) -->
      <StackPanel Grid.Column="0" VerticalAlignment="Top">
        <Button Height="44" Width="44" Margin="0,2" ToolTip="Mở / thu gọn KPI" Cursor="Hand" Command="{Binding ToggleKpiPanelCommand}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="Transparent" CornerRadius="10" BorderThickness="0">
                <Viewbox Width="20" Height="20">
                  <Grid Width="20" Height="20">
                    <Path Fill="#0F2A55" Data="M3,17 L3,10 L6,10 L6,17 Z M8.5,17 L8.5,5 L11.5,5 L11.5,17 Z M14,17 L14,8 L17,8 L17,17 Z"/>
                    <Path Stroke="#0F2A55" StrokeThickness="1.5" Data="M2.5,17.5 L18,17.5"/>
                  </Grid>
                </Viewbox>
              </Border>
              <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F1F5F9"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <Button Height="44" Width="44" Margin="0,2" ToolTip="Mở / thu gọn bộ lọc" Cursor="Hand" Command="{Binding ToggleFilterPanelCommand}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="Transparent" CornerRadius="10" BorderThickness="0">
                <Viewbox Width="20" Height="20">
                  <Path Fill="#0F2A55" Data="M2,4 C2,3.45 2.45,3 3,3 L17,3 C17.55,3 18,3.45 18,4 C18,4.25 17.9,4.48 17.73,4.66 L12,10.55 L12,16.2 C12,16.55 11.82,16.87 11.52,17.05 L8.52,18.8 C7.86,19.18 7,18.71 7,17.95 L7,10.55 L2.27,4.66 C2.1,4.48 2,4.25 2,4 Z"/>
                </Viewbox>
              </Border>
              <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F1F5F9"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </StackPanel>

      <!-- CONTENT + FLOATING PANELS -->
      <Grid Grid.Column="1" Margin="8,0,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="450"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- INBOX -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#DDE7F3" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="8,6">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                  <Button Content="Hệ thống" Command="{Binding NavigateInboxTabCommand}" CommandParameter="0" Height="30" FontSize="12" FontWeight="SemiBold" Padding="12,0" Margin="0,0,4,0" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#64748B">
                    <Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsInboxTabSystem}" Value="True"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style>
                  </Button>
                  <Button Content="Người quản lý" Command="{Binding NavigateInboxTabCommand}" CommandParameter="1" Height="30" FontSize="12" FontWeight="SemiBold" Padding="12,0" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#64748B">
                    <Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsInboxTabManager}" Value="True"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style>
                  </Button>
                  <Button Content="Lịch sử" Command="{Binding NavigateInboxTabCommand}" CommandParameter="2" Height="30" FontSize="12" FontWeight="SemiBold" Padding="12,0" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#64748B">
                    <Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsInboxTabHistory}" Value="True"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style>
                  </Button>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="999" Background="#EEF3F9" Padding="8,4">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#475569"><Run Text="Chưa đọc: "/><Run Text="{Binding UnreadCount}"/></TextBlock>
                </Border>
              </Grid>
            </Border>

            <!-- Tab: System -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsInboxTabSystem, Converter={StaticResource B2V}}">
              <ItemsControl ItemsSource="{Binding SystemInboxItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="Itm" Padding="12,10" BorderBrush="#EDF3F9" BorderThickness="0,0,0,1" Cursor="Hand" MouseLeftButtonDown="OnInboxItemClick">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Margin="0,0,10,0" VerticalAlignment="Top" Background="#FEF2F2"><TextBlock Text="{Binding TypeIcon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1">
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="7" Height="7" CornerRadius="50" Background="#DC2626" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding IsUnread, Converter={StaticResource B2V}}"/>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            <Button Width="20" Height="20" FontSize="11" Padding="0" Cursor="Hand" ToolTip="Ghim / Bỏ ghim"
                                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                              <Button.Style><Style TargetType="Button">
                                <Setter Property="Content" Value="📌"/><Setter Property="Opacity" Value="0.3"/>
                                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers>
                              </Style></Button.Style>
                            </Button>
                          </StackPanel>
                          <WrapPanel>
                            <TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="#DC2626"/><TextBlock Text=" · " FontSize="11" Foreground="#94A3B8"/>
                            <Border CornerRadius="999" Padding="5,2" Margin="0,0,0,0">
                              <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F1F5F9"/><Style.Triggers><DataTrigger Binding="{Binding PriorityText}" Value="Cao"><Setter Property="Background" Value="#FEF2F2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                              <TextBlock Text="{Binding PriorityText}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                            </Border>
                          </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="8,0,0,0">
                          <TextBlock Text="{Binding ElapsedText}" FontSize="11" Foreground="#94A3B8" TextAlignment="Right"/>
                            <Border CornerRadius="999" Padding="4,2" Background="#DC2626" Margin="4,0,0,0" Visibility="{Binding IsGrouped, Converter={StaticResource B2V}}"><TextBlock Text="{Binding GroupCount}" FontSize="9" FontWeight="Bold" Foreground="White"/></Border>
                          <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" TextAlignment="Right" Margin="0,2,0,0" Visibility="{Binding IsUnread, Converter={StaticResource B2V}}" Text="Chưa đọc"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Itm" Property="Background" Value="#EFF6FF"/></DataTrigger></DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Tab: Manager -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsInboxTabManager, Converter={StaticResource B2V}}">
              <ItemsControl ItemsSource="{Binding ManagerInboxItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="Itm2" Padding="12,10" BorderBrush="#EDF3F9" BorderThickness="0,0,0,1" Cursor="Hand" MouseLeftButtonDown="OnInboxItemClick">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Margin="0,0,10,0" VerticalAlignment="Top" Background="#EFF6FF"><TextBlock Text="{Binding TypeIcon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1">
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="7" Height="7" CornerRadius="50" Background="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding IsUnread, Converter={StaticResource B2V}}"/>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            <Button Width="20" Height="20" FontSize="11" Padding="0" Cursor="Hand" ToolTip="Ghim / Bỏ ghim"
                                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                              <Button.Style><Style TargetType="Button">
                                <Setter Property="Content" Value="📌"/><Setter Property="Opacity" Value="0.3"/>
                                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers>
                              </Style></Button.Style>
                            </Button>
                          </StackPanel>
                          <WrapPanel>
                            <TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="#2563EB"/><TextBlock Text=" · " FontSize="11" Foreground="#94A3B8"/>
                            <Border CornerRadius="999" Padding="5,2" Margin="0,0,0,0">
                              <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F1F5F9"/><Style.Triggers><DataTrigger Binding="{Binding PriorityText}" Value="Cao"><Setter Property="Background" Value="#FEF2F2"/></DataTrigger><DataTrigger Binding="{Binding PriorityText}" Value="Khẩn cấp"><Setter Property="Background" Value="#FEF2F2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                              <TextBlock Text="{Binding PriorityText}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                            </Border>
                          </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="8,0,0,0">
                          <TextBlock Text="{Binding ElapsedText}" FontSize="11" Foreground="#94A3B8" TextAlignment="Right"/>
                            <Border CornerRadius="999" Padding="4,2" Background="#DC2626" Margin="4,0,0,0" Visibility="{Binding IsGrouped, Converter={StaticResource B2V}}"><TextBlock Text="{Binding GroupCount}" FontSize="9" FontWeight="Bold" Foreground="White"/></Border>
                          <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" TextAlignment="Right" Margin="0,2,0,0" Visibility="{Binding IsUnread, Converter={StaticResource B2V}}" Text="Chưa đọc"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Itm2" Property="Background" Value="#EFF6FF"/></DataTrigger></DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Tab: History with sub-tabs -->
            <Grid Grid.Row="1" Visibility="{Binding IsInboxTabHistory, Converter={StaticResource B2V}}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,4">
                <Button Content="Đã đọc" Command="{Binding NavigateHistoryTabCommand}" CommandParameter="0" Height="28" FontSize="11" FontWeight="SemiBold" Padding="10,0" Margin="0,0,4,0" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#64748B">
                  <Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsHistoryTabRead}" Value="True"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Content="Đã xử lý" Command="{Binding NavigateHistoryTabCommand}" CommandParameter="1" Height="28" FontSize="11" FontWeight="SemiBold" Padding="10,0" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#64748B">
                  <Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsHistoryTabDone}" Value="True"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsHistoryTabRead, Converter={StaticResource B2V}}">
                <ItemsControl ItemsSource="{Binding ReadHistoryItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="12,10" BorderBrush="#EDF3F9" BorderThickness="0,0,0,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Margin="0,0,10,0" Background="#EFF6FF"><TextBlock Text="{Binding TypeIcon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            <Button Width="20" Height="20" FontSize="11" Padding="0" Cursor="Hand" ToolTip="Ghim / Bỏ ghim"
                                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                              <Button.Style><Style TargetType="Button">
                                <Setter Property="Content" Value="📌"/><Setter Property="Opacity" Value="0.3"/>
                                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers>
                              </Style></Button.Style>
                            </Button>
                            <WrapPanel><TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="#2563EB"/><TextBlock Text=" · " FontSize="11" Foreground="#94A3B8"/><Border CornerRadius="999" Padding="5,2" Background="#EFF6FF"><TextBlock Text="Đã đọc" FontSize="10" FontWeight="SemiBold" Foreground="#2563EB"/></Border></WrapPanel>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Top"/>
                            <Border CornerRadius="999" Padding="4,2" Background="#DC2626" Margin="4,0,0,0" Visibility="{Binding IsGrouped, Converter={StaticResource B2V}}"><TextBlock Text="{Binding GroupCount}" FontSize="9" FontWeight="Bold" Foreground="White"/></Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsHistoryTabDone, Converter={StaticResource B2V}}">
                <ItemsControl ItemsSource="{Binding DoneHistoryItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="12,10" BorderBrush="#EDF3F9" BorderThickness="0,0,0,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Margin="0,0,10,0" Background="#ECFDF3"><TextBlock Text="{Binding TypeIcon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            <Button Width="20" Height="20" FontSize="11" Padding="0" Cursor="Hand" ToolTip="Ghim / Bỏ ghim"
                                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                              <Button.Style><Style TargetType="Button">
                                <Setter Property="Content" Value="📌"/><Setter Property="Opacity" Value="0.3"/>
                                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers>
                              </Style></Button.Style>
                            </Button>
                            <WrapPanel><TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="#15803D"/><TextBlock Text=" · " FontSize="11" Foreground="#94A3B8"/><Border CornerRadius="999" Padding="5,2" Background="#ECFDF3"><TextBlock Text="Hoàn tất" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/></Border></WrapPanel>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Top"/>
                            <Border CornerRadius="999" Padding="4,2" Background="#DC2626" Margin="4,0,0,0" Visibility="{Binding IsGrouped, Converter={StaticResource B2V}}"><TextBlock Text="{Binding GroupCount}" FontSize="9" FontWeight="Bold" Foreground="White"/></Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#DDE7F3" BorderThickness="0,1,0,0" Height="40">
              <TextBlock FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding SystemInboxItems.Count, StringFormat={}{0} mục}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsInboxTabManager}" Value="True"><Setter Property="Text" Value="{Binding ManagerInboxItems.Count, StringFormat={}{0} mục}"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsInboxTabHistory}" Value="True">
                      <Setter Property="Text" Value="{Binding HistoryItems.Count, StringFormat={}{0} mục}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style></TextBlock.Style>
              </TextBlock>
            </Border>
          </Grid>
        </Border>

        <!-- DETAIL -->
        <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#DDE7F3" BorderThickness="1">
          <Grid>
            <Border Background="White" CornerRadius="12" BorderBrush="#DDE7F3" BorderThickness="1" Padding="20" Margin="16" Visibility="{Binding IsCreatingTask, Converter={StaticResource B2V}}" Panel.ZIndex="10">
              <StackPanel>
                <TextBlock Text="Tạo công việc mới" FontWeight="SemiBold" FontSize="16" Foreground="#0F172A" Margin="0,0,0,10"/>
                <!-- Quick templates -->
                <WrapPanel Margin="0,0,0,14">
                  <TextBlock Text="Mẫu nhanh:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Button Content="Kiểm kê kho" Height="26" FontSize="10" Padding="8,0" Margin="0,0,4,0" Cursor="Hand" Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1" Command="{Binding QuickCreateTaskCommand}" CommandParameter="{Binding TaskTemplates[0]}"/>
                  <Button Content="Đối soát quỹ" Height="26" FontSize="10" Padding="8,0" Margin="0,0,4,0" Cursor="Hand" Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1" Command="{Binding QuickCreateTaskCommand}" CommandParameter="{Binding TaskTemplates[1]}"/>
                  <Button Content="Báo cáo tuần" Height="26" FontSize="10" Padding="8,0" Margin="0,0,4,0" Cursor="Hand" Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1" Command="{Binding QuickCreateTaskCommand}" CommandParameter="{Binding TaskTemplates[2]}"/>
                  <Button Content="Định lượng món" Height="26" FontSize="10" Padding="8,0" Cursor="Hand" Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1" Command="{Binding QuickCreateTaskCommand}" CommandParameter="{Binding TaskTemplates[3]}"/>
                </WrapPanel>
                <!-- Row 1: Title + Priority -->
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Tiêu đề *" Style="{StaticResource AccountingFilterLabel}"/>
                    <TextBox Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="12" Style="{StaticResource EnterpriseModuleTextBox}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Mức độ ưu tiên" Style="{StaticResource AccountingFilterLabel}"/>
                    <ComboBox ItemsSource="{Binding TaskPriorityOptions}" SelectedItem="{Binding TaskPriority}" Height="34" FontSize="12" Style="{StaticResource EnterpriseModuleComboBox}"/>
                  </StackPanel>
                </Grid>
                <!-- Row 2: Assign to + Module -->
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Giao cho" Style="{StaticResource AccountingFilterLabel}"/>
                    <TextBox Text="{Binding TaskAssignedTo, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="12" Style="{StaticResource EnterpriseModuleTextBox}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Module liên quan" Style="{StaticResource AccountingFilterLabel}"/>
                    <TextBox Text="{Binding TaskModule, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="12" Style="{StaticResource EnterpriseModuleTextBox}"/>
                  </StackPanel>
                </Grid>
                <!-- Row 3: Start + Due dates -->
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Ngày bắt đầu" Style="{StaticResource AccountingFilterLabel}"/>
                    <DatePicker SelectedDate="{Binding TaskStartDate}" Height="34" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Hạn hoàn thành" Style="{StaticResource AccountingFilterLabel}"/>
                    <DatePicker SelectedDate="{Binding TaskDueDate}" Height="34" FontSize="12"/>
                  </StackPanel>
                </Grid>
                <!-- Description -->
                <TextBlock Text="Mô tả công việc" Style="{StaticResource AccountingFilterLabel}" Margin="0,4,0,4"/>
                <TextBox Text="{Binding TaskDescription, UpdateSourceTrigger=PropertyChanged}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="12" Style="{StaticResource EnterpriseModuleTextBox}" Margin="0,0,0,14"/>
                <!-- Buttons -->
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Content="Lưu công việc" Command="{Binding SaveTaskCommand}" Height="36" FontSize="12" Padding="20,0"/>
                  <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Content="Hủy" Command="{Binding ToggleCreateTaskCommand}" Height="36" FontSize="12" Padding="16,0" Margin="8,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Grid>
              <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsCreatingTask}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSelectedItem}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <Border Width="72" Height="72" CornerRadius="36" Background="#F1F5F9" HorizontalAlignment="Center"><TextBlock Text="&#x1F4EC;" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="Chọn một thông báo hoặc công việc" FontWeight="SemiBold" FontSize="15" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,16,0,0"/>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelectedItem, Converter={StaticResource B2V}}">
                <StackPanel Margin="22">
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="14" Background="#FEE2E2"><TextBlock Text="{Binding SelectedInboxItem.TypeIcon}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                      <TextBlock Text="{Binding SelectedInboxItem.Title}" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6"/>
                      <WrapPanel>
                        <Border CornerRadius="999" Padding="5,2" Background="#FEF2F2" Margin="0,0,6,3"><TextBlock Text="{Binding SelectedInboxItem.TypeText}" FontSize="10" FontWeight="SemiBold" Foreground="#DC2626"/></Border>
                        <Border CornerRadius="999" Padding="5,2" Background="#EFF6FF" Margin="0,0,6,3"><TextBlock Text="{Binding SelectedInboxItem.PriorityText}" FontSize="10" FontWeight="SemiBold" Foreground="#2563EB"/></Border>
                        <Border CornerRadius="999" Padding="5,2" Background="#ECFDF3" Margin="0,0,6,3"><TextBlock Text="{Binding SelectedInboxItem.StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/></Border>
                      </WrapPanel>
                      <!-- Reactions -->
                      <WrapPanel Margin="0,8,0,0">
                        <Button Content="👍" Width="32" Height="28" FontSize="14" Padding="0" Margin="0,0,4,0" Cursor="Hand" Background="#F1F5F9" BorderThickness="0" ToolTip="Thích" Command="{Binding AddReactionCommand}" CommandParameter="👍"/>
                        <Button Content="✅" Width="32" Height="28" FontSize="14" Padding="0" Margin="0,0,4,0" Cursor="Hand" Background="#F1F5F9" BorderThickness="0" ToolTip="Đã xong" Command="{Binding AddReactionCommand}" CommandParameter="✅"/>
                        <Button Content="❤️" Width="32" Height="28" FontSize="14" Padding="0" Margin="0,0,4,0" Cursor="Hand" Background="#F1F5F9" BorderThickness="0" ToolTip="Yêu thích" Command="{Binding AddReactionCommand}" CommandParameter="❤️"/>
                        <Button Content="🔥" Width="32" Height="28" FontSize="14" Padding="0" Margin="0,0,4,0" Cursor="Hand" Background="#F1F5F9" BorderThickness="0" ToolTip="Quan trọng" Command="{Binding AddReactionCommand}" CommandParameter="🔥"/>
                        <Button Content="👀" Width="32" Height="28" FontSize="14" Padding="0" Cursor="Hand" Background="#F1F5F9" BorderThickness="0" ToolTip="Đang xem" Command="{Binding AddReactionCommand}" CommandParameter="👀"/>
                      </WrapPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource EnterpriseModuleCmdSecondary}" Content="Đánh dấu đã đọc" Command="{Binding MarkReadCommand}" Height="32" FontSize="11" Padding="10,0"/>
                  </Grid>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                      <Border BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="Nội dung" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,8"/><TextBlock Text="{Binding SelectedInboxItem.Description}" FontSize="13" Foreground="#0F172A" TextWrapping="Wrap" LineHeight="20"/></StackPanel></Border>
                      <Border BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="Lịch sử xử lý" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding SelectedTimeline}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Time, StringFormat=dd/MM HH:mm}" FontSize="11" Foreground="#94A3B8"/><Border Grid.Column="1" Width="6" Height="6" CornerRadius="3" Background="#2563EB" Margin="4,4,0,0"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding Action}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A"/><TextBlock Text="{Binding Actor}" FontSize="10" Foreground="#94A3B8"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                      <!-- Chat Box -->
                      <Border BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="10" Padding="0" Margin="0,10,0,0" Background="#F9FAFB">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                          <TextBlock Grid.Row="0" Text="Binh luan" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A" Margin="14,12,14,0"/>
                          <Border Grid.Row="1" MaxHeight="160" Margin="14,8,14,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                              <ItemsControl ItemsSource="{Binding CommentList}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                  <StackPanel Margin="0,0,0,8">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding IsMine}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <Border MaxWidth="280" Padding="10,7" CornerRadius="10,10,10,2">
                                      <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F1F5F9"/><Style.Triggers><DataTrigger Binding="{Binding IsMine}" Value="True"><Setter Property="Background" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                      <StackPanel>
                                        <TextBlock FontSize="10" FontWeight="SemiBold" Margin="0,0,0,3"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Sender}"/><Setter Property="Foreground" Value="#2563EB"/><Style.Triggers><DataTrigger Binding="{Binding IsMine}" Value="True"><Setter Property="Foreground" Value="#BFDBFE"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        <TextBlock FontSize="12" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="18"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#0F172A"/><Style.Triggers><DataTrigger Binding="{Binding IsMine}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        <TextBlock FontSize="9" Margin="0,3,0,0" Text="{Binding TimeText}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding IsMine}" Value="True"><Setter Property="Foreground" Value="#93C5FD"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                      </StackPanel>
                                    </Border>
                                  </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </ScrollViewer>
                          </Border>
                          <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Background="White" Padding="10,8" CornerRadius="0,0,10,10">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <TextBox Grid.Column="0" Text="{Binding NewCommentText, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="12" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0"/>
                              <Button Grid.Column="1" Content="Gui" Command="{Binding AddCommentCommand}" Style="{StaticResource EnterpriseModuleCmdPrimary}" Height="34" FontSize="12" Padding="14,0"/>
                            </Grid>
                          </Border>
                        </Grid>
                      </Border>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="Hành động" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,10"/><Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Content="Mở module" Command="{Binding OpenRelatedModuleCommand}" Margin="0,0,0,6"/><Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Content="Tiếp nhận định lượng" Command="{Binding ReceiveQuantificationCommand}" Visibility="{Binding CanReceiveQuantification, Converter={StaticResource B2V}}" Margin="0,0,0,6"/><Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Content="Hoàn thành chuẩn bị" Command="{Binding CompleteQuantificationCommand}" Visibility="{Binding CanCompleteQuantification, Converter={StaticResource B2V}}" Margin="0,0,0,6"/><Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Content="Giao cho tôi" Command="{Binding AssignToMeCommand}" Margin="0,0,0,6"/><Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Content="Hoàn tất" Command="{Binding CompleteCommand}" Margin="0,0,0,6"/><Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Content="⏰ Tạm hoãn 30 phút" Command="{Binding SnoozeCommand}" CommandParameter="30" Margin="0,0,0,6"/></StackPanel></Border>
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>

        <!-- FLOATING PANELS (ZIndex, inside content grid) -->
        <Grid Panel.ZIndex="30" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Border Width="340" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="14">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsKpiPanelOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel Margin="14,12">
              <Border Background="White" CornerRadius="10" BorderBrush="#E8ECF0" BorderThickness="1" Padding="14" Margin="0,0,0,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#F1EAFF" Margin="0,0,10,0"><TextBlock Text="&#x1F514;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Chưa đọc" FontSize="12" Foreground="#64748B" FontWeight="Bold"/><TextBlock Text="{Binding UnreadCount}" FontSize="24" FontWeight="SemiBold" Foreground="#7C3AED"/></StackPanel>
                </Grid>
              </Border>
              <Border Background="White" CornerRadius="10" BorderBrush="#E8ECF0" BorderThickness="1" Padding="14" Margin="0,0,0,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#FFF7E6" Margin="0,0,10,0"><TextBlock Text="&#x1F4C5;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Cần xử lý hôm nay" FontSize="12" Foreground="#64748B" FontWeight="Bold"/><TextBlock Text="{Binding DueTodayCount}" FontSize="24" FontWeight="SemiBold" Foreground="#F59E0B"/></StackPanel>
                </Grid>
              </Border>
              <Border Background="White" CornerRadius="10" BorderBrush="#E8ECF0" BorderThickness="1" Padding="14" Margin="0,0,0,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#EAF2FF" Margin="0,0,10,0"><TextBlock Text="&#x1F4CB;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Công việc đang mở" FontSize="12" Foreground="#64748B" FontWeight="Bold"/><TextBlock Text="{Binding OpenTaskCount}" FontSize="24" FontWeight="SemiBold" Foreground="#2563EB"/></StackPanel>
                </Grid>
              </Border>
              <Border Background="White" CornerRadius="10" BorderBrush="#E8ECF0" BorderThickness="1" Padding="14" Margin="0,0,0,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#FEE2E2" Margin="0,0,10,0"><TextBlock Text="&#x23F0;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Quá hạn" FontSize="12" Foreground="#64748B" FontWeight="Bold"/><TextBlock Text="{Binding OverdueCount}" FontSize="24" FontWeight="SemiBold" Foreground="#DC2626"/></StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <Border Width="340" Margin="0,58,0,0" Background="White" BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="14" Padding="14">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsFilterPanelOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel>
              <TextBlock Text="Bộ lọc" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,10"/>
              <TextBlock Text="Tìm kiếm" Style="{StaticResource AccountingFilterLabel}"/>
              <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="12" Margin="0,0,0,8" Style="{StaticResource EnterpriseModuleTextBox}"/>
              <TextBlock Text="Loại" Style="{StaticResource AccountingFilterLabel}"/>
              <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedTypeFilter}" Height="34" FontSize="12" Margin="0,0,0,8" Style="{StaticResource EnterpriseModuleComboBox}"/>
              <TextBlock Text="Trạng thái" Style="{StaticResource AccountingFilterLabel}"/>
              <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" Height="34" FontSize="12" Margin="0,0,0,8" Style="{StaticResource EnterpriseModuleComboBox}"/>
              <TextBlock Text="Mức độ" Style="{StaticResource AccountingFilterLabel}"/>
              <ComboBox ItemsSource="{Binding PriorityFilters}" SelectedItem="{Binding SelectedPriorityFilter}" Height="34" FontSize="12" Margin="0,0,0,10" Style="{StaticResource EnterpriseModuleComboBox}"/>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="Từ ngày" Style="{StaticResource AccountingFilterLabel}"/><DatePicker SelectedDate="{Binding FilterFromDate}" Height="34" FontSize="12"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Đến ngày" Style="{StaticResource AccountingFilterLabel}"/><DatePicker SelectedDate="{Binding FilterToDate}" Height="34" FontSize="12"/></StackPanel>
              </Grid>
              <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Content="Áp dụng" Height="34" FontSize="12" Command="{Binding ApplyFilterCommand}"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- TOAST NOTIFICATION -->
    <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
            Panel.ZIndex="100" Width="340" Background="White" CornerRadius="12" BorderBrush="#DDE7F3" BorderThickness="1"
            Visibility="{Binding ShowToast, Converter={StaticResource B2V}}">
      <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.12"/></Border.Effect>
      <Grid Margin="16,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="{Binding ToastIcon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding ToastTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
          <Button Content="×" Cursor="Hand" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#94A3B8"
                  HorizontalAlignment="Right" Command="{Binding DismissToastCommand}"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{Binding ToastMessage}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <ProgressBar Grid.Row="2" Height="3" Value="100" Foreground="#2563EB" Background="#E5E7EB"/>
      </Grid>
    </Border>

    <!-- AI Suggestions -->
      <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,80" Panel.ZIndex="99" MaxWidth="360"
              Visibility="{Binding AiSuggestions.Count, Converter={StaticResource B2V}, FallbackValue=Collapsed}">
        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding AiSuggestions.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <Border Background="White" CornerRadius="12" BorderBrush="#DDE7F3" BorderThickness="1" Padding="16,14">
          <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.1"/></Border.Effect>
          <StackPanel>
            <TextBlock Text="🤖 AI Trợ lý" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding AiSuggestions}">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock FontSize="12" Foreground="#475569" Text="{Binding}" Margin="0,0,0,4" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Border>
      <TextBlock Grid.Row="2" Style="{StaticResource CaptionTextStyle}" Margin="18,6,18,8">
      <Run Text="{Binding StatusMessage, Mode=OneWay}"/><Run Text="  |  "/><Run Text="Ctrl+N Tạo việc · Ctrl+R Làm mới · Ctrl+D Đọc tất cả" FontSize="10" Foreground="#94A3B8"/>
    </TextBlock>
  </Grid>
</UserControl>
