<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ASMILE.BO.App.Views.Banquet.BanquetDashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <!-- KPI Row -->
    <UniformGrid Columns="6" Margin="0,0,0,12">
      <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,6,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,12,0"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Tiệc hôm nay" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Dashboard.TodayEvents}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text=" tiệc" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/></StackPanel></StackPanel></Grid></Border>
      <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,6,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource SuccessLightBrush}" Margin="0,0,12,0"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Khách dự kiến" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Dashboard.ExpectedGuests}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text=" khách" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/></StackPanel></StackPanel></Grid></Border>
      <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,6,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,12,0"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Doanh thu dự kiến" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ForecastRevenue, StringFormat={}{0:N0} đ}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/></StackPanel></Grid></Border>
      <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,6,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource SuccessLightBrush}" Margin="0,0,12,0"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Đặt cọc hôm nay" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding Dashboard.TodayDeposits, StringFormat={}{0:N0} đ}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/></StackPanel></Grid></Border>
      <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,6,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource WarningLightBrush}" Margin="0,0,12,0"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Tiệc chưa chốt" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding UpcomingEventsCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text=" tiệc" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/></StackPanel></StackPanel></Grid></Border>
      <Border Style="{StaticResource KpiCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource DangerLightBrush}" Margin="0,0,12,0"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Cảnh báo lịch" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ImportantAlertCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text=" tiệc trùng" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/></StackPanel></StackPanel></Grid></Border>
    </UniformGrid>

    <!-- Main Row -->
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
      <!-- Event List -->
      <Border Grid.Column="0" Style="{StaticResource CardStyle}"><StackPanel>
        <TextBlock Text="DANH SÁCH SỰ KIỆN" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <Button Content="Tất cả" Style="{StaticResource FilterBtnActiveStyle}" Margin="0,0,6,0"/>
          <Button Content="Hôm nay" Style="{StaticResource FilterBtnStyle}" Margin="0,0,6,0"/>
          <Button Content="Tuần này" Style="{StaticResource FilterBtnStyle}" Margin="0,0,6,0"/>
          <Button Content="Tháng này" Style="{StaticResource FilterBtnStyle}"/>
        </StackPanel>
        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Style="{StaticResource SearchBoxStyle}" Width="310" Text="{Binding EventSearchText, UpdateSourceTrigger=PropertyChanged}"/>
          <Button Grid.Column="1" Width="38" Height="38" Content="&#xE71B;" FontFamily="Segoe MDL2 Assets" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand" Template="{StaticResource BtnTemplate}"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding FilteredEvents}" MaxHeight="480">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Command="{Binding DataContext.SelectEvent, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
              <Border Background="White" CornerRadius="10" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                  <Grid><TextBlock Text="{Binding EventType}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Border HorizontalAlignment="Right" Height="24" Padding="8,0" CornerRadius="8"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SubtleBgBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Confirmed"><Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Pending"><Setter Property="Background" Value="{StaticResource WarningLightBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Confirmed"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Pending"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                  </Grid>
                  <TextBlock Text="{Binding CustomerName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0"/><TextBlock Text="{Binding EventDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0"/><TextBlock Text="{Binding StartTime, StringFormat={}{0:hh\\:mm}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                </StackPanel>
              </Border>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel></Border>

      <!-- Event Detail -->
      <Border Grid.Column="2" Style="{StaticResource CardStyle}">
        <Grid>
          <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding SelectedEvent}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Grid Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedEvent.EventType}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text=" - " FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="{Binding SelectedEvent.CustomerName}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Sửa" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="In hợp đồng" Style="{StaticResource GhostButtonStyle}"/></StackPanel></Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><StackPanel Orientation="Horizontal" Margin="0,0,20,0"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/><TextBlock Text="{Binding SelectedEvent.EventDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,20,0"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/><TextBlock Text="{Binding StartTimeText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,20,0"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/><TextBlock Text="{Binding SelectedEvent.RoomName}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/><TextBlock Text="{Binding SelectedEvent.GuestCount, StringFormat={}{0} khách}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></StackPanel>
            <UniformGrid Columns="3" Margin="0,0,0,12">
              <Border Background="{StaticResource SubtleBgBrush}" CornerRadius="10" Padding="16" Margin="0,0,6,0"><StackPanel><TextBlock Text="KHÁCH HÀNG" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/><TextBlock Text="Họ tên" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding SelectedEvent.CustomerName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/><TextBlock Text="Điện thoại" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding SelectedEvent.Phone}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/></StackPanel></Border>
              <Border Background="{StaticResource SubtleBgBrush}" CornerRadius="10" Padding="16" Margin="0,0,6,0"><StackPanel><TextBlock Text="SỰ KIỆN" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/><TextBlock Text="Loại" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding SelectedEvent.EventType}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/><TextBlock Text="Sảnh" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding SelectedEvent.RoomName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/></StackPanel></Border>
              <Border Background="{StaticResource SubtleBgBrush}" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="TÀI CHÍNH" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/><TextBlock Text="Tổng" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding SelectedEvent.TotalAmount, StringFormat={}{0:N0} đ}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/><TextBlock Text="Đã cọc" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding SelectedEvent.DepositAmount, StringFormat={}{0:N0} đ}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/></StackPanel></Border>
            </UniformGrid>
            <TabControl SelectedIndex="{Binding SelectedDetailTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0"><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="0,12"/><Setter Property="Margin" Value="0,0,16,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#334155"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Header}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources>
              <TabItem Header="Thông tin"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8"><TextBlock Text="Loại sự kiện" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"/><ComboBox ItemsSource="{Binding EventTypeOptions}" Text="{Binding EventType, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" Background="White" BorderBrush="{StaticResource BorderInputBrush}" BorderThickness="1"/><TextBlock Text="Tên khách hàng" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"/><TextBox Text="{Binding EventCustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/><TextBlock Text="Số điện thoại" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"/><TextBox Text="{Binding EventPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/><TextBlock Text="Ngày tổ chức" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"/><DatePicker SelectedDate="{Binding EventDate, UpdateSourceTrigger=PropertyChanged}" Height="36"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Bắt đầu" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding StartTimeText}" Style="{StaticResource InputStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Kết thúc" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding EndTimeText}" Style="{StaticResource InputStyle}"/></StackPanel></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Số khách" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding GuestCount}" Style="{StaticResource InputStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Số bàn" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding TableCount}" Style="{StaticResource InputStyle}"/></StackPanel></Grid><TextBlock Text="Phòng" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"/><ComboBox ItemsSource="{Binding Rooms}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedEventRoomId}" Height="36" Padding="10,0" Background="White" BorderBrush="{StaticResource BorderInputBrush}" BorderThickness="1"/><TextBlock Text="Trạng thái" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"/><ComboBox ItemsSource="{Binding EventStatusOptions}" SelectedItem="{Binding EventStatus}" Height="36" Padding="10,0" Background="White" BorderBrush="{StaticResource BorderInputBrush}" BorderThickness="1"/><TextBlock Text="Ghi chú" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"/><TextBox Text="{Binding EventNote, UpdateSourceTrigger=PropertyChanged}" Height="60" Padding="10,8" Background="White" BorderBrush="{StaticResource BorderInputBrush}" BorderThickness="1" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel></ScrollViewer></TabItem>
              <TabItem Header="Thực đơn"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8"><TextBlock Text="Gói thực đơn" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding MenuPackages}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F8FAFC" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="{Binding Price, StringFormat={}{0:N0} đ}" FontSize="12" Foreground="#0F766E" Margin="0,3,0,0"/></StackPanel><Button Content="Gán" Width="52" Height="28" FontSize="11" Background="{StaticResource PrimaryLightBrush}" Foreground="{StaticResource PrimaryBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.AttachMenuPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Template="{StaticResource BtnTemplate}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Đã gán" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,8"/><ItemsControl ItemsSource="{Binding EventMenus}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding PackageName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Margin="0,2,0,0" FontSize="11"><Run Text="{Binding GuestCount, StringFormat={}{0} khách}" Foreground="{StaticResource TextMutedBrush}"/><Run Text=" · " Foreground="#CBD5E1"/><Run Text="{Binding Amount, StringFormat={}{0:N0} đ}" Foreground="#0F766E" FontWeight="SemiBold"/></TextBlock></StackPanel><Button Grid.Column="1" Content="&#xE74D;" Width="24" Height="24" FontFamily="Segoe MDL2 Assets" FontSize="10" Background="Transparent" Foreground="{StaticResource DangerBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.DetachMenuPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem>
              <TabItem Header="Dịch vụ"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8"><TextBlock Text="Dịch vụ đã chọn" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding EventServices}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Description}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"><Run Text="{Binding Qty, StringFormat={}{0:N0}}"/><Run Text=" x "/><Run Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}"/></TextBlock></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Amount, StringFormat={}{0:N0} đ}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0"/><Button Content="&#xE74D;" Width="24" Height="24" FontFamily="Segoe MDL2 Assets" FontSize="10" Background="Transparent" Foreground="{StaticResource DangerBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.DeleteServiceLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Separator Margin="0,12" Background="{StaticResource DividerBrush}"/><TextBlock Text="Thêm dịch vụ" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/><TextBox Text="{Binding ServiceDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,0,0,6"/><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="80"/><ColumnDefinition Width="6"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding ServiceTypeOptions}" Text="{Binding ServiceType, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,0" Background="White" BorderBrush="{StaticResource BorderInputBrush}" BorderThickness="1"/><TextBox Grid.Column="2" Text="{Binding ServiceUnitPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" ToolTip="Đơn giá bán"/><TextBox Grid.Column="4" Text="{Binding ServiceCostPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" ToolTip="Giá vốn"/></Grid><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ServiceQty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/><TextBox Grid.Column="2" Text="{Binding ServiceNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/><Button Grid.Column="4" Content="Thêm" Style="{StaticResource PrimaryButtonStyle}" Height="36" MinWidth="60" Command="{Binding SaveServiceLineCommand}"/></Grid></StackPanel></ScrollViewer></TabItem>
              <TabItem Header="Checklist"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8"><TextBlock Text="Danh sách" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding ChecklistItems}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Center" Margin="0,0,8,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="{Binding Note}" FontSize="10" Foreground="{StaticResource TextDisabledBrush}" Margin="0,2,0,0"/></StackPanel><Button Grid.Column="2" Content="&#xE74D;" Width="24" Height="24" FontFamily="Segoe MDL2 Assets" FontSize="10" Background="Transparent" Foreground="{StaticResource DangerBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.DeleteChecklistItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Separator Margin="0,12" Background="{StaticResource DividerBrush}"/><TextBlock Text="Thêm mục" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/><TextBox Text="{Binding NewChecklistTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,0,0,6"/><TextBox Text="{Binding NewChecklistNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,0,0,10"/><Button Content="Thêm" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveChecklistItemCommand}"/></StackPanel></ScrollViewer></TabItem>
              <TabItem Header="Timeline"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8"><ItemsControl ItemsSource="{Binding EventTimelineItems}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StartTime, StringFormat={}{0:hh\\:mm}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Width="48" HorizontalAlignment="Right"/><Grid Grid.Column="1" Margin="12,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource PrimaryBrush}" Margin="0,4,8,0" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding ResponsiblePerson}" FontSize="10" Foreground="{StaticResource TextDisabledBrush}" Margin="0,3,0,0"/></StackPanel></Grid><StackPanel Grid.Column="2" VerticalAlignment="Top"><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{StaticResource PrimaryBrush}"/><Button Content="&#xE74D;" Width="20" Height="20" FontFamily="Segoe MDL2 Assets" FontSize="9" Background="Transparent" Foreground="{StaticResource DangerBrush}" BorderThickness="0" Cursor="Hand" Margin="0,4,0,0" Command="{Binding DataContext.DeleteTimelineItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Separator Margin="0,12" Background="{StaticResource DividerBrush}"/><TextBlock Text="Thêm mốc" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding TimelineStartTimeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/><TextBox Grid.Column="2" Text="{Binding TimelineTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/></Grid><TextBox Text="{Binding TimelineDescription, UpdateSourceTrigger=PropertyChanged}" Height="50" Padding="10,8" Background="White" BorderBrush="{StaticResource BorderInputBrush}" BorderThickness="1" Margin="0,0,0,6" TextWrapping="Wrap" AcceptsReturn="True"/><TextBox Text="{Binding TimelineResponsiblePerson, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,0,0,10"/><Button Content="Thêm" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveTimelineItemCommand}"/></StackPanel></ScrollViewer></TabItem>
              <TabItem Header="Tài chính"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8"><TextBlock Text="Lịch sử đặt cọc" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding EventDeposits}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F8FAFC" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Amount, StringFormat={}{0:N0} đ}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock Text="{Binding PaymentMethod}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text=" · " FontSize="11" Foreground="#CBD5E1"/><TextBlock Text="{Binding DepositDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Separator Margin="0,12" Background="{StaticResource DividerBrush}"/><TextBlock Text="Ghi nhận đặt cọc" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/><TextBlock Text="Số tiền" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding DepositAmount, UpdateSourceTrigger=PropertyChanged}" Height="44" Padding="10,0" Background="White" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderInputBrush}" BorderThickness="1" Margin="0,0,0,6"/><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Phương thức" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding PaymentMethodOptions}" SelectedItem="{Binding DepositPaymentMethod}" Height="36" Padding="8,0" Background="White" BorderBrush="{StaticResource BorderInputBrush}" BorderThickness="1"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Người nhận" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding DepositReceiver, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/></StackPanel></Grid><TextBox Text="{Binding DepositNote, UpdateSourceTrigger=PropertyChanged}" Height="50" Padding="10,8" Background="White" BorderBrush="{StaticResource BorderInputBrush}" BorderThickness="1" Margin="0,0,0,10" TextWrapping="Wrap" AcceptsReturn="True"/><Button Content="Xác nhận đặt cọc" Style="{StaticResource PrimaryButtonStyle}" Height="40" Command="{Binding AddDepositCommand}"/></StackPanel></ScrollViewer></TabItem>
              <TabItem Header="Hợp đồng"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8"><TextBlock Text="Danh sách" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding EventContracts}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F8FAFC" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6"><StackPanel><Grid><TextBlock Text="{Binding ContractNo}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><Border HorizontalAlignment="Right" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Signed"><Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Draft"><Setter Property="Background" Value="{StaticResource WarningLightBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/></Border></Grid><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding SignDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text=" · " FontSize="11" Foreground="#CBD5E1"/><TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0} đ}" FontSize="11" FontWeight="SemiBold" Foreground="#0F766E"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Separator Margin="0,12" Background="{StaticResource DividerBrush}"/><TextBlock Text="Tạo hợp đồng" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/><TextBlock Text="Ngày ký" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/><DatePicker SelectedDate="{Binding ContractSignDate}" Height="36" Margin="0,0,0,12"/><Button Content="Tạo hợp đồng" Style="{StaticResource PrimaryButtonStyle}" Height="40" Command="{Binding CreateContractCommand}"/></StackPanel></ScrollViewer></TabItem>
            </TabControl>
          </StackPanel>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="EmptyPanel">
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding SelectedEvent}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center"/><TextBlock Text="Chọn một sự kiện từ danh sách" FontSize="14" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Right panel -->
      <StackPanel Grid.Column="4"><Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"><StackPanel><Grid Margin="0,0,0,12"><TextBlock Text="LỊCH PHÒNG TIỆC" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/></Grid><Border Height="360" Background="{StaticResource SubtleBgBrush}" CornerRadius="8" Margin="0,0,0,12"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center"/><TextBlock Text="Lịch phòng tiệc" FontSize="13" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border><TextBlock Text="Cảnh báo lịch" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/><Border Background="{StaticResource DangerLightBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"/><TextBlock Text="Trùng lịch" FontSize="12" Foreground="{StaticResource DangerBrush}"/></StackPanel></Border></StackPanel></Border></StackPanel>
    </Grid>

    <Border Style="{StaticResource CardStyle}" Height="72" Padding="14"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,12,0"><TextBlock Text="60%" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Checklist công việc" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/><CheckBox Content="Nhận đặt cọc" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/><CheckBox Content="Xác nhận khách" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/><CheckBox Content="Chuẩn bị phòng" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/></StackPanel></Grid></Border>
  </StackPanel>
</UserControl>
