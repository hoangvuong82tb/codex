<Window x:Class="ASMILE.BO.App.Views.IncidentActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cập nhật sự cố" Width="520" Height="390" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="#F8FAFC">
    <Window.Resources>
        <Style x:Key="Input" TargetType="TextBox"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,0"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style>
        <Style x:Key="Secondary" TargetType="Button"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="Foreground" Value="#475569"/></Style>
        <Style x:Key="Primary" TargetType="Button"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="14,0"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="White"/></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock x:Name="DescriptionText" FontSize="11" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="PromptOneText" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/><TextBox x:Name="PromptOneBox" Style="{StaticResource Input}" TextWrapping="Wrap"/>
            <TextBlock x:Name="PromptTwoText" FontSize="11" Foreground="#475569" Margin="0,12,0,4"/><TextBox x:Name="PromptTwoBox" Style="{StaticResource Input}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Hủy" Click="OnCancel" Style="{StaticResource Secondary}" Margin="0,0,6,0"/><Button Content="Xác nhận" Click="OnSave" Style="{StaticResource Primary}"/></StackPanel>
    </Grid>
</Window>
