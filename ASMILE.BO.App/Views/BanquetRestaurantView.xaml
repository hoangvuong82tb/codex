                  <Grid Margin="14,12,14,10"><StackPanel><TextBlock Text="Tổng nguyên liệu" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"><Run Text="{Binding QuantificationIngredientCount, Mode=OneWay}"/><Run Text=" mặt hàng · Dự toán "/><Run Text="{Binding QuantificationEstimatedCost, Mode=OneWay, StringFormat={}{0:N0} đ}"/></TextBlock></StackPanel><TextBlock Text="Đã gồm tỷ lệ hao hụt trong công thức" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="10" Foreground="#047857"/></Grid>
                  <Grid Grid.Row="1" Background="#F7F9FC" Margin="1,0"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/><ColumnDefinition Width="100"/><ColumnDefinition Width="64"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="STT" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="Mã" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="2" Text="NGUYÊN LIỆU" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="3" Text="ĐV" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="4" Text="SL CẦN" TextAlignment="Right" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="5" Text="SỐ TIỆC" TextAlignment="Right" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="6" Text="DỰ TOÁN" TextAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/></Grid>
                  <ScrollViewer Grid.Row="2" MaxHeight="470" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><ItemsControl ItemsSource="{Binding QuantificationIngredients}" HorizontalAlignment="Stretch"><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><Grid MinHeight="36"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/><ColumnDefinition Width="100"/><ColumnDefinition Width="64"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><Border Grid.ColumnSpan="7" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"/><TextBlock Text="{Binding Sequence}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Code}" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Grid.Column="3" Text="{Binding UnitName}" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="4" Text="{Binding RequiredQuantity, StringFormat={}{0:N0}}" TextAlignment="Right" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#047857"/><TextBlock Grid.Column="5" Text="{Binding EventCount}" TextAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="6" Text="{Binding EstimatedCost, StringFormat={}{0:N0} đ}" TextAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                  <TextBlock Grid.Row="2" Text="Chưa có nguyên liệu để hiển thị." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding IsQuantificationIngredientsEmpty, Converter={StaticResource B2V}}"/>
                </Grid>
              </Border>

              <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardStyle}" Padding="0" MinHeight="250">
                  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="14,12,14,10"><TextBlock Text="Dịch vụ cần điều phối" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="Cộng theo số lượng dịch vụ trong từng tiệc" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
                    <Grid Grid.Row="1" Background="#F7F9FC" Margin="1,0"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/><ColumnDefinition Width="78"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><TextBlock Text="STT" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="DỊCH VỤ" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="2" Text="ĐV" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="3" Text="SL CẦN" TextAlignment="Right" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="4" Text="TIỆC" TextAlignment="Right" Margin="0,0,9,0" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/></Grid>
                    <ScrollViewer Grid.Row="2" MaxHeight="270" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><ItemsControl ItemsSource="{Binding QuantificationServices}" HorizontalAlignment="Stretch"><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><Grid MinHeight="38"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/><ColumnDefinition Width="78"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><Border Grid.ColumnSpan="5" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"/><TextBlock Text="{Binding Sequence}" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Code}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding UnitName}" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="3" Text="{Binding RequiredQuantity, StringFormat={}{0:N0}}" TextAlignment="Right" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/><TextBlock Grid.Column="4" Text="{Binding EventCount}" TextAlignment="Right" Margin="0,0,9,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    <TextBlock Grid.Row="2" Text="Chưa có dịch vụ cần điều phối." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding IsQuantificationServicesEmpty, Converter={StaticResource B2V}}"/>
                  </Grid>
                </Border>

                <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,12,0,0">
                  <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasQuantificationWarnings}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                  <StackPanel><Grid><StackPanel><TextBlock Text="Món chưa có công thức" FontSize="13" FontWeight="SemiBold" Foreground="#9A3412"/><TextBlock Text="Bổ sung tại module Món ăn &amp; Định lượng trước khi chốt nhập hàng." FontSize="10" Foreground="#C2410C" Margin="0,2,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FFEDD5" CornerRadius="10" Padding="8,3"><TextBlock Text="{Binding QuantificationMissingRecipeCount}" FontSize="10" FontWeight="Bold" Foreground="#C2410C"/></Border></Grid><ItemsControl ItemsSource="{Binding QuantificationMissingRecipes}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="{Binding MenuItemName}" VerticalAlignment="Center" FontSize="10.5" Foreground="#7C2D12" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding MenuQuantity, StringFormat={}{0:N0} suất}" TextAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#9A3412"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>

          <!-- ===== BÁO CÁO ===== -->
          <StackPanel>
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTabIndex}" Value="6"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Grid Margin="0,0,0,12"><StackPanel><TextBlock Text="Báo cáo hoạt động" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="Tổng hợp doanh thu, sự kiện và hiệu suất phòng từ dữ liệu đã lưu." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Làm mới" Command="{Binding RefreshBanquetReportsCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,8,0"/><Button Content="Xuất Excel" Command="{Binding ExportBanquetReportExcelCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="38" MinWidth="112"/></StackPanel></Grid>

            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Kỳ báo cáo" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><ComboBox ItemsSource="{Binding ReportPeriodOptions}" SelectedValuePath="Value" SelectedValue="{Binding ReportPeriodPreset}" Style="{StaticResource FilterChipCombo}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Từ ngày" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><DatePicker SelectedDate="{Binding ReportFromDate}" Style="{StaticResource FluentDatePicker}" Height="30"/></StackPanel>
              <StackPanel Grid.Column="4"><TextBlock Text="Đến ngày" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><DatePicker SelectedDate="{Binding ReportToDate}" Style="{StaticResource FluentDatePicker}" Height="30"/></StackPanel>
              <StackPanel Grid.Column="6"><TextBlock Text="Phòng tiệc" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><ComboBox ItemsSource="{Binding EventRoomFilterOptions}" SelectedValuePath="Value" SelectedValue="{Binding SelectedReportRoomId}" Style="{StaticResource FilterChipCombo}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
              <StackPanel Grid.Column="8"><TextBlock Text="Loại tiệc" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><ComboBox ItemsSource="{Binding EventTypeFilterOptions}" SelectedValuePath="Value" SelectedValue="{Binding SelectedReportEventType}" Style="{StaticResource FilterChipCombo}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
              <Grid Grid.Row="2" Grid.ColumnSpan="5"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Trạng thái" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><ComboBox ItemsSource="{Binding EventStatusFilterOptions}" SelectedValuePath="Value" SelectedValue="{Binding SelectedReportStatus}" Style="{StaticResource FilterChipCombo}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Tìm kiếm" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><TextBox Text="{Binding ReportSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="30"/></StackPanel><Button Grid.Column="4" Content="Đặt lại bộ lọc" Command="{Binding ResetReportFiltersCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="30" VerticalAlignment="Bottom"/></Grid>
              <TextBlock Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="3" Text="{Binding ReportStatusText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Right" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
            </Grid></Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Button Content="Tổng quan" Command="{Binding SetReportViewCommand}" CommandParameter="Overview" Height="34" MinWidth="92" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsReportOverviewView}" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Danh sách sự kiện" Command="{Binding SetReportViewCommand}" CommandParameter="Events" Height="34" MinWidth="126" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsReportEventsView}" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Hiệu suất phòng" Command="{Binding SetReportViewCommand}" CommandParameter="Rooms" Height="34" MinWidth="120"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsReportRoomsView}" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel>

            <UniformGrid Columns="4" Margin="0,0,0,12">
              <Border Style="{StaticResource CardStyle}" Padding="13" Margin="0,0,6,0"><StackPanel><TextBlock Text="TỔNG GIÁ TRỊ TIỆC" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ReportRevenue, StringFormat={}{0:N0} đ}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,2"/><TextBlock Text="{Binding ReportRevenueChangeText}" Foreground="{Binding ReportRevenueChangeBrush}" FontSize="10"/></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}" Padding="13" Margin="0,0,6,0"><StackPanel><TextBlock Text="SỰ KIỆN" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ReportTotalEvents, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,2"/><TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}"><Run Text="{Binding ReportConfirmedEvents, Mode=OneWay}"/><Run Text=" đã xác nhận"/></TextBlock></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}" Padding="13" Margin="0,0,6,0"><StackPanel><TextBlock Text="TỔNG KHÁCH" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ReportGuestCount, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,2"/><TextBlock Text="Lượt khách trong kỳ" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}" Padding="13" Margin="0,0,6,0"><StackPanel><TextBlock Text="TIỀN ĐẶT CỌC" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ReportDepositAmount, StringFormat={}{0:N0} đ}" FontSize="18" FontWeight="Bold" Foreground="#059669" Margin="0,5,0,2"/><TextBlock Text="Đã ghi nhận" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}" Padding="13" Margin="0,0,6,0"><StackPanel><TextBlock Text="CÒN PHẢI THU" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ReportOutstandingAmount, StringFormat={}{0:N0} đ}" FontSize="18" FontWeight="Bold" Foreground="#C2410C" Margin="0,5,0,2"/><TextBlock Text="Theo dữ liệu sự kiện" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}" Padding="13"><StackPanel><TextBlock Text="GIÁ TRỊ BÌNH QUÂN" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ReportAverageEventValue, StringFormat={}{0:N0} đ}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,2"/><TextBlock Text="Trên mỗi sự kiện" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}" Padding="13" Margin="0,6,6,0"><StackPanel><TextBlock Text="CHI PHÍ ƯỚC TÍNH" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ReportEstimatedCost, StringFormat={}{0:N0} đ}" FontSize="18" FontWeight="Bold" Foreground="#B45309" Margin="0,5,0,2"/><TextBlock Text="Dịch vụ và định lượng mua hàng" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}" Padding="13" Margin="0,6,0,0"><StackPanel><TextBlock Text="L&#195;I GỘP ƯỚC TÍNH" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ReportEstimatedGrossProfit, StringFormat={}{0:N0} đ}" FontSize="18" FontWeight="Bold" Foreground="#047857" Margin="0,5,0,2"/><TextBlock Text="{Binding ReportEstimatedGrossMarginRate, StringFormat=Biên lãi {0:P1}}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></Border>
            </UniformGrid>

            <Grid Visibility="{Binding IsReportOverviewView, Converter={StaticResource B2V}}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}" Padding="14" MinHeight="330"><StackPanel><TextBlock Text="Xu hướng doanh thu" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Doanh thu và số sự kiện theo từng mốc trong kỳ." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,12"/><ItemsControl ItemsSource="{Binding ReportTrends}"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="39" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding EventCount, StringFormat={}{0} tiệc}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/></StackPanel><Border Grid.Column="1" Height="14" Background="#EEF3FA" CornerRadius="4" VerticalAlignment="Center"><Border Width="{Binding BarWidth}" MaxWidth="260" Background="{StaticResource PrimaryBrush}" CornerRadius="4" HorizontalAlignment="Left"/></Border><TextBlock Grid.Column="2" Text="{Binding Revenue, StringFormat={}{0:N0} đ}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#0F766E"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Không có doanh thu trong kỳ đã chọn." Visibility="{Binding IsReportEventsEmpty, Converter={StaticResource B2V}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,70,0,0"/></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14" MinHeight="330"><StackPanel><TextBlock Text="Cơ cấu loại tiệc" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Tỷ trọng theo số lượng sự kiện." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,12"/><ItemsControl ItemsSource="{Binding ReportTypes}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="9" Height="32" CornerRadius="4" Background="{Binding AccentBrush}" Margin="0,0,9,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding EventTypeDisplay, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/><TextBlock FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"><Run Text="{Binding EventCount}"/><Run Text=" tiệc · "/><Run Text="{Binding GuestCount}"/><Run Text=" khách"/></TextBlock></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding ShareText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding Revenue, StringFormat={}{0:N0} đ}" FontSize="9.5" Foreground="#0F766E" HorizontalAlignment="Right"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="0"
                    Visibility="{Binding IsReportEventsView, Converter={StaticResource B2V}}"
                    ClipToBounds="True">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="42"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Background="#F6F8FB">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="105"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="STT" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="NGÀY / GIỜ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="LOẠI TIỆC" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="KHÁCH HÀNG" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="4" Text="PHÒNG" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="5" Text="SỐ KHÁCH" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="6" Text="TỔNG TIỀN" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="7" Text="TRẠNG THÁI" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding ReportEvents}"
                         SelectedItem="{Binding SelectedReportEventRow, Mode=TwoWay}"
                         AlternationCount="10000"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Margin" Value="0"/>
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderThickness" Value="0"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                      <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter Property="Background" Value="Transparent"/>
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="44" Background="Transparent" Cursor="Hand">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="105"/>
                          </Grid.ColumnDefinitions>
                          <Border Grid.ColumnSpan="8" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"/>
                          <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource OneBasedIndexConverter}}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EventDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="10.5" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StartTime, StringFormat={}{0:hh\\:mm}}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding EventTypeDisplay}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CustomerName}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding EventNo}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                          </StackPanel>
                          <TextBlock Grid.Column="4" Text="{Binding RoomName}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="5" Text="{Binding GuestCount, StringFormat={}{0:N0}}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                          <TextBlock Grid.Column="6" Text="{Binding TotalAmount, StringFormat={}{0:N0} đ}" FontSize="10" FontWeight="SemiBold" Foreground="#0F766E" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                          <Border Grid.Column="7" Background="#EAF2FF" CornerRadius="5" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusDisplay}" FontSize="9" Foreground="#1D4ED8"/>
                          </Border>
                        </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <Grid Visibility="{Binding IsReportRoomsView, Converter={StaticResource B2V}}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Padding="14"><StackPanel><TextBlock Text="Hiệu suất phòng / sảnh" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Tỷ lệ sử dụng tính theo hai ca mỗi ngày trong kỳ." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,12"/><ItemsControl ItemsSource="{Binding ReportRooms}"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="52"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="210"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding RoomName}" FontSize="11" FontWeight="SemiBold"/><TextBlock FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"><Run Text="{Binding EventCount}"/><Run Text=" tiệc · "/><Run Text="{Binding GuestCount}"/><Run Text=" khách"/></TextBlock></StackPanel><TextBlock Grid.Column="1" Text="{Binding UtilizationText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/><Border Grid.Column="2" Height="10" Background="#EEF3FA" CornerRadius="5" VerticalAlignment="Center" Margin="14,0"><Border Width="{Binding UtilizationWidth}" MaxWidth="180" Background="#2563EB" CornerRadius="5" HorizontalAlignment="Left"/></Border><TextBlock Grid.Column="3" Text="{Binding Revenue, StringFormat={}{0:N0} đ}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F766E" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14"><StackPanel><TextBlock Text="Gợi ý vận hành" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="• Ưu tiên bán các phòng có tỷ lệ sử dụng thấp." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,7"/><TextBlock Text="• Kiểm tra lại sức chứa trước khi xác nhận tiệc." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,7"/><TextBlock Text="• Dùng Lịch phòng để rà ca Trưa và ca Tối còn trống." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border></Grid>
          </StackPanel>

          <!-- ===== CÀI ĐẶT ===== -->
          <StackPanel>
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTabIndex}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Grid Margin="0,0,0,14"><StackPanel><TextBlock Text="Cài đặt Nhà hàng Tiệc" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="Thông tin đơn vị, quy tắc vận hành và tự động hóa dùng riêng cho module." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Tải lại" Command="{Binding ReloadBanquetSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,8,0"/><Button Content="Khôi phục mặc định" Command="{Binding ResetBanquetSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,8,0"/><Button Content="Lưu cấu hình" Command="{Binding SaveBanquetSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="38" MinWidth="120"/></StackPanel></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}" Padding="10"><StackPanel><TextBlock Text="NHÓM CẤU HÌNH" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="8,4,0,8"/><Button Content="Thông tin đơn vị" Command="{Binding SetBanquetSettingsSectionCommand}" CommandParameter="General" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="BorderThickness" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsBanquetGeneralSettings}" Value="True"><Setter Property="Background" Value="#EAF2FF"/><Setter Property="Foreground" Value="#1D4ED8"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Quy tắc vận hành" Command="{Binding SetBanquetSettingsSectionCommand}" CommandParameter="Operation" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="BorderThickness" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsBanquetOperationSettings}" Value="True"><Setter Property="Background" Value="#EAF2FF"/><Setter Property="Foreground" Value="#1D4ED8"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Tự động hóa" Command="{Binding SetBanquetSettingsSectionCommand}" CommandParameter="Automation" Height="40" HorizontalContentAlignment="Left" Padding="12,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="BorderThickness" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsBanquetAutomationSettings}" Value="True"><Setter Property="Background" Value="#EAF2FF"/><Setter Property="Foreground" Value="#1D4ED8"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Border Height="1" Background="{StaticResource DividerBrush}" Margin="4,14"/><TextBlock Text="{Binding BanquetSettingsSavedText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="8,0"/><TextBlock Text="{Binding BanquetSettingsValidationMessage}" FontSize="10" Foreground="#DC2626" TextWrapping="Wrap" Margin="8,8,8,0"/></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18" MinHeight="470">
                <Grid>
                  <StackPanel Visibility="{Binding IsBanquetGeneralSettings, Converter={StaticResource B2V}}"><TextBlock Text="Thông tin đơn vị" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Thông tin này được dùng trên báo cáo và biểu mẫu nghiệp vụ của Nhà hàng Tiệc." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="Tên đơn vị *" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><TextBox Text="{Binding BanquetVenueName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Mã đơn vị *" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><TextBox Text="{Binding BanquetVenueCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/></StackPanel>
                    <StackPanel Grid.Row="2"><TextBlock Text="Điện thoại" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><TextBox Text="{Binding BanquetVenuePhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Mã số thuế" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><TextBox Text="{Binding BanquetVenueTaxCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/></StackPanel>
                    <StackPanel Grid.Row="4"><TextBlock Text="Email" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><TextBox Text="{Binding BanquetVenueEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/></StackPanel><StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="Website" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><TextBox Text="{Binding BanquetVenueWebsite, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/></StackPanel>
                    <StackPanel Grid.Row="6" Grid.ColumnSpan="3"><TextBlock Text="Địa chỉ" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><TextBox Text="{Binding BanquetVenueAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/></StackPanel>
                  </Grid></StackPanel>

                  <StackPanel Visibility="{Binding IsBanquetOperationSettings, Converter={StaticResource B2V}}"><TextBlock Text="Quy tắc vận hành" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Giá trị mặc định dùng khi tạo sự kiện, giữ chỗ và lập báo giá." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,18"/><UniformGrid Columns="2"><StackPanel Margin="0,0,7,14"><TextBlock Text="Số khách tiêu chuẩn mỗi bàn" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><TextBox Text="{Binding BanquetGuestsPerTable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/></StackPanel><StackPanel Margin="7,0,0,14"><TextBlock Text="Tỷ lệ đặt cọc mặc định (%)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><TextBox Text="{Binding BanquetDefaultDepositRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/></StackPanel><StackPanel Margin="0,0,7,14"><TextBlock Text="Thuế VAT mặc định (%)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><TextBox Text="{Binding BanquetDefaultVatRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/></StackPanel><StackPanel Margin="7,0,0,14"><TextBlock Text="Thời hạn giữ chỗ (ngày)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><TextBox Text="{Binding BanquetHoldDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/></StackPanel><StackPanel Margin="0,0,7,14"><TextBlock Text="Giờ bắt đầu ca Trưa" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><TextBox Text="{Binding BanquetLunchStartTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/></StackPanel><StackPanel Margin="7,0,0,14"><TextBlock Text="Giờ bắt đầu ca Tối" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><TextBox Text="{Binding BanquetDinnerStartTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/></StackPanel><StackPanel Margin="0,0,7,0"><TextBlock Text="Nhắc công việc trước (ngày)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><TextBox Text="{Binding BanquetReminderDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/></StackPanel></UniformGrid></StackPanel>

                  <StackPanel Visibility="{Binding IsBanquetAutomationSettings, Converter={StaticResource B2V}}"><TextBlock Text="Tự động hóa và kiểm soát" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Bật các quy tắc bảo vệ dữ liệu và hỗ trợ theo dõi sự kiện." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,18"/>
                    <Border Background="#F7F9FC" CornerRadius="7" Padding="14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tự động tạo mã sự kiện" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Sinh mã mới khi tạo sự kiện, tránh nhập trùng thủ công." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding BanquetAutoGenerateEventNo}" Style="{StaticResource Win11SwitchStyle}" VerticalAlignment="Center"/></Grid></Border>
                    <Border Background="#F7F9FC" CornerRadius="7" Padding="14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ngăn trùng lịch phòng" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Cảnh báo khi hai sự kiện chồng thời gian trong cùng phòng." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding BanquetPreventRoomConflict}" Style="{StaticResource Win11SwitchStyle}" VerticalAlignment="Center"/></Grid></Border>
                    <Border Background="#F7F9FC" CornerRadius="7" Padding="14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Nhắc đặt cọc" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Đưa các tiệc chưa đặt cọc vào danh sách cảnh báo vận hành." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding BanquetEnableDepositReminder}" Style="{StaticResource Win11SwitchStyle}" VerticalAlignment="Center"/></Grid></Border>
                    <Border Background="#F7F9FC" CornerRadius="7" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Hiển thị sự kiện đã hoàn thành" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Giữ các sự kiện hoàn thành trên lịch và trong báo cáo." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding BanquetShowCompletedEvents}" Style="{StaticResource Win11SwitchStyle}" VerticalAlignment="Center"/></Grid></Border>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </StackPanel>

        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
