<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ASMILE.BO.App.Views.BanquetRestaurantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASMILE.BO.App.Controls"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             KeyboardNavigation.TabNavigation="Continue"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

  <UserControl.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewEventCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveEventCommand}" />
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="B2V" />
    <converters:VietnamCurrencyConverter x:Key="VietnamCurrency"/>
    <converters:OneBasedIndexConverter x:Key="OneBasedIndexConverter"/>

    <Style x:Key="TabButton" TargetType="TabItem" BasedOn="{StaticResource AccountingTabButton}"/>
    <Style x:Key="CmdAdd" TargetType="Button" BasedOn="{StaticResource AccountingCmdAdd}"/>
    <Style x:Key="CmdEdit" TargetType="Button" BasedOn="{StaticResource AccountingCmdEdit}"/>
    <Style x:Key="CmdDelete" TargetType="Button" BasedOn="{StaticResource AccountingCmdDelete}"/>
    <Style x:Key="CmdRefresh" TargetType="Button" BasedOn="{StaticResource AccountingCmdRefresh}"/>
    <Style x:Key="CmdExport" TargetType="Button" BasedOn="{StaticResource AccountingCmdExport}"/>

    <Style x:Key="FluentDatePicker" TargetType="DatePicker">
      <Setter Property="Height" Value="38"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#BFD4F1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FluentTextBox" TargetType="TextBox">
      <Setter Property="Height" Value="38"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="BorderBrush" Value="#BFD4F1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="#4F8AF7"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="#7AA7FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FluentTextBoxMulti" TargetType="TextBox" BasedOn="{StaticResource FluentTextBox}">
      <Setter Property="Height" Value="88"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>

    <Style x:Key="FilterChipCombo" TargetType="ComboBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderInputBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,0,28,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                <ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
              </Border>
              <ToggleButton Width="24" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                            Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </ToggleButton>
              <Popup Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ItemsPresenter/>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Win11SwitchStyle" TargetType="CheckBox">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="42" Height="22">
              <Border x:Name="SwitchTrack" Background="#CBD5E1" BorderBrush="#B8C3D1" BorderThickness="1" CornerRadius="11"/>
              <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Margin="3,0,0,0" HorizontalAlignment="Left" Fill="White">
                <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.18"/></Ellipse.Effect>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SwitchTrack" Property="Background" Value="#2563EB"/>
                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#2563EB"/>
                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="Opacity" Value="0.9"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ServiceStepperButton" TargetType="Button">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.86"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.68"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ServiceDeleteButton" TargetType="Button" BasedOn="{StaticResource ServiceStepperButton}">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
    </Style>
  </UserControl.Resources>

  <Grid Background="{StaticResource BgBrush}">
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <!-- TOP BAR -->
    <Border Grid.Row="0" Background="White" BorderBrush="#EEF2F8" BorderThickness="0,0,0,1">
      <Grid Margin="16,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="6" Background="#1677FF" Margin="0,0,12,0">
            <TextBlock Text="B" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Nhà hàng Tiệc (Banquet)" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock Text="{Binding TodayHeaderText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <TextBlock Text="&#xE7E4;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
          <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource DangerBrush}" Margin="-8,-8,0,0"><TextBlock Text="3" FontSize="10" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <Border Width="28" Height="28" CornerRadius="14" Background="#64748B" Margin="16,0,0,0"/>
          <TextBlock Text="Administrator" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,16,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- SIDEBAR + CONTENT -->
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding SidebarWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" BorderBrush="#EEF2F8" BorderThickness="0,1,0,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel VerticalAlignment="Top" Margin="8,12,8,0">
            <Button Width="{Binding SidebarButtonWidth}" Height="66" Margin="0,0,0,2" Tag="Tổng quan" Content="&#xE80F;" Command="{Binding NavigateTabCommand}" CommandParameter="0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsDashboardTab}" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <Button Width="{Binding SidebarButtonWidth}" Height="66" Margin="0,0,0,2" Tag="Phòng tiệc" Content="&#xE8F1;" Command="{Binding NavigateTabCommand}" CommandParameter="7"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsSettingsTab}" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <Button Width="{Binding SidebarButtonWidth}" Height="66" Margin="0,0,0,2" Tag="Lịch phòng" Content="&#xE787;" Command="{Binding NavigateTabCommand}" CommandParameter="1"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsCalendarTab}" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <Button Width="{Binding SidebarButtonWidth}" Height="66" Margin="0,0,0,2" Tag="Định lượng" Content="&#xE9F9;" Command="{Binding NavigateTabCommand}" CommandParameter="8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsQuantificationTab}" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <Button Width="{Binding SidebarButtonWidth}" Height="66" Margin="0,0,0,2" Tag="Báo cáo" Content="&#xE9D2;" Command="{Binding NavigateTabCommand}" CommandParameter="6"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsReportsTab}" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <Button Width="{Binding SidebarButtonWidth}" Height="66" Tag="Cài đặt" Content="&#xE713;" Command="{Binding NavigateTabCommand}" CommandParameter="2"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsCustomersTab}" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          </StackPanel>
          <Button Grid.Row="1" Width="36" Height="36" Margin="0,0,0,8" HorizontalAlignment="Center"
                  Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                  FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold" BorderThickness="0"
                  Cursor="Hand" Command="{Binding ToggleSidebarCommand}"
                  Content="{Binding SidebarToggleText}"
                  ToolTip="Thu gọn hoặc mở rộng thanh điều hướng"/>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20,16,20,20">
          <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}" Foreground="{StaticResource PrimaryBrush}" Background="Transparent"/>

          <!-- ===== DASHBOARD ===== -->
          <Grid>
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTabIndex}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid Margin="0,0,0,12" MinWidth="900"><Grid.ColumnDefinitions><ColumnDefinition Width="520"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Height="760" VerticalAlignment="Top"><Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12"><TextBlock Text="Danh sách sự kiện" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/><Button Content="+ Thêm mới" Style="{StaticResource CmdAdd}" HorizontalAlignment="Right" Height="32" MinWidth="100" FontSize="12" Command="{Binding NewEventCommand}"/></Grid>
                <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding EventSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                  <Button Grid.Column="1" Width="38" Height="38" Content="&#xE71B;" FontFamily="Segoe MDL2 Assets" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand" Template="{StaticResource BtnTemplate}" Margin="8,0,0,0"/>
                </Grid>
                <Grid Grid.Row="2" Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Trạng thái" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/>
                    <ComboBox ItemsSource="{Binding EventStatusFilterOptions}" SelectedValuePath="Value" SelectedValue="{Binding SelectedEventStatusFilter}" Style="{StaticResource FilterChipCombo}" HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Loại tiệc" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/>
                    <ComboBox ItemsSource="{Binding EventTypeFilterOptions}" SelectedValuePath="Value" SelectedValue="{Binding SelectedEventTypeFilter}" Style="{StaticResource FilterChipCombo}" HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="Phòng tiệc" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/>
                    <ComboBox ItemsSource="{Binding EventRoomFilterOptions}" SelectedValuePath="Value" SelectedValue="{Binding SelectedEventRoomFilterId}" Style="{StaticResource FilterChipCombo}" HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <TextBlock Grid.Row="3" Margin="0,0,0,8" FontSize="12" Foreground="{StaticResource TextMutedBrush}"><Run Text="{Binding FilteredEvents.Count, Mode=OneWay}"/><Run Text=" sự kiện"/></TextBlock>
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4">
                  <ItemsControl ItemsSource="{Binding FilteredEvents}" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Border CornerRadius="10" Padding="10,8" Margin="0,0,0,6" Cursor="Hand"
                              Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Border.InputBindings>
                          <MouseBinding Command="{Binding DataContext.SelectEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Grid>
                          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <!-- Date icon -->
                          <Border Grid.RowSpan="2" Width="36" Height="36" CornerRadius="8" Background="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding EventDate, StringFormat={}{0:dd/MM}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <!-- Row 1: EventType + Status badge -->
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EventTypeDisplay}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text=" · " Foreground="#CBD5E1"/>
                            <TextBlock Text="{Binding CustomerName}" FontSize="13" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <Border Height="18" Padding="5,2" CornerRadius="4" Margin="8,0,0,0" VerticalAlignment="Center">
                              <Border.Style><Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SubtleBgBrush}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Status}" Value="Confirmed"><Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/></DataTrigger>
                                  <DataTrigger Binding="{Binding Status}" Value="Hold"><Setter Property="Background" Value="{StaticResource WarningLightBrush}"/></DataTrigger>
                                  <DataTrigger Binding="{Binding Status}" Value="Preparing"><Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/></DataTrigger>
                                  <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Background" Value="{StaticResource DangerLightBrush}"/></DataTrigger>
                                </Style.Triggers>
                              </Style></Border.Style>
                              <TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Confirmed"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Hold"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Preparing"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                  </Style.Triggers>
                                </Style></TextBlock.Style>
                              </TextBlock>
                            </Border>
                          </StackPanel>
                          <!-- Row 2: Room · Guests · Time -->
                          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,3,0"/>
                            <TextBlock Text="{Binding RoomName}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text=" · " Foreground="#CBD5E1"/>
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,3,0"/>
                            <TextBlock Text="{Binding GuestCount, StringFormat={}{0} khách}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text=" · " Foreground="#CBD5E1"/>
                            <TextBlock Text="{Binding StartTime, StringFormat={}{0:hh\\:mm}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                          </StackPanel>
                          <!-- Amount -->
                          <StackPanel Grid.Column="2" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0} đ}" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding EventNo}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl></ScrollViewer>
                <!-- Pager -->
                <Border Grid.Row="5" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center">
                      <Run Text="{Binding FilteredEvents.Count, Mode=OneWay}"/><Run Text=" sự kiện"/>
                    </TextBlock>
                    <controls:TablePagerControl Grid.Column="1" DataContext="{Binding EventsPager}"/>
                  </Grid>
                </Border>
              </Grid></Border>

              <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                  <StackPanel x:Name="DetailPanel"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ShowEventEditor}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <Grid Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedEvent.EventTypeDisplay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text=" - " FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="{Binding SelectedEvent.CustomerName}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Lưu" Style="{StaticResource CmdAdd}" Margin="0,0,8,0" Command="{Binding SaveEventCommand}" IsEnabled="{Binding CanSaveEvent}"/><Button Content="Hủy tiệc" Style="{StaticResource CmdDelete}" Margin="0,0,8,0" Command="{Binding CancelSelectedEventCommand}"/><Button Content="In HĐ" Style="{StaticResource CmdExport}" Command="{Binding CreateContractCommand}"/></StackPanel></Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><StackPanel Orientation="Horizontal" Margin="0,0,20,0"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/><TextBlock Text="{Binding SelectedEvent.EventDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,20,0"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/><TextBlock Text="{Binding StartTimeText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,20,0"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/><TextBlock Text="{Binding SelectedEvent.RoomName}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/><TextBlock Text="{Binding SelectedEvent.GuestCount, StringFormat={}{0} khách}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></StackPanel>
                    <UniformGrid Columns="3" Margin="0,0,0,8">
                      <Border Background="{StaticResource SubtleBgBrush}" CornerRadius="8" Padding="10" Margin="0,0,4,0"><StackPanel><TextBlock Text="KHÁCH HÀNG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/><TextBlock Text="{Binding SelectedEvent.CustomerName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="{Binding SelectedEvent.Phone}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/></StackPanel></Border>
