                                  <TextBlock Text="{Binding TimelineFormTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="Thiết lập thời gian, nội dung và người chịu trách nhiệm." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,14"/>
