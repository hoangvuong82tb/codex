                                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsTimelineEmpty, Converter={StaticResource B2V}}"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#CBD5E1" HorizontalAlignment="Center"/><TextBlock Text="Chưa có kịch bản vận hành" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,10,0,0"/><TextBlock Text="Thêm mốc thời gian đầu tiên từ biểu mẫu bên phải." FontSize="10" Foreground="#94A3B8" Margin="0,3,0,0"/></StackPanel>
