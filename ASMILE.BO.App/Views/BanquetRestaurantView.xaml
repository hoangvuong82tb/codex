                                            <Grid>
                                              <Image Source="{Binding DisplayImageSource}" Stretch="UniformToFill">
                                                <Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding DisplayImageSource}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding DisplayImageSource}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style>
                                              </Image>
                                              <TextBlock Text="{Binding Emoji}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DisplayImageSource}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding DisplayImageSource}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                              </TextBlock>
                                            </Grid>
                                          </Border>
                                          <StackPanel Grid.Row="1" Margin="0,7,0,5">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#0F2A55" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ServiceTypeDisplay}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Price, StringFormat={}{0:N0} đ}" FontSize="12" FontWeight="Bold" Foreground="#0F766E" Margin="0,2,0,0"/>
                                          </StackPanel>
                                          <Button Grid.Row="2" Content="+ Thêm dịch vụ" Height="34" Background="#2563EB" Foreground="White" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.AddServiceToEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#1D4ED8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                          </Button>
                                        </Grid>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </ScrollViewer>
                            </Grid>
                          </Border>
                          <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                            <Grid>
                              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                              <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Dịch vụ đã chọn" FontSize="15" FontWeight="SemiBold" Foreground="#1E3352"/>
                                <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0"><Run Text="{Binding EventServices.Count, Mode=OneWay}"/><Run Text=" dịch vụ"/></TextBlock>
                              </StackPanel>
                              <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="4" Padding="4,6" Margin="0,0,0,4">
                                <Grid>
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="78"/><ColumnDefinition Width="88"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                  <TextBlock Text="STT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                  <TextBlock Grid.Column="1" Text="TÊN DỊCH VỤ" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                  <TextBlock Grid.Column="2" Text="SỐ LƯỢNG" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                  <TextBlock Grid.Column="3" Text="ĐƠN GIÁ" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                  <TextBlock Grid.Column="4" Text="THÀNH TIỀN" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                  <TextBlock Grid.Column="5" Text="XÓA" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </Grid>
                              </Border>
                              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
