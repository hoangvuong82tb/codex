                                      <TextBlock Grid.Column="5" Text="{Binding Amount, StringFormat={}{0:N0} đ}" FontSize="12" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center" HorizontalAlignment="Right"/>
