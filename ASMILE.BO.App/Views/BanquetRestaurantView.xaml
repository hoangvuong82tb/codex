                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Border Height="188" Margin="4" Padding="10" Background="#F8FBFF" BorderBrush="#D9E2F0" BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                          <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
