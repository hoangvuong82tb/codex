                                                <Button Content="&#xE74D;" Width="26" Height="26" FontFamily="Segoe MDL2 Assets" FontSize="10" Background="#FEF2F2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" Margin="4,0,0,0" ToolTip="Xóa mốc" Command="{Binding DataContext.DeleteTimelineItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                              </StackPanel>
                                            </Grid>
