                                  <Border Width="110" Height="110" CornerRadius="55" Background="#FFFFFF" Opacity="0.85" VerticalAlignment="Center">
                                    <Grid>
                                      <TextBlock Text="🍽️" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><ScaleTransform ScaleX="1.3" ScaleY="1.3"/></TextBlock.RenderTransform>
                                      </TextBlock>
                                    </Grid>
                                  </Border>
                                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Chọn món theo yêu cầu" FontSize="18" FontWeight="Bold" Foreground="#9A3412"/>
