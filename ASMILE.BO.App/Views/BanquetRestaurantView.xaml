                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding EventType}" Value="Wedding"><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderThickness" Value="2"/></DataTrigger>
