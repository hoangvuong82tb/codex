                      </ItemsControl>
                    </Grid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <!-- ===== ĐỊNH LƯỢNG ===== -->
          <StackPanel>
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTabIndex}" Value="8"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Grid Margin="0,0,0,12">
              <StackPanel><TextBlock Text="Định lượng tiệc" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="Tổng hợp nguyên liệu và dịch vụ cần chuẩn bị từ các tiệc đã lưu." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Làm mới" Command="{Binding RefreshQuantificationCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" MinWidth="92" Margin="0,0,8,0"/></StackPanel>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.7*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Từ ngày" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><DatePicker SelectedDate="{Binding QuantificationFromDate}" Style="{StaticResource FluentDatePicker}" Height="32"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Đến ngày" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><DatePicker SelectedDate="{Binding QuantificationToDate}" Style="{StaticResource FluentDatePicker}" Height="32"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="Trạng thái tiệc" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4"/><ComboBox ItemsSource="{Binding QuantificationStatusOptions}" SelectedValuePath="Value" SelectedValue="{Binding QuantificationStatusFilter}" Style="{StaticResource FilterChipCombo}" Height="32"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                <Border Grid.Column="6" Background="#F7F9FC" CornerRadius="6" Padding="12,8"><Grid><StackPanel><TextBlock Text="TRẠNG THÁI TỔNG HỢP" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding QuantificationStatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><TextBlock Text="{Binding QuantificationSentText}" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="10" Foreground="#059669" Margin="0,0,0,0"/></Grid></Border>
              </Grid>
            </Border>

            <Grid MinHeight="560"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
              <!-- Card 1: Danh sách tiệc -->
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <StackPanel Margin="14,12,14,10"><TextBlock Text="Danh sách tiệc" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"><Run Text="{Binding QuantificationEventCount, Mode=OneWay}"/><Run Text=" tiệc trong khoảng đã chọn"/></TextBlock></StackPanel>
                  <Border Grid.Row="1" Background="#F7F9FC" Padding="12,8" Margin="1,0"><TextBlock Text="Chọn tiệc để xem định lượng và lịch sử gửi" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/></Border>
                  <ListBox Grid.Row="2" ItemsSource="{Binding QuantificationEvents}" SelectedItem="{Binding SelectedQuantificationEvent}" Background="Transparent" BorderThickness="0" Padding="8" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemRoot" Background="{TemplateBinding Background}" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="7" Padding="11"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#EFF6FF"/><Setter TargetName="ItemRoot" Property="BorderBrush" Value="#2563EB"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemRoot" Property="BorderBrush" Value="#93C5FD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding CustomerName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"><Run Text="{Binding EventTypeDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding EventNo, Mode=OneWay}"/></TextBlock></StackPanel><Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{Binding SendStatusBackground}" CornerRadius="9" Padding="7,3"><TextBlock Text="{Binding SendStatusText}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding SendStatusForeground}"/></Border></Grid><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding EventDateText}" FontSize="10.5" FontWeight="SemiBold"/><TextBlock Text="{Binding TimeText}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding LocationText}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ScaleText}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></Grid><TextBlock Text="{Binding LastSentText}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Grid.Row="2" Text="Không có tiệc phù hợp." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding IsQuantificationEventsEmpty, Converter={StaticResource B2V}}"/>
                </Grid>
              </Border>

              <!-- Card 2: Nguyên liệu theo tiệc -->
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid Margin="14,12,14,10"><StackPanel><TextBlock Text="Nguyên liệu của tiệc" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="{Binding SelectedQuantificationEventTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#047857" Margin="0,3,0,0"/><TextBlock Text="{Binding SelectedQuantificationEventDetail}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock Text="{Binding QuantificationIngredientCount}" FontSize="20" FontWeight="SemiBold" Foreground="#047857" TextAlignment="Right"/><TextBlock Text="mặt hàng" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></Grid>
                  <Grid Grid.Row="1" Background="#F7F9FC" Margin="1,0"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><TextBlock Text="STT" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="Mã" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="2" Text="NGUYÊN LIỆU" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="3" Text="ĐV" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="4" Text="SL CẦN" TextAlignment="Right" Margin="0,0,9,0" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/></Grid>
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><ItemsControl ItemsSource="{Binding QuantificationIngredients}" HorizontalAlignment="Stretch"><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><Grid MinHeight="38"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><Border Grid.ColumnSpan="5" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"/><TextBlock Text="{Binding Sequence}" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Code}" VerticalAlignment="Center" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Grid.Column="3" Text="{Binding UnitName}" VerticalAlignment="Center" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="4" Text="{Binding RequiredQuantity, StringFormat={}{0:N0}}" TextAlignment="Right" Margin="0,0,9,0" VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="#047857"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                  <TextBlock Grid.Row="2" Text="Tiệc này chưa có nguyên liệu từ công thức." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding IsQuantificationIngredientsEmpty, Converter={StaticResource B2V}}"/>
                  <Border Grid.Row="3" Background="#FFF7ED" Padding="12,8" Visibility="{Binding HasQuantificationWarnings, Converter={StaticResource B2V}}"><TextBlock FontSize="10" Foreground="#9A3412" TextWrapping="Wrap"><Run Text="Cảnh báo: "/><Run Text="{Binding QuantificationMissingRecipeCount, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" món chưa có công thức định lượng."/></TextBlock></Border>
                </Grid>
              </Border>

              <!-- Card 3: Dịch vụ và gửi -->
              <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid Margin="14,12,14,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Thông tin gửi định lượng" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="Chi tiết tiệc và dịch vụ cần điều phối" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/></StackPanel><Border Grid.Column="1" HorizontalAlignment="Right" Background="{Binding SelectedQuantificationEvent.SendStatusBackground}" CornerRadius="9" Padding="8,4"><TextBlock Text="{Binding SelectedQuantificationEvent.SendStatusText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding SelectedQuantificationEvent.SendStatusForeground}"/></Border></Grid>
                  <Border Grid.Row="1" Background="#F7F9FC" Padding="12" Margin="1,0,1,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="KHÁCH ĐẶT TIỆC" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding SelectedQuantificationEvent.CustomerName}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="{Binding SelectedQuantificationEvent.Phone}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="THỜI GIAN / ĐỊA ĐIỂM" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding SelectedQuantificationEvent.EventDateText}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"><Run Text="{Binding SelectedQuantificationEvent.TimeText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedQuantificationEvent.LocationText, Mode=OneWay}"/></TextBlock></StackPanel></Grid></Border>
                  <Grid Grid.Row="2" Background="#F7F9FC" Margin="1,0"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><TextBlock Text="STT" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="DỊCH VỤ" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="2" Text="ĐV" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="3" Text="SL CẦN" TextAlignment="Right" Margin="0,0,9,0" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/></Grid>
                  <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><ItemsControl ItemsSource="{Binding QuantificationServices}" HorizontalAlignment="Stretch"><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><Grid MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Border Grid.ColumnSpan="4" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"/><TextBlock Text="{Binding Sequence}" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Code}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding UnitName}" VerticalAlignment="Center" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="3" Text="{Binding RequiredQuantity, StringFormat={}{0:N0}}" TextAlignment="Right" Margin="0,0,9,0" VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="#2563EB"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                  <TextBlock Grid.Row="3" Text="Tiệc này không có dịch vụ cần điều phối." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding IsQuantificationServicesEmpty, Converter={StaticResource B2V}}"/>
                  <Border Grid.Row="4" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12"><Grid><StackPanel><TextBlock Text="{Binding SelectedQuantificationEvent.LastSentText}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="Thông báo gồm khách hàng, thời gian, phòng, nguyên liệu và dịch vụ." FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/></StackPanel><Button HorizontalAlignment="Right" Content="{Binding SelectedQuantificationEvent.SendButtonText}" Command="{Binding SendQuantificationCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="38" MinWidth="146"/></Grid></Border>
                </Grid>
              </Border>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,12" Visibility="Collapsed">
              <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="TIỆC CẦN CHUẨN BỊ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding QuantificationEventCount}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0"/><TextBlock Text="Theo khoảng ngày và trạng thái" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="NGUYÊN LIỆU" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding QuantificationIngredientCount}" FontSize="21" FontWeight="SemiBold" Foreground="#047857" Margin="0,5,0,0"/><TextBlock Text="Mặt hàng cần nhập / xuất kho" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="DỊCH VỤ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding QuantificationServiceCount}" FontSize="21" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,5,0,0"/><TextBlock Text="Hạng mục cần điều phối" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}" Padding="14"><StackPanel><TextBlock Text="CHƯA CÓ CÔNG THỨC" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding QuantificationMissingRecipeCount}" FontSize="21" FontWeight="SemiBold" Foreground="#D97706" Margin="0,5,0,0"/><TextBlock Text="Cần bổ sung trước khi chốt" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></Border>
