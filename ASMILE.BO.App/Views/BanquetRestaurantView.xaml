                                <Border.InputBindings><MouseBinding Command="{Binding DataContext.SelectEventTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Wedding" MouseAction="LeftClick"/></Border.InputBindings>
                                <StackPanel HorizontalAlignment="Center">
                                  <Border Width="56" Height="56" CornerRadius="14" Background="#FEE2E2" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  </Border>
                                  <TextBlock Text="Tiệc Cưới" FontSize="14" FontWeight="Bold" Foreground="#0F2A55" HorizontalAlignment="Center"/>
                                </StackPanel>
                              </Border>
                              <!-- Conference -->
                              <Border Margin="0,0,6,6" CornerRadius="12" Padding="16" Cursor="Hand"
                                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Border.Style><Style TargetType="Border">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding EventType}" Value="Conference"><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderThickness" Value="2"/></DataTrigger>
                                  </Style.Triggers>
                                </Style></Border.Style>
                                <Border.InputBindings><MouseBinding Command="{Binding DataContext.SelectEventTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Conference" MouseAction="LeftClick"/></Border.InputBindings>
                                <StackPanel HorizontalAlignment="Center">
                                  <Border Width="56" Height="56" CornerRadius="14" Background="#DBEAFE" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  </Border>
                                  <TextBlock Text="Hội nghị" FontSize="14" FontWeight="Bold" Foreground="#0F2A55" HorizontalAlignment="Center"/>
                                </StackPanel>
                              </Border>
                              <!-- Birthday -->
                              <Border Margin="0,0,6,6" CornerRadius="12" Padding="16" Cursor="Hand"
                                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Border.Style><Style TargetType="Border">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding EventType}" Value="Birthday"><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderThickness" Value="2"/></DataTrigger>
                                  </Style.Triggers>
                                </Style></Border.Style>
                                <Border.InputBindings><MouseBinding Command="{Binding DataContext.SelectEventTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Birthday" MouseAction="LeftClick"/></Border.InputBindings>
                                <StackPanel HorizontalAlignment="Center">
                                  <Border Width="56" Height="56" CornerRadius="14" Background="#FEF9C3" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#CA8A04" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  </Border>
                                  <TextBlock Text="Sinh nhật" FontSize="14" FontWeight="Bold" Foreground="#0F2A55" HorizontalAlignment="Center"/>
                                </StackPanel>
                              </Border>
                              <!-- Meeting -->
                              <Border Margin="0,0,6,6" CornerRadius="12" Padding="16" Cursor="Hand"
                                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Border.Style><Style TargetType="Border">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding EventType}" Value="Meeting"><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderThickness" Value="2"/></DataTrigger>
                                  </Style.Triggers>
                                </Style></Border.Style>
                                <Border.InputBindings><MouseBinding Command="{Binding DataContext.SelectEventTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Meeting" MouseAction="LeftClick"/></Border.InputBindings>
                                <StackPanel HorizontalAlignment="Center">
                                  <Border Width="56" Height="56" CornerRadius="14" Background="#EDE9FE" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  </Border>
                                  <TextBlock Text="Họp mặt" FontSize="14" FontWeight="Bold" Foreground="#0F2A55" HorizontalAlignment="Center"/>
                                </StackPanel>
                              </Border>
                              <!-- Party -->
                              <Border Margin="0,0,6,6" CornerRadius="12" Padding="16" Cursor="Hand"
                                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Border.Style><Style TargetType="Border">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding EventType}" Value="Party"><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderThickness" Value="2"/></DataTrigger>
                                  </Style.Triggers>
                                </Style></Border.Style>
                                <Border.InputBindings><MouseBinding Command="{Binding DataContext.SelectEventTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Party" MouseAction="LeftClick"/></Border.InputBindings>
                                <StackPanel HorizontalAlignment="Center">
                                  <Border Width="56" Height="56" CornerRadius="14" Background="#FFEDD5" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#EA580C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  </Border>
                                  <TextBlock Text="Tiệc / Party" FontSize="14" FontWeight="Bold" Foreground="#0F2A55" HorizontalAlignment="Center"/>
                                </StackPanel>
                              </Border>
                              <!-- Other -->
                              <Border Margin="0,0,6,6" CornerRadius="12" Padding="16" Cursor="Hand"
                                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Border.Style><Style TargetType="Border">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding EventType}" Value="Other"><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderThickness" Value="2"/></DataTrigger>
                                  </Style.Triggers>
                                </Style></Border.Style>
                                <Border.InputBindings><MouseBinding Command="{Binding DataContext.SelectEventTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Other" MouseAction="LeftClick"/></Border.InputBindings>
                                <StackPanel HorizontalAlignment="Center">
                                  <Border Width="56" Height="56" CornerRadius="14" Background="#F1F5F9" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  </Border>
                                  <TextBlock Text="Sự kiện khác" FontSize="14" FontWeight="Bold" Foreground="#0F2A55" HorizontalAlignment="Center"/>
                                </StackPanel>
                              </Border>
                            </UniformGrid>
                          </StackPanel>
                        </ScrollViewer>
                      </TabItem>
                      <TabItem Header="Thông tin"><ScrollViewer VerticalScrollBarVisibility="Auto">
                      <Grid Margin="0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="6*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>

                        <!-- LEFT: Input form -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                          <StackPanel>
                            <TextBlock Text="Nhập thông tin" FontSize="15" FontWeight="SemiBold" Foreground="#1E3352" Margin="0,0,0,14"/>
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                              <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Tên khách hàng" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EventCustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/>
                              </StackPanel>
                              <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,12">
                                <TextBlock Text="Số điện thoại" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EventPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/>
                              </StackPanel>
                              <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,0,0,12">
                                <TextBlock Text="Ngày tổ chức" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding EventDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentDatePicker}"/>
                              </StackPanel>
                              <StackPanel Grid.Column="0" Grid.Row="4" Margin="0,0,0,12">
                                <TextBlock Text="Phòng / Sảnh" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Rooms}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedEventRoomId}" Style="{StaticResource FluentComboBox}" Height="38" FontSize="13"/>
                              </StackPanel>
                              <StackPanel Grid.Column="0" Grid.Row="5">
                                <TextBlock Text="Trạng thái" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding EventStatusOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding EventStatus}" Style="{StaticResource FluentComboBox}" Height="38" FontSize="13"/>
                              </StackPanel>
                              <!-- Event-type specific fields -->
                              <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,0,12">
                                <TextBlock Text="{Binding EventTypeSpecificLabel}" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <!-- Wedding: Cô dâu - Chú rể -->
                                <Grid Visibility="{Binding IsWedding, Converter={StaticResource B2V}}">
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                  <TextBox Text="{Binding BrideName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/>
                                  <TextBox Grid.Column="2" Text="{Binding GroomName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/>
                                </Grid>
                                <!-- Conference: Tên hội nghị -->
                                <TextBox Visibility="{Binding IsConference, Converter={StaticResource B2V}}" Text="{Binding ConferenceName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/>
                                <!-- Birthday: Người tổ chức + Ngày sinh -->
                                <Grid Visibility="{Binding IsBirthday, Converter={StaticResource B2V}}">
                                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                  <TextBox Text="{Binding BirthdayPersonName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Tag="Tên người sinh nhật" Margin="0,0,0,4"/>
                                  <DatePicker Grid.Row="1" SelectedDate="{Binding BirthdayDate}" Style="{StaticResource FluentDatePicker}"/>
                                </Grid>
                                <!-- Meeting: Chủ đề -->
                                <TextBox Visibility="{Binding IsMeeting, Converter={StaticResource B2V}}" Text="{Binding MeetingTopic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/>
                                <!-- Party: Chủ đề tiệc -->
                                <TextBox Visibility="{Binding IsParty, Converter={StaticResource B2V}}" Text="{Binding PartyTheme, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/>
                                <!-- Other: Tên sự kiện -->
                                <TextBox Visibility="{Binding IsOtherEvent, Converter={StaticResource B2V}}" Text="{Binding OtherEventName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"/>
                              </StackPanel>
                              <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Giờ bắt đầu — Kết thúc" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                  <TextBox Text="{Binding StartTimeText}" Style="{StaticResource FluentTextBox}"/>
                                  <TextBox Grid.Column="2" Text="{Binding EndTimeText}" Style="{StaticResource FluentTextBox}"/>
                                </Grid>
                              </StackPanel>
                              <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,12">
                                <TextBlock Text="Số khách — Số bàn" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                  <TextBox Text="{Binding GuestCount}" Style="{StaticResource FluentTextBox}"/>
                                  <TextBox Grid.Column="2" Text="{Binding TableCount}" Style="{StaticResource FluentTextBox}"/>
                                </Grid>
                              </StackPanel>
                              <StackPanel Grid.Column="2" Grid.Row="2" Margin="0,0,0,12">
                                <TextBlock Text="Khách PS — Bàn PS" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                  <TextBox Text="{Binding ExtraGuestCount}" Style="{StaticResource FluentTextBox}"/>
                                  <TextBox Grid.Column="2" Text="{Binding ExtraTableCount}" Style="{StaticResource FluentTextBox}"/>
                                </Grid>
                              </StackPanel>
                              <StackPanel Grid.Column="2" Grid.Row="3" Grid.RowSpan="4">
                                <TextBlock Text="Ghi chú" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EventNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBoxMulti}"/>
                              </StackPanel>
                            </Grid>
                          </StackPanel>
                        </Border>

                        <!-- RIGHT: Live preview mirror -->
                        <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                          <StackPanel>
                            <TextBlock Text="Xem trước" FontSize="15" FontWeight="SemiBold" Foreground="#1E3352" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,14">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding EventTypeDisplayName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                              </StackPanel>
                            </Border>
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                              <!-- Left -->
                              <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Tên khách hàng" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding EventCustomerName, TargetNullValue='—'}" FontSize="14" FontWeight="SemiBold" Foreground="#0F2A55"/>
                              </StackPanel>
                              <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,12">
                                <TextBlock Text="Số điện thoại" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding EventPhone, TargetNullValue='—'}" FontSize="14" Foreground="#334D70"/>
                              </StackPanel>
                              <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,0,0,12">
                                <TextBlock Text="Ngày tổ chức" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding EventDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="14" Foreground="#334D70"/>
                              </StackPanel>
                              <StackPanel Grid.Column="0" Grid.Row="4" Margin="0,0,0,12">
                                <TextBlock Text="Phòng / Sảnh" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedRoom.Name, TargetNullValue='—'}" FontSize="14" Foreground="#334D70"/>
                              </StackPanel>
                              <StackPanel Grid.Column="0" Grid.Row="5">
                                <TextBlock Text="Trạng thái" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding EventStatus}" FontSize="14" FontWeight="SemiBold" Foreground="#16A34A"/>
                              </StackPanel>
                              <!-- Event-type specific preview -->
                              <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,0,12">
                                <TextBlock Text="{Binding EventTypeSpecificLabel}" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <!-- Wedding -->
                                <TextBlock Visibility="{Binding IsWedding, Converter={StaticResource B2V}}" FontSize="14" Foreground="#334D70"><Run Text="{Binding BrideName, TargetNullValue='—'}"/><Run Text=" &amp; "/><Run Text="{Binding GroomName, TargetNullValue='—'}"/></TextBlock>
                                <!-- Conference -->
                                <TextBlock Visibility="{Binding IsConference, Converter={StaticResource B2V}}" Text="{Binding ConferenceName, TargetNullValue='—'}" FontSize="14" Foreground="#334D70"/>
                                <!-- Birthday -->
                                <StackPanel Visibility="{Binding IsBirthday, Converter={StaticResource B2V}}">
                                  <TextBlock Text="{Binding BirthdayPersonName, TargetNullValue='—'}" FontSize="14" FontWeight="SemiBold" Foreground="#0F2A55"/>
                                  <TextBlock Text="{Binding BirthdayDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- Meeting -->
                                <TextBlock Visibility="{Binding IsMeeting, Converter={StaticResource B2V}}" Text="{Binding MeetingTopic, TargetNullValue='—'}" FontSize="14" Foreground="#334D70"/>
                                <!-- Party -->
                                <TextBlock Visibility="{Binding IsParty, Converter={StaticResource B2V}}" Text="{Binding PartyTheme, TargetNullValue='—'}" FontSize="14" Foreground="#334D70"/>
                                <!-- Other -->
                                <TextBlock Visibility="{Binding IsOtherEvent, Converter={StaticResource B2V}}" Text="{Binding OtherEventName, TargetNullValue='—'}" FontSize="14" Foreground="#334D70"/>
                              </StackPanel>
                              <!-- Right -->
                              <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Giờ bắt đầu — Kết thúc" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock FontSize="14" Foreground="#334D70"><Run Text="{Binding StartTimeText}"/><Run Text=" — "/><Run Text="{Binding EndTimeText}"/></TextBlock>
                              </StackPanel>
                              <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,12">
                                <TextBlock Text="Số khách — Số bàn" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock FontSize="14" Foreground="#334D70"><Run Text="{Binding GuestCount, StringFormat={}{0} khách}"/><Run Text=" — "/><Run Text="{Binding TableCount, StringFormat={}{0} bàn}"/></TextBlock>
                              </StackPanel>
                              <StackPanel Grid.Column="2" Grid.Row="2" Margin="0,0,0,12">
                                <TextBlock Text="Khách PS — Bàn PS" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock FontSize="14" Foreground="#334D70"><Run Text="{Binding ExtraGuestCount, StringFormat={}{0} khách}"/><Run Text=" — "/><Run Text="{Binding ExtraTableCount, StringFormat={}{0} bàn}"/></TextBlock>
                              </StackPanel>
                              <StackPanel Grid.Column="2" Grid.Row="3" Grid.RowSpan="4">
                                <TextBlock Text="Ghi chú" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding EventNote, TargetNullValue='—'}" FontSize="13" Foreground="#334D70" TextWrapping="Wrap"/>
                              </StackPanel>
                            </Grid>
                          </StackPanel>
                        </Border>
                      </Grid>
                      </ScrollViewer></TabItem>
                      <TabItem Header="Thực đơn"><ScrollViewer VerticalScrollBarVisibility="Auto">
                      <Grid Margin="0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="6*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                          <StackPanel>
                            <!-- Card 1: Chọn món theo yêu cầu -->
                            <Border Height="200" Margin="0,0,0,6" CornerRadius="14" Cursor="Hand" ClipToBounds="True">
                              <Border.InputBindings><MouseBinding Command="{Binding OpenCustomMenuCommand}" MouseAction="LeftClick"/></Border.InputBindings>
                              <Grid>
                                <!-- Background gradient -->
                                <Border Background="#FFF7ED" CornerRadius="14"/>
                                <Border CornerRadius="14">
                                  <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                      <GradientStop Color="#FFF7ED" Offset="0"/>
                                      <GradientStop Color="#FFEDD5" Offset="1"/>
                                    </LinearGradientBrush>
                                  </Border.Background>
                                </Border>
                                <Grid Margin="28,0">
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
