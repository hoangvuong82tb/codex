                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="4,8">
                                        <Grid>
                                          <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="78"/><ColumnDefinition Width="88"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                          <TextBlock Text="{Binding LineNo}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Description}" FontSize="12" FontWeight="SemiBold" Foreground="#0F2A55" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ServiceTypeDisplay}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/></StackPanel>
                                          <Grid Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="30"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource ServiceStepperButton}" Background="#DCE7F7" Command="{Binding DataContext.DecreaseEventServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><TextBlock Text="-" FontFamily="Arial" FontSize="13" FontWeight="Bold" Foreground="#1E3A5F"/></Button>
                                            <TextBlock Grid.Column="1" Text="{Binding Qty, StringFormat={}{0:0.##}}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Style="{StaticResource ServiceStepperButton}" Background="#BFDBFE" Command="{Binding DataContext.IncreaseEventServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><TextBlock Text="+" FontFamily="Arial" FontSize="13" FontWeight="Bold" Foreground="#1D4ED8"/></Button>
                                          </Grid>
                                          <TextBlock Grid.Column="3" Text="{Binding UnitPrice, StringFormat={}{0:N0}}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                          <TextBlock Grid.Column="4" Text="{Binding Amount, StringFormat={}{0:N0} đ}" FontSize="12" FontWeight="Bold" Foreground="#0F766E" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                          <Button Grid.Column="5" Style="{StaticResource ServiceDeleteButton}" Background="#FECACA" HorizontalAlignment="Center" Command="{Binding DataContext.DeleteServiceLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><TextBlock Text="X" FontFamily="Arial" FontSize="12" FontWeight="Bold" Foreground="#B91C1C"/></Button>
                                        </Grid>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </ScrollViewer>
                              <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tổng tiền dịch vụ" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/><TextBlock Grid.Column="1" Text="{Binding SelectedBanquetServiceTotalAmount, StringFormat={}{0:N0} đ}" FontSize="14" FontWeight="Bold" Foreground="#0F766E"/></Grid>
                              </Border>
                            </Grid>
                          </Border>
                        </Grid>
                      </TabItem>
                      <TabItem Header="Checklist">
