<UserControl x:Class="ASMILE.BO.App.Views.ReservationHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ASMILE.BO.App.Models"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:views="clr-namespace:ASMILE.BO.App.Views"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <DataTemplate DataType="{x:Type models:ReservationHubCard}">
            <Border Style="{StaticResource HubCardStyle}" Visibility="{Binding IsVisible, Converter={StaticResource BoolVis}}"
                    Tag="{Binding Id}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding Command}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBox" Style="{StaticResource HubIconBoxStyle}">
                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource HubCardTitleStyle}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Id}" Value="create"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4A8EFF" Offset="0"/><GradientStop Color="#1765F2" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="search"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#31C9B8" Offset="0"/><GradientStop Color="#00A58F" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="edit"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFAD39" Offset="0"/><GradientStop Color="#ED7900" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="assign"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B158FF" Offset="0"/><GradientStop Color="#7D2BE1" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="confirm"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4ED86E" Offset="0"/><GradientStop Color="#18B33F" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="cancel"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF5A94" Offset="0"/><GradientStop Color="#E32F70" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="status"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4A91FF" Offset="0"/><GradientStop Color="#1E6CF1" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="web"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2CC7D8" Offset="0"/><GradientStop Color="#00A7BA" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="denials"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3E83F3" Offset="0"/><GradientStop Color="#195FCE" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="availability"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#9853F0" Offset="0"/><GradientStop Color="#6F28D8" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="reports"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2661D9" Offset="0"/><GradientStop Color="#1046B7" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.04,0.04" Center="0.04,0.04" RadiusX="0.32" RadiusY="0.32">
                <GradientStop Color="#106aa7ff" Offset="0"/>
                <GradientStop Color="#00ffffff" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Style="{StaticResource HubContainerStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Content="← Quay lại" Command="{Binding BackCommand}" Style="{StaticResource HubBackButtonStyle}"/>

                <!-- Error/Info messages -->
                <Border Grid.Row="1" Margin="0,4,0,0" Padding="12,8" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8"
                        Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#991B1B" FontSize="13"/>
                </Border>
                <Border Grid.Row="1" Margin="0,4,0,0" Padding="12,8" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8"
                        Visibility="{Binding HasInfo, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" Foreground="#166534" FontSize="13"/>
                </Border>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,32">
                    <TextBlock Text="Đặt phòng" Style="{StaticResource HubHeaderStyle}"/>
                    <TextBlock Text="Quản lý đặt phòng và phân phối khách sạn" Style="{StaticResource HubSubtitleStyle}"/>
                </StackPanel>

                <ItemsControl Grid.Row="3" ItemsSource="{Binding Cards}" Style="{StaticResource HubGridStyle}"/>
            </Grid>
        </ScrollViewer>

        <ContentControl Content="{Binding ModalService.ActiveModal}"
                        Visibility="{Binding ModalService.IsOpen, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
    </Grid>
</UserControl>
