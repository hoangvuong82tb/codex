<Window x:Class="ASMILE.BO.App.Views.MarketingCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ASMILE.BO.App.Views"
        Title="Marketing Center"
        Width="1540" Height="900" MinWidth="1180" MinHeight="680"
        Background="#F7F9FC" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#12335F" />
        <SolidColorBrush x:Key="Line" Color="#DCE6F3" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#F2F6FB" />
            <Setter Property="BorderBrush" Value="#D7E2F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#183455" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="13,9" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="#CBD9EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="#CBD9EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E9EFF7" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FBFCFE" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF1FA" />
            <Setter Property="Foreground" Value="#183455" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="BorderBrush" Value="#EAF1FA" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#17324D" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFF4DF" />
                    <Setter Property="Foreground" Value="#17324D" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="KpiTemplate" DataType="{x:Type local:MarketingKpi}">
            <Border Width="142" Height="68" Margin="0,0,9,0" Padding="12,8" Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="{Binding Value}" FontSize="19" FontWeight="Bold" Foreground="{Binding Accent}" />
                    <TextBlock Text="{Binding Label}" Margin="0,2,0,0" Foreground="#60748E" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,17">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" Background="#266BEA" CornerRadius="13" Margin="0,0,13,0">
                        <TextBlock Text="M" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTitle}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="{Binding CurrentSubtitle}" Foreground="#61758F" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Xuất Excel" Click="Export_Click" />
                    <Button Content="Làm mới" Click="Refresh_Click" />
                    <Button Content="Đóng" Margin="0" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FBFCFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SourceButton" Content="Nguồn khách" Tag="source" Style="{StaticResource SectionButton}" Click="Section_Click" />
                <Button x:Name="SegmentButton" Content="Phân khúc" Tag="segment" Style="{StaticResource SectionButton}" Click="Section_Click" />
                <Button x:Name="AgencyButton" Content="Đại lý" Tag="agency" Style="{StaticResource SectionButton}" Click="Section_Click" />
                <Button x:Name="MemberButton" Content="Thành viên" Tag="member" Style="{StaticResource SectionButton}" Click="Section_Click" />
                <Button x:Name="PromotionButton" Content="Khuyến mại" Tag="promotion" Style="{StaticResource SectionButton}" Click="Section_Click" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,11">
            <StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Kpis}" ItemTemplate="{StaticResource KpiTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="AddButton" Content="+ Thêm mới" Background="#266BEA" Foreground="White" BorderBrush="#266BEA" Click="Add_Click" />
                    <Button Content="Chỉnh sửa" Click="Edit_Click" />
                    <Button x:Name="StatusButton" Content="Đổi trạng thái" Click="ToggleStatus_Click" />
                    <TextBox x:Name="SearchBox" Width="255" Margin="10,0,8,0" VerticalContentAlignment="Center" ToolTip="Tìm theo mã, tên, nhóm hoặc người phụ trách" TextChanged="Search_TextChanged" />
                    <ComboBox x:Name="StatusFilter" Width="150" SelectionChanged="StatusFilter_SelectionChanged">
                        <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True" />
                        <ComboBoxItem Content="Đang hoạt động" />
                        <ComboBoxItem Content="Tạm dừng" />
                        <ComboBoxItem Content="Kết thúc" />
                    </ComboBox>
                    <Button Content="Xóa lọc" Margin="8,0,0,0" Click="ClearFilter_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="18,14,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Danh mục" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Ink}" Margin="0,0,0,10" />
                    <ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent" SelectionChanged="CategoryList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="9,8" /><Setter Property="Margin" Value="0,1" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,8">
                        <TextBlock Text="{Binding ListTitle}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="{Binding ResultText}" DockPanel.Dock="Right" Foreground="#7386A1" />
                    </DockPanel>
                    <DataGrid x:Name="RecordsGrid" Grid.Row="1" ItemsSource="{Binding RecordsView}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}" SelectionChanged="RecordsGrid_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="110" />
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*" MinWidth="170" />
                            <DataGridTextColumn Header="Nhóm / thị trường" Binding="{Binding Group}" Width="150" />
                            <DataGridTextColumn Header="Phụ trách" Binding="{Binding Owner}" Width="135" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Doanh thu" Binding="{Binding RevenueText}" Width="120" />
                            <DataGridTextColumn Header="Cập nhật" Binding="{Binding Updated}" Width="105" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="2,11,2,0">
                        <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Foreground="#7386A1" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="‹" Padding="10,6" Click="PreviousPage_Click" />
                            <Button Content="1" Padding="10,6" Background="#266BEA" BorderBrush="#266BEA" Foreground="White" />
                            <Button Content="2" Padding="10,6" Click="NextPage_Click" />
                            <Button Content="›" Padding="10,6" Margin="0" Click="NextPage_Click" />
                            <ComboBox Width="105" Margin="10,0,0,0" SelectedIndex="1" SelectionChanged="PageSize_SelectionChanged">
                                <ComboBoxItem Content="10 / trang" /><ComboBoxItem Content="20 / trang" /><ComboBoxItem Content="50 / trang" />
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Padding="18,15" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedRecord.Name, TargetNullValue=Chọn một mục}" FontWeight="SemiBold" FontSize="17" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedRecord.Id, TargetNullValue=Chọn dòng ở danh sách để xem chi tiết}" Foreground="#7487A1" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="×" FontSize="16" Padding="10,4" Margin="12,0,0,0" Click="ClearSelection_Click" />
                        </Grid>
                    </Border>
                    <TabControl Grid.Row="1" Margin="12" Padding="8">
                        <TabItem Header="Tổng quan">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="THÔNG TIN CHI TIẾT" FontSize="11" FontWeight="Bold" Foreground="#8192AA" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /></Grid.RowDefinitions>
                                        <TextBlock Text="Mã" Foreground="#7C90AA" /><TextBlock Grid.Column="1" Text="{Binding SelectedRecord.Id}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="Nhóm" Foreground="#7C90AA" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRecord.Group}" />
                                        <TextBlock Grid.Row="2" Text="Phụ trách" Foreground="#7C90AA" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRecord.Owner}" />
                                        <TextBlock Grid.Row="3" Text="Trạng thái" Foreground="#7C90AA" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedRecord.Status}" />
                                        <TextBlock Grid.Row="4" Text="Doanh thu" Foreground="#7C90AA" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedRecord.RevenueText}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="5" Text="Cập nhật" Foreground="#7C90AA" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedRecord.Updated}" />
                                    </Grid>
                                    <TextBlock Text="GHI CHÚ" FontSize="11" FontWeight="Bold" Foreground="#8192AA" Margin="0,16,0,5" />
                                    <Border Padding="11" Background="#F7FAFE" CornerRadius="8"><TextBlock Text="{Binding SelectedRecord.Notes, TargetNullValue=Chưa có ghi chú cho mục được chọn.}" TextWrapping="Wrap" Foreground="#506780" /></Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Hiệu quả">
                            <StackPanel Margin="18"><TextBlock Text="Theo dõi chuyển đổi và doanh thu" FontWeight="SemiBold" Foreground="{StaticResource Ink}" /><TextBlock Text="Số liệu sẽ được tổng hợp theo nguồn, phân khúc hoặc chương trình đang chọn." TextWrapping="Wrap" Foreground="#6D819B" Margin="0,10,0,0" /></StackPanel>
                        </TabItem>
                        <TabItem Header="Lịch sử">
                            <StackPanel Margin="18"><TextBlock Text="Lịch sử thay đổi" FontWeight="SemiBold" Foreground="{StaticResource Ink}" /><TextBlock Text="Chọn một mục để xem các mốc tạo mới, cập nhật và thay đổi trạng thái." TextWrapping="Wrap" Foreground="#6D819B" Margin="0,10,0,0" /></StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="#657B96" />
                <TextBlock DockPanel.Dock="Right" Text="Marketing Center · ASMILE BO" Foreground="#93A4B8" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
