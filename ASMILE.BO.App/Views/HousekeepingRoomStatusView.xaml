<UserControl x:Class="ASMILE.BO.App.Views.HousekeepingRoomStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" Loaded="OnLoaded"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:StringToBrushConverter x:Key="StringToBrush"/>

        <!-- ═══ STYLES ═══ -->
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SlidingDetailPanel" TargetType="Border" BasedOn="{StaticResource PanelCard}">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="1,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><TranslateTransform X="390"/></Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDetailOpen}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value><TranslateTransform X="0"/></Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDetailOpen}" Value="False">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value><TranslateTransform X="390"/></Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#4A8EFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1765F2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/><Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewModeBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="FilterTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7E2F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource FluentComboBox}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,0,30,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7E2F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ModDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#EFF6FF"/>
                        <Setter Property="Foreground" Value="#1E40AF"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="6,0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PagerBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InspectorTabBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress bar -->
        <Style x:Key="MiniProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#F1F5F9" CornerRadius="2">
                            <Border x:Name="PART_Indicator" Background="#16A34A" CornerRadius="2" HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Padding="22,14" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4A8EFF" Offset="0"/><GradientStop Color="#1765F2" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE8D1;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tình trạng phòng" FontSize="19" FontWeight="SemiBold" Foreground="#102E5A"/>
                        <Border CornerRadius="10" Padding="6,2" Margin="10,0,0,0" Background="#EFF6FF">
                            <TextBlock Text="{Binding TotalRooms, StringFormat='{}{0} phòng'}" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Housekeeping Room Status — Trung tâm điều hành tình trạng phòng khách sạn." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryBtn}"/>
                    <Button Content="Đồng bộ" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0"/>
                    <Button Content="Toàn màn hình" Command="{Binding ToggleFullScreenCommand}" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0"/>
                    <Button Content="Xuất Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0"/>
                    <Button Content="In" Command="{Binding PrintReportCommand}" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ STATS DASHBOARD ═══ -->
        <Border Grid.Row="1" Padding="14,8" Background="#FAFBFD" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding DashboardKpis}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RoomStatusKpi}">
                        <Border Width="125" Margin="0,0,6,4" Padding="10,6" CornerRadius="8" Cursor="Hand"
                                MouseLeftButtonDown="OnKpiClick"
                                Background="{Binding BgColor}" BorderBrush="{Binding Color}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Color}" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{Binding Color}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Value}" FontSize="17" FontWeight="Bold" Foreground="{Binding Color}"/>
                                <ProgressBar Value="{Binding ProgressValue}" Style="{StaticResource MiniProgressBar}" Width="100"
                                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ═══ TOOLBAR + VIEW MODE ═══ -->
        <Border Grid.Row="2" Padding="14,7" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Grid" Command="{Binding SetViewGridCommand}" Style="{StaticResource ViewModeBtn}"/>
                    <Button Content="Table" Command="{Binding SetViewTableCommand}" Style="{StaticResource ViewModeBtn}"/>
                    <Button Content="Tầng" Command="{Binding SetViewFloorCommand}" Style="{StaticResource ViewModeBtn}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ FILTER BAR ═══ -->
        <Border Grid.Row="3" Padding="12,7" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel>
                    <StackPanel Margin="0,0,8,4" Width="160">
                        <TextBlock Text="Tìm phòng" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,4" Width="110">
                        <TextBlock Text="FO Status" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{x:Static vm:HousekeepingRoomStatusViewModel.FoStatusFilters}" SelectedItem="{Binding FilterFoStatus}" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,4" Width="110">
                        <TextBlock Text="HK Status" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{x:Static vm:HousekeepingRoomStatusViewModel.HkStatusFilters}" SelectedItem="{Binding FilterHkStatus}" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,4" Width="100">
                        <TextBlock Text="Loại phòng" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{x:Static vm:HousekeepingRoomStatusViewModel.RoomTypeFilters}" SelectedItem="{Binding FilterRoomType}" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,4" Width="90">
                        <TextBlock Text="Tầng" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{x:Static vm:HousekeepingRoomStatusViewModel.FloorFilters}" SelectedItem="{Binding FilterFloor}" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,4" Width="100">
                        <TextBlock Text="Khu" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{x:Static vm:HousekeepingRoomStatusViewModel.AreaFilters}" SelectedItem="{Binding FilterArea}" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                    <Button Content="Thêm lọc ▾" Style="{StaticResource SecondaryBtn}" Height="32" FontSize="11" Margin="0,14,6,4" Padding="8,0" Command="{Binding ToggleFilterCommand}"/>
                    <Button Content="Xóa lọc" Style="{StaticResource SecondaryBtn}" Height="32" FontSize="11" Margin="0,14,0,4" Padding="8,0" Command="{Binding ClearFiltersCommand}"/>
                </WrapPanel>
                <!-- Expanded filters -->
                <WrapPanel Grid.Row="1" Visibility="{Binding IsFilterExpanded, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <StackPanel Margin="0,0,6,4" Width="100">
                        <TextBlock Text="Room Class" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{x:Static vm:HousekeepingRoomStatusViewModel.RoomClassFilters}" SelectedItem="{Binding FilterRoomClass}" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,4" Width="110">
                        <TextBlock Text="Condition" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{x:Static vm:HousekeepingRoomStatusViewModel.RoomConditionFilters}" SelectedItem="{Binding FilterRoomCondition}" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,4" Width="120">
                        <TextBlock Text="Tìm khách" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SearchGuest, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,4" Width="120">
                        <TextBlock Text="Tìm Reservation" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SearchReservation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,4" VerticalAlignment="Bottom">
                        <CheckBox Content="VIP" IsChecked="{Binding FilterVipOnly}" FontSize="11" Foreground="#D97706" Margin="0,16,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,4" VerticalAlignment="Bottom">
                        <CheckBox Content="Có khách" IsChecked="{Binding FilterOccupiedOnly}" FontSize="11" Foreground="#2563EB" Margin="0,16,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,4" VerticalAlignment="Bottom">
                        <CheckBox Content="Trống" IsChecked="{Binding FilterVacantOnly}" FontSize="11" Foreground="#16A34A" Margin="0,16,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,4" VerticalAlignment="Bottom">
                        <CheckBox Content="OOO" IsChecked="{Binding FilterOooOnly}" FontSize="11" Foreground="#6B7280" Margin="0,16,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,4" VerticalAlignment="Bottom">
                        <CheckBox Content="OOS" IsChecked="{Binding FilterOosOnly}" FontSize="11" Foreground="#EA580C" Margin="0,16,0,0"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Row="4" MouseLeftButtonDown="OnMainAreaClick">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="460"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Content Area -->
            <Border Grid.Column="0" Margin="10,8,4,8" Style="{StaticResource PanelCard}" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <!-- Info/Error banner -->
                    <Border x:Name="InfoBanner" Background="#F0FDF4" Padding="10,6" Visibility="{Binding InfoMessage, Converter={StaticResource StringToVis}}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding InfoMessage}" FontSize="12" Foreground="#16A34A"/>
                            <Button Grid.Column="1" Content="✕" Width="20" Height="20" FontSize="10" Background="Transparent" Foreground="#16A34A" BorderThickness="0" Click="OnDismissInfo"/>
                        </Grid>
                    </Border>

                    <!-- WARNING BADGES -->
                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="10,6,10,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RoomWarningItem}">
                                <Border CornerRadius="12" Padding="8,3" Margin="0,0,6,2" BorderBrush="{Binding Color}" BorderThickness="1" Background="White">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Color}" Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{Binding Color}" Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding RoomNumber}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Color}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ═══ VIEW MODE 0: ROOM GRID ═══ -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                        <WrapPanel Margin="8,6,8,8" x:Name="RoomGridPanel">
                            <ItemsControl ItemsSource="{Binding FilteredRooms}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RoomStatusDto}">
                                        <Border Width="120" Height="105" Margin="0,0,4,4" CornerRadius="10" Cursor="Hand"
                                                Background="{Binding BgColor}" BorderBrush="{Binding BgBorder}" BorderThickness="1.5"
                                                MouseLeftButtonDown="OnRoomCardClick">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
                                            </Border.Effect>
                                            <Grid Margin="8,7">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <!-- Room number + VIP -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding RoomNumber}" FontSize="15" FontWeight="Bold" Foreground="#17365D"/>
                                                    <Border CornerRadius="4" Padding="3,1" Margin="4,0,0,0" Background="#E32F70"
                                                            Visibility="{Binding VipLevel, Converter={StaticResource StringToVis}}">
                                                        <TextBlock Text="VIP" FontSize="8" Foreground="White" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <!-- Room type + FO status dot -->
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,1,0,0">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding StatusDotColor}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RoomTypeName}" FontSize="10" Foreground="#64748B"/>
                                                </StackPanel>
                                                <!-- FO status -->
                                                <TextBlock Grid.Row="2" Text="{Binding FoStatusShort}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusDotColor}" Margin="0,1,0,0"/>
                                                <!-- Guest name -->
                                                <TextBlock Grid.Row="3" Text="{Binding GuestName}" FontSize="9" Foreground="#475569"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                <!-- Icons row -->
                                                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="🍸" FontSize="8" Visibility="{Binding MinibarNeedsCheck, Converter={StaticResource BoolToVis}}" ToolTip="Minibar cần kiểm" Margin="0,0,2,0"/>
                                                    <TextBlock Text="🚫" FontSize="8" Visibility="{Binding IsDnd, Converter={StaticResource BoolToVis}}" ToolTip="DND" Margin="0,0,2,0"/>
                                                    <TextBlock Text="🛏" FontSize="8" Visibility="{Binding HasExtraBed, Converter={StaticResource BoolToVis}}" ToolTip="Extra Bed" Margin="0,0,2,0"/>
                                                    <TextBlock Text="👶" FontSize="8" Visibility="{Binding HasBabyCot, Converter={StaticResource BoolToVis}}" ToolTip="Baby Cot" Margin="0,0,2,0"/>
                                                    <TextBlock Text="👕" FontSize="8" Visibility="{Binding HasLaundry, Converter={StaticResource BoolToVis}}" ToolTip="Laundry" Margin="0,0,2,0"/>
                                                    <TextBlock Text="🔔" FontSize="8" Visibility="{Binding HasWakeUpCall, Converter={StaticResource BoolToVis}}" ToolTip="Wake-up Call" Margin="0,0,2,0"/>
                                                    <TextBlock Text="📋" FontSize="8" Visibility="{Binding InspectionPending, Converter={StaticResource BoolToVis}}" ToolTip="Chờ kiểm tra"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                    </ScrollViewer>

                    <!-- ═══ VIEW MODE 1: TABLE ═══ -->
                    <DataGrid Grid.Row="1" Style="{StaticResource ModDataGrid}" ItemsSource="{Binding FilteredRooms}"
                              SelectedItem="{Binding SelectedRoom, Mode=TwoWay}" SelectionChanged="OnRoomSelectionChanged"
                              Visibility="{Binding IsTableView, Converter={StaticResource BoolToVis}}"
                              MouseDoubleClick="OnRoomDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu FontFamily="Segoe UI" FontSize="12">
                                <MenuItem Header="Đánh dấu sạch" Command="{Binding MarkCleanCommand}"/>
                                <MenuItem Header="Đánh dấu bẩn" Command="{Binding MarkDirtyCommand}"/>
                                <MenuItem Header="Gửi Housekeeping" Command="{Binding SendToHousekeepingCommand}"/>
                                <MenuItem Header="Kiểm tra phòng" Command="{Binding InspectRoomCommand}"/>
                                <Separator/>
                                <MenuItem Header="Đưa vào OOO" Command="{Binding SetOooCommand}"/>
                                <MenuItem Header="Đưa vào OOS" Command="{Binding SetOosCommand}"/>
                                <MenuItem Header="Hủy OOO/OOS" Command="{Binding ClearOooOosCommand}"/>
                                <Separator/>
                                <MenuItem Header="Đổi Attendant" Command="{Binding ChangeAttendantCommand}"/>
                                <MenuItem Header="Mở Minibar" Command="{Binding OpenMinibarCommand}"/>
                                <MenuItem Header="Lost &amp; Found" Command="{Binding OpenLostFoundCommand}"/>
                                <Separator/>
                                <MenuItem Header="Xem Folio" Command="{Binding OpenFolioCommand}"/>
                                <MenuItem Header="Mở Reservation" Command="{Binding OpenReservationCommand}"/>
                                <MenuItem Header="Room History" Command="{Binding OpenRoomHistoryCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Phòng" Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:RoomStatusDto}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusDotColor}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding RoomNumber}" FontSize="12" FontWeight="SemiBold" Foreground="#17365D"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tầng" Width="45" Binding="{Binding Floor}"/>
                            <DataGridTextColumn Header="Loại" Width="60" Binding="{Binding RoomType}"/>
                            <DataGridTemplateColumn Header="HK Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:RoomStatusDto}">
                                        <Border CornerRadius="6" Padding="5,2" Background="#F1F5F9" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding HkStatusLabel}" FontSize="10" Foreground="#475569" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="FO Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:RoomStatusDto}">
                                        <Border CornerRadius="6" Padding="5,2" HorizontalAlignment="Left"
                                                Background="{Binding BgColor}" BorderBrush="{Binding BgBorder}" BorderThickness="1">
                                            <TextBlock Text="{Binding FoStatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusDotColor}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Khách" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:RoomStatusDto}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GuestName}" FontSize="11" Foreground="#17365D" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ArrivalDate, StringFormat='{}{0:dd/MM}'}" FontSize="9" Foreground="#94A3B8"/>
                                                <TextBlock Text="→" FontSize="9" Foreground="#CBD5E1" Margin="2,0"/>
                                                <TextBlock Text="{Binding DepartureDate, StringFormat='{}{0:dd/MM}'}" FontSize="9" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="VIP" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:RoomStatusDto}">
                                        <Border CornerRadius="4" Padding="4,1" Background="#FFF0F5"
                                                Visibility="{Binding VipLevel, Converter={StaticResource StringToVis}}" HorizontalAlignment="Center">
                                            <TextBlock Text="VIP" FontSize="9" Foreground="#E32F70" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Tiện ích" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:RoomStatusDto}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🍸" FontSize="10" Visibility="{Binding MinibarNeedsCheck, Converter={StaticResource BoolToVis}}" Margin="0,0,2,0"/>
                                            <TextBlock Text="👕" FontSize="10" Visibility="{Binding HasLaundry, Converter={StaticResource BoolToVis}}" Margin="0,0,2,0"/>
                                            <TextBlock Text="🚫" FontSize="10" Visibility="{Binding IsDnd, Converter={StaticResource BoolToVis}}" Margin="0,0,2,0"/>
                                            <TextBlock Text="📋" FontSize="10" Visibility="{Binding InspectionPending, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ghi chú" Width="120" Binding="{Binding HkNote}">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#94A3B8"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Attendant" Width="100" Binding="{Binding Attendant}">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="10"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ═══ VIEW MODE 2: FLOOR VIEW ═══ -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsFloorView, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="10,6">
                            <WrapPanel Margin="0,0,0,8">
                                <ItemsControl ItemsSource="{Binding FloorList}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type sys:Int32}" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
                                            <Button Content="{Binding ., StringFormat='Tầng {0}'}" Width="70" Height="30" FontSize="11"
                                                    Margin="0,0,4,4" Style="{StaticResource ToolbarBtn}"
                                                    Command="{Binding DataContext.SelectFloorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding .}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                            <TextBlock Text="{Binding SelectedFloorView, StringFormat='Tầng {0}'}" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding FilteredRooms}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RoomStatusDto}">
                                        <Border Width="116" Height="100" Margin="0,0,4,4" CornerRadius="10" Cursor="Hand"
                                                Background="{Binding BgColor}" BorderBrush="{Binding BgBorder}" BorderThickness="1.5"
                                                MouseLeftButtonDown="OnRoomCardClick">
                                            <StackPanel Margin="8,7">
                                                <TextBlock Text="{Binding RoomNumber}" FontSize="14" FontWeight="Bold" Foreground="#17365D"/>
                                                <TextBlock Text="{Binding RoomTypeName}" FontSize="9" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding FoStatusShort}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusDotColor}" Margin="0,1,0,0"/>
                                                <TextBlock Text="{Binding GuestName}" FontSize="9" Foreground="#475569" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Legend strip at bottom -->
                    <Border Grid.Row="2" Padding="10,6" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                        <ItemsControl ItemsSource="{Binding LegendItems}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RoomLegendItem}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                        <Border Width="12" Height="12" CornerRadius="3" Background="{Binding BgColor}" BorderBrush="{Binding Color}" BorderThickness="1" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Code}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Color}" Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: Detail Panel. It overlays the list so the list keeps its full width when closed. -->
            <Border x:Name="RightDetailPanel" Grid.Column="0" Width="370" HorizontalAlignment="Right"
                    Margin="4,8,10,8" Style="{StaticResource SlidingDetailPanel}" Panel.ZIndex="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <!-- Detail Header -->
                    <Border Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedRoom.RoomNumber}" FontSize="18" FontWeight="Bold" Foreground="#102E5A"/>
                                    <Border CornerRadius="4" Padding="4,1" Margin="6,0,0,0" Background="#FFF0F5"
                                            Visibility="{Binding SelectedRoom.VipLevel, Converter={StaticResource StringToVis}}">
                                        <TextBlock Text="VIP" FontSize="9" Foreground="#E32F70" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding SelectedRoom.RoomTypeName}" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text=" · " FontSize="12" Foreground="#CBD5E1"/>
                                    <TextBlock Text="{Binding SelectedRoom.Floor, StringFormat='Tầng {0}'}" FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Width="28" Height="28" Command="{Binding CloseDetailCommand}"
                                    Style="{StaticResource SecondaryBtn}" FontSize="12" Padding="0"/>
                        </Grid>
                    </Border>

                    <!-- Detail Tabs -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,8,10,0">
                        <Button x:Name="TabRoom" Content="Phòng" Width="70" Style="{StaticResource InspectorTabBtn}" Click="OnDetailTabClick" Tag="0" Margin="0,0,2,0"/>
                        <Button x:Name="TabGuest" Content="Khách" Width="65" Style="{StaticResource InspectorTabBtn}" Click="OnDetailTabClick" Tag="1" Margin="0,0,2,0"/>
                        <Button x:Name="TabHK" Content="HK" Width="50" Style="{StaticResource InspectorTabBtn}" Click="OnDetailTabClick" Tag="2" Margin="0,0,2,0"/>
                        <Button x:Name="TabAmenity" Content="Tiện ích" Width="70" Style="{StaticResource InspectorTabBtn}" Click="OnDetailTabClick" Tag="3" Margin="0,0,2,0"/>
                        <Button x:Name="TabTimeline" Content="Timeline" Width="70" Style="{StaticResource InspectorTabBtn}" Click="OnDetailTabClick" Tag="4"/>
                    </StackPanel>

                    <!-- Detail Content -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="10,6,10,12">
                        <StackPanel>
                            <!-- TAB 0: Room Info -->
                            <StackPanel x:Name="DetailTab0" Visibility="Visible">
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Thông tin phòng" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Số phòng:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.RoomNumber}" FontSize="11" FontWeight="SemiBold" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Loại:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.RoomTypeName}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Diện tích:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.SquareMeters, StringFormat='{}{0} m²'}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Hướng:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.View}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Giường:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.BedType}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Smoking:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.IsSmoking}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Connecting:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.IsConnecting}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Trạng thái" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="FO Status:" Width="80" FontSize="11" Foreground="#94A3B8"/><Border CornerRadius="6" Padding="5,2" Background="{Binding SelectedRoom.BgColor}" BorderBrush="{Binding SelectedRoom.BgBorder}" BorderThickness="1"><TextBlock Text="{Binding SelectedRoom.FoStatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding SelectedRoom.StatusDotColor}"/></Border></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="HK Status:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.HkStatusLabel}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Condition:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.RoomCondition}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- TAB 1: Guest Info -->
                            <StackPanel x:Name="DetailTab1" Visibility="Collapsed">
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Thông tin khách" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Tên:" Width="75" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.GuestName}" FontSize="11" FontWeight="SemiBold" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Reservation:" Width="75" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.ReservationCode}" FontSize="11" Foreground="#2563EB"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Stay:" Width="75" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.StayDays, StringFormat='{}{0} đêm'}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Đến:" Width="75" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.ArrivalDate, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Đi:" Width="75" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.DepartureDate, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Người lớn:" Width="75" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.Adults}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Trẻ em:" Width="75" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.Children}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Quốc tịch:" Width="75" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.Nationality}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="VIP:" Width="75" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.VipLevel}" FontSize="11" Foreground="#E32F70" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Công ty:" Width="75" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.CompanyName}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Đại lý:" Width="75" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.AgentName}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- TAB 2: Housekeeping -->
                            <StackPanel x:Name="DetailTab2" Visibility="Collapsed">
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Thông tin Housekeeping" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Trạng thái:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.HkStatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Bẩn từ:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.DirtySince, StringFormat='{}{0:HH:mm dd/MM}'}" FontSize="11" Foreground="#DC2626"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Dọn lần cuối:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.LastCleaned, StringFormat='{}{0:HH:mm dd/MM}'}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Attendant:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.Attendant}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Inspector:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.Inspector}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Thời gian dọn:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.CleaningTimeMinutes, StringFormat='{}{0} phút'}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Condition:" Width="80" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="{Binding SelectedRoom.RoomCondition}" FontSize="11" Foreground="#17365D"/></StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- TAB 3: Amenities -->
                            <StackPanel x:Name="DetailTab3" Visibility="Collapsed">
                                <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Tiện nghi &amp; Dịch vụ" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                        <WrapPanel>
                                            <Border CornerRadius="6" Padding="8,4" Margin="0,0,6,4" Background="#EFF6FF" Visibility="{Binding SelectedRoom.HasExtraBed, Converter={StaticResource BoolToVis}}"><TextBlock Text="Extra Bed" FontSize="10" Foreground="#2563EB"/></Border>
                                            <Border CornerRadius="6" Padding="8,4" Margin="0,0,6,4" Background="#F5F3FF" Visibility="{Binding SelectedRoom.HasBabyCot, Converter={StaticResource BoolToVis}}"><TextBlock Text="Baby Cot" FontSize="10" Foreground="#7C3AED"/></Border>
                                            <Border CornerRadius="6" Padding="8,4" Margin="0,0,6,4" Background="#FFF7ED" Visibility="{Binding SelectedRoom.MinibarNeedsCheck, Converter={StaticResource BoolToVis}}"><TextBlock Text="Minibar cần kiểm" FontSize="10" Foreground="#D97706"/></Border>
                                            <Border CornerRadius="6" Padding="8,4" Margin="0,0,6,4" Background="#F0FDF4" Visibility="{Binding SelectedRoom.HasLaundry, Converter={StaticResource BoolToVis}}"><TextBlock Text="Laundry" FontSize="10" Foreground="#16A34A"/></Border>
                                            <Border CornerRadius="6" Padding="8,4" Margin="0,0,6,4" Background="#ECFEFF" Visibility="{Binding SelectedRoom.HasWakeUpCall, Converter={StaticResource BoolToVis}}"><TextBlock Text="Wake-up Call" FontSize="10" Foreground="#0891B2"/></Border>
                                            <Border CornerRadius="6" Padding="8,4" Margin="0,0,6,4" Background="#F3F4F6" Visibility="{Binding SelectedRoom.IsDnd, Converter={StaticResource BoolToVis}}"><TextBlock Text="DND" FontSize="10" Foreground="#4B5563"/></Border>
                                            <Border CornerRadius="6" Padding="8,4" Margin="0,0,6,4" Background="#FEF2F2" Visibility="{Binding SelectedRoom.IsMur, Converter={StaticResource BoolToVis}}"><TextBlock Text="MUR" FontSize="10" Foreground="#DC2626"/></Border>
                                            <Border CornerRadius="6" Padding="8,4" Margin="0,0,6,4" Background="#FFF7ED" Visibility="{Binding SelectedRoom.InspectionPending, Converter={StaticResource BoolToVis}}"><TextBlock Text="Chờ kiểm tra" FontSize="10" Foreground="#D97706"/></Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- TAB 4: Timeline -->
                            <StackPanel x:Name="DetailTab4" Visibility="Collapsed">
                                <ItemsControl ItemsSource="{Binding RoomTimeline}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RoomTimelineEntry}">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Width="40" VerticalAlignment="Top" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Time}" FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                                <Grid Grid.Column="1" Width="22" Margin="4,0">
                                                    <Rectangle Width="2" Fill="#E2E8F0" HorizontalAlignment="Center"/>
                                                    <Ellipse Width="9" Height="9" Fill="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                </Grid>
                                                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="10,7" BorderBrush="#F1F5F9" BorderThickness="1" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Event}" FontSize="11" FontWeight="SemiBold" Foreground="#102E5A"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#64748B"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

        <!-- ═══ FOOTER ═══ -->
        <Border Grid.Row="5" Padding="14,8" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="#64748B">
                        <Run Text="Hiển thị "/><Run Text="{Binding FilteredRooms.Count, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding TotalRooms, Mode=OneWay}"/><Run Text=" phòng"/>
                    </TextBlock>
                    <Border CornerRadius="6" Padding="6,2" Margin="10,0,0,0" Background="#EFF6FF">
                        <TextBlock FontSize="11" Foreground="#1E40AF" FontWeight="SemiBold">
                            <Run Text="Công suất: "/><Run Text="{Binding OccupancyPct, Mode=OneWay, StringFormat='{}{0}%'}"/>
                            <Run Text=" · Sạch: "/><Run Text="{Binding CleanRate, Mode=OneWay, StringFormat='{}{0}%'}"/>
                            <Run Text=" · Bẩn: "/><Run Text="{Binding DirtyRate, Mode=OneWay, StringFormat='{}{0}%'}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilteredRooms.Count, Mode=OneWay, StringFormat='{}{0} phòng hiển thị'}" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
