<Window x:Class="ASMILE.BO.App.Views.ExchangeRateEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tỷ giá" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="DatePicker"><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Height" Value="34"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#17365D"/></Style>
        <Style x:Key="Primary" TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="18,0"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
    </Window.Resources>
    <Border Padding="20" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Tỷ giá ngoại tệ" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Mã tiền tệ *"/><TextBox x:Name="CodeBox"/><TextBlock Text="Tên tiền tệ *"/><TextBox x:Name="NameBox"/><TextBlock Text="Ký hiệu"/><TextBox x:Name="SymbolBox"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Mua vào *"/><TextBox x:Name="BuyBox"/><TextBlock Text="Bán ra *"/><TextBox x:Name="SellBox"/><TextBlock Text="Hotel Rate *"/><TextBox x:Name="HotelBox"/></StackPanel>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Hiệu lực từ *"/><DatePicker x:Name="FromPicker"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Hiệu lực đến"/><DatePicker x:Name="ToPicker"/></StackPanel></Grid>
            <CheckBox x:Name="DefaultBox" Content="Đặt làm tiền tệ mặc định" Margin="0,0,0,10" Foreground="#17365D"/>
            <TextBlock Text="Ghi chú"/><TextBox x:Name="NotesBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Hủy" Click="OnCancel" Height="36" Padding="18,0"/><Button Content="Lưu" Click="OnSave" Style="{StaticResource Primary}"/></StackPanel>
        </StackPanel>
    </Border>
</Window>
