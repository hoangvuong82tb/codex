<UserControl x:Class="ASMILE.BO.App.Views.RoomTypeMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource HotelSettingsButtonBase}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="BorderBrush" Value="#D7E2F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>
        <Style x:Key="SettingsTextBox" TargetType="TextBox" BasedOn="{StaticResource HotelSettingsTextBoxBase}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D7E2F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent" Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Padding="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Hạng phòng" FontSize="22" FontWeight="SemiBold" Foreground="#102E5A"/>
                    <TextBlock Text="Thêm, chỉnh sửa, kích hoạt và tạm ngưng hạng phòng bằng dữ liệu thật." Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Làm mới" Command="{Binding LoadCommand}" Style="{StaticResource SettingsButton}"/>
                    <Button Content="+ Thêm hạng phòng" Command="{Binding NewRoomTypeCommand}" Style="{StaticResource SettingsPrimaryButton}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Từ khóa" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" ToolTip="Tìm theo mã hoặc tên hạng phòng"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Tìm" Command="{Binding SearchCommand}" Style="{StaticResource SettingsButton}" Margin="8,0,0,0"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
            <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="False" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#F8FAFC" CornerRadius="10" ClipToBounds="True" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Mã" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Grid.Column="1" Text="Tên hạng phòng" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Grid.Column="2" Text="Sức chứa" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Grid.Column="3" Text="Trạng thái" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding RoomTypes}"
                             SelectedItem="{Binding SelectedRoomType, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="RoomTypeCard" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="#17365D"/>
                                        <StackPanel Grid.Column="1" MinWidth="0"><TextBlock Text="{Binding Name}" Foreground="#17365D" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding StandardAdultCapacity, StringFormat='NL chuẩn: {0}'}" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding IsActive, StringFormat='{}{0}'}" Foreground="#2563EB" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#D7E3F1"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                    <Setter Property="BorderBrush" Value="#BFD7F5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                    <Setter Property="BorderBrush" Value="#BFD7F5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="1" Margin="16,0,0,0" Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Chi tiết hạng phòng" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A"/>
                        <TextBlock Text="{Binding SelectedSummary}" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/>
                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Mã hạng phòng" Foreground="#475569"/><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,10"/>
                            <TextBlock Text="Tên hạng phòng" Foreground="#475569"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,10"/>
                            <TextBlock Text="Mô tả" Foreground="#475569"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="10,8" BorderBrush="#D7E2F0" Margin="0,4,0,10"/>
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="NL chuẩn" Foreground="#475569"/><TextBox Text="{Binding StandardAdultCapacity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="TE chuẩn" Foreground="#475569"/><TextBox Text="{Binding StandardChildCapacity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,0"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="NL tối đa" Foreground="#475569"/><TextBox Text="{Binding MaximumAdultCapacity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="TE tối đa" Foreground="#475569"/><TextBox Text="{Binding MaximumChildCapacity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,0"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Số khách mặc định" Foreground="#475569"/><TextBox Text="{Binding DefaultOccupancy, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,10"/>
                            <TextBlock Text="Thứ tự hiển thị" Foreground="#475569"/><TextBox Text="{Binding DisplayOrder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,14"/>
                            <StackPanel Orientation="Horizontal"><Button Content="Hủy" Command="{Binding CancelEditCommand}" Style="{StaticResource SettingsButton}"/><Button Content="Lưu hạng phòng" Command="{Binding SaveCommand}" Style="{StaticResource SettingsPrimaryButton}" Margin="0"/></StackPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsReadOnlyPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Trạng thái" Foreground="#64748B" Margin="0,0,0,3"/><TextBlock Text="{Binding SelectedStatus}" Foreground="#17365D" FontWeight="SemiBold"/>
                            <TextBlock Text="Chọn một hạng phòng để sửa hoặc đổi trạng thái. Tầng và tòa nhà được quản lý trong hồ sơ phòng." Foreground="#64748B" TextWrapping="Wrap" Margin="0,14,0,16"/>
                            <StackPanel Orientation="Horizontal"><Button Content="Sửa" Command="{Binding EditRoomTypeCommand}" Style="{StaticResource SettingsPrimaryButton}"/><Button Content="Bật / tạm ngưng" Command="{Binding ToggleActiveCommand}" Style="{StaticResource SettingsButton}" Margin="0"/></StackPanel>
                        </StackPanel>
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap"/></Border>
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0" Visibility="{Binding HasInfo, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding InfoMessage}" Foreground="#166534" TextWrapping="Wrap"/></Border>
                    </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>


