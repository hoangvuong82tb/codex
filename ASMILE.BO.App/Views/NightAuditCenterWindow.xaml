<Window x:Class="ASMILE.BO.App.Views.NightAuditCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Night Audit" Width="1460" Height="860" MinWidth="1080" MinHeight="680"
        Background="#F7F9FC" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#12335F" />
        <SolidColorBrush x:Key="Line" Color="#DCE6F3" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#F2F6FB" />
            <Setter Property="BorderBrush" Value="#D7E2F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#183455" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="156" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E9EFF7" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeight" Value="43" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FBFCFE" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF1FA" />
            <Setter Property="Foreground" Value="#183455" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="BorderBrush" Value="#EAF1FA" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#17324D" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFF4DF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,17">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" Background="#276BE8" CornerRadius="13" Margin="0,0,13,0">
                        <TextBlock Text="NA" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Night Audit" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="Kiểm tra, đối chiếu và đóng ngày kinh doanh khách sạn." Foreground="#61758F" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Làm mới" Click="Refresh_Click" />
                    <Button Content="Đóng" Margin="0" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FBFCFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CheckStep" Content="A  Kiểm tra" Tag="check" Style="{StaticResource StepButton}" Click="Step_Click" />
                <Button x:Name="RunStep" Content="B  Chạy Night Audit" Tag="run" Style="{StaticResource StepButton}" Click="Step_Click" />
                <Button x:Name="CloseStep" Content="C  Đóng ngày" Tag="close" Style="{StaticResource StepButton}" Click="Step_Click" />
                <Border Background="#EEF7FF" CornerRadius="12" Padding="13,8" Margin="6,0,0,0">
                    <TextBlock x:Name="BusinessDateText" Foreground="#2563A9" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,12">
            <WrapPanel>
                <Border Width="152" Margin="0,0,10,0" Padding="12,9" Background="#EEF8FF" BorderBrush="#B8DEFF" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Text="06" FontSize="19" FontWeight="Bold" Foreground="#1675D1" /><TextBlock Text="Hạng mục kiểm tra" Foreground="#60748E" FontSize="11" /></StackPanel></Border>
                <Border Width="152" Margin="0,0,10,0" Padding="12,9" Background="#EDFCF2" BorderBrush="#A9E9BD" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Text="04" FontSize="19" FontWeight="Bold" Foreground="#169B46" /><TextBlock Text="Đã sẵn sàng" Foreground="#60748E" FontSize="11" /></StackPanel></Border>
                <Border Width="152" Margin="0,0,10,0" Padding="12,9" Background="#FFF5EB" BorderBrush="#FFD59C" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Text="02" FontSize="19" FontWeight="Bold" Foreground="#D97606" /><TextBlock Text="Cần xử lý" Foreground="#60748E" FontSize="11" /></StackPanel></Border>
                <Border Width="185" Margin="0,0,10,0" Padding="12,9" Background="#F8F1FF" BorderBrush="#DCC2FF" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Text="12,450,000 đ" FontSize="19" FontWeight="Bold" Foreground="#7C3AED" /><TextBlock Text="Chênh lệch tạm tính" Foreground="#60748E" FontSize="11" /></StackPanel></Border>
                <Border Width="152" Padding="12,9" Background="#F5F8FE" BorderBrush="#D8E4F4" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Text="23:45" FontSize="19" FontWeight="Bold" Foreground="#2766DF" /><TextBlock Text="Lần chạy gần nhất" Foreground="#60748E" FontSize="11" /></StackPanel></Border>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="3" Margin="22,14,22,12">
            <Grid x:Name="CheckPanel">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Danh sách kiểm tra trước khi chạy" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Hoàn tất tất cả mục bắt buộc trước khi chạy Night Audit." Foreground="#61758F" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,12">
                            <Button Content="Mở đối chiếu" Click="OpenReconcile_Click" />
                            <Button Content="Mở Folio" Click="OpenFolio_Click" />
                            <Button Content="Đánh dấu đã kiểm tra" Background="#276BE8" BorderBrush="#276BE8" Foreground="White" Click="MarkChecked_Click" />
                        </StackPanel>
                        <DataGrid x:Name="CheckGrid" Grid.Row="2" SelectionChanged="CheckGrid_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hạng mục" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Nguồn" Binding="{Binding Source}" Width="1.2*" />
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="1.2*" />
                                <DataGridTextColumn Header="Số liệu" Binding="{Binding Detail}" Width="1.4*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Chi tiết hạng mục" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBlock x:Name="SelectedCheckName" FontSize="17" FontWeight="SemiBold" Foreground="#173D72" Margin="0,18,0,7" TextWrapping="Wrap" />
                        <TextBlock x:Name="SelectedCheckDetail" Foreground="#5C708A" TextWrapping="Wrap" LineHeight="21" />
                        <Border Background="#FFF7E5" CornerRadius="8" Padding="12" Margin="0,18,0,0"><TextBlock x:Name="SelectedCheckHint" Foreground="#A65B00" TextWrapping="Wrap" /></Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="RunPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Chạy Night Audit" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="Xử lý tuần tự các bước cuối ngày trên dữ liệu đã được kiểm tra." Foreground="#61758F" Margin="0,4,0,16" />
                        <ItemsControl x:Name="RunItems"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F8FAFD" BorderBrush="#E1EAF5" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="26" Height="26" Background="#E7F8EC" CornerRadius="13"><TextBlock Text="✓" Foreground="#159447" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border><StackPanel Grid.Column="1" Margin="11,0"><TextBlock Text="{Binding Name}" Foreground="#183455" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Foreground="#6A7D95" FontSize="12" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#169B46" VerticalAlignment="Center" FontWeight="SemiBold" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Điều khiển chạy" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="Chạy thử không ghi nhận dữ liệu; chạy chính thức sẽ khóa các nghiệp vụ đã hoàn tất trong ngày." Foreground="#61758F" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,20" />
                        <Button Content="Chạy thử" Click="Simulate_Click" />
                        <Button Content="Chạy Night Audit" Background="#18B33F" BorderBrush="#18B33F" Foreground="White" Click="RunAudit_Click" />
                        <Button Content="Xem nhật ký" Click="OpenLog_Click" />
                        <TextBlock x:Name="RunStatus" Foreground="#277146" Margin="0,18,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ClosePanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Đóng ngày kinh doanh" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="Xác nhận các điều kiện trước khi chuyển ngày kinh doanh của khách sạn." Foreground="#61758F" Margin="0,4,0,18" />
                        <CheckBox x:Name="CloseCheck1" Content="Đã hoàn tất đối chiếu Folio và thanh toán" Margin="0,0,0,12" Checked="CloseCheckChanged" Unchecked="CloseCheckChanged" />
                        <CheckBox x:Name="CloseCheck2" Content="Đã rà soát giao dịch treo và chênh lệch" Margin="0,0,0,12" Checked="CloseCheckChanged" Unchecked="CloseCheckChanged" />
                        <CheckBox x:Name="CloseCheck3" Content="Đã kiểm tra doanh thu và công nợ trong ngày" Margin="0,0,0,12" Checked="CloseCheckChanged" Unchecked="CloseCheckChanged" />
                        <CheckBox x:Name="CloseCheck4" Content="Tôi xác nhận chuyển ngày kinh doanh" Checked="CloseCheckChanged" Unchecked="CloseCheckChanged" />
                        <Border Background="#FFF7E5" CornerRadius="8" Padding="12" Margin="0,22,0,0"><TextBlock x:Name="CloseHint" Foreground="#A65B00" TextWrapping="Wrap" /></Border>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Tóm tắt ngày 09/08/2026" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="Doanh thu phòng" Margin="0,18,0,2" Foreground="#71839A" /><TextBlock Text="184,500,000 đ" FontSize="19" FontWeight="Bold" Foreground="#173D72" />
                        <TextBlock Text="Doanh thu dịch vụ" Margin="0,14,0,2" Foreground="#71839A" /><TextBlock Text="67,250,000 đ" FontSize="19" FontWeight="Bold" Foreground="#173D72" />
                        <TextBlock Text="Chênh lệch cần theo dõi" Margin="0,14,0,2" Foreground="#71839A" /><TextBlock Text="12,450,000 đ" FontSize="19" FontWeight="Bold" Foreground="#D97606" />
                        <Button x:Name="CloseDayButton" Content="Đóng ngày" Background="#276BE8" BorderBrush="#276BE8" Foreground="White" Margin="0,24,0,0" IsEnabled="False" Click="CloseDay_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel><TextBlock x:Name="FooterText" Foreground="#6A7D95" VerticalAlignment="Center" /><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Quay lại" Click="Back_Click" /><Button Content="Tiếp tục" Background="#276BE8" BorderBrush="#276BE8" Foreground="White" Margin="0" Click="Next_Click" /></StackPanel></DockPanel>
        </Border>
    </Grid>
</Window>
