<Window x:Class="ASMILE.BO.App.Views.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check-out" Width="900" Height="640"
        MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="GrayBtn" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ActionCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="24,20"/><Setter Property="Cursor" Value="Hand"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#DC2626" Offset="0"/><GradientStop Color="#B91C1C" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="Check-out" FontSize="20" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Hoàn tất trả phòng và bàn giao." FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="2" Content="Đóng" Click="OnClose" Style="{StaticResource GrayBtn}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="32,28,32,20">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ActionCard}" MouseLeftButtonDown="OnPrepCheckout">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="14" Background="#EFF6FF" Margin="0,0,0,14"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Chuẩn bị Check-out" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Kiểm tra Folio, dịch vụ, bàn giao." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ActionCard}" MouseLeftButtonDown="OnQuickCheckout">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="14" Background="#F0FDF4" Margin="0,0,0,14"><TextBlock Text="&#xE961;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Check-out nhanh" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Hoàn tất nhanh, Folio đã cân." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ActionCard}" MouseLeftButtonDown="OnGroupCheckout" Margin="0,16,0,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="14" Background="#FFF7ED" Margin="0,0,0,14"><TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Check-out đoàn" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Xử lý đoàn, nhiều phòng cùng lúc." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ActionCard}" MouseLeftButtonDown="OnExpressCheckout" Margin="0,16,0,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="14" Background="#F3E8FF" Margin="0,0,0,14"><TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Express Check-out" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Khách để chìa khóa, rời không chờ." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ActionCard}" MouseLeftButtonDown="OnCheckFolio" Margin="0,16,0,0" Padding="20,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="12" Background="#FEF2F2" Margin="0,0,16,0"><TextBlock Text="&#xE90B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Kiểm tra Folio" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A"/>
                        <TextBlock Text="Xem số dư, công nợ và tình trạng thanh toán trước khi Check-out." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="14,10" Margin="14,10,14,12" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#94A3B8" Text="Chọn một thao tác để bắt đầu"/>
                <Button Grid.Column="1" Content="Đóng" Click="OnClose" Style="{StaticResource GrayBtn}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
