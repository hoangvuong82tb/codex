<Window x:Class="ASMILE.BO.App.Views.WebReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ASMILE.BO.App.Views"
        Title="Đặt phòng Web"
        Width="1300" Height="800"
        MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F7F9FC"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="10" Background="#E0F2FE"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Đặt phòng Web" FontSize="19" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Tra cứu và xử lý đặt phòng từ Website/OTA bằng dữ liệu thật" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/></StackPanel>
                <Button Grid.Column="2" Content="Làm mới" Click="OnRefreshClick" Style="{StaticResource FluentSecondaryButton}" Padding="16,8"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
            <views:SearchReservationView DataContext="{Binding}"/>
        </Border>
    </Grid>
</Window>
