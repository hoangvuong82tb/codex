<UserControl x:Class="ASMILE.BO.App.Views.ReservationModalWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="WsLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#7B8DA6"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style x:Key="WsValue" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style x:Key="WsDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="White"/><Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="RowHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#66000000">
        <Border Background="#F8FAFC" CornerRadius="16"
                Width="1280" MaxHeight="820"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.18" Color="#000000"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <!-- ═══ HEADER ═══ -->
                <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Content="← Quay lại" Command="{Binding CloseCommand}" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" FontSize="13" Padding="8,4"/>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="#102E5A"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Làm mới" Command="{Binding Workspace.RefreshCommand}" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Padding="14,6" Cursor="Hand" FontSize="12"/>
                            <Button Content="✕" Command="{Binding CloseCommand}" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#64748B" Cursor="Hand" Width="32" Height="32" Margin="8,0,0,0" ToolTip="Đóng (Esc)"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ KPI STATUS BAR (StatusMode only) ═══ -->
                <Border Grid.Row="1" Padding="20,12" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                        Visibility="{Binding Workspace.ShowKpiBar, Converter={StaticResource BoolVis}}">
                    <WrapPanel Orientation="Horizontal">
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" MinWidth="110" Cursor="Hand">
                            <StackPanel><TextBlock Text="Draft" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="—" FontSize="24" FontWeight="Bold" Foreground="#64748B"/></StackPanel>
                        </Border>
                        <Border Background="#FFF7ED" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" MinWidth="110" Cursor="Hand">
                            <StackPanel><TextBlock Text="Tentative" FontSize="11" Foreground="#D97706"/><TextBlock Text="—" FontSize="24" FontWeight="Bold" Foreground="#D97706"/></StackPanel>
                        </Border>
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" MinWidth="110" Cursor="Hand">
                            <StackPanel><TextBlock Text="Confirmed" FontSize="11" Foreground="#2563EB"/><TextBlock Text="—" FontSize="24" FontWeight="Bold" Foreground="#2563EB"/></StackPanel>
                        </Border>
                        <Border Background="#F0FDF4" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" MinWidth="110" Cursor="Hand">
                            <StackPanel><TextBlock Text="Checked In" FontSize="11" Foreground="#16A34A"/><TextBlock Text="—" FontSize="24" FontWeight="Bold" Foreground="#16A34A"/></StackPanel>
                        </Border>
                        <Border Background="#FEF2F2" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" MinWidth="110" Cursor="Hand">
                            <StackPanel><TextBlock Text="No Show" FontSize="11" Foreground="#DC2626"/><TextBlock Text="—" FontSize="24" FontWeight="Bold" Foreground="#DC2626"/></StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" MinWidth="110" Cursor="Hand">
                            <StackPanel><TextBlock Text="Cancelled" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="—" FontSize="24" FontWeight="Bold" Foreground="#94A3B8"/></StackPanel>
                        </Border>
                    </WrapPanel>
                </Border>

                <!-- ═══ FILTER BAR ═══ -->
                <Border Grid.Row="2" Padding="20,12" Background="White">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="130"/><ColumnDefinition Width="8"/><ColumnDefinition Width="120"/><ColumnDefinition Width="8"/><ColumnDefinition Width="120"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Workspace.SearchText, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center" FontSize="13"/>
                        <ComboBox Grid.Column="2" Height="36" ItemsSource="{Binding Workspace.StatusFilters}" SelectedItem="{Binding Workspace.SelectedStatus}" BorderBrush="#CBD5E1" FontSize="13"/>
                        <DatePicker Grid.Column="4" SelectedDate="{Binding Workspace.FilterArrivalFrom}" Height="36" FontSize="13"/>
                        <DatePicker Grid.Column="6" SelectedDate="{Binding Workspace.FilterArrivalTo}" Height="36" FontSize="13"/>
                        <Button Grid.Column="8" Content="Tìm" Command="{Binding Workspace.SearchCommand}" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="16,0" Cursor="Hand" FontSize="13" FontWeight="SemiBold" Height="36"/>
                        <Button Grid.Column="10" Content="Xóa lọc" Command="{Binding Workspace.ClearFiltersCommand}" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Padding="14,0" Cursor="Hand" FontSize="13" Height="36"/>
                    </Grid>
                </Border>

                <!-- ═══ MAIN CONTENT: DataGrid + Detail Panel ═══ -->
                <Grid Grid.Row="3" Margin="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding Workspace.Reservations}" SelectedItem="{Binding Workspace.SelectedReservation}"
                              Style="{StaticResource WsDataGrid}" Margin="20,12,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Số XN" Binding="{Binding ReservationNumber}" Width="120"/>
                            <DataGridTextColumn Header="Tên khách" Binding="{Binding GuestName}" Width="160"/>
                            <DataGridTextColumn Header="Ngày đến" Binding="{Binding ArrivalDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Ngày đi" Binding="{Binding DepartureDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Người lớn" Binding="{Binding AdultCount}" Width="70"/>
                            <DataGridTextColumn Header="Trẻ em" Binding="{Binding ChildCount}" Width="60"/>
                            <DataGridTextColumn Header="Nguồn" Binding="{Binding Source}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Detail Panel -->
                    <Border Grid.Column="1" Width="300" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0"
                            Visibility="{Binding Workspace.SelectedReservation, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                        <Grid Margin="0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,16">
                                    <TextBlock Text="Chi tiết đặt phòng" FontSize="15" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,14"/>

                                    <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource WsLabel}" Text="Số xác nhận"/><TextBlock Style="{StaticResource WsValue}" Text="{Binding Workspace.SelectedReservation.ReservationNumber, Mode=OneWay, FallbackValue=—}"/>
                                            <TextBlock Style="{StaticResource WsLabel}" Margin="0,8,0,0" Text="Trạng thái"/><TextBlock Style="{StaticResource WsValue}" Text="{Binding Workspace.SelectedStatusText, Mode=OneWay, FallbackValue=—}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource WsLabel}" Text="Khách"/><TextBlock Style="{StaticResource WsValue}" Text="{Binding Workspace.SelectedGuestName, Mode=OneWay, FallbackValue=—}"/>
                                            <TextBlock Style="{StaticResource WsLabel}" Margin="0,6,0,0" Text="Điện thoại"/><TextBlock Text="{Binding Workspace.SelectedPhone, Mode=OneWay, FallbackValue=—}" FontSize="13" Foreground="#17365D"/>
                                            <TextBlock Style="{StaticResource WsLabel}" Margin="0,6,0,0" Text="Email"/><TextBlock Text="{Binding Workspace.SelectedEmail, Mode=OneWay, FallbackValue=—}" FontSize="13" Foreground="#17365D" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource WsLabel}" Text="Lưu trú"/>
                                            <TextBlock Style="{StaticResource WsValue}"><Run Text="{Binding Workspace.SelectedArrival, Mode=OneWay, StringFormat=dd/MM/yyyy, FallbackValue=—}"/><Run Text=" → "/><Run Text="{Binding Workspace.SelectedDeparture, Mode=OneWay, StringFormat=dd/MM/yyyy, FallbackValue=—}"/></TextBlock>
                                            <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="#2563EB" FontWeight="SemiBold"><Run Text="{Binding Workspace.SelectedNights, Mode=OneWay}"/><Run Text=" đêm"/></TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource WsLabel}" Text="Phòng"/>
                                            <TextBlock Style="{StaticResource WsValue}" Text="{Binding Workspace.SelectedRoomTypeName, Mode=OneWay, FallbackValue=—, TargetNullValue=—}"/>
                                            <TextBlock Style="{StaticResource WsLabel}" Margin="0,6,0,0" Text="Số phòng"/><TextBlock Text="{Binding Workspace.SelectedRoomNumber, Mode=OneWay, FallbackValue=Chưa phân, TargetNullValue=Chưa phân}" FontSize="13" Foreground="#17365D"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#FAFBFD" CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource WsLabel}" Text="Nguồn"/><TextBlock Style="{StaticResource WsValue}" Text="{Binding Workspace.SelectedSource, Mode=OneWay, FallbackValue=—}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Action Buttons -->
                            <Border Grid.Row="1" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <Button Content="Sửa" Height="36" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"
                                            IsEnabled="{Binding Workspace.CanUpdate}"/>
                                    <Button Content="Phân phòng" Height="36" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Cursor="Hand" FontSize="13" Margin="0,0,0,6"
                                            IsEnabled="{Binding Workspace.CanAssignRoom}"/>
                                    <Button Content="Xác nhận" Height="36" Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"
                                            IsEnabled="{Binding Workspace.CanConfirm}"/>
                                    <Button Content="Hủy đặt phòng" Height="36" Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="13"
                                            IsEnabled="{Binding Workspace.CanCancelReservation}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══ PAGINATION ═══ -->
                <Border Grid.Row="4" Padding="20,12" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Foreground="#64748B" FontSize="13" Text="{Binding Workspace.TotalCount, StringFormat='Tổng: {0}'}"/>
                            <TextBlock VerticalAlignment="Center" Foreground="#94A3B8" FontSize="13" Margin="16,0,0,0"
                                       Visibility="{Binding Workspace.HasError, Converter={StaticResource BoolVis}}" Text="{Binding Workspace.ErrorMessage, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Trước" Command="{Binding Workspace.PreviousPageCommand}" IsEnabled="{Binding Workspace.HasPreviousPage}" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Padding="14,6" Cursor="Hand" FontSize="12"/>
                            <Button Content="Sau" Command="{Binding Workspace.NextPageCommand}" IsEnabled="{Binding Workspace.HasNextPage}" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Padding="14,6" Cursor="Hand" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
