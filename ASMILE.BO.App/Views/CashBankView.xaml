                                        <Button Grid.Row="3" Style="{StaticResource EnterpriseModuleCmdSuccess}" Tag="&#xE8C8;" Content="Xuất" Margin="0,8,0,0" HorizontalAlignment="Stretch" Command="{Binding ExportReportCommand}" />
                                        <Button Grid.Row="4" Style="{StaticResource EnterpriseModuleCmdSecondary}" Tag="&#xE735;" Content="Ưa thích" Margin="0,8,0,0" HorizontalAlignment="Stretch" Command="{Binding ToggleFavoriteReportCommand}" />
                                    </Grid>
                                </Border>
                                <DataGrid Grid.Row="0" Grid.Column="1" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding ReportRowsPager.Items}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ngày" Width="95" Binding="{Binding Date}" />
                                        <DataGridTextColumn Header="Chứng từ" Width="150" Binding="{Binding DocumentNo}" />
                                        <DataGridTextColumn Header="Tài khoản" Width="150" Binding="{Binding Account}" />
                                        <DataGridTextColumn Header="Diễn giải" Width="2*" Binding="{Binding Description}" />
                                        <DataGridTextColumn Header="Nợ/Thu" Width="120" Binding="{Binding Debit}" />
                                        <DataGridTextColumn Header="Có/Chi" Width="120" Binding="{Binding Credit}" />
                                        <DataGridTextColumn Header="Số dư/Lệch" Width="120" Binding="{Binding Balance}" />
                                        <DataGridTextColumn Header="Trạng thái" Width="105" Binding="{Binding Status, Converter={StaticResource StatusDisplayConverter}}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CashBankPagerCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Foreground="#475569" Text="{Binding ReportRowsPager.PageText}" />
                                        <controls:TablePagerControl Grid.Column="1" DataContext="{Binding ReportRowsPager}" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="270" />
                                    </Grid.ColumnDefinitions>
                                    <DataGrid Grid.Row="0" Grid.Column="0" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding ReportHistoryPager.Items}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Báo cáo" Width="170" Binding="{Binding ReportCode}" />
                                            <DataGridTextColumn Header="Bắt đầu" Width="150" Binding="{Binding StartedAt, StringFormat=dd/MM/yyyy HH:mm}" />
                                            <DataGridTextColumn Header="Dòng" Width="80" Binding="{Binding RowCount}" />
                                            <DataGridTextColumn Header="Trạng thái" Width="105" Binding="{Binding Status, Converter={StaticResource StatusDisplayConverter}}" />
                                            <DataGridTextColumn Header="Lỗi" Width="2*" Binding="{Binding ErrorMessage}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource EnterpriseModulePanelCard}" Margin="10,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Báo cáo ưa thích" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding FavoriteReports}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Foreground="#1D4ED8" Margin="0,0,0,6" Text="{Binding Label}" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CashBankPagerCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Foreground="#475569" Text="{Binding ReportHistoryPager.PageText}" />
                                            <controls:TablePagerControl Grid.Column="1" DataContext="{Binding ReportHistoryPager}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </controls:EnterpriseStatePresenter.StateContent>
        </controls:EnterpriseStatePresenter>

        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="#64748B" Text="{Binding LastRefreshText}" />
                <TextBlock Foreground="#334155" TextTrimming="CharacterEllipsis" Text="{Binding DrilldownText}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>


