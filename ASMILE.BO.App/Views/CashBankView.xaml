                                        </StackPanel>
                                        <StackPanel Grid.Row="5" Style="{StaticResource CashBankField}">
                                            <TextBlock Text="Ngày giao dịch" Style="{StaticResource CashBankLabel}" />
                                            <DatePicker SelectedDate="{Binding QuickBankEntry.TransactionDate}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="6" Style="{StaticResource CashBankField}">
                                            <TextBlock Text="Diễn giải" Style="{StaticResource CashBankLabel}" />
                                            <TextBox Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding QuickBankEntry.Description, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <Button Grid.Row="7"
                                                Style="{StaticResource EnterpriseModuleCmdSuccess}"
                                                Tag="&#xE74E;"
                                                Content="{Binding QuickBankSaveText}"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding SaveQuickBankCommand}" />
                                    </Grid>
                                </Border>
                                <DataGrid Grid.Row="0" Grid.Column="1" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding BankTransactionsPager.Items}" SelectedItem="{Binding SelectedBankTransaction}" PreviewKeyDown="BankGrid_PreviewKeyDown">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ngày" Width="95" Binding="{Binding TransactionDate, StringFormat=dd/MM/yyyy}" />
                                        <DataGridTextColumn Header="Số GD" Width="130" Binding="{Binding TransactionNo}" />
                                        <DataGridTextColumn Header="Tham chiếu" Width="120" Binding="{Binding ReferenceNo}" />
                                        <DataGridTextColumn Header="TK NH" Width="130" Binding="{Binding AccountNumber}" />
                                        <DataGridTextColumn Header="Diễn giải" Width="2*" Binding="{Binding Description}" />
                                        <DataGridTextColumn Header="Thu" Width="110" Binding="{Binding DebitAmount, StringFormat=N0}" />
                                        <DataGridTextColumn Header="Chi" Width="110" Binding="{Binding CreditAmount, StringFormat=N0}" />
                                        <DataGridTextColumn Header="Số dư" Width="120" Binding="{Binding BalanceAfter, StringFormat=N0}" />
                                        <DataGridTextColumn Header="Trạng thái" Width="100" Binding="{Binding Status, Converter={StaticResource StatusDisplayConverter}}" />
                                        <DataGridTextColumn Header="Bút toán" Width="150" Binding="{Binding JournalHeaderId}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                                    <Button Style="{StaticResource EnterpriseModuleCmdInfo}" Tag="&#xE70F;" Content="Sửa" Command="{Binding EditBankTransactionCommand}" IsEnabled="{Binding CanEditBankTransaction}" ToolTip="Chỉ sửa giao dịch Draft" ToolTipService.ShowOnDisabled="True" />
                                    <Button Style="{StaticResource EnterpriseModuleCmdDanger}" Tag="&#xE74D;" Content="Xóa" Command="{Binding DeleteBankTransactionCommand}" IsEnabled="{Binding CanDeleteBankTransaction}" ToolTip="Chỉ xóa giao dịch Draft" ToolTipService.ShowOnDisabled="True" />
                                    <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Tag="&#xE73E;" Content="Duyệt" Command="{Binding ApproveBankCommand}" />
                                    <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Tag="&#xE711;" Content="Hủy duyệt" Command="{Binding CancelBankApprovalCommand}" IsEnabled="{Binding CanCancelBankApproval}" ToolTip="Chỉ hủy duyệt giao dịch ở trạng thái Approved" ToolTipService.ShowOnDisabled="True" />
                                    <Button Style="{StaticResource EnterpriseModuleCmdSuccess}" Tag="&#xE8FB;" Content="Ghi sổ" Command="{Binding PostBankCommand}" />
                                    <Button Style="{StaticResource EnterpriseModuleCmdWarning}" Tag="&#xE7A7;" Content="Đảo bút toán" Command="{Binding ReverseBankCommand}" />
                                    <Button Style="{StaticResource EnterpriseModuleCmdInfo}" Tag="&#xE8FD;" Content="Ghi sổ hàng loạt" Command="{Binding BatchPostBankCommand}" />
                                    <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Tag="&#xE8A5;" Content="Xem chi tiết" Command="{Binding OpenSelectedDrilldownCommand}" />
                                </WrapPanel>
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CashBankPagerCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Foreground="#475569" Text="{Binding BankTransactionsPager.PageText}" />
                                        <controls:TablePagerControl Grid.Column="1" DataContext="{Binding BankTransactionsPager}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Nhập sao kê">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource EnterpriseModulePanelCard}">
                                    <DockPanel LastChildFill="True">
                                        <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource EnterpriseModuleCmdInfo}" Tag="&#xE8B5;" Content="Chọn CSV/XLSX" Command="{Binding ImportStatementCommand}" />
                                            <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Tag="&#xE73E;" Content="Kiểm tra" Command="{Binding ValidateImportCommand}" />
                                            <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Tag="&#xE896;" Content="Xuất file lỗi" Command="{Binding DownloadImportErrorsCommand}" />
                                            <Button Style="{StaticResource EnterpriseModuleCmdSuccess}" Tag="&#xE74E;" Content="Ghi nhận" Command="{Binding CommitImportCommand}" />
                                        </WrapPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding ImportTemplateText}" />
                                            <TextBlock Foreground="#64748B" TextWrapping="Wrap" Text="{Binding ImportStatusText}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataGrid Grid.Row="1" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding ImportPreviewPager.Items}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Width="55" Binding="{Binding RowNumber}" />
                                        <DataGridTextColumn Header="Trạng thái" Width="95" Binding="{Binding Status, Converter={StaticResource StatusDisplayConverter}}" />
                                        <DataGridTextColumn Header="Cảnh báo" Width="85" Binding="{Binding WarningCount}" />
                                        <DataGridTextColumn Header="Lỗi" Width="70" Binding="{Binding ErrorCount}" />
                                        <DataGridTextColumn Header="Ngày" Width="150" Binding="{Binding Values[TransactionDate]}" />
                                        <DataGridTextColumn Header="Tham chiếu" Width="130" Binding="{Binding Values[ReferenceNo]}" />
                                        <DataGridTextColumn Header="Diễn giải" Width="2*" Binding="{Binding Values[Description]}" />
                                        <DataGridTextColumn Header="Thu" Width="110" Binding="{Binding Values[DebitAmount]}" />
                                        <DataGridTextColumn Header="Chi" Width="110" Binding="{Binding Values[CreditAmount]}" />
                                        <DataGridTextColumn Header="Số dư" Width="120" Binding="{Binding Values[Balance]}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="2" Style="{StaticResource CashBankPagerCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Foreground="#475569" Text="{Binding ImportPreviewPager.PageText}" />
                                        <controls:TablePagerControl Grid.Column="1" DataContext="{Binding ImportPreviewPager}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Đối chiếu">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="180" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource EnterpriseModulePanelCard}">
                                    <DockPanel LastChildFill="True">
                                        <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource EnterpriseModuleCmdInfo}" Tag="&#xE9F5;" Content="Gợi ý khớp" Command="{Binding RunReconciliationCommand}" />
                                            <Button Style="{StaticResource EnterpriseModuleCmdSuccess}" Tag="&#xE73E;" Content="Xác nhận" Command="{Binding ConfirmReconciliationCommand}" />
                                        </WrapPanel>
                                        <WrapPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Đã khớp " Foreground="#64748B" />
                                            <TextBlock FontWeight="SemiBold" Margin="0,0,18,0" Text="{Binding MatchedAmount, StringFormat=N0}" />
                                            <TextBlock Text="Chưa khớp " Foreground="#64748B" />
                                            <TextBlock FontWeight="SemiBold" Margin="0,0,18,0" Text="{Binding UnmatchedAmount, StringFormat=N0}" />
                                            <TextBlock Text="Chênh lệch " Foreground="#64748B" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding ReconciliationDifference, StringFormat=N0}" />
                                        </WrapPanel>
                                    </DockPanel>
                                </Border>
                                <DataGrid Grid.Row="1" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding ReconciliationsPager.Items}" SelectedItem="{Binding SelectedReconciliation}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ngày" Width="95" Binding="{Binding ReconciliationDate, StringFormat=dd/MM/yyyy}" />
                                        <DataGridTextColumn Header="Số đối chiếu" Width="160" Binding="{Binding ReconciliationNo}" />
                                        <DataGridTextColumn Header="Sổ kế toán" Width="120" Binding="{Binding BookBalance, StringFormat=N0}" />
                                        <DataGridTextColumn Header="Sao kê" Width="120" Binding="{Binding StatementBalance, StringFormat=N0}" />
                                        <DataGridTextColumn Header="Chênh lệch" Width="120" Binding="{Binding Difference, StringFormat=N0}" />
                                        <DataGridTextColumn Header="Trạng thái" Width="105" Binding="{Binding Status, Converter={StaticResource StatusDisplayConverter}}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="2" Style="{StaticResource CashBankPagerCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Foreground="#475569" Text="{Binding ReconciliationsPager.PageText}" />
                                        <controls:TablePagerControl Grid.Column="1" DataContext="{Binding ReconciliationsPager}" />
                                    </Grid>
                                </Border>
                                <DataGrid Grid.Row="3" Style="{StaticResource EnterpriseModuleDataGrid}" Margin="0,10,0,0" ItemsSource="{Binding ReconciliationLinesPager.Items}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Khớp" Width="95" Binding="{Binding MatchStatus, Converter={StaticResource StatusDisplayConverter}}" />
                                        <DataGridTextColumn Header="GD ngân hàng" Width="130" Binding="{Binding BankTransactionNo}" />
                                        <DataGridTextColumn Header="Ngày sao kê" Width="115" Binding="{Binding StatementDate, StringFormat=dd/MM/yyyy}" />
                                        <DataGridTextColumn Header="Tham chiếu" Width="130" Binding="{Binding ReferenceNo}" />
                                        <DataGridTextColumn Header="Diễn giải" Width="2*" Binding="{Binding Description}" />
                                        <DataGridTextColumn Header="Thu" Width="110" Binding="{Binding DebitAmount, StringFormat=N0}" />
                                        <DataGridTextColumn Header="Chi" Width="110" Binding="{Binding CreditAmount, StringFormat=N0}" />
                                        <DataGridTextColumn Header="Lệch" Width="110" Binding="{Binding DifferenceAmount, StringFormat=N0}" />
