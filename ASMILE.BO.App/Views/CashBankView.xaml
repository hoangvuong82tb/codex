<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ASMILE.BO.App.Views.CashBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASMILE.BO.App.Controls"
             xmlns:conv="clr-namespace:ASMILE.BO.App.Converters"
             FontFamily="Segoe UI, Segoe UI Variable Text"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <conv:StatusDisplayConverter x:Key="StatusDisplayConverter" />
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource EnterpriseModuleTextBox}">
            <Setter Property="Height" Value="36" />
        </Style>
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource EnterpriseModuleComboBox}">
            <Setter Property="Height" Value="36" />
        </Style>
        <Style TargetType="{x:Type DatePicker}" BasedOn="{StaticResource EnterpriseModuleDatePicker}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Height" Value="36" />
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource AccountingTabButton}">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="CashBankSideIconButton" TargetType="Button" BasedOn="{StaticResource AccountingSideIconButton}" />
        <Style x:Key="CashBankFloatingCard" TargetType="Border" BasedOn="{StaticResource AccountingPanelCard}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="#FBFDFF" />
        </Style>
        <Style x:Key="CashBankKpiCard" TargetType="Border" BasedOn="{StaticResource AccountingKpiCard}">
            <Setter Property="MinHeight" Value="92" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="CashBankPagerCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FBFF" />
            <Setter Property="BorderBrush" Value="#D7E3F2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="CashBankField" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style x:Key="CashBankLabel" TargetType="TextBlock" BasedOn="{StaticResource AccountingFilterLabel}" />
        <Style x:Key="CashBankCompactSearchBox" TargetType="TextBox" BasedOn="{StaticResource EnterpriseModuleTextBox}">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Width" Value="360" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="32,8,12,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F6F8FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="18,16,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" MinWidth="220">
                <TextBlock Text="Quỹ &amp; Ngân hàng" Style="{StaticResource AppTitleTextStyle}" />
                <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" Text="{Binding StatusText}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Grid Width="360" Height="44" Margin="0,0,10,0">
                    <TextBox Style="{StaticResource CashBankCompactSearchBox}"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Tìm giao dịch quỹ, ngân hàng hoặc diễn giải" />
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#64748B"
                               FontSize="13"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               IsHitTestVisible="False" />
                </Grid>
                <Button Style="{StaticResource EnterpriseModuleCmdInfo}"
                        Tag="&#xE9D2;"
                        Content="Chạy báo cáo"
                        Command="{Binding RunReportCommand}" />
                <Button Style="{StaticResource EnterpriseModuleCmdSecondary}"
                        Tag="&#xE72C;"
                        Content="Làm mới"
                        Margin="0"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <controls:EnterpriseCommandToolbar Grid.Row="1"
                                           Margin="18,14,18,0"
                                           SearchPlaceholder="Tìm giao dịch quỹ, ngân hàng hoặc diễn giải..."
                                           RefreshText="Làm mới"
                                           ShowExportImport="False"
                                           Visibility="Collapsed"
                                           SearchText="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           RefreshCommand="{Binding RefreshCommand}">
            <controls:EnterpriseCommandToolbar.ActionsContent>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource EnterpriseModuleCmdInfo}"
                            Tag="&#xE9D2;"
                            Content="Chạy báo cáo"
                            Command="{Binding RunReportCommand}" />
                </StackPanel>
            </controls:EnterpriseCommandToolbar.ActionsContent>
        </controls:EnterpriseCommandToolbar>

        <Grid Grid.Row="1" Margin="18,14,18,12" Visibility="Collapsed">
            <StackPanel MinWidth="220">
                <TextBlock Text="Quỹ &amp; Ngân hàng" Style="{StaticResource AppTitleTextStyle}" />
                <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" Text="{Binding StatusText}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <controls:EnterpriseStatePresenter Grid.Row="2" Margin="0,8,0,0" EmptyText="Chưa có dữ liệu quỹ/ngân hàng." IsLoading="{Binding IsBusy}">
            <controls:EnterpriseStatePresenter.StateContent>
                <Grid Margin="18,0,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="30" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top">
                            <Button Style="{StaticResource CashBankSideIconButton}" Command="{Binding ToggleSummaryCommand}" ToolTip="Mở / thu gọn KPI">
                                <Viewbox Width="19" Height="19">
                                    <Grid Width="20" Height="20">
                                        <Path Fill="#0F2A55" Data="M3,17 L3,10 L6,10 L6,17 Z M8.5,17 L8.5,5 L11.5,5 L11.5,17 Z M14,17 L14,8 L17,8 L17,17 Z" />
                                        <Path Stroke="#0F2A55" StrokeThickness="1.5" Data="M2.5,17.5 L18,17.5" />
                                    </Grid>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource CashBankSideIconButton}" Command="{Binding ToggleFilterCommand}" ToolTip="Mở / thu gọn bộ lọc">
                                <Viewbox Width="19" Height="19">
                                    <Path Fill="#0F2A55" Data="M2,4 C2,3.45 2.45,3 3,3 L17,3 C17.55,3 18,3.45 18,4 C18,4.25 17.9,4.48 17.73,4.66 L12,10.55 L12,16.2 C12,16.55 11.82,16.87 11.52,17.05 L8.52,18.8 C7.86,19.18 7,18.71 7,17.95 L7,10.55 L2.27,4.66 C2.1,4.48 2,4.25 2,4 Z" />
                                </Viewbox>
                            </Button>
                        </StackPanel>

                        <Border Grid.Column="1" Width="420" Margin="6,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CashBankFloatingCard}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSummaryExpanded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Border Style="{StaticResource CashBankKpiCard}">
                                    <DockPanel VerticalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#E9F1FF" DockPanel.Dock="Left" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Số dư quỹ" FontSize="12" Foreground="#64748B" FontWeight="Bold" />
                                            <TextBlock Text="{Binding CashBalanceText}" FontSize="24" FontWeight="SemiBold" />
                                            <TextBlock Text="Tiền mặt hiện có" FontSize="12" Foreground="#64748B" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource CashBankKpiCard}">
                                    <DockPanel VerticalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#E8FAEF" DockPanel.Dock="Left" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Thu hôm nay" FontSize="12" Foreground="#64748B" FontWeight="Bold" />
                                            <TextBlock Text="{Binding DailyInflow, StringFormat=N0}" FontSize="24" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DailyOutflow, StringFormat=Chi {0:N0}}" FontSize="12" Foreground="#64748B" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource CashBankKpiCard}">
                                    <DockPanel VerticalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#FFF5DE" DockPanel.Dock="Left" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Quỹ chờ xử lý" FontSize="12" Foreground="#64748B" FontWeight="Bold" />
                                            <TextBlock Text="{Binding PendingText}" FontSize="24" FontWeight="SemiBold" />
                                            <TextBlock Text="Chưa ghi sổ" FontSize="12" Foreground="#64748B" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource CashBankKpiCard}">
                                    <DockPanel VerticalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#F1EAFF" DockPanel.Dock="Left" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Số dư ngân hàng" FontSize="12" Foreground="#64748B" FontWeight="Bold" />
                                            <TextBlock Text="{Binding BankBalanceText}" FontSize="24" FontWeight="SemiBold" />
                                            <TextBlock Text="Theo tài khoản chọn" FontSize="12" Foreground="#64748B" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource CashBankKpiCard}">
                                    <DockPanel VerticalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#EAF3FF" DockPanel.Dock="Left" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Khả dụng" FontSize="12" Foreground="#64748B" FontWeight="Bold" />
                                            <TextBlock Text="{Binding BankAvailableBalance, StringFormat=N0}" FontSize="24" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding BankPendingAmount, StringFormat=Chờ xử lý {0:N0}}" FontSize="12" Foreground="#64748B" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource CashBankKpiCard}" Margin="0">
                                    <DockPanel VerticalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#FEECEC" DockPanel.Dock="Left" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Đối chiếu" FontSize="12" Foreground="#64748B" FontWeight="Bold" />
                                            <TextBlock Text="{Binding LastReconciliationText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="Lần gần nhất" FontSize="12" Foreground="#64748B" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Width="420" Margin="6,58,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CashBankFloatingCard}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterExpanded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Bộ lọc" FontSize="18" FontWeight="SemiBold" Foreground="#0F2A55" Margin="0,0,0,10" />
                                <TextBlock Text="Luồng quỹ/ngân hàng đã lưu" Foreground="#64748B" Margin="0,2,0,12" TextWrapping="Wrap" />
                                <TextBlock Text="Quỹ" Style="{StaticResource CashBankLabel}" />
                                <ComboBox DisplayMemberPath="FundName" Margin="0,0,0,10" ItemsSource="{Binding CashFunds}" SelectedItem="{Binding SelectedCashFund}" />
                                <TextBlock Text="Ngân hàng" Style="{StaticResource CashBankLabel}" />
                                <ComboBox DisplayMemberPath="AccountNumber" Margin="0,0,0,10" ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding SelectedBankAccount}" />
                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Từ ngày" Style="{StaticResource CashBankLabel}" />
                                        <DatePicker Margin="0" SelectedDate="{Binding FromDate}" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Đến ngày" Style="{StaticResource CashBankLabel}" />
                                        <DatePicker Margin="0" SelectedDate="{Binding ToDate}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="Tìm kiếm" Style="{StaticResource CashBankLabel}" />
                                <TextBox Margin="0,0,0,12" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <Button Style="{StaticResource EnterpriseModuleCmdPrimary}" Tag="&#xE71C;" Content="Áp dụng" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource EnterpriseModuleCmdSecondary}" Tag="&#xE72C;" Content="Làm mới" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                                </UniformGrid>
                                <TextBlock Text="Kiểm tra trực tiếp" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding ValidationMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Foreground="#9A3412">
                                                        <Run Text="{Binding Severity}" />
                                                        <Run Text=" - " />
                                                        <Run Text="{Binding Scope}" />
                                                    </TextBlock>
                                                    <TextBlock Foreground="#334155" TextWrapping="Wrap" Text="{Binding Message}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <controls:EnterpriseFilterPanel Grid.Column="0" Title="Bộ lọc" Margin="0,0,12,0" Visibility="Collapsed">
                        <controls:EnterpriseFilterPanel.PanelContent>
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Luồng quỹ/ngân hàng đã lưu" Foreground="#64748B" Margin="0,2,0,12" TextWrapping="Wrap" />
                                    <TextBlock Text="Quỹ" Style="{StaticResource CashBankLabel}" />
                                    <ComboBox DisplayMemberPath="FundName" Margin="0,0,0,10" ItemsSource="{Binding CashFunds}" SelectedItem="{Binding SelectedCashFund}" />
                                    <TextBlock Text="Ngân hàng" Style="{StaticResource CashBankLabel}" />
                                    <ComboBox DisplayMemberPath="AccountNumber" Margin="0,0,0,10" ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding SelectedBankAccount}" />
                                    <TextBlock Text="Từ ngày" Style="{StaticResource CashBankLabel}" />
                                    <DatePicker Margin="0,0,0,10" SelectedDate="{Binding FromDate}" />
                                    <TextBlock Text="Đến ngày" Style="{StaticResource CashBankLabel}" />
                                    <DatePicker Margin="0,0,0,10" SelectedDate="{Binding ToDate}" />
                                    <TextBlock Text="Tìm kiếm" Style="{StaticResource CashBankLabel}" />
                                    <TextBox Margin="0,0,0,12" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Style="{StaticResource EnterpriseModuleCmdPrimary}"
                                            Tag="&#xE71C;"
                                            Content="Áp dụng"
                                            HorizontalAlignment="Left"
                                            Command="{Binding RefreshCommand}" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                    <TextBlock Text="Kiểm tra trực tiếp" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding ValidationMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Foreground="#9A3412">
                                                            <Run Text="{Binding Severity}" />
                                                            <Run Text=" - " />
                                                            <Run Text="{Binding Scope}" />
                                                        </TextBlock>
                                                        <TextBlock Foreground="#334155" TextWrapping="Wrap" Text="{Binding Message}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </controls:EnterpriseFilterPanel.PanelContent>
                    </controls:EnterpriseFilterPanel>

                    <StackPanel Grid.Column="1"
                                Panel.ZIndex="20"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,4,0,0"
                                Visibility="Collapsed">
                        <Grid Width="360" Height="44" Margin="0,0,10,0">
                            <TextBox Style="{StaticResource CashBankCompactSearchBox}"
                                     Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tìm giao dịch quỹ, ngân hàng hoặc diễn giải" />
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#64748B"
                                       FontSize="13"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       IsHitTestVisible="False" />
                        </Grid>
                        <Button Style="{StaticResource EnterpriseModuleCmdInfo}"
                                Tag="&#xE9D2;"
                                Content="Chạy báo cáo"
                                Command="{Binding RunReportCommand}" />
                        <Button Style="{StaticResource EnterpriseModuleCmdSecondary}"
                                Tag="&#xE72C;"
                                Content="Làm mới"
                                Margin="0"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>

                    <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}">
                        <TabItem Header="Sổ quỹ">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="360" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Style="{StaticResource EnterpriseModulePanelCard}" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Style="{StaticResource CashBankField}">
                                            <TextBlock Text="Loại giao dịch" Style="{StaticResource CashBankLabel}" />
                                            <ComboBox ItemsSource="{Binding CashEntryTypes}" SelectedItem="{Binding SelectedCashEntryType}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Style="{StaticResource CashBankField}">
                                            <TextBlock Text="Số tiền" Style="{StaticResource CashBankLabel}" />
                                            <TextBox Text="{Binding QuickCashEntry.Amount, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <Grid Grid.Row="2" Margin="0,0,10,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="TK Nợ" Style="{StaticResource CashBankLabel}" />
                                                <TextBox Text="{Binding QuickCashDebitAccountCode, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="TK Có" Style="{StaticResource CashBankLabel}" />
                                                <TextBox Text="{Binding QuickCashCreditAccountCode, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="3" Style="{StaticResource CashBankField}">
                                            <TextBlock Text="Người nộp/nhận" Style="{StaticResource CashBankLabel}" />
                                            <TextBox Text="{Binding QuickCashEntry.CounterpartyName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="4" Style="{StaticResource CashBankField}">
                                            <TextBlock Text="Ngày giao dịch" Style="{StaticResource CashBankLabel}" />
                                            <DatePicker SelectedDate="{Binding QuickCashEntry.TransactionDate}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="5" Style="{StaticResource CashBankField}">
                                            <TextBlock Text="Diễn giải" Style="{StaticResource CashBankLabel}" />
                                            <TextBox Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding QuickCashEntry.Description, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <Button Grid.Row="6"
                                                Style="{StaticResource EnterpriseModuleCmdSuccess}"
                                                Tag="&#xE74E;"
                                                Content="{Binding QuickCashSaveText}"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding SaveQuickCashCommand}" />
                                    </Grid>
                                </Border>
                                <DataGrid Grid.Row="0" Grid.Column="1" Style="{StaticResource EnterpriseModuleDataGrid}" ItemsSource="{Binding CashTransactionsPager.Items}" SelectedItem="{Binding SelectedCashTransaction}" PreviewKeyDown="CashGrid_PreviewKeyDown">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ngày" Width="95" Binding="{Binding TransactionDate, StringFormat=dd/MM/yyyy}" />
                                        <DataGridTextColumn Header="Số GD" Width="130" Binding="{Binding TransactionNo}" />
                                        <DataGridTextColumn Header="Loại" Width="95" Binding="{Binding TransactionType, Converter={StaticResource StatusDisplayConverter}}" />
                                        <DataGridTextColumn Header="Quỹ" Width="110" Binding="{Binding FundCode}" />
                                        <DataGridTextColumn Header="Diễn giải" Width="2*" Binding="{Binding Description}" />
                                        <DataGridTextColumn Header="Thu" Width="110" Binding="{Binding DebitAmount, StringFormat=N0}" />
                                        <DataGridTextColumn Header="Chi" Width="110" Binding="{Binding CreditAmount, StringFormat=N0}" />
                                        <DataGridTextColumn Header="Số dư" Width="120" Binding="{Binding BalanceAfter, StringFormat=N0}" />
