<UserControl x:Class="ASMILE.BO.App.Views.DepartmentPeoplePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASMILE.BO.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1520"
             FocusVisualStyle="{x:Null}"
             Focusable="False"
             IsTabStop="False"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <Grid FocusVisualStyle="{x:Null}" Focusable="False" KeyboardNavigation.IsTabStop="False">
        <Border x:Name="MainContentSurface" Background="{StaticResource SupplierPageBackgroundBrush}" Padding="30,18,30,30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Bộ phận &amp; Nhân sự" FontSize="31" FontWeight="Bold" Foreground="#162C4E" />
                    <TextBlock Text="Quản lý cơ cấu phòng ban và danh sách nhân sự theo từng bộ phận."
                               Margin="0,4,0,0"
                               FontSize="15.5"
                               Foreground="#4C6281" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="73*" />
                    </Grid.ColumnDefinitions>

                    <controls:DepartmentPeopleToolbar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16" />
                    <controls:DepartmentTreeCard Grid.Row="1" Grid.Column="0" />
                    <Border Grid.Row="1" Grid.Column="2" BorderThickness="0" CornerRadius="24">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPeopleSectionFocused}" Value="True">
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="BorderBrush" Value="#7AA6F8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <controls:PeopleListCard />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Visibility="{Binding IsDepartmentFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#16FFFFFF"
              Panel.ZIndex="20">
            <controls:DepartmentFormView HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <Grid Visibility="{Binding IsPersonFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#16FFFFFF"
              Panel.ZIndex="21">
            <controls:PersonFormView HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
