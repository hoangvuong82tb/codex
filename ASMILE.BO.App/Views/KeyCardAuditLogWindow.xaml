<Window x:Class="ASMILE.BO.App.Views.KeyCardAuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhật ký thẻ" Width="1700" Height="940" MinWidth="1400" MinHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Height" Value="30"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="10,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Height" Value="30"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="8,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SmallButton" TargetType="Button"><Setter Property="Height" Value="26"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="10"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="8,0"/><Setter Property="Margin" Value="0,0,4,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox"><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,0"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModernComboBox" TargetType="ComboBox"><Setter Property="Height" Value="30"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center"/><Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#7B8DA6" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="8" Height="4" Stretch="Uniform"/></Grid></Border><Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="7" Margin="0,2"><ScrollViewer MaxHeight="200"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PagerButtonStyle" TargetType="Button"><Setter Property="Width" Value="26"/><Setter Property="Height" Value="24"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="1,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PanelCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Padding="14,8" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="9"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0891B2" Offset="0"/><GradientStop Color="#0E7490" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Nhật ký thẻ" FontSize="17" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Theo dõi toàn bộ lịch sử và sự kiện liên quan đến thẻ khóa." FontSize="11" Foreground="#64748B"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Làm mới" Click="OnRefresh" Style="{StaticResource SecondaryButton}"/><Button Content="Xuất" Click="OnExport" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0"/>
                    <Button Content="In" Click="OnPrint" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0"/><Button Content="Đóng" Click="OnClose" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI STRIP -->
        <Border Grid.Row="1" Padding="10,6" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel x:Name="KpiStrip" Orientation="Horizontal"/>
        </Border>

        <!-- SEARCH + QUICK FILTERS -->
        <Border Grid.Row="2" Padding="10,5" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel>
                <WrapPanel Margin="0,0,0,4">
                    <TextBox x:Name="EventSearchBox" Width="180" Style="{StaticResource ModernTextBox}" Margin="0,0,4,2"/>
                    <ComboBox x:Name="EventTypeFilter" Width="110" Style="{StaticResource ModernComboBox}" Margin="0,0,4,2"/>
                    <ComboBox x:Name="EventResultFilter" Width="90" Style="{StaticResource ModernComboBox}" Margin="0,0,4,2"/>
                    <ComboBox x:Name="EventRiskFilter" Width="90" Style="{StaticResource ModernComboBox}" Margin="0,0,4,2"/>
                    <Button Content="Tìm" Click="OnApplyFilter" Style="{StaticResource PrimaryButton}" Margin="0,0,3,2"/>
                    <Button Content="Xóa lọc" Click="OnClearFilter" Style="{StaticResource SecondaryButton}" Margin="0,0,3,2"/>
                </WrapPanel>
                <WrapPanel>
                    <Button Content="Hôm nay" Click="OnQuickToday" Style="{StaticResource SmallButton}"/><Button Content="7 ngày" Click="OnQuick7Days" Style="{StaticResource SmallButton}"/>
                    <Button Content="30 ngày" Click="OnQuick30Days" Style="{StaticResource SmallButton}"/><Button Content="Tất cả" Click="OnQuickAll" Style="{StaticResource SmallButton}"/>
                    <Button Content="⚠ Cảnh báo AN" Click="OnQuickSecurity" Style="{StaticResource SmallButton}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="3" Margin="8,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>

            <!-- LEFT: Timeline -->
            <Border Style="{StaticResource PanelCard}" Padding="10">
                <StackPanel>
                    <TextBlock Text="Timeline" FontSize="13" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,8"/>
                    <StackPanel x:Name="TimelinePanel"/>
                </StackPanel>
            </Border>

            <!-- CENTER: Audit Grid -->
            <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="EventGridPanel" Margin="8,6"/>
                    </ScrollViewer>
                    <Border Grid.Row="1" Padding="8,5" Background="#FBFCFE" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="EventPagerSummary" VerticalAlignment="Center" FontSize="10" Foreground="#64748B"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="EventPrevBtn" Content="←" Click="OnEventPrevPage" Style="{StaticResource PagerButtonStyle}"/>
                                <StackPanel x:Name="EventPageBtns" Orientation="Horizontal"/>
                                <Button x:Name="EventNextBtn" Content="→" Click="OnEventNextPage" Style="{StaticResource PagerButtonStyle}"/>
                                <ComboBox x:Name="EventPageSizeBox" Width="95" Margin="3,0,0,0" SelectionChanged="OnEventPageSizeChanged" Style="{StaticResource ModernComboBox}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: Inspector -->
            <Border Grid.Column="4" Style="{StaticResource PanelCard}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <StackPanel x:Name="InspectorTabs" Orientation="Horizontal" Margin="4,3,0,0"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,6"><StackPanel x:Name="InspectorPanel"/></ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="4" Padding="10,5" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid><TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/><Button HorizontalAlignment="Right" Content="Đóng" Click="OnClose" Style="{StaticResource SecondaryButton}"/></Grid>
        </Border>
    </Grid>
</Window>
