<UserControl x:Class="ASMILE.BO.App.Views.HotelPartnerProfileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
 <UserControl.Resources>
  <Style x:Key="B" TargetType="Button" BasedOn="{StaticResource HotelSettingsButtonBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style>
  <Style x:Key="P" TargetType="Button" BasedOn="{StaticResource B}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/></Style>
  <Style x:Key="T" TargetType="TextBox" BasedOn="{StaticResource HotelSettingsTextBoxBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style>
  <Style x:Key="C" TargetType="ComboBox" BasedOn="{StaticResource HotelSettingsComboBoxBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,0"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style>
 </UserControl.Resources>
 <Grid Background="Transparent" Margin="0,0,0,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Padding="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="{Binding PageDescription}" Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Làm mới" Command="{Binding LoadCommand}" Style="{StaticResource B}"/><Button Content="{Binding AddLabel}" Command="{Binding NewItemCommand}" Style="{StaticResource P}" Margin="0"/></StackPanel></Grid></Border>
  <Border Grid.Row="1" Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Từ khóa" Grid.Column="0" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBlock Text="Loại" Grid.Column="1" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" ToolTip="Tìm theo mã hoặc tên"/><ComboBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" Style="{StaticResource C}"/><Button Grid.Row="1" Grid.Column="3" Content="Tìm" Command="{Binding SearchCommand}" Style="{StaticResource B}" Margin="8,0,0,0"/></Grid></Border>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
   <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="False"><ListBox ItemContainerStyle="{StaticResource HotelSettingsListBoxItemStyle}" HorizontalContentAlignment="Stretch" Background="Transparent" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="#17365D"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Foreground="#17365D"/><TextBlock Text="{Binding Kind}" Foreground="#64748B" FontSize="11"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Details}" Foreground="#64748B" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="#15803D" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
   <Border Grid.Column="1" Margin="16,0,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16"><StackPanel><StackPanel><TextBlock Text="Chi tiết master" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="{Binding SelectedSummary}" Foreground="#64748B" Margin="0,4,0,14"/>
    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
     <TextBlock Text="Mã / tên"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/><TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/></Grid>
     <TextBlock Text="Loại"/><ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}" Style="{StaticResource C}" Margin="0,4,0,8"/>
     <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SubCodeLabel}"/><TextBox Text="{Binding SubCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding SubCode2Label}"/><TextBox Text="{Binding SubCode2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,4,0,0"/></StackPanel></Grid>
     <StackPanel Visibility="{Binding IsCommission, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Tỷ lệ / số tiền cố định / tiền tệ"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding RatePercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/><TextBox Grid.Column="2" Text="{Binding FixedAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/><TextBox Grid.Column="4" Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/></Grid><WrapPanel Margin="0,0,0,8"><CheckBox Content="Bao gồm thuế" IsChecked="{Binding IncludeTax}" Margin="0,0,16,4"/><CheckBox Content="Bao gồm phí dịch vụ" IsChecked="{Binding IncludeServiceCharge}" Margin="0,0,16,4"/><CheckBox Content="Cần phê duyệt" IsChecked="{Binding ApprovalRequired}"/></WrapPanel></StackPanel>
     <StackPanel Visibility="{Binding IsNotCommission, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Liên hệ"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/><TextBox Grid.Column="2" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/></Grid><TextBlock Text="Email / địa chỉ"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/><TextBox Grid.Column="2" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/></Grid></StackPanel>
     <StackPanel Visibility="{Binding IsCompany, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Tiền tệ / hạn mức / số ngày công nợ"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/><TextBox Grid.Column="2" Text="{Binding CreditLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/><TextBox Grid.Column="4" Text="{Binding CreditDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/></Grid><WrapPanel Margin="0,0,0,8"><CheckBox Content="Bắt buộc hợp đồng" IsChecked="{Binding RequireContract}" Margin="0,0,16,4"/><CheckBox Content="Bắt buộc PO" IsChecked="{Binding RequirePurchaseOrder}"/></WrapPanel></StackPanel>
     <StackPanel Visibility="{Binding IsTravelAgent, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Quy tắc hoa hồng / market mặc định / điều khoản"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding CommissionRuleCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/><TextBox Grid.Column="2" Text="{Binding DefaultMarketSegmentCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/></Grid><TextBox Text="{Binding PaymentTerms, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,0,0,8"/></StackPanel>
     <TextBlock Text="Hiệu lực từ / đến"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding EffectiveFrom, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/><TextBox Grid.Column="2" Text="{Binding EffectiveTo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/></Grid><TextBlock Text="Mô tả"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,4,0,8"/><StackPanel Orientation="Horizontal"><Button Content="Hủy" Command="{Binding CancelEditCommand}" Style="{StaticResource B}"/><Button Content="Lưu" Command="{Binding SaveCommand}" Style="{StaticResource P}" Margin="0"/></StackPanel>
    </StackPanel>
    <StackPanel Visibility="{Binding IsReadOnlyPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Trạng thái" Foreground="#64748B"/><TextBlock Text="{Binding SelectedStatus}" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock Text="{Binding InfoMessage}" Foreground="#15803D" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock Text="Workspace độc lập theo property; dữ liệu không dùng catalog chung." Foreground="#64748B" TextWrapping="Wrap" Margin="0,14,0,16"/><StackPanel Orientation="Horizontal"><Button Content="Sửa" Command="{Binding EditItemCommand}" Style="{StaticResource P}"/><Button Content="Bật / tạm ngưng" Command="{Binding ToggleActiveCommand}" Style="{StaticResource B}" Margin="0"/></StackPanel></StackPanel>
    <Border Background="#FEF2F2" Padding="10" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap"/></Border>
   </StackPanel></StackPanel></Border>
  </Grid>
 </Grid>
</UserControl>



