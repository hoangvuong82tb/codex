              <Grid>
                <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="12" />
                <primitives:DatePickerTextBox Name="PART_TextBox" Background="#00FFFFFF" BorderThickness="0" Padding="12,0,34,0" VerticalContentAlignment="Center" Foreground="#1F2937" FontSize="{TemplateBinding Control.FontSize}" />
                <Button Name="PART_Button" Width="32" HorizontalAlignment="Right" Background="#00FFFFFF" BorderThickness="0" Padding="0" Cursor="Hand" Style="{x:Null}">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#64748B" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <primitives:Popup Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False">
                  <Border Background="#FFFFFFFF" BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="10" Padding="6" Effect="{StaticResource SoftShadow}">
                    <Calendar Name="PART_Calendar" />
                  </Border>
                </primitives:Popup>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type primitives:DatePickerTextBox}" TargetType="{x:Type primitives:DatePickerTextBox}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#1F2937" />
      </Style>
      <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
