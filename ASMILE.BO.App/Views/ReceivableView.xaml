      <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,14,0">
        <TabControl ItemContainerStyle="{StaticResource TabButton}" Background="#00FFFFFF" BorderThickness="0" Padding="12,8,12,0" SelectedIndex="{Binding SelectedTabIndex}">
          <TabItem Header="Dashboard">
            <Grid Margin="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="245" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,8,8" Padding="14">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Top 5 khách hàng nợ nhiều nhất" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Xem tất cả" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold" />
                  </Grid>
                  <ItemsControl Grid.Row="1" Margin="0,10,0,0" AlternationCount="10" ItemsSource="{Binding TopDebtors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Height="32">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="95" />
                          </Grid.ColumnDefinitions>
                          <Border Width="18" Height="18" CornerRadius="4" Background="#E8F1FF" VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Path=(ItemsControl.AlternationIndex), Converter={StaticResource OneBasedIndexConverter}, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                          </Border>
                          <TextBlock Grid.Column="1" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,10,0" Text="{Binding CustomerName}" />
                          <ProgressBar Grid.Column="2" Height="4" VerticalAlignment="Center" Minimum="0" Foreground="#3B82F6" Background="#E6EDF7" Maximum="{Binding DataContext.RemainingAmount, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{Binding ClosingBalance}" />
                          <TextBlock Grid.Column="3" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding ClosingBalance, StringFormat={}{0:N0}}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
