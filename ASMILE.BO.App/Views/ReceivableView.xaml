        <DockPanel VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="19" Background="#FFF5DE" DockPanel.Dock="Left" Margin="0,0,10,0">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel>
            <TextBlock Text="Còn phải thu" FontSize="12" Foreground="#64748B" FontWeight="Bold" />
