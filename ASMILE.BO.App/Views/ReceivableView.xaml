          <Border Width="38" Height="38" CornerRadius="19" Background="#E9F1FF" DockPanel.Dock="Left" Margin="0,0,10,0">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
