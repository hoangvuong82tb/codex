                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel>
                <TextBlock Text="Đã thu trong kỳ" FontSize="12" Foreground="#64748B" FontWeight="Bold" />
