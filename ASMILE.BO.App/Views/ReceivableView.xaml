              </Border>
              <StackPanel>
                <TextBlock Text="Giao dịch thu" FontSize="12" Foreground="#64748B" FontWeight="Bold" />
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding CollectionTransactionCount}" />
                <TextBlock Text="Giao dịch gần nhất" FontSize="12" Foreground="#64748B" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Width="452" Padding="18" Margin="6,58,0,0">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource FilterCard}" TargetType="{x:Type Border}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="RenderTransform">
              <Setter.Value>
                <TranslateTransform X="-18" />
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsFilterExpanded}">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="RenderTransform">
                  <Setter.Value>
                    <TranslateTransform X="0" />
                  </Setter.Value>
                </Setter>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <StackPanel>
          <TextBlock Text="Bộ lọc" FontSize="18" FontWeight="SemiBold" Foreground="#0F2A55" Margin="-18,0,0,10" />
          <TextBlock Text="Tìm kiếm" FontSize="12" Foreground="#51647F" FontWeight="SemiBold" />
          <TextBox Margin="0,6,0,12" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
