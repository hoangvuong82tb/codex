              </Border>
              <StackPanel>
                <TextBlock Text="Còn phải thu" FontSize="12" Foreground="#64748B" FontWeight="Bold" />
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding RemainingAmount, StringFormat={}{0:N0}}" />
