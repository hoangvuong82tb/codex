          </Border>
          <StackPanel>
            <TextBlock Text="Quá hạn" FontSize="12" Foreground="#64748B" FontWeight="Bold" />
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding OverdueAmount, StringFormat={}{0:N0}}" />
            <TextBlock Text="↑ +12.5%" FontSize="12" Foreground="#16A34A" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
        <DockPanel VerticalAlignment="Center">
