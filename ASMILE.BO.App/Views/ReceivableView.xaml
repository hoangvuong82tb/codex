            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel>
            <TextBlock Text="Tổng phải thu" FontSize="12" Foreground="#64748B" FontWeight="Bold" />
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding TotalReceivable, StringFormat={}{0:N0}}" />
            <TextBlock Text="↑ +320,000,000" FontSize="12" Foreground="#16A34A" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
        <DockPanel VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="19" Background="#E8FAEF" DockPanel.Dock="Left" Margin="0,0,10,0">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel>
            <TextBlock Text="Đã thu trong kỳ" FontSize="12" Foreground="#64748B" FontWeight="Bold" />
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding CollectedAmount, StringFormat={}{0:N0}}" />
            <TextBlock Text="↑ +15.2%" FontSize="12" Foreground="#16A34A" />
          </StackPanel>
