<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ASMILE.BO.App.Views.ReceivableView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" xmlns:controls="clr-namespace:ASMILE.BO.App.Controls" xmlns:converters="clr-namespace:ASMILE.BO.App.Converters" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" xmlns:views="clr-namespace:ASMILE.BO.App.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:ReceivableDocumentTypeDisplayConverter x:Key="DocTypeConverter" />
      <converters:DebtStatusDisplayConverter x:Key="DebtStatusConverter" />
      <converters:DebtStatusBrushConverter x:Key="DebtStatusBrushConverter" />
      <converters:OneBasedIndexConverter x:Key="OneBasedIndexConverter" />
