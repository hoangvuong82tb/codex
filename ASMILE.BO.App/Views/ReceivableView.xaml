      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}" BasedOn="{StaticResource AccountingFilterTextBox}" />
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource AccountingFilterComboBox}" />
      <Style x:Key="{x:Type DatePicker}" TargetType="{x:Type DatePicker}">
        <Setter Property="Height" Value="38" />
        <Setter Property="Width" Value="180" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderBrush" Value="#D5E1EF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#FFFFFFFF" />
