        <ColumnDefinition Width="54" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="46" Height="46" CornerRadius="11" Background="#E8FAEF" HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#16A34A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
