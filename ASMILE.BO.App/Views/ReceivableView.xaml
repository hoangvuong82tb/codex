            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Từ ngày" FontSize="12" Foreground="#51647F" FontWeight="SemiBold" />
              <DatePicker Language="vi-VN" Margin="0,6,0,0" SelectedDate="{Binding FromDate}" />
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="Đến ngày" FontSize="12" Foreground="#51647F" FontWeight="SemiBold" />
              <DatePicker Language="vi-VN" Margin="0,6,0,0" SelectedDate="{Binding ToDate}" />
            </StackPanel>
          </primitives:UniformGrid>
          <TextBlock Text="Trạng thái" FontSize="12" Foreground="#51647F" FontWeight="SemiBold" />
          <ComboBox Margin="0,6,0,12" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" />
          <CheckBox Content="Chỉ quá hạn" Margin="0,0,0,14" IsChecked="{Binding OverdueOnly}" />
          <primitives:UniformGrid Columns="2">
            <Button Style="{StaticResource CmdPrimary}" Content="Lọc" Margin="0,0,8,0" Command="{Binding SearchCommand}" />
