                          <TextBlock Text="Nhóm khách hàng" Foreground="#64748B" FontSize="12" />
                          <TextBlock Text="Nhân viên phụ trách" Foreground="#64748B" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text=" " FontSize="12" />
                          <TextBlock FontSize="12" HorizontalAlignment="Right" Text="{Binding FromDate, StringFormat=dd/MM/yyyy}" />
                          <TextBlock FontSize="12" HorizontalAlignment="Right" Text="{Binding ToDate, StringFormat=dd/MM/yyyy}" />
                          <TextBlock FontSize="12" HorizontalAlignment="Right" Text="{Binding SelectedGroup}" />
                          <TextBlock FontSize="12" HorizontalAlignment="Right" Text="{Binding SelectedOwner}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <primitives:UniformGrid Columns="3">
                      <Button Style="{StaticResource CmdSecondary}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" />
                          <TextBlock Text="Xem trước" />
                        </StackPanel>
                      </Button>
                      <Button Style="{StaticResource CmdSecondary}" Margin="0,0,8,0" Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" />
                          <TextBlock Text="Xuất Excel" />
                        </StackPanel>
                      </Button>
                      <Button Style="{StaticResource CmdSecondary}" Command="{Binding PrintStatementCommand}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" />
                          <TextBlock Text="In" />
                        </StackPanel>
                      </Button>
                    </primitives:UniformGrid>
                  </StackPanel>
                </Border>
              </primitives:UniformGrid>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource PanelCard}" Padding="16">
        <StackPanel>
          <TextBlock Text="Chi tiết khách hàng" FontSize="16" FontWeight="Bold" />
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="64" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="64" Height="64" CornerRadius="12" Background="#E8F7EA">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#22A559" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding SelectedSummary.CustomerCode}" />
              <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding SelectedSummary.CustomerName}" />
              <TextBlock Text="Nhóm: Khách hàng lớn" Foreground="#64748B" FontSize="12" />
            </StackPanel>
          </Grid>
          <Border Background="#FEECEC" CornerRadius="10" Padding="10,4" Margin="0,10,0,0" HorizontalAlignment="Left">
            <TextBlock Text="Quá hạn" Foreground="#DC2626" FontWeight="SemiBold" FontSize="13" />
          </Border>
          <primitives:UniformGrid Columns="4" Margin="0,10,0,0">
            <Border Style="{StaticResource PanelCard}" Margin="0,0,6,0" Padding="8">
              <StackPanel>
                <TextBlock Text="Tổng phải thu" FontSize="11" Foreground="#64748B" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding SelectedSummary.TotalDebit, StringFormat={}{0:N0}}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelCard}" Margin="0,0,6,0" Padding="8">
              <StackPanel>
                <TextBlock Text="Đã thu" FontSize="11" Foreground="#64748B" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding SelectedSummary.TotalCredit, StringFormat={}{0:N0}}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelCard}" Margin="0,0,6,0" Padding="8">
              <StackPanel>
                <TextBlock Text="Còn nợ" FontSize="11" Foreground="#64748B" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" />
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding SelectedSummary.ClosingBalance, StringFormat={}{0:N0}}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelCard}" Padding="8">
              <StackPanel>
                <TextBlock Text="Quá hạn" FontSize="11" Foreground="#64748B" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" />
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding SelectedSummary.OverdueAmount, StringFormat={}{0:N0}}" />
              </StackPanel>
            </Border>
          </primitives:UniformGrid>
          <TextBlock Text="Tuổi nợ" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="● 0 - 30 ngày" Foreground="#4CC476" FontSize="13" />
              <TextBlock Text="● 31 - 60 ngày" Foreground="#4D96F3" FontSize="13" />
              <TextBlock Text="● 61 - 90 ngày" Foreground="#F3B43F" FontSize="13" />
              <TextBlock Text="● &gt; 90 ngày" Foreground="#F56C6C" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock HorizontalAlignment="Right" FontSize="13" Text="{Binding Bucket0To30, StringFormat={}{0:N0}}" />
              <TextBlock HorizontalAlignment="Right" FontSize="13" Text="{Binding Bucket31To60, StringFormat={}{0:N0}}" />
              <TextBlock HorizontalAlignment="Right" FontSize="13" Text="{Binding Bucket61To90, StringFormat={}{0:N0}}" />
              <TextBlock HorizontalAlignment="Right" FontSize="13" Text="{Binding Bucket90Plus, StringFormat={}{0:N0}}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="Giao dịch gần nhất" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="95" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="13" Text="{Binding SelectedTransaction.TransactionDate, StringFormat=dd/MM/yyyy}" />
            <TextBlock Grid.Column="1" FontSize="13" Text="{Binding SelectedTransaction.DocumentNo}" />
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontSize="13" Foreground="#16A34A" FontWeight="SemiBold" Text="{Binding SelectedTransaction.CreditAmount, StringFormat=+{0:N0}}" />
          </Grid>
          <TextBlock Text="Thao tác nhanh" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" />
          <primitives:UniformGrid Columns="4" Margin="0,0,0,2">
            <Button Style="{StaticResource CmdSecondary}" Height="58" MinWidth="72" Margin="0,0,6,0" Command="{Binding ReceivePaymentCommand}">
              <StackPanel>
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" />
                <TextBlock Text="Thu tiền" FontSize="12" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource CmdSecondary}" Height="58" MinWidth="72" Margin="0,0,6,0" Command="{Binding OpenTransactionTabCommand}">
              <StackPanel>
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" />
                <TextBlock Text="Xem phát sinh" FontSize="12" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource CmdSecondary}" Height="58" MinWidth="72" Margin="0,0,6,0" Command="{Binding PrintStatementCommand}">
              <StackPanel>
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" />
                <TextBlock Text="In đối chiếu" FontSize="12" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource CmdSecondary}" Height="58" MinWidth="72" Command="{Binding MoreCommand}">
              <StackPanel>
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" />
                <TextBlock Text="Mở hồ sơ VFC" FontSize="12" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </primitives:UniformGrid>
          <primitives:UniformGrid Columns="2" Margin="0,8,0,2">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type primitives:UniformGrid}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsReconciliationTabActive}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <Button Style="{StaticResource CmdSecondary}" Height="52" Margin="0,0,6,0" Command="{Binding OpenReconciliationSendModalCommand}">
              <StackPanel>
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" />
                <TextBlock FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Danh sách đối chiếu" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource CmdSecondary}" Height="52" Command="{Binding OpenReconciliationDetailModalCommand}">
              <StackPanel>
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" />
                <TextBlock Text="Chi tiết đối chiếu" FontSize="12" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </primitives:UniformGrid>
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PanelCard}" Margin="0,14,0,0" Padding="12,7">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding StatusBarText}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock Text="© 2026 ASMILE ERP" FontSize="12" Foreground="#64748B" Margin="0,0,8,0" />
          <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,4,6,0" />
          <TextBlock Text="Online" FontSize="12" Foreground="#64748B" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>