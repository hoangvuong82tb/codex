      <Style x:Key="TabButton" TargetType="{x:Type TabItem}" BasedOn="{StaticResource AccountingTabButton}" />
      <Style x:Key="{x:Type DataGrid}" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource AccountingDataGrid}" />
