<UserControl x:Class="ASMILE.BO.App.Views.HotelMessagingIntegrationProfileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
  <UserControl.Resources>
    <Style x:Key="B" TargetType="Button" BasedOn="{StaticResource HotelSettingsButtonBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="P" TargetType="Button" BasedOn="{StaticResource B}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/></Style>
    <Style x:Key="I" TargetType="TextBox" BasedOn="{StaticResource HotelSettingsTextBoxBase}"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,0"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style>
  </UserControl.Resources>
  <Grid Background="Transparent" Margin="0,0,0,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Padding="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Email / SMS / API" FontSize="22" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Cấu hình kênh gửi, endpoint, template, retry và thời gian chờ theo cơ sở." Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Làm mới" Command="{Binding LoadCommand}" Style="{StaticResource B}"/><Button Content="+ Thêm profile" Command="{Binding NewItemCommand}" Style="{StaticResource P}" Margin="0"/></StackPanel></Grid></Border>
    <Border Grid.Row="1" Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Từ khóa" Grid.Column="0" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource I}" ToolTip="Tìm mã, kênh, nhà cung cấp hoặc endpoint"/><Button Grid.Row="1" Grid.Column="1" Content="Tìm" Command="{Binding SearchCommand}" Style="{StaticResource B}" Margin="8,0,0,0"/></Grid></Border>
    <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
      <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="False"><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#F8FAFC" CornerRadius="10" ClipToBounds="True" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="Mã" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Profile" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Kênh" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Provider / Endpoint" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></Border><ListBox ItemContainerStyle="{StaticResource HotelSettingsListBoxItemStyle}" HorizontalContentAlignment="Stretch" Background="Transparent" Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="#17365D"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Foreground="#17365D"/><TextBlock Text="{Binding IsActive, StringFormat=Active: {0}}" Foreground="#64748B" FontSize="11"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Channel}" Foreground="#17365D"/><StackPanel Grid.Column="3"><TextBlock Text="{Binding Provider}" Foreground="#17365D"/><TextBlock Text="{Binding Endpoint}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
      <Border Grid.Column="1" Margin="16,0,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16"><StackPanel><StackPanel><TextBlock Text="Chi tiết profile tích hợp" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="{Binding SelectedSummary}" Foreground="#64748B" Margin="0,4,0,8"/><TextBlock Text="Secret chỉ lưu dạng tham chiếu an toàn, không lưu mật khẩu/token thô." Foreground="#0369A1" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Mã / tên"/><Grid Margin="0,3,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource I}" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource I}" Grid.Column="2" HorizontalAlignment="Stretch" Margin="0"/></Grid><TextBlock Text="Kênh / nhà cung cấp"/><Grid Margin="0,3,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Channel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource I}" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0"/><TextBox Text="{Binding Provider, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource I}" Grid.Column="2" HorizontalAlignment="Stretch" Margin="0"/></Grid><TextBlock Text="Endpoint"/><TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource I}" Margin="0,3,0,7"/><TextBlock Text="Secret reference / template reference"/><Grid Margin="0,3,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding SecretReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource I}" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0"/><TextBox Text="{Binding TemplateReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource I}" Grid.Column="2" HorizontalAlignment="Stretch" Margin="0"/></Grid><TextBlock Text="Retry / timeout (giây) / hiệu lực"/><Grid Margin="0,3,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding MaxRetries}" Style="{StaticResource I}" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0"/><TextBox Text="{Binding TimeoutSeconds}" Style="{StaticResource I}" Grid.Column="2" HorizontalAlignment="Stretch" Margin="0"/><TextBox Text="{Binding EffectiveFrom}" Style="{StaticResource I}" Grid.Column="4" HorizontalAlignment="Stretch" Margin="0"/><TextBox Text="{Binding EffectiveTo}" Style="{StaticResource I}" Grid.Column="6" HorizontalAlignment="Stretch" Margin="0"/></Grid><TextBlock Text="Mô tả"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource I}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,3,0,10"/><StackPanel Orientation="Horizontal"><Button Content="Lưu" Command="{Binding SaveCommand}" Style="{StaticResource P}"/><Button Content="Hủy" Command="{Binding CancelEditCommand}" Style="{StaticResource B}" Margin="0"/></StackPanel></StackPanel>
        <StackPanel Visibility="{Binding IsReadOnlyPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Trạng thái" Foreground="#64748B"/><TextBlock Text="{Binding SelectedStatus}" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,2,0,14"/><Button Content="Sửa profile" Command="{Binding EditItemCommand}" Style="{StaticResource P}"/><Button Content="Bật / tạm ngưng" Command="{Binding ToggleActiveCommand}" Style="{StaticResource B}" Margin="0,8,0,0"/></StackPanel><TextBlock Text="{Binding InfoMessage}" Foreground="#15803D" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></StackPanel></Border>
    </Grid>
  </Grid>
</UserControl>



