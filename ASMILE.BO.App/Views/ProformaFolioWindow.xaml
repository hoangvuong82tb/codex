<Window x:Class="ASMILE.BO.App.Views.ProformaFolioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="In tạm tính" Width="1520" Height="920" MinWidth="1300" MinHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="ModernDataGrid" TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="#FAFBFD"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ColumnHeaderHeight" Value="36"/><Setter Property="RowHeight" Value="32"/><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2F6FC"/><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="10"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="4,0"/></Style></Setter.Value></Setter></Style>
        <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Height" Value="32"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Height" Value="32"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="10,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <ControlTemplate x:Key="RibbonBtn" TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
        <Style x:Key="PanelCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Padding="16,10" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#6366F1" Offset="0"/><GradientStop Color="#4F46E5" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="In tạm tính" FontSize="18" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Kiểm tra và xem trước hóa đơn trước khi thanh toán hoặc trả phòng." FontSize="12" Foreground="#64748B"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Làm mới" Click="OnRefresh" Style="{StaticResource SecondaryButton}"/>
                    <Button Content="Preview" Click="OnPreview" Style="{StaticResource PrimaryButton}" Margin="4,0,0,0"/>
                    <Button Content="In" Click="OnPrint" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/>
                    <Button Content="Xuất" Click="OnExport" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/>
                    <Button Content="Email" Click="OnEmail" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/>
                    <Button Content="Đóng" Click="OnClose" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SUMMARY STRIP -->
        <Border Grid.Row="1" Padding="10,5" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <WrapPanel x:Name="SummaryStrip" HorizontalAlignment="Center"/>
        </Border>

        <!-- TOOLBAR: Template + Language + Currency -->
        <Border Grid.Row="2" Padding="10,5" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal"><TextBlock Text="Template:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/><StackPanel x:Name="TemplatePanel" Orientation="Horizontal"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"><TextBlock Text="Ngôn ngữ:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/><StackPanel x:Name="LangPanel" Orientation="Horizontal"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0"><TextBlock Text="Currency:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/><StackPanel x:Name="CurrPanel" Orientation="Horizontal"/></StackPanel>
            </Grid>
        </Border>

        <!-- BODY: 3 columns -->
        <Grid Grid.Row="3" Margin="8,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>

            <!-- LEFT: Folio Browser -->
            <Border Style="{StaticResource PanelCard}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Danh sách Folio" FontSize="13" FontWeight="SemiBold" Foreground="#102E5A" Margin="10,8,10,6"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="FolioListPanel"/></ScrollViewer>
                </Grid>
            </Border>

            <!-- CENTER: Bill Preview + Side Tabs -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel x:Name="SideTabPanel" Orientation="Horizontal" Margin="0,0,0,6"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="White">
                    <StackPanel x:Name="BillPanel" Margin="16,10"/>
                </ScrollViewer>
                <!-- Side tab content areas (hidden, shown in side tabs) -->
                <StackPanel x:Name="OverviewArea" Grid.Row="1" Visibility="Collapsed" Margin="0,8,0,0"><WrapPanel x:Name="OverviewPanel"/></StackPanel>
                <StackPanel x:Name="PostingArea" Grid.Row="1" Visibility="Collapsed"><StackPanel x:Name="PostingTabPanel"/></StackPanel>
                <StackPanel x:Name="PaymentArea" Grid.Row="1" Visibility="Collapsed"><StackPanel x:Name="PaymentTabPanel"/></StackPanel>
                <StackPanel x:Name="DepositArea" Grid.Row="1" Visibility="Collapsed"><StackPanel x:Name="DepositTabPanel"/></StackPanel>
                <StackPanel x:Name="RefundArea" Grid.Row="1" Visibility="Collapsed"><StackPanel x:Name="RefundTabPanel"/></StackPanel>
                <StackPanel x:Name="RoutingArea" Grid.Row="1" Visibility="Collapsed"><StackPanel x:Name="RoutingTabPanel"/></StackPanel>
                <StackPanel x:Name="DocumentArea" Grid.Row="1" Visibility="Collapsed"><StackPanel x:Name="DocumentTabPanel"/></StackPanel>
                <StackPanel x:Name="HistoryArea" Grid.Row="1" Visibility="Collapsed"><StackPanel x:Name="HistoryTabPanel"/></StackPanel>
            </Grid>

            <!-- RIGHT: Inspector -->
            <Border Grid.Column="4" Style="{StaticResource PanelCard}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <StackPanel x:Name="InspectorTabs" Orientation="Horizontal" Margin="4,3,0,0"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,6"><StackPanel x:Name="InspectorPanel"/></ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM SUMMARY -->
        <Border Grid.Row="4" Padding="10,5" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <WrapPanel x:Name="BottomSummary" HorizontalAlignment="Center"/>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="5" Padding="10,6" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid><TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/><Button HorizontalAlignment="Right" Content="Đóng" Click="OnClose" Style="{StaticResource SecondaryButton}"/></Grid>
        </Border>
    </Grid>
</Window>
