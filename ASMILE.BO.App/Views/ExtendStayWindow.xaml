<Window x:Class="ASMILE.BO.App.Views.ExtendStayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gia hạn lưu trú" Width="1100" Height="760" MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ModTextBox" TargetType="TextBox"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModCombo" TargetType="ComboBox"><Setter Property="Height" Value="38"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/><Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#7B8DA6" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="6" Stretch="Uniform"/></Grid></Border><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="9" Margin="0,2"><ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="BlueBtn" TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="GrayBtn" TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="OutlineBtn" TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="20,16" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="11"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#31C9B8" Offset="0"/><GradientStop Color="#00A58F" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Gia hạn lưu trú" FontSize="18" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Kéo dài ngày đi của khách đang lưu trú." FontSize="12" Foreground="#64748B"/></StackPanel>
                <Button Grid.Column="2" Content="Đóng" Click="OnClose" Style="{StaticResource GrayBtn}"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,12">
            <StackPanel>
                <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,12"><StackPanel>
                    <TextBlock Text="A. Thông tin hiện tại" FontSize="14" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,10"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Khách: Nguyễn Văn An" FontSize="13" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock Text="Phòng 201 · Deluxe" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/></StackPanel>
                        <StackPanel><TextBlock Text="Ngày đến" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="24/07/2026" FontSize="13" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock Text="Ngày đi: 27/07/2026" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/></StackPanel>
                        <StackPanel><TextBlock Text="Giá phòng" FontSize="11" Foreground="#94A3B8"/><TextBlock Text="1.200.000 VND/đêm" FontSize="13" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock Text="Folio: 3.600.000 VND · Đã TT 1M" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/></StackPanel>
                    </Grid>
                </StackPanel></Border>
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16"><StackPanel>
                        <TextBlock Text="B. Gia hạn" FontSize="14" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,10"/>
                        <TextBlock Text="Ngày đi mới" FontSize="11" Foreground="#94A3B8"/><TextBox Text="29/07/2026" Style="{StaticResource ModTextBox}" Margin="0,2,0,6"/>
                        <TextBlock Text="Số đêm thêm" FontSize="11" Foreground="#94A3B8"/><TextBox Text="2" Style="{StaticResource ModTextBox}" Margin="0,2,0,6"/>
                        <TextBlock Text="Lý do" FontSize="11" Foreground="#94A3B8"/><ComboBox Style="{StaticResource ModCombo}" Margin="0,2,0,6"><ComboBoxItem Content="Khách yêu cầu" IsSelected="True"/><ComboBoxItem Content="Công tác kéo dài"/><ComboBoxItem Content="Chờ chuyến bay"/></ComboBox>
                        <TextBlock Text="Ghi chú" FontSize="11" Foreground="#94A3B8"/><TextBox Style="{StaticResource ModTextBox}" Height="50" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel></Border>
                    <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16"><StackPanel>
                        <TextBlock Text="C. Khả dụng &amp; Giá" FontSize="14" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,10"/>
                        <Border Background="#DCFCE7" CornerRadius="8" Padding="10,6" Margin="0,0,0,8"><TextBlock Text="✓ Có thể gia hạn đến 30/07" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A"/></Border>
                        <TextBlock FontSize="12" Foreground="#64748B" Margin="0,0,0,8"><Run Text="Số đêm thêm: 2"/><LineBreak/><Run Text="Giá hiện tại: 1.200.000"/><LineBreak/><Run Text="Tổng phát sinh: 2.400.000 VND"/><LineBreak/><Run Text="Đặt cọc bổ sung: 1.000.000 VND"/></TextBlock>
                        <Border Background="#FFF7ED" CornerRadius="8" Padding="10,6"><TextBlock Text="⚠ Có khách đến 30/07 — không thể gia hạn quá" FontSize="11" Foreground="#92400E"/></Border>
                    </StackPanel></Border>
                </Grid>
                <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16"><StackPanel>
                    <TextBlock Text="D. Tóm tắt" FontSize="14" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,10"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Ngày đi cũ: 27/07/2026" FontSize="12" Foreground="#64748B"/><TextBlock Text="Ngày đi mới: 29/07/2026" FontSize="13" FontWeight="SemiBold" Foreground="#17365D"/></StackPanel>
                        <StackPanel><TextBlock Text="Số đêm thêm: 2" FontSize="13" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock Text="Tổng phát sinh: 2.400.000" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626"/></StackPanel>
                        <StackPanel><TextBlock Text="Giá áp dụng: 1.200.000" FontSize="12" Foreground="#64748B"/><TextBlock Text="Trạng thái: Có thể gia hạn" FontSize="12" Foreground="#16A34A"/></StackPanel>
                    </Grid>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="14,12" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="Hủy" Click="OnClose" Style="{StaticResource GrayBtn}" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Kiểm tra khả dụng" Style="{StaticResource OutlineBtn}" Margin="0,0,8,0"/><Button Content="Xác nhận gia hạn" Click="OnConfirm" Style="{StaticResource BlueBtn}"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
