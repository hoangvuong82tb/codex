<Window x:Class="ASMILE.BO.App.Views.CreateReceiptVoucherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lập phiếu thu" Width="1400" Height="860" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PanelCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,6"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="ModernComboBox" TargetType="ComboBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,4"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="16,10" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="#6D28D9"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Lập phiếu thu" FontSize="18" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Ghi nhận khoản thanh toán thật vào Folio đã chọn." FontSize="12" Foreground="#64748B"/></StackPanel>
                <Button Grid.Column="2" Content="Đóng" Click="OnClose" Style="{StaticResource SecondaryButton}"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Padding="16,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"><StackPanel x:Name="StepBar" Orientation="Horizontal" HorizontalAlignment="Center"/></Border>
        <Grid Grid.Row="2" Margin="14,10">
            <Border x:Name="Step1" Style="{StaticResource PanelCard}" Padding="60"/>
            <Border x:Name="Step2" Visibility="Collapsed" Style="{StaticResource PanelCard}" Padding="60"/>
            <Border x:Name="Step3" Visibility="Collapsed" Style="{StaticResource PanelCard}" Padding="60"/>
            <Border x:Name="Step4" Visibility="Collapsed" Style="{StaticResource PanelCard}" Padding="60"/>
            <Border x:Name="Step5" Visibility="Collapsed" Style="{StaticResource PanelCard}" Padding="60"/>
            <Border x:Name="Step6" Visibility="Collapsed" Style="{StaticResource PanelCard}" Padding="60"/>
        </Grid>
        <Border Grid.Row="3" Padding="14,8" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterLabel" Text="Bước 1/6 · Nguồn thu" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Hủy" Click="OnClose" Style="{StaticResource SecondaryButton}"/><Button x:Name="BtnBack" Content="← Quay lại" Click="OnBack" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" IsEnabled="False"/><Button x:Name="BtnNext" Content="Tiếp tục →" Click="OnNext" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/><Button x:Name="BtnCreate" Content="Lập phiếu thu" Click="OnCreate" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Visibility="Collapsed"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
