                <Button Style="{StaticResource QuickActionButton}" Margin="0,0,8,0" Command="{Binding AdjustStockCommand}">
                  <StackPanel>
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#2563EB" HorizontalAlignment="Center" />
                    <TextBlock Text="Điều chỉnh tồn" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickActionButton}" Margin="0,0,8,0" Command="{Binding PrintStockCardCommand}">
                  <StackPanel>
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#0EA5E9" HorizontalAlignment="Center" />
                    <TextBlock Text="In thẻ kho" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickActionButton}" Margin="0" Command="{Binding CopyVirtualPathCommand}">
                  <StackPanel>
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#2563EB" HorizontalAlignment="Center" />
                    <TextBlock Text="Mở vị trí" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                  </StackPanel>
                </Button>
              </primitives:UniformGrid>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
      <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource Card}" CornerRadius="12" Margin="0,14,0,0" Padding="14,8">
        <DockPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <TextBlock Text="© 2026 ASMILE ERP" Foreground="#64748B" FontSize="12" Margin="0,0,16,0" />
            <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="Online" Foreground="#64748B" FontSize="12" />
          </StackPanel>
          <TextBlock Foreground="#64748B" FontSize="12" Text="{Binding StatusBarText, Mode=OneWay}" />
        </DockPanel>
      </Border>
    </Grid>
    <Grid ZIndex="50" Background="#660F172A" Visibility="{Binding IsRowDetailOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Border Name="RowDetailOverlayPanel" Width="1040" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F5F8FC" CornerRadius="18" Padding="18" BorderBrush="#DDE7F3" BorderThickness="1" MouseLeftButtonDown="RowDetailPanel_MouseLeftButtonDown" MouseMove="RowDetailPanel_MouseMove" MouseLeftButtonUp="RowDetailPanel_MouseLeftButtonUp">
        <UIElement.RenderTransform>
          <TranslateTransform x:Name="RowDetailOverlayTransform" />
        </UIElement.RenderTransform>
        <Grid DataContext="{Binding CurrentRowDetail}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Name="RowDetailDragHeader" Background="#FFFFFFFF" BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="16" Padding="18" Cursor="SizeAll">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="42" Height="42" CornerRadius="12" Background="#E8F1FF">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#1F2937" Text="{Binding Title}" />
                <TextBlock FontSize="13" Foreground="#64748B" Margin="0,3,0,0" Text="{Binding Subtitle}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="Kéo để di chuyển" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" />
              <Border Grid.Column="3" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Background="{Binding BadgeBackground}">
                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding BadgeText}" Foreground="{Binding BadgeForeground}" />
              </Border>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="#FFFFFFFF" BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,14,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <primitives:UniformGrid Columns="3" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#F8FBFF" BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,12,12">
                      <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,8" Text="{Binding Title}" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel MinHeight="38" Margin="0,0,0,7">
                                <TextBlock Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Text="{Binding Label}" />
                                <TextBlock Foreground="#1F2937" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,2,0,0" Text="{Binding Value}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <Grid Row="2">
            <TextBlock Text="Module chi tiết nằm trong app shell. Có thể kéo thả bằng phần header." Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
            <Button Content="Đóng" Width="110" Height="36" HorizontalAlignment="Right" Background="#FFFFFFFF" BorderBrush="#DDE7F3" BorderThickness="1" Command="{Binding DataContext.CloseRowDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
