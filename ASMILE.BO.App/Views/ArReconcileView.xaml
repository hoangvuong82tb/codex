<UserControl x:Class="ASMILE.BO.App.Views.ArReconcileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" Loaded="OnLoaded" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:StringToBrushConverter x:Key="StringToBrush"/>

        <Style x:Key="PanelCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="64"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}"><Setter Property="Background" Value="#16A34A"/></Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}"><Setter Property="Background" Value="#DC2626"/></Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="56"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="10,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ToolbarBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}"><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0,0,5,3"/><Setter Property="FontSize" Value="11"/></Style>
        <Style x:Key="FilterTextBox" TargetType="TextBox"><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="6,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource FluentComboBox}"><Setter Property="Height" Value="30"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="8,0,28,0"/><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Margin" Value="0,0,5,3"/></Style>
        <Style x:Key="FilterDatePicker" TargetType="DatePicker" BasedOn="{StaticResource EnterpriseModuleDatePicker}"><Setter Property="Height" Value="30"/><Setter Property="Width" Value="110"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,5,3"/></Style>
        <Style x:Key="ModDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="RowHeight" Value="38"/><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1E40AF"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="10"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="5,0"/></Style></Setter.Value></Setter>
        </Style>
        <Style x:Key="PagerBtn" TargetType="Button" BasedOn="{StaticResource FluentPaginationButton}"><Setter Property="Foreground" Value="#475569"/><Setter Property="Margin" Value="1,0"/></Style>
        <Style x:Key="PagerPageBtn" TargetType="Button" BasedOn="{StaticResource FluentPaginationButton}"><Setter Property="Content" Value="{Binding Label}"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="#2563EB"/><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></DataTrigger><DataTrigger Binding="{Binding IsEllipsis}" Value="True"><Setter Property="Width" Value="22"/><Setter Property="MinWidth" Value="22"/><Setter Property="MaxWidth" Value="22"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style>

        <DataTemplate x:Key="KpiCardTemplate" DataType="{x:Type vm:ArReconcileKpi}">
            <Border Background="{Binding BgColor, Converter={StaticResource StringToBrush}}" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,4" Width="100" Margin="0,0,4,3"><StackPanel><TextBlock Text="{Binding Value}" FontSize="14" FontWeight="Bold" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" FontFamily="Segoe UI"/><TextBlock Text="{Binding Label}" FontSize="9" Foreground="#64748B" Margin="0,1,0,0" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#4ED86E" Margin="0,0,12,0"><TextBlock Text="ĐC" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel><TextBlock Text="Đối chiếu — Reconciliation Center" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/><TextBlock Text="Đối chiếu Invoice, Payment, Deposit, Refund, Transfer — khách sạn ↔ khách hàng, doanh nghiệp, đại lý" FontSize="11" Foreground="#64748B" Margin="0,1,0,0" FontFamily="Segoe UI"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Export Excel" Style="{StaticResource ToolbarBtn}" Command="{Binding ExportExcelCommand}"/><Button Content="Export PDF" Style="{StaticResource ToolbarBtn}" Command="{Binding ExportPdfCommand}"/><Button Content="Làm mới" Style="{StaticResource SecondaryBtn}" Command="{Binding RefreshCommand}"/></StackPanel>
            </Grid>
        </Border>

        <!-- KPI -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="12,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding DashboardKpis}" ItemTemplate="{StaticResource KpiCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
        </Border>

        <!-- TOOLBAR + FILTER -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel Grid.Row="0">
                    <Button Content="Đối chiếu tự động" Style="{StaticResource SuccessBtn}" Margin="0,0,5,3" Command="{Binding AutoMatchCommand}"/>
                    <Button Content="Ghép thủ công" Style="{StaticResource PrimaryBtn}" Margin="0,0,5,3" Command="{Binding OpenMatchFormCommand}"/>
                    <Button Content="Hủy ghép" Style="{StaticResource ToolbarBtn}" Command="{Binding UndoMatchCommand}"/>
                    <Button Content="In biên bản" Style="{StaticResource ToolbarBtn}" Command="{Binding PrintStatementCommand}"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,0"/>
                    <ToggleButton Content="Panel Phải" IsChecked="{Binding IsRightPanelOpen}" Height="32" Width="80" Padding="8,0" Margin="0,0,5,3" FontSize="11" FontFamily="Segoe UI" Background="#F1F5F9" Foreground="#475569" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                </WrapPanel>
                <WrapPanel Grid.Row="1" Margin="0,4,0,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="140"/>
                    <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding FilterType}" Style="{StaticResource FilterCombo}" Width="90"/>
                    <ComboBox ItemsSource="{Binding MatchStatusFilters}" SelectedItem="{Binding FilterMatchStatus}" Style="{StaticResource FilterCombo}" Width="100"/>
                    <ComboBox ItemsSource="{Binding CurrencyFilters}" SelectedItem="{Binding FilterCurrency}" Style="{StaticResource FilterCombo}" Width="70"/>
                    <ComboBox ItemsSource="{Binding DepartmentFilters}" SelectedItem="{Binding FilterDepartment}" Style="{StaticResource FilterCombo}" Width="90"/>
                    <ComboBox ItemsSource="{Binding GuestFilters}" SelectedItem="{Binding FilterGuest}" Style="{StaticResource FilterCombo}" Width="100"/>
                    <DatePicker SelectedDate="{Binding FilterFromDate}" Style="{StaticResource FilterDatePicker}"/>
                    <DatePicker SelectedDate="{Binding FilterToDate}" Style="{StaticResource FilterDatePicker}"/>
                    <Button Content="Xóa lọc" Style="{StaticResource SecondaryBtn}" Command="{Binding ClearFiltersCommand}" Height="30" FontSize="10"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- MAIN 3-COLUMN -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

            <!-- LEFT: Conditions -->
            <Border Grid.Column="0" Margin="8,6,4,6" Style="{StaticResource PanelCard}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <StackPanel Margin="2,0,4,0">
                        <TextBlock Text="ĐIỀU KIỆN ĐỐI CHIẾU" FontSize="11" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="8,5" Margin="0,0,0,8" Visibility="{Binding InfoMessage, Converter={StaticResource StringToVis}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding InfoMessage}" FontSize="10" Foreground="#1E40AF" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="×" Background="Transparent" BorderThickness="0" Foreground="#1E40AF" FontSize="14" FontFamily="Segoe UI" Cursor="Hand" Width="22" Height="22" Padding="0" Click="OnDismissInfo"/></Grid></Border>
                        <Border Background="#FEF2F2" CornerRadius="6" Padding="8,5" Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"><TextBlock Text="{Binding ErrorMessage}" FontSize="10" Foreground="#DC2626" TextWrapping="Wrap"/></Border>

                        <TextBlock Text="Loại đối chiếu" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                        <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding FilterType}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,8"/>

                        <TextBlock Text="Trạng thái" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                        <ComboBox ItemsSource="{Binding MatchStatusFilters}" SelectedItem="{Binding FilterMatchStatus}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,8"/>

                        <TextBlock Text="Từ ngày" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                        <DatePicker SelectedDate="{Binding FilterFromDate}" Style="{StaticResource FilterDatePicker}" Width="Auto" Margin="0,0,0,8"/>

                        <TextBlock Text="Đến ngày" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                        <DatePicker SelectedDate="{Binding FilterToDate}" Style="{StaticResource FilterDatePicker}" Width="Auto" Margin="0,0,0,8"/>

                        <TextBlock Text="Currency" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                        <ComboBox ItemsSource="{Binding CurrencyFilters}" SelectedItem="{Binding FilterCurrency}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,8"/>

                        <TextBlock Text="Department" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" FontFamily="Segoe UI"/>
                        <ComboBox ItemsSource="{Binding DepartmentFilters}" SelectedItem="{Binding FilterDepartment}" Style="{StaticResource FilterCombo}" Width="Auto" Margin="0,0,0,8"/>

                        <Separator Margin="0,8" Background="#F1F5F9"/>
                        <TextBlock Text="KẾT QUẢ NHANH" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                        <Grid Margin="6,0,6,8">
                            <Grid.Resources><Style TargetType="TextBlock"><Setter Property="Margin" Value="10,5"/></Style></Grid.Resources>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#F8FAFC" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tổng Debit" FontSize="10" Foreground="#475569"/><TextBlock Grid.Column="1" Text="{Binding TotalDebit, StringFormat='{}{0:N0} ₫'}" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/></Grid>
                            <Grid Grid.Row="1" Background="#F8FAFC" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tổng Credit" FontSize="10" Foreground="#475569"/><TextBlock Grid.Column="1" Text="{Binding TotalCredit, StringFormat='{}{0:N0} ₫'}" FontSize="11" FontWeight="SemiBold" Foreground="#16A34A"/></Grid>
                            <Grid Grid.Row="2" Background="#F8FAFC" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tổng Payment" FontSize="10" Foreground="#475569"/><TextBlock Grid.Column="1" Text="{Binding TotalPayment, StringFormat='{}{0:N0} ₫'}" FontSize="11" FontWeight="SemiBold" Foreground="#D97706"/></Grid>
                            <Grid Grid.Row="3" Background="#F8FAFC" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Còn nợ" FontSize="10" Foreground="#475569"/><TextBlock Grid.Column="1" Text="{Binding TotalOutstanding, StringFormat='{}{0:N0} ₫'}" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626"/></Grid>
                            <Grid Grid.Row="4" Background="#FEF2F2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Chênh lệch" FontSize="10" Foreground="#DC2626"/><TextBlock Grid.Column="1" Text="{Binding TotalDifference, StringFormat='{}{0:N0} ₫'}" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626"/></Grid>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER: Transaction List -->
            <Border Grid.Column="1" Margin="4,6,4,6" Style="{StaticResource PanelCard}" Padding="0">
                <Grid>
                    <ScrollViewer Grid.Row="0" Margin="6,6" VerticalScrollBarVisibility="Auto">
                        <DataGrid ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource ModDataGrid}" MouseDoubleClick="OnDataGridDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Xem chi tiết" Command="{Binding SelectItemCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
                                    <MenuItem Header="Ghép thủ công" Command="{Binding OpenMatchFormCommand}"/>
                                    <MenuItem Header="Hủy ghép" Command="{Binding UndoMatchCommand}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã GD" Binding="{Binding TxnId}" Width="85"/>
                                <DataGridTemplateColumn Header="Loại" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="5" Padding="4,1" Background="{Binding TypeColor, Converter={StaticResource StringToBrush}}"><TextBlock Text="{Binding TypeLabel}" FontSize="9" FontWeight="SemiBold" Foreground="White"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Khách" Binding="{Binding GuestName}" Width="100"/>
                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNo}" Width="90"/>
                                <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNo}" Width="85"/>
                                <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="120"/>
                                <DataGridTemplateColumn Header="Debit" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Debit, StringFormat='{}{0:N0} ₫'}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#2563EB"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Credit" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Credit, StringFormat='{}{0:N0} ₫'}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#16A34A"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Payment" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Payment, StringFormat='{}{0:N0} ₫'}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#D97706"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Còn nợ" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Outstanding, StringFormat='{}{0:N0} ₫'}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DC2626"/><Style.Triggers><DataTrigger Binding="{Binding Outstanding}" Value="0"><Setter Property="Foreground" Value="#16A34A"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ngày" Binding="{Binding PostingDate, StringFormat='{}{0:dd/MM}'}" Width="70"/>
                                <DataGridTemplateColumn Header="Khớp" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="6" Padding="4,1" Background="{Binding MatchBg, Converter={StaticResource StringToBrush}}"><TextBlock Text="{Binding MatchLabel}" FontSize="8" FontWeight="SemiBold" Foreground="{Binding MatchColor, Converter={StaticResource StringToBrush}}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                    <Border Grid.Row="1" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="6,4">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="«" Style="{StaticResource PagerBtn}" Command="{Binding FirstPageCommand}" IsEnabled="{Binding HasPrevPage}" Width="24" Height="24" FontSize="10"/><Button Content="‹" Style="{StaticResource PagerBtn}" Command="{Binding PrevPageCommand}" IsEnabled="{Binding HasPrevPage}" Width="24" Height="24" FontSize="14"/>
                            <ItemsControl ItemsSource="{Binding PageButtons}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArReconcilePaginationButton}"><Button Style="{StaticResource PagerPageBtn}" Width="26" Height="24" FontSize="10" Command="{Binding DataContext.SetPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding PageNumber}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <Button Content="›" Style="{StaticResource PagerBtn}" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" Width="24" Height="24" FontSize="14"/><Button Content="»" Style="{StaticResource PagerBtn}" Command="{Binding LastPageCommand}" IsEnabled="{Binding HasNextPage}" Width="24" Height="24" FontSize="10"/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: Results -->
            <Border Grid.Column="2" Margin="4,6,8,6" Width="360" Style="{StaticResource PanelCard}" Padding="0" Visibility="{Binding IsRightPanelOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0"><StackPanel Margin="18,14,18,14">
                    <TextBlock Text="KẾT QUẢ ĐỐI CHIẾU" FontSize="11" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" FontFamily="Segoe UI"/>

                    <!-- SELECTED TRANSACTION INSPECTOR -->
                    <Border Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel.Resources><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,3"/></Style></StackPanel.Resources>
                            <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding SelectedItem.TxnId}" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/><TextBlock Text="{Binding SelectedItem.Description}" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
                                <Button Grid.Column="1" Content="×" Width="24" Height="24" Padding="0" Style="{StaticResource SecondaryBtn}" Command="{Binding CloseDetailCommand}"/>
                            </Grid>
                            <WrapPanel Margin="0,7,0,8">
                                <Button Content="Tổng quan" Style="{StaticResource SecondaryBtn}" Height="27" Margin="0,0,4,3" Command="{Binding SelectDetailTabCommand}" CommandParameter="0"/>
                                <Button Content="Đối chiếu" Style="{StaticResource SecondaryBtn}" Height="27" Margin="0,0,4,3" Command="{Binding SelectDetailTabCommand}" CommandParameter="1"/>
                                <Button Content="Lịch sử" Style="{StaticResource SecondaryBtn}" Height="27" Margin="0,0,4,3" Command="{Binding SelectDetailTabCommand}" CommandParameter="2"/>
                                <Button Content="Thanh toán" Style="{StaticResource SecondaryBtn}" Height="27" Margin="0,0,4,3" Command="{Binding SelectDetailTabCommand}" CommandParameter="3"/>
                                <Button Content="Hóa đơn" Style="{StaticResource SecondaryBtn}" Height="27" Margin="0,0,4,3" Command="{Binding SelectDetailTabCommand}" CommandParameter="4"/>
                                <Button Content="Sai lệch" Style="{StaticResource SecondaryBtn}" Height="27" Margin="0,0,4,3" Command="{Binding SelectDetailTabCommand}" CommandParameter="5"/>
                            </WrapPanel>
                            <StackPanel Visibility="{Binding IsMatchingTab, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="THÔNG TIN GIAO DỊCH" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="150"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Khách" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.GuestName, TargetNullValue=—, FallbackValue=—}" FontSize="10" Foreground="#0F172A" Margin="12,0,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Text="Phòng" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.RoomNo, TargetNullValue=—, FallbackValue=—}" FontSize="10" Foreground="#0F172A" Margin="12,0,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Text="Invoice" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.InvoiceNo, TargetNullValue=—, FallbackValue=—}" FontSize="10" Foreground="#0F172A" Margin="12,0,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="3" Text="Receipt" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.ReceiptNo, TargetNullValue=—, FallbackValue=—}" FontSize="10" Foreground="#0F172A" Margin="12,0,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="4" Text="Folio" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.FolioNo, TargetNullValue=—, FallbackValue=—}" FontSize="10" Foreground="#0F172A" Margin="12,0,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="5" Text="Ngày" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedItem.PostingDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue=—, FallbackValue=—}" FontSize="10" Foreground="#0F172A" Margin="12,0,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="6" Text="Trạng thái" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedItem.MatchLabel, TargetNullValue=—, FallbackValue=—}" FontSize="10" FontWeight="SemiBold" Foreground="#2563EB" Margin="12,0,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="7" Text="Loại" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedItem.Type, TargetNullValue=—, FallbackValue=—}" FontSize="10" Foreground="#0F172A" Margin="12,0,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="8" Text="Bộ phận" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedItem.Department, TargetNullValue=—, FallbackValue=—}" FontSize="10" Foreground="#0F172A" Margin="12,0,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="9" Text="Reservation" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedItem.ReservationNo, TargetNullValue=—, FallbackValue=—}" FontSize="10" Foreground="#0F172A" Margin="12,0,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="10" Text="Tiền tệ" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedItem.Currency, TargetNullValue=—, FallbackValue=—}" FontSize="10" Foreground="#0F172A" Margin="12,0,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="11" Text="Debit" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding SelectedItem.Debit, StringFormat='{}{0:N0} ₫'}" FontSize="10" Foreground="#2563EB" Margin="12,0,0,3"/>
                                    <TextBlock Grid.Row="12" Text="Credit" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding SelectedItem.Credit, StringFormat='{}{0:N0} ₫'}" FontSize="10" Foreground="#16A34A" Margin="12,0,0,3"/>
                                    <TextBlock Grid.Row="13" Text="Payment" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding SelectedItem.Payment, StringFormat='{}{0:N0} ₫'}" FontSize="10" Foreground="#D97706" Margin="12,0,0,3"/>
                                    <TextBlock Grid.Row="14" Text="Còn nợ" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding SelectedItem.Outstanding, StringFormat='{}{0:N0} ₫'}" FontSize="10" FontWeight="SemiBold" Foreground="#DC2626" Margin="12,0,0,3"/>
                                    <TextBlock Grid.Row="15" Text="Công ty" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="15" Grid.Column="1" Text="{Binding SelectedItem.CompanyName, TargetNullValue=—, FallbackValue=—}" FontSize="10" Foreground="#0F172A" Margin="12,0,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="16" Text="Tham chiếu" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/><TextBlock Grid.Row="16" Grid.Column="1" Text="{Binding SelectedItem.Reference, TargetNullValue=—, FallbackValue=—}" FontSize="10" Foreground="#0F172A" Margin="12,0,0,3" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsStatementTab, Converter={StaticResource BoolToVis}}"><TextBlock Text="STATEMENT" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/><TextBlock Text="{Binding SelectedItem.Debit, StringFormat='Debit: {0:N0} ₫'}" FontSize="11" Foreground="#2563EB" Margin="0,0,0,4"/><TextBlock Text="{Binding SelectedItem.Credit, StringFormat='Credit: {0:N0} ₫'}" FontSize="11" Foreground="#16A34A" Margin="0,0,0,4"/><TextBlock Text="{Binding SelectedItem.Payment, StringFormat='Payment: {0:N0} ₫'}" FontSize="11" Foreground="#D97706" Margin="0,0,0,4"/><TextBlock Text="{Binding SelectedItem.Outstanding, StringFormat='Còn nợ: {0:N0} ₫'}" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626"/></StackPanel>
                            <StackPanel Visibility="{Binding IsHistoryTab, Converter={StaticResource BoolToVis}}"><TextBlock Text="AUDIT LOG" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/><ItemsControl ItemsSource="{Binding SelectedItem.Audits}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="5" Padding="6,4" Margin="0,0,0,4"><StackPanel><TextBlock Text="{Binding ActionLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A"/><TextBlock Text="{Binding Detail}" FontSize="9" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="9" Foreground="#94A3B8"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                            <StackPanel Visibility="{Binding IsPaymentTab, Converter={StaticResource BoolToVis}}"><TextBlock Text="THANH TOÁN" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/><TextBlock Text="{Binding SelectedItem.Payment, StringFormat='Số tiền: {0:N0} ₫'}" FontSize="11" Foreground="#D97706" Margin="0,0,0,4"/><TextBlock Text="{Binding SelectedItem.ReceiptNo, StringFormat='Receipt: {0}'}" FontSize="10" Foreground="#0F172A" Margin="0,0,0,4"/><TextBlock Text="{Binding SelectedItem.Currency, StringFormat='Tiền tệ: {0}'}" FontSize="10" Foreground="#64748B"/></StackPanel>
                            <StackPanel Visibility="{Binding IsInvoiceTab, Converter={StaticResource BoolToVis}}"><TextBlock Text="HÓA ĐƠN" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/><TextBlock Text="{Binding SelectedItem.InvoiceNo, StringFormat='Invoice: {0}'}" FontSize="11" Foreground="#0F172A" Margin="0,0,0,4"/><TextBlock Text="{Binding SelectedItem.ReservationNo, StringFormat='Reservation: {0}'}" FontSize="10" Foreground="#64748B"/></StackPanel>
                            <StackPanel Visibility="{Binding IsDiffTab, Converter={StaticResource BoolToVis}}"><TextBlock Text="SAI LỆCH" FontSize="10" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,6"/><TextBlock Text="{Binding SelectedItem.MatchReason}" FontSize="10" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,4"/><TextBlock Text="{Binding SelectedItem.MatchedBy, StringFormat='Đối chiếu bởi: {0}'}" FontSize="10" Foreground="#64748B"/><TextBlock Text="{Binding SelectedItem.Outstanding, StringFormat='Chênh lệch: {0:N0} ₫'}" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,4,0,0"/></StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Match Summary -->
                    <Grid Margin="0,0,0,8"><Grid.Resources><Style TargetType="TextBlock"><Setter Property="Margin" Value="8,4"/></Style></Grid.Resources><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="#DCFCE7" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Đã khớp" FontSize="10" Foreground="#16A34A"/><TextBlock Grid.Column="1" Text="{Binding MatchedCount}" FontSize="12" FontWeight="Bold" Foreground="#16A34A"/></Grid>
                        <Grid Grid.Row="1" Background="#FFFBEB" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Khớp 1 phần" FontSize="10" Foreground="#D97706"/><TextBlock Grid.Column="1" Text="{Binding PartialCount}" FontSize="12" FontWeight="Bold" Foreground="#D97706"/></Grid>
                        <Grid Grid.Row="2" Background="#FEE2E2" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Chưa khớp" FontSize="10" Foreground="#DC2626"/><TextBlock Grid.Column="1" Text="{Binding UnmatchedCount}" FontSize="12" FontWeight="Bold" Foreground="#DC2626"/></Grid>
                        <Grid Grid.Row="3" Background="#F3E8FF" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Trùng" FontSize="10" Foreground="#7C3AED"/><TextBlock Grid.Column="1" Text="{Binding DuplicateCount}" FontSize="12" FontWeight="Bold" Foreground="#7C3AED"/></Grid>
                        <Grid Grid.Row="4" Background="#EFF6FF"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tỷ lệ khớp" FontSize="10" Foreground="#2563EB"/><TextBlock Grid.Column="1" Text="{Binding MatchPercent, StringFormat='{}{0:F1}%'}" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/></Grid>
                    </Grid>

                    <!-- Differences -->
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8" Visibility="{Binding ShowMatchedState, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="✓ Giao dịch đã khớp, không có sai lệch." FontSize="10" Foreground="#15803D" TextWrapping="Wrap"/>
                    </Border>
                    <Border Background="#FEF2F2" CornerRadius="8" Padding="10,7" Margin="0,0,0,8" Visibility="{Binding HasSelectedDifferences, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="⚠ SAI LỆCH" FontSize="10" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                            <ItemsControl ItemsSource="{Binding SelectedDifferences}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArReconcileDiffDto}">
                                <Border Padding="6,4" Margin="0,0,0,3" Background="White" CornerRadius="4">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border CornerRadius="4" Padding="3,0" Margin="0,0,6,0" VerticalAlignment="Center" Background="{Binding SeverityColor, Converter={StaticResource StringToBrush}}"><TextBlock Text="{Binding Severity}" FontSize="8" FontWeight="SemiBold" Foreground="White"/></Border>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A"/><TextBlock Text="{Binding Detail}" FontSize="9" Foreground="#64748B" TextWrapping="Wrap"/></StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Statement Summary -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10,7">
                        <StackPanel>
                        <TextBlock Text="STATEMENT" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Opening" FontSize="10" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding TotalOutstanding, StringFormat='{}{0:N0} ₫'}" FontSize="10" Foreground="#475569"/></Grid>
                            <Grid Grid.Row="1" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Debit" FontSize="10" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding TotalDebit, StringFormat='{}{0:N0} ₫'}" FontSize="10" Foreground="#2563EB"/></Grid>
                            <Grid Grid.Row="2" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Credit" FontSize="10" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding TotalCredit, StringFormat='{}{0:N0} ₫'}" FontSize="10" Foreground="#16A34A"/></Grid>
                            <Grid Grid.Row="3" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Payment" FontSize="10" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding TotalPayment, StringFormat='{}{0:N0} ₫'}" FontSize="10" Foreground="#D97706"/></Grid>
                            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Closing" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A"/><TextBlock Grid.Column="1" Text="{Binding TotalDifference, StringFormat='{}{0:N0} ₫'}" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/></Grid>
                        </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="4" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding PageDisplay}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/><Border CornerRadius="5" Padding="5,1" Margin="8,0,0,0" Background="#EFF6FF"><TextBlock Text="Reconciliation Center" FontSize="10" Foreground="#2563EB" FontWeight="SemiBold"/></Border></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="«" Style="{StaticResource PagerBtn}" Command="{Binding FirstPageCommand}" IsEnabled="{Binding HasPrevPage}" Width="28" Height="28" FontSize="11"/>
                    <Button Content="‹" Style="{StaticResource PagerBtn}" Command="{Binding PrevPageCommand}" IsEnabled="{Binding HasPrevPage}" Width="28" Height="28" FontSize="15"/>
                    <ItemsControl ItemsSource="{Binding PageButtons}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ArReconcilePaginationButton}"><Button Style="{StaticResource PagerPageBtn}" Width="30" Height="28" FontSize="11" Command="{Binding DataContext.SetPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding PageNumber}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Button Content="›" Style="{StaticResource PagerBtn}" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" Width="28" Height="28" FontSize="15"/>
                    <Button Content="»" Style="{StaticResource PagerBtn}" Command="{Binding LastPageCommand}" IsEnabled="{Binding HasNextPage}" Width="28" Height="28" FontSize="11"/>
                    <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemStringFormat="{}{0} / trang" Style="{StaticResource FluentComboBox}" Width="122" Height="28" MinWidth="0" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FORM OVERLAY: Match -->
        <Border Grid.RowSpan="5" Background="#80000000" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
            <Grid><Border Background="White" CornerRadius="12" MaxWidth="460" MaxHeight="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="12,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding FormTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/><Button Grid.Column="1" Content="Đóng" Style="{StaticResource SecondaryBtn}" Width="52" Height="28" Padding="6,0" Command="{Binding CloseFormCommand}"/></Grid></Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,10"><StackPanel>
                        <Border Background="#FEF2F2" CornerRadius="6" Padding="8,5" Margin="0,0,0,8" Visibility="{Binding FormErrorMessage, Converter={StaticResource StringToVis}}"><TextBlock Text="{Binding FormErrorMessage}" FontSize="10" Foreground="#DC2626"/></Border>
                        <StackPanel Visibility="{Binding IsMatchForm, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Mã GD nguồn" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding MatchSourceTxnId, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                            <TextBlock Text="Mã GD đích *" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding MatchTargetTxnId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                            <TextBlock Text="Số tiền" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding MatchAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                            <TextBlock Text="Lý do" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/><TextBox Text="{Binding MatchReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Width="Auto" Margin="0,0,0,8"/>
                        </StackPanel>
                    </StackPanel></ScrollViewer>
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Hủy" Style="{StaticResource SecondaryBtn}" Width="70" Command="{Binding CloseFormCommand}" Margin="0,0,6,0"/><Button Content="Ghép" Width="70" Style="{StaticResource PrimaryBtn}" Command="{Binding SubmitMatchFormCommand}"/></StackPanel></Border>
                </Grid>
            </Border></Grid>
        </Border>
        <Border Grid.RowSpan="5" Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Đang tải..." FontSize="14" Foreground="#64748B"/></StackPanel></Border>
    </Grid>
</UserControl>
