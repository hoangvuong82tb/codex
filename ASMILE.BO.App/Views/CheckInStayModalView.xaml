<UserControl x:Class="ASMILE.BO.App.Views.CheckInStayModalView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" UseLayoutRounding="True"><UserControl.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseCommand}" /></UserControl.InputBindings><Border Style="{StaticResource FO.LargeModalShell}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Check-in" Style="{StaticResource FO.HubPageTitle}"/><TextBlock Text="Chon ho so PendingArrival va xac nhan nhan phong." Foreground="{StaticResource TextSecondaryBrush}"/><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,14,0,8"/><Button Content="Tim" Command="{Binding SearchCommand}" Style="{StaticResource FluentSecondaryButton}" HorizontalAlignment="Left"/></StackPanel><Grid Grid.Row="1"><ListBox ItemsSource="{Binding Stays}" SelectedItem="{Binding SelectedStay}" DisplayMemberPath="GuestName"/><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource FO.Status.ErrorBrush}" TextWrapping="Wrap"/></Grid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding InfoMessage}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="Tai lai" Command="{Binding ReloadCommand}" IsEnabled="{Binding CanReload}" Style="{StaticResource FluentSecondaryButton}"/><Button Content="Huy" Command="{Binding CloseCommand}" Style="{StaticResource FluentSecondaryButton}"/><Button Content="Xac nhan nhan phong" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" Style="{StaticResource FluentPrimaryButton}" Margin="10,0,0,0"/></StackPanel></Grid></Border></UserControl>
