<Window x:Class="ASMILE.BO.App.Views.DeniedReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theo dõi từ chối"
        Width="1300" Height="800"
        MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F7F9FC"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="GrayBtn" TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="10" Background="#FEF2F2"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Theo dõi từ chối" FontSize="19" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Ghi nhận và phân tích các yêu cầu đặt phòng không thành công" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/></StackPanel>
                <Button Grid.Column="2" Content="Làm mới" Click="OnRefreshClick" Style="{StaticResource GrayBtn}"/>
            </Grid>
        </Border>

        <!-- EMPTY STATE: No backend -->
        <Border Grid.Row="1" Background="White" Margin="16,14,16,16" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
                <Border Width="72" Height="72" CornerRadius="18" Background="#FEF2F2" Margin="0,0,0,20">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#FCA5A5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Backend hiện chưa hỗ trợ theo dõi yêu cầu từ chối" FontSize="18" FontWeight="SemiBold" Foreground="#102E5A" TextAlignment="Center"/>
                <TextBlock Text="Module này sẽ cho phép ghi nhận các yêu cầu đặt phòng không thành công, phân tích lý do từ chối và theo dõi cơ hội phục hồi." FontSize="14" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>

                <!-- Planned features -->
                <Border Background="#F8FAFC" CornerRadius="10" Padding="16,14" Margin="0,20,0,0" Width="420">
                    <StackPanel>
                        <TextBlock Text="Tính năng dự kiến" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
                        <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0"><Run Text="• Ghi nhận yêu cầu bị từ chối với đầy đủ thông tin"/></TextBlock>
                        <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0"><Run Text="• Phân tích lý do: hết phòng, giá, hạng phòng, khách đổi ý"/></TextBlock>
                        <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0"><Run Text="• Theo dõi số phòng và room nights bị mất"/></TextBlock>
                        <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0"><Run Text="• Tạo đặt phòng từ yêu cầu khi có cơ hội phục hồi"/></TextBlock>
                        <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0"><Run Text="• Báo cáo Lost Business phân tích xu hướng từ chối"/></TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="#FFF7ED" CornerRadius="10" Padding="16,14" Margin="0,12,0,0" Width="420" BorderBrush="#FED7AA" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⚠ Trạng thái triển khai" FontSize="13" FontWeight="SemiBold" Foreground="#C2410C" Margin="0,0,0,4"/>
                        <TextBlock FontSize="12" Foreground="#9A3412" Text="BLOCKED BY BACKEND — Chưa có entity ReservationDenied, chưa có denied reason catalog, chưa có create/update command."/>
                    </StackPanel>
                </Border>

                <Button Content="Làm mới" Click="OnRefreshClick" Style="{StaticResource GrayBtn}" Margin="0,20,0,0" Width="120"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
