<Window x:Class="ASMILE.BO.App.Views.DeniedReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theo dõi từ chối" Width="1320" Height="820" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F7F9FC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="Input" TargetType="TextBox"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
        <Style x:Key="Combo" TargetType="ComboBox"><Setter Property="Height" Value="36"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="Padding" Value="8,0"/></Style>
        <Style x:Key="Primary" TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="16,0"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="Secondary" TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="16,0"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="10" Background="#FEE2E2"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Theo dõi từ chối" FontSize="20" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Ghi nhận và theo dõi yêu cầu đặt phòng không thành công" Foreground="#64748B" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="2" Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource Secondary}"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" Padding="18,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="220" Style="{StaticResource Input}" Margin="0,0,8,0" ToolTip="Tìm theo mã hoặc tên khách"/>
                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" Width="150" Style="{StaticResource Combo}" Margin="0,0,8,0"/>
                <Button Content="Tìm" Command="{Binding RefreshCommand}" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
                <TextBlock Text="Số yêu cầu:" VerticalAlignment="Center" Foreground="#64748B"/><TextBlock Text="{Binding Items.Count}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5,0,0,0"/>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2" Margin="16,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="10">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding DenialNumber}" Width="130"/>
                        <DataGridTextColumn Header="Khách" Binding="{Binding GuestName}" Width="*"/>
                        <DataGridTextColumn Header="Ngày đến" Binding="{Binding ArrivalDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Ngày đi" Binding="{Binding DepartureDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Nguồn" Binding="{Binding Source}" Width="90"/>
                        <DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="130"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Margin="12,0,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="Ghi nhận yêu cầu" FontSize="17" FontWeight="SemiBold" Foreground="#17365D" Margin="0,0,0,14"/>
                    <TextBlock Text="Tên khách" Foreground="#64748B"/><TextBox Text="{Binding GuestName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,4,0,10"/>
                    <TextBlock Text="Điện thoại" Foreground="#64748B"/><TextBox Text="{Binding GuestPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,4,0,10"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,5,0"><TextBlock Text="Ngày đến" Foreground="#64748B"/><DatePicker SelectedDate="{Binding ArrivalDate}" Margin="0,4,0,10"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Ngày đi" Foreground="#64748B"/><DatePicker SelectedDate="{Binding DepartureDate}" Margin="0,4,0,10"/></StackPanel></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,5,0"><TextBlock Text="Người lớn" Foreground="#64748B"/><TextBox Text="{Binding AdultCount}" Style="{StaticResource Input}" Margin="0,4,0,10"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Trẻ em" Foreground="#64748B"/><TextBox Text="{Binding ChildCount}" Style="{StaticResource Input}" Margin="0,4,0,10"/></StackPanel></Grid>
                    <TextBlock Text="Nguồn" Foreground="#64748B"/><TextBox Text="{Binding Source}" Style="{StaticResource Input}" Margin="0,4,0,10"/>
                    <TextBlock Text="Lý do" Foreground="#64748B"/><ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding Reason}" Style="{StaticResource Combo}" Margin="0,4,0,10"/>
                    <TextBlock Text="Ghi chú" Foreground="#64748B"/><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8" BorderBrush="#D8E2F0" Margin="0,4,0,14"/>
                    <Button Content="Ghi nhận từ chối" Command="{Binding CreateCommand}" Style="{StaticResource Primary}"/>
                    <Button Content="Đóng yêu cầu đang chọn" Command="{Binding CloseSelectedCommand}" IsEnabled="{Binding HasSelection}" Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding InfoMessage}" Foreground="#15803D" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="White" Padding="18,10" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"><TextBlock Text="Dữ liệu được lưu trong backend Front Office; không tạo dữ liệu mô phỏng." Foreground="#64748B"/></Border>
        <Border Grid.RowSpan="4" Background="#66000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"><TextBlock Text="Đang tải..." Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
</Window>
