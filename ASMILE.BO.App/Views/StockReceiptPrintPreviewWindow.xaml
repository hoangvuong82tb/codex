<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ASMILE.BO.App.Views.StockReceiptPrintPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Xem trước in phiếu nhập" Width="1100" Height="760" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterOwner" Background="#FFFFFFFF" xmlns:views="clr-namespace:ASMILE.BO.App.Views;assembly=ASMILE.BO.App">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Margin="0,0,0,10" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Background="#F8FAFC">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Width="110" Height="34" Margin="0,0,8,0" Content="In phiếu" Click="PrintButton_Click" />
        <Button Width="88" Height="34" IsCancel="True" Content="Đóng" />
      </StackPanel>
    </Border>
    <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
      <DocumentViewer Name="PreviewViewer" />
    </Border>
  </Grid>
</Window>