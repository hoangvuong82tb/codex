<UserControl x:Class="ASMILE.BO.App.Views.HotelPaymentMethodProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="SButton" TargetType="Button" BasedOn="{StaticResource HotelSettingsButtonBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style>
        <Style x:Key="SPrimary" TargetType="Button" BasedOn="{StaticResource SButton}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/></Style>
        <Style x:Key="SText" TargetType="TextBox" BasedOn="{StaticResource HotelSettingsTextBoxBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style>
        <Style x:Key="SCombo" TargetType="ComboBox" BasedOn="{StaticResource HotelSettingsComboBoxBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,0"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style>
    </UserControl.Resources>
    <Grid Background="Transparent" Margin="0,0,0,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Padding="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Phương thức thanh toán" FontSize="22" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Cấu hình phương thức thu tiền, phí, tiền tệ, tham chiếu và mapping BO theo cơ sở." Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Làm mới" Command="{Binding LoadCommand}" Style="{StaticResource SButton}"/><Button Content="+ Thêm phương thức" Command="{Binding NewItemCommand}" Style="{StaticResource SPrimary}" Margin="0"/></StackPanel></Grid></Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Từ khóa" Grid.Column="0" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBlock Text="Loại" Grid.Column="1" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SText}" ToolTip="Tìm theo mã, tên, tiền tệ, tài khoản hoặc terminal"/><ComboBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKindFilter}" Style="{StaticResource SCombo}"/><Button Grid.Row="1" Grid.Column="3" Content="Tìm" Command="{Binding SearchCommand}" Style="{StaticResource SButton}" Margin="8,0,0,0"/></Grid></Border>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
            <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="False"><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#F8FAFC" CornerRadius="10" ClipToBounds="True" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="Mã" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/><TextBlock Grid.Column="1" Text="Loại" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/><TextBlock Grid.Column="2" Text="Tên / tiền tệ" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/><TextBlock Grid.Column="3" Text="Phí" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/></Grid></Border><ListBox ItemContainerStyle="{StaticResource HotelSettingsListBoxItemStyle}" HorizontalContentAlignment="Stretch" Background="Transparent" Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="#475569"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding Name}" Foreground="#17365D"/><TextBlock Text="{Binding CurrencyCode}" Foreground="#94A3B8" FontSize="11"/></StackPanel><TextBlock Grid.Column="3" Text="{Binding FeeRate, StringFormat={}{0:0.####}%}" Foreground="#17365D"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
            <Border Grid.Column="1" Margin="16,0,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16"><StackPanel><StackPanel><TextBlock Text="Chi tiết phương thức thanh toán" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="{Binding SelectedSummary}" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/><StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Loại" Foreground="#475569"/><ComboBox ItemsSource="{Binding EditKindOptions}" SelectedItem="{Binding SelectedKind}" Style="{StaticResource SCombo}" Margin="0,4,0,10"/><TextBlock Text="Mã" Foreground="#475569"/><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SText}" Margin="0,4,0,10"/><TextBlock Text="Tên" Foreground="#475569"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SText}" Margin="0,4,0,10"/><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tiền tệ" Foreground="#475569"/><TextBox Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SText}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Phí (%)" Foreground="#475569"/><TextBox Text="{Binding FeeRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SText}" Margin="0,4,0,0"/></StackPanel></Grid><TextBlock Text="Tài khoản ngân hàng" Foreground="#475569"/><TextBox Text="{Binding BankAccount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SText}" Margin="0,4,0,10"/><TextBlock Text="Card terminal" Foreground="#475569"/><TextBox Text="{Binding CardTerminal, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SText}" Margin="0,4,0,10"/><TextBlock Text="Mapping BO" Foreground="#475569"/><TextBox Text="{Binding AccountingMapping, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SText}" Margin="0,4,0,10"/><CheckBox Content="Bắt buộc nhập mã tham chiếu" IsChecked="{Binding RequireReference}" Margin="0,0,0,8"/><CheckBox Content="Bắt buộc phê duyệt" IsChecked="{Binding RequireApproval}" Margin="0,0,0,14"/><StackPanel Orientation="Horizontal"><Button Content="Hủy" Command="{Binding CancelEditCommand}" Style="{StaticResource SButton}"/><Button Content="Lưu" Command="{Binding SaveCommand}" Style="{StaticResource SPrimary}" Margin="0"/></StackPanel></StackPanel><StackPanel Visibility="{Binding IsReadOnlyPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Loại" Foreground="#64748B" Margin="0,0,0,3"/><TextBlock Text="{Binding SelectedKindLabel}" Foreground="#17365D" FontWeight="SemiBold"/><TextBlock Text="Trạng thái" Foreground="#64748B" Margin="0,14,0,3"/><TextBlock Text="{Binding SelectedStatus}" Foreground="#17365D" FontWeight="SemiBold"/><TextBlock Text="Workspace này lưu dữ liệu thật theo property, hỗ trợ phí, tiền tệ, bank account, terminal, tham chiếu, phê duyệt và mapping BO." Foreground="#64748B" TextWrapping="Wrap" Margin="0,14,0,16"/><StackPanel Orientation="Horizontal"><Button Content="Sửa" Command="{Binding EditItemCommand}" Style="{StaticResource SPrimary}"/><Button Content="Bật / tạm ngưng" Command="{Binding ToggleActiveCommand}" Style="{StaticResource SButton}" Margin="0"/></StackPanel></StackPanel><Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap"/></Border><Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0" Visibility="{Binding HasInfo, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding InfoMessage}" Foreground="#166534" TextWrapping="Wrap"/></Border></StackPanel></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>



