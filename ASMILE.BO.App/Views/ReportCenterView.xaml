<UserControl x:Class="ASMILE.BO.App.Views.ReportCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASMILE.BO.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="SurfaceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DCE7F4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="36,0,12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D7E3F2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <Style x:Key="ReportNavigationListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F7FAFF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#D4E4F8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EAF2FF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#BFD7F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatIconButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentSecondaryButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="ExportChipButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentSecondaryButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="BorderBrush" Value="#D7E3F2" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="ParameterInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D7E3F2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="HistoryStatusBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#E8F8EE" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F4F8FD" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Trung tâm báo cáo"
                           Foreground="#10213F"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="Chạy báo cáo từ ReportEngine persisted, xem lịch sử và xuất Excel/PDF/CSV."
                           Margin="0,6,0,0"
                           Foreground="#64748B"
                           FontSize="13" />
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#F8FBFF"
                    BorderBrush="#D8E7FA"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,10"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text=""
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#2563EB"
                               FontSize="14"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Nguồn dữ liệu: ReportEngine"
                               Margin="8,0,0,0"
                               Foreground="#2563EB"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="295" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Danh mục báo cáo" Style="{StaticResource SectionHeaderTextStyle}" />

                    <Grid Grid.Row="1" Margin="0,14,0,14">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBoxStyle}" />
                        <TextBlock Text=""
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#94A3B8"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding ReportGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander IsExpanded="False" Margin="0,0,0,8">
                                            <Expander.Header>
                                                <DockPanel>
                                                    <TextBlock Text=""
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="#64748B"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="#1E293B"
                                                               FontWeight="SemiBold" />
                                                </DockPanel>
                                            </Expander.Header>
                                            <ListBox ItemsSource="{Binding Items}"
                                                     SelectedItem="{Binding DataContext.SelectedReport, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     ItemContainerStyle="{StaticResource ReportNavigationListItemStyle}"
                                                     Margin="0,8,0,0">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="#334155"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding SelectedReport.Name, FallbackValue='Kết quả báo cáo'}"
                                       Foreground="#10213F"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedReportDescription}"
                                       Margin="0,6,0,0"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource FluentPrimaryButton}"
                                    Command="{Binding ExecuteReportCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White" />
                                    <TextBlock Text="Chạy báo cáo" VerticalAlignment="Center" Foreground="White" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FluentSecondaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding RefreshSelectedReportCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Làm mới" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FluentDangerButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding CancelExecutionCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White" />
                                    <TextBlock Text="Dừng" VerticalAlignment="Center" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Style="{StaticResource ExportChipButtonStyle}" Command="{Binding ExportExcelCommand}" Width="106">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="6" Background="#E7F7EC" BorderBrush="#B7E4C3" BorderThickness="1">
                                    <TextBlock Text="X" Foreground="#15803D" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Excel" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ExportChipButtonStyle}" Command="{Binding ExportPdfCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="6" Background="#FEECEC" BorderBrush="#F9CACA" BorderThickness="1">
                                    <TextBlock Text="P" Foreground="#DC2626" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="PDF" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ExportChipButtonStyle}" Command="{Binding ExportCsvCommand}" Width="109">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="6" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                                    <TextBlock Text="C" Foreground="#2563EB" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="CSV" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="2"
                            BorderBrush="#DCE7F4"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="46" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                            </Grid>

                            <DataGrid x:Name="ResultGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding ResultPager.Items}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      RowHeight="36"
                                      ColumnHeaderHeight="40"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ResultPager.PageText}"
                                   VerticalAlignment="Center"
                                   Foreground="#64748B" />
                        <controls:TablePagerControl Grid.Column="1" DataContext="{Binding ResultPager}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Tham số" Style="{StaticResource SectionHeaderTextStyle}" />

                    <Border Grid.Row="1"
                            Background="#FFF7ED"
                            BorderBrush="#FED7AA"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,12,0,12"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#C2410C"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Grid.Row="2"
                            Background="#FBFDFF"
                            BorderBrush="#E2ECF8"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Foreground="#334155"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding DisplayName, Mode=OneWay}" />
                                            <Grid Margin="0,6,0,0">
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ParameterInputStyle}" />
                                                <TextBlock Text=""
                                                           FontFamily="Segoe MDL2 Assets"
                                                           Foreground="#94A3B8"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataType}" Value="Date">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <DatePicker SelectedDate="{Binding DateValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            SelectedDateFormat="Short"
                                                            Height="40"
                                                            Padding="10,6"
                                                            Background="White"
                                                            BorderBrush="#CBDCF5"
                                                            BorderThickness="1"
                                                            Foreground="#10213F">
                                                    <DatePicker.Style>
                                                        <Style TargetType="DatePicker">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataType}" Value="Date">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DatePicker.Style>
                                                </DatePicker>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource FluentSecondaryButton}"
                                    Command="{Binding ExecuteReportCommand}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Áp dụng tham số" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="3">
                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock Text="Lịch sử chạy" Style="{StaticResource SectionHeaderTextStyle}" DockPanel.Dock="Left" />
                                    <TextBlock Foreground="#2563EB" FontWeight="SemiBold" DockPanel.Dock="Right" />
                                </DockPanel>

                                <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding HistoryPager.Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="20" Height="20" CornerRadius="6" Margin="0,2,10,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#E8F8EE" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                        <Setter Property="Background" Value="#FEECEC" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="●"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="10">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#16A34A" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding ReportCode}" Foreground="#10213F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StartedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="#64748B" FontSize="12" />
                                                    </StackPanel>

                                                    <Border Grid.Column="2">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource HistoryStatusBorderStyle}">
                                                                <Setter Property="Background" Value="#E8F8EE" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                        <Setter Property="Background" Value="#FEECEC" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#15803D" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Report Center dùng ReportEngine persisted. Các màn báo cáo cũ vẫn giữ nguyên để tránh phá workflow hiện tại."
                       Foreground="#94A3B8"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="© 2026 Report Center    v1.0.0"
                       Foreground="#94A3B8"
                       FontSize="12" />
        </Grid>
    </Grid>
</UserControl>
