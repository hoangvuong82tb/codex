<Window x:Class="ASMILE.BO.App.Views.FolioBusinessDateBackfillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backfill ngày hạch toán Folio" Width="1120" Height="720"
        MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F8FAFC" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Secondary" TargetType="Button">
            <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Backfill ngày hạch toán Folio" FontSize="20" FontWeight="SemiBold" Foreground="#102E5A"/>
                <TextBlock Text="Chỉ cập nhật các dòng đang thiếu ngày. Ngày đề xuất phải được đối chiếu trước khi phê duyệt; mọi thay đổi đều ghi audit log." FontSize="13" Foreground="#64748B" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="10">
            <DataGrid x:Name="BackfillGrid" Style="{StaticResource GridStyle}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Chọn" Binding="{Binding IsSelected, Mode=TwoWay}" Width="55"/>
                    <DataGridTextColumn Header="Mã bút toán" Binding="{Binding EntryShortId}" Width="145" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Loại" Binding="{Binding EntryType}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Giá trị" Binding="{Binding AmountDisplay}" Width="105" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Ngày đề xuất" Binding="{Binding SuggestedBusinessDateDisplay}" Width="115" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Ngày hạch toán" Binding="{Binding BusinessDateText, UpdateSourceTrigger=PropertyChanged}" Width="125"/>
                    <DataGridTextColumn Header="Diễn giải" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Lý do phê duyệt" Foreground="#475569" VerticalAlignment="Center"/>
                <TextBox x:Name="ApprovalReasonBox" Grid.Column="1" Style="{StaticResource Input}" ToolTip="Ví dụ: Đối chiếu sổ Folio lịch sử tháng 09/2026"/>
                <TextBlock Text="Số tham chiếu" Grid.Column="2" Foreground="#475569" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBox x:Name="ApprovalReferenceBox" Grid.Column="3" Style="{StaticResource Input}" ToolTip="Số biên bản hoặc phiếu phê duyệt"/>
                <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="4" Foreground="#64748B" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"/>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Hủy" Click="OnCancel" Style="{StaticResource Secondary}" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyButton" Content="Phê duyệt &amp; backfill" Click="OnApply" Style="{StaticResource Primary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
