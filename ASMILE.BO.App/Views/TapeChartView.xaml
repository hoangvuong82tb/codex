<UserControl x:Class="ASMILE.BO.App.Views.TapeChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ASMILE.BO.App.ViewModels"
             xmlns:converters="clr-namespace:ASMILE.BO.App.Converters"
             UseLayoutRounding="True" Loaded="OnLoaded" PreviewKeyDown="OnKeyDown">
    <UserControl.Resources>
        <converters:StringToBrushConverter x:Key="StrToBrush"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThickness"/>
        <converters:StringToVisibilityConverter x:Key="StrToVis"/>
        <converters:IntToStringConverter x:Key="IntToStr"/>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseDetailCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NavigateDayCommand}" CommandParameter="1"/>
        <KeyBinding Key="Left" Command="{Binding NavigateDayCommand}" CommandParameter="-1"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Bieu Do Phong (Tape Chart)" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Border CornerRadius="3" Padding="6,2" Margin="12,4,0,0" Background="#DC2626" Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ConflictCount, StringFormat='{}{0} xung dot'}" FontSize="11" Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding TotalRooms, StringFormat='Phong: {0}'}" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalReservations, StringFormat='Dat phong: {0}'}" Margin="0,0,16,0" Foreground="#2563EB" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding InfoMessage}" Margin="12,0,0,0" Foreground="#16A34A" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="◀" Command="{Binding NavigateDayCommand}" CommandParameter="-1" Style="{StaticResource FluentSecondaryButton}" Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="Hom nay" Command="{Binding NavigateTodayCommand}" Style="{StaticResource FluentSecondaryButton}" Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="▶" Command="{Binding NavigateDayCommand}" CommandParameter="1" Style="{StaticResource FluentSecondaryButton}" Padding="8,4" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding ZoomOptions}" SelectedItem="{Binding ZoomDays, Converter={StaticResource IntToStr}}" Width="60" Margin="0,0,4,0"/>
                    <TextBlock Text="ngay" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button Content="Lam moi (F5)" Command="{Binding RefreshCommand}" Style="{StaticResource FluentSecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTER BAR -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="12,6">
            <WrapPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,6,4"/>
                <Button Content="Tim" Command="{Binding SearchCommand}" Style="{StaticResource FluentSecondaryButton}" Margin="0,0,6,4" Padding="8,4"/>
                <ComboBox ItemsSource="{Binding BuildingFilters}" SelectedItem="{Binding FilterBuilding}" Width="90" Margin="0,0,4,4"/>
                <ComboBox ItemsSource="{Binding FloorFilters}" SelectedItem="{Binding FilterFloor}" Width="90" Margin="0,0,4,4"/>
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" Width="100" Margin="0,0,4,4"/>
                <CheckBox Content="VIP" IsChecked="{Binding FilterVip}" Margin="6,3,4,4"/>
            </WrapPanel>
        </Border>

        <!-- CHART AREA -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

            <!-- Room list with drag source -->
            <Border Grid.Column="0" Background="White" BorderBrush="#DDE7F3" BorderThickness="0,0,1,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F0F4F8" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="8,10"><TextBlock Text="PHONG" FontWeight="Bold" FontSize="12"/></Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Rooms}" BorderThickness="0" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AllowDrop" Value="True"/><EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnRoomMouseDown"/><EventSetter Event="Drop" Handler="OnRoomDrop"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:TapeChartRoomDto}">
                            <Border Height="48" Padding="8,4" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Cursor="Hand" Tag="{Binding}" AllowDrop="True">
                                <Border.Background><Binding Path="IsOoo"><Binding.Converter><converters:BoolToVisibilityConverter/></Binding.Converter></Binding></Border.Background>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding RoomNumber}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding InventoryStatus}" FontSize="9" Foreground="#DC2626" Margin="4,2,0,0" Visibility="{Binding IsOoo, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RoomTypeName}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Timeline -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F0F4F8" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1">
                        <ItemsControl ItemsSource="{Binding DateHeaders}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Width="120" Height="40" BorderBrush="#DDE7F3" BorderThickness="0,0,1,0" Padding="4,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StringFormat='{}{0:ddd}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding StringFormat='{}{0:dd/MM}'}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Rooms}">
                        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:TapeChartRoomDto}">
                            <Border Height="48" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Background="{Binding IsOoo, Converter={StaticResource StrToBrush}, ConverterParameter='#FEE2E2'}">
                                <ItemsControl ItemsSource="{Binding Bars}" Height="44" Margin="4,2">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:TapeChartBar}">
                                        <Border Height="40" CornerRadius="6" Padding="8,2"
                                                Background="{Binding ColorCode, Converter={StaticResource StrToBrush}}"
                                                BorderBrush="#DC2626" BorderThickness="{Binding HasConflict, Converter={StaticResource BoolToThickness}}"
                                                Canvas.Left="{Binding BarLeft}" Width="{Binding BarWidth}" Cursor="Hand"
                                                MouseLeftButtonDown="OnBarClick">
                                            <Border.ToolTip>
                                                <ToolTip MaxWidth="300">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding GuestName}" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="{Binding ReservationNumber}" FontSize="11"/>
                                                        <Separator Margin="0,4"/>
                                                        <TextBlock FontSize="11"><Run Text="Phong: "/><Run Text="{Binding RoomNumber}"/></TextBlock>
                                                        <TextBlock Text="{Binding Status, StringFormat='Trang thai: {0}'}" FontSize="11"/>
                                                        <TextBlock Text="{Binding Company, StringFormat='Cong ty: {0}'}" FontSize="11" Visibility="{Binding Company, Converter={StaticResource StrToVis}}"/>
                                                        <TextBlock Text="{Binding DepositBalance, StringFormat='Dat coc: {0:N0} VND'}" FontSize="11"/>
                                                        <TextBlock Text="{Binding FolioBalance, StringFormat='So du: {0:N0} VND'}" FontSize="11" Foreground="#2563EB"/>
                                                        <Border CornerRadius="3" Padding="4,2" Background="#F2994A" Margin="0,4,0,0" Visibility="{Binding IsVip, Converter={StaticResource BoolToVis}}"><TextBlock Text="VIP" FontSize="10" Foreground="White"/></Border>
                                                        <TextBlock Text="{Binding ConflictReason}" FontSize="10" Foreground="#DC2626" FontWeight="Bold" Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding GuestName}" FontSize="11" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="⚠" FontSize="10" Foreground="White" Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}" Margin="4,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock FontSize="9" Foreground="White"><Run Text="{Binding ArrivalDate, StringFormat='{}{0:dd/MM}'}"/><Run Text=" → "/><Run Text="{Binding DepartureDate, StringFormat='{}{0:dd/MM}'}"/></TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- Detail Panel -->
            <Border Grid.Column="2" Width="360" Background="White" BorderBrush="#DDE7F3" BorderThickness="1,0,0,0" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
                <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CHI TIET" FontSize="16" FontWeight="Bold"/>
                        <Button Content="✕" Command="{Binding CloseDetailCommand}" HorizontalAlignment="Right" Margin="200,0,0,0" Style="{StaticResource FluentIconButton}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedBar.GuestName}" FontSize="16" FontWeight="SemiBold"/>
                            <Border CornerRadius="3" Padding="4,2" Background="#F2994A" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding SelectedBar.IsVip, Converter={StaticResource BoolToVis}}"><TextBlock Text="VIP" FontSize="10" Foreground="White" FontWeight="Bold"/></Border>
                            <TextBlock Text="{Binding SelectedBar.ReservationNumber}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SelectedBar.RoomNumber, StringFormat='Phong: {0}'}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SelectedBar.Status, StringFormat='Trang thai: {0}'}" Margin="0,4,0,0"/>

                            <Separator Margin="0,8"/>
                            <TextBlock Text="THONG TIN LUU TRU" FontWeight="Bold" FontSize="12" Margin="0,4,0,4"/>
                            <TextBlock Text="{Binding SelectedBar.ArrivalDate, StringFormat='Den: {0:dd/MM/yyyy}'}"/>
                            <TextBlock Text="{Binding SelectedBar.DepartureDate, StringFormat='Di: {0:dd/MM/yyyy}'}"/>
                            <TextBlock Text="{Binding SelectedBar.Company, StringFormat='Cong ty: {0}'}"/>
                            <TextBlock Text="{Binding SelectedBar.GroupName, StringFormat='Doan: {0}'}"/>

                            <Separator Margin="0,8"/>
                            <TextBlock Text="GIA PHONG" FontWeight="Bold" FontSize="12" Margin="0,4,0,4"/>
                            <TextBlock Text="{Binding SelectedBar.DailyRate, StringFormat='Gia ngay: {0:N0} VND'}"/>
                            <TextBlock Text="{Binding SelectedBar.PackageAmount, StringFormat='Goi: {0:N0} VND'}"/>
                            <TextBlock Text="{Binding SelectedBar.DiscountAmount, StringFormat='Giam gia: {0:N0} VND'}"/>
                            <TextBlock Text="{Binding SelectedBar.TotalAmount, StringFormat='Tong: {0:N0} VND'}" FontWeight="Bold" Foreground="#2563EB"/>

                            <Separator Margin="0,8"/>
                            <TextBlock Text="TAI CHINH" FontWeight="Bold" FontSize="12" Margin="0,4,0,4"/>
                            <TextBlock Text="{Binding SelectedBar.DepositBalance, StringFormat='Dat coc: {0:N0} VND'}"/>
                            <TextBlock Text="{Binding SelectedBar.FolioBalance, StringFormat='So du Folio: {0:N0} VND'}" Foreground="#2563EB"/>

                            <Separator Margin="0,8"/>
                            <TextBlock Text="THAO TAC" FontWeight="Bold" FontSize="12" Margin="0,4,0,4"/>
                            <Button Content="+ Gia han (+1 ngay)" Command="{Binding ExtendStayCommand}" CommandParameter="1" Style="{StaticResource FluentSecondaryButton}" Margin="0,2,0,4" Padding="8,4" FontSize="11"/>
                            <Button Content="- Rut ngan (-1 ngay)" Command="{Binding ShortenStayCommand}" CommandParameter="1" Style="{StaticResource FluentSecondaryButton}" Margin="0,0,0,4" Padding="8,4" FontSize="11"/>

                            <TextBlock Text="{Binding SelectedBar.Notes}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedBar.ConflictReason}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#DC2626" FontWeight="Bold" FontSize="11" Visibility="{Binding SelectedBar.HasConflict, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading -->
        <Border Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Dang tai..." Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
