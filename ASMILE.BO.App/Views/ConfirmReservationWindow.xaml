<Window x:Class="ASMILE.BO.App.Views.ConfirmReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ASMILE.BO.App.Controls"
        Title="Xác nhận đặt phòng"
        Width="1220" Height="780"
        MinWidth="1080" MinHeight="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F7F9FC"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.InputBindings><KeyBinding Key="F" Modifiers="Control" Command="{Binding SearchCommand}"/></Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Status badge -->
        <Style x:Key="StatusBadge" TargetType="Border"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="10,3"/><Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Draft"><Setter Property="Background" Value="#F1F5F9"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Tentative"><Setter Property="Background" Value="#FFF7ED"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Confirmed"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Background" Value="#F3F4F6"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NoShow"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Draft"><Setter Property="Foreground" Value="#475569"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Tentative"><Setter Property="Foreground" Value="#C2410C"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Confirmed"><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Foreground" Value="#6B7280"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NoShow"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Input styles -->
        <Style x:Key="ModTextBox" TargetType="TextBox"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ModCombo" TargetType="ComboBox"><Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#94A3B8" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="6" Stretch="Uniform"/></Grid></Border><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="8" Margin="0,2"><ScrollViewer MaxHeight="200"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ModDatePicker" TargetType="DatePicker"><Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker"><Grid><Border x:Name="Root" Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" BorderThickness="0" Background="Transparent" Padding="12,0" VerticalContentAlignment="Center" FontSize="13" FontFamily="Segoe UI" Foreground="#17365D"/><ToggleButton x:Name="PART_Button" Grid.Column="1" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><Border Width="26" Height="26" CornerRadius="6" Background="#EFF6FF"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#2F6BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ToggleButton></Grid><Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"><Border Background="White" BorderBrush="#DCE5F1" BorderThickness="1" CornerRadius="14" Padding="0"><Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.16" Color="#62748E"/></Border.Effect><Calendar x:Name="PART_Calendar" Style="{StaticResource FoModernCalendarStyle}" Language="vi-VN" BorderThickness="0" Background="White" SelectedDate="{Binding SelectedDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" DisplayDate="{Binding DisplayDate, RelativeSource={RelativeSource TemplatedParent}}"/></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#AFCBF7"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="ModDataGrid" TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="#FAFBFD"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="RowHeight" Value="40"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2F6FC"/><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="10,0"/></Style></Setter.Value></Setter>
            <Setter Property="RowStyle"><Setter.Value><Style TargetType="DataGridRow"><Setter Property="BorderBrush" Value="#F1F5F9"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style></Setter.Value></Setter>
        </Style>

        <!-- Buttons -->
        <Style x:Key="GreenBtn" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#16A34A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#15803D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Background" Value="#E8EDF5"/><Setter Property="Foreground" Value="#9AA8BA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GrayBtn" TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- Detail styles -->
        <Style x:Key="DL" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#7B8DA6"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style x:Key="DV" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="10" Background="#DCFCE7"><TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Xác nhận đặt phòng" FontSize="19" FontWeight="SemiBold" Foreground="#102E5A" FontFamily="Segoe UI"/><TextBlock Text="Kiểm tra và xác nhận các đặt phòng nháp hoặc tạm giữ" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/></StackPanel>
                <Button Grid.Column="2" Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource GrayBtn}"/>
            </Grid>
        </Border>

        <!-- ═══ FILTER CARD ═══ -->
        <Border Grid.Row="1" Margin="16,12,16,6" Padding="16,14" Background="White" CornerRadius="12" BorderBrush="#D8E2F0" BorderThickness="1">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,6"><TextBlock Text="Từ khóa" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/><TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModTextBox}" Width="220" TabIndex="1"/></StackPanel>
                <StackPanel Margin="0,0,12,6"><TextBlock Text="Trạng thái" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}" Style="{StaticResource ModCombo}" Width="150" TabIndex="2"/></StackPanel>
                <StackPanel Margin="0,0,12,6"><TextBlock Text="Ngày đến từ" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/><DatePicker SelectedDate="{Binding FilterArrivalFrom}" Style="{StaticResource ModDatePicker}" Width="140" TabIndex="3"/></StackPanel>
                <StackPanel Margin="0,0,12,6"><TextBlock Text="Ngày đến đến" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/><DatePicker SelectedDate="{Binding FilterArrivalTo}" Style="{StaticResource ModDatePicker}" Width="140" TabIndex="4"/></StackPanel>
                <StackPanel Margin="0,16,0,6" Orientation="Horizontal"><Button Content="Xóa lọc" Command="{Binding ClearFiltersCommand}" Style="{StaticResource GrayBtn}" TabIndex="5"/></StackPanel>
            </WrapPanel>
        </Border>

        <!-- ═══ MAIN: DataGrid + Detail ═══ -->
        <Grid Grid.Row="2" Margin="16,8,16,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>

            <!-- DataGrid Card -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <!-- Card Header -->
                    <Border Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Danh sách cần xác nhận" FontSize="14" FontWeight="SemiBold" Foreground="#102E5A"/>
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="#94A3B8" Text="{Binding TotalCount, StringFormat={}{0} kết quả}"/>
                        </Grid>
                    </Border>

                    <!-- Empty State -->
                    <Border Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" Background="White">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#94A3B8" HorizontalAlignment="Center"/><TextBlock Text="Không có đặt phòng đang chờ xác nhận" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" Margin="0,8,0,0"/><TextBlock Text="Thay đổi bộ lọc hoặc làm mới danh sách." FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/><Button Content="Xóa bộ lọc" Command="{Binding ClearFiltersCommand}" Style="{StaticResource GrayBtn}" Margin="0,14,0,0"/></StackPanel>
                    </Border>

                    <!-- Loading -->
                    <Border Grid.Row="1" Background="#D9FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar Width="160" Height="6" IsIndeterminate="True"/><TextBlock Text="Đang tải..." Margin="0,10,0,0" Foreground="#64748B"/></StackPanel></Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Reservations}" SelectedItem="{Binding SelectedReservation}" Style="{StaticResource ModDataGrid}" TabIndex="6">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Trạng thái" Width="115"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Border Style="{StaticResource StatusBadge}"><TextBlock Style="{StaticResource StatusText}" Text="{Binding Status}"/></Border>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Số đặt phòng" Binding="{Binding ReservationNumber}" Width="135"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#17365D"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            <DataGridTextColumn Header="Tên khách" Binding="{Binding GuestName}" Width="170"/>
                            <DataGridTextColumn Header="Ngày đến" Binding="{Binding ArrivalDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Ngày đi" Binding="{Binding DepartureDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Số đêm" Binding="{Binding Nights, Mode=OneWay}" Width="70"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Foreground" Value="#2563EB"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            <DataGridTextColumn Header="Người lớn" Binding="{Binding AdultCount}" Width="75"/>
                            <DataGridTextColumn Header="Trẻ em" Binding="{Binding ChildCount}" Width="65"/>
                            <DataGridTextColumn Header="Nguồn" Binding="{Binding Source}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Detail Panel -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,16">
                            <TextBlock Text="Kiểm tra đặt phòng" FontSize="14" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,14"/>

                            <!-- Empty state -->
                            <Border Background="#FAFBFD" CornerRadius="8" Padding="20,24"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <TextBlock Text="Chọn một đặt phòng để kiểm tra." FontSize="13" Foreground="#94A3B8" TextAlignment="Center"/>
                            </Border>

                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                                <!-- Group: Đặt phòng -->
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Text="ĐẶT PHÒNG" Margin="0,0,0,6"/>
                                <Border Padding="0,0,0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DL}" Text="Số ĐP"/><TextBlock Grid.Column="1" Style="{StaticResource DV}" Text="{Binding SelectedReservation.ReservationNumber, Mode=OneWay, FallbackValue=—}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <Border Padding="0,0,0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DL}" Text="Trạng thái"/><Border Grid.Column="1" Style="{StaticResource StatusBadge}" HorizontalAlignment="Right" DataContext="{Binding SelectedReservation}"><TextBlock Style="{StaticResource StatusText}" Text="{Binding Status, Mode=OneWay, FallbackValue=—}"/></Border>
                                    </Grid>
                                </Border>

                                <!-- Group: Khách -->
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,4,0,6">KHÁCH</TextBlock>
                                <Border Padding="0,0,0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource DL}" Text="Tên"/><TextBlock Grid.Column="1" Style="{StaticResource DV}" Text="{Binding SelectedReservation.GuestName, Mode=OneWay, FallbackValue=—}" HorizontalAlignment="Right"/></Grid></Border>
                                <Border Padding="0,0,0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource DL}" Text="Điện thoại"/><TextBlock Grid.Column="1" Text="{Binding SelectedReservation.GuestPhone, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" FontSize="13" Foreground="#17365D" HorizontalAlignment="Right"/></Grid></Border>
                                <Border Padding="0,0,0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource DL}" Text="Email"/><TextBlock Grid.Column="1" Text="{Binding SelectedReservation.GuestEmail, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" FontSize="13" Foreground="#17365D" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/></Grid></Border>

                                <!-- Group: Lưu trú -->
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,4,0,6">LƯU TRÚ</TextBlock>
                                <Border Padding="0,0,0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource DL}" Text="Ngày đến"/><TextBlock Grid.Column="1" Style="{StaticResource DV}" Text="{Binding SelectedReservation.ArrivalDate, Mode=OneWay, StringFormat=dd/MM/yyyy, FallbackValue=—}" HorizontalAlignment="Right"/></Grid></Border>
                                <Border Padding="0,0,0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource DL}" Text="Ngày đi"/><TextBlock Grid.Column="1" Style="{StaticResource DV}" Text="{Binding SelectedReservation.DepartureDate, Mode=OneWay, StringFormat=dd/MM/yyyy, FallbackValue=—}" HorizontalAlignment="Right"/></Grid></Border>
                                <Border Padding="0,0,0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource DL}" Text="Số đêm"/><TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding SelectedReservation.Nights, Mode=OneWay, StringFormat={}{0} đêm}" HorizontalAlignment="Right"/></Grid></Border>
                                <Border Padding="0,0,0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource DL}" Text="Khách"/><TextBlock Grid.Column="1" Style="{StaticResource DV}" HorizontalAlignment="Right"><Run Text="{Binding SelectedReservation.AdultCount, Mode=OneWay}"/><Run Text=" NL, "/><Run Text="{Binding SelectedReservation.ChildCount, Mode=OneWay}"/><Run Text=" TE"/></TextBlock></Grid></Border>

                                <!-- Group: Nguồn -->
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,4,0,6">NGUỒN</TextBlock>
                                <Border Padding="0,0,0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource DL}" Text="Nguồn"/><TextBlock Grid.Column="1" Style="{StaticResource DV}" Text="{Binding SelectedReservation.Source, Mode=OneWay, FallbackValue=—}" HorizontalAlignment="Right"/></Grid></Border>

                                <!-- Validation -->
                                <Border CornerRadius="8" Padding="12,10" Margin="0,6,0,0" BorderThickness="1"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFF7ED"/>
                                            <Setter Property="BorderBrush" Value="#FED7AA"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanConfirm}" Value="True">
                                                    <Setter Property="Background" Value="#F0FDF4"/>
                                                    <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ConfirmationReadinessMessage}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9A3412"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanConfirm}" Value="True">
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Actions -->
                    <Border Grid.Row="1" Padding="14,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Button Content="Xác nhận đặt phòng" Click="OnConfirmClick" Style="{StaticResource GreenBtn}" IsEnabled="{Binding CanConfirm}" TabIndex="7"/>
                            <Button Content="Tạm giữ" Click="OnTentativeClick" Style="{StaticResource GrayBtn}" Margin="0,8,0,0" IsEnabled="{Binding CanMarkTentative}" TabIndex="8"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ FOOTER ═══ -->
        <Border Grid.Row="3" Padding="16,12" Margin="16,10,16,14" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Foreground="#64748B" FontSize="13"><Run Text="Tổng: "/><Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#17365D"/><Run Text=" kết quả"/></TextBlock>
                    <TextBlock VerticalAlignment="Center" Foreground="#DC2626" FontSize="12" Margin="16,0,0,0" Text="{Binding ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"/>
                    <TextBlock VerticalAlignment="Center" Foreground="#15803D" FontSize="12" Margin="16,0,0,0" Text="{Binding InfoMessage, Mode=OneWay}" TextWrapping="Wrap" Visibility="{Binding HasInfo, Converter={StaticResource BoolVis}}" AutomationProperties.AutomationId="reservation.confirm.success-message"/>
                </StackPanel>
                <controls:ServerPagerControl Grid.Column="1" DataContext="{Binding}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
