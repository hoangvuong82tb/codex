<UserControl x:Class="ASMILE.BO.App.Views.HotelDepositPolicyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
 <UserControl.Resources><Style x:Key="B" TargetType="Button" BasedOn="{StaticResource HotelSettingsButtonBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style><Style x:Key="P" TargetType="Button" BasedOn="{StaticResource B}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/></Style><Style x:Key="T" TargetType="TextBox" BasedOn="{StaticResource HotelSettingsTextBoxBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style><Style x:Key="C" TargetType="ComboBox" BasedOn="{StaticResource HotelSettingsComboBoxBase}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,0"/><Setter Property="BorderBrush" Value="#D7E2F0"/></Style></UserControl.Resources>
 <Grid Background="Transparent" Margin="0,0,0,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Padding="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Chính sách đặt cọc" FontSize="22" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Thiết lập tiền cọc, hạn nộp, hoàn trả, nhắc hạn và tự động áp dụng vào Folio." Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Làm mới" Command="{Binding LoadCommand}" Style="{StaticResource B}"/><Button Content="+ Thêm chính sách" Command="{Binding NewItemCommand}" Style="{StaticResource P}" Margin="0"/></StackPanel></Grid></Border><Border Grid.Row="1" Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Từ khóa" Grid.Column="0" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" ToolTip="Tìm theo mã hoặc tên"/><Button Grid.Row="1" Grid.Column="2" Content="Tìm" Command="{Binding SearchCommand}" Style="{StaticResource B}" Margin="8,0,0,0"/></Grid></Border><Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions><Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="False"><ListBox ItemContainerStyle="{StaticResource HotelSettingsListBoxItemStyle}" HorizontalContentAlignment="Stretch" Background="Transparent" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="#17365D"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Foreground="#17365D"/><TextBlock Text="{Binding DepositType}" Foreground="#94A3B8" FontSize="11"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding EffectiveFrom, StringFormat={}{0:dd/MM/yyyy}}" Foreground="#475569"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border><Border Grid.Column="1" Margin="16,0,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="16"><StackPanel><StackPanel><TextBlock Text="Chi tiết chính sách đặt cọc" FontSize="16" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="{Binding SelectedSummary}" Foreground="#64748B" Margin="0,4,0,14"/><StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Loại" Foreground="#475569"/><ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding DepositType}" Style="{StaticResource C}" Margin="0,4,0,8"/><TextBlock Text="Mã" Foreground="#475569"/><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,4,0,8"/><TextBlock Text="Tên" Foreground="#475569"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,4,0,8"/><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Phần trăm"/><TextBox Text="{Binding Percentage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Số tiền"/><TextBox Text="{Binding FixedAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,4,0,0"/></StackPanel></Grid><TextBlock Text="Hạn trước ngày đến"/><TextBox Text="{Binding DueDaysBeforeArrival, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}" Margin="0,4,0,8"/><TextBlock Text="Hiệu lực từ / đến"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding EffectiveFrom, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/><TextBox Grid.Column="2" Text="{Binding EffectiveTo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource T}"/></Grid><CheckBox Content="Bắt buộc" IsChecked="{Binding Required}" Margin="0,0,0,6"/><CheckBox Content="Có thể hoàn trả" IsChecked="{Binding Refundable}" Margin="0,0,0,6"/><CheckBox Content="Có thể chuyển" IsChecked="{Binding Transferable}" Margin="0,0,0,6"/><CheckBox Content="Có thể tịch thu" IsChecked="{Binding Forfeitable}" Margin="0,0,0,6"/><CheckBox Content="Tự nhắc hạn" IsChecked="{Binding AutoReminder}" Margin="0,0,0,6"/><CheckBox Content="Tự áp dụng vào Folio" IsChecked="{Binding AutoApplyToFolio}" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Hủy" Command="{Binding CancelEditCommand}" Style="{StaticResource B}"/><Button Content="Lưu" Command="{Binding SaveCommand}" Style="{StaticResource P}" Margin="0"/></StackPanel></StackPanel><StackPanel Visibility="{Binding IsReadOnlyPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Loại" Foreground="#64748B"/><TextBlock Text="{Binding SelectedTypeLabel}" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock Text="Trạng thái" Foreground="#64748B" Margin="0,14,0,3"/><TextBlock Text="{Binding SelectedStatus}" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock Text="Workspace độc lập theo property, có hiệu lực, rowversion và audit." Foreground="#64748B" TextWrapping="Wrap" Margin="0,14,0,16"/><StackPanel Orientation="Horizontal"><Button Content="Sửa" Command="{Binding EditItemCommand}" Style="{StaticResource P}"/><Button Content="Bật / tạm ngưng" Command="{Binding ToggleActiveCommand}" Style="{StaticResource B}" Margin="0"/></StackPanel></StackPanel><Border Background="#FEF2F2" Padding="10" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap"/></Border></StackPanel></StackPanel></Border></Grid></Grid>
</UserControl>



