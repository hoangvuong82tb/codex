<Window x:Class="ASMILE.BO.App.Views.AddGroupServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm dịch vụ đoàn"
        Width="900"
        Height="720"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="DialogLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="DialogTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7E2F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7E2F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DialogDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/>
        </Style>
        <Style x:Key="PrimaryDialogBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#FF5A94"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E32F70"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelDialogBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="22,16" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="10" Background="#FF5A94">
                    <TextBlock Text="+" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Thêm dịch vụ đoàn mới" FontSize="18" FontWeight="SemiBold" Foreground="#102E5A"/>
                    <TextBlock Text="Điền thông tin dịch vụ và chọn hình thức Charge To." FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <!-- SECTION 1: Basic Info -->
                <Border Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Thông tin cơ bản" FontSize="13" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                            <!-- Row 0 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Loại dịch vụ *" Style="{StaticResource DialogLabel}"/>
                                <ComboBox x:Name="CategoryCombo" Style="{StaticResource DialogCombo}" SelectedIndex="0">
                                    <ComboBoxItem Content="Nhà hàng"/><ComboBoxItem Content="Hội họp"/><ComboBoxItem Content="Vận chuyển"/>
                                    <ComboBoxItem Content="Spa"/><ComboBoxItem Content="Giặt ủi"/><ComboBoxItem Content="Tiệc"/>
                                    <ComboBoxItem Content="Thiết bị"/><ComboBoxItem Content="Khác"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                                <TextBlock Text="Tên dịch vụ *" Style="{StaticResource DialogLabel}"/>
                                <TextBox x:Name="ServiceNameTextBox" Style="{StaticResource DialogTextBox}" Text=""/>
                            </StackPanel>

                            <!-- Row 1 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Department *" Style="{StaticResource DialogLabel}"/>
                                <ComboBox x:Name="DepartmentCombo" Style="{StaticResource DialogCombo}" SelectedIndex="0">
                                    <ComboBoxItem Content="Food &amp; Beverage"/><ComboBoxItem Content="Banquet"/><ComboBoxItem Content="Concierge"/>
                                    <ComboBoxItem Content="Spa"/><ComboBoxItem Content="Housekeeping"/><ComboBoxItem Content="Business Center"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                                <TextBlock Text="Nhà cung cấp" Style="{StaticResource DialogLabel}"/>
                                <ComboBox x:Name="ProviderCombo" Style="{StaticResource DialogCombo}" SelectedIndex="0">
                                    <ComboBoxItem Content="Sen Restaurant"/><ComboBoxItem Content="Lotus Restaurant"/><ComboBoxItem Content="Pool Bar"/>
                                    <ComboBoxItem Content="Saigon Catering"/><ComboBoxItem Content="Spa An Yên"/><ComboBoxItem Content="Mai Linh Taxi"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Row 2 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Địa điểm" Style="{StaticResource DialogLabel}"/>
                                <TextBox x:Name="LocationTextBox" Style="{StaticResource DialogTextBox}" Text=""/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,10">
                                <TextBlock Text="Đoàn" Style="{StaticResource DialogLabel}"/>
                                <ComboBox x:Name="GroupCombo" Style="{StaticResource DialogCombo}" DisplayMemberPath="GroupName"/>
                            </StackPanel>

                            <!-- Row 3: Date, Time, Duration, Qty -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Ngày *" Style="{StaticResource DialogLabel}"/>
                                <DatePicker x:Name="ServiceDatePicker" Style="{StaticResource DialogDatePicker}"/>
                            </StackPanel>
                            <Grid Grid.Row="3" Grid.Column="1" Margin="10,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Giờ *" Style="{StaticResource DialogLabel}"/>
                                    <ComboBox x:Name="ServiceTimeCombo" Style="{StaticResource DialogCombo}" SelectedIndex="7">
                                        <ComboBoxItem Content="06:00"/><ComboBoxItem Content="07:00"/><ComboBoxItem Content="08:00"/>
                                        <ComboBoxItem Content="09:00"/><ComboBoxItem Content="10:00"/><ComboBoxItem Content="11:00"/>
                                        <ComboBoxItem Content="12:00"/><ComboBoxItem Content="13:00"/><ComboBoxItem Content="14:00"/>
                                        <ComboBoxItem Content="15:00"/><ComboBoxItem Content="16:00"/><ComboBoxItem Content="17:00"/>
                                        <ComboBoxItem Content="18:00"/><ComboBoxItem Content="19:00"/><ComboBoxItem Content="20:00"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="Thời lượng (phút)" Style="{StaticResource DialogLabel}"/>
                                    <TextBox x:Name="DurationTextBox" Style="{StaticResource DialogTextBox}" Text="90"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SL *" Style="{StaticResource DialogLabel}"/>
                                    <TextBox x:Name="QuantityTextBox" Style="{StaticResource DialogTextBox}" Text="1"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: Pricing -->
                <Border Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Định giá" FontSize="13" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Đơn giá *" Style="{StaticResource DialogLabel}"/>
                                <TextBox x:Name="UnitPriceTextBox" Style="{StaticResource DialogTextBox}" Text="500000"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Giảm giá (%)" Style="{StaticResource DialogLabel}"/>
                                <TextBox x:Name="DiscountTextBox" Style="{StaticResource DialogTextBox}" Text="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="VAT (%)" Style="{StaticResource DialogLabel}"/>
                                <TextBox x:Name="TaxRateTextBox" Style="{StaticResource DialogTextBox}" Text="8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Phí DV (%)" Style="{StaticResource DialogLabel}"/>
                                <TextBox x:Name="ServiceChargeRateTextBox" Style="{StaticResource DialogTextBox}" Text="5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Tổng dự kiến" Style="{StaticResource DialogLabel}"/>
                                <Border Background="#F5F3FF" CornerRadius="7" Padding="10,0" Height="34" BorderBrush="#C4B5FD" BorderThickness="1">
                                    <TextBlock Text="500,000 VND" FontSize="12" FontWeight="SemiBold" Foreground="#7C3AED" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: Charge To -->
                <Border Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Charge To *" FontSize="13" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <RadioButton x:Name="MasterFolioRadio" Content="Master Folio" IsChecked="True" GroupName="ChargeTo" Margin="0,0,20,0" FontSize="12" Foreground="#17365D"/>
                            <RadioButton x:Name="GuestFolioRadio" Content="Guest Folio" GroupName="ChargeTo" Margin="0,0,20,0" FontSize="12" Foreground="#17365D"/>
                            <RadioButton x:Name="RoomRadio" Content="Phòng" GroupName="ChargeTo" Margin="0,0,20,0" FontSize="12" Foreground="#17365D"/>
                            <RadioButton x:Name="CompanyRadio" Content="Công ty" GroupName="ChargeTo" Margin="0,0,20,0" FontSize="12" Foreground="#17365D"/>
                            <RadioButton x:Name="AgentRadio" Content="Đại lý" GroupName="ChargeTo" FontSize="12" Foreground="#17365D"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 4: Category-specific fields -->
                <Border Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Chi tiết đặc thù (theo loại dịch vụ)" FontSize="13" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,12"/>

                        <!-- Restaurant -->
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,8">
                                <TextBlock Text="Nhà hàng" Style="{StaticResource DialogLabel}"/>
                                <ComboBox Style="{StaticResource DialogCombo}" SelectedIndex="0">
                                    <ComboBoxItem Content="Sen Restaurant"/><ComboBoxItem Content="Lotus Restaurant"/>
                                    <ComboBoxItem Content="Pool Bar"/><ComboBoxItem Content="Lobby Lounge"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,8">
                                <TextBlock Text="Loại menu" Style="{StaticResource DialogLabel}"/>
                                <ComboBox Style="{StaticResource DialogCombo}" SelectedIndex="0">
                                    <ComboBoxItem Content="Buffet"/><ComboBoxItem Content="Set Menu"/>
                                    <ComboBoxItem Content="Vegetarian"/><ComboBoxItem Content="Children"/><ComboBoxItem Content="Special Meal"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Meeting -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,8">
                                <TextBlock Text="Phòng họp" Style="{StaticResource DialogLabel}"/>
                                <ComboBox Style="{StaticResource DialogCombo}" SelectedIndex="0">
                                    <ComboBoxItem Content="Phòng họp Grand"/><ComboBoxItem Content="Phòng họp VIP"/>
                                    <ComboBoxItem Content="Ballroom"/><ComboBoxItem Content="Garden Terrace"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,8">
                                <TextBlock Text="Setup" Style="{StaticResource DialogLabel}"/>
                                <ComboBox Style="{StaticResource DialogCombo}" SelectedIndex="0">
                                    <ComboBoxItem Content="Theatre"/><ComboBoxItem Content="Classroom"/>
                                    <ComboBoxItem Content="U-Shape"/><ComboBoxItem Content="Boardroom"/><ComboBoxItem Content="Cocktail"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,4,0,0">
                            <CheckBox Content="Projector" Margin="0,0,16,0" FontSize="12" Foreground="#475569"/>
                            <CheckBox Content="Màn hình" Margin="0,0,16,0" FontSize="12" Foreground="#475569"/>
                            <CheckBox Content="Âm thanh" Margin="0,0,16,0" FontSize="12" Foreground="#475569"/>
                            <CheckBox Content="Sân khấu" Margin="0,0,16,0" FontSize="12" Foreground="#475569"/>
                            <CheckBox Content="Hoa" Margin="0,0,16,0" FontSize="12" Foreground="#475569"/>
                            <CheckBox Content="Bảng Welcome" FontSize="12" Foreground="#475569"/>
                        </WrapPanel>

                        <!-- Transport -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,8">
                                <TextBlock Text="Loại xe" Style="{StaticResource DialogLabel}"/>
                                <ComboBox Style="{StaticResource DialogCombo}" SelectedIndex="0">
                                    <ComboBoxItem Content="Sedan 4 chỗ"/><ComboBoxItem Content="SUV 7 chỗ"/>
                                    <ComboBoxItem Content="Van 16 chỗ"/><ComboBoxItem Content="Xe 29 chỗ"/><ComboBoxItem Content="Xe 45 chỗ"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,8">
                                <TextBlock Text="Số hiệu chuyến bay" Style="{StaticResource DialogLabel}"/>
                                <TextBox Style="{StaticResource DialogTextBox}" Text=""/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,8">
                                <TextBlock Text="Điểm đón" Style="{StaticResource DialogLabel}"/>
                                <TextBox Style="{StaticResource DialogTextBox}" Text=""/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,8">
                                <TextBlock Text="Điểm trả" Style="{StaticResource DialogLabel}"/>
                                <TextBox Style="{StaticResource DialogTextBox}" Text=""/>
                            </StackPanel>
                        </Grid>

                        <!-- Spa -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,8">
                                <TextBlock Text="Liệu trình" Style="{StaticResource DialogLabel}"/>
                                <ComboBox Style="{StaticResource DialogCombo}" SelectedIndex="0">
                                    <ComboBoxItem Content="Massage Thái"/><ComboBoxItem Content="Massage đá nóng"/>
                                    <ComboBoxItem Content="Facial"/><ComboBoxItem Content="Body Scrub"/><ComboBoxItem Content="Tắm thảo dược"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,8">
                                <TextBlock Text="Chuyên viên" Style="{StaticResource DialogLabel}"/>
                                <ComboBox Style="{StaticResource DialogCombo}" SelectedIndex="0">
                                    <ComboBoxItem Content="Chuyên viên A"/><ComboBoxItem Content="Chuyên viên B"/><ComboBoxItem Content="Chuyên viên C"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Laundry -->
                        <StackPanel Margin="0,4,0,0">
                            <CheckBox Content="Giặt nhanh (Express — giao trong 2h)" Margin="0,0,16,0" FontSize="12" Foreground="#475569"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 5: PIC & Remark -->
                <Border Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="PIC &amp; Ghi chú" FontSize="13" FontWeight="SemiBold" Foreground="#102E5A" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Người phụ trách (PIC)" Style="{StaticResource DialogLabel}"/>
                                <ComboBox Style="{StaticResource DialogCombo}" SelectedIndex="0">
                                    <ComboBoxItem Content="Nguyễn Sales"/><ComboBoxItem Content="Trần Phục Vụ"/><ComboBoxItem Content="Lê Điều Hành"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Ghi chú" Style="{StaticResource DialogLabel}"/>
                                <TextBox x:Name="RemarkTextBox" Style="{StaticResource DialogTextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Text=""/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer buttons -->
        <Border Grid.Row="2" Padding="20,14" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Style="{StaticResource CancelDialogBtn}" Click="OnCancelClick"/>
                <Button Content="Lưu dịch vụ" Style="{StaticResource PrimaryDialogBtn}" Margin="10,0,0,0" Click="OnSaveClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
