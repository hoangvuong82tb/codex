                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Giá vốn ước tính" Foreground="#64748B" FontSize="12" />
                      <TextBlock Foreground="#2563EB" FontWeight="Bold" FontSize="18" Text="{Binding DetailEstimatedCost, StringFormat=N0}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding AvailabilityStatusText}">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Setter Property="Foreground" Value="#16A34A" />
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding HasAvailabilityWarning}">
                              <Setter Property="Foreground" Value="#EA580C" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                  </Grid>
                </Border>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Kho xuất" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox Style="{StaticResource FluentComboBox}" SelectedValuePath="Id" DisplayMemberPath="Display" ItemsSource="{Binding WarehouseLookup}" SelectedValue="{Binding WarehouseId}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Kho nhận (nếu có)" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox Style="{StaticResource FluentComboBox}" SelectedValuePath="Id" DisplayMemberPath="Display" ItemsSource="{Binding WarehouseLookup}" SelectedValue="{Binding ToWarehouseId}" />
                  </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Tồn kho / Số lượng" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Style="{StaticResource FluentTextBox}" IsReadOnly="True" Text="{Binding DetailOnHand, StringFormat={}{0:#,##0.####}}" />
                      <TextBox Grid.Column="2" Style="{StaticResource FluentTextBox}" Text="{Binding DetailQuantity, UpdateSourceTrigger=LostFocus, StringFormat={}{0:#,##0.####}}" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Giá nhập / Giá xuất" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Style="{StaticResource FluentTextBox}" IsReadOnly="True" Text="{Binding DetailImportPrice, StringFormat={}{0:#,##0.####}}" />
                      <TextBox Grid.Column="2" Style="{StaticResource FluentTextBox}" Text="{Binding DetailUnitPrice, UpdateSourceTrigger=LostFocus, StringFormat={}{0:#,##0.####}}" />
                    </Grid>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Bộ phận" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox Style="{StaticResource FluentComboBox}" SelectedValuePath="Code" DisplayMemberPath="Display" ItemsSource="{Binding DepartmentLookup}" SelectedValue="{Binding DepartmentCode, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Visibility="{Binding ShowAccountingFields, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Tài khoản nợ / có" Foreground="#223B5A" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Style="{StaticResource FluentTextBox}" Text="{Binding DebitAccountCode, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBox Grid.Column="2" Style="{StaticResource FluentTextBox}" Text="{Binding CreditAccountCode, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource FluentToggleSwitchStyle}" VerticalAlignment="Center" IsChecked="{Binding IsTransfer, Mode=TwoWay}" />
                    <TextBlock Text="Chuyển kho" Margin="8,0,0,0" Foreground="#223B5A" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CompactPrimaryButtonStyle}" Margin="0,0,10,0" Command="{Binding AddDetailFromFormCommand}">
                      <TextBlock Text="Thêm dòng" Foreground="#FFFFFFFF" />
                    </Button>
                    <Button Style="{StaticResource CompactDangerButtonStyle}" Command="{Binding RemoveDetailCommand}" CommandParameter="{Binding SelectedDetail}">
                      <TextBlock Text="Xóa dòng" Foreground="#FFFFFFFF" />
                    </Button>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="#D9E5F4" BorderThickness="0,1,0,0" Padding="0,12,0,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CompactSecondaryButtonStyle}" Margin="0,0,10,0" Command="{Binding NewCommand}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" Foreground="#1F3653" FontSize="20" />
                    <TextBlock Text="Mới" Foreground="#1F3653" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource CompactPrimaryButtonStyle}" Margin="0,0,10,0" Command="{Binding SaveCommand}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" Foreground="#FFFFFFFF" FontSize="20" />
                    <TextBlock Text="Lưu" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource CompactDangerButtonStyle}" Command="{Binding DeleteCommand}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" Foreground="#FFFFFFFF" FontSize="20" />
                    <TextBlock Text="Xóa" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>