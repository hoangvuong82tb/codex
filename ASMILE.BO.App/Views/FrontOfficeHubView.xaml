<UserControl x:Class="ASMILE.BO.App.Views.FrontOfficeHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ASMILE.BO.App.Models"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseComingSoonCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="0" Direction="0" Opacity="0.08" Color="#1a3a5c"/>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="236"/>
            <Setter Property="Height" Value="92"/>
            <Setter Property="Margin" Value="9,10"/>
            <Setter Property="Padding" Value="16,0,14,0"/>
            <Setter Property="Background" Value="#FFFFFFF2"/>
            <Setter Property="BorderBrush" Value="#D5E3F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value><DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.12" Color="#1a3a5c"/></Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransform">
                        <Setter.Value><TranslateTransform Y="-3"/></Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type models:FrontOfficeHubCard}">
            <Border Style="{StaticResource CardBorderStyle}" Visibility="{Binding IsVisible, Converter={StaticResource BoolVis}}"
                    Tag="{Binding Id}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding Command}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBox" Width="54" Height="54" CornerRadius="14" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.24" Color="#000000"/>
                        </Border.Effect>
                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#16325C" VerticalAlignment="Center" Margin="16,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Id}" Value="reservation"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4A8EFF" Offset="0"/><GradientStop Color="#1765F2" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="reception"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#31C9B8" Offset="0"/><GradientStop Color="#00A58F" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="cashier"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFAD39" Offset="0"/><GradientStop Color="#ED7900" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="group"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B158FF" Offset="0"/><GradientStop Color="#7D2BE1" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="housekeeping"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4ED86E" Offset="0"/><GradientStop Color="#18B33F" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="telephone"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4A91FF" Offset="0"/><GradientStop Color="#1E6CF1" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="receivable"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2CC7D8" Offset="0"/><GradientStop Color="#00A7BA" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="inquiry"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3E83F3" Offset="0"/><GradientStop Color="#195FCE" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="marketing"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF5A94" Offset="0"/><GradientStop Color="#E32F70" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="reports"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#9853F0" Offset="0"/><GradientStop Color="#6F28D8" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="night-audit"><Setter TargetName="IconBox" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2661D9" Offset="0"/><GradientStop Color="#1046B7" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.04,0.04" Center="0.04,0.04" RadiusX="0.32" RadiusY="0.32">
                <GradientStop Color="#106aa7ff" Offset="0"/>
                <GradientStop Color="#00ffffff" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Visibility="{Binding IsMainHubOpen, Converter={StaticResource BoolVis}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1060" HorizontalAlignment="Center" Margin="0,40,0,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                    <TextBlock Text="Quản lý khách sạn" FontSize="38" FontWeight="SemiBold"
                               Foreground="#102e5a" TextAlignment="Center"/>
                    <TextBlock Text="Trung tâm điều hành các nghiệp vụ tiền sảnh và lưu trú"
                               FontSize="18" Foreground="#5E6E82" TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Cards}" Focusable="False"
                              HorizontalAlignment="Center" MaxWidth="1060">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="256" ItemHeight="118"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Border Grid.Row="2" Margin="0,12,0,0" Padding="14,10"
                        Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10"
                        Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#991B1B"/>
                </Border>
            </Grid>
        </ScrollViewer>
        </Grid>

        <ContentControl Content="{Binding ActiveWorkspace}"
                        Visibility="{Binding HasActiveWorkspace, Converter={StaticResource BoolVis}}"/>

        <Grid Visibility="{Binding IsComingSoonDialogOpen, Converter={StaticResource BoolVis}}">
            <Border Background="#40000000"/>
            <Border Background="White" CornerRadius="16" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="360" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                               Foreground="#E67E22" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ComingSoonTitle}" Margin="0,12,0,4"
                               FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="Chức năng này đang được phát triển." TextWrapping="Wrap"
                               FontSize="13" Foreground="#64748B" TextAlignment="Center"/>
                    <Button Content="Đã hiểu" Command="{Binding CloseComingSoonCommand}"
                            Style="{StaticResource FluentPrimaryButton}"
                            HorizontalAlignment="Center" Margin="0,18,0,0" Width="100"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
