              <TextBlock Text="Mức giảm tối đa của thu ngân (%)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding CashierMaxDiscountPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,14"/>
              <Button Content="Lưu cấu hình" Tag="&#xE74E;" Command="{Binding SaveSalesPolicySettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Text="Kiểm soát đang áp dụng" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
              <TextBlock Text="Các quyền hủy món, hủy đơn, giảm giá và phương thức thanh toán được kiểm tra ngay trên màn bán hàng." Foreground="#475569" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>

        <Grid Visibility="{Binding IsSettingsTabInventory, Converter={StaticResource B2V}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsCard}" Margin="0,0,14,0">
            <StackPanel>
              <TextBlock Text="Tồn kho &amp; định lượng" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
              <CheckBox Content="Kiểm tồn trước khi bán" IsChecked="{Binding CheckInventoryBeforeSale}" Margin="0,0,0,8"/>
              <CheckBox Content="Chặn bán khi hết nguyên liệu" IsChecked="{Binding BlockSaleWhenOutOfStock}" Margin="0,0,0,8"/>
              <CheckBox Content="Cảnh báo món chưa có định lượng" IsChecked="{Binding WarnMenuWithoutRecipe}" Margin="0,0,0,8"/>
              <CheckBox Content="Trừ kho khi thanh toán" IsChecked="{Binding ConsumeInventoryOnPayment}" Margin="0,0,0,8"/>
              <CheckBox Content="Trừ kho khi gửi bếp" IsChecked="{Binding ConsumeInventoryOnKitchenSend}" Margin="0,0,0,12"/>
              <TextBlock Text="Kho xuất bán mặc định" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding DefaultSaleWarehouseCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,14"/>
              <Button Content="Lưu cấu hình" Tag="&#xE74E;" Command="{Binding SaveSalesPolicySettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Text="Tình trạng món bán" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
              <TextBlock Text="Luồng bán hiện đang dùng cảnh báo tồn kho/định lượng từ menu item. Cấu hình này là lớp kiểm soát vận hành cho POS." Foreground="#475569" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>

        <Grid Visibility="{Binding IsSettingsTabDataAudit, Converter={StaticResource B2V}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsCard}" Margin="0,0,14,0">
            <StackPanel>
              <TextBlock Text="Dữ liệu &amp; audit" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
              <CheckBox Content="Ghi nhật ký thay đổi cấu hình" IsChecked="{Binding EnableSettingsAuditLog}" Margin="0,0,0,8"/>
              <CheckBox Content="Bắt buộc xác nhận trước khi reset" IsChecked="{Binding RequireConfirmBeforeReset}" Margin="0,0,0,8"/>
              <CheckBox Content="Cho phép export cấu hình" IsChecked="{Binding AllowExportSettings}" Margin="0,0,0,8"/>
              <CheckBox Content="Cho phép import cấu hình" IsChecked="{Binding AllowImportSettings}" Margin="0,0,0,12"/>
              <TextBlock Text="Số ngày lưu audit" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding AuditRetentionDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,10"/>
              <TextBlock Text="Thư mục backup cấu hình" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding SettingsBackupFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseModuleTextBox}" Height="36" Margin="0,0,0,14"/>
              <Button Content="Lưu cấu hình" Tag="&#xE74E;" Command="{Binding SaveSalesPolicySettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Text="File cấu hình" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
              <TextBlock Text="Các cấu hình POS được lưu tại Data/Settings/breakfast-cafe-sales-policy.json trong thư mục chạy ứng dụng." Foreground="#475569" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>


