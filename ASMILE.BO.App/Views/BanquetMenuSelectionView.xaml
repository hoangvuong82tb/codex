<UserControl x:Class="ASMILE.BO.App.Views.BanquetMenuSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Background="White">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>

    <Style x:Key="MiniIconButton" TargetType="Button">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MiniDeleteButton" TargetType="Button" BasedOn="{StaticResource MiniIconButton}">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
    </Style>

    <Style x:Key="PrimaryActionButton" TargetType="Button">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#1D4ED8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#1E40AF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
      <Setter Property="Background" Value="#EFF6FF"/>
      <Setter Property="Foreground" Value="#1D4ED8"/>
    </Style>

    <Style x:Key="NeutralActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="Foreground" Value="#1E3352"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#D9E2F0"/>
    </Style>

    <Style x:Key="PresetCatalogTabButton" TargetType="Button" BasedOn="{StaticResource NeutralActionButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedPresetTab}" Value="0">
          <Setter Property="Background" Value="#2563EB"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="BorderThickness" Value="0"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PresetGroupTabButton" TargetType="Button" BasedOn="{StaticResource NeutralActionButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedPresetTab}" Value="1">
          <Setter Property="Background" Value="#2563EB"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="BorderThickness" Value="0"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PresetEditorTabButton" TargetType="Button" BasedOn="{StaticResource NeutralActionButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedPresetTab}" Value="2">
          <Setter Property="Background" Value="#2563EB"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="BorderThickness" Value="0"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CategoryTreeButton" TargetType="Button">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CatalogEditButton" TargetType="Button">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="#F59E0B"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#D97706"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CatalogSelectButton" TargetType="Button" BasedOn="{StaticResource CatalogEditButton}">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#1D4ED8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="{Binding Title}"
               FontSize="18"
               FontWeight="Bold"
               Foreground="#0F2A55"
               Margin="0,0,0,8"/>

    <Grid Grid.Row="1" Visibility="{Binding IsCustomMenu, Converter={StaticResource B2V}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <ScrollViewer Grid.Column="0"
                    Grid.RowSpan="2"
                    VerticalScrollBarVisibility="Auto"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,1,0"
                    Margin="0,0,4,0">
        <ItemsControl ItemsSource="{Binding CategoryNodes}" Margin="4,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <Button Height="30"
                        Padding="4,0"
                        FontSize="12"
                        Cursor="Hand"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        Foreground="#475569"
                        BorderThickness="0"
                        Command="{Binding DataContext.ToggleCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text=">"
                               Width="14"
                               FontSize="9"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasChildren, Converter={StaticResource B2V}}"/>
                    <TextBlock Text="{Binding Category.Name}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                  </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Children}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource B2V}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Height="28"
                              Padding="18,0,4,0"
                              FontSize="12"
                              Cursor="Hand"
                              HorizontalContentAlignment="Left"
                              Background="Transparent"
                              Foreground="#64748B"
                              BorderThickness="0"
                              Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding Category.Id}">
                        <TextBlock Text="{Binding Category.Name}"/>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Grid Grid.Row="1" Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="6*"/>
          <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <TextBox Grid.Row="0"
                 Grid.ColumnSpan="2"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Height="34"
                 FontSize="13"
                 Padding="12,0"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,6"/>

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Margin="0,0,4,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ItemsSource}" Margin="4" Width="780" HorizontalAlignment="Left">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="152"
                          Margin="2"
                          Height="128"
                          VerticalAlignment="Top"
                          Background="White"
                          BorderBrush="#E5E7EB"
                          BorderThickness="1"
                          CornerRadius="6"
                          Cursor="Hand">
                    <Border.InputBindings>
                      <MouseBinding Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    MouseAction="LeftClick"/>
                    </Border.InputBindings>
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="85"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>
                      <Border Grid.Row="0" Height="85" Background="#FFF7ED" CornerRadius="4,4,0,0" ClipToBounds="True">
                        <Grid>
                          <Image Source="{Binding DisplayImageSource}" Stretch="UniformToFill" Visibility="{Binding HasImage, Converter={StaticResource B2V}}"/>
                          <Border Background="#FFF7ED" Visibility="{Binding HasNoImage, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding Emoji}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                        </Grid>
                      </Border>
                      <StackPanel Grid.Row="1" Margin="5,3,5,2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="10" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}" FontWeight="Bold" FontSize="10" Foreground="#EA580C" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Grid.RowSpan="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8"
                Margin="4,0,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,6">
              <TextBlock Text="Món đã chọn" FontSize="13" FontWeight="Bold" Foreground="#1E3352"/>
              <TextBlock FontSize="11" Foreground="#64748B">
                <Run Text="{Binding SelectedItems.Count, Mode=OneWay}"/>
                <Run Text=" món"/>
              </TextBlock>
            </StackPanel>

            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="4" Padding="4,3" Margin="0,0,0,2">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="66"/>
                  <ColumnDefinition Width="60"/>
                  <ColumnDefinition Width="68"/>
                  <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="STT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                <TextBlock Grid.Column="1" Text="Tên món" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                <TextBlock Grid.Column="2" Text="ĐV" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                <TextBlock Grid.Column="3" Text="SL" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Đơn giá" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="5" Text="Thành tiền" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="6" Text="Xóa" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
              </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding SelectedItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="2,5">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="26"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="44"/>
                          <ColumnDefinition Width="66"/>
                          <ColumnDefinition Width="60"/>
                          <ColumnDefinition Width="68"/>
                          <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding LineNo}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding FoodItem.Name}" FontSize="11" FontWeight="SemiBold" Foreground="#0F2A55" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding UnitName}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                        <Grid Grid.Column="3">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Button Style="{StaticResource MiniIconButton}" Background="#DCE7F7" Foreground="#1E3A5F" Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <TextBlock Text="-" FontSize="12" FontWeight="Bold" Foreground="#1E3A5F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Button>
                          <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="11" FontWeight="Bold" Foreground="#0F2A55" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                          <Button Grid.Column="2" Style="{StaticResource MiniIconButton}" Background="#BFDBFE" Foreground="#1D4ED8" Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <TextBlock Text="+" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Button>
                        </Grid>
                        <TextBlock Grid.Column="4" Text="{Binding UnitPrice, StringFormat={}{0:N0}}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                        <TextBlock Grid.Column="5" Text="{Binding LineTotal, StringFormat={}{0:N0} đ}" FontSize="11" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        <Button Grid.Column="6" Style="{StaticResource MiniDeleteButton}" Background="#FECACA" Foreground="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                          <TextBlock Text="X" FontSize="12" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="6" Padding="6,4" Margin="0,4,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#64748B">
                  <Run Text="{Binding TotalItems, Mode=OneWay}"/>
                  <Run Text=" món"/>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="Tổng tiền 1 bàn: " FontSize="11" FontWeight="SemiBold" Foreground="#0F2A55" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat={}{0:N0} đ}" FontSize="12" FontWeight="Bold" Foreground="#EA580C" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Button Grid.Row="2"
                Grid.Column="0"
                Content="Lưu &amp; Đóng"
                Style="{StaticResource PrimaryActionButton}"
                Margin="0,8,4,0"
                Command="{Binding SaveAndCloseCommand}"/>
      </Grid>
    </Grid>

    <Grid Grid.Row="1" Visibility="{Binding ShowPresetLayout, Converter={StaticResource B2V}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="#D9E2F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8"
                Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal">
            <Button Content="Danh mục thực đơn"
                    Style="{StaticResource PresetCatalogTabButton}"
                    Margin="0,0,8,0"
                    Command="{Binding SelectPresetTabCommand}"
                    CommandParameter="0"/>
            <Button Content="Nhóm thực đơn"
                    Style="{StaticResource PresetGroupTabButton}"
                    Margin="0,0,8,0"
                    Command="{Binding SelectPresetTabCommand}"
                    CommandParameter="1"/>
            <Button Content="Thêm món vào menu có sẵn"
                    Style="{StaticResource PresetEditorTabButton}"
                    Command="{Binding SelectPresetTabCommand}"
                    CommandParameter="2"/>
          </StackPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsPresetCatalogTab, Converter={StaticResource B2V}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                  <TextBlock Text="Thực đơn đã lưu" FontSize="16" FontWeight="Bold" Foreground="#1E3352"/>
                  <TextBlock Text="Tìm kiếm, xem nhanh và chọn thực đơn cho sự kiện hiện tại." FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="240"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Tìm kiếm" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox Height="34"
                             Text="{Binding PackageSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,0"
                             VerticalContentAlignment="Center"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Nhóm thực đơn" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox Height="34"
                              ItemsSource="{Binding PresetGroups}"
                              SelectedItem="{Binding SelectedPresetGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Padding="10,0"
                              VerticalContentAlignment="Center"/>
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Sắp xếp" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox Height="34"
                              ItemsSource="{Binding PackageSortOptions}"
                              SelectedItem="{Binding SelectedPackageSort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Padding="10,0"
                              VerticalContentAlignment="Center"/>
                  </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding FilteredPackages}" AlternationCount="5">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="5"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#D7E0EC"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                Height="450"
                                Margin="4">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="#EFF6FF"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                  <Setter Property="Background" Value="#F0FDF4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="2">
                                  <Setter Property="Background" Value="#FFF7ED"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="3">
                                  <Setter Property="Background" Value="#FDF4FF"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="4">
                                  <Setter Property="Background" Value="#F0FDFA"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="*"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#0F2A55" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding GroupName, TargetNullValue=Chưa phân nhóm}" FontSize="11" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="{Binding Price, StringFormat={}{0:N0} đ / 1 bàn}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#0F766E"
                                       Margin="0,8,0,0"/>

                            <Border Grid.Row="2" Grid.ColumnSpan="2" Height="290" Margin="0,10,0,8" Background="#FFFFFF" CornerRadius="8" Padding="8">
                              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Lines}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="*"/>
                                          <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding MenuItemName}" FontSize="10" Foreground="#1E3352" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}" FontSize="10" Foreground="#475569" HorizontalAlignment="Right"/>
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </ScrollViewer>
                            </Border>

                            <Grid Grid.Row="3" Grid.ColumnSpan="2">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <Button Content="Sửa"
                                      Style="{StaticResource CatalogEditButton}"
                                      Margin="0,0,5,0"
                                      Command="{Binding DataContext.EditPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>
                              <Button Grid.Column="1"
                                      Content="Chọn thực đơn"
                                      Style="{StaticResource CatalogSelectButton}"
                                      Margin="5,0,0,0"
                                      Command="{Binding DataContext.ApplySelectedPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>
                            </Grid>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <Grid Grid.Column="1">
              <Border Background="#FBFDFF"
                      BorderBrush="#E2E8F0"
                      BorderThickness="1"
                      CornerRadius="12"
                      Padding="16"
                      Visibility="{Binding ShowPresetEmptyState, Converter={StaticResource B2V}}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Chọn một thực đơn để xem nhanh" FontSize="18" FontWeight="Bold" Foreground="#0F2A55"/>
                  <TextBlock Text="Bạn có thể áp dụng ngay hoặc chuyển sang tab thiết kế để chỉnh lại món trong menu." FontSize="12" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <Border Background="#FBFDFF"
                      BorderBrush="#E2E8F0"
                      BorderThickness="1"
                      CornerRadius="12"
                      Padding="16"
                      Visibility="{Binding ShowPresetPreview, Converter={StaticResource B2V}}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding SelectedPackage.Name}" FontSize="18" FontWeight="Bold" Foreground="#0F2A55"/>
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Background="#EFF6FF" CornerRadius="999" Padding="10,4">
                          <TextBlock Text="{Binding SelectedPackageGroupDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="999" Padding="10,4" Margin="8,0,0,0">
                          <TextBlock Text="{Binding SelectedPackage.Code}" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                        </Border>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Button Content="Sửa"
                              Style="{StaticResource NeutralActionButton}"
                              Margin="0,0,8,0"
                              Command="{Binding EditSelectedPackageCommand}"/>
                      <Button Content="Chọn thực đơn"
                              Style="{StaticResource PrimaryActionButton}"
                              Command="{Binding ApplySelectedPackageCommand}"/>
                    </StackPanel>
                  </Grid>

                  <Grid Grid.Row="1" Margin="0,14,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180"/>
                      <ColumnDefinition Width="180"/>
                      <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,10,0">
                      <StackPanel>
                        <TextBlock Text="Đơn giá" FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding SelectedPackage.Price, StringFormat={}{0:N0} đ}" FontSize="16" FontWeight="Bold" Foreground="#0F766E" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,10,0">
                      <StackPanel>
                        <TextBlock Text="Số món" FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding SelectedPackage.LineCount}" FontSize="16" FontWeight="Bold" Foreground="#0F2A55" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                      <StackPanel>
                        <TextBlock Text="VAT" FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding SelectedPackage.VatRate, StringFormat={}{0:0.##}%}" FontSize="16" FontWeight="Bold" Foreground="#0F2A55" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Border Grid.Row="2"
                          Background="#FFFFFF"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="10">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>
                      <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="6" Padding="6,4" Margin="0,0,0,4">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="96"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="STT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                          <TextBlock Grid.Column="1" Text="Tên món" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                          <TextBlock Grid.Column="2" Text="ĐV" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                          <TextBlock Grid.Column="3" Text="Số lượng" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                          <TextBlock Grid.Column="4" Text="Đơn giá" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                          <TextBlock Grid.Column="5" Text="Thành tiền" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                        </Grid>
                      </Border>
                      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedPackageLines}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="4,6">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="96"/>
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="{Binding LineNo}" FontSize="11" Foreground="#94A3B8"/>
                                  <TextBlock Grid.Column="1" Text="{Binding ItemName}" FontSize="12" FontWeight="SemiBold" Foreground="#0F2A55" TextTrimming="CharacterEllipsis"/>
                                  <TextBlock Grid.Column="2" Text="{Binding UnitName}" FontSize="11" Foreground="#64748B"/>
                                  <TextBlock Grid.Column="3" Text="{Binding Quantity, StringFormat={}{0:0.###}}" FontSize="11" FontWeight="SemiBold" Foreground="#0F2A55" HorizontalAlignment="Center"/>
                                  <TextBlock Grid.Column="4" Text="{Binding UnitPrice, StringFormat={}{0:N0}}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                                  <TextBlock Grid.Column="5" Text="{Binding Amount, StringFormat={}{0:N0} đ}" FontSize="12" FontWeight="Bold" Foreground="#0F766E" HorizontalAlignment="Right"/>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Grid>
                  </Border>
                </Grid>
              </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsPresetGroupTab, Converter={StaticResource B2V}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="380"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,10,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                  <TextBlock Text="Tạo nhóm riêng" FontSize="16" FontWeight="Bold" Foreground="#1E3352"/>
                  <TextBlock Text="Nhóm giúp gom các menu cùng chủ đề, ví dụ: Tiệc cưới, Hội nghị, Cao cấp." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <TextBox Grid.Row="1"
                         Text="{Binding DraftPresetGroupName, UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         Padding="12,0"
                         VerticalContentAlignment="Center"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,12">
                  <Button Content="Tạo nhóm"
                          Style="{StaticResource PrimaryActionButton}"
                          Margin="0,0,8,0"
                          Width="110"
                          Command="{Binding CreatePresetGroupCommand}"/>
                  <Button Content="Tạo thực đơn"
                          Style="{StaticResource SecondaryActionButton}"
                          Margin="0,0,8,0"
                          Width="126"
                          Command="{Binding StartMenuFromDraftGroupCommand}"/>
                  <Button Content="Xem tất cả"
                          Style="{StaticResource NeutralActionButton}"
                          Width="110"
                          Command="{Binding SelectPresetGroupCommand}"
                          CommandParameter="Tất cả"/>
                </StackPanel>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding PresetGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Height="36"
                                Margin="0,0,0,8"
                                Padding="12,0"
                                HorizontalContentAlignment="Left"
                                Background="#FFFFFF"
                                Foreground="#334155"
                                BorderBrush="#D9E2F0"
                                BorderThickness="1"
                                Cursor="Hand"
                                Command="{Binding DataContext.SelectPresetGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                          <Button.Template>
                            <ControlTemplate TargetType="Button">
                              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                              </Border>
                            </ControlTemplate>
                          </Button.Template>
                          <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#FBFDFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                  <TextBlock Text="Thực đơn trong nhóm đang chọn" FontSize="16" FontWeight="Bold" Foreground="#1E3352"/>
                  <TextBlock FontSize="11" Foreground="#64748B" Margin="0,4,0,0">
                    <Run Text="Đang lọc: "/>
                    <Run Text="{Binding SelectedPresetGroup, Mode=OneWay}"/>
                  </TextBlock>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding FilteredPackages}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,10">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#0F2A55"/>
                              <TextBlock Text="{Binding Code}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                              <Button Content="Xem"
                                      Width="110"
                                      Style="{StaticResource CatalogSelectButton}"
                                      Margin="0,0,8,0"
                                      Command="{Binding DataContext.SelectPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>
                              <Button Content="Sửa"
                                      Width="110"
                                      Style="{StaticResource CatalogEditButton}"
                                      Command="{Binding DataContext.EditPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsPresetEditorTab, Converter={StaticResource B2V}}">
            <Border Background="#FBFDFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Visibility="{Binding ShowPresetEditor, Converter={StaticResource B2V}}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Thiết kế thực đơn có sẵn" FontSize="18" FontWeight="Bold" Foreground="#0F2A55"/>
                    <TextBlock Text="Tạo mới hoặc chỉnh sửa một menu rồi lưu lại để dùng nhanh cho các lần sau." FontSize="12" Foreground="#64748B" Margin="0,6,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Hủy"
                            Style="{StaticResource NeutralActionButton}"
                            Margin="0,0,8,0"
                            Command="{Binding CancelPackageEditorCommand}"/>
                    <Button Content="Lưu thực đơn"
                            Style="{StaticResource PrimaryActionButton}"
                            Command="{Binding SavePackageCommand}"/>
                  </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Nhóm thực đơn" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding MenuPackageGroups}"
                              SelectedItem="{Binding PackageGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Height="34"
                              Padding="10,0"
                              VerticalContentAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Tên thực đơn" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="10,0" VerticalContentAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Mã thực đơn" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PackageCode, Mode=OneWay}" Height="34" Padding="10,0" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F8FAFC"/>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="Đơn giá" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PackagePrice, Mode=OneWay, StringFormat={}{0:N0} đ}" Height="34" Padding="10,0" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F8FAFC"/>
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="VAT %" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PackageVatRate, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="10,0" VerticalContentAlignment="Center"/>
                  </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.78*"/>
                    <ColumnDefinition Width="1.22*"/>
                  </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,0,12,0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                      <TextBlock Text="Món trong menu" FontSize="13" FontWeight="Bold" Foreground="#1E3352" DockPanel.Dock="Left"/>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="6" Padding="6,4" Margin="0,0,0,4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="26"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="44"/>
                          <ColumnDefinition Width="66"/>
                          <ColumnDefinition Width="60"/>
                          <ColumnDefinition Width="68"/>
                          <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="STT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="Tên món" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="2" Text="ĐV" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="3" Text="SL" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="Đơn giá" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                        <TextBlock Grid.Column="5" Text="Thành tiền" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="Xóa" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                      </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding SelectedItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="2,5">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="26"/>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="44"/>
                                  <ColumnDefinition Width="66"/>
                                  <ColumnDefinition Width="60"/>
                                  <ColumnDefinition Width="68"/>
                                  <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding LineNo}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding FoodItem.Name}" FontSize="11" FontWeight="SemiBold" Foreground="#0F2A55" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding UnitName}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                <Grid Grid.Column="3">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>
                                  <Button Style="{StaticResource MiniIconButton}" Background="#DCE7F7" Foreground="#1E3A5F" Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <TextBlock Text="-" FontSize="12" FontWeight="Bold" Foreground="#1E3A5F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  </Button>
                                  <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="11" FontWeight="Bold" Foreground="#0F2A55" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                  <Button Grid.Column="2" Style="{StaticResource MiniIconButton}" Background="#BFDBFE" Foreground="#1D4ED8" Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <TextBlock Text="+" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  </Button>
                                </Grid>
                                <TextBlock Grid.Column="4" Text="{Binding UnitPrice, StringFormat={}{0:N0}}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                <TextBlock Grid.Column="5" Text="{Binding LineTotal, StringFormat={}{0:N0} đ}" FontSize="11" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <Button Grid.Column="6" Style="{StaticResource MiniDeleteButton}" Background="#FECACA" Foreground="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                  <TextBlock Text="X" FontSize="12" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="6" Padding="8,6" Margin="0,6,0,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#64748B">
                          <Run Text="{Binding TotalItems, Mode=OneWay}"/>
                          <Run Text=" món đã chọn"/>
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                          <TextBlock Text="Tổng tiền món" FontSize="11" FontWeight="SemiBold" Foreground="#0F2A55" VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <TextBlock Text="{Binding TotalAmount, Mode=OneWay, StringFormat={}{0:N0} đ}" FontSize="13" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Grid>
                </Border>

                <Grid Grid.Column="1">
                  <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>

                  <Border Grid.Column="0"
                          Grid.RowSpan="2"
                          Background="#FFFFFF"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1"
                          CornerRadius="10"
                          Margin="0,0,10,0"
                          Padding="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding CategoryNodes}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel>
                              <Button Style="{StaticResource CategoryTreeButton}"
                                      Height="30"
                                      Padding="4,0"
                                      FontSize="12"
                                      Cursor="Hand"
                                      HorizontalContentAlignment="Left"
                                      Background="Transparent"
                                      Foreground="#475569"
                                      BorderThickness="0"
                                      Command="{Binding DataContext.ToggleCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text=">"
                                             Width="14"
                                             FontSize="9"
                                             Foreground="#94A3B8"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding HasChildren, Converter={StaticResource B2V}}"/>
                                  <TextBlock Text="{Binding Category.Name}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>
                              </Button>
                              <ItemsControl ItemsSource="{Binding Children}" Visibility="{Binding IsExpanded, Converter={StaticResource B2V}}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Button Style="{StaticResource CategoryTreeButton}"
                                            Height="28"
                                            Padding="18,0,4,0"
                                            FontSize="12"
                                            Cursor="Hand"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            Foreground="#64748B"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Category.Id}">
                                      <TextBlock Text="{Binding Category.Name}"/>
                                    </Button>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Border>

                  <TextBox Grid.Column="1"
                           Grid.Row="0"
                           Height="34"
                           Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                           Padding="12,0"
                           VerticalContentAlignment="Center"
                           Margin="0,0,0,8"/>

                  <Border Grid.Column="1"
                          Grid.Row="1"
                          Background="#FFFFFF"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1"
                          CornerRadius="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding ItemsSource}" Margin="4" Width="624" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Width="152"
                                    Margin="2"
                                    Height="116"
                                    VerticalAlignment="Top"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Cursor="Hand">
                              <Border.InputBindings>
                                <MouseBinding Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              MouseAction="LeftClick"/>
                              </Border.InputBindings>
                              <Grid>
                                <Grid.RowDefinitions>
                                  <RowDefinition Height="72"/>
                                  <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Height="72" Background="#FFF7ED" CornerRadius="4,4,0,0" ClipToBounds="True">
                                  <Grid>
                                    <Image Source="{Binding DisplayImageSource}" Stretch="UniformToFill" Visibility="{Binding HasImage, Converter={StaticResource B2V}}"/>
                                    <Border Background="#FFF7ED" Visibility="{Binding HasNoImage, Converter={StaticResource B2V}}">
                                      <TextBlock Text="{Binding Emoji}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                  </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="5,3,5,2">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="10" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                  <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}" FontWeight="Bold" FontSize="10" Foreground="#EA580C" Margin="0,2,0,0"/>
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Border>
                </Grid>
                </Grid>

                <DockPanel Grid.Row="3" Margin="0,12,0,0">
                  <Button DockPanel.Dock="Right"
                          Content="Lưu thực đơn"
                          Width="140"
                          Style="{StaticResource PrimaryActionButton}"
                          Command="{Binding SavePackageCommand}"/>
                  <Button DockPanel.Dock="Right"
                          Content="Hủy"
                          Width="90"
                          Margin="0,0,8,0"
                          Style="{StaticResource NeutralActionButton}"
                          Command="{Binding CancelPackageEditorCommand}"/>
                </DockPanel>
              </Grid>
            </Border>

            <Border Background="#FBFDFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Visibility="{Binding ShowPresetEditorPlaceholder, Converter={StaticResource B2V}}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Chưa mở màn hình thiết kế menu" FontSize="18" FontWeight="Bold" Foreground="#0F2A55"/>
                <TextBlock Text="Hãy tạo thực đơn mới hoặc chọn một thực đơn rồi bấm Sửa từ tab Danh mục thực đơn hoặc Nhóm thực đơn." FontSize="12" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button Content="Tạo thực đơn mới"
                          Style="{StaticResource PrimaryActionButton}"
                          Margin="0,0,8,0"
                          Command="{Binding OpenNewPackageEditorCommand}"/>
                  <Button Content="Sang tab Danh mục"
                          Style="{StaticResource NeutralActionButton}"
                          Command="{Binding SelectPresetTabCommand}"
                          CommandParameter="0"/>
                </StackPanel>
              </StackPanel>
            </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
