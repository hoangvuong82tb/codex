                    <Border Height="1" Background="#E2E8F0" Margin="0,8,0,12"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#F1F5F9" CornerRadius="8" Padding="10,5"><TextBlock x:Name="ScanStatus" Text="Chưa quét" FontSize="12" Foreground="#94A3B8"/></Border>
                            <Button Content="Xóa kết quả" Style="{StaticResource ScanDeleteBtn}" Margin="16,0,0,0" Click="OnClearScanClick"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Bỏ qua bước này" Height="40" MinWidth="140" FontSize="13" FontFamily="Segoe UI" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Padding="16,0" Cursor="Hand" Click="OnSkipScanClick"/>
                            <Button Content="Áp dụng dữ liệu" Style="{StaticResource ScanApplyBtn}" Margin="12,0,0,0" Click="OnApplyScanClick" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- STEP B: GUEST & STAY -->
                <StackPanel x:Name="StepGuestContent" Visibility="Collapsed">
                    <TextBlock Text="Thông tin khách" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Họ và tên *" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><TextBox Grid.Column="1" x:Name="GuestName" Style="{StaticResource ModTextBox}" TabIndex="1"/></Grid>
                        <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Điện thoại" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><TextBox Grid.Column="1" x:Name="GuestPhone" Style="{StaticResource ModTextBox}" TabIndex="2"/></Grid>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,14">
                        <Button Content="Chọn khách cũ" Click="OnFindGuestClick" Style="{StaticResource GrayBtn}" Margin="0,0,8,0"/>
                        <Button Content="Tạo hồ sơ khách mới" Click="OnCreateGuestClick" Style="{StaticResource BlueBtn}"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Loại giấy tờ" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><ComboBox Grid.Column="1" Style="{StaticResource ModCombo}" TabIndex="3"><ComboBoxItem Content="CCCD"/><ComboBoxItem Content="Hộ chiếu"/><ComboBoxItem Content="CMND"/><ComboBoxItem Content="Khác"/></ComboBox></Grid>
                        <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Số giấy tờ" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><TextBox Grid.Column="1" x:Name="DocNumber" Style="{StaticResource ModTextBox}" TabIndex="4"/></Grid>
                    </Grid>
                    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Quốc tịch" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><ComboBox Grid.Column="1" Style="{StaticResource ModCombo}" TabIndex="5"><ComboBoxItem Content="Việt Nam"/><ComboBoxItem Content="Khác"/></ComboBox></Grid>
                        <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Ngày sinh" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><DatePicker Grid.Column="1" x:Name="Dob" Style="{StaticResource ModDatePicker}" TabIndex="6"/></Grid>
                    </Grid>
                    <TextBlock Text="Thông tin lưu trú" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions><TextBlock Text="Ngày đến" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><DatePicker Grid.Column="1" x:Name="ArrivalDate" SelectedDate="{x:Static sys:DateTime.Today}" Style="{StaticResource ModDatePicker}" TabIndex="7"/><TextBox Grid.Column="3" Text="14:00" Style="{StaticResource ModTextBox}" TextAlignment="Center" TabIndex="8"/></Grid>
                        <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions><TextBlock Text="Ngày đi" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><DatePicker Grid.Column="1" x:Name="DepartureDate" Style="{StaticResource ModDatePicker}" TabIndex="9"/><TextBox Grid.Column="3" Text="12:00" Style="{StaticResource ModTextBox}" TextAlignment="Center" TabIndex="10"/></Grid>
                    </Grid>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Số đêm" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><Border Background="#EFF6FF" CornerRadius="8" Padding="10,4" Margin="0,0,0,0"><TextBlock x:Name="NightsDisplay" FontSize="18" FontWeight="SemiBold" Foreground="#2F6BFF" Text="1"/></Border></Grid>
                    <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Số khách" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><StackPanel Grid.Column="1"><TextBlock Text="Người lớn" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/><TextBox x:Name="Adults" Text="1" Style="{StaticResource NumericBox}" TabIndex="11"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Trẻ em" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/><TextBox x:Name="Children" Text="0" Style="{StaticResource NumericBox}" TabIndex="12"/></StackPanel><StackPanel Grid.Column="5"><TextBlock Text="Sơ sinh" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/><TextBox Text="0" Style="{StaticResource NumericBox}" TabIndex="13"/></StackPanel><StackPanel Grid.Column="7"><TextBlock Text="Giường thêm" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/><TextBox Text="0" Style="{StaticResource NumericBox}" TabIndex="14"/></StackPanel></Grid>
                </StackPanel>

                <!-- STEP B -->
                <StackPanel x:Name="StepBContent" Visibility="Collapsed">
                    <TextBlock Text="Phòng &amp; dịch vụ" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,18"/>
                    <TextBlock Text="Chọn phòng" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Hạng phòng" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><ComboBox Grid.Column="1" x:Name="RoomTypeB" Style="{StaticResource ModCombo}" TabIndex="15" SelectionChanged="OnRoomTypeBChanged"/><Button Grid.Column="3" Content="…" Style="{StaticResource LookupBtn}" TabIndex="16"/></Grid>
                        <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Số phòng" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><ComboBox Grid.Column="1" x:Name="RoomB" Style="{StaticResource ModCombo}" TabIndex="17"/><Button Grid.Column="3" Content="…" Style="{StaticResource LookupBtn}" TabIndex="18"/></Grid>
                    </Grid>
                    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Tầng" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><TextBox Grid.Column="1" Style="{StaticResource ModTextBox}" IsReadOnly="True" Text="Chưa chọn"/></Grid>
                        <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Trạng thái" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><TextBox Grid.Column="1" Style="{StaticResource ModTextBox}" IsReadOnly="True" Text="—"/></Grid>
                    </Grid>
                    <Border Background="#EFF6FF" CornerRadius="10" Padding="14,12" Margin="0,0,0,16" Visibility="Collapsed" x:Name="SelectedRoomCard"><StackPanel><TextBlock Text="Phòng được chọn" FontSize="13" FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,0,0,4"/><TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" x:Name="RoomDetailB" Text="—"/><TextBlock FontSize="12" Foreground="#6F8198" x:Name="RoomFloorB" Margin="0,2,0,0"/></StackPanel></Border>
                    <TextBlock Text="Dịch vụ" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Meal Code" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><ComboBox Grid.Column="1" Style="{StaticResource ModCombo}" TabIndex="20"><ComboBoxItem Content="RO"/><ComboBoxItem Content="BB"/><ComboBoxItem Content="HB"/><ComboBoxItem Content="FB"/></ComboBox></Grid>
                        <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Nguồn" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><ComboBox Grid.Column="1" Style="{StaticResource ModCombo}" TabIndex="21"><ComboBoxItem Content="Walk-In"/><ComboBoxItem Content="Direct"/></ComboBox></Grid>
                    </Grid>
                </StackPanel>

                <!-- STEP C -->
                <StackPanel x:Name="StepCContent" Visibility="Collapsed">
                    <TextBlock Text="Giá &amp; Folio" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,18"/>
                    <TextBlock Text="Nguồn giá" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <RadioButton Content="Dùng Rate Code" GroupName="PriceSrc" IsChecked="True" Style="{StaticResource SegBtn}" Margin="0,0,8,0" TabIndex="22"/>
                        <RadioButton Content="Giá thỏa thuận" GroupName="PriceSrc" Style="{StaticResource SegBtn}" TabIndex="23"/>
                    </StackPanel>
                    <TextBlock Text="Giá phòng" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Rate Code" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><TextBox Grid.Column="1" Text="RACK" Style="{StaticResource ModTextBox}" TabIndex="24"/></Grid>
                        <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Room Rate" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><TextBox Grid.Column="1" x:Name="RoomRate" Style="{StaticResource ModTextBox}" TabIndex="25"/></Grid>
                    </Grid>
                    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Tiền tệ" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><ComboBox Grid.Column="1" Style="{StaticResource ModCombo}" TabIndex="26"><ComboBoxItem Content="VND"/><ComboBoxItem Content="USD"/></ComboBox></Grid>
                        <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="VAT" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><ToggleButton Grid.Column="2" x:Name="VatToggle" IsChecked="True" Style="{StaticResource VatToggle}" TabIndex="27"/><TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="13" Foreground="#17365D" x:Name="VatLabel" Text="Đã gồm VAT"/></Grid>
                    </Grid>
                    <TextBlock Text="Đặt cọc" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Tiền đặt cọc" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><TextBox Grid.Column="1" x:Name="DepositAmt" Text="0" Style="{StaticResource ModTextBox}" TabIndex="28"/></Grid>
                        <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Hình thức" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><ComboBox Grid.Column="1" Style="{StaticResource ModCombo}" TabIndex="29"><ComboBoxItem Content="Tiền mặt"/><ComboBoxItem Content="Chuyển khoản"/><ComboBoxItem Content="Thẻ"/></ComboBox></Grid>
                    </Grid>
                    <TextBlock Text="Giảm giá" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Giảm giá %" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><TextBox Grid.Column="1" x:Name="DiscountPct" Text="0" Style="{StaticResource ModTextBox}" TabIndex="30"/></Grid>
                        <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Giảm giá tiền" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium"/><TextBox Grid.Column="1" x:Name="DiscountAmt" Text="0" Style="{StaticResource ModTextBox}" TabIndex="31"/></Grid>
                    </Grid>
                </StackPanel>

                <!-- STEP D -->
                <StackPanel x:Name="StepDContent" Visibility="Collapsed">
                    <TextBlock Text="Xác nhận Walk-In" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                    <TextBlock Text="Kiểm tra thông tin trước khi tạo hồ sơ và nhận phòng." FontSize="13" Foreground="#64748B" Margin="0,0,0,18"/>
                    <WrapPanel Orientation="Horizontal">
                        <Border Width="290" Background="#FAFBFD" CornerRadius="10" Padding="16,14" Margin="0,0,12,12"><StackPanel><TextBlock Text="👤 Khách" FontSize="14" FontWeight="SemiBold" Foreground="#17365D" Margin="0,0,0,8"/><TextBlock FontSize="13" x:Name="ConfirmGuest" Text="—" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock FontSize="12" Foreground="#6F8198" x:Name="ConfirmPhone" Text="—" Margin="0,2,0,0"/><TextBlock FontSize="12" Foreground="#6F8198" x:Name="ConfirmDoc" Text="—" Margin="0,2,0,0"/></StackPanel></Border>
                        <Border Width="290" Background="#FAFBFD" CornerRadius="10" Padding="16,14" Margin="0,0,12,12"><StackPanel><TextBlock Text="🏨 Phòng" FontSize="14" FontWeight="SemiBold" Foreground="#17365D" Margin="0,0,0,8"/><TextBlock FontSize="13" x:Name="ConfirmRoom" Text="—" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock FontSize="12" Foreground="#6F8198" x:Name="ConfirmRoomTypeB" Text="—" Margin="0,2,0,0"/></StackPanel></Border>
                        <Border Width="290" Background="#FAFBFD" CornerRadius="10" Padding="16,14" Margin="0,0,12,12"><StackPanel><TextBlock Text="📅 Lưu trú" FontSize="14" FontWeight="SemiBold" Foreground="#17365D" Margin="0,0,0,8"/><TextBlock FontSize="13" x:Name="ConfirmStay" Text="—" FontWeight="SemiBold" Foreground="#17365D"/><TextBlock FontSize="13" x:Name="ConfirmNights" Text="—" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Border>
                        <Border Width="290" Background="#FAFBFD" CornerRadius="10" Padding="16,14" Margin="0,0,12,12"><StackPanel><TextBlock Text="💰 Giá" FontSize="14" FontWeight="SemiBold" Foreground="#17365D" Margin="0,0,0,8"/><TextBlock FontSize="13" x:Name="ConfirmPrice" Text="—" FontWeight="SemiBold" Foreground="#17365D"/></StackPanel></Border>
                    </WrapPanel>
                    <Border Background="#EFF6FF" CornerRadius="10" Padding="16,14" Margin="0,12,0,0" BorderBrush="#93C5FD" BorderThickness="1">
                        <TextBlock Text="Sẵn sàng thực hiện Walk-In" FontSize="14" TextAlignment="Center" Foreground="#1E40AF" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT SUMMARY -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20,18">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Chi tiết Walk-In" FontSize="16" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,14"/>
                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6"><StackPanel><TextBlock Text="Khách" FontSize="12" Foreground="#7B8DA6" Margin="0,0,0,6"/><TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" x:Name="SumGuest" Text="—"/><TextBlock FontSize="13" Foreground="#6F8198" x:Name="SumPhone" Text="—"/></StackPanel></Border>
                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6"><StackPanel><TextBlock Text="Lưu trú" FontSize="12" Foreground="#7B8DA6" Margin="0,0,0,6"/><TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" x:Name="SumStay" Text="—"/><TextBlock FontSize="13" Foreground="#6F8198" x:Name="SumNights" Text="—"/></StackPanel></Border>
                    <Border Background="#FAFBFD" CornerRadius="8" Padding="14,12" Margin="0,0,0,6"><StackPanel><TextBlock Text="Phòng" FontSize="12" Foreground="#7B8DA6" Margin="0,0,0,6"/><TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#17365D" x:Name="SumRoom" Text="—"/><TextBlock FontSize="13" Foreground="#6F8198" x:Name="SumRoomType" Text="—"/></StackPanel></Border>
                    <Border Background="#EEF4FF" BorderBrush="#CFE0FF" BorderThickness="1" CornerRadius="8" Padding="14,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="●" Foreground="#2F6BFF" FontSize="10" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Đang nhập dữ liệu" FontSize="13" Foreground="#1E40AF" Margin="8,0,0,0"/></Grid></Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="3" Padding="20,14" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Foreground="#DC2626" TextWrapping="Wrap" x:Name="ErrorText" Text="" MaxHeight="40"/><TextBlock x:Name="StepLabel" Text="Bước A/5" FontSize="13" Foreground="#64748B"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Đóng" Click="OnCloseClick" Style="{StaticResource GrayBtn}"/>
                    <Button Content="← Quay lại" Click="OnBackClick" x:Name="BackBtn" Style="{StaticResource GrayBtn}" Margin="10,0,0,0" Visibility="Collapsed"/>
                    <Button Content="Tiếp theo →" Click="OnNextClick" x:Name="NextBtn" Style="{StaticResource BlueBtn}" Margin="10,0,0,0"/>
                    <Button Content="Thực hiện Walk-In" Click="OnExecuteClick" x:Name="ExecuteBtn" Style="{StaticResource GreenBtn}" Margin="10,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
