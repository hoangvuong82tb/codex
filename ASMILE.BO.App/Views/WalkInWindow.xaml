<Window x:Class="ASMILE.BO.App.Views.WalkInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Walk-In" Width="1280" Height="900"
        MinWidth="1120" MinHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- ═══ CONTROL STYLES ═══ -->
        <Style x:Key="ModTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" SnapsToDevicePixels="True">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/><Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/></Trigger>
                    <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F4F6FA"/><Setter Property="Foreground" Value="#5F6F85"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ModCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" SnapsToDevicePixels="True">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#7B8DA6" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="6" Stretch="Uniform"/>
                    </Grid>
                </Border>
                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="9" Margin="0,2" SnapsToDevicePixels="True"><ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border>
                </Popup></Grid>
                <ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ModDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
                <Grid>
                    <Border x:Name="Root" Background="White" BorderBrush="#D8E2F0" BorderThickness="1" CornerRadius="9" SnapsToDevicePixels="True"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                        <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" BorderThickness="0" Background="Transparent" Padding="12,0" VerticalContentAlignment="Center" FontSize="14" FontFamily="Segoe UI" Foreground="#17365D"/>
                        <ToggleButton x:Name="PART_Button" Grid.Column="1" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#F2F6FD">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2F6BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ToggleButton>
                    </Grid>
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border Background="White" BorderBrush="#DCE5F1" BorderThickness="1" CornerRadius="14" Padding="0">
                            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.16" Color="#62748E"/></Border.Effect>
                            <Calendar x:Name="PART_Calendar" Style="{StaticResource FoModernCalendarStyle}" Language="vi-VN" BorderThickness="0" Background="White" SelectedDate="{Binding SelectedDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" DisplayDate="{Binding DisplayDate, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#AFCBF7"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#2F6BFF"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="NumericBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/><Setter Property="Width" Value="80"/><Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" SnapsToDevicePixels="True">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- VAT ToggleSwitch -->
        <Style x:Key="VatToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="24"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Track" Width="46" Height="24" CornerRadius="12" Background="#D8E2F0" SnapsToDevicePixels="True">
                    <Border x:Name="Thumb" Width="20" Height="20" CornerRadius="10" Background="White" HorizontalAlignment="Left" Margin="2,0,0,0" SnapsToDevicePixels="True">
                        <Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.15" Color="#000000"/></Border.Effect>
                    </Border>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#2F6BFF"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- Buttons -->
        <Style x:Key="BlueBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="22,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Background" Value="#94A3B8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GreenBtn" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#16A34A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="22,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GrayBtn" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#F3F6FA"/><Setter Property="Foreground" Value="#52657D"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LookupBtn" TargetType="Button"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="#2F6BFF"/><Setter Property="Background" Value="#F2F6FD"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E8F0FF"/><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SegBtn" TargetType="RadioButton"><Setter Property="Height" Value="38"/><Setter Property="MinWidth" Value="140"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#52657D"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="#2F6BFF"/><Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- Fluent Action Button Styles -->
        <Style x:Key="ScanActionBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Width" Value="110"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#2563EB"/><Setter Property="Background" Value="#F8FAFF"/>
            <Setter Property="BorderBrush" Value="#D7E3FF"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EAF2FF"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ScanDeleteBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Width" Value="110"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#DC2626"/><Setter Property="Background" Value="#FFF5F5"/>
            <Setter Property="BorderBrush" Value="#FECACA"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ScanApplyBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/><Setter Property="MinWidth" Value="140"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="22,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Background" Value="#94A3B8"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Padding="24,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0EA5E9" Offset="0"/><GradientStop Color="#0284C7" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE1D3;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="Walk-In" FontSize="20" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Tạo hồ sơ lưu trú cho khách không có đặt phòng trước" FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="2" Content="Làm mới" Click="OnRefreshClick" Style="{StaticResource GrayBtn}"/>
            </Grid>
        </Border>

        <!-- STEP BAR -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border x:Name="StepScanBox" Width="148" Height="64" CornerRadius="10" Margin="0,0,4,0" Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1.5" Cursor="Hand" Padding="12,8" MouseLeftButtonDown="OnStepClick" Tag="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="8" Background="#2563EB" VerticalAlignment="Center"><TextBlock Text="A" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="Quét giấy tờ" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF"/><TextBlock x:Name="StepScanLabel" Text="Đang nhập" FontSize="10" Foreground="#1E40AF" Opacity="0.7"/></StackPanel></Grid></Border>
                <TextBlock Text="▸" FontSize="16" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Border x:Name="StepABox" Width="148" Height="64" CornerRadius="10" Margin="0,0,4,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" Padding="12,8" MouseLeftButtonDown="OnStepClick" Tag="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="8" Background="#F1F5F9" VerticalAlignment="Center"><TextBlock Text="B" FontSize="15" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="Khách &amp; lưu trú" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/><TextBlock x:Name="StepALabel" Text="Chưa bắt đầu" FontSize="10" Foreground="#64748B"/></StackPanel></Grid></Border>
                <TextBlock Text="▸" FontSize="16" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Border x:Name="StepBBox" Width="148" Height="64" CornerRadius="10" Margin="0,0,4,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" Padding="12,8" MouseLeftButtonDown="OnStepClick" Tag="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="8" Background="#F1F5F9" VerticalAlignment="Center"><TextBlock Text="C" FontSize="15" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="Phòng &amp; dịch vụ" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/><TextBlock x:Name="StepBLabel" Text="Chưa bắt đầu" FontSize="10" Foreground="#64748B"/></StackPanel></Grid></Border>
                <TextBlock Text="▸" FontSize="16" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Border x:Name="StepCBox" Width="148" Height="64" CornerRadius="10" Margin="0,0,4,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" Padding="12,8" MouseLeftButtonDown="OnStepClick" Tag="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="8" Background="#F1F5F9" VerticalAlignment="Center"><TextBlock Text="D" FontSize="15" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="Giá &amp; Folio" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/><TextBlock x:Name="StepCLabel" Text="Chưa bắt đầu" FontSize="10" Foreground="#64748B"/></StackPanel></Grid></Border>
                <TextBlock Text="▸" FontSize="16" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Border x:Name="StepDBox" Width="148" Height="64" CornerRadius="10" Margin="0,0,4,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" Padding="12,8" MouseLeftButtonDown="OnStepClick" Tag="4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="8" Background="#F1F5F9" VerticalAlignment="Center"><TextBlock Text="E" FontSize="15" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="Xác nhận" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/><TextBlock x:Name="StepDLabel" Text="Chưa bắt đầu" FontSize="10" Foreground="#64748B"/></StackPanel></Grid></Border>
            </StackPanel>
        </Border>

        <!-- MAIN: 2-column -->
        <Grid Grid.Row="2" Margin="24,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="65*" MinWidth="440"/><ColumnDefinition Width="20"/><ColumnDefinition Width="35*" MinWidth="330"/></Grid.ColumnDefinitions>

            <!-- LEFT INPUT CARD -->
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="26,22">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.04" Color="#000000"/></Border.Effect>
                <Grid>
                <!-- STEP A: DOCUMENT SCAN (optional, can skip) -->
                <StackPanel x:Name="StepAContent">
                    <TextBlock Text="Quét giấy tờ" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" FontFamily="Segoe UI" Margin="0,0,0,14"/>

                    <!-- Row 1: Chọn khách + Loại giấy tờ -->
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Chọn khách" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource ModCombo}" TabIndex="1"><ComboBoxItem Content="Khách chính" IsSelected="True"/></ComboBox>
                        </Grid>
                        <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Loại giấy tờ" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource ModCombo}" TabIndex="2"><ComboBoxItem Content="CCCD" IsSelected="True"/><ComboBoxItem Content="Hộ chiếu"/><ComboBoxItem Content="CMND"/><ComboBoxItem Content="Khác"/></ComboBox>
                        </Grid>
                    </Grid>

                    <Border Height="1" Background="#E2E8F0" Margin="0,2,0,10"/>

                    <!-- Action Bar -->
                    <Border Background="White" Padding="14,12" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Quét CCCD" Style="{StaticResource ScanActionBtn}" TabIndex="3" IsEnabled="False" ToolTip="Chức năng quét giấy tờ chưa được kết nối."/>
                            <Button Content="Passport" Style="{StaticResource ScanActionBtn}" Margin="10,0,0,0" TabIndex="4" IsEnabled="False" ToolTip="Chức năng quét giấy tờ chưa được kết nối."/>
                            <Button Content="Nạp ảnh" Style="{StaticResource ScanActionBtn}" Margin="10,0,0,0" TabIndex="5" IsEnabled="False"/>
                            <Button Content="Khách cũ" Style="{StaticResource ScanActionBtn}" Margin="10,0,0,0" TabIndex="6" Click="OnFindGuestClick"/>
                            <Button Content="Xóa" Style="{StaticResource ScanDeleteBtn}" Margin="10,0,0,0" TabIndex="7" Click="OnClearScanClick"/>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#E2E8F0" Margin="0,2,0,10"/>

                    <!-- Row 3+: Identity fields -->
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Họ và tên" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                            <TextBox Grid.Column="1" x:Name="ScanFullName" Style="{StaticResource ModTextBox}" TabIndex="8"/>
                        </Grid>
                        <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Giới tính" VerticalAlignment="Center" FontSize="13" Foreground="#52657D" FontWeight="Medium" FontFamily="Segoe UI"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource ModCombo}" TabIndex="9"><ComboBoxItem Content="Nam"/><ComboBoxItem Content="Nữ"/></ComboBox>
                        </Grid>
                    </Grid>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
