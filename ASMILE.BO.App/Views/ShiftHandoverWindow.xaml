<Window x:Class="ASMILE.BO.App.Views.ShiftHandoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bàn giao ca" Width="1720" Height="940" MinWidth="1400" MinHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#94A3B8"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Height" Value="30"/><Setter Property="Background" Value="#2F6BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="10,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Height" Value="30"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="8,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox"><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,0"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#17365D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E2F0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PanelCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Padding="14,8" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="9"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#10B981" Offset="0"/><GradientStop Color="#059669" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Bàn giao ca" FontSize="17" FontWeight="SemiBold" Foreground="#102E5A"/><TextBlock Text="Tổng hợp và bàn giao toàn bộ trạng thái vận hành Front Office." FontSize="11" Foreground="#64748B"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Làm mới" Click="OnRefresh" Style="{StaticResource SecondaryButton}"/><Button Content="Xuất" Click="OnExport" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0"/><Button Content="In" Click="OnPrint" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0"/><Button Content="Đóng" Click="OnClose" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="10,6" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="ShiftInfoPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Xác nhận bàn giao" Click="OnConfirmHandover" Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="10,6" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel x:Name="KpiStrip" Orientation="Horizontal"/>
        </Border>

        <Grid Grid.Row="3" Margin="8,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="720"/><ColumnDefinition Width="8"/><ColumnDefinition Width="260"/><ColumnDefinition Width="8"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelCard}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel x:Name="CenterTabs" Orientation="Horizontal" Margin="8,6,0,6"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel x:Name="Tab1" Visibility="Visible" Margin="12,4"><StackPanel x:Name="Tab1Panel"/></StackPanel>
                            <StackPanel x:Name="Tab2" Visibility="Collapsed" Margin="12,4"><StackPanel x:Name="Tab2Panel"/></StackPanel>
                            <StackPanel x:Name="Tab3" Visibility="Collapsed" Margin="12,4"><StackPanel x:Name="Tab3Panel"/></StackPanel>
                            <StackPanel x:Name="Tab4" Visibility="Collapsed" Margin="12,4"><StackPanel x:Name="Tab4Panel"/></StackPanel>
                            <StackPanel x:Name="Tab5" Visibility="Collapsed" Margin="12,4"><StackPanel x:Name="Tab5Panel"/></StackPanel>
                            <StackPanel x:Name="Tab6" Visibility="Collapsed" Margin="12,4"><StackPanel x:Name="Tab6Panel"/></StackPanel>
                            <StackPanel x:Name="Tab7" Visibility="Collapsed" Margin="12,4"><StackPanel x:Name="Tab7Panel"/></StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ShiftSummaryPanel"/>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource PanelCard}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="InspectorTabs" Orientation="Horizontal" Margin="4,3,0,0"/>
                        </ScrollViewer>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,6"><StackPanel x:Name="InspectorPanel"/></ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Padding="10,5" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid><TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/><Button HorizontalAlignment="Right" Content="Đóng" Click="OnClose" Style="{StaticResource SecondaryButton}"/></Grid>
        </Border>
    </Grid>
</Window>
