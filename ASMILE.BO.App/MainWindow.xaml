<Window x:Class="ASMILE.BO.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ASMILE.BO.App.Views"
        xmlns:authViews="clr-namespace:ASMILE.BO.App.Views.Auth"
        mc:Ignorable="d"
        Title="ASMILE BO - Windows 11 Enterprise Shell"
        Height="920"
        Width="1540"
        MinHeight="760"
        MinWidth="1280"
        Icon="file:///D:/ASMILE-BO/Windows_Icon/Icons/logo/u2.png"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">
    <Grid>
        <views:DesktopShellView />

        <Border x:Name="LoginOverlay" Background="#66000000" Visibility="Collapsed">
            <authViews:LoginPanelView x:Name="LoginPanel" />
        </Border>
    </Grid>
</Window>
