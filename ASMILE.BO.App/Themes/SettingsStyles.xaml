<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="SettingsMainBackground" Color="#EFF6FB" />
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SettingsBorderBrush" Color="#DDE6F1" />
    <SolidColorBrush x:Key="SettingsTextPrimaryBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="SettingsTextSecondaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="SettingsAccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="SettingsDangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="SettingsSuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="SettingsWarningBrush" Color="#F59E0B" />

    <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="12,0,10,0" />
        <Setter Property="Margin" Value="0,3,0,3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                        <Grid>
                            <Border x:Name="SelectedBar" Width="3" Background="Transparent" HorizontalAlignment="Left" CornerRadius="2" Margin="0,6,0,6"/>
                            <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EEF3FA" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E8F1FF" />
                            <Setter TargetName="SelectedBar" Property="Background" Value="#2563EB" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SettingsCardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SettingsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="SettingsSettingRowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="70" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Padding" Value="16,10,16,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F8FAFC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsPrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{StaticResource SettingsAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsSecondaryButton" TargetType="Button" BasedOn="{StaticResource SettingsPrimaryButton}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#1F2937" />
        <Setter Property="BorderBrush" Value="{StaticResource SettingsBorderBrush}" />
    </Style>

    <Style x:Key="SettingsToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="Track" Width="46" Height="24" CornerRadius="12" Background="#CBD5E1"/>
                        <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#2563EB"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
