<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardSoftBrush" Color="{StaticResource CardSoftColor}" />
    <SolidColorBrush x:Key="TaskbarBrush" Color="{StaticResource TaskbarColor}" />
    <SolidColorBrush x:Key="StartMenuBrush" Color="{StaticResource StartMenuColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource TextOnDarkColor}" />

    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}" />
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentOrangeColor}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}" />

    <ImageBrush x:Key="DesktopWallpaperBrush"
                ImageSource="file:///C:/Windows/Web/Wallpaper/Windows/img0.jpg"
                Stretch="UniformToFill"
                AlignmentX="Center"
                AlignmentY="Center" />

    <SolidColorBrush x:Key="WindowHeaderBrush" Color="#F7F9FD" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#CCD8EA" />
</ResourceDictionary>
