<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="RestaurantBgColor">#F2F6FC</Color>
    <Color x:Key="RestaurantSurfaceColor">#FFFFFF</Color>
    <Color x:Key="RestaurantPrimaryColor">#2563EB</Color>
    <Color x:Key="RestaurantCardBorderColor">#E2E8F0</Color>
    <Color x:Key="RestaurantTextPrimaryColor">#0F172A</Color>
    <Color x:Key="RestaurantTextMutedColor">#64748B</Color>
    <Color x:Key="RestaurantSuccessColor">#16A34A</Color>
    <Color x:Key="RestaurantWarningColor">#EA580C</Color>
    <Color x:Key="RestaurantDangerColor">#DC2626</Color>

    <SolidColorBrush x:Key="RestaurantBgBrush" Color="{DynamicResource RestaurantBgColor}"/>
    <SolidColorBrush x:Key="RestaurantSurfaceBrush" Color="{DynamicResource RestaurantSurfaceColor}"/>
    <SolidColorBrush x:Key="RestaurantPrimaryBrush" Color="{DynamicResource RestaurantPrimaryColor}"/>
    <SolidColorBrush x:Key="RestaurantCardBorderBrush" Color="{DynamicResource RestaurantCardBorderColor}"/>
    <SolidColorBrush x:Key="RestaurantTextPrimaryBrush" Color="{DynamicResource RestaurantTextPrimaryColor}"/>
    <SolidColorBrush x:Key="RestaurantTextMutedBrush" Color="{DynamicResource RestaurantTextMutedColor}"/>
    <SolidColorBrush x:Key="RestaurantSuccessBrush" Color="{DynamicResource RestaurantSuccessColor}"/>
    <SolidColorBrush x:Key="RestaurantWarningBrush" Color="{DynamicResource RestaurantWarningColor}"/>
    <SolidColorBrush x:Key="RestaurantDangerBrush" Color="{DynamicResource RestaurantDangerColor}"/>

    <Style x:Key="RestaurantSidebarButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="58"/>
        <Setter Property="Margin" Value="6,2"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource RestaurantTextMutedBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#EFF6FF"/>
                            <Setter Property="Foreground" Value="{DynamicResource RestaurantPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource RestaurantPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RestaurantActiveSidebarButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource RestaurantSidebarButtonStyle}">
        <Setter Property="Background" Value="#EFF6FF"/>
        <Setter Property="Foreground" Value="{DynamicResource RestaurantPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RestaurantPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="RestaurantDetailTabButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource RestaurantTextMutedBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,3"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
</ResourceDictionary>
