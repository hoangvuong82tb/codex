<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WindowHostHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WindowHeaderBrush}" />
        <Setter Property="CornerRadius" Value="18,18,0,0" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderBrush" Value="#D5E0F1" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
    </Style>

    <Style x:Key="HeaderIconCircleStyle" TargetType="Border">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Background" Value="#E7EFFB" />
    </Style>
</ResourceDictionary>
