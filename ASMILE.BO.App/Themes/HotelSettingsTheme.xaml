<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared visual language for Front Office settings pages.
         Local view styles inherit these keys so existing commands and bindings stay unchanged. -->
    <SolidColorBrush x:Key="HotelSettingsSurfaceBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="HotelSettingsCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HotelSettingsBorderBrush" Color="#C9D8EA" />
    <SolidColorBrush x:Key="HotelSettingsTextBrush" Color="#17365D" />
    <SolidColorBrush x:Key="HotelSettingsMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="HotelSettingsAccentBrush" Color="#2563EB" />

    <Style x:Key="HotelSettingsButtonBase" TargetType="Button" BasedOn="{StaticResource FluentSecondaryButton}">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource HotelSettingsTextBrush}" />
        <Setter Property="Background" Value="{StaticResource HotelSettingsCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HotelSettingsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="HotelSettingsPrimaryButtonBase" TargetType="Button" BasedOn="{StaticResource FluentPrimaryButton}">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="HotelSettingsTextBoxBase" TargetType="TextBox" BasedOn="{StaticResource FluentTextBox}">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource HotelSettingsTextBrush}" />
        <Setter Property="Background" Value="{StaticResource HotelSettingsCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HotelSettingsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="HotelSettingsComboBoxBase" TargetType="ComboBox" BasedOn="{StaticResource FluentComboBox}">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="12,0,36,0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource HotelSettingsTextBrush}" />
        <Setter Property="Background" Value="{StaticResource HotelSettingsCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HotelSettingsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="HotelSettingsDatePickerBase" TargetType="DatePicker" BasedOn="{StaticResource EnterpriseModuleDatePicker}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderBrush" Value="{StaticResource HotelSettingsBorderBrush}" />
    </Style>

    <Style x:Key="HotelSettingsListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HotelSettingsCardStyle" TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
        <Setter Property="Background" Value="{StaticResource HotelSettingsCardBrush}" />
        <Setter Property="BorderBrush" Value="#D7E3F1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="HotelSettingsSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource FO.Text.Section}">
        <Setter Property="Foreground" Value="{StaticResource HotelSettingsTextBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="HotelSettingsCaption" TargetType="TextBlock" BasedOn="{StaticResource FO.Text.Caption}">
        <Setter Property="Foreground" Value="{StaticResource HotelSettingsMutedBrush}" />
    </Style>
</ResourceDictionary>
