<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#F2FFFFFF" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BorderBrush" Value="#D8E2F0" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="WindowCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ContentCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="BorderBrush" Value="#D9E3F1" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</ResourceDictionary>
