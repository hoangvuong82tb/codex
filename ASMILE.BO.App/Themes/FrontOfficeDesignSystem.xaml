<ResourceDictionary x:Class="ASMILE.BO.App.Themes.FrontOfficeDesignSystem"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Primitive tokens: keep values static and reuse existing application colors/brushes. -->
    <sys:Double x:Key="FO.Space.4">4</sys:Double>
    <sys:Double x:Key="FO.Space.8" xmlns:sys="clr-namespace:System;assembly=mscorlib">8</sys:Double>
    <sys:Double x:Key="FO.Space.12" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="FO.Space.16" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="FO.Space.20" xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
    <sys:Double x:Key="FO.Space.24" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    <sys:Double x:Key="FO.Space.32" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
    <sys:Double x:Key="FO.Space.40" xmlns:sys="clr-namespace:System;assembly=mscorlib">40</sys:Double>

    <CornerRadius x:Key="FO.Radius.Small">8</CornerRadius>
    <CornerRadius x:Key="FO.Radius.Medium">10</CornerRadius>
    <CornerRadius x:Key="FO.Radius.Large">12</CornerRadius>
    <CornerRadius x:Key="FO.Radius.Modal">14</CornerRadius>

    <sys:Double x:Key="FO.Hub.MaxWidth">1500</sys:Double>
    <sys:Double x:Key="FO.Hub.HeaderHeight">54</sys:Double>
    <sys:Double x:Key="FO.Card.MinWidth">266</sys:Double>
    <sys:Double x:Key="FO.Card.Height">138</sys:Double>
    <sys:Double x:Key="FO.Card.IconSize">42</sys:Double>
    <sys:Double x:Key="FO.Modal.MinWidth">760</sys:Double>
    <sys:Double x:Key="FO.Modal.MaxWidth">1500</sys:Double>
    <sys:Double x:Key="FO.Modal.MinHeight">540</sys:Double>
    <sys:Double x:Key="FO.Modal.MaxHeight">980</sys:Double>

    <!-- Aliases retain the established palette and make Color-versus-Brush intent explicit. -->
    <SolidColorBrush x:Key="FO.Surface.BackgroundBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="FO.Surface.CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="FO.Surface.CardHoverBrush" Color="{StaticResource CardSoftColor}" />
    <SolidColorBrush x:Key="FO.Surface.CardPressedBrush" Color="{StaticResource CardSoftColor}" />
    <SolidColorBrush x:Key="FO.Border.DefaultBrush" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="FO.Border.FocusBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="FO.Text.PrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="FO.Text.SecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="FO.Text.MutedBrush" Color="{StaticResource TextSecondaryColor}" Opacity="0.82" />
    <SolidColorBrush x:Key="FO.Accent.Brush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="FO.Status.ActiveBrush" Color="{StaticResource AccentGreenColor}" />
    <SolidColorBrush x:Key="FO.Status.ReadOnlyBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="FO.Status.ComingSoonBrush" Color="{StaticResource AccentOrangeColor}" />
    <SolidColorBrush x:Key="FO.Status.ErrorBrush" Color="{StaticResource AccentRedColor}" />
    <SolidColorBrush x:Key="FO.Overlay.ScrimBrush" Color="{StaticResource TextPrimaryColor}" />

    <Style x:Key="FO.Text.Display" TargetType="TextBlock" BasedOn="{StaticResource AppTitleTextStyle}"><Setter Property="FontSize" Value="28" /></Style>
    <Style x:Key="FO.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource AppTitleTextStyle}"><Setter Property="FontSize" Value="26" /></Style>
    <Style x:Key="FO.Text.Section" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleTextStyle}"><Setter Property="FontSize" Value="16" /></Style>
    <Style x:Key="FO.Text.Body" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{StaticResource FO.Text.PrimaryBrush}" /></Style>
    <Style x:Key="FO.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}" />
    <Style x:Key="FO.Text.Badge" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}" /></Style>

    <Style x:Key="FO.HubCardButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource FO.Card.MinWidth}" />
        <Setter Property="Height" Value="{StaticResource FO.Card.Height}" />
        <Setter Property="Margin" Value="0,0,18,18" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{StaticResource FO.Surface.CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FO.Border.DefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ToolTip" Value="{Binding DisabledReason}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource FO.Radius.Large}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource FO.Surface.CardHoverBrush}" /><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource FO.Border.FocusBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource FO.Border.FocusBrush}" /><Setter TargetName="Root" Property="BorderThickness" Value="2" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.88" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.56" /><Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FO.MainHubCardButton" TargetType="Button" BasedOn="{StaticResource FO.HubCardButton}">
        <Setter Property="Width" Value="330" />
        <Setter Property="Height" Value="168" />
        <Setter Property="Margin" Value="0,0,16,16" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <Style x:Key="FO.HubCardIconTile" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource FO.Card.IconSize}" />
        <Setter Property="Height" Value="{StaticResource FO.Card.IconSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource FO.Radius.Medium}" />
        <Setter Property="Background" Value="{StaticResource CardSoftBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="FO.HubBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource FO.Radius.Small}" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FO.HubBadge.Active" TargetType="Border" BasedOn="{StaticResource FO.HubBadge}"><Setter Property="Background" Value="{StaticResource FO.Status.ActiveBrush}" /></Style>
    <Style x:Key="FO.HubBadge.ReadOnly" TargetType="Border" BasedOn="{StaticResource FO.HubBadge}"><Setter Property="Background" Value="{StaticResource FO.Status.ReadOnlyBrush}" /></Style>
    <Style x:Key="FO.HubBadge.ComingSoon" TargetType="Border" BasedOn="{StaticResource FO.HubBadge}"><Setter Property="Background" Value="{StaticResource FO.Status.ComingSoonBrush}" /></Style>

    <Style x:Key="FO.HubPageTitle" TargetType="TextBlock" BasedOn="{StaticResource AppTitleTextStyle}"><Setter Property="FontSize" Value="26" /></Style>
    <Style x:Key="FO.HubPageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}"><Setter Property="FontSize" Value="13" /><Setter Property="Margin" Value="0,4,0,0" /></Style>
    <Style x:Key="FO.HubContextText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}"><Setter Property="TextAlignment" Value="Right" /></Style>

    <Style x:Key="FO.ErrorNotice" TargetType="Border">
        <Setter Property="Padding" Value="14" /><Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" /><Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource FO.Radius.Medium}" />
    </Style>
    <Style x:Key="FO.InfoNotice" TargetType="Border" BasedOn="{StaticResource FO.ErrorNotice}"><Setter Property="Background" Value="{StaticResource CardSoftBrush}" /><Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" /></Style>

    <Style x:Key="FO.ModalScrim" TargetType="Border"><Setter Property="Background" Value="{StaticResource FO.Overlay.ScrimBrush}" /><Setter Property="Opacity" Value="0.28" /></Style>
    <Style x:Key="FO.LargeModalShell" TargetType="Border">
        <Setter Property="Margin" Value="70,48" /><Setter Property="MaxWidth" Value="{StaticResource FO.Modal.MaxWidth}" /><Setter Property="MaxHeight" Value="{StaticResource FO.Modal.MaxHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource FO.Modal.MinWidth}" /><Setter Property="MinHeight" Value="{StaticResource FO.Modal.MinHeight}" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" /><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource FO.Radius.Modal}" />
    </Style>
    <Style x:Key="FO.ReadOnlyModalShell" TargetType="Border" BasedOn="{StaticResource FO.LargeModalShell}"><Setter Property="Margin" Value="48" /><Setter Property="MaxWidth" Value="1240" /><Setter Property="MaxHeight" Value="760" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="CornerRadius" Value="{StaticResource FO.Radius.Modal}" /></Style>
    <Style x:Key="FO.ComingSoonModalShell" TargetType="Border" BasedOn="{StaticResource DialogCardStyle}"><Setter Property="Padding" Value="28" /><Setter Property="CornerRadius" Value="{StaticResource FO.Radius.Modal}" /></Style>
    <Style x:Key="FO.ModalSection" TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource FO.Radius.Medium}" /><Setter Property="Padding" Value="18" /></Style>
    <Style x:Key="FO.ModalLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}"><Setter Property="Margin" Value="0,0,0,6" /></Style>
    <Style x:Key="FO.LoadingState" TargetType="StackPanel"><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style x:Key="FO.EmptyState" TargetType="StackPanel"><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Width" Value="330" /></Style>
    <Style x:Key="FO.StateTitle" TargetType="TextBlock" BasedOn="{StaticResource FO.Text.Section}"><Setter Property="TextAlignment" Value="Center" /></Style>
    <Style x:Key="FO.StateDescription" TargetType="TextBlock" BasedOn="{StaticResource FO.Text.Caption}"><Setter Property="TextAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" /></Style>

    <!-- ═══════════════════════════════════════════════════════
         MODERN CALENDAR DESIGN SYSTEM
         ═══════════════════════════════════════════════════════ -->

    <!-- CalendarDayButton — individual day cells -->
    <Style x:Key="FoCalendarDayButtonStyle" TargetType="primitives:CalendarDayButton">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#334155"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:CalendarDayButton">
                    <Border x:Name="Root"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#EAF3FF"/>
                            <Setter Property="Foreground" Value="#2563EB"/>
                        </Trigger>
                        <!-- Selected -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#2F6BFF"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <!-- Today (not selected) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsToday" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="BorderBrush" Value="#2F6BFF"/>
                            <Setter TargetName="Root" Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="#2563EB"/>
                        </MultiTrigger>
                        <!-- Inactive (other month) -->
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="#B8C3D1"/>
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <!-- Blackout -->
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Opacity" Value="0.25"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Calendar navigation button (prev/next arrows) -->
    <Style x:Key="FoCalendarNavButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#EAF3FF"/>
                            <Setter Property="Foreground" Value="#2F6BFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CalendarItem — the month view -->
    <Style x:Key="FoCalendarItemStyle" TargetType="primitives:CalendarItem">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:CalendarItem">
                    <Border x:Name="PART_Root" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header: prev | month/year | next -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PART_PreviousButton" Grid.Column="0"
                                        Style="{StaticResource FoCalendarNavButtonStyle}"
                                        Content="&#x2039;" FontSize="16"/>

                                <Button x:Name="PART_HeaderButton" Grid.Column="1"
                                        FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                        Foreground="#17365D" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand"
                                        HorizontalAlignment="Center"
                                        Padding="8,4">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" Background="Transparent"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="PART_NextButton" Grid.Column="2"
                                        Style="{StaticResource FoCalendarNavButtonStyle}"
                                        Content="&#x203A;" FontSize="16"/>
                            </Grid>

                            <!-- Weekday headers (Vietnamese) -->
                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="T2" FontFamily="Segoe UI" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#64748B"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="T3" FontFamily="Segoe UI" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#64748B"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="T4" FontFamily="Segoe UI" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#64748B"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="T5" FontFamily="Segoe UI" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#64748B"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="T6" FontFamily="Segoe UI" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#64748B"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="T7" FontFamily="Segoe UI" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#64748B"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="CN" FontFamily="Segoe UI" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#EF4444"
                                           HorizontalAlignment="Center"/>
                            </Grid>

                            <!-- Day grid -->
                            <Grid x:Name="PART_MonthView" Grid.Row="2"
                                  HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/>
                                </Grid.RowDefinitions>
                            </Grid>

                            <!-- Year view (hidden) -->
                            <Grid x:Name="PART_YearView" Grid.Row="2"
                                  HorizontalAlignment="Center"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/><ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="72"/><ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/>
                                </Grid.RowDefinitions>
                            </Grid>

                            <Border x:Name="PART_DisabledVisual" Grid.RowSpan="3"
                                    Background="White" Opacity="0.55" Visibility="Collapsed"
                                    IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Calendar — combines CalendarItem with quick action footer -->
    <Style x:Key="FoModernCalendarStyle" TargetType="Calendar">
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource FoCalendarDayButtonStyle}"/>
        <Setter Property="CalendarItemStyle" Value="{StaticResource FoCalendarItemStyle}"/>
        <Setter Property="Language" Value="vi-VN"/>
        <Setter Property="FirstDayOfWeek" Value="Monday"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#DCE5F1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.16" Color="#62748E"/></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <Border x:Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                        <StackPanel>
                            <!-- Calendar month view -->
                            <primitives:CalendarItem x:Name="PART_CalendarItem"
                                                     Style="{TemplateBinding CalendarItemStyle}"/>

                            <!-- Divider -->
                            <Border Height="1" Background="#E8EEF6" Margin="12,6,12,8"/>

                            <!-- Quick action footer -->
                            <Grid Margin="12,8,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="Hôm nay"
                                        Click="OnCalendarToday"
                                        HorizontalAlignment="Stretch" Height="34"
                                        Margin="0,0,6,0" Padding="8,0"
                                        FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Foreground="#234E9A" Background="#EEF4FF"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#DFEAFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="1" Content="Ngày mai"
                                        Click="OnCalendarTomorrow"
                                        HorizontalAlignment="Stretch" Height="34"
                                        Margin="3,0,3,0" Padding="8,0"
                                        FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Foreground="#234E9A" Background="#EEF4FF"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#DFEAFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="2" Content="Xóa ngày"
                                        Click="OnCalendarClear"
                                        HorizontalAlignment="Stretch" Height="34"
                                        Margin="6,0,0,0" Padding="8,0"
                                        FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Foreground="#D64545" Background="#FFF1F2"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#FFE4E6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
