<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ModuleShellCardStyle" TargetType="Border" BasedOn="{StaticResource FluentCardStyle}">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="ModuleHeaderTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#1F2B3D"/>
    </Style>

    <Style x:Key="CommandBarButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="MinWidth" Value="90"/>
    </Style>

    <Style x:Key="StatusBadgeStyleModern" TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style x:Key="FilterInputStyle" TargetType="Control">
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="ModernDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="RowHeight" Value="38"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="AlternatingRowBackground" Value="#F8FBFF"/>
        <Setter Property="BorderBrush" Value="#CFDBEC"/>
        <Setter Property="Background" Value="White"/>
    </Style>

    <Style x:Key="DetailPaneStyle" TargetType="Border" BasedOn="{StaticResource ModuleShellCardStyle}">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Background" Value="#FCFDFF"/>
    </Style>

    <Style x:Key="KpiCardStyle" TargetType="Border" BasedOn="{StaticResource ModuleShellCardStyle}">
        <Setter Property="Background" Value="#F7FAFF"/>
        <Setter Property="MinHeight" Value="84"/>
    </Style>
</ResourceDictionary>
