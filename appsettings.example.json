{
  "Database": {
    "ConnectionString": "",
    "MigrationMode": "ValidateOnly",
    "AllowApplyPendingMigrations": false,
    "FailOnPendingMigrations": true,
    "BackupDirectory": "Backups",
    "AllowDatabaseRestore": false
  },
  "TrainingData": {
    "AllowDestructiveReset": false,
    "AllowInProduction": false,
    "AllowResetWithRealDataRisk": false,
    "RequireConfirmationText": "RESET DATA"
  },
  "Licensing": {
    "Product": "ASMILE.BO",
    "ManifestPath": "",
    "PublicKeyPem": ""
  },
  "Maintenance": {
    "Product": "ASMILE.BO",
    "UpdateManifestPath": "",
    "UpdatePublicKeyPem": "",
    "UpdateStagingPath": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/asmile-bo-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
